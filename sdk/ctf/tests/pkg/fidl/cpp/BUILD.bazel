load("//build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")
load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")
load("//build/bazel/rules/fidl:fidl_library.bzl", "fidl_library")
load("//build/bazel/rules/host_tests:host_cc_test.bzl", "host_cc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")
load(
    "//src/tests/fidl/conformance_suite:gidl_conformance_suite.bzl",
    "CONFORMANCE_SUITE_FIDL_TARGET",
    "CONFORMANCE_SUITE_GIDL_FILES",
)
load("//tools/fidl/gidl:gidl.bzl", "gidl_hlcpp_conformance")

package(default_applicable_licenses = ["//:license"])

fidl_library(
    name = "union_migration_test_fidl",
    testonly = True,
    srcs = ["union_migration.test.fidl"],
    enable_hlcpp = True,
    excluded_checks = ["invalid-copyright-for-platform-source-library"],
    library_name = "fidl.test.unionmigration",
    visibility = ["//visibility:private"],
)

fx_cc_library(
    name = "test_util",
    testonly = True,
    hdrs = ["test/test_util.h"],
    includes = ["../../../../.."],
    public_configs = ["//sdk/config"],  # For bazel2gn.
    visibility = ["//visibility:private"],
    deps = ["//sdk/lib/fidl/hlcpp:hlcpp_base"],
    alwayslink = True,
)

fx_cc_library(
    name = "handle_util",
    testonly = True,
    srcs = ["test/handle_util.cc"],
    hdrs = ["test/handle_util.h"],
    includes = ["../../../../.."],
    public_configs = ["//sdk/config"],  # For bazel2gn.
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = [
        "//src/lib/fidl/llcpp/tests/conformance:__pkg__",
        "//src/tests/benchmarks/fidl/cpp:__pkg__",
        "//src/tests/benchmarks/fidl/driver_cpp:__pkg__",
        "//src/tests/benchmarks/fidl/driver_llcpp:__pkg__",
        "//src/tests/benchmarks/fidl/hlcpp:__pkg__",
        "//src/tests/benchmarks/fidl/llcpp:__pkg__",
    ],
    deps = ["//zircon/system/ulib/zx"],
    alwayslink = True,
)

# LINT.IfChange

# @bazel2gn:skip
_GIDL_OUTPUT_PREFIX = "conformance_suite__"

# @bazel2gn:skip
_GIDL_DEPS = [
    ":%s%s" % (
        _GIDL_OUTPUT_PREFIX,
        gidl_file.rsplit(":", 1)[1].removesuffix(".gidl"),
    )
    for gidl_file in CONFORMANCE_SUITE_GIDL_FILES
]

# @bazel2gn:skip
[
    gidl_hlcpp_conformance(
        name = "%s%s" % (
            _GIDL_OUTPUT_PREFIX,
            gidl_file.rsplit(":", 1)[1].removesuffix(".gidl"),
        ),
        testonly = True,
        fidl = CONFORMANCE_SUITE_FIDL_TARGET,
        inputs = [gidl_file],
        deps = [
            ":test_util",
            "//zircon/system/ulib/zxtest",
        ] + select({
            "@platforms//os:fuchsia": [":handle_util"],
            "//conditions:default": [],
        }),
    )
    for gidl_file in CONFORMANCE_SUITE_GIDL_FILES
]

# @bazel2gn:skip
fx_cc_binary(
    name = "fidl-hlcpp-conformance-tests_bin",
    testonly = True,
    deps = _GIDL_DEPS + [
        "//sdk/lib/async-loop:async-loop-cpp",
        "//sdk/lib/async-loop:async-loop-default",
        "//sdk/lib/fdio",
        "//sdk/testing/fidl:test",
        "//sdk/testing/fidl:test_support",
        "//zircon/system/ulib/zxtest",
    ],
)

# @bazel2gn:skip
fx_unittest_package(
    name = "fidl-hlcpp-conformance-tests-latest",
    unit_tests = [":fidl-hlcpp-conformance-tests_bin"],
    visibility = ["//sdk/ctf/tests/pkg/fidl:__subpackages__"],
)

# @bazel2gn:skip
host_cc_test(
    name = "fidl-hlcpp-conformance-tests-host",
    visibility = ["//sdk/ctf/tests/pkg/fidl:__subpackages__"],
    deps = ["//zircon/system/ulib/zxtest"] + _GIDL_DEPS,
)

# LINT.ThenChange(//sdk/ctf/tests/pkg/fidl/cpp/BUILD.gn)
