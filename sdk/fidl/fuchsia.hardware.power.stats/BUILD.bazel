load(
    "@rules_fuchsia//fuchsia:defs.bzl",
    "fuchsia_cc_library",
    "fuchsia_fidl_library",
)
load("//build/bazel/rules/fidl:fidl_library.bzl", "fidl_library")

package(default_applicable_licenses = ["//:license"])

fidl_library(
    name = "fuchsia.hardware.power.stats",
    srcs = [
        "stats.fidl",
    ],
    # TODO(https://fxbug.dev/493687765): Re-enable C++ bindings here and remove
    # the @rules_fuchsia targets below once out-of-tree-style Bazel drivers no
    # longer link this library alongside @fuchsia_sdk libraries (which would
    # otherwise duplicate libfidl/libasync symbols with the in-tree bindings;
    # see https://fxrev.dev/1861855).
    # @bazel2gn:skip
    enable_cpp = False,
    visibility = [
        "//src/devices/power/bin/power-stats-util:__pkg__",
        "//src/starnix/kernel/core:__pkg__",
        "//src/starnix/modules/power_residency:__pkg__",
        "//src/starnix/tests/syscalls/rust:__pkg__",
        "//vendor/google:__subpackages__",
    ],
)

# @bazel2gn:skip
fuchsia_fidl_library(
    name = "fuchsia.hardware.power.stats_sdk",
    srcs = [
        "stats.fidl",
    ],
    cc_bindings = [
        "cpp",
    ],
    library = "fuchsia.hardware.power.stats",
    tags = ["manual"],
    target_compatible_with = [
        "@platforms//os:fuchsia",
        "//build/bazel/platforms:fuchsia_artifacts_build_with_sdk_rules",
    ],
)

# @bazel2gn:skip
fuchsia_cc_library(
    name = "fuchsia.hardware.power.stats_cpp",
    target_compatible_with = [
        "@platforms//os:fuchsia",
        "//build/bazel/platforms:fuchsia_artifacts_build_with_sdk_rules",
    ],
    visibility = [
        "//vendor/google:__subpackages__",
    ],
    deps = [":fuchsia.hardware.power.stats_sdk_cpp"],
)
