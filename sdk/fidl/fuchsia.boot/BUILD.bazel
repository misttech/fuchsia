load(
    "@rules_fuchsia//fuchsia:defs.bzl",
    "fuchsia_cc_library",
    "fuchsia_fidl_library",
)
load("//build/bazel/rules/fidl:fidl_library.bzl", "fidl_library")

package(default_applicable_licenses = ["//:license"])

fidl_library(
    name = "fuchsia.boot",
    srcs = [
        "arguments.fidl",
        "factory-items.fidl",
        "items.fidl",
        "log.fidl",
        "overview.fidl",
        "svc-stash.fidl",
        "userboot.fidl",
    ],
    api_area = "Kernel",
    # @bazel2gn:skip
    enable_cpp = False,
    enable_hlcpp = True,
    visibility = ["//visibility:public"],
    deps = [
        "//sdk/fidl/fuchsia.io",
        "//zircon/vdso/zx",
    ],
)

# In-tree platform C++ bindings for non-SDK targets (e.g. //src/lib/zxdump).
# @bazel2gn:skip
fidl_library(
    name = "fuchsia.boot_in_tree",
    srcs = [
        "arguments.fidl",
        "factory-items.fidl",
        "items.fidl",
        "log.fidl",
        "overview.fidl",
        "svc-stash.fidl",
        "userboot.fidl",
    ],
    api_area = "Kernel",
    enable_cpp = True,
    enable_hlcpp = False,
    enable_rust = False,
    enable_rust_next = False,
    library_name = "fuchsia.boot",
    visibility = ["//visibility:private"],
    deps = [
        "//sdk/fidl/fuchsia.io",
        "//zircon/vdso/zx",
    ],
)

# @bazel2gn:skip
fuchsia_fidl_library(
    name = "fuchsia.boot_sdk",
    srcs = [
        "arguments.fidl",
        "factory-items.fidl",
        "items.fidl",
        "log.fidl",
        "overview.fidl",
        "svc-stash.fidl",
        "userboot.fidl",
    ],
    cc_bindings = ["cpp"],
    library = "fuchsia.boot",
    tags = ["manual"],
    target_compatible_with = [
        "@platforms//os:fuchsia",
        "//build/bazel/platforms:fuchsia_artifacts_build_with_sdk_rules",
    ],
    visibility = ["//visibility:private"],
    deps = ["@fuchsia_sdk//fidl/fuchsia.io"],
)

# @bazel2gn:skip
fuchsia_cc_library(
    name = "fuchsia.boot_cpp",
    visibility = ["//visibility:public"],
    deps = select({
        "//build/bazel/platforms:is_fuchsia_with_sdk_rules": [":fuchsia.boot_sdk_cpp"],
        "//conditions:default": [":fuchsia.boot_in_tree_cpp"],
    }),
)
