/// Google On-Device Power Monitor (ODPM) interface.
@available(added=HEAD)
library fuchsia.hardware.google.odpm;

using zx;

const MAX_RAIL_NAME_SIZE uint32 = 256;

/// An arbitrary, human-readable string that uniquely identifies a power rail.
alias RailName = string:MAX_RAIL_NAME_SIZE;

type RailMetadata = table {
    /// Canonical identifier for the rail (e.g. "cpu_big", "gpu").
    1: name RailName;
    /// Hardware channel index.
    2: channel_id uint32;
    /// Schematic name of the rail (e.g. "S2M_VDD_CPU2").
    3: schematic_name RailName;
};

type MeasurementType = flexible enum {
    /// Average measurement over a time interval (default).
    AVERAGE = 1;
    /// Instantaneous snapshot.
    INSTANTANEOUS = 2;
};

type Options = table {
    /// Specifies the type of measurement desired.
    /// Defaults to `AVERAGE` if omitted.
    1: measurement_type MeasurementType;
};

type PowerReading = table {
    /// Measured power in microwatts.
    1: power_uw int32;
    /// Measurement time interval (omitted if unknown).
    2: interval zx.Duration;
    /// Time when the reading was taken.
    3: timestamp zx.Time;
};

type CurrentReading = table {
    /// Measured current in microamperes.
    1: current_ua int32;
    /// Measurement time interval (omitted if unknown).
    2: interval zx.Duration;
    /// Time when the reading was taken.
    3: timestamp zx.Time;
};

type EnergyReading = table {
    /// Measured energy in microjoules.
    1: energy_uj int32;
    /// Measurement time interval (omitted if unknown).
    2: interval zx.Duration;
    /// Time when the reading was taken.
    3: timestamp zx.Time;
};

@discoverable
open protocol Device {
    /// Returns metadata for the rail.
    flexible GetRailMetadata() -> (RailMetadata) error zx.Status;

    /// Returns the power consumption.
    flexible GetPowerWatts(Options) -> (PowerReading) error zx.Status;

    /// Returns the current.
    flexible GetCurrentAmperes(Options) -> (CurrentReading) error zx.Status;

    /// Returns the energy consumption.
    flexible GetEnergyJoules(Options) -> (EnergyReading) error zx.Status;
};

service Service {
    device client_end:Device;
};
