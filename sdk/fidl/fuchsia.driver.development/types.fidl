library fuchsia.driver.development;

using fuchsia.component.decl;
using fuchsia.driver.framework;
using fuchsia.url;
using zx;

const NODE_MONIKER_MAX uint32 = 1024;
const MAX_SEGMENTS uint32 = 20;

type NodeInfo = table {
    /// Unique ID identifying the node.
    1: id uint64;

    /// List of ids representing parents. If more than one, this is a composite node.
    2: parent_ids vector<uint64>:MAX;

    /// List of ids representing children.
    3: child_ids vector<uint64>:MAX;

    /// The process KOID of the driver host the driver resides within.
    4: driver_host_koid zx.Koid;

    /// URL to the driver component manifest
    5: bound_driver_url fuchsia.url.Url;

    /// The collection-relative moniker of the node.
    7: moniker string:NODE_MONIKER_MAX;

    /// Properties of the node.
    8: node_property_list fuchsia.driver.framework.NodeProperties;

    /// Component offers to the node.
    9: offer_list vector<fuchsia.component.decl.Offer>:MAX;

    /// Whether the node is in a quarantined state. That is, the |bound_driver_url| has failed to
    /// start, and the node is no longer running its driver instance.
    10: quarantined bool;

    /// Information about the node's bus topology.
    11: bus_topology vector<fuchsia.driver.framework.BusInfo>:MAX_SEGMENTS;

    /// The topological path of the node in devfs.
    // TODO(https://fxbug.dev/500119481): Remove this field once all clients are
    // migrated away from devfs.
    12: topological_path string:NODE_MONIKER_MAX;

    /// Whether the driver bound to this node has completed starting and is currently running.
    @available(added=HEAD)
    13: is_running bool;
};

/// Information about a node binding to either a driver or a composite.
type NodeBindingInfo = table {
    /// Full topological name of the node.
    1: node_name string:NODE_MONIKER_MAX;
    /// This is the component url for the driver that bound to the node.
    /// If this is present, then |composite_parents| must not be.
    2: driver_url fuchsia.url.Url;
    /// The composite parents that this node binded to.
    /// If this is present, then |driver_url| must not be.
    3: composite_parents vector<fuchsia.driver.framework.CompositeParent>:MAX;
};

/// Contains information for a composite.
@strict_audit(bug="https://fxbug.dev/467128685", state="PENDING_REVIEW")
type CompositeInfo = strict union {
    2: composite fuchsia.driver.framework.CompositeInfo;
};

/// Contains information for a composite node.
type CompositeNodeInfo = table {
    /// The topological paths of the parent nodes of this composite, ordered by index.
    1: parent_topological_paths vector<string:<MAX, optional>>:MAX;

    /// The topological path of the created composite node. Empty if not created.
    2: topological_path string:MAX;

    // Information about the composite.
    3: composite CompositeInfo;

    /// The monikers of the parent nodes of this composite, ordered by index.
    4: parent_monikers vector<string:<MAX, optional>>:MAX;

    /// The moniker of the created composite node. Empty if not created.
    5: moniker string:NODE_MONIKER_MAX;
};

/// Contains information for a thread.
type ThreadInfo = table {
    /// The koid for the thread.
    1: koid zx.Koid;

    /// The name of the thread.
    2: name string:MAX;

    /// The scheduler role of the thread.
    3: scheduler_role string:MAX;
};

/// The lifecycle state of a dispatcher.
@available(added=HEAD)
type DispatcherState = flexible enum {
    RUNNING = 1;
    SHUTTING_DOWN = 2;
    SHUTDOWN = 3;
    DESTROYED = 4;
};

/// Breakdown of reasons why requests were not inlined by the driver runtime.
@available(added=HEAD)
type NonInlinedRequestStats = table {
    /// Calling from a non-blocking to a blocking (`ALLOW_SYNC_CALLS`) dispatcher.
    1: allow_sync_calls uint64;
    /// Another thread was already dispatching a request.
    2: parallel_dispatch uint64;
    /// The request was a task.
    3: task uint64;
    /// The request was queued from an unknown thread.
    4: unknown_thread uint64;
    /// The request would have been reentrant.
    5: reentrant uint64;
    /// Channel wait was not yet registered when the message was received.
    6: channel_wait_not_yet_registered uint64;
    /// Called into a dispatcher that wasn't allowed to migrate threads.
    7: no_thread_migration uint64;
};

/// Request and inlining statistics for a dispatcher.
@available(added=HEAD)
type DispatcherDebugStats = table {
    /// Total number of requests processed by this dispatcher.
    1: num_total_requests uint64;
    /// Number of requests that were inlined.
    2: num_inlined_requests uint64;
    /// Breakdown of reasons why requests were not inlined.
    3: non_inlined NonInlinedRequestStats;
};

/// Diagnostic information for a task queued on a dispatcher.
@available(added=HEAD)
type QueuedTaskInfo = table {
    /// Address of the queued `async_task_t`.
    1: ptr uint64;
    /// Address of the task handler function.
    2: handler uint64;
    /// Address of the dispatcher that queued this task, if queued from a runtime thread.
    3: initiating_dispatcher uint64;
    /// Name of the dispatcher that queued this task, if known.
    4: initiating_dispatcher_name string:MAX;
    /// Address of the driver that queued this task, if queued from a runtime thread.
    5: initiating_driver uint64;
    /// URL of the driver that queued this task, if known.
    6: initiating_driver_url fuchsia.url.Url;
};

/// Contains information for a dispatcher.
type DispatcherInfo = table {
    /// The driver which created this dispatcher.
    1: driver fuchsia.url.Url;

    /// The name of the dispatcher.
    2: name string:MAX;

    /// The options the dispatcher was created with.
    3: options uint32;

    /// The scheduler role of the dispatcher.
    4: scheduler_role string:MAX;

    /// Address of the dispatcher in the driver host process.
    @available(added=HEAD)
    5: dispatcher_ptr uint64;

    /// Address of the driver owner in the driver host process.
    @available(added=HEAD)
    6: driver_ptr uint64;

    /// Whether the dispatcher is synchronized.
    @available(added=HEAD)
    7: synchronized bool;

    /// Whether the dispatcher allows blocking synchronous calls.
    @available(added=HEAD)
    8: allow_sync_calls bool;

    /// Current lifecycle state of the dispatcher.
    @available(added=HEAD)
    9: state DispatcherState;

    /// Name of the dispatcher that initiated destruction, if `Destroy` was called.
    @available(added=HEAD)
    10: destroy_context string:MAX;

    /// Whether `Destroy` was user-initiated (`true`) or environment-initiated (`false`).
    @available(added=HEAD)
    11: destroy_user_initiated bool;

    /// Request and inlining statistics for the dispatcher.
    @available(added=HEAD)
    12: debug_stats DispatcherDebugStats;

    /// Currently queued tasks on the dispatcher.
    @available(added=HEAD)
    13: queued_tasks vector<QueuedTaskInfo>:MAX;

    /// Total number of queued tasks on the dispatcher prior to any truncation.
    @available(added=HEAD)
    14: num_queued_tasks uint64;
};

/// Contains information for a driver host.
type DriverHostInfo = table {
    /// The process KOID of the driver host.
    1: process_koid zx.Koid;

    /// Optional name of the driver host.
    5: name string:MAX;

    /// The list of threads of the driver host.
    2: threads vector<ThreadInfo>:MAX;

    /// List of drivers loaded into this driver host.
    3: drivers vector<fuchsia.url.Url>:MAX;

    /// List of dispatchers .
    4: dispatchers vector<DispatcherInfo>:MAX;
};

type TestNodeAddArgs = table {
    /// Name of the node.
    1: name string:NODE_MONIKER_MAX;

    /// Properties of the node.
    @available(added=HEAD)
    2: properties fuchsia.driver.framework.NodeProperties;
};

/// These flags indicate when a |fuchsia.driver.index.DriverIndex::MatchDriver| call should be
/// made for a node that is restarting in order to find a new driver, instead of reusing the driver
/// that was previously bound to the node.
type RestartRematchFlags = flexible bits : uint32 {
    /// Rematch nodes that are currently bound to the requested driver. The requested driver is
    /// the driver url that the restart operation was initiated for.
    REQUESTED = 0x0001;
    /// Rematch nodes that are currently bound to a driver other than the requested driver. These
    /// are nodes that are affected by the restart of the requested driver, for example when
    /// it is a colocated parent.
    NON_REQUESTED = 0x0002;
    /// Rematch nodes that are created as part of a completed composite spec.
    COMPOSITE_SPEC = 0x0008;
};
