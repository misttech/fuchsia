library fuchsia.memory.attribution;

using zx;

/// Rights to map a VMO in read-only mode and read its "content size" property.
const VMO_MAP_READONLY_RIGHTS zx.Rights
        = zx.RIGHTS_BASIC | zx.Rights.READ | zx.Rights.GET_PROPERTY | zx.Rights.MAP;

/// Protocol used by user pagers to publish memory attribution statistics.
@discoverable
protocol PagerStatsSink {
    /// Sends a VMO containing shared counts of page refaults and total page faults, both measured
    /// in pages supplied by the pager including readahead. The shared counts are stored as two
    /// canonical monotonic atomic 64-bit unsigned integers from the start of the VMO:
    /// - Offset 0: `page_refaults` (pages supplied that had already been supplied before)
    /// - Offset 8: `page_faults` (total pages supplied by the user pager)
    SendPagerStats(resource struct {
        pager_stats_vmo zx.Handle:<VMO, VMO_MAP_READONLY_RIGHTS>;
    });
};
