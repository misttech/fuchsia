@available(added=HEAD)
library fuchsia.driver.host;

using fuchsia.driver.framework;
using fuchsia.driver.loader;
using fuchsia.ldsvc;
using fuchsia.url;
using zx;

/// Protocol through which a driver's lifecycle can be managed.
///
/// The Driver Runner will call Stop() on this protocol to indicate that the
/// Driver Host should stop the Driver. The Driver Host should close the
/// server end of the channel with an epitath to signal that the driver has
/// been stopped.
///
/// EPITAPH
///
/// This protocol sends a FIDL epitaph to indicate that the driver instance
/// has been terminated correctly. The Driver Host must send an epitaph of
/// ZX_OK in order to indicate the Driver was Stopped correctly.
/// Not sending an epitaph, or sending an error, will cause Driver Runner
/// to log an error.
closed protocol Driver {

    /// Request that the Driver is Stopped.
    ///
    /// After stopping the driver instance, the server should close this
    /// connection with an epitath. This signals that the Driver has been
    /// stopped.
    strict Stop();

    /// Requests the driver to perform a self-diagnostic check.
    ///
    /// The Driver Host enforces per-level deadlines (`PING` 250ms, `FAST` 2s,
    /// `DEEP` 2min) and fails the call with `TIMEOUT` if the driver does not
    /// reply in time. A check is only forwarded while the driver is resumed;
    /// otherwise the Driver Host replies `INVALID_STATE` itself, and a check
    /// whose completion is observed while the driver is no longer resumed is
    /// also answered `INVALID_STATE`. A driver built against an SDK without
    /// `HealthCheck` replies `NOT_SUPPORTED`; other transport failures reply
    /// `INTERNAL_ERROR`. In-flight checks are answered with `INVALID_STATE`
    /// when `Stop` is received.
    strict HealthCheck(struct {
        request fuchsia.driver.framework.HealthCheckRequest;
    }) -> (fuchsia.driver.framework.HealthCheckResponse) error fuchsia.driver.framework.HealthCheckError;

    /// Proactively emitted by the driver (via the Driver Host) when it detects
    /// an asynchronous self-fault or suspects an upstream/downstream neighbor.
    strict -> OnHealthAlert(struct {
        alert fuchsia.driver.framework.HealthAlert;
    });
};

/// The lifecycle state of a dispatcher.
type DispatcherState = flexible enum {
    RUNNING = 1;
    SHUTTING_DOWN = 2;
    SHUTDOWN = 3;
    DESTROYED = 4;
};

/// Breakdown of reasons why requests were not inlined by the driver runtime.
type NonInlinedRequestStats = struct {
    allow_sync_calls uint64;
    parallel_dispatch uint64;
    task uint64;
    unknown_thread uint64;
    reentrant uint64;
    channel_wait_not_yet_registered uint64;
    no_thread_migration uint64;
};

/// Request and inlining statistics for a dispatcher.
type DispatcherDebugStats = struct {
    num_total_requests uint64;
    num_inlined_requests uint64;
    non_inlined NonInlinedRequestStats;
};

/// Diagnostic information for a task queued on a dispatcher.
type QueuedTaskInfo = struct {
    ptr uint64;
    handler uint64;
    initiating_dispatcher uint64;
    initiating_dispatcher_name string:MAX;
    initiating_driver uint64;
    initiating_driver_url string:MAX;
};

/// Information about the driver host's dispatchers. Used for debugging.
type DispatcherInfo = struct {
    driver string:MAX;
    name string:MAX;
    options uint32;
    scheduler_role string:MAX;
    dispatcher_ptr uint64;
    driver_ptr uint64;
    synchronized bool;
    allow_sync_calls bool;
    state DispatcherState;
    destroy_context string:MAX;
    has_destroy_user_initiated bool;
    destroy_user_initiated bool;
    debug_stats DispatcherDebugStats;
    num_queued_tasks uint64;
    queued_tasks vector<QueuedTaskInfo>:MAX;
};

/// Information about the driver host's threads. Used for debugging.
type ThreadInfo = struct {
    koid uint64;
    name string:MAX;
    scheduler_role string:MAX;
};

/// Information about the driver host. Used for debugging.
type ProcessInfo = struct {
    job_koid uint64;
    process_koid uint64;
    main_thread_koid uint64;
    threads vector<ThreadInfo>:MAX;
    dispatchers vector<DispatcherInfo>:MAX;
};

/// Information stored when a thread crashes.
type DriverCrashInfo = resource table {
    1: url string:fuchsia.url.MAX_URL_LENGTH;
    2: node_token zx.Handle:EVENT;
};

/// Protocol through which a driver host can be managed.
@discoverable
closed protocol DriverHost {
    /// Start a driver within a driver host.
    strict Start(resource struct {
        start_args fuchsia.driver.framework.DriverStartArgs;
        driver server_end:Driver;
        host_name string:100;
    }) -> () error zx.Status;

    /// Start a driver that's been loaded via an out of process dynamic linker.
    strict StartLoadedDriver(resource struct {
        start_args fuchsia.driver.framework.DriverStartArgs;
        dynamic_linking_abi fuchsia.driver.loader.DynamicLinkingPassiveAbi;
        driver server_end:Driver;
    }) -> () error zx.Status;

    /// Returns the job and process KOIDs of the driver host.
    strict GetProcessInfo() -> (ProcessInfo) error zx.Status;

    /// Provides a loader service which should be installed via
    /// `dl_set_loader_service`.
    strict InstallLoader(resource struct {
        loader client_end:fuchsia.ldsvc.Loader;
    });

    strict TriggerStackTrace();

    /// Returns the driver crash information if the thread specified by |thread_koid|
    /// exists in this driver host and it has ran into an exception.
    /// Otherwise returns ZX_ERR_NOT_FOUND.
    strict FindDriverCrashInfoByThreadKoid(resource struct {
        thread_koid zx.Koid;
    }) -> (DriverCrashInfo) error zx.Status;
};
