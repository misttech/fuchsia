load("//build/bazel/rules/fidl:fidl_library.bzl", "fidl_library")
load("//tools/fidl/measure-tape:measure_tape.bzl", "measure_tape")

package(default_applicable_licenses = ["//:license"])

fidl_library(
    name = "fuchsia.wlan.policy",
    srcs = [
        "access_point_provider.fidl",
        "client_provider.fidl",
        "overview.fidl",
        "types.fidl",
    ],
    api_area = "WLAN",
    category = "partner",
    enable_hlcpp = True,
    # TODO(https://fxbug.dev/42111344): Remove lint exclusions by fixing known FIDL lint violations in this target
    excluded_checks = ["vector-bounds-not-specified"],
    stable = True,
    visibility = ["//visibility:public"],
    deps = [
        "//sdk/fidl/fuchsia.wlan.ieee80211",
        "//zircon/vdso/zx",
    ],
)

measure_tape(
    name = "measure_tape_for_scan_result",
    fidls = ["//sdk/fidl/fuchsia.wlan.policy"],
    target_binding = "rust",
    target_types = ["fuchsia.wlan.policy/ScanResult"],
    visibility = ["//src/connectivity/wlan/wlancfg:__pkg__"],
)
