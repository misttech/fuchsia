@available(added=HEAD)
library fuchsia.hardware.ufs.phy;

using fuchsia.hardware.inlineencryption;
using zx;

/// Interface provided by the UFS MAC (controller driver) to the PHY driver,
/// allowing the PHY driver to send UIC commands (like DME_SET) or access
/// MAC-level registers required for PHY initialization.
open protocol Ufshci {
    /// Send a UIC DME_SET command to the UFS controller.
    flexible DmeSet(struct {
        mib_attribute uint16;
        gen_selector_index uint16;
        value uint32;
    }) -> () error zx.Status;

    /// Send a UIC DME_GET command to the UFS controller.
    /// If the MIB attribute's value has not been set via the DME_SET command, a hardware reset
    /// default value is returned by the device.
    /// For invalid mib_attribute or gen_selector_index values, a ZX_ERR_INTERNAL error is returned.
    flexible DmeGet(struct {
        mib_attribute uint16;
        gen_selector_index uint16;
    }) -> (struct {
        value uint32;
    }) error zx.Status;
};

@discoverable
open protocol UfsPhy {
    /// Perform the UFS PHY specific initialization which happens before link startup.
    flexible Init(resource struct {
        ufs_hci client_end:Ufshci;
    }) -> () error zx.Status;

    /// Perform PHY calibration and configuration prior to power mode / gear change.
    flexible PrePowerModeChange() -> () error zx.Status;

    /// Returns the PHY driver's static capabilities. The controller driver calls this once at
    /// initialization to decide which power-management features it may use. A PHY driver that
    /// does not implement this method is treated as supporting none of the optional features.
    flexible GetProperties() -> (table {
        /// Whether `Suspend` and `Resume` are implemented, i.e. the PHY can power down the UFS
        /// device, PHY and host controller power domains and bring them back up. When unset or
        /// false the controller driver only uses link hibernation for system suspend.
        1: supports_suspend_resume bool;
    });

    /// Powers down the UFS device rails, PHY reset, regulators, clocks, and power domains.
    ///
    /// The caller must have stopped the host controller (HCE = 0) before calling this; after it
    /// returns the UFSHCI register space must not be accessed until `Resume` has succeeded.
    /// Calling `Suspend` while already suspended is a no-op. On failure the PHY is still
    /// considered suspended (every step is attempted and the first error reported), so the caller
    /// must go through `Resume` to bring it back. Only resources that are actually held are
    /// released, so `Suspend` is also safe to call after a failed `Resume` (which has already
    /// released what it acquired). The host controller is stopped for the whole duration of
    /// `Suspend` and `Resume`, so `Ufshci` calls made from within them fail with ZX_ERR_BAD_STATE.
    flexible Suspend() -> () error zx.Status;

    /// Powers up the UFS power domains and clocks prior to host controller enable and link startup.
    ///
    /// Calling `Resume` while not suspended is a no-op that returns success. On failure the PHY
    /// must release anything it acquired during the attempt and remain suspended, so that the
    /// caller may either call `Suspend` or retry `Resume`.
    flexible Resume() -> () error zx.Status;
};

service Service {
    phy client_end:UfsPhy;
    inline_crypto client_end:fuchsia.hardware.inlineencryption.Controller;
};
