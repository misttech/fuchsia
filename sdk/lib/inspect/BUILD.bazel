load("//build/bazel/rules/components:cml_shard.bzl", "cml_shard")

package(default_applicable_licenses = ["//:license"])

exports_files(
    [
        "offer.shard.cml",
        "client.shard.cml",
        "use.shard.cml",
    ],
    visibility = [
        "//bundles/assembly:__subpackages__",
        "//src/security/lib/scrutiny/tests/route_verification:__pkg__",
        "//src/sys/pkg/bin/omaha-client:__pkg__",
        "//src/sys/pkg/bin/pkg-cache:__pkg__",
        "//src/sys/pkg/bin/system-update-checker:__pkg__",
        "//src/sys/pkg/bin/system-update-committer:__pkg__",
        "//src/sys/pkg/bin/system-updater:__pkg__",
        "//src/sys/pkg/lib/omaha-client-fuchsia:__pkg__",
        "//src/sys/pkg/tests/pkg-resolver:__pkg__",
    ],
)

cml_shard(
    name = "offer.shard",
    shard = "offer.shard.cml",
)

cml_shard(
    name = "use.shard",
    shard = "use.shard.cml",
)

cml_shard(
    name = "client.shard",
    includes = [
        ":offer.shard",
        ":use.shard",
    ],
    shard = "client.shard.cml",
    visibility = ["//src/power/shutdown-shim:__subpackages__"],
)
