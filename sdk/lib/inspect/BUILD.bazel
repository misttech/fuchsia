load("//build/bazel/rules/components:cml_shard.bzl", "cml_shard")
load("//build/bazel/rules/components:expect_includes.bzl", "expect_includes")

package(default_applicable_licenses = ["//:license"])

exports_files(
    [
        "offer.shard.cml",
        "client.shard.cml",
        "use.shard.cml",
    ],
    visibility = [
        "//bundles/assembly:__subpackages__",
        "//src/factory/fake_factory_items:__pkg__",
        "//src/factory/fake_factory_store_providers:__pkg__",
        "//src/security/lib/scrutiny/tests/route_verification:__pkg__",
        "//src/sys/pkg/lib/omaha-client-fuchsia:__pkg__",
        "//src/sys/pkg/tests/pkg-resolver:__pkg__",
    ],
)

# @bazel2gn:skip
cml_shard(
    name = "offer.shard",
    shard = "offer.shard.cml",
    visibility = [
        "//src/lib/fuchsia-hyper:__pkg__",
        "//src/sys/component_manager/tests/attributed_logging/components:__pkg__",
        "//src/sys/lib/elf_runner/tests/lifecycle:__pkg__",
    ],
)

# @bazel2gn:skip
cml_shard(
    name = "use.shard",
    shard = "use.shard.cml",
)

# @bazel2gn:skip
cml_shard(
    name = "client.shard",
    includes = [
        ":offer.shard",
        ":use.shard",
    ],
    shard = "client.shard.cml",
    visibility = [
        "//examples:__subpackages__",
        "//src:__subpackages__",
    ],
)

# Require dependent components to include required capabilities in their
# component manifests in order to export Inspect data.
expect_includes(
    name = "client_includes",
    includes = [":client.shard"],
    visibility = [
        "//sdk/lib/inspect/component/cpp:__pkg__",
        "//src/lib/diagnostics/inspect/runtime/rust:__pkg__",
    ],
)

# Expose the .api file to the definition of the library.
exports_files(
    ["inspect.api"],
    visibility = [
        "//zircon/system/ulib/inspect:__pkg__",
    ],
)
