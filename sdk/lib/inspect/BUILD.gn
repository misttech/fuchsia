import("//build/sdk/sdk_component_manifests.gni")
import("//tools/cmc/build/expect_includes.gni")

sdk_component_manifests("inspect") {
  name = "inspect"
  manifests = [
    "client.shard.cml",
    "use.shard.cml",
    "offer.shard.cml",
  ]
  category = "partner"
}

group("tests") {
  testonly = true
  deps = [
    "component:tests",
    "contrib/cpp:tests",
  ]
}

