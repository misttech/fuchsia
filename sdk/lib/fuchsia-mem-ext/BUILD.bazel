load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")

package(default_applicable_licenses = ["//:license"])

fx_cc_library(
    name = "fuchsia-mem-ext",
    srcs = ["fuchsia-mem-ext.cc"],
    hdrs = ["include/lib/fuchsia-mem-ext/fuchsia-mem-ext.h"],
    includes = ["include"],
    public_configs = [":config"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = [
        "//sdk/lib/fuchsia-mem-ext/tests:__pkg__",
        "//vendor/google:__subpackages__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.mem:fuchsia.mem_hlcpp",
        "//sdk/lib/stdcompat",
        "//zircon/system/ulib/zx",
    ],
    alwayslink = True,
)
