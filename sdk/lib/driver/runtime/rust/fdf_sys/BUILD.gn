rustc_library("fdf_sys") {
  sources = [
    "src/bindings.rs",
    "src/lib.rs",
  ]
  edition = "2024"
  visibility = [
    ":*",
    "//sdk/lib/driver/*",
    "//src/devices/bin/driver-host/*",
    "//src/lib/dso/rust/*",
    "//src/sys/runners/dso/*",
  ]
  deps = [
    "//sdk/lib/async/rust/sys",
    "//sdk/rust/zx-types",
  ]
}
rustc_test("fdf_sys_test") {
  sources = [
    "src/bindings.rs",
    "src/lib.rs",
  ]
  edition = "2024"
  deps = [
    "//sdk/lib/async/rust/sys",
    "//sdk/rust/zx-types",
  ]
}
fuchsia_unittest_package("fdf_sys_tests") {
  package_name = "fdf_sys_tests-gn"
  component_name = "fdf_sys_tests"
  deps = [ ":fdf_sys_test" ]
}
