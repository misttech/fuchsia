import("//build/bazel/bazel_test_suite.gni")

bazel_test_suite("bazel_tests") {
  target_tests = [ "//sdk/lib/driver/runtime/rust:fdf_rust_tests" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    ":fdf_rust_tests",
    "channel:tests",
    "core:tests",
    "env:tests",
    "fdf_sys:tests",
    "fidl:tests",
  ]
}

