import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("rust") {
  sources = [ "src/lib.rs" ]
  crate_name = "fdf"
  edition = "2024"
  lint_config = "//build/config/rust/lints:clippy_warn_all"
  visibility = [
    ":*",
    "//build/rust:*",
    "//examples/drivers/*",
    "//sdk/lib/async/rust/fidl:*",
    "//sdk/lib/driver/component/rust:*",
    "//src/connectivity/*",
    "//src/developer/*",
    "//src/devices/*",
    "//src/graphics/*",
    "//src/lib/dso/rust:*",
    "//src/lib/fidl/rust/fidl_driver:*",
    "//src/sys/*",
    "//src/ui/*",
    "//tools/create/*",
    "//tools/fidl/*",
    "//vendor/google/*",
  ]
  deps = [
    "//sdk/lib/async/rust",
    "//sdk/lib/driver/runtime/rust/channel",
    "//sdk/lib/driver/runtime/rust/core",
  ]
}

rustc_test("rust_test") {
  sources = [ "src/lib.rs" ]
  edition = "2024"
  deps = [
    "//sdk/lib/async/rust",
    "//sdk/lib/driver/runtime/rust/channel",
    "//sdk/lib/driver/runtime/rust/core",
  ]
  output_name = "fdf_lib_test"
  lint_config = "//build/config/rust/lints:clippy_warn_all"
}

fuchsia_unittest_package("fdf_rust_tests") {
  package_name = "fdf_rust_tests-gn"
  component_name = "fdf_rust_tests"
  deps = [ ":rust_test" ]
}
