import("//build/components.gni")
import("//build/rust/rustc_test.gni")

# The library is defined in BUILD.bazel. The unit tests stay in GN: they depend
# on //src/devices/bin/driver_runtime, which is not built by Bazel yet.
rustc_test("core_test") {
  output_name = "fdf_core_lib_test"
  edition = "2024"
  configs += [ "//build/config/rust/lints:clippy_warn_all" ]
  deps = [
    "//sdk/lib/async",
    "//sdk/lib/async/rust",
    "//sdk/lib/async/rust/dispatcher",
    "//sdk/lib/driver/runtime/rust/fdf_sys",
    "//sdk/rust/zx",
    "//src/devices/bin/driver_runtime",
    "//src/devices/lib/driver:driver_runtime",
    "//src/lib/fuchsia-async",
    "//third_party/rust_crates:futures",
  ]
  sources = [
    "src/dispatcher.rs",
    "src/handle.rs",
    "src/lib.rs",
    "src/shutdown_observer.rs",
  ]
}

fuchsia_unittest_package("fdf_rust_core_tests") {
  deps = [ ":core_test" ]
}

group("tests") {
  testonly = true
  deps = [ ":fdf_rust_core_tests" ]
}

