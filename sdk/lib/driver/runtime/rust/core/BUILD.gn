import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("core") {
  sources = [
    "src/dispatcher.rs",
    "src/handle.rs",
    "src/lib.rs",
    "src/shutdown_observer.rs",
  ]
  crate_name = "fdf_core"
  edition = "2024"
  link_deps = [
    "//sdk/lib/async",
    "//src/devices/lib/driver:driver_runtime",
  ]
  lint_config = "//build/config/rust/lints:clippy_warn_all"
  visibility = [
    ":*",
    "//sdk/lib/driver/*",
    "//src/devices/bin/driver-host/*",
  ]
  deps = [
    "//sdk/lib/async/rust/dispatcher",
    "//sdk/lib/driver/runtime/rust/fdf_sys",
    "//sdk/rust/zx",
  ]
}
