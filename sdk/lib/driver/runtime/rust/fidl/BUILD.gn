rustc_library("fidl") {
  sources = [
    "src/lib.rs",
    "src/wire.rs",
  ]
  crate_name = "fdf_fidl"
  edition = "2024"
  link_deps = [ "//src/devices/bin/driver_runtime" ]
  lint_config = "//build/config/rust/lints:clippy_warn_all"
  version = "0.1.0"
  visibility = [ "//*" ]
  deps = [
    "//sdk/lib/async/rust/dispatcher",
    "//sdk/lib/async/rust/fidl",
    "//sdk/lib/driver/runtime/rust/channel",
    "//sdk/lib/driver/runtime/rust/core",
    "//sdk/lib/driver/runtime/rust/fdf_sys",
    "//sdk/rust/zx",
    "//src/lib/fidl/rust_next/fidl_next",
    "//src/lib/fuchsia-sync",
  ]
}
