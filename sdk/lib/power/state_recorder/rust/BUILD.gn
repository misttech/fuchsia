import("//build/components.gni")

# Hand-written GN copy of the Bazel test package: bazel2gn cannot translate
# the explicit fx_package chain needed for the custom manifest (which adds
# `tmp` storage). The test runs in both build systems while the library has
# GN users; the GN package gets a `-gn` suffix so it can coexist with the
# Bazel package of the same name.
# TODO(https://fxrev.dev/1913272): Use //src/sys/test_runners:tmp_storage
# expect_includes and fx_unittest_package once fxr/1913272 lands.
fuchsia_unittest_package("power_state_recorder_rust_unittests") {
  package_name = "power_state_recorder_rust_unittests-gn"
  component_name = "power_state_recorder_rust_unittests"
  deps = [ ":state_recorder_lib_test" ]
  manifest = "meta/power_state_recorder_rust_unittests.cml"
}

group("tests") {
  testonly = true
  deps = [ ":power_state_recorder_rust_unittests" ]
}

