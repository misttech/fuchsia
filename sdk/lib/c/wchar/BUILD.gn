import("../libc.gni")

llvm_libc_source_set("wchar") {
  functions = [ "wcsdup" ]
  deps = [ ":wchar-minimal" ]
}

llvm_libc_source_set("wchar-minimal") {
  visibility = [ "//zircon/kernel/lib/libc/*" ]

  functions = [
    "wcpcpy",
    "wcpncpy",
    "wcscat",
    "wcschr",
    "wcscmp",
    "wcscpy",
    "wcscspn",
    "wcslen",
    "wcsncat",
    "wcsncmp",
    "wcsncpy",
    "wcsnlen",
    "wcspbrk",
    "wcsrchr",
    "wcsspn",
    "wcsstr",
    "wcstok",
    "wmemchr",
    "wmemcmp",
    "wmemcpy",
    "wmemmove",
    "wmemset",

    # "wmempcpy",  # not in the legacy (musl) ABI or header, maybe add it
  ]
}
