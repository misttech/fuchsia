source_set("conformance_utils") {
  testonly = true
  public = [ "conformance_utils.h" ]
  visibility = [ ":*" ]
  public_deps = [
    "//sdk/lib/fidl/cpp/wire",
    "//sdk/lib/fidl_base",
    "//src/zircon/lib/zircon",
    "//zircon/system/ulib/zx",
    "//zircon/system/ulib/zxtest",
  ]
}
