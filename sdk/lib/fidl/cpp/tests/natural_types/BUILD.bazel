load("//build/bazel/rules/cc:fx_cc_test.bzl", "fx_cc_test")
load("//build/bazel/rules/components:fx_component.bzl", "fx_component_manifest", "fx_test_component")
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load("//build/bazel/rules/packages:fx_packaged_binary.bzl", "fx_packaged_binary")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

# test-parity-allow-manual: Fuchsia-only test binary wrapped by fx_packaged_binary in :fidl_cpp_natural_type_api_tests_package.
fx_cc_test(
    name = "fidl_cpp_natural_type_api_tests_bin",
    srcs = [
        "bits_test.cc",
        "box_test.cc",
        "enum_test.cc",
        "serializable_test.cc",
        "struct_test.cc",
        "table_test.cc",
        "union_test.cc",
    ],
    tags = ["manual"],
    deps = [
        "//sdk/testing/fidl/types_tests:test.types_cpp",
        "//src/lib/fxl/test:gtest_main",
        "@com_google_googletest//:gtest",
    ],
)

fx_packaged_binary(
    name = "fidl_cpp_natural_type_api_tests_packaged_bin",
    testonly = True,
    binary = ":fidl_cpp_natural_type_api_tests_bin",
    binary_name = "fidl_cpp_natural_type_api_tests",
    install_root = "test/",
)

fx_component_manifest(
    name = "fidl_cpp_natural_type_api_tests_manifest",
    component_name = "fidl_cpp_natural_type_api_tests",
    includes = [
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/gtest:default.shard.cml",
    ],
    manifest = "meta/natural_type_api_tests.cml",
)

fx_test_component(
    name = "fidl_cpp_natural_type_api_tests_component",
    compiled_manifest = ":fidl_cpp_natural_type_api_tests_manifest",
    component_name = "fidl_cpp_natural_type_api_tests",
    deps = [
        ":fidl_cpp_natural_type_api_tests_packaged_bin",
    ],
)

fx_package(
    name = "fidl_cpp_natural_type_api_tests_package",
    package_name = "fidl_cpp_natural_type_api_tests",
    testonly = True,
    test_components = [
        ":fidl_cpp_natural_type_api_tests_component",
    ],
)

# Use `fuchsia.process.Launcher` for death tests
fx_test(
    name = "fidl_cpp_natural_type_api_tests",
    package = ":fidl_cpp_natural_type_api_tests_package",
    visibility = ["//sdk/lib:__pkg__"],
)
