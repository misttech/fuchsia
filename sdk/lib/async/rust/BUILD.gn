import("//build/components.gni")
import("//build/rust/rustc_test.gni")

# The library is defined in BUILD.bazel. The unit tests stay in GN: they depend
# on //sdk/lib/driver/runtime/rust/env, which is not built by Bazel yet.
rustc_test("rust_test") {
  output_name = "libasync_lib_test"
  edition = "2024"
  configs += [ "//build/config/rust/lints:clippy_warn_all" ]
  deps = [
    "//sdk/lib/async",
    "//sdk/lib/async/rust/dispatcher",
    "//sdk/lib/async/rust/sys",
    "//sdk/lib/driver/runtime/rust/env",
    "//sdk/rust/zx",
    "//third_party/rust_crates:futures",
  ]
  sources = [
    "src/after_deadline.rs",
    "src/callback_state.rs",
    "src/lib.rs",
    "src/on_interrupt.rs",
    "src/on_signals.rs",
  ]
}

fuchsia_unittest_package("libasync_tests") {
  deps = [ ":rust_test" ]
}

group("tests") {
  testonly = true
  deps = [
    ":libasync_tests",
    "dispatcher:tests",
    "fidl:tests",
    "scope_dispatcher:tests",
    "sys:tests",
  ]
}

