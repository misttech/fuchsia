import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("rust") {
  sources = [
    "src/after_deadline.rs",
    "src/callback_state.rs",
    "src/lib.rs",
    "src/on_interrupt.rs",
    "src/on_signals.rs",
  ]
  crate_name = "libasync"
  edition = "2024"
  link_deps = [ "//sdk/lib/async" ]
  lint_config = "//build/config/rust/lints:clippy_warn_all"
  version = "0.1.0"
  visibility = [
    ":*",
    "//sdk/lib/async/*",
    "//sdk/lib/driver/*",
    "//src/devices/bin/driver-host/*",
    "//src/lib/trace/rust/*",
    "//src/ui/lib/input_pipeline/*",
    "//vendor/*",
  ]
  deps = [
    "//sdk/lib/async/rust/dispatcher",
    "//sdk/lib/async/rust/sys",
    "//sdk/rust/zx",
    "//third_party/rust_crates:futures",
  ]
}
