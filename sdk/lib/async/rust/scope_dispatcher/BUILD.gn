import("//build/components.gni")
import("//build/rust/rustc_library.gni")

rustc_library("scope_dispatcher") {
  crate_name = "libasync_scope_dispatcher"
  version = "0.1.0"
  edition = "2024"
  with_unit_tests = true

  configs += [ "//build/config/rust/lints:clippy_warn_all" ]

  deps = [
    #"//sdk/lib/async",
    "//sdk/lib/async/rust/dispatcher",
    "//sdk/lib/async/rust/sys",
    "//sdk/rust/zx",
    "//src/lib/fuchsia-async",

    #"//third_party/rust_crates:futures",
  ]

  test_deps = [ "//src/lib/fuchsia" ]

  sources = [
    "src/lib.rs",
    "src/ops.rs",
    "src/ops/v1.rs",
    "src/ops/v2.rs",
    "src/ops/v3.rs",
    "src/ops/v4.rs",
    "src/scope_dispatcher.rs",
  ]
}

fuchsia_unittest_package("libasync_scope_dispatcher_tests") {
  deps = [ ":scope_dispatcher_test" ]
}

group("tests") {
  testonly = true
  deps = [ ":libasync_scope_dispatcher_tests" ]
}
