rustc_library("fidl") {
  sources = [ "src/lib.rs" ]
  crate_name = "libasync_fidl"
  edition = "2024"
  lint_config = "//build/config/rust/lints:clippy_warn_all"
  version = "0.1.0"
  visibility = [
    ":*",
    "//examples/*",
    "//sdk/lib/async/rust/*",
    "//sdk/lib/driver/*",
    "//src/ui/lib/input_pipeline/*",
    "//vendor/*",
  ]
  deps = [
    "//sdk/lib/async/rust",
    "//sdk/lib/async/rust/sys",
    "//sdk/rust/zx",
    "//src/lib/fidl/rust_next/fidl_next",
    "//third_party/rust_crates:futures",
  ]
}
