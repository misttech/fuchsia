load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "dispatcher",
    srcs = [
        "src/current_dispatcher.rs",
        "src/detect_dispatcher.rs",
        "src/lib.rs",
        "src/task.rs",
    ],
    crate_name = "libasync_dispatcher",
    edition = "2024",
    link_deps = [
        "//sdk/lib/async",
        "//sdk/lib/async-default",
    ],
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    version = "0.1.0",
    visibility = [
        "//sdk/lib/async:__subpackages__",
        "//sdk/lib/driver/runtime:__subpackages__",
    ],
    deps = [
        "//sdk/lib/async/rust/sys",
        "//sdk/rust/zx-status",
        "//sdk/rust/zx-types",
        "//src/lib/fuchsia-sync",
        "//third_party/rust_crates/vendor:futures",
    ],
)

# @bazel2gn:skip
rustc_test(
    name = "dispatcher_test",
    crate = ":dispatcher",
    edition = "2024",
)

# @bazel2gn:skip
fx_unittest_package(
    name = "libasync_dispatcher_tests",
    unit_tests = [":dispatcher_test"],
)
