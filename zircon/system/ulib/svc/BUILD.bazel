    #
    # This is an allowlist of targets that use the svc library. New code should
    # use the component::OutgoingDirectory class in //sdk/lib/sys/component/cpp
    # instead.
    #
    # To remove items from the allowlist, please send a change to one of the
    # OWNERS of this file to remove an element from the visibility list below.
