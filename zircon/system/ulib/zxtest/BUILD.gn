import("//build/tools/bazel2gn/bazel_migration.gni")

config("zxtest_enable_streamable_assertions") {
  defines = [ "ZXTEST_USE_STREAMABLE_MACROS" ]
}

config("prod_config") {
  include_dirs = [ "include" ]
}

# Dependency for "production" callers who use zxtest_prod header, (see that file
# for more).
source_set("prod") {
  public = [ "include/zxtest/cpp/zxtest_prod.h" ]
  public_configs = [ ":prod_config" ]
}

group("tests") {
  testonly = true
  deps = [ "test:tests" ]
}

