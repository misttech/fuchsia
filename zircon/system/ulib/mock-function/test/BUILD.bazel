load("//build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

fx_cc_binary(
    name = "mock-function-test",
    testonly = True,
    srcs = ["mock-function-test.cc"],
    tags = ["manual"],
    deps = [
        "//sdk/lib/fdio",
        "//zircon/system/ulib/fbl",
        "//zircon/system/ulib/mock-function",
        "//zircon/system/ulib/zx",
        "//zircon/system/ulib/zxtest",
    ],
)

fx_unittest_package(
    name = "mock-function-test-pkg",
    package_name = "mock-function-test",
    unit_tests = [":mock-function-test"],
    visibility = ["//zircon/system/ulib:__pkg__"],
)
