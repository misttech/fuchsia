load("@fuchsia_rules_common//build_flags:build_flags.bzl", "build_flags")
load("//build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

build_flags(
    name = "config",
    # The C file here uses a macro to detect whether a type is signed, by
    # comparing the values of -1 and 0. This leads to complaints about
    # vacuously true comparisons, which we don't care about.
    cflags = ["-Wno-type-limits"],
    visibility = ["//visibility:private"],
)

fx_cc_binary(
    name = "int-types",
    testonly = True,
    srcs = [
        "int-types.c",
        "int-types.cc",
        "wchar-type.c",
        "wchar-type.cc",
    ],
    build_flags = [":config"],
    tags = ["manual"],
    deps = [
        "//sdk/lib/fdio",
        "//zircon/system/ulib/fbl",
        "//zircon/system/ulib/zxtest",
    ],
)

fx_unittest_package(
    name = "int-types-test",
    unit_tests = [":int-types"],
    visibility = ["//zircon/system/utest:__pkg__"],
)
