config("stack_config") {
  visibility = [ ":*" ]

  cflags = [ "-fstack-protector-all" ]

  if (current_cpu == "arm64") {  # && !is_gcc
    cflags += [ "-fsanitize=shadow-call-stack" ]
  }

  if (select_variant + [ "gcc" ] - [ "gcc" ] != select_variant) {
    cflags += [ "-fno-sanitize=safe-stack" ]
  }
}

