import("//build/cpp/library_headers.gni")

library_headers("headers") {
  headers = [ "lib/cksum.h" ]
  public_deps = [
    # <lib/cksum.h> uses <zircon/compiler.h>.
    "//zircon/system/public",
  ]
}

static_library("cksum") {
  public_deps = [ ":headers" ]

  sources = [
    "crc32.c",
    "crc32.h",
    "zutil.h",
  ]

  if (is_kernel) {
    deps = [ "//zircon/kernel/lib/libc" ]
  }
}
