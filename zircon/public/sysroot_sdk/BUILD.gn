# IMPORTANT: This file is used to build the Fuchsia SDK sysroot for the
# current target architecture only, i.e. the set of files that will be exported
# to the SDK's sysroot atom. This does not setup the platform sysroot.
# See //zircon/public/sysroot/BUILD.gn for details on the latter.
#
# Note however that both files parse the same inputs collected from
# sysroot_entries.gni files. See below for details.
import("//build/config/fuchsia/target_api_level.gni")
import("//build/sdk/sdk_atom.gni")

# Collect the metadata for the SDK.
file_base = "${sdk_prebuilt_base_for_target_api_level}/sysroot"
sdk_api_contents = []

version_content = {
  root = file_base

  include_dir = "$file_base/include"
  dist_dir = ""
  headers = []
  link_libs = []
  dist_libs = []
  debug_libs = []
}

sdk_files = []

platform_sysroot_files = []
platform_sysroot_deps = []

import("//sdk/lib/c/sysroot_entries.gni")
import("//src/zircon/lib/zircon/sysroot_entries.gni")

# Turn the information from Zircon into a set of copy() rules for the
# sysroot while filling in $version_content.
#
# sysroot_entries will be a list of GN scopes, whose schema is documented
# in //zircon/public/sysroot/BUILD.gn.
#
sysroot_entries = sysroot_uninstrumented_libc_entries +
                  sysroot_instrumented_libc_entries + sysroot_vdso_entries

sysroot_sdk_deps = []
foreach(entry, sysroot_entries) {
  if (defined(entry.sdk)) {
    sdk = {
    }
    sdk = entry.sdk
    if (defined(sdk.headers)) {
      # This has to generate a separate copy() target for each file.
      # sdk.include_dir can be either a GN source path that begins with //
      # or a path relative to the Ninja build directory. use rebase_path()
      # to transform that to a rebased path first, then generate its
      # absolute path.
      rebased_include_dir =
          rebase_path(sdk.include_dir, root_build_dir, root_build_dir)
      dir = rebase_path(rebased_include_dir, "", root_build_dir)
      foreach(file, sdk.headers) {
        no_export = defined(sdk.no_export) && sdk.no_export
        if (!no_export) {
          version_content.headers += [ "$file_base/include/$file" ]
          sdk_files += [
            {
              source = "$dir/$file"
              dest = "$file_base/include/$file"
            },
          ]
          platform_sysroot_files += [
            {
              source = "${rebased_include_dir}/${file}"
              dest = "include/$file"
            },
          ]
          sdk_api_contents += [
            {
              source = "$dir/$file"
              dest = "include/$file"
            },
          ]
        }
      }
    } else if (defined(sdk.debug)) {
      sdk_files += [
        {
          source = rebase_path(sdk.source, "", root_build_dir)
          dest = "$file_base/${sdk.debug}"
        },
      ]
      platform_sysroot_files += [
        {
          source = sdk.source
          dest = sdk.debug
        },
      ]
      version_content.debug_libs += [ "$file_base/${sdk.debug}" ]
    } else {
      # This is just a single copy() target.
      if (defined(sdk.link)) {
        version_content.link_libs += [ "$file_base/${sdk.link}" ]
        sdk_files += [
          {
            source = rebase_path(sdk.source, "", root_build_dir)
            dest = "$file_base/${sdk.link}"
          },
        ]
        platform_sysroot_files += [
          {
            source = sdk.source
            dest = sdk.link
          },
        ]
      } else if (defined(sdk.dist)) {
        version_content.dist_libs += [ "$file_base/${sdk.dist}" ]
        version_content.dist_dir = file_base
        sdk_files += [
          {
            source = rebase_path(sdk.source, "", root_build_dir)
            dest = "$file_base/${sdk.dist}"
          },
        ]
        platform_sysroot_files += [
          {
            source = sdk.source
            dest = sdk.dist
          },
        ]
      } else {
        assert(false, "confused by $sdk")
      }
    }
    if (defined(sdk.deps)) {
      sysroot_sdk_deps += sdk.deps
      platform_sysroot_deps += sdk.deps
    }
  }
}

sdk_files += [
  {
    source = "//sdk/lib/c/libc.ifs"
    dest = "pkg/sysroot/libc.ifs"
  },
  {
    source = "//src/zircon/lib/zircon/zircon.ifs"
    dest = "pkg/sysroot/zircon.ifs"
  },
]

platform_sysroot_files += [
  {
    source = rebase_path("//sdk/lib/c/libc.ifs", root_build_dir)
    dest = "libc.ifs"
  },
  {
    source = rebase_path("//src/zircon/lib/zircon/zircon.ifs", root_build_dir)
    dest = "zircon.ifs"
  },
]

_sysroot_meta = {
  type = "sysroot"
  name = "sysroot"
  ifs_files = [
    "pkg/sysroot/libc.ifs",
    "pkg/sysroot/zircon.ifs",
  ]
  if (current_build_target_api_level == "PLATFORM") {
    versions = {
      if (target_cpu == "arm64") {
        arm64 = version_content
      } else if (target_cpu == "x64") {
        x64 = version_content
      } else if (target_cpu == "riscv64") {
        riscv64 = version_content
      } else {
        assert(false, "Unknown CPU type: $target_cpu")
      }
    }
  } else {
    variants = [
      {
        constraints = {
          api_level = "$current_build_target_api_level"
          arch = target_cpu
        }
        values = {
          root = file_base

          include_dir = "$file_base/include"
          sysroot_dir = version_content.dist_dir
          headers = version_content.headers
          link_libs = version_content.link_libs
          dist_libs = version_content.dist_libs
          debug_libs = version_content.debug_libs
        }
      },
    ]
  }
}

sdk_atom("sysroot_sdk") {
  id = "sdk://pkg/sysroot"
  category = "partner"
  api = "sysroot.api"
  api_contents = sdk_api_contents

  non_sdk_deps = [ "//zircon/vdso:sysroot_sdk" ] + sysroot_sdk_deps

  meta = {
    dest = "pkg/sysroot/meta.json"
    type = "sysroot"
    value = _sysroot_meta

    # `source_prebuild_info` is unnecessary because `value` is provided.
  }

  files = sdk_files
}

# This target is used to generate the platform sysroot files with Ninja, and
# write a JSON file that describes how to copy them to an external platform
# sysroot. This will be used to configure the Bazel fuchsia_platform toolchain.
#
# The output is a JSON array of objects, each one with the following schema:
#
#  "source": Path to the source file, relative to the Ninja build directory.
#  "dest": Path to the destination file, relative to the sysroot directory.
#
generated_file("sysroot_for_fuchsia_platform") {
  deps = platform_sysroot_deps
  contents = platform_sysroot_files

  # LINT.IfChange(sysroot_for_fuchsia_platform_json)
  outputs = [ "$root_build_dir/sysroot_for_fuchsia_platform.json" ]

  # LINT.ThenChange(//build/regenerator.py:sysroot_for_fuchsia_platform_json)
  output_conversion = "json"
}

import("//build/config/zircon/standard.gni")

# Per-CPU target aggregator: directly references toolchains for each CPU
template("sysroot_cpu_artifacts") {
  _cpu = invoker.cpu
  _variants = [
    "",
    "asan",
  ]
  if (_cpu == "arm64") {
    _variants += [ "hwasan" ]
  }

  group(target_name) {
    deps = [
      # 1. Startup object Scrt1.o compiled in user.basic toolchain for this CPU:
      "//sdk/lib/c/startup:startfiles(//build/toolchain/zircon:user.basic_${_cpu})",

      # 2. Linker stubs (llvm-ifs) for libc.so and libzircon.so:
      "//sdk/lib/c:c.stub.${_cpu}",
      "//src/zircon/lib/zircon:zircon.stub.${_cpu}",
    ]

    # 3. Stripped dynamic linker (dist/lib/ld.so.1) and debug symbols (debug/libc.so)
    # for all sanitizer variants for this CPU:
    foreach(variant, _variants) {
      if (variant == "") {
        _libc_toolchain = "//sdk/lib/c:user.libc_${_cpu}"
      } else {
        _libc_toolchain = "//sdk/lib/c:user.libc_${_cpu}-${variant}"
      }
      deps += [ "//sdk/lib/c:libc($_libc_toolchain)" ]
    }
  }
}

foreach(cpu, standard_fuchsia_cpus) {
  sysroot_cpu_artifacts("sysroot_artifacts_${cpu}") {
    cpu = cpu
  }
}

group("sysroot_artifacts_all_cpus") {
  deps = []
  foreach(cpu, standard_fuchsia_cpus) {
    deps += [ ":sysroot_artifacts_${cpu}" ]
  }
}

import("//build/config/fuchsia/platform_version.gni")
import("//build/sdk/config.gni")

_manifest_file = "$target_gen_dir/sysroot_manifest_inputs.json"

_sysroot_headers = []
foreach(entry, sysroot_entries) {
  if (defined(entry.sdk)) {
    _sdk = {
    }
    _sdk = entry.sdk
    if (defined(_sdk.headers)) {
      rebased_include_dir =
          rebase_path(_sdk.include_dir, root_build_dir, root_build_dir)
      dir = rebase_path(rebased_include_dir, "", root_build_dir)
      foreach(file, _sdk.headers) {
        if (!defined(_sdk.no_export) || !_sdk.no_export) {
          _sysroot_headers += [
            {
              source = "$dir/$file"
              dest = "include/$file"
            },
          ]
        }
      }
    }
  }
}

_manifest_cpus = []
foreach(cpu, idk_buildable_cpus) {
  _clang_cpu = cpu
  foreach(translation, clang_cpu_translations) {
    if (cpu == translation.gn) {
      _clang_cpu = translation.clang
    }
  }

  _dist_libs = {
  }
  _dist_libs = {
    ld_so = "user.libc_${cpu}/libc.so"
    asan_ld_so = "user.libc_${cpu}-asan/libc.so"
    if (cpu == "arm64") {
      hwasan_ld_so = "user.libc_${cpu}-hwasan/libc.so"
    }
  }

  _debug_libs = {
  }
  _debug_libs = {
    libc_so = "user.libc_${cpu}/libc.so.debug"
    asan_libc_so = "user.libc_${cpu}-asan/libc.so.debug"
    if (cpu == "arm64") {
      hwasan_libc_so = "user.libc_${cpu}-hwasan/libc.so.debug"
    }
  }

  _manifest_cpus += [
    {
      cpu = cpu
      stubs = {
        libc = "gen/sdk/lib/c/c.${_clang_cpu}/libc.so"
        libzircon =
            "gen/src/zircon/lib/zircon/zircon.${_clang_cpu}/libzircon.so"
      }
      startfiles = {
        scrt1 = "user.basic_${cpu}/gen/zircon/public/sysroot/lib/Scrt1.o"
      }
      dist_libs = _dist_libs
      debug_libs = _debug_libs
    },
  ]
}

_manifest_contents = {
  headers = _sysroot_headers
  ifs_files = {
    libc = rebase_path("//sdk/lib/c/libc.ifs", root_build_dir)
    zircon = rebase_path("//src/zircon/lib/zircon/zircon.ifs", root_build_dir)
  }
  musl_lib_ld =
      rebase_path("//zircon/third_party/ulib/musl/lib.ld", root_build_dir)
  cpus = _manifest_cpus
}

generated_file("sysroot_manifest_inputs") {
  outputs = [ _manifest_file ]
  contents = _manifest_contents
  output_conversion = "json"
}

action("sysroot_sdk_export") {
  script = "//build/sdk/generate_sysroot_idk_atom.py"
  _export_dir = "$root_build_dir/sysroot_idk_export"
  _meta_json = "$_export_dir/pkg/sysroot/meta.json"
  _stamp_file = "$target_gen_dir/$target_name.stamp"
  _depfile = "$target_gen_dir/$target_name.d"
  _validator_tool =
      "//build/tools/json_validator:json_validator_valico($host_toolchain)"
  _validator_path = "$host_out_dir/json_validator_valico"
  _schema = "//build/sdk/meta/sysroot.json"
  _manifest_schema = "//build/sdk/meta/manifest.json"

  inputs = [
    _manifest_file,
    _schema,
    _manifest_schema,
    _validator_path,
  ]

  outputs = [
    _meta_json,
    _stamp_file,
  ]

  depfile = _depfile

  args = [
    "--manifest",
    rebase_path(_manifest_file, root_build_dir),
    "--output-dir",
    rebase_path(_export_dir, root_build_dir),
    "--json-validator",
    rebase_path(_validator_path, root_build_dir),
    "--schema",
    rebase_path(_schema, root_build_dir),
    "--manifest-schema",
    rebase_path(_manifest_schema, root_build_dir),
    "--meta-manifest-id",
    "fuchsia_idk_sysroot",
    "--stamp-file",
    rebase_path(_stamp_file, root_build_dir),
    "--depfile",
    rebase_path(_depfile, root_build_dir),
    "--target-cpus",
  ]
  args += idk_buildable_cpus

  args += [ "--api-levels" ]
  foreach(level, idk_buildable_api_levels) {
    args += [ "$level" ]
  }

  deps = [
    ":sysroot_artifacts_all_cpus",
    ":sysroot_manifest_inputs",
    _validator_tool,
  ]
}
