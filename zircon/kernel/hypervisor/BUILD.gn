import("//build/cpp/library_headers.gni")
import("//build/zircon/zircon_cpu.gni")
import("//zircon/kernel/kernel_rust_mod.gni")

source_set("hypervisor") {
  public_deps = [ ":headers" ]

  sources = [
    "guest_ffi.cc",
    "trap_map_ffi.cc",
    "vcpu_ffi.cc",
  ]
  deps = [
    ":hypervisor-rs",
    "//zircon/kernel/arch/$zircon_cpu/hypervisor",
    "//zircon/kernel/lib/fbl",
    "//zircon/kernel/lib/ktl",
    "//zircon/kernel/lib/ktrace",
    "//zircon/kernel/lib/page",
    "//zircon/system/ulib/bitmap",
  ]
}

kernel_rust_mod("hypervisor-rs") {
  sources = [
    "aspace.rs",
    "aspace_ffi.rs",
    "cpu.rs",
    "cpu_ffi.rs",
    "ktrace.rs",
    "ktrace_ffi.rs",
    "mod.rs",
    "state_invalidator.rs",
    "state_invalidator_ffi.rs",
    "trap_map.rs",
    "trap_map_ffi.rs",
  ]
  deps = [
    "//sdk/rust/zx-status",
    "//sdk/rust/zx-types",
    "//src/lib/kalloc",
    "//src/lib/ksync",
    "//src/lib/zr",
    "//third_party/rust_crates:pin-init",
    "//zircon/kernel/lib/page",
    "//zircon/kernel/lib/range_check:range_check_rs",
    "//zircon/system/ulib/fbl/rust:fbl",
  ]
  test_deps = [ "//zircon/kernel/lib/unittest:unittest-rs" ]
}

library_headers("headers") {
  headers = []
  public_deps = [
    # <hypervisor/trap_map.h> has #include <object/port_dispatcher.h>.
    "//zircon/kernel/object:headers",

    # <hypervisor/id_allocator.h> has #include <bitmap/raw-bitmap.h>.
    "//zircon/system/ulib/bitmap:headers",

    # <hypervisor/aspace.h> has #include <vm/vm_aspace.h>.
    "//zircon/kernel/vm:headers",

    # <hypervisor/page.h> has #include <lib/page/size.h>
    "//zircon/kernel/lib/page:headers",
  ]
}

source_set("tests") {
  testonly = true
  sources = [ "hypervisor_unittest.cc" ]
  deps = [
    ":hypervisor",
    "//zircon/kernel/lib/unittest",
  ]
}

group("kernel-tests") {
  testonly = true
  deps = [
    ":tests",
    "//zircon/kernel/arch/$zircon_cpu/hypervisor:kernel-tests",
  ]
}
