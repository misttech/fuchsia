import("//build/cpp/library_headers.gni")
import("//zircon/kernel/kernel_rust_mod.gni")

library_headers("headers") {
  headers = [
    "dev/interrupt/arm_gicv2_init.h",
    "dev/interrupt/arm_gicv2_regs.h",
  ]
  public_deps = [ "//sdk/lib/zbi-format" ]
}

kernel_rust_mod("gicv2-rs") {
  output_name = "gicv2"
  source_root = "arm_gicv2.rs"
  sources = [
    "arm_gicv2.rs",
    "gicv2m.rs",
    "gicv2m_msi.rs",
    "regs.rs",
  ]
  deps = [
    "//sdk/rust/zbi",
    "//sdk/rust/zx-status",
    "//sdk/rust/zx-types",
    "//src/lib/kprint",
    "//src/lib/ksync",
    "//src/lib/lazy_init:lazy_init_rs",
    "//src/lib/regio",
    "//src/lib/zr",
    "//third_party/rust_crates:pin-init",
    "//zircon/kernel/lib/debug",
    "//zircon/kernel/lib/ktrace:ktrace-rs",
    "//zircon/kernel/lib/page:page-rs",
    "//zircon/kernel/lib/pow2_range_allocator:pow2-range-allocator-rs",
    "//zircon/kernel/lib/root_resource_filter:root_resource_filter_rs",
    "//zircon/kernel/lib/topology:topology_rs",
  ]
  test_deps = [ "//zircon/kernel/lib/unittest:unittest-rs" ]
}

source_set("v2") {
  sources = []
  public_deps = [ ":headers" ]
  deps = [
    ":gicv2-rs",
    "//zircon/kernel/dev/interrupt",
    "//zircon/kernel/dev/interrupt/gic/common",
    "//zircon/kernel/dev/pdev/interrupt",
    "//zircon/kernel/lib/root_resource_filter",
  ]
}
