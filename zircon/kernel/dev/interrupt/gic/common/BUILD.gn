import("//build/cpp/library_headers.gni")
import("//zircon/kernel/kernel_rust_mod.gni")

kernel_rust_mod("gic-common-rs") {
  output_name = "gic_common"
  source_root = "gic_common.rs"
  sources = [ "gic_common.rs" ]
  deps = [ "//sdk/rust/zx-status" ]
}

source_set("common") {
  public_deps = [ ":headers" ]

  sources = [ "arm_gic_hw_interface.cc" ]
  deps = [
    ":gic-common-rs",
    "//zircon/kernel/dev/interrupt",
    "//zircon/kernel/dev/pdev/interrupt",
  ]
}

library_headers("headers") {
  headers = [
    "dev/interrupt/arm_gic_common.h",
    "dev/interrupt/arm_gic_hw_interface.h",
  ]
}
