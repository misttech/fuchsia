import("//zircon/kernel/kernel_rust_mod.gni")

kernel_rust_mod("interrupt-rs") {
  output_name = "pdev_interrupt"
  source_root = "interrupt.rs"
  sources = [
    "console.rs",
    "interrupt.rs",
  ]
  deps = [
    "//sdk/rust/zx-status",
    "//src/lib/ksync",
    "//src/lib/lazy_init:lazy_init_rs",
    "//third_party/rust_crates:pin-init",
    "//zircon/kernel/lib/debug",
  ]
  test_deps = [ "//zircon/kernel/lib/unittest:unittest-rs" ]
}

source_set("interrupt") {
  deps = [ ":interrupt-rs" ]
}
