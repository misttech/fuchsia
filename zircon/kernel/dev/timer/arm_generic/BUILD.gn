import("//build/cpp/library_headers.gni")
import("//zircon/kernel/kernel_rust_mod.gni")

library_headers("headers") {
  headers = [ "dev/timer/arm_generic.h" ]
  public_deps = [ "//sdk/lib/zbi-format" ]
}

kernel_rust_mod("arm_generic_rs") {
  sources = [ "arm_generic_timer.rs" ]
  deps = [
    "//sdk/rust/zbi",
    "//sdk/rust/zx-status",
    "//sdk/rust/zx-types",
    "//src/lib/regio",
    "//src/lib/zr",
    "//zircon/kernel/lib/arch:arch-rs",
    "//zircon/kernel/lib/boot-options:boot-options-rs",
    "//zircon/kernel/lib/counters:counters-rs",
    "//zircon/kernel/lib/debug",
    "//zircon/kernel/lib/init:init_rust",
    "//zircon/system/ulib/affine/rust:affine",
  ]
  test_deps = [
    "//src/lib/kprint",
    "//zircon/kernel/lib/unittest:unittest-rs",
  ]
}

source_set("arm_generic") {
  sources = [
    "arm_generic_timer.cc",
    "arm_generic_timer_ffi.h",
  ]
  public_deps = [ ":headers" ]
  deps = [
    ":arm_generic_rs",
    "//zircon/kernel/lib/arch",
  ]
}
