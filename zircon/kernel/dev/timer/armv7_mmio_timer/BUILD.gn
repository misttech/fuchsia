import("//build/cpp/library_headers.gni")
import("//zircon/kernel/kernel_rust_mod.gni")

library_headers("headers") {
  headers = [ "dev/timer/armv7_mmio_timer.h" ]
}

kernel_rust_mod("armv7-mmio-timer-rs") {
  output_name = "armv7_mmio_timer"
  source_root = "armv7_mmio_timer.rs"
  sources = [
    "armv7_mmio_timer.rs",
    "debug.rs",
    "registers.rs",
  ]
  deps = [
    "//sdk/rust/zbi",
    "//sdk/rust/zx-status",
    "//sdk/rust/zx-types",
    "//src/lib/kalloc",
    "//src/lib/kprint",
    "//src/lib/ksync",
    "//src/lib/regio",
    "//src/lib/zr",
    "//third_party/rust_crates:pin-init",
    "//zircon/kernel/lib/arch:arch-rs",
    "//zircon/kernel/lib/debug",
    "//zircon/kernel/lib/root_resource_filter:root_resource_filter_rs",
    "//zircon/system/ulib/affine/rust:affine",
  ]
}

source_set("armv7_mmio_timer") {
  sources = []
  public_deps = [
    ":headers",
    "//sdk/lib/zbi-format",
    "//zircon/kernel/dev/interrupt",
    "//zircon/system/ulib/affine",
  ]
  deps = [ ":armv7-mmio-timer-rs" ]
}
