import("//zircon/kernel/kernel_rust_mod.gni")

kernel_rust_mod("intel_rng-rs") {
  output_name = "intel_rng"
  source_root = "intel_rng.rs"
  sources = [ "intel_rng.rs" ]
  deps = [
    "//sdk/rust/zx-status",
    "//src/lib/zr",
    "//zircon/kernel/lib/init:init_rust",
  ]
}

group("intel_rng") {
  deps = [
    ":intel_rng-rs",
    "//zircon/kernel/dev/hw_rng",
  ]
}
