import("//build/cpp/library_headers.gni")
import("//zircon/kernel/kernel_rust_mod.gni")

kernel_rust_mod("hw_rng-rs") {
  visibility = [ ":*" ]
  sources = [
    "console.rs",
    "hw_rng.rs",
  ]
  deps = [
    "//sdk/rust/zx-status",
    "//src/lib/kprint",
    "//src/lib/zr",
    "//third_party/rust_crates:zerocopy",
    "//zircon/kernel/lib/debug",
    "//zircon/system/ulib/pretty/rust:pretty",
  ]
}

source_set("hw_rng") {
  public_deps = [ ":headers" ]

  sources = [ "hw_rng_ffi.cc" ]
  deps = [ ":hw_rng-rs" ]
}

library_headers("headers") {
  headers = [ "dev/hw_rng.h" ]
}
