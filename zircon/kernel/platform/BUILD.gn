import("//build/cpp/library_headers.gni")
import("//build/zircon/zircon_cpu.gni")
import("//zircon/kernel/kernel_bindgen_crate.gni")
import("//zircon/kernel/kernel_rust_mod.gni")

source_set("platform") {
  public_deps = [ ":headers" ]

  sources = [
    "crashlog_ffi.cc",
    "debug.cc",
    "debug_ffi.cc",
    "efi.cc",
    "efi_bootbyte.cc",
    "efi_crashlog.cc",
    "mapped_crashlog.cc",
    "power_ffi.cc",
    "timer_ffi.cc",
  ]
  deps = [
    ":ffi",
    "//sdk/lib/zbi-format",
    "//src/lib/zbitl",
    "//zircon/kernel/dev/interrupt",
    "//zircon/kernel/dev/pdev/hw_watchdog",
    "//zircon/kernel/lib/boot-options",
    "//zircon/kernel/lib/cbuf",
    "//zircon/kernel/lib/code-patching:headers",
    "//zircon/kernel/lib/console",
    "//zircon/kernel/lib/counters",
    "//zircon/kernel/lib/crashlog",
    "//zircon/kernel/lib/debuglog",
    "//zircon/kernel/lib/init",
    "//zircon/kernel/lib/instrumentation:headers",
    "//zircon/kernel/lib/jtrace:headers",
    "//zircon/kernel/lib/ktl",
    "//zircon/kernel/lib/page",
    "//zircon/kernel/lib/persistent-debuglog",
    "//zircon/kernel/lib/root_resource_filter",
    "//zircon/kernel/lib/uart-gate:headers",
    "//zircon/kernel/phys/handoff",
    "//zircon/kernel/phys/lib/memalloc",
    "//zircon/system/ulib/affine:headers",
    "//zircon/system/ulib/fbl",
    "//zircon/system/ulib/ram-crashlog",
    "//zircon/system/ulib/zx",
  ]
}

library_headers("headers") {
  headers = [ "platform/uart.h" ]
}

source_set("tests") {
  testonly = true
  sources = [
    "debug_tests.cc",
    "efi_test.cc",
    "suspend_tests.cc",
  ]
  deps = [
    ":platform",
    "//zircon/kernel/lib/debuglog",
    "//zircon/kernel/lib/efi",
    "//zircon/kernel/lib/io",
    "//zircon/kernel/lib/unittest",
  ]
}

group("kernel-tests") {
  testonly = true
  deps = [ ":tests" ]
  if (current_cpu == "arm64") {
    deps += [ "generic-arm:kernel-tests" ]
  } else if (current_cpu == "riscv64") {
    deps += [ "generic-riscv64:kernel-tests" ]
  } else if (current_cpu == "x64") {
    deps += [ "pc:kernel-tests" ]
  }
}

source_set("ffi") {
  deps = [ "//zircon/kernel/lib/ktl" ]
}

kernel_bindgen_crate("halt-token-bindings") {
  visibility = [ ":*" ]
  headers = [ "//zircon/kernel/include/platform/halt_token.h" ]
  non_rust_deps = [ ":platform" ]
  cpp = true

  notice_year = 2026
  type_allowlist = [
    "HaltToken",
    "ktl::atomic",
    "std::atomic",
  ]
  type_blocklist = [ "Event" ]
  opaque_types = [
    "ktl::atomic",
    "std::atomic",
  ]
  function_blocklist = [ "HaltToken_.*" ]
  var_blocklist = [ "HaltToken_.*" ]
  additional_bindgen_flags = [ "--no-recursive-allowlist" ]
  deps = [ "//zircon/kernel/kernel:event-bindings" ]
  raw_lines = [
    "#![no_std]",
    "pub use event_bindings::Event;",
  ]
  expect_lints = [ "non_camel_case_types" ]
}

kernel_rust_mod("platform-rs") {
  output_name = "platform_rs"
  source_root = "platform.rs"
  sources = [
    "debug.rs",
    "halt_helper.rs",
    "halt_token.rs",
    "platform.rs",
    "power.rs",
    "timer.rs",
  ]
  test_deps = [ "//zircon/kernel/lib/unittest:unittest-rs" ]
  deps = [
    ":halt-token-bindings",
    "//sdk/rust/zx-status",
    "//sdk/rust/zx-types",
    "//src/lib/kprint",
    "//src/lib/ksync",
    "//src/lib/zr",
    "//zircon/kernel/lib/boot-options",
    "//zircon/kernel/lib/debug",
    "//zircon/system/ulib/affine/rust:affine",
  ]
}
