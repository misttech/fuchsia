import("//zircon/kernel/kernel_rust_mod.gni")
import("//zircon/kernel/params.gni")

kernel_rust_mod("generic-riscv64-rs") {
  output_name = "generic_riscv64"
  source_root = "src/mod.rs"
  sources = [
    "src/dev_init.rs",
    "src/mod.rs",
    "src/platform.rs",
    "src/timer.rs",
  ]
  deps = [
    "//sdk/rust/zbi",
    "//sdk/rust/zx-status",
    "//sdk/rust/zx-types",
    "//src/lib/kprint",
    "//src/lib/zr",
    "//zircon/kernel/lib/boot-options",
    "//zircon/kernel/lib/debug",
    "//zircon/kernel/lib/init:init_rust",
    "//zircon/system/ulib/fbl/rust:fbl",
  ]
  test_deps = [ "//zircon/kernel/lib/unittest:unittest-rs" ]
}

source_set("generic-riscv64") {
  sources = [ "generic_riscv64_ffi.cc" ]
  deps = [
    ":generic-riscv64-rs",
    "//src/lib/lazy_init",
    "//zircon/kernel/dev/interrupt/plic",
    "//zircon/kernel/dev/pdev/power",
    "//zircon/kernel/lib/topology",
    "//zircon/kernel/phys/handoff",
    "//zircon/kernel/platform:headers",
    "//zircon/system/ulib/ram-crashlog",
  ]

  public_deps = [ "//zircon/system/ulib/affine" ]
}

group("kernel-tests") {
  testonly = true
}
