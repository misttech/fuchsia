kernel_bindgen_crate("event-bindings") {
  visibility = [ "//zircon/kernel/*" ]
  headers = [ "//zircon/kernel/include/kernel/event_ffi.h" ]
  non_rust_deps = [ ":kernel" ]
  output_name = "event_bindings.rs"
  cpp = true

  edition = "2024"
  notice_year = 2026
  function_allowlist = [
    "cpp_event_.*",
    "cpp_autounsignal_event_.*",
  ]
  type_allowlist = [
    "Event",
    "AutounsignalEvent",
  ]
  type_blocklist = [
    "Deadline",
    "Interruptible",
    "OwnedWaitQueue",
    "zx_instant_mono_t",
    "zx_status_t",
  ]
  opaque_types = [
    "Event",
    "AutounsignalEvent",
  ]
  function_blocklist = [
    "Event_.*",
    "AutounsignalEvent_.*",
  ]
  additional_bindgen_flags = [ "--no-recursive-allowlist" ]
  deps = [ "//sdk/rust/zx-types" ]
  expect_lints = [
    "non_camel_case_types",
    "non_upper_case_globals",
  ]
  raw_lines = [
    "#![no_std]",
    "pub use zx_types::{zx_instant_mono_t, zx_status_t};",
    "pub type Deadline = core::ffi::c_void;",
    "pub type Interruptible = bool;",
    "pub type OwnedWaitQueue = core::ffi::c_void;",
  ]
}

