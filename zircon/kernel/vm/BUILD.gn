  cpp = true

  edition = "2024"
  notice_year = 2026

  type_allowlist = [ "PmmChecker" ]
  function_blocklist = [ "PmmChecker_.*" ]

  # bindgen emits enum-typed constexpr members as unresolvable extern statics,
  # so only the integer form of kDefaultAction is exposed.
  var_allowlist = [ "PmmChecker_kDefaultActionRaw" ]
  var_blocklist = [ "PmmChecker_kDefaultAction" ]
  type_blocklist = [
    "CheckFailAction",
    "PmmChecker_.*",
  ]
  additional_bindgen_flags = [ "--no-recursive-allowlist" ]
  deps = [ "//zircon/kernel/lib/boot-options:boot-options-rs" ]

  # pmm_checker.rs asserts that its PmmChecker matches the layout of this
  # binding, so check the binding against the C++ layout.
  layout_tests = true

  raw_lines = [
    "#![no_std]",
    "pub use boot_options::CheckFailAction;",
  ]
  expect_lints = [ "non_upper_case_globals" ]
}

