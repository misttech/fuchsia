    "pmm.cc",
    "pmm_arena.cc",
    "pmm_checker.cc",
    "pmm_ffi.cc",
    "pmm_node.cc",
    "ppb_command.cc",
    "scanner.cc",
    "scanner_ffi.cc",
    "slot_page_storage.cc",
    "stream_size_manager.cc",
    "vm.cc",
    "vm_address_region.cc",
    "vm_address_region_or_mapping.cc",
    "vm_aspace.cc",
    "vm_cow_pages.cc",
    "vm_cow_pages_ffi.cc",
    "vm_mapping.cc",
    "vm_object.cc",
    "vm_object_ffi.cc",
    "vm_object_paged.cc",
    "vm_object_paged_ffi.cc",
    "vm_object_physical.cc",
    "vm_page_list.cc",
    "vmm.cc",
  ]
  deps = [
    ":vm-rs",
    "//src/lib/zbitl",
    "//third_party/lz4",
    "//zircon/kernel/lib/arch",
    "//zircon/kernel/lib/boot-options",
    "//zircon/kernel/lib/btree",
    "//zircon/kernel/lib/console",
    "//zircon/kernel/lib/counters",
    "//zircon/kernel/lib/dump",
    "//zircon/kernel/lib/fbl",
    "//zircon/kernel/lib/heap/cmpctmalloc:headers",
    "//zircon/kernel/lib/init",
    "//zircon/kernel/lib/ktl",
    "//zircon/kernel/lib/ktrace",
    "//zircon/kernel/lib/page",
    "//zircon/kernel/lib/page_cache",
    "//zircon/kernel/lib/thread-stack",
    "//zircon/kernel/lib/user_copy",
    "//zircon/kernel/lib/userabi",
    "//zircon/kernel/phys:handoff",
    "//zircon/kernel/phys:zircon-abi-spec",
    "//zircon/kernel/phys/lib/memalloc:range",
    "//zircon/system/ulib/affine",
    "//zircon/system/ulib/ffl",
    "//zircon/system/ulib/lazy_init",
    "//zircon/system/ulib/pretty",
  ]

  defines = [
    "LZ4_STATIC_LINKING_ONLY",
    "LZ4_STATIC_LINKING_ONLY_DISABLE_MEMORY_ALLOCATION",
  ]

  # GCC figures out some cases where we have a global variable that's used as a
  # RefPtr and so appears like it might be passed to delete.  We always leak
  # the reference so it will never actually be called, but the compiler can't
  # figure that out statically so we must disable its warning.
  configs += [ ":suppress-nonheap-warning" ]
}

config("bindgen_common_config") {
  cflags = [ "-ffreestanding" ]
  defines = [
    "SMP_MAX_CPUS=$smp_max_cpus",
    "_KERNEL",
    "LK",
    "ZIRCON_TOOLCHAIN",
  ]
  include_dirs = [
    "//zircon/kernel/include",
    "//zircon/kernel/arch/$zircon_cpu/include",
    "//zircon/system/ulib/page_tables/include",
  ]
  if (current_cpu == "x64") {
    include_dirs += [ "//zircon/kernel/arch/x86/page_tables/include" ]
  }
}

group("bindgen_common_deps") {
  public_configs = [
    ":bindgen_common_config",
    "//build/config/fuchsia:compiler_fuchsia_api_level",
  ]
  public_deps = [
