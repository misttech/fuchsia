library_headers("headers") {
  headers = []
  public_deps = [
    "//zircon/kernel/dev/interrupt:headers",
    "//zircon/kernel/lib/debuglog:headers",

    # <object/dispatcher.h> has #include <ktl/unique_ptr.h>.
    "//zircon/kernel/lib/ktl:headers",

    # <object/port_dispatcher.h> has <lib/object_cache.h>.
    "//zircon/kernel/lib/object_cache:headers",

    # <object/log_dispatcher.h> and <object/counter_dispatcher.h> have #include
    # <lib/object-constants.h>.
    "//zircon/kernel/lib/object-constants:headers",

    # <object/clock_dispatcher.h> has #include <lib/page/size.h>.
    "//zircon/kernel/lib/page:headers",

    # <object/process_dispatcher.h> has #include <vm/vm_aspace.h>.
    "//zircon/kernel/vm:headers",
    "//zircon/system/ulib/affine",
  ]
}

source_set("tests") {
  testonly = true
  sources = [
    "test/exceptionate_tests.cc",
    "test/handle_tests.cc",
    "test/interrupt_event_dispatcher_tests.cc",
    "test/job_dispatcher_tests.cc",
    "test/process_dispatcher_tests.cc",
    "test/shareable_process_state_tests.cc",
    "test/state_tracker_tests.cc",
  ]
  deps = [
    ":headers",
    "//zircon/kernel/lib/console",
    "//zircon/kernel/lib/ktl",
    "//zircon/kernel/lib/unittest",
  ]
}

group("kernel-tests") {
  testonly = true
  deps = [ ":tests" ]
}

kernel_bindgen_crate("executor-bindings") {
  visibility = [ ":*" ]
  headers = [ "include/object/executor.h" ]
  non_rust_deps = [ ":headers" ]
  cpp = true

  edition = "2024"
  notice_year = 2026

  function_blocklist = [ ".*" ]
  type_allowlist = [
    "Executor",
    "HandleOwner",
    "MemoryWatchdog",
  ]
  type_blocklist = [ "MemoryWatchdog_.*" ]
  opaque_types = [
    "HandleOwner",
    "MemoryWatchdog",
    "fbl::RefPtr",
    "std::unique_ptr",
  ]
  additional_bindgen_flags = [ "--no-recursive-allowlist" ]
  raw_lines = [ "#![no_std]" ]
  expect_lints = []
}

