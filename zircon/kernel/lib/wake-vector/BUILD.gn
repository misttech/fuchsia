import("//build/cpp/library_headers.gni")
import("//zircon/kernel/kernel_rust_mod.gni")

library_headers("headers") {
  headers = [ "lib/wake-vector.h" ]
}

kernel_rust_mod("wake-vector-rs") {
  sources = [
    "wake_vector.rs",
    "wake_vector_ffi.rs",
  ]
  deps = [
    "//sdk/rust/zx-status",
    "//sdk/rust/zx-types",
    "//src/lib/ksync",
    "//src/lib/zr",
    "//third_party/rust_crates:pin-init",
    "//zircon/kernel/lib/arch:arch-rs",
    "//zircon/kernel/lib/libc:rust",
    "//zircon/system/ulib/fbl/rust:fbl",
  ]
}

source_set("wake-vector") {
  sources = [ "wake-vector_ffi.cc" ]
  public_deps = [ ":headers" ]
  deps = [ ":wake-vector-rs" ]
}

group("tests") {
  testonly = true
}

group("kernel-tests") {
  testonly = true
}

group("phys-tests") {
  testonly = true
}

group("boot_tests") {
  testonly = true
}
