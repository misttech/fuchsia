import("//build/cpp/library_headers.gni")
import("//build/rust/rustc_staticlib.gni")
import("//zircon/kernel/kernel_rust_mod.gni")

library_headers("headers") {
  headers = [
    "lib/cmpctmalloc.h",
    "lib/cmpctmalloc_ffi.h",
  ]
  public_deps = [
    # <lib/cmpctmalloc.h> has `#include <fbl/enum_bits.h>'.
    "//zircon/system/ulib/fbl",
  ]
}

source_set("cmpctmalloc") {
  public_deps = [ ":headers" ]

  if (is_host) {
    deps = [ ":cmpctmalloc-userspace-rs" ]
  }
}

if (is_kernel) {
  kernel_rust_mod("cmpctmalloc-rs") {
    sources = [
      "cmpctmalloc.rs",
      "cmpctmalloc_ffi.rs",
      "mod.rs",
    ]
    deps = [
      "//src/lib/kprint",
      "//src/lib/ksync",
      "//src/lib/zr",
      "//third_party/rust_crates:bitflags",
      "//zircon/kernel/lib/counters",
      "//zircon/kernel/lib/debug",
      "//zircon/kernel/lib/instrumentation/asan:asan-rs",
      "//zircon/kernel/lib/ktrace:ktrace-rs",
      "//zircon/kernel/lib/page:page-rs",
      "//zircon/system/ulib/pretty/rust:pretty",
    ]
  }
} else {
  rustc_staticlib("cmpctmalloc-userspace-rs") {
    edition = "2024"
    source_root = "mod.rs"
    sources = [
      "cmpctmalloc.rs",
      "cmpctmalloc_ffi.rs",
      "mod.rs",
    ]
    features = [ "userspace" ]
    configs += [ "//build/config/rust:debug_assertions" ]
    deps = [
      "//src/lib/ksync",
      "//src/lib/zr",
      "//third_party/rust_crates:bitflags",
      "//zircon/kernel/lib/page:page-rs",
    ]
  }
}

group("tests") {
  testonly = true
  deps = [ "tests" ]
}
