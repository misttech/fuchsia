import("//build/cpp/library_headers.gni")
import("//build/toolchain/toolchain_environment.gni")
import("//zircon/kernel/kernel_rust_mod.gni")

static_library("instrumentation") {
  public_deps = [ ":headers" ]

  sources = []
  if (toolchain_environment == "kernel") {
    sources += [ "vmo_ffi.cc" ]
    deps = [
      ":instrumentation-rs",
      ":private",
      ":profile",
      ":sancov",
      "asan",
      "ubsan:runtime",
      "//zircon/kernel/lib/heap",
      "//zircon/kernel/lib/ktl",
      "//zircon/kernel/lib/page",
      "//zircon/kernel/object",
      "//zircon/kernel/phys/handoff",
      "//zircon/system/ulib/fbl",
    ]
  }
}

library_headers("headers") {
  headers = []
}

group("tests") {
  testonly = true
}

group("boot_tests") {
  testonly = true
}

if (is_kernel) {
  kernel_rust_mod("instrumentation-rs") {
    sources = [
      "debugdata.rs",
      "instrumentation_ffi.rs",
      "kernel_mapped_vmo.rs",
      "memory_profile.rs",
      "mod.rs",
      "sancov.rs",
      "sancov_ffi.rs",
      "vmo.rs",
      "vmo_ffi.rs",
    ]
    deps = [
      "//sdk/rust/zx-status",
      "//sdk/rust/zx-types",
      "//src/lib/kprint",
      "//src/lib/lazy_init:lazy_init_rs",
      "//src/lib/zr",
      "//zircon/kernel/lib/heap:heap-rs",
      "//zircon/kernel/lib/page:page-rs",
      "//zircon/system/ulib/fbl/rust:fbl",
    ]
    test_deps = [ "//zircon/kernel/lib/unittest:unittest-rs" ]
  }

  group("kernel-tests") {
    testonly = true
    deps = [ "test:tests" ]
  }

  group("phys-tests") {
    testonly = true
  }

  source_set("private") {
    visibility = [ ":*" ]
    public = [ "private.h" ]
    public_deps = [
      ":instrumentation-rs",
      "//zircon/kernel/lib/ktl",
      "//zircon/kernel/vm:headers",
    ]
  }

  source_set("profile") {
    sources = [ "profile.cc" ]
    deps = [
      ":headers",
      ":private",
      "//src/lib/llvm-profdata",
      "//zircon/kernel/lib/ktl",
      "//zircon/kernel/lib/page",
      "//zircon/kernel/object",
      "//zircon/kernel/phys/handoff",
      "//zircon/kernel/vm:headers",
    ]
    defines = []
    if (is_pecoff) {
      # TODO(https://fxbug.dev/440394989) Support calling convention predefine
      # upstream for uefi triple.
      defines += [ "__MSVC_X86_64_CC__" ]
    }
  }

  source_set("sancov") {
    _sancov_config = [ "//build/config/sanitizers:sancov" ]
    if (configs + _sancov_config - _sancov_config != configs) {
      have_sancov = 1
    } else {
      have_sancov = 0
    }
    defines = [ "HAVE_SANCOV=$have_sancov" ]

    sources = [ "sancov_ffi.cc" ]
    deps = [
      ":headers",
      ":instrumentation-rs",
      ":private",
      "//zircon/kernel/lib/init",
      "//zircon/kernel/lib/ktl",
      "//zircon/kernel/vm:headers",
    ]

    # sancov code shouldn't make asan checks.
    # Annotating the functions with NO_ASAN is not enough, as it doesn't
    # allow for ktl::atomic operations to be inlined.
    _asan_config = [ "//build/config/sanitizers:asan" ]
    if (configs + _asan_config - _asan_config != configs) {
      configs -= _asan_config
    }
  }
}
