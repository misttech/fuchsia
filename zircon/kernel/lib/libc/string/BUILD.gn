import("//build/toolchain/toolchain_environment.gni")
import("//build/zircon/zircon_cpu.gni")

group("string") {
  deps = [ "//sdk/lib/c/string:kernel" ]

  # For the functions the compiler calls (memcpy, memmove, memset), the kernel
  # proper has special versions on some machines.
  if (toolchain_environment == "kernel" &&
      (zircon_cpu == "arm64" || zircon_cpu == "x86")) {
    deps += [ "arch/$zircon_cpu" ]
  } else {
    deps += [ "//sdk/lib/c/string:kernel-compiler" ]
  }
}
