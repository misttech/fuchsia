import("//build/cpp/library_headers.gni")
import("//zircon/kernel/kernel_rust_mod.gni")
import("params.gni")

static_library("crashlog") {
  public_deps = [ ":headers" ]

  complete_static_lib = true

  sources = [ "crashlog_ffi.cc" ]
  deps = [ ":crashlog-rs" ]
}

kernel_rust_mod("crashlog-rs") {
  sources = [
    "src/crashlog.rs",
    "src/panic_buffer.rs",
    "src/tests.rs",
  ]
  deps = [
    "//sdk/rust/zx-status",
    "//sdk/rust/zx-types",
    "//src/lib/kalloc",
    "//src/lib/kprint",
    "//src/lib/ksync",
    "//src/lib/zr",
    "//third_party/rust_crates:bitflags",
    "//zircon/kernel/lib/boot-options:boot-options-rs",
    "//zircon/kernel/lib/console:console_rs",
    "//zircon/kernel/lib/libc:rust",
    "//zircon/system/ulib/affine/rust:affine",
    "//zircon/system/ulib/fbl/rust:fbl",
  ]
  test_deps = [ "//zircon/kernel/lib/unittest:unittest-rs" ]
}

library_headers("headers") {
  headers = [ "lib/crashlog.h" ]
  public_configs = [ ":config" ]
}

config("config") {
  visibility = [ ":*" ]
  defines = [ "MIN_CRASHLOG_SIZE=$min_crashlog_size" ]
}

group("tests") {
  testonly = true
}

group("kernel-tests") {
  testonly = true
}

group("phys-tests") {
  testonly = true
}

group("boot_tests") {
  testonly = true
}
