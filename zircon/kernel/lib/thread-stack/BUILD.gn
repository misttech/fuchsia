import("//build/cpp/library_headers.gni")
import("//zircon/kernel/kernel_rust_mod.gni")

library_headers("headers") {
  headers = [ "lib/thread-stack/abi.h" ]
  public_deps = [
    "//zircon/system/public",

    # <lib/thread-stack.h> has #include <lib/page/size.h>
    "//zircon/kernel/lib/page:headers",

    # <lib/thread-stack/abi.h> has #include <phys/handoff/zircon-abi-spec.h>
    "//zircon/kernel/phys/handoff",
  ]
}

group("thread-stack") {
  public_deps = [ ":headers" ]
  deps = [ ":thread-stack-rs" ]
}

kernel_rust_mod("thread-stack-rs") {
  sources = [ "src/mod.rs" ]
  deps = [
    "//src/lib/zr",
    "//zircon/kernel/lib/page:page-rs",
    "//zircon/kernel/phys/handoff:handoff-rs",
  ]
  test_deps = [ "//zircon/kernel/lib/unittest:unittest-rs" ]
}

group("tests") {
  testonly = true
}

group("kernel-tests") {
  testonly = true
}

group("phys-tests") {
  testonly = true
}

group("boot_tests") {
  testonly = true
}
