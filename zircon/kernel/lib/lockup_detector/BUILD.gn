import("//build/cpp/library_headers.gni")
import("//zircon/kernel/kernel_rust_mod.gni")

static_library("lockup_detector") {
  public_deps = [ ":headers" ]

  sources = [
    "diagnostics.cc",
    "lockup_detector.cc",
  ]
  deps = [
    ":lockup_detector-rs",
    "//zircon/kernel/lib/backtrace",
    "//zircon/kernel/lib/boot-options",
    "//zircon/kernel/lib/counters",
    "//zircon/kernel/lib/crashlog",
    "//zircon/kernel/lib/page",
    "//zircon/kernel/object",
    "//zircon/system/ulib/affine",
  ]
}

kernel_rust_mod("lockup_detector-rs") {
  sources = [ "lockup_detector.rs" ]
  deps = [
    "//sdk/rust/zx-status",
    "//sdk/rust/zx-types",
    "//src/lib/kprint",
    "//src/lib/ksync",
    "//src/lib/zr",
    "//zircon/kernel/lib/console:console_rs",
  ]
}

library_headers("headers") {
  headers = []
  public_deps = [ "//zircon/kernel/lib/ktl:headers" ]
}

group("tests") {
  testonly = true
}

group("kernel-tests") {
  testonly = true
  deps = [ "tests" ]
}

group("phys-tests") {
  testonly = true
}

group("boot_tests") {
  testonly = true
}
