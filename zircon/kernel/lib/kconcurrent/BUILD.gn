import("//build/cpp/library_headers.gni")
import("//zircon/kernel/kernel_rust_mod.gni")

library_headers("headers") {
  headers = [
    "lib/kconcurrent/chainlock.h",
    "lib/kconcurrent/copy.h",
    "lib/kconcurrent/seqlock.h",
  ]

  public_deps = [
    "//src/lib/lockdep:headers",
    "//zircon/system/ulib/concurrent:headers",
    "//zircon/system/ulib/fbl:headers",
  ]
}

kernel_rust_mod("kconcurrent_rs") {
  sources = [
    "src/chainlock.rs",
    "src/chainlock_proof.rs",
    "src/chainlock_transaction.rs",
    "src/mod.rs",
  ]
  deps = [
    "//src/lib/ksync",
    "//src/lib/zr",
    "//zircon/kernel/lib/arch:arch-rs",
    "//zircon/system/ulib/affine/rust:affine",
    "//zircon/system/ulib/concurrent/rust:concurrent",
  ]
  test_deps = [ "//zircon/kernel/lib/unittest:unittest-rs" ]
}

source_set("kconcurrent") {
  sources = [
    "chainlock_transaction.cc",
    "seqlock.cc",
  ]
  public_deps = [ ":headers" ]
  deps = [
    ":kconcurrent_rs",
    "//src/lib/lockdep",
    "//zircon/kernel/lib/arch",
    "//zircon/kernel/lib/counters",
    "//zircon/system/ulib/affine",
    "//zircon/system/ulib/concurrent",
  ]
}

group("tests") {
  testonly = true
}

group("kernel-tests") {
  testonly = true
}

group("phys-tests") {
  testonly = true
}

group("boot_tests") {
  testonly = true
}
