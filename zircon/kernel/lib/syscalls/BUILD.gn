import("//zircon/kernel/kernel_rust_mod.gni")
import("//zircon/kernel/params.gni")

# This can be used for headers only by the vDSO and test code.
group("syscalls") {
  visibility = [ "//zircon/kernel/*" ]

  # Depend on the files generated by Zither.
  public_deps = [ "//zircon/vdso:private" ]

  if (!kernel_no_userabi) {
    deps = [
      ":dispatch",
      ":syscalls-rs",
    ]
  }
}

# Only this file depends on vdso-valid-sysret.h.
source_set("dispatch") {
  sources = [ "syscalls.cc" ]
  include_dirs = [ "include" ]
  deps = [
    "//zircon/kernel/lib/ktl",
    "//zircon/kernel/lib/userabi:headers",
    "//zircon/vdso:private",
  ]
}

group("tests") {
  testonly = true
}

group("kernel-tests") {
  testonly = true
}

group("phys-tests") {
  testonly = true
}

group("boot_tests") {
  testonly = true
}

kernel_rust_mod("syscalls-rs") {
  sources = [
    "bti.rs",
    "channel.rs",
    "clock.rs",
    "counter.rs",
    "cprng.rs",
    "debug.rs",
    "debuglog.rs",
    "driver.rs",
    "event.rs",
    "exceptions.rs",
    "fifo.rs",
    "futex.rs",
    "guest.rs",
    "handle_ops.rs",
    "interrupt.rs",
    "iob.rs",
    "iommu.rs",
    "job.rs",
    "membarrier.rs",
    "mod.rs",
    "msi.rs",
    "nanosleep.rs",
    "object.rs",
    "object_info.rs",
    "object_property.rs",
    "object_wait.rs",
    "pager.rs",
    "pmt.rs",
    "port.rs",
    "process.rs",
    "profile.rs",
    "resource.rs",
    "restricted.rs",
    "sampler.rs",
    "smc.rs",
    "socket.rs",
    "stream.rs",
    "system.rs",
    "system_x86.rs",
    "task.rs",
    "test.rs",
    "thread.rs",
    "ticks.rs",
    "timer.rs",
    "vcpu.rs",
    "vmar.rs",
    "vmo.rs",
  ]
  deps = [
    "macros:syscalls-macro",
    "//sdk/rust/zx-status",
    "//sdk/rust/zx-types",
    "//src/lib/kalloc",
    "//src/lib/ksync",
    "//src/lib/zr",
    "//third_party/rust_crates:pin-init",
    "//third_party/rust_crates:zerocopy",
    "//zircon/kernel/bin/rustenv_path",
    "//zircon/kernel/lib/arch:arch-rs",
    "//zircon/kernel/lib/boot-options:boot-options-rs",
    "//zircon/kernel/lib/crypto",
    "//zircon/kernel/lib/debug",
    "//zircon/kernel/lib/page:page-rs",
    "//zircon/kernel/lib/wake-vector:wake-vector-rs",
    "//zircon/system/ulib/explicit-memory:explicit-memory-rs",
    "//zircon/system/ulib/fbl/rust:fbl",
  ]
  public_deps = [ "//zircon/vdso:syscall-signatures" ]
  test_deps = [ "//zircon/kernel/lib/unittest:unittest-rs" ]
}
