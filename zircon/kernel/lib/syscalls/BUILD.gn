import("//build/cpp/library_headers.gni")
import("//build/zircon/zircon_cpu.gni")
import("//zircon/kernel/kernel_rust_mod.gni")
import("//zircon/kernel/params.gni")

library_headers("headers") {
  headers = [
    "lib/syscalls/forward.h",
    "lib/syscalls/safe-syscall-argument.h",
  ]

  # Depend on the files generated by Zither.
  public_deps = [ "//zircon/vdso:private" ]
}

# This can be used for headers only by the vDSO and test code.
source_set("syscalls") {
  visibility = [ "//zircon/kernel/*" ]

  public_deps = [ ":headers" ]

  if (!kernel_no_userabi) {
    deps = [ ":impl" ]
  }
}

source_set("impl") {
  visibility = [ ":*" ]
  sources = [
    "channel.cc",
    "clock.cc",
    "debug_ffi.cc",
    "driver.cc",
    "driver_${zircon_cpu}.cc",
    "exceptions.cc",
    "futex.cc",
    "handle_ops.cc",
    "hypervisor.cc",
    "iob.cc",
    "membarrier_ffi.cc",
    "object.cc",
    "object_info.cc",
    "object_property.cc",
    "object_wait.cc",
    "pager.cc",
    "port.cc",
    "resource.cc",
    "socket.cc",
    "stream.cc",
    "system.cc",
    "system_${zircon_cpu}.cc",
    "system_ffi.cc",
    "task.cc",
    "test.cc",
    "thread_ffi.cc",
    "vmar.cc",
    "vmo.cc",
    "zircon.cc",
  ]
  deps = [
    ":dispatch",
    ":headers",
    ":syscalls-rs",
    "//src/lib/zbitl",
    "//zircon/kernel/dev/iommu",
    "//zircon/kernel/lib/boot-options",
    "//zircon/kernel/lib/console",
    "//zircon/kernel/lib/counters",
    "//zircon/kernel/lib/crashlog",
    "//zircon/kernel/lib/crypto",
    "//zircon/kernel/lib/fbl",
    "//zircon/kernel/lib/heap",
    "//zircon/kernel/lib/io",
    "//zircon/kernel/lib/ktl",
    "//zircon/kernel/lib/ktrace",
    "//zircon/kernel/lib/page",
    "//zircon/kernel/lib/page-map",
    "//zircon/kernel/lib/persistent-debuglog",
    "//zircon/kernel/lib/power-management",
    "//zircon/kernel/lib/stall",
    "//zircon/kernel/lib/thread_sampler",
    "//zircon/kernel/lib/user_copy",
    "//zircon/kernel/lib/userabi:headers",
    "//zircon/kernel/lib/wake-vector",
    "//zircon/kernel/object",
    "//zircon/kernel/platform:headers",
    "//zircon/system/ulib/explicit-memory",
    "//zircon/system/ulib/region-alloc",
  ]
  if (current_cpu == "x64") {
    deps += [
      "//zircon/kernel/lib/acpi_lite",
      "//zircon/kernel/platform/pc",
    ]
  }
}

# Only this file depends on vdso-valid-sysret.h.
source_set("dispatch") {
  sources = [ "syscalls.cc" ]
  deps = [
    ":headers",
    "//zircon/kernel/lib/boot-options",
    "//zircon/kernel/lib/ktl",
    "//zircon/kernel/lib/userabi:headers",
  ]
}

group("tests") {
  testonly = true
}

group("kernel-tests") {
  testonly = true
}

group("phys-tests") {
  testonly = true
}

group("boot_tests") {
  testonly = true
}

kernel_rust_mod("syscalls-rs") {
  output_name = "syscalls_rs"
  source_root = "mod.rs"
  sources = [
    "counter.rs",
    "debug.rs",
    "debuglog.rs",
    "event.rs",
    "fifo.rs",
    "iommu.rs",
    "job.rs",
    "lib.rs",
    "membarrier.rs",
    "msi.rs",
    "object_wait.rs",
    "profile.rs",
    "restricted.rs",
    "sampler.rs",
    "system.rs",
    "task.rs",
    "test.rs",
    "thread.rs",
    "timer.rs",
  ]
  deps = [
    "macros:syscalls-macro",
    "//sdk/rust/zx-status",
    "//sdk/rust/zx-types",
    "//src/lib/kalloc",
    "//src/lib/zr",
    "//third_party/rust_crates:zerocopy",
    "//zircon/kernel/lib/boot-options:boot-options-rs",
    "//zircon/kernel/lib/counters:counters-rs",
    "//zircon/kernel/lib/debug",
    "//zircon/kernel/lib/page:page-rs",
    "//zircon/kernel/lib/user_copy:user-copy-rs",
    "//zircon/system/ulib/fbl/rust:fbl",
    "//zircon/vdso:private",
    "//zircon/vdso:syscall-signatures",
  ]
}
