import("//build/cpp/library_headers.gni")
import("//zircon/kernel/kernel_bindgen_crate.gni")
import("//zircon/kernel/kernel_rust_crate.gni")

static_library("efi") {
  visibility = [
    "//src/firmware/gigaboot/*",
    "//src/lib/zbitl/*",
    "//zircon/kernel/*",
  ]

  public_deps = [ ":headers" ]

  sources = [ "guids.c" ]
}

source_set("efi-bindgen-c") {
  visibility = [ ":*" ]
  sources = [ "efi_bindgen.c" ]
  deps = [ ":headers" ]
}

kernel_bindgen_crate("efi-bindings") {
  visibility = [ ":*" ]
  notice_year = 2026
  headers = [ "efi_bindgen.h" ]
  non_rust_deps = [ ":headers" ]

  type_allowlist = [
    "efi_guid",
    "efi_status",
  ]
  var_allowlist = [
    "EFI_VARIABLE_.*",
    "ZIRCON_CRASHLOG_EFIATTR",
    "kEfi.*",
  ]

  std_derives = [
    "eq",
    "partialeq",
  ]

  expect_lints = [
    "non_camel_case_types",
    "non_upper_case_globals",
  ]

  raw_lines = [ "#![no_std]" ]
}

kernel_rust_crate("efi-rs") {
  crate_name = "efi"
  sources = [ "src/lib.rs" ]
  deps = [
    ":efi-bindgen-c",
    ":efi-bindings",
  ]
}

library_headers("headers") {
  headers = [
    "efi/boot-services.h",
    "efi/global-variable.h",
    "efi/protocol/block-io.h",
    "efi/protocol/device-path-to-text.h",
    "efi/protocol/device-path.h",
    "efi/protocol/disk-io.h",
    "efi/protocol/driver-binding.h",
    "efi/protocol/file.h",
    "efi/protocol/graphics-output.h",
    "efi/protocol/ip6.h",
    "efi/protocol/loaded-image.h",
    "efi/protocol/managed-network.h",
    "efi/protocol/pci-root-bridge-io.h",
    "efi/protocol/serial-io.h",
    "efi/protocol/service-binding.h",
    "efi/protocol/serial-io.h",
    "efi/protocol/shell-parameters.h",
    "efi/protocol/simple-file-system.h",
    "efi/protocol/simple-network.h",
    "efi/protocol/simple-text-input.h",
    "efi/protocol/simple-text-output.h",
    "efi/protocol/tcg2.h",
    "efi/protocol/tcp6.h",
    "efi/protocol/usb-io.h",
    "efi/runtime-services.h",
    "efi/system-table.h",
    "efi/types.h",
    "efi/zircon.h",
  ]
  public_deps = [
    # All headers use `#include <zircon/compiler.h>`.
    "//zircon/system/public",
  ]
}

group("tests") {
  testonly = true
  deps = [
    "string:tests",
    "testing:efi_testing_test($host_toolchain)",
    "variable:tests",
  ]
}

group("kernel-tests") {
  testonly = true
}

group("phys-tests") {
  testonly = true
}

group("boot_tests") {
  testonly = true
}
