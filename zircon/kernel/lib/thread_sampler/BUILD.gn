import("//build/cpp/library_headers.gni")
import("//zircon/kernel/kernel_rust_mod.gni")

library_headers("headers") {
  headers = [
    "lib/thread_sampler/thread_sampler.h",
    "lib/thread_sampler/thread_sampler_ffi.h",
  ]
  public_deps = [
    "//zircon/kernel/lib/arch:headers",
    "//zircon/system/ulib/zx",
  ]
}

kernel_rust_mod("thread_sampler-rs") {
  sources = [
    "thread_sampler.rs",
    "thread_sampler_ffi.rs",
  ]
  deps = [
    "//sdk/rust/zx-status",
    "//sdk/rust/zx-types",
    "//src/lib/kprint",
    "//src/lib/ksync",
    "//src/lib/lockdep",
    "//third_party/rust_crates:zerocopy",
    "//zircon/kernel/lib/percpu_writer:percpu_writer-rs",
    "//zircon/system/ulib/fbl/rust:fbl",
  ]
  test_deps = [
    "//zircon/kernel/lib/page:page-rs",
    "//zircon/kernel/lib/unittest:unittest-rs",
  ]
}

group("thread_sampler") {
  public_deps = [ ":headers" ]
  deps = [ ":thread_sampler-rs" ]
}

group("tests") {
  testonly = true
}

group("kernel-tests") {
  testonly = true
  deps = [ "tests" ]
}

group("phys-tests") {
  testonly = true
}

group("boot_tests") {
  testonly = true
}
