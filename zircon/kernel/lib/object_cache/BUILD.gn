import("//build/cpp/library_headers.gni")
import("//zircon/kernel/kernel_rust_mod.gni")

kernel_rust_mod("object_cache-rs") {
  sources = [
    "src/ffi.rs",
    "src/lib.rs",
  ]
  deps = [
    "//sdk/rust/zx-status",
    "//src/lib/ksync",
    "//src/lib/zr",
    "//third_party/rust_crates:pin-init",
    "//zircon/kernel/lib/page:page-rs",
    "//zircon/system/ulib/fbl/rust:fbl",
  ]
  test_deps = [ "//zircon/kernel/lib/unittest:unittest-rs" ]
}

source_set("object_cache") {
  public_deps = [ ":headers" ]
  deps = [ ":object_cache-rs" ]
}

library_headers("headers") {
  headers = [ "lib/object_cache.h" ]
  public_deps = [
    "//zircon/kernel/lib/ktl:headers",

    # <lib/object_cache.h> has #include <lib/page/size.h>
    "//zircon/kernel/lib/page:headers",

    # <lib/object_cache.h> has #include <vm/pmm.h>.
    "//zircon/kernel/vm:headers",
  ]
}

group("tests") {
  testonly = true
}

group("kernel-tests") {
  testonly = true
  deps = [ "tests" ]
}

group("phys-tests") {
  testonly = true
}

group("boot_tests") {
  testonly = true
}
