import("//build/cpp/library_headers.gni")
import("//zircon/kernel/kernel_rust_mod.gni")

library_headers("headers") {
  headers = [ "lib/control-region.h" ]
  public_deps = [
    "//src/lib/lockdep:headers",
    "//zircon/kernel/lib/ktl:headers",
  ]
}

kernel_rust_mod("control-region-rs") {
  sources = [
    "control_region.rs",
    "control_region_ffi.rs",
  ]
  deps = [
    "//src/lib/ksync",
    "//src/lib/zr",
    "//third_party/rust_crates:pin-init",
    "//zircon/kernel/lib/arch:arch-rs",
  ]
}

group("control-region") {
  public_deps = [
    ":control-region-rs",
    ":headers",
  ]
}

kernel_rust_mod("control-region-tests") {
  testonly = true
  sources = [ "tests/kernel.rs" ]
  deps = [ ":control-region-rs" ]
  test_deps = [
    "//src/lib/kprint",
    "//third_party/rust_crates:pin-init",
    "//zircon/kernel/lib/arch:arch-rs",
    "//zircon/kernel/lib/unittest:unittest-rs",
  ]
}

group("tests") {
  testonly = true
}

group("kernel-tests") {
  testonly = true
  deps = [ ":control-region-tests" ]
}

group("phys-tests") {
  testonly = true
}

group("boot_tests") {
  testonly = true
}
