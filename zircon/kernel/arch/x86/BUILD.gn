library_headers("headers") {
  headers = []
  public_deps = [
    # <arch/x86/system_topology.h> has #include <arch/x86/cpuid.h>.
    "//zircon/kernel/arch/x86/cpuid:headers",

    # <arch/x86/apic.h has #include <dev/interrupt.h>.
    # <arch/x86/apic.h> has #include <dev/interrupt.h>.
    "//zircon/kernel/dev/interrupt:headers",

    # <arch/x86/hypervisor.h> has #include <hypervisor/aspace.h>.
    "//zircon/kernel/hypervisor:headers",

    # <arch/x86/hypervisor.h> has #include <lib/id_allocator.h>.
    "//zircon/kernel/lib/id_allocator:headers",

    # <arch/x86/bootstrap16.h> has #include <lib/page/size.h>
    # <arch/x86/pv.h> has #include <lib/page/size.h>
    # <arch/aspace.h> has #include <lib/page/size.h>
    "//zircon/kernel/lib/page:headers",

    # <arch/aspace.h> has #include <bitmap/rle-bitmap.h>.
    # <arch/x86/ioport.h> has #include <bitmap/rle-bitmap.h>.
    "//zircon/system/ulib/bitmap:headers",

    # <arch/aspace.h> uses various fbl things
    "//zircon/system/ulib/fbl:headers",

    # <arch/x86/idle_states.h> has #include <ktl/atomic.h>.
    "//zircon/kernel/lib/ktl:headers",

    # <arch/x86.h> has #include <lib/arch/intrin.h>.
    "//zircon/kernel/lib/arch:headers",
  ]
}

source_set("syscall") {
  sources = [ "syscall.S" ]
  deps = [
    "//zircon/kernel/lib/code-patching:headers",
    "//zircon/kernel/lib/syscalls",
  ]
}

kernel_bindgen_crate("arch-x86-vm-bindings") {
  headers = [ "include/arch/vm.h" ]
  cpp = true
  non_rust_deps = [ ":headers" ]
  raw_lines = [ "#![no_std]" ]
  var_allowlist = [ "kX86CanonicalAddressMask" ]
  expect_lints = [ "non_upper_case_globals" ]
  notice_year = 2026
}

kernel_bindgen_crate("arch-x86-aspace-bindings") {
  headers = [
    "include/arch/kernel_aspace.h",
    "include/arch/x86/mmu.h",
  ]
  cpp = true
  non_rust_deps = [
    ":headers",
    "page_tables:headers",
  ]
  raw_lines = [ "#![no_std]" ]
  var_allowlist = [
    "KERNEL_ASPACE_BASE",
    "KERNEL_ASPACE_SIZE",
    "MMU_GUEST_SIZE_SHIFT",
    "USER_ASPACE_BASE",
    "USER_ASPACE_SIZE",
    "USER_RESTRICTED_ASPACE_SIZE",
  ]
  notice_year = 2026
}

