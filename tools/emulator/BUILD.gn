import("//build/tools/bazel2gn/bazel_migration.gni")

if (is_host) {
  go_library("emulator") {
    testonly = true
    sources = [ "emulator.go" ]
    visibility = [
      "./*",
      "//bundles/buildbot/core:*",
      "//src/connectivity/network/testing/conformance/emulator:*",
      "//src/tests/*",
      "//third_party/network-conformance/orchestrator:*",
    ]
    deps = [
      "//tools/lib/productbundle",
      "//tools/qemu",
      "//tools/virtual_device",
      "//tools/virtual_device:proto",
    ]
    data_deps = [
      ":test_data(${toolchain_variant.base})",
      "//src/storage/lib/sparse/rust:simg2img_sources",
    ]
  }
}
if (is_host) {
  go_test("emulator_tests") {
    sources = [ "emulator_test.go" ]
    embed = [ ":emulator" ]
    visibility = [
      ":*",
      "//tools:*",
    ]
  }
}
