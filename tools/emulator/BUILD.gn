import("//build/bazel/bazel_build_action.gni")
import("//build/testing/host_test_data.gni")

group("tests") {
  testonly = true
  deps = [ ":emulator_tests($host_toolchain)" ]
}

if (is_host) {
  if (current_toolchain == toolchain_variant.base) {
    # The infrastructure does not provide a way for host tests to access
    # qemu, so we need to archive our own copy of qemu from the source
    # tree. The archives are built by Bazel (see BUILD.bazel) and copied here
    # so that GN host tests and Bazel host tests share a single copy.
    bazel_build_action("archives") {
      testonly = true
      visibility = [ ":*" ]
      bazel_config = "host"
      bazel_target = "//tools/emulator:archives"
      ninja_base_dir = "$root_out_dir/test_data/emulator"
      copy_outputs = [
        {
          bazel = "{{BAZEL_TARGET_OUT_DIR}}/qemu.tar.gz"
          ninja = "qemu.tar.gz"
        },
        {
          bazel = "{{BAZEL_TARGET_OUT_DIR}}/femu.tar.gz"
          ninja = "femu.tar.gz"
        },
      ]
    }

    generated_file("buildinfo.ini") {
      testonly = true
      contents = [ "target_cpu=$target_cpu" ]
      outputs = [ "$root_out_dir/test_data/emulator/buildinfo.ini" ]
    }

    host_test_data("test_data") {
      sources = get_target_outputs(":buildinfo.ini") + [
                  "$root_out_dir/test_data/emulator/femu.tar.gz",
                  "$root_out_dir/test_data/emulator/qemu.tar.gz",
                ]

      deps = [
        ":archives",
        ":buildinfo.ini",
      ]
    }
  }
}

