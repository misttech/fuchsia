load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@fuchsia_build_config//:defs.bzl", "build_config")
load("@fuchsia_build_info//:args.bzl", "target_cpu")
load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules:cipd_prebuilt.bzl", "cipd_prebuilt_directory")
load("//build/bazel/rules/host_tests:host_go_test.bzl", "host_go_test")
load("//build/bazel/rules/host_tests:host_test_data.bzl", "host_test_data_files")
load(":emulator_archive.bzl", "emulator_archive")

package(default_applicable_licenses = ["//:license"])

# @bazel2gn:skip
cipd_prebuilt_directory(
    name = "prebuilt_qemu",
    testonly = True,
    path = "//prebuilt/third_party/qemu/%s" % build_config.host_tag,
    target_compatible_with = HOST_OS_CONSTRAINTS,
)

# @bazel2gn:skip
cipd_prebuilt_directory(
    name = "prebuilt_femu",
    testonly = True,
    path = "//prebuilt/third_party/android/aemu/release-gfxstream/%s" % build_config.host_tag,
    target_compatible_with = HOST_OS_CONSTRAINTS,
)

# @bazel2gn:skip
emulator_archive(
    name = "qemu",
    testonly = True,
    src = ":prebuilt_qemu",
    target_compatible_with = HOST_OS_CONSTRAINTS,
)

# @bazel2gn:skip
emulator_archive(
    name = "femu",
    testonly = True,
    src = ":prebuilt_femu",
    target_compatible_with = HOST_OS_CONSTRAINTS,
)

# Built by the GN `:archives` bazel_build_action() and copied into the Ninja
# build dir for GN host tests.
# @bazel2gn:skip
filegroup(
    name = "archives",
    testonly = True,
    srcs = [
        ":femu",
        ":qemu",
    ],
    target_compatible_with = HOST_OS_CONSTRAINTS,
)

# @bazel2gn:skip
write_file(
    name = "buildinfo.ini",
    testonly = True,
    out = "gen/buildinfo.ini",
    content = ["target_cpu=%s" % target_cpu],
    target_compatible_with = HOST_OS_CONSTRAINTS,
)

host_test_data_files(
    name = "test_data",
    testonly = True,
    srcs = [
        ":buildinfo.ini",
        ":femu",
        ":qemu",
    ],
    dest_dir = "test_data/emulator",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = [":__subpackages__"],
)

# The emulator itself should only be included via the base toolchain, not
# any toolchain variant (such as sanitizers).
# @bazel2gn:raw_attribute:data_deps = [ ":test_data(${toolchain_variant.base})", "//src/storage/lib/sparse/rust:simg2img_sources" ]
go_library(
    name = "emulator",
    testonly = True,
    srcs = ["emulator.go"],
    importpath = "go.fuchsia.dev/fuchsia/tools/emulator",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = [
        ":__subpackages__",
        # For e2e_test_libs in //build/config/BUILDCONFIG.gn.
        "//bundles/buildbot/core:__pkg__",
        "//src/connectivity/network/testing/conformance/emulator:__pkg__",
        "//src/tests:__subpackages__",
        "//third_party/network-conformance/orchestrator:__pkg__",
    ],
    deps = [
        "//tools/lib/productbundle",
        "//tools/qemu",
        "//tools/virtual_device",
        "//tools/virtual_device:proto",
    ],
)

host_go_test(
    name = "emulator_tests",
    srcs = ["emulator_test.go"],
    embed = [":emulator"],
    visibility = ["//tools:__pkg__"],
)
