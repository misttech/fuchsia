import("//build/tools/bazel2gn/bazel_migration.gni")

if (is_host) {
  rustc_binary("generate_config_bin") {
    sources = [ "src/main.rs" ]
    output_name = "generate_config"
    edition = "2024"
    visibility = [
      ":*",
      "//build/component:*",
      "//src/sys/component_manager/*",
    ]
    deps = [
      "//src/lib/assembly/component_manager_config",
      "//third_party/rust_crates:argh",
      "//tools/lib/cml",
    ]
  }
}
if (is_host) {
  rustc_test("generate_config_bin_test") {
    sources = [ "src/main.rs" ]
    edition = "2024"
    deps = [
      "//src/lib/assembly/component_manager_config",
      "//third_party/rust_crates:argh",
      "//tools/lib/cml",
    ]
    source_root = "src/main.rs"
    visibility = [
      ":*",
      "//tools:*",
    ]
  }
}
