"""A macro for generating a Rust library from protobuf definitions using prost.

This is the Bazel equivalent of the GN `rust_proto_library()` template in
//tools/protobuf/rust_proto_library.gni, and bazel2gn converts it to that
template.
"""

load("//build/bazel/rules/rust:defs.bzl", "rustc_library")

visibility([
    "//src/starnix/modules/perfetto_consumer/lib/perfetto/...",
    "//src/sys/pkg/lib/update-package/...",
])

def _include_dir_to_exec_path(include_dir):
    """Converts a source-absolute GN-style directory to an execroot path."""
    if not include_dir.startswith("//"):
        fail("rust_proto_library() include_dirs must be source-absolute paths " +
             "starting with \"//\", got: %s" % include_dir)
    path = include_dir[2:].rstrip("/")
    return path if path else "."

def rust_proto_library(
        name,
        srcs,
        packages,
        include_dirs = [],
        proto_deps = [],
        deps = [],
        target_compatible_with = None,
        testonly = None,
        visibility = None,
        tags = None):
    """Generates a Rust library from .proto files using prost-build.

    The generated crate is named after `name`, and exposes one module per
    protobuf package, e.g. package `foo.bar` is available as `crate::foo::bar`.

    Args:
        name: Name of the generated rustc_library target.
        srcs: List of .proto files to compile.
        packages: List of protobuf package names generated by the .proto files
            and the files they import. Each package produces one `<package>.rs`
            file, and they must be listed exhaustively.
        include_dirs: Directories in which to search for imported .proto files,
            as source-absolute paths (e.g. "//third_party/perfetto"). The
            directories of `srcs` are always searched. Same as `include_dirs`
            in GN.
        proto_deps: .proto files (or filegroups of them) that are imported by
            `srcs` but not compiled directly. They are made available to the
            code generator so it can run sandboxed. This attribute is
            Bazel-only, because the GN template discovers imports through a
            depfile instead.
        deps: Additional crate dependencies for the generated library. The
            prost runtime is always included.
        target_compatible_with: Platform constraints for the targets.
        testonly: Whether the targets are testonly.
        visibility: Visibility of the generated library.
        tags: Tags for the generated targets.
    """
    gen_name = "gen_" + name
    lib_rs = "{}/lib.rs".format(name)
    outs = [lib_rs] + ["{}/{}.rs".format(name, pkg) for pkg in packages]

    args = [
        "$(execpath //tools/protobuf/rust_proto:prost_build_standalone)",
        "--protoc",
        "$(execpath @com_google_protobuf//:protoc)",
        "--out-dir",
        "$(RULEDIR)/" + name,
    ]
    for include_dir in include_dirs:
        args += ["--include-dirs", _include_dir_to_exec_path(include_dir)]
    for src in srcs:
        args += ["--protos", "$(execpath {})".format(src)]

    native.genrule(
        name = gen_name,
        srcs = srcs + proto_deps,
        outs = outs,
        cmd = "mkdir -p $(RULEDIR)/{} && {}".format(name, " ".join(args)),
        tools = [
            "//tools/protobuf/rust_proto:prost_build_standalone",
            "@com_google_protobuf//:protoc",
        ],
        target_compatible_with = target_compatible_with,
        testonly = testonly,
        tags = tags,
        visibility = ["//visibility:private"],
    )

    rustc_library(
        name = name,
        srcs = outs,
        crate_root = lib_rs,
        # This code is generated by prost, so there is not much point in
        # reporting lint violations in it.
        disable_clippy = True,
        edition = "2024",
        target_compatible_with = target_compatible_with,
        testonly = testonly,
        tags = tags,
        visibility = visibility,
        deps = [
            "//third_party/rust_crates/vendor:prost",
        ] + deps,
    )
