load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("@platforms//host:constraints.bzl", "HOST_CONSTRAINTS")
load("//build/bazel/rules/host:defs.bzl", "go_binary_host_tool")
load("//build/bazel/rules/host_tests:host_go_test.bzl", "host_go_test")
load("//build/bazel/rules/host_tests:host_test_data.bzl", "host_test_data_files")

package(default_applicable_licenses = ["//:license"])

go_library(
    name = "lib",
    srcs = [
        "client.go",
        "fixture.go",
        "lib.go",
    ],
    importpath = "go.fuchsia.dev/fuchsia/tools/testing/resultdb",
    target_compatible_with = HOST_CONSTRAINTS,
    deps = [
        "//third_party/golibs:google.golang.org/protobuf/encoding/protojson",
        "//third_party/golibs:google.golang.org/protobuf/proto",
        "//third_party/golibs:google.golang.org/protobuf/types/known/durationpb",
        "//third_party/golibs:google.golang.org/protobuf/types/known/structpb",
        "//third_party/golibs:google.golang.org/protobuf/types/known/timestamppb",
        "//third_party/luci-go/resultdb/proto/v1:resultdb_proto_go",
        "//third_party/luci-go/resultdb/sink/proto/v1:resultsink_proto_go",
        "//tools/build",
        "//tools/testing/runtests",
    ],
)

go_library(
    name = "main",
    srcs = [
        "cmd/main.go",
    ],
    importpath = "go.fuchsia.dev/fuchsia/tools/testing/resultdb/cmd",
    target_compatible_with = HOST_CONSTRAINTS,
    deps = [
        ":lib",
        "//third_party/luci-go/resultdb/proto/v1:resultdb_proto_go",
        "//third_party/luci-go/resultdb/sink/proto/v1:resultsink_proto_go",
        "//tools/lib/flagmisc",
    ],
)

go_binary_host_tool(
    name = "resultdb",
    embed = [":main"],
    target_compatible_with = HOST_CONSTRAINTS,
)

host_test_data_files(
    name = "resultdb_testdata",
    srcs = glob(["testdata/**"]),
    dest_dir = "testdata",
)

host_go_test(
    name = "resultdb_lib_tests",
    srcs = [
        "client_test.go",
        "fixture_test.go",
        "lib_test.go",
    ],
    embed = [":lib"],
    target_compatible_with = HOST_CONSTRAINTS,
    test_args = ["-test_data_dir=testdata"],
    test_data = [":resultdb_testdata"],
    visibility = ["//tools:__pkg__"],
    deps = [
        "//third_party/golibs:github.com/google/go-cmp/cmp",
        "//third_party/golibs:github.com/google/go-cmp/cmp/cmpopts",
        "//third_party/golibs:google.golang.org/protobuf/encoding/protojson",
        "//third_party/golibs:google.golang.org/protobuf/proto",
        "//third_party/golibs:google.golang.org/protobuf/testing/protocmp",
        "//third_party/golibs:google.golang.org/protobuf/types/known/structpb",
        "//third_party/luci-go/resultdb/proto/v1:resultdb_proto_go",
        "//third_party/luci-go/resultdb/sink/proto/v1:resultsink_proto_go",
        "//tools/build",
        "//tools/integration/testsharder:metadata",
        "//tools/testing/runtests",
    ],
)

host_go_test(
    name = "resultdb_main_tests",
    srcs = [
        "cmd/main_test.go",
    ],
    embed = [":main"],
    target_compatible_with = HOST_CONSTRAINTS,
    visibility = ["//tools:__pkg__"],
    deps = [
        "//third_party/golibs:github.com/google/go-cmp/cmp",
        "//third_party/golibs:google.golang.org/protobuf/testing/protocmp",
        "//third_party/luci-go/resultdb/proto/v1:resultdb_proto_go",
    ],
)
