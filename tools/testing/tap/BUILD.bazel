load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_go_test.bzl", "host_go_test")

package(default_applicable_licenses = ["//:license"])

go_library(
    name = "tap",
    srcs = [
        "doc.go",
        "parser.go",
        "producer.go",
        "tap.go",
    ],
    importpath = "go.fuchsia.dev/fuchsia/tools/testing/tap",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//:__subpackages__"],
    deps = [
        ":tokenizer",
    ],
)

go_library(
    name = "tokenizer",
    srcs = [
        "tokenizer/iterator.go",
        "tokenizer/lexer.go",
        "tokenizer/stream.go",
    ],
    importpath = "go.fuchsia.dev/fuchsia/tools/testing/tap/tokenizer",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//:__subpackages__"],
)

# TODO(https://fxbug.dev/574121341): Run this test in GN too.
# @bazel2gn:skip
host_go_test(
    name = "tap_tests",
    srcs = [
        "parser_test.go",
        "producer_test.go",
    ],
    embed = [":tap"],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//tools:__pkg__"],
    deps = [
        "//third_party/golibs:gopkg.in/yaml.v2",
    ],
)
