if (is_host) {
  go_library("tap") {
    sources = [
      "doc.go",
      "parser.go",
      "producer.go",
      "tap.go",
    ]
    visibility = [ "//*" ]
    deps = [ ":tokenizer" ]
  }
}
if (is_host) {
  go_library("tokenizer") {
    sources = [
      "tokenizer/iterator.go",
      "tokenizer/lexer.go",
      "tokenizer/stream.go",
    ]
    visibility = [ "//*" ]
  }
}
if (is_host) {
  go_test("tap_tests") {
    sources = [
      "parser_test.go",
      "producer_test.go",
    ]
    embed = [ ":tap" ]
    visibility = [
      ":*",
      "//tools:*",
    ]
    deps = [ "//third_party/golibs:gopkg.in/yaml.v2" ]
  }
}
