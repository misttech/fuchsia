#### CATEGORY=Other
### list attached usb disks

case "$(uname)" in
Linux)
  for disk in $(ls /dev/disk/by-path/*-usb-* 2>/dev/null); do
    if [[ "${disk}" =~ part ]]; then
      continue
    fi
    disk=$(readlink -f "${disk}")
    details="$(cat /sys/block/$(basename "${disk}")/device/model)"
    echo "${disk} - ${details}"
  done
  ;;
*)
  echo "Unsupported platform $(uname)"
  exit 1
  ;;
esac
