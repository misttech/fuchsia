import("//build/python/python_host_test.gni")

if (is_host) {
  python_host_test("scm_test") {
    main_source = "scm_test.py"
    sources = [ "scm.py" ]
  }

  python_host_test("shac_runner_test") {
    main_source = "shac_runner_test.py"
    sources = [
      "scm.py",
      "shac_runner.py",
    ]
  }
}

group("tests") {
  testonly = true
  deps = [
    ":scm_test($host_toolchain)",
    ":shac_runner_test($host_toolchain)",
  ]
}
