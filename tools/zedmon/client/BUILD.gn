import("//build/bazel/bazel_host_tool.gni")

if (is_host) {
  bazel_host_tool("bin") {
    bazel_target = ":bin"
    bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/bin"
    output_name = "zedmon"
    install_host_tool = true
  }
}

group("zedmon_client") {
  deps = [ ":bin($host_toolchain)" ]
}

group("client") {
  deps = [ ":zedmon_client" ]
}
