# A forwarding target to the Bazel-built debugsyms host tool.
group("debugsyms") {
  public_deps = [ ":host" ]
}

group("host") {
  public_deps = [ "//build/bazel/host:bazel_root_host_tools.debugsyms.host_tool($host_toolchain)" ]
}
