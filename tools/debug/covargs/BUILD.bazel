load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("@platforms//host:constraints.bzl", "HOST_CONSTRAINTS")
load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host:defs.bzl", "go_binary_host_tool")
load("//build/bazel/rules/host_tests:host_go_test.bzl", "host_go_test")

package(default_applicable_licenses = ["//:license"])

go_library(
    name = "codecoverage_api",
    srcs = [
        "api/third_party/codecoverage/code_coverage.pb.go",
    ],
    importpath = "go.fuchsia.dev/fuchsia/tools/debug/covargs/api/third_party/codecoverage",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = [
        "//third_party/golibs:google.golang.org/protobuf/proto",
        "//third_party/golibs:google.golang.org/protobuf/reflect/protoreflect",
        "//third_party/golibs:google.golang.org/protobuf/runtime/protoimpl",
    ],
)

go_library(
    name = "llvm_api",
    srcs = [
        "api/llvm/doc.go",
        "api/llvm/llvm.go",
    ],
    importpath = "go.fuchsia.dev/fuchsia/tools/debug/covargs/api/llvm",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = [
        "//src/tests/coverage:__pkg__",
        "//src/tests/early-boot-coverage/host-test:__pkg__",
    ],
)

go_library(
    name = "covargs_lib",
    srcs = [
        "common.go",
        "report.go",
    ],
    importpath = "go.fuchsia.dev/fuchsia/tools/debug/covargs",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//tools/testing/testrunner:__pkg__"],
    deps = [
        ":codecoverage_api",
        ":llvm_api",
        "//third_party/golibs:golang.org/x/sync/errgroup",
        "//third_party/golibs:google.golang.org/protobuf/encoding/protojson",
        "//third_party/golibs:google.golang.org/protobuf/proto",
        "//tools/debug/symbolize:symbolize_lib",
        "//tools/lib/logger",
        "//tools/testing/runtests",
    ],
)

# covargs binary and its main package are Bazel-only.
# @bazel2gn:skip
go_library(
    name = "main",
    srcs = [
        "cmd/main.go",
    ],
    importpath = "go.fuchsia.dev/fuchsia/tools/debug/covargs/main",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = [
        ":covargs_lib",
        ":llvm_api",
        "//third_party/golibs:golang.org/x/sync/errgroup",
        "//tools/debug/symbolize:symbolize_lib",
        "//tools/lib/cache",
        "//tools/lib/color",
        "//tools/lib/flagmisc",
        "//tools/lib/logger",
        "//tools/lib/osmisc",
        "//tools/lib/retry",
        "//tools/testing/runtests",
    ],
)

# @bazel2gn:skip
go_binary_host_tool(
    name = "covargs",
    embed = [
        ":main",
    ],
    target_compatible_with = HOST_CONSTRAINTS,
)

host_go_test(
    name = "covargs_lib_tests",
    srcs = [
        "report_test.go",
    ],
    embed = [
        ":covargs_lib",
    ],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//tools:__pkg__"],
)

# @bazel2gn:skip
host_go_test(
    name = "covargs_tests",
    srcs = [
        "cmd/main_test.go",
    ],
    embed = [
        ":main",
    ],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//tools:__pkg__"],
    deps = [
        "//third_party/golibs:github.com/google/go-cmp/cmp",
    ],
)
