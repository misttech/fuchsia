import("//build/bazel/bazel_host_tool.gni")

if (is_host) {
  bazel_host_tool("rust-unsafe-analyzer") {
    bazel_target = ":rust-unsafe-analyzer"
    bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/rust-unsafe-analyzer"
  }
}

group("host") {
  deps = [ ":rust-unsafe-analyzer($host_toolchain)" ]
}
