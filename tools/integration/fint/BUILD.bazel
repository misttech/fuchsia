load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host:defs.bzl", "go_binary_host_tool")
load("//build/bazel/rules/host_tests:host_go_test.bzl", "host_go_test")

package(default_applicable_licenses = ["//:license"])

go_library(
    name = "proto_lib",
    srcs = [
        "proto/build_artifacts.pb.go",
        "proto/context.pb.go",
        "proto/set_artifacts.pb.go",
        "proto/static.pb.go",
    ],
    importpath = "go.fuchsia.dev/fuchsia/tools/integration/fint/proto",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = [
        "//tools/build/fx-set:__pkg__",
        "//tools/integration/testsharder:__pkg__",
    ],
    deps = [
        "//third_party/golibs:google.golang.org/protobuf/proto",
        "//third_party/golibs:google.golang.org/protobuf/reflect/protoreflect",
        "//third_party/golibs:google.golang.org/protobuf/runtime/protoimpl",
        "//third_party/golibs:google.golang.org/protobuf/types/known/structpb",
    ],
)

go_library(
    name = "fint_lib",
    srcs = [
        "affected.go",
        "build.go",
        "common.go",
        "ninja.go",
        "parse.go",
        "set.go",
        "should_build.go",
    ],
    importpath = "go.fuchsia.dev/fuchsia/tools/integration/fint",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = [
        "//tools/build/fx-set:__pkg__",
        "//vendor/google:__subpackages__",
    ],
    deps = [
        ":proto_lib",
        "//third_party/golibs:github.com/google/go-cmp/cmp",
        "//third_party/golibs:github.com/google/subcommands",
        "//third_party/golibs:github.com/kr/pretty",
        "//third_party/golibs:golang.org/x/sync/errgroup",
        "//third_party/golibs:golang.org/x/sys/unix",
        "//third_party/golibs:google.golang.org/protobuf/encoding/prototext",
        "//third_party/golibs:google.golang.org/protobuf/proto",
        "//third_party/golibs:google.golang.org/protobuf/reflect/protoreflect",
        "//third_party/golibs:google.golang.org/protobuf/runtime/protoimpl",
        "//third_party/golibs:google.golang.org/protobuf/types/known/structpb",
        "//tools/build",
        "//tools/lib/color",
        "//tools/lib/hostplatform",
        "//tools/lib/isatty",
        "//tools/lib/jsonutil",
        "//tools/lib/logger",
        "//tools/lib/osmisc",
        "//tools/lib/streams",
        "//tools/lib/subprocess",
    ],
)

# fint binary and its main package are Bazel-only.
# @bazel2gn:skip
go_library(
    name = "main",
    srcs = [
        "cmd/fint/cmd_affected.go",
        "cmd/fint/cmd_build.go",
        "cmd/fint/cmd_set.go",
        "cmd/fint/common.go",
        "cmd/fint/main.go",
    ],
    importpath = "go.fuchsia.dev/fuchsia/tools/integration/fint/main",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = [
        ":fint_lib",
        ":proto_lib",
        "//third_party/golibs:github.com/google/subcommands",
        "//third_party/golibs:google.golang.org/protobuf/encoding/protojson",
        "//third_party/golibs:google.golang.org/protobuf/proto",
        "//third_party/golibs:google.golang.org/protobuf/reflect/protoreflect",
        "//third_party/golibs:google.golang.org/protobuf/runtime/protoimpl",
        "//tools/lib/color",
        "//tools/lib/jsonutil",
        "//tools/lib/logger",
        "//tools/lib/osmisc",
    ],
)

# @bazel2gn:skip
go_binary_host_tool(
    name = "fint",
    embed = [
        ":main",
    ],
    target_compatible_with = HOST_OS_CONSTRAINTS,
)

host_go_test(
    name = "fint_lib_tests",
    srcs = [
        "affected_test.go",
        "build_test.go",
        "common_test.go",
        "ninja_test.go",
        "parse_test.go",
        "set_test.go",
        "should_build_test.go",
    ],
    embed = [
        ":fint_lib",
    ],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//tools:__pkg__"],
    deps = [
        "//third_party/golibs:github.com/google/go-cmp/cmp/cmpopts",
        "//third_party/golibs:google.golang.org/protobuf/testing/protocmp",
    ],
)

# @bazel2gn:skip
host_go_test(
    name = "main_tests",
    srcs = [
        "cmd/fint/cmd_set_test.go",
    ],
    embed = [
        ":main",
    ],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//tools:__pkg__"],
)
