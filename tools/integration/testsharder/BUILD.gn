import("//build/bazel/bazel_host_tool.gni")
import("//build/go/go_library.gni")
import("//build/go/golden_go_proto.gni")

golden_go_proto("params") {
  sources = [ "proto/params.proto" ]
  generate_descriptor_set = true
  import_protobuf_full = true
}

if (is_host) {
  bazel_host_tool("testsharder") {
    bazel_target = ":testsharder"
    bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/testsharder_/testsharder"
  }
}

