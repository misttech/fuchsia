import("//build/bazel/bazel_host_tool.gni")

if (is_host) {
  bazel_host_tool("assemblydoc_bin") {
    bazel_target = ":assemblydoc_bin"
    bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/assemblydoc_bin"
    output_name = "assemblydoc"
    install_host_tool = true
  }
}

group("assemblydoc") {
  deps = [ ":assemblydoc_bin($host_toolchain)" ]
}
