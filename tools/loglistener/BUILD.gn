import("//build/bazel/bazel_host_tool.gni")

if (is_host) {
  bazel_host_tool("loglistener") {
    bazel_target = ":loglistener"
    bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/loglistener"
    install_host_tool = true
  }
}

group("host") {
  deps = [ ":loglistener($host_toolchain)" ]
}
