  go_library("color") {
    sources = [ "color.go" ]
    visibility = [
      ":*",
      "//build/tools/*",
      "//src/firmware/*",
      "//src/sys/*",
      "//src/testing/host-target-testing/omaha_tool:*",
      "//third_party/network-conformance/*",
      "//tools/*",
      "//vendor/google/*",
      "//zircon/tools/*",
    ]
    deps = [ "//tools/lib/isatty" ]
  }
}
if (is_host) {
  go_test("color_tests") {
    sources = [ "color_test.go" ]
    embed = [ ":color" ]
    visibility = [
      ":*",
      "//tools:*",
    ]
  }
}
