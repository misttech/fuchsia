load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_go_test.bzl", "host_go_test")

package(default_applicable_licenses = ["//:license"])

go_library(
    name = "ffxutil",
    srcs = [
        "emu.go",
        "ffx.go",
        "flash.go",
        "mock.go",
        "repository.go",
        "test.go",
    ],
    importpath = "go.fuchsia.dev/fuchsia/tools/lib/ffxutil",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = [
        "//src/connectivity/network/testing/conformance/ffx:__pkg__",
        "//src/testing/host-target-testing/ffx:__pkg__",
        "//src/tests/early-boot-coverage/host-test:__pkg__",
        "//third_party/network-conformance/orchestrator:__pkg__",
        "//tools:__subpackages__",
    ],
    deps = [
        ":constants",
        "//tools/botanist:constants",
        "//tools/build",
        "//tools/lib/jsonutil",
        "//tools/lib/logger",
        "//tools/lib/retry",
        "//tools/lib/subprocess",
    ],
)

go_library(
    name = "constants",
    srcs = [
        "constants/constants.go",
    ],
    importpath = "go.fuchsia.dev/fuchsia/tools/lib/ffxutil/constants",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//tools/testing/testrunner:__pkg__"],
)

# TODO(https://fxbug.dev/574121341): Run this test in GN too.
# @bazel2gn:skip
host_go_test(
    name = "ffxutil_tests",
    srcs = [
        "ffx_test.go",
    ],
    embed = [":ffxutil"],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//tools:__pkg__"],
    deps = [
        "//tools/lib/clock",
    ],
)
