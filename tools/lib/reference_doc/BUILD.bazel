load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//build/bazel/rules/rust:defs.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "reference_doc",
    srcs = ["src/lib.rs"],
    edition = "2024",
    proc_macro_deps = [
        "//tools/lib/reference_doc/macro",
    ],
    visibility = [
        "//tools/cmc:__pkg__",
        "//tools/lib/cml:__pkg__",
        "//tools/lib/reference_doc/macro/derive-reference-doc-tests:__pkg__",
    ],
)

# TODO(https://fxbug.dev/574121341): Run this test in GN too.
# @bazel2gn:skip
host_rustc_test(
    name = "reference_doc_test",
    crate = ":reference_doc",
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//tools:__pkg__"],
)
