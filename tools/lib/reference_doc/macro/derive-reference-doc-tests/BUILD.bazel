load("@platforms//host:constraints.bzl", "HOST_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")

package(default_applicable_licenses = ["//:license"])

host_rustc_test(
    name = "derive-reference-doc_test",
    srcs = ["src/lib.rs"],
    crate_name = "derive_reference_doc",
    crate_root = "src/lib.rs",
    edition = "2024",
    target_compatible_with = HOST_CONSTRAINTS,
    visibility = ["//tools:__pkg__"],
    deps = [
        "//third_party/rust_crates/vendor:pretty_assertions",
        "//tools/lib/reference_doc",
    ],
)
