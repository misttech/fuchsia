import("//build/go/go_library.gni")
import("//build/go/go_test.gni")

copy("copy_agents_txt") {
  sources = [ "//tools/devshell/lib/agents.txt" ]
  outputs = [ "$target_gen_dir/agents.txt" ]
}

copy("copy_agents_go") {
  sources = [ "agents.go" ]
  outputs = [ "$target_gen_dir/agents.go" ]
}

go_library("agents") {
  source_dir = target_gen_dir
  name = "go.fuchsia.dev/fuchsia/tools/lib/agents"
  sources = [ "agents.go" ]
  embedsrcs = [ "agents.txt" ]
  non_go_deps = [
    ":copy_agents_go",
    ":copy_agents_txt",
  ]
}

go_test("agents_tests") {
  sources = [ "agents_test.go" ]
  embed = [ ":agents" ]
}

