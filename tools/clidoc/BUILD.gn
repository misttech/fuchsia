import("//build/bazel/bazel_host_tool.gni")

if (is_host) {
  bazel_host_tool("clidoc_bin") {
    bazel_target = ":clidoc_bin"
    bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/clidoc_bin"
    output_name = "clidoc"
    install_host_tool = true
  }
}

group("clidoc") {
  deps = [ ":clidoc_bin($host_toolchain)" ]
}
