group("fidl") {
  public_deps = [
    ":fidl-lint",
    ":fidlfmt",
    "compat_audit($host_toolchain)",
    "fidl_ir",
    "fidlc:host",
    "fidlgen_cpp:host($host_toolchain)",
    "fidlgen_hlcpp:host",
    "fidlgen_rust_next:host",
    "lib:lib($host_toolchain)",
    "//build/bazel/host:bazel_root_host_tools.fidl_api_diff.host_tool($host_toolchain)",
    "//build/bazel/host:bazel_root_host_tools.fidl_api_summarize.host_tool($host_toolchain)",
    "//build/bazel/host:bazel_root_host_tools.fidlcparsequality.host_tool($host_toolchain)",
    "//build/bazel/host:bazel_root_host_tools.fidldoc.host_tool($host_toolchain)",
    "//build/bazel/host:bazel_root_host_tools.fidlgen_go.host_tool($host_toolchain)",
    "//build/bazel/host:bazel_root_host_tools.fidlgen_python.host_tool($host_toolchain)",
    "//build/bazel/host:bazel_root_host_tools.fidlgen_rust.host_tool($host_toolchain)",
    "//build/bazel/host:bazel_root_host_tools.fidlgen_syzkaller.host_tool($host_toolchain)",
    "//build/bazel/host:bazel_root_host_tools.fidlmerge.host_tool($host_toolchain)",
    "//build/bazel/host:bazel_root_host_tools.gidl-format.host_tool($host_toolchain)",
    "//build/bazel/host:bazel_root_host_tools.gidl.host_tool($host_toolchain)",
    "//build/bazel/host:bazel_root_host_tools.gidl_audit.host_tool($host_toolchain)",
    "//build/bazel/host:bazel_root_host_tools.measure-tape.host_tool($host_toolchain)",
  ]
}

group("fidlfmt") {
  if (current_os != "fuchsia") {
    deps = [ "fidlc:fidl-format" ]
  }
}

group("fidl-lint") {
  if (current_os != "fuchsia") {
    deps = [ "fidlc:fidl-lint" ]
  }
}

group("tests") {
  testonly = true

  deps = [
    "abi-compat:tests",
    "example-tester:tests",
    "fidl_ir:tests",
    "fidlc:tests",
    "fidldoc:tests",
    "fidlgen_cpp:tests",
    "fidlgen_go:tests",
    "fidlgen_hlcpp:tests",
    "fidlgen_python:tests",
    "fidlgen_rust:tests",
    "fidlgen_rust_next:tests",
    "fidlgen_syzkaller:tests",
    "gidl:tests",
    "lib:tests",
    "measure-tape:tests",
  ]
}
