import("//build/rust/rustc_binary.gni")

# TODO(https://fxbug.dev/454452299): Move this binary to BUILD.bazel once
# Bazel fidl_library() generates `_rust_next` bindings. Bazel has no
# equivalent of `:fidl_rust_next` yet, so the binary cannot build there.
rustc_binary("bin") {
  name = "rust_next_benchmark"
  edition = "2024"

  deps = [
    ":fidl_rust",
    ":fidl_rust_next",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fidl/rust_next/fidl_next",
    "//third_party/rust_crates:criterion",
    "//third_party/rust_crates:rand",
  ]

  sources = [
    "src/_macros.rs",
    "src/log.rs",
    "src/main.rs",
    "src/mesh.rs",
    "src/minecraft.rs",
  ]
}

