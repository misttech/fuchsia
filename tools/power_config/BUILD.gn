import("//build/bazel/bazel_host_tool.gni")

if (is_host) {
  bazel_host_tool("power_config") {
    bazel_target = ":power_config"
    bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/power_config"
  }
}

group("tests") {
  testonly = true
  deps = [ "tests" ]
}
