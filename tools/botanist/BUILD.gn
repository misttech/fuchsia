import("//build/bazel/bazel_host_tool.gni")
import("//build/go/go_binary.gni")
import("//build/go/go_library.gni")
import("//build/go/go_test.gni")

bazel_host_tool("botanist") {
  bazel_target = ":botanist"
  bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/botanist_/botanist"
}

group("tests") {
  testonly = true
  deps = [
    ":botanist_lib_tests($host_toolchain)",
    ":botanist_repo_tests($host_toolchain)",
    ":botanist_targets_tests($host_toolchain)",
  ]
}

