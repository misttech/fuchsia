import("//build/bazel/bazel_host_tool.gni")
import("//build/sdk/sdk_host_tool.gni")

if (is_host) {
  sdk_host_tool("device-finder_sdk") {
    category = "partner"
    sdk_area = "Developer"
    output_name = "device-finder"
    deps = [ ":device-finder" ]
  }

  bazel_host_tool("device-finder") {
    bazel_target = ":device-finder"
    bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/device-finder_/device-finder"
    install_host_tool = true
  }
}

group("host") {
  deps = [ ":device-finder($host_toolchain)" ]
}
