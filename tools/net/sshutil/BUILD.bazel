load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_go_test.bzl", "host_go_test")

package(default_applicable_licenses = ["//:license"])

go_library(
    name = "sshutil",
    srcs = [
        "client.go",
        "conn.go",
        "resolver.go",
        "sshutil.go",
        "testserver.go",
    ],
    importpath = "go.fuchsia.dev/fuchsia/tools/net/sshutil",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//:__subpackages__"],
    deps = [
        ":constants",
        "//third_party/golibs:github.com/pkg/sftp",
        "//third_party/golibs:golang.org/x/crypto/ssh",
        "//third_party/golibs:golang.org/x/sync/errgroup",
        "//tools/lib/logger",
        "//tools/lib/retry",
    ],
)

go_library(
    name = "constants",
    srcs = [
        "constants/constants.go",
    ],
    importpath = "go.fuchsia.dev/fuchsia/tools/net/sshutil/constants",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//:__subpackages__"],
)

# TODO(https://fxbug.dev/574121341): Run this test in GN too.
# @bazel2gn:skip
host_go_test(
    name = "sshutil_tests",
    srcs = [
        "client_test.go",
        "conn_test.go",
        "sshutil_test.go",
        "testserver_test.go",
    ],
    embed = [":sshutil"],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//tools:__pkg__"],
    deps = [
        "//third_party/golibs:golang.org/x/crypto/ssh",
        "//tools/lib/retry",
    ],
)
