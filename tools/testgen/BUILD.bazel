load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules:golden_files.bzl", "verify_golden_files")
load("//build/bazel/rules/host:defs.bzl", "rustc_binary_host_tool")

package(default_applicable_licenses = ["//:license"])

# Files generated by `testgen integration_test`, relative to the test root. Each
# one is rendered from templates/integration_test/<path>.hbrs and checked
# against testdata/goldens/integration_test/<path>. When adding a file, create
# an empty golden before building with `update_goldens=true`, since Bazel fails
# on missing golden files instead of creating them.
_INTEGRATION_TEST_FILES = [
    "testing/fidl/BUILD.gn",
    "testing/fidl/realm_factory.test.fidl",
    "testing/realm-factory/BUILD.gn",
    "testing/realm-factory/meta/default.cml",
    "testing/realm-factory/src/main.rs",
    "tests/BUILD.gn",
    "tests/meta/test-root.cml",
    "tests/meta/test-suite.cml",
    "tests/src/main.rs",
]

_GENERATED_TEST_ROOT = "generated_integration_test"

rustc_binary_host_tool(
    name = "testgen",
    srcs = [
        "src/cmd_integration_test.rs",
        "src/common.rs",
        "src/flags.rs",
        "src/main.rs",
    ],
    compile_data = [
        "templates/integration_test/%s.hbrs" % f
        for f in _INTEGRATION_TEST_FILES
    ],
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = [
        "//src/lib/diagnostics/log/rust",
        "//src/lib/fuchsia",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:argh",
        "//third_party/rust_crates/vendor:chrono",
        "//third_party/rust_crates/vendor:handlebars",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:tempfile",
        "//third_party/rust_crates/vendor:walkdir",
        "//tools/lib/cml",
    ],
)

genrule(
    name = "generate_integration_test",
    testonly = True,
    srcs = ["testdata/meta/example-component.cml"],
    outs = ["%s/%s" % (_GENERATED_TEST_ROOT, f) for f in _INTEGRATION_TEST_FILES],
    # testgen refuses to write into an existing directory, but Bazel creates
    # the test root ahead of time as the parent of the declared outputs.
    cmd = " ".join([
        "rm -rf $(RULEDIR)/%s &&" % _GENERATED_TEST_ROOT,
        "$(location :testgen)",
        "--year-override 2024",
        "integration_test",
        "--test-root $(RULEDIR)/" + _GENERATED_TEST_ROOT,
        "--component-manifest $(location testdata/meta/example-component.cml)",
        "--component-gn-label //tools/testgen/testdata:example-component",
    ]),
    target_compatible_with = HOST_OS_CONSTRAINTS,
    tools = [":testgen"],
)

verify_golden_files(
    name = "integration_test_goldens",
    testonly = True,
    # Use the genrule rather than its individual outputs so that the GN
    # bazel_action's depfile includes testgen's sources.
    candidate_files = [":generate_integration_test"],
    golden_files = [
        "testdata/goldens/integration_test/" + f
        for f in _INTEGRATION_TEST_FILES
    ],
    target_compatible_with = HOST_OS_CONSTRAINTS,
)
