import("//build/bazel/bazel_build_action.gni")
import("//build/bazel/bazel_host_tool.gni")

if (is_host) {
  bazel_host_tool("testgen") {
    bazel_target = ":testgen"
    bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/testgen"
    install_host_tool = true
  }

  # TODO(127883): Add a golden file test for the helptext.

  bazel_build_action("integration_test_goldens") {
    testonly = true
    bazel_target = ":integration_test_goldens"
    bazel_config = "host"
    copy_outputs = [
      {
        bazel = "{{BAZEL_TARGET_OUT_DIR}}/{{BAZEL_TARGET_NAME}}.verified"
        ninja = "$target_name.verified"
      },
    ]
  }
}

group("host") {
  deps = [ ":testgen($host_toolchain)" ]
}

# Tests for the integration_test subcommand.
group("integration_test_tests") {
  testonly = true
  deps = [
    ":integration_test_goldens($host_toolchain)",

    # Ensure the generated test builds and passes.
    "testdata/goldens/integration_test/tests",
  ]
}

group("tests") {
  testonly = true
  deps = [ ":integration_test_tests" ]
}
