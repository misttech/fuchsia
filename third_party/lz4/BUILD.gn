import("//build/cpp/library_headers.gni")
import("//build/zircon/migrated_targets.gni")

library_headers("headers") {
  headers = [
    "lz4/lz4.h",
    "lz4/lz4frame.h",
  ]
}

# LINT.IfChange
static_library("lz4") {
  public_deps = [ ":headers" ]

  sources = [
    "src/lib/lz4.c",
    "src/lib/lz4.h",
    "src/lib/lz4frame.c",
    "src/lib/lz4frame.h",
    "src/lib/lz4hc.c",
    "src/lib/lz4hc.h",
    "src/lib/xxhash.c",
    "src/lib/xxhash.h",
  ]
  defines = [
    "XXH_NAMESPACE=LZ4_",

    # Preempt the default that will break symbols out of hidden visibility.
    "LZ4LIB_VISIBILITY=",
    "LZ4FLIB_VISIBILITY=",

    # Upstream lz4.c disables LZ4_FAST_DEC_LOOP for non-Apple aarch64 Clang
    # builds (see https://github.com/lz4/lz4/pull/707). Enabling it
    # significantly improves decompression performance on the ARM64 CPUs that
    # Fuchsia targets.
    "LZ4_FAST_DEC_LOOP=1",
  ]

  configs -= [ "//build/config:default_optimize" ]
  configs += [
    "//build/config:optimize_speed",
    "//build/config:Wno-implicit-fallthrough",
    "//build/config:Wno-missing-declarations",
    "//build/config:Wno-missing-prototypes",
  ]
}

# LINT.ThenChange(BUILD.bazel)

group("tests") {
  testonly = true
  deps = [
    "rust:tests",
    "test:tests",
  ]
}
