load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "lz4",
    srcs = ["src/lib.rs"],
    edition = "2024",
    link_deps = [
        "//third_party/lz4",
    ],
    visibility = [
        "//src/devices/bin/driver-index:__pkg__",
        "//src/storage/erofs:__pkg__",
        "//src/storage/lib/delivery_blob:__pkg__",
    ],
    # TODO(https://b/566963647): Use `with_unit_tests = "both"`.
    with_host_unit_tests = True,
    deps = [
        "//third_party/rust_crates/vendor:thiserror",
    ],
)
