import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("bssl-macros") {
  sources = [ "//third_party/boringssl/src/rust/bssl-macros/src/lib.rs" ]
  source_root = "//third_party/boringssl/src/rust/bssl-macros/src/lib.rs"
  edition = "2024"
  visibility = [
    ":*",
    "//third_party/rust_crates:*",
  ]
}
static_library("rust-wrapper") {
  sources = [ "bssl-sys/wrapper.c" ]
  configs += [ ":rust-wrapper.config" ]
  visibility = [ ":*" ]
}
rustc_library("bssl-sys.lib") {
  sources = [ "bssl-sys/lib.rs" ]
  configs += [ ":bssl-sys.config" ]
  inputs = [ "bssl-sys/bindgen.rs" ]
  crate_name = "bssl_sys"
  source_root = "bssl-sys/lib.rs"
  disable_clippy = true
  edition = "2021"
  link_deps = [ ":rust-wrapper" ]
  rustenv = [ "BINDGEN_RS_FILE=bindgen.rs" ]
  visibility = [ ":*" ]
  deps = [ ":bssl-macros" ]
}
