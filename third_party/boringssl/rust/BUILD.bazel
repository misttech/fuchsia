load("@fuchsia_rules_common//build_flags:build_flags.bzl", "build_flags")
load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_library_group.bzl", "rustc_library_group")

package(default_applicable_licenses = ["//:license"])

# The crate sources live in the boringssl checkout under
# //third_party/boringssl/src, which belongs to the //third_party/boringssl
# package in Bazel (see --deleted_packages in template.bazelrc).

rustc_library(
    name = "bssl-macros",
    srcs = ["//third_party/boringssl:src/rust/bssl-macros/src/lib.rs"],
    crate_root = "//third_party/boringssl:src/rust/bssl-macros/src/lib.rs",  # @bazel2gn:raw_overwrite:"//third_party/boringssl/src/rust/bssl-macros/src/lib.rs"
    edition = "2024",
    visibility = ["//third_party/rust_crates:__pkg__"],
)

# This provides the implementations of some error-handing utilities declared in
# the bindings and used in the crate.
fx_cc_library(
    name = "rust-wrapper",
    srcs = ["bssl-sys/wrapper.c"],
    hdrs = ["//third_party/boringssl:src/rust/bssl-sys/wrapper.h"],  # @bazel2gn:skip
    # bazel2gn maps copts to GN configs: GN gets the headers from this config,
    # Bazel from the header-only deps below.
    copts = [],  # @bazel2gn:raw_overwrite:[ ":rust-wrapper.config" ]
    visibility = ["//visibility:private"],

    # Only the boringssl headers: as in GN, the bssl-sys* groups below pick the
    # boringssl link flavor.
    # @bazel2gn:skip
    deps = [
        "//third_party/boringssl:crypto-headers",
        "//third_party/boringssl:ssl-headers",
    ],
)

# LINT.IfChange(bssl_sys_config)
# Hand-ported from the GN config with the same label, as bazel2gn does not
# convert build_flags().
# @bazel2gn:skip
build_flags(
    name = "bssl-sys.config",
    rustflags = [
        # This controls whether bindgen.rs is included via the BINDGEN_RS_FILE
        # environment variable.
        "--cfg=bindgen_rs_file",

        # Needed to expose CBS_init() and CBS_len(), which is currently a bit
        # funny due to these being inline definitions included in wrapper.h
        # that bindgen ignores.
        "--cfg=unsupported_inline_wrappers",

        # The boringssl API uses uint128_t's and without this rustc would
        # complain that u128 in the bindings are not "FFI-safe".
        "-Aimproper_ctypes",

        # Redundant unsafe blocks are generated by bindgen in the new version.
        "-Aunused-unsafe",
    ],
)
# LINT.ThenChange(BUILD.gn:bssl_sys_config)

rustc_library(
    name = "bssl-sys.lib",
    srcs = ["bssl-sys/lib.rs"],

    # Like the GN groups, which pick the boringssl link flavor, dependents use
    # the bssl-sys* groups below rather than this crate directly.
    build_flags = [":bssl-sys.config"],
    compile_data = ["bssl-sys/bindgen.rs"],
    crate_name = "bssl_sys",
    crate_root = "bssl-sys/lib.rs",

    # Since bindgen.rs is being include!-ed into the crate root (which we want
    # to remain purely mirrored code), we don't have a chance to annotate
    # `#![allow(clippy::missing_safety_doc)]`, etc. Accordingly we have no
    # choice but to skip the check altogether. There is barely anything in
    # lib.rs apart from the bindgen output anyway.
    disable_clippy = True,
    edition = "2021",
    link_deps = [":rust-wrapper"],
    rustc_env = {"BINDGEN_RS_FILE": "bindgen.rs"},
    visibility = ["//visibility:private"],
    deps = [":bssl-macros"],
)

# LINT.IfChange(bssl_crypto_allows)
# Hand-ported from the GN config with the same label, as bazel2gn does not
# convert build_flags().
# @bazel2gn:skip
build_flags(
    name = "bssl-crypto.allows",
    rustflags = [
        "-Adead_code",
        "-Aelided_lifetimes_in_paths",
        "-Aunused_extern_crates",
    ],
)
# LINT.ThenChange(BUILD.gn:bssl_crypto_allows)

# LINT.IfChange(bssl_crypto_lib)
# Hand-written in BUILD.gn as well, which keeps `enforce_source_listing = false`
# there; bazel2gn would list every source file instead.
# @bazel2gn:skip
rustc_library(
    name = "bssl-crypto.lib",
    srcs = ["//third_party/boringssl:bssl-crypto-srcs"],

    # Like GN configs, these come after the default `-Wrust-2018-idioms`.
    build_flags = [":bssl-crypto.allows"],
    crate_name = "bssl_crypto",
    crate_root = "//third_party/boringssl:src/rust/bssl-crypto/src/lib.rs",

    # We don't maintain this code.
    disable_clippy = True,
    edition = "2021",

    # As with bssl-sys, dependents use the bssl-crypto* groups below.
    visibility = ["//visibility:private"],
    deps = [":bssl-sys.lib"],
)
# LINT.ThenChange(BUILD.gn:bssl_crypto_lib)

# The unit tests run through Bazel only, on host, against the static boringssl.
# bazel2gn can't translate their sources, which come from a filegroup outside
# this package.
# @bazel2gn:skip
host_rustc_test(
    name = "bssl-crypto.lib_test",
    build_flags = [":bssl-crypto.allows"],
    crate = ":bssl-crypto.lib",
    edition = "2021",
    link_deps = ["//third_party/boringssl:boringssl-static"],

    # We don't maintain this code, and its own #![deny(clippy::...)] attributes
    # override any lint_config.
    tags = ["noclippy"],
    target_compatible_with = HOST_OS_CONSTRAINTS,
)

# Link flavors
#
# LINT.IfChange(link_flavors)
# Like the GN groups of the same names in BUILD.gn, each of these is a crate
# plus the boringssl library flavor that dependents link. bazel2gn does not sync
# them. Visibility lists the current GN dependents of each group; the ones with
# no dependents yet stay private. Where GN selects on `is_host`, Bazel uses
# `//conditions:default`; GN has no other toolchain these groups are used in.

# Defaults to a shared libboringssl for Fuchsia and a static for host.
# @bazel2gn:skip
rustc_library_group(
    name = "bssl-sys",
    link_deps = select({
        "@platforms//os:fuchsia": ["//third_party/boringssl:boringssl-shared"],
        "//conditions:default": ["//third_party/boringssl:boringssl-static"],
    }),
    visibility = [
        "//src/security/bin/kms:__pkg__",
        "//third_party/rust_crates:__pkg__",
        "//vendor/google:__subpackages__",
    ],
    deps = [":bssl-sys.lib"],
)

# @bazel2gn:skip
rustc_library_group(
    name = "bssl-sys.shared",
    link_deps = ["//third_party/boringssl:boringssl-shared"],
    visibility = ["//visibility:private"],
    deps = [":bssl-sys.lib"],
)

# Avoids a dynamic dependency on libssl, which some clients do not need.
# @bazel2gn:skip
rustc_library_group(
    name = "bssl-sys.shared-no-ssl",
    link_deps = ["//third_party/boringssl:crypto-shared"],
    visibility = [
        "//src/connectivity/wlan/lib/fcg-crypto:__pkg__",
        "//src/connectivity/wlan/lib/rsn:__pkg__",
        "//src/lib/mundane:__pkg__",
    ],
    deps = [":bssl-sys.lib"],
)

# @bazel2gn:skip
rustc_library_group(
    name = "bssl-sys.static",
    link_deps = ["//third_party/boringssl:boringssl-static"],
    visibility = ["//src/lib/mundane:__pkg__"],
    deps = [":bssl-sys.lib"],
)

# Defaults to a shared libboringssl for Fuchsia and a static for host.
# @bazel2gn:skip
rustc_library_group(
    name = "bssl-crypto",
    link_deps = select({
        "@platforms//os:fuchsia": ["//third_party/boringssl:boringssl-shared"],
        "//conditions:default": ["//third_party/boringssl:boringssl-static"],
    }),
    visibility = ["//vendor/google:__subpackages__"],
    deps = [":bssl-crypto.lib"],
)

# @bazel2gn:skip
rustc_library_group(
    name = "bssl-crypto.shared",
    link_deps = ["//third_party/boringssl:boringssl-shared"],
    visibility = ["//visibility:private"],
    deps = [":bssl-crypto.lib"],
)

# @bazel2gn:skip
rustc_library_group(
    name = "bssl-crypto.static",
    link_deps = ["//third_party/boringssl:boringssl-static"],
    visibility = ["//visibility:private"],
    deps = [":bssl-crypto.lib"],
)

# @bazel2gn:skip
rustc_library_group(
    name = "bssl-crypto.no-ssl",
    link_deps = select({
        "@platforms//os:fuchsia": ["//third_party/boringssl:crypto-shared"],
        "//conditions:default": ["//third_party/boringssl:crypto-static"],
    }),
    visibility = ["//src/sys/pkg/lib/fuchsia-merkle:__pkg__"],
    deps = [":bssl-crypto.lib"],
)
# LINT.ThenChange(BUILD.gn:link_flavors)
