load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")

package(default_applicable_licenses = ["//:license"])

rustc_binary(
    name = "bin",
    srcs = ["src/main.rs"],
    crate_name = "inspect_rust_codelab_fizzbuzz",
    edition = "2024",
    tags = ["manual"],
    deps = [
        "//examples/diagnostics/inspect/codelab/fidl:fuchsia.examples.inspect_rust",
        "//sdk/rust/zx",
        "//src/lib/diagnostics/inspect/runtime/rust",
        "//src/lib/diagnostics/inspect/rust:fuchsia-inspect",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
    ],
)

fx_packaged_binary(
    name = "bin_packaged",
    binary = ":bin",
    binary_name = "inspect_rust_codelab_fizzbuzz",
)

fx_component_manifest(
    name = "manifest",
    component_name = "fizzbuzz",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/syslog:client.shard",
    ],
    manifest = "meta/inspect_rust_codelab_fizzbuzz.cml",
)

fx_component(
    name = "fizzbuzz",
    compiled_manifest = ":manifest",
    visibility = ["//examples/diagnostics/inspect/codelab/rust:__subpackages__"],
    deps = [":bin_packaged"],
)
