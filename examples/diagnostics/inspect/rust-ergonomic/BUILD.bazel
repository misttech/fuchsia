load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_test(
    name = "ergonomic_inspect_tests",
    srcs = ["src/main.rs"],
    crate_root = "src/main.rs",
    edition = "2024",
    deps = [
        "//src/lib/diagnostics/inspect/derive",
        "//src/lib/diagnostics/inspect/rust:fuchsia-inspect",
        "//src/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
        "//src/lib/fuchsia",
    ],
)

fx_unittest_package(
    name = "ergonomic-inspect-tests",
    unit_tests = [":ergonomic_inspect_tests"],
    visibility = ["//examples:__pkg__"],
)
