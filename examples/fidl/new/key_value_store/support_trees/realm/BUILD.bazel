load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)

package(default_applicable_licenses = ["//:license"])

fx_component_manifest(
    name = "realm-manifest",
    component_name = "realm",
    manifest = "meta/realm.cml",
)

# Create a `realm` component, which may be invoked by an instance of the
# RealmBuilder to create a new test realm at test runtime.
fx_component(
    name = "realm",
    compiled_manifest = ":realm-manifest",
    component_name = "realm",
    visibility = [
        "//examples/fidl/new/key_value_store/support_trees/rust:__pkg__",
        "//examples/fidl/new/key_value_store/support_trees/rust_next:__pkg__",
    ],
)
