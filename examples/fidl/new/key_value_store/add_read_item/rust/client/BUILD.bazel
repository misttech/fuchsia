load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component_manifest",
)
load(
    "//build/bazel/rules/components:structured_config.bzl",
    "fuchsia_structured_config_rust_lib",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")

package(default_applicable_licenses = ["//:license"])

fx_component_manifest(
    name = "manifest",
    component_name = "client",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "//examples/fidl/new/key_value_store/add_read_item:meta/client.cml",
)

fuchsia_structured_config_rust_lib(
    name = "config",
    cm_label = ":manifest",
)

# GN puts the binary in a per-target directory so the `client_bin` outputs
# of the sibling key_value_store examples don't collide.
# @bazel2gn:raw_attribute:output_dir = target_out_dir + "/rust"
rustc_binary(
    name = "bin",
    srcs = ["src/main.rs"],
    crate_name = "client_bin",
    edition = "2024",
    visibility = ["//examples/fidl/new/key_value_store/add_read_item/rust:__pkg__"],
    deps = [
        ":config",
        "//examples/fidl/new/key_value_store/add_read_item/fidl:examples.keyvaluestore.addreaditem_rust",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component",
        "//third_party/rust_crates/vendor:anyhow",
    ],
)
