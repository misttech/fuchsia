# Example device tests defined in Bazel. These are exported to `fx test` and
# infra builders through the `bazel_tests` target in //examples/BUILD.gn.
test_suite(
    name = "target_tests",
    target_compatible_with = ["@platforms//os:fuchsia"],
    tests = [
        "//examples/diagnostics/inspect/rust-ergonomic:ergonomic-inspect-tests",
        "//examples/rust/rust_static_linking:static_linking_tests",
    ],
)
