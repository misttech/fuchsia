import("//build/tools/bazel2gn/bazel_migration.gni")

if (is_fuchsia) {
  rustc_binary("provider_bin") {
    sources = [ "provider/src/main.rs" ]
    output_name = "dynamic_dictionary_provider"
    source_root = "provider/src/main.rs"
    edition = "2024"
    deps = [
      "//examples/components/routing/fidl:echo_rust",
      "//sdk/fidl/fuchsia.component.runtime:fuchsia.component.runtime_rust",
      "//src/lib/fidl/rust/fidl",
      "//src/lib/fuchsia",
      "//src/lib/fuchsia-async",
      "//src/lib/fuchsia-component",
      "//third_party/rust_crates:futures",
      "//third_party/rust_crates:log",
    ]
  }
}
fuchsia_component_manifest("dynamic-dictionary-provider-manifest") {
  component_name = "dynamic-dictionary-provider"
  manifest = "meta/dynamic_dictionary_provider.cml"
  restricted_features = [ "dynamic_dictionaries" ]
}
fuchsia_component("dynamic-dictionary-provider") {
  cm_label = ":dynamic-dictionary-provider-manifest"
  component_name = "dynamic-dictionary-provider"
  deps = [ ":provider_bin" ]
}
if (is_fuchsia) {
  rustc_test("bin") {
    sources = [ "src/lib.rs" ]
    output_name = "dynamic_dictionary"
    edition = "2024"
    deps = [
      "//examples/components/routing/fidl:echo_rust",
      "//src/lib/fuchsia",
      "//src/lib/fuchsia-component",
      "//third_party/rust_crates:assert_matches",
      "//third_party/rust_crates:log",
    ]
  }
}
fuchsia_component_manifest("dynamic-dictionary-example-manifest") {
  component_name = "dynamic-dictionary-example"
  manifest = "meta/dynamic_dictionary.cml"
}
fuchsia_test_component("dynamic-dictionary-example") {
  cm_label = ":dynamic-dictionary-example-manifest"
  component_name = "dynamic-dictionary-example"
  deps = [ ":bin" ]
}
fuchsia_test_package("dictionary-examples") {
  package_name = "dictionary-examples-gn"
  test_components = [ ":dynamic-dictionary-example" ]
  deps = [ ":dynamic-dictionary-provider" ]
}
