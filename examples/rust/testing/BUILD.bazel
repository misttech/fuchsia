load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "testing",
    srcs = ["src/lib.rs"],
    edition = "2024",
    visibility = ["//examples/rust:__pkg__"],
    with_unit_tests = True,
)

rustc_test(
    name = "testing_integration_test",
    srcs = ["tests/integration_test.rs"],
    crate_root = "tests/integration_test.rs",
    edition = "2024",
    visibility = ["//examples/rust:__pkg__"],
    deps = [":testing"],
)

rustc_test(
    name = "testing_integration_test_two",
    srcs = ["tests/integration_test_two.rs"],
    crate_root = "tests/integration_test_two.rs",
    edition = "2024",
    visibility = ["//examples/rust:__pkg__"],
    deps = [":testing"],
)
