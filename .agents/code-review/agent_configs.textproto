configs: {
  id: "fuchsia-zircon-syscall-struct-versioning"
  display_name: "Zircon Syscall Struct Versioning"
  description: "Rules for evolving Zircon syscall ABI structs with versioned (_vN) structs and topics."
  tags: "code-review-agent"
  skills: "zircon-syscall-struct-versioning"
  include_filters: {
    project: "fuchsia"
