import("//build/bazel/bazel_test_suite.gni")
import("//build/python/python_library.gni")
import("//build/testing/python_build_time_tests.gni")

bazel_test_suite("bazel_tests") {
  host_tests = [ "//scripts/lib/agents:agents_tests" ]
}

group("tests") {
  testonly = true

  deps = [
    ":agents_source_path_test($host_toolchain)",
    ":bazel_tests",
  ]
}

if (is_host) {
  # Bazel has no equivalent of python_build_time_tests(), so this test stays
  # in GN.
  python_build_time_tests("agents_source_path_test") {
    tests = [ "tests/agents_test.py" ]
    inputs = [ "//tools/devshell/lib/agents.txt" ]
    deps = [ ":agents" ]
  }
}

