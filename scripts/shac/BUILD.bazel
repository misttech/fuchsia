package(default_applicable_licenses = ["//:license"])

# host_shac_test() runs `shac test` in a minimal checkout containing only the
# test's declared data, so tests depend on this to be able to load the check
# implementations they test.
filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = [
        "bazel.star",
        "bazel_migration.star",
        "bazel_migration_fidl.star",
        "bug_urls.star",
        "check_licenses.star",
        "cml.star",
        "commit_msg.star",
        "common.star",
        "confusing_characters.star",
        "cpp.star",
        "dart.star",
        "dml.star",
        "docs.star",
        "fidl.star",
        "gn.star",
        "go.star",
        "json.star",
        "keep_sorted.star",
        "main.star",
        "mirror_blocklists.star",
        "owners.star",
        "prebuilts.star",
        "python.star",
        "readme_fuchsia.star",
        "rust.star",
        "skills.star",
        "starlark.star",
        "third_party_readme.star",
        "underscore_vs_dash.star",
    ],
    visibility = [
        "//build:__pkg__",
        "//scripts/shac/tests:__subpackages__",
    ],
)
