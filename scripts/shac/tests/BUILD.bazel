load("@fuchsia_build_config//:defs.bzl", "build_config")
load("//build/bazel/rules/host_tests:host_shac_test.bzl", "host_shac_test")

package(default_applicable_licenses = ["//:license"])

# Tests run by `shac test`, as opposed to the Python tests in BUILD.gn.
test_suite(
    name = "host_tests",
    tests = [
        ":bazel2gn_test",
        ":bazel_migration_test",
        ":bazel_test",
        ":bug_urls_test",
        ":cml_test",
        ":confusing_characters_test",
        ":docs_test",
        ":fidl_test",
        ":gn_test",
        ":keep_sorted_test",
        ":mirror_blocklists_test",
        ":prebuilts_test",
        ":python_test",
        ":underscore_vs_dash_test",
    ],
)

host_shac_test(
    name = "bazel2gn_test",
    src = "bazel2gn_test.star",
    data = ["//scripts/shac:starlark_files"],
)

host_shac_test(
    name = "bazel_migration_test",
    src = "bazel_migration_test.star",
    data = ["//scripts/shac:starlark_files"],
)

host_shac_test(
    name = "bazel_test",
    src = "bazel_test.star",
    data = ["//scripts/shac:starlark_files"],
)

host_shac_test(
    name = "bug_urls_test",
    src = "bug_urls_test.star",
    data = ["//scripts/shac:starlark_files"],
)

host_shac_test(
    name = "cml_test",
    src = "cml_test.star",
    data = ["//scripts/shac:starlark_files"],
)

host_shac_test(
    name = "confusing_characters_test",
    src = "confusing_characters_test.star",
    data = ["//scripts/shac:starlark_files"],
)

host_shac_test(
    name = "docs_test",
    src = "docs_test.star",
    data = ["//scripts/shac:starlark_files"],
)

host_shac_test(
    name = "fidl_test",
    src = "fidl_test.star",
    data = ["//scripts/shac:starlark_files"],
)

host_shac_test(
    name = "gn_test",
    src = "gn_test.star",
    data = [
        # Executed for real, rather than mocked.
        "//:prebuilt/third_party/gn/%s/gn" % build_config.host_tag,
        "//scripts/shac:starlark_files",
    ],
)

host_shac_test(
    name = "keep_sorted_test",
    src = "keep_sorted_test.star",
    data = [
        # Executed for real, rather than mocked.
        "//:prebuilt/third_party/keep-sorted/%s/keep-sorted" % build_config.host_tag,
        "//scripts/shac:starlark_files",
    ],
)

host_shac_test(
    name = "mirror_blocklists_test",
    src = "mirror_blocklists_test.star",
    data = ["//scripts/shac:starlark_files"],
)

host_shac_test(
    name = "prebuilts_test",
    src = "prebuilts_test.star",
    data = ["//scripts/shac:starlark_files"],
)

host_shac_test(
