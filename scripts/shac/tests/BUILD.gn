assert(is_host, "shac tests only supported for host testing")

import("//build/bazel/bazel_test_suite.gni")
import("//build/python/python_host_test.gni")

python_host_test("python_format_test") {
  main_source = "python_format_test.py"
  main_callable = "main"
  extra_args = [
    "--python-bin=" + rebase_path(python_exe_src, root_build_dir),
    "--autoflake=" +
        rebase_path("//third_party/pylibs/autoflake/main.py", root_build_dir),
    "--isort=" +
        rebase_path("//third_party/pylibs/isort/main.py", root_build_dir),
    "--black=" +
        rebase_path("//prebuilt/third_party/black/${host_os}-x64/black",
                    root_build_dir),
    "--python-format-script=" +
        rebase_path("//scripts/shac/python_format.py", root_build_dir),
  ]
  test_data_deps = [
    "//build/python:black",
    "//build/python:interpreter",
    "//scripts/shac:python_format_script",
    "//third_party/pylibs:autoflake",
    "//third_party/pylibs:isort",
    "//third_party/pylibs:pyflakes",
  ]
}

python_host_test("bazel_root_package_labels_test") {
  main_source = "bazel_root_package_labels_test.py"
  sources = [ "//scripts/shac/bazel_lint/checks/root_package_labels.py" ]
}

python_host_test("check_header_guards_test") {
  main_source = "check_header_guards_test.py"
  sources = [ "//scripts/shac/check_header_guards.py" ]
}

python_host_test("clang_tidy_test") {
  main_source = "clang_tidy_test.py"
  sources = [ "//scripts/shac/clang_tidy.py" ]
}

python_host_test("commit_msg_checker_test") {
  main_source = "commit_msg_checker_test.py"
  sources = [ "//scripts/shac/commit_msg_checker.py" ]
}

bazel_test_suite("bazel_defined_tests") {
  host_tests = [ "//scripts/shac/tests:host_tests" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_defined_tests",
    ":bazel_root_package_labels_test",
    ":check_header_guards_test",
    ":clang_tidy_test",
    ":commit_msg_checker_test",
    ":python_format_test",
  ]
}
