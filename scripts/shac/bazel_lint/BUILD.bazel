# host_shac_test() runs `shac test` in a minimal checkout containing only the
# test's declared data, so //scripts/shac/tests:bazel_test depends on this
# filegroup to stage the framework, check modules, and Starlark check tests
# that it loads and executes.
filegroup(
    name = "files",
    testonly = True,
    srcs = [
        "allowlist.py",
        "framework.py",
        "main.py",
        "//scripts/shac/bazel_lint/checks:files",
        "//scripts/shac/bazel_lint/checks/tests:files",
    ],
    visibility = [
        "//scripts/shac/tests:__subpackages__",
    ],
)
