# Staged into the runfiles of //scripts/shac/tests:bazel_test (via
# //scripts/shac/bazel_lint:files) so `shac test` can execute main.py against
# the registered check modules.
filegroup(
    name = "files",
    testonly = True,
    srcs = [
        "__init__.py",
        "visibility_utils.py",
        # LINT.IfChange(all_check_files)
        "host_constraints.py",
        "load_visibility.py",
        "package_default_visibility.py",
        "root_package_labels.py",
        "target_visibility.py",
        "vendor_paths.py",
        "visibility_for_public_by_default_types.py",
        # LINT.ThenChange(//scripts/shac/bazel_lint/checks/__init__.py:all_checks)
    ],
    visibility = [
        "//scripts/shac/bazel_lint:__pkg__",
    ],
)
