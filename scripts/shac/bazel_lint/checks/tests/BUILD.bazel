# Staged into the runfiles of //scripts/shac/tests:bazel_test (via
# //scripts/shac/bazel_lint:files) so bazel_test.star can load checks_test.star
# and the per-check Starlark test files.
filegroup(
    name = "files",
    testonly = True,
    srcs = [
        "base_test.star",
        "checks_test.star",
        # LINT.IfChange(all_check_test_files)
        "load_visibility_test.star",
        "package_default_visibility_test.star",
        "root_package_labels_test.star",
        "target_visibility_test.star",
        # LINT.ThenChange(//scripts/shac/bazel_lint/checks/__init__.py:all_checks)
    ],
    visibility = [
        "//scripts/shac/bazel_lint:__pkg__",
    ],
)
