load("@rules_python//python:py_library.bzl", "py_library")
load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_py_test.bzl", "host_py_test")

package(default_applicable_licenses = ["//:license"])

py_library(
    name = "dataclasses_json_lite",
    srcs = [
        "__init__.py",
        "dataclasses_json_lite.py",
    ],
    imports = [".."],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = [
        "//scripts/ffx_complete:__pkg__",
        "//scripts/memory/debug_json:__pkg__",
        "//scripts/memory/images_json:__pkg__",
    ],
)

host_py_test(
    name = "dataclasses_json_lite_test",
    srcs = ["dataclasses_json_lite_test.py"],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//scripts/memory:__pkg__"],
    deps = [":dataclasses_json_lite"],
)
