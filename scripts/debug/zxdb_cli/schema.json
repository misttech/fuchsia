                    "command": {
                        "const": "break",
                        "default": "break",
                        "title": "Command",
                        "type": "string"
                    },
                    "last_seen_seq": {
                        "anyOf": [
                            {
                                "type": "integer"
                            },
                            {
                                "type": "null"
                            }
