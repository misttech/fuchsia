                    "command": {
                        "const": "attach",
                        "default": "attach",
                        "title": "Command",
                        "type": "string"
                    },
                    "last_seen_seq": {
                        "anyOf": [
                            {
                                "type": "integer"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "title": "Last Seen Seq"
                    },
                    "ack_seq": {
                        "anyOf": [
                            {
                                "type": "integer"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "title": "Ack Seq"
                    },
                    "filter": {
                        "anyOf": [
                            {
                                "type": "integer"
