                        "default": null,
                        "title": "Last Seen Seq"
                    },
                    "ack_seq": {
                        "anyOf": [
                            {
                                "type": "integer"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "title": "Ack Seq"
                    },
                    "file": {
                        "title": "File",
                        "type": "string"
