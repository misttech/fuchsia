import("//build/python/python_library.gni")
import("//build/testing/python_build_time_tests.gni")

group("tests") {
  testonly = true
  deps = [
    ":related_invocations_test($host_toolchain)",
    ":rs_profile_test($host_toolchain)",
    ":rsninja_test($host_toolchain)",
  ]
}

if (is_host) {
  python_library("rsninja") {
    sources = [ "rsninja.py" ]
    library_deps = [
      ":related_invocations",
      ":rs_profile",
    ]
  }

  python_build_time_tests("rsninja_test") {
    tests = [ "rsninja_test.py" ]
    deps = [ ":rsninja" ]
  }

  python_library("related_invocations") {
    sources = [ "related_invocations.py" ]
  }

  python_build_time_tests("related_invocations_test") {
    tests = [ "related_invocations_test.py" ]
    deps = [ ":related_invocations" ]
  }

  python_library("rs_profile") {
    sources = [ "rs_profile.py" ]
    library_deps = [
      "//build/python/modules/serialization",
      "//build/scripts:service_profile_lib",
    ]
  }

  python_build_time_tests("rs_profile_test") {
    tests = [ "rs_profile_test.py" ]
    deps = [ ":rs_profile" ]
  }
}
