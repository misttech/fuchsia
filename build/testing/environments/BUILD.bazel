"""Shared test environments for `fx_test(environments = ...)`.

These mirror the individual environments in //build/testing/environments.gni,
under the same names.

There are no targets for the environment lists in environments.gni:
  - `basic_envs` is what an `fx_test()` with no `environments` gets.
  - Other lists can be added when a Bazel test needs them, as Starlark lists
    of absolute labels of these targets in a .bzl file in this package.
"""

load(
    "//build/bazel/rules/testing:fx_test_environment.bzl",
    "fx_test_environment",
)
load(":device_types.bzl", "device_types", "host_device_types")

package(default_applicable_licenses = ["//:license"])

# Only environments that tests all over the tree use are public. The others are
# visible to the areas whose GN tests reference them directly, or private if no
# GN test does, so that new uses of specialized or scarce testbeds get reviewed
# here. Environments that GN tests only get through a list like
# `wlan_ap_iperf_envs` or `all_fuchsia_envs` count as unused, because those
# lists don't exist in Bazel yet. A list's labels are resolved where the list is
# used, so porting a list means making each of its environments visible to the
# list's users.

# LINT.IfChange(environments)

fx_test_environment(
    name = "aemu_env",
    dimensions = {"device_type": device_types.aemu},
    visibility = ["//visibility:public"],
)

