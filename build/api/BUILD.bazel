    deps = [":elf_sizes"],
)

py_library(
    name = "file_to_test_package",
    srcs = ["file_to_test_package.py"],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = [
        ":gn_ninja_outputs",
        "//build/bazel/scripts:build_utils",
