load("@rules_python//python:py_library.bzl", "py_library")
load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_py_test.bzl", "host_py_test")

package(default_applicable_licenses = ["//:license"])

py_library(
    name = "affected_tests",
    srcs = ["affected_tests.py"],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = [
        ":ninja_artifacts",
        "//build/bazel/scripts:build_utils",
    ],
)

host_py_test(
    name = "affected_tests_test",
    srcs = ["affected_tests_test.py"],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = [
        ":affected_tests",
        ":ninja_artifacts",
    ],
)

py_library(
    name = "build_api_filter",
    srcs = ["build_api_filter.py"],
    target_compatible_with = HOST_OS_CONSTRAINTS,
)

host_py_test(
    name = "build_api_filter_test",
    srcs = ["build_api_filter_test.py"],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = [":build_api_filter"],
)

py_library(
    name = "debug_symbols",
    srcs = ["debug_symbols.py"],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = [
        "//build:__pkg__",
        "//build/bazel/scripts:__pkg__",
    ],
)

host_py_test(
    name = "debug_symbols_test",
    srcs = ["debug_symbols_test.py"],
    target_compatible_with = HOST_OS_CONSTRAINTS,
