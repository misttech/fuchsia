# This target cannot be named "client" as it would conflict
# with the script with the same name during mypy checks.
py_library(
    name = "client_lib",
    srcs = ["client.py"],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = [
        ":affected_tests",
        ":build_api_filter",
        ":debug_symbols",
        ":elf_sizes",
        ":file_to_test_package",
        ":gn_labels",
        ":gn_ninja_outputs",
        ":ninja_artifacts",
        ":script_commands",
        "//build/bazel/scripts:build_utils",
    ],
)
