py_library(
    name = "gn_ninja_outputs",
    srcs = ["gn_ninja_outputs.py"],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = [
        "//build/beads/scripts:__pkg__",
        "//build/ninja_implicit_inputs:__pkg__",
    ],
