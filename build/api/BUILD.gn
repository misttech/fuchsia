import("//build/bazel/bazel_test_suite.gni")
import("//build/python/python_library.gni")
import("//build/testing/python_build_time_tests.gni")

if (is_host) {
  # GN copies of the host_py_test() targets in BUILD.bazel, which bazel2gn
  # can't translate yet. These run the same tests at build time.
  python_build_time_tests("affected_tests_test") {
    tests = [ "affected_tests_test.py" ]
    deps = [
      ":affected_tests",
      ":ninja_artifacts",
    ]
  }

  python_build_time_tests("build_api_filter_test") {
    tests = [ "build_api_filter_test.py" ]
    deps = [ ":build_api_filter" ]
  }

  python_build_time_tests("debug_symbols_test") {
    tests = [ "debug_symbols_test.py" ]
    deps = [ ":debug_symbols" ]
  }

  python_build_time_tests("elf_sizes_test") {
    tests = [ "elf_sizes_test.py" ]
    deps = [ ":elf_sizes" ]
  }

  python_build_time_tests("file_to_test_package_test") {
    tests = [ "file_to_test_package_test.py" ]
    deps = [ ":file_to_test_package" ]
  }

  python_build_time_tests("gn_labels_test") {
    tests = [ "gn_labels_test.py" ]
    deps = [ ":gn_labels" ]
  }

  python_build_time_tests("gn_ninja_outputs_test") {
    tests = [ "gn_ninja_outputs_test.py" ]
    deps = [ ":gn_ninja_outputs" ]
  }

  python_build_time_tests("ninja_artifacts_test") {
    tests = [ "ninja_artifacts_test.py" ]
    deps = [ ":ninja_artifacts" ]
  }

  python_build_time_tests("script_commands_test") {
    tests = [ "script_commands_test.py" ]
    deps = [ ":script_commands" ]
  }

  # This test is not in BUILD.bazel because Bazel can't express it yet: it
  # runs the `client` launcher, which executes the prebuilt Python interpreter
  # and Ninja binary from the checkout, and neither is available as a Bazel
  # test runfile.
  python_build_time_tests("client_test") {
    tests = [ "client_test.py" ]
    inputs = [
      "client",
      "target_metadata.schema.json",

      # Ninja is accessed implicitly by the test now.
      "//prebuilt/third_party/ninja/${host_os}-${host_cpu}/ninja",
    ]
    deps = [ ":client_lib" ]
  }

  group("host_tests") {
    testonly = true
    deps = [
      ":affected_tests_test",
      ":build_api_filter_test",
      ":client_test",
      ":debug_symbols_test",
      ":elf_sizes_test",
      ":file_to_test_package_test",
      ":gn_labels_test",
      ":gn_ninja_outputs_test",
      ":ninja_artifacts_test",
      ":script_commands_test",
    ]
  }
}

bazel_test_suite("bazel_tests") {
  host_tests = [
    "//build/api:affected_tests_test",
    "//build/api:build_api_filter_test",
    "//build/api:debug_symbols_test",
    "//build/api:elf_sizes_test",
    "//build/api:file_to_test_package_test",
    "//build/api:gn_labels_test",
    "//build/api:gn_ninja_outputs_test",
    "//build/api:ninja_artifacts_test",
    "//build/api:script_commands_test",
  ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    ":host_tests($host_toolchain)",
  ]
}

