# Populate a build directory from resource() equivalent metadata.
#
# This defines an action() target that creates a subdirectory (within the build
# directory) containing hard links (virtual copies) of source and/or build
# files in a layout described by the resource() equivalent metadata in its
# $deps graph.
#
# Parameters
#
#  * outputs
#    - Required: A singleton list of a directory path.
#    - Type: list(path)
#
#  * sources
#    - Optional: Singleton list of distribution_manifest() JSON file path.
#    - Type: list(path)
#    - Default: get_target_outputs(deps[0])
#
#  * deps
#    - Required: Singleton list of target label that generates $sources.  If
#    $sources is empty or omitted, that must be a distribution_manifest()
#    target just defined.  This must also lead (via deps or data_deps)
#    to all the resource() equivalent targets of interest.
#    - Type: list(label)
#    - Default: []
#
#  * expected_outputs
#    - Required: If this is `true`, then there **MUST NOT** be any use of the
#    contents of the $outputs directory as _inputs_ to other parts of the build;
#    the contents of $outputs will not be checked by this build action and must
#    be used only for things like test-running where the build system is not
#    considering the modification time of any of those files.  Otherwise, this
#    must be a complete list of files populating the $outputs directory, given
#    as paths relative to that directory (the destinations in the metadata).
#    Order does not matter but the set must be complete; these become GN outputs
#    of the action() target so that Ninja will know to re-check their timestamps
#    after running this action in case any is an input to another build step.
#    - Type: true or list(path)
#
#  * metadata, testonly, visibility
#    - Optional: Usual GN meanings.
#
template("distribution_manifest_copy") {
  action(target_name) {
    forward_variables_from(invoker,
                           [
                             "deps",
                             "metadata",
                             "outputs",
                             "sources",
                             "testonly",
                             "visibility",
                           ])
    assert(defined(outputs), "distribution_entries_files() requires outputs")
    assert(outputs == [ outputs[0] ], "outputs must be a single directory")
    if (defined(sources) && sources != []) {
      assert(sources == [ sources[0] ], "sources must be a single file")
    } else {
      assert(defined(deps), "distribution_manifest_copy() requires deps")
      assert(deps == [ deps[0] ],
             "deps must list a single, local distribution_manifest() target")
      sources = get_target_outputs(deps[0])
    }
    script = "//build/dist/distribution-manifest-copy.py"
    depfile = "$target_gen_dir/$target_name.d"
    args = [
      "--output=" + rebase_path(outputs[0], root_build_dir),
      "--manifest=" + rebase_path(sources[0], root_build_dir),
      "--depfile=" + rebase_path(depfile, root_build_dir),
    ]

    assert(defined(invoker.expected_outputs),
           "distribution_manifest_copy() rqeuires expected_outputs")
    if (invoker.expected_outputs == true) {
      args += [ "--expect-any-output" ]
    } else {
      foreach(file, invoker.expected_outputs) {
        args += [ "--expect-output=" +
                  rebase_path(file, root_build_dir, outputs[0]) ]
        outputs += [ "${outputs[0]}/${file}" ]
      }
    }

    # This action is in fact hermetic enough.  Its inputs are all accounted for
    # in the depfile.  It does have individual output _files_ that are not
    # known statically, but they are all inside the the output directory that
    # itself is the sole output of the action in aggregate.  **NOTE:** This
    # requires each and every use of this template to be included in the
    # //build:non_hermetic_deps visibility list.
    hermetic_action_ignored_prefixes = outputs
  }
}
