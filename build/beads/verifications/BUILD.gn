import("//build/python/python_action.gni")
import("//build/python/python_binary.gni")
import("//build/python/python_library.gni")
import("//build/testing/python_build_time_tests.gni")

if (current_toolchain == default_toolchain) {
  # When `select_variant` is non-empty (e.g. asan, hwasan, lto, thinlto),
  # `variant_target()` in //build/config/BUILDCONFIG.gn redirects executable()
  # and rustc_binary() targets from `default_toolchain` / `host_toolchain` to
  # `fuchsia_default_variant_toolchain` / `host_default_variant_toolchain` (or
  # the `-novariant` toolchain if no variant applies to that environment).
  _fuchsia_verification_toolchain = fuchsia_default_variant_toolchain
  _host_verification_toolchain = host_default_variant_toolchain
  if (select_variant_canonical != []) {
    if (_fuchsia_verification_toolchain == default_toolchain) {
      _fuchsia_verification_toolchain = "${default_toolchain}-novariant"
    }
    if (_host_verification_toolchain == host_toolchain) {
      _host_verification_toolchain = "${host_toolchain}-novariant"
    }
  }

  # Records the default and variant-resolved Fuchsia and Host toolchains for the
  # current build configuration into `${root_build_dir}/beads_toolchains.json`
  # at `gn gen` time. `verify_build_commands.py` reads this file so it can
  # rewrite the unvarianted GN labels in `targets_to_compare.json` to the actual
  # variant toolchains where those targets and their Ninja commands are defined.
  generated_file("beads_toolchains_json") {
    outputs = [ "${root_build_dir}/beads_toolchains.json" ]
    output_conversion = "json"
    contents = {
      default_toolchain = default_toolchain
      host_toolchain = host_toolchain
      fuchsia_toolchain = _fuchsia_verification_toolchain
      host_variant_toolchain = _host_verification_toolchain
    }
  }

  # Convenience group used by `verify_multi_build_configs.py` (via
  # `build_only_labels = [ "//build/beads/verifications:example_targets" ]`) to
  # pull only the verification targets into the GN/Ninja graph without
  # elaborating the full product package universe.
  #
  # IMPORTANT: This group must depend on the GN labels of all targets listed in
  # `targets_to_compare.json` (in their corresponding Fuchsia and/or Host
  # verification toolchains) so that their compile and link commands are
  # generated in `build.ninja`.
  group("example_targets") {
    testonly = true
    public_deps = [
      ":beads_toolchains_json",
      "//build/beads/verifications/cc:beads_asm_example_lib(${_fuchsia_verification_toolchain})",
      "//build/beads/verifications/cc:beads_asm_example_lib(${_host_verification_toolchain})",
      "//build/beads/verifications/cc:beads_c_example_lib(${_fuchsia_verification_toolchain})",
      "//build/beads/verifications/cc:beads_c_example_lib(${_host_verification_toolchain})",
      "//build/beads/verifications/cc:beads_cc_example_bin(${_fuchsia_verification_toolchain})",
      "//build/beads/verifications/cc:beads_cc_example_bin(${_host_verification_toolchain})",
      "//build/beads/verifications/cc:beads_cc_example_lib(${_fuchsia_verification_toolchain})",
      "//build/beads/verifications/cc:beads_cc_example_lib(${_host_verification_toolchain})",
      "//build/beads/verifications/rust:beads_rust_example_bin(${_fuchsia_verification_toolchain})",
      "//build/beads/verifications/rust:beads_rust_example_bin(${_host_verification_toolchain})",
      "//build/beads/verifications/rust:beads_rust_example_bin_with_linker_args(${_host_verification_toolchain})",
      "//build/beads/verifications/rust:beads_rust_example_lib(${_fuchsia_verification_toolchain})",
      "//build/beads/verifications/rust:beads_rust_example_lib(${_host_verification_toolchain})",
    ]
  }
}

if (is_host) {
  python_binary("verify_build_commands") {
    testonly = true
    main_source = "verify_build_commands.py"
    sources = [
      "//build/api/gn_ninja_outputs.py",
      "//build/bazel/scripts/bazel_build_args.py",
      "//build/bazel/scripts/build_utils.py",
      "//build/beads/scripts/compare_utils.py",
      "//build/beads/scripts/flags_differences.py",
      "//build/beads/scripts/gn_runner.py",
      "//build/beads/scripts/normalize_clang_args.py",
      "//build/beads/scripts/normalize_rustc_args.py",
      "//build/beads/scripts/path_normalizer.py",
      "//build/beads/scripts/shell_utils.py",
    ]
  }

  python_library("verify_multi_build_configs_lib") {
    testonly = true
    sources = [
      "verify_build_commands.py",
      "verify_multi_build_configs.py",
    ]
    library_deps = [
      "//build/beads/scripts:compare_utils",
      "//build/beads/scripts:flags_differences",
    ]
  }

  # NOTE: There is no python_binary() target for the verify_multi_build_configs
  # script, because the latter cannot run at build time, and is already
  # correctly type-checked by the python_library() target above that
  # includes it in its sources.

  python_build_time_tests("verify_multi_build_configs_test") {
    tests = [ "verify_multi_build_configs_test.py" ]
    deps = [ ":verify_multi_build_configs_lib" ]
  }

  python_action("verify_build_commands_for_example") {
    # This runs `bazel aquery`, which will block if other Bazel commands are
    # running. So use the same pool as other Bazel actions to avoid conflicts.
    pool = "//:console($default_toolchain)"

    testonly = true
    binary_label = ":verify_build_commands"

    _manifest = "//build/beads/verifications/targets_to_compare.json"

    _stamp_file = "${target_out_dir}/${target_name}.stamp"
    _report_file = "${target_out_dir}/${target_name}.report.txt"

    outputs = [
      _report_file,
      _stamp_file,
    ]

    args = [
      "--fuchsia-dir",
      rebase_path("//", root_build_dir),
      "--build-dir",
      rebase_path(root_build_dir, root_build_dir),
      "--manifest",
      rebase_path(_manifest, root_build_dir),
      "--report",
      rebase_path(_report_file, root_build_dir),
      "--stamp",
      rebase_path(_stamp_file, root_build_dir),
    ]
    inputs = [
      "${root_build_dir}/beads_toolchains.json",
      "${root_build_dir}/ninja_outputs.json",
      "//prebuilt/third_party/ninja/${host_platform}/ninja",
      _manifest,

      # Any build file changes should trigger rerunning this action.
      "cc/BUILD.bazel",
      "cc/BUILD.gn",
      "rust/BUILD.gn",
      "rust/BUILD.bazel",
    ]
    deps = [
      ":example_targets(${default_toolchain})",
      "//:ninja_outputs_json(${default_toolchain})",
    ]

    # This action runs GN, Ninja, and Bazel queries, and it's very difficult
    # to list all the files it might read.
    hermetic_deps = false
  }

  group("tests") {
    testonly = true
    deps = [ ":verify_multi_build_configs_test" ]
    if (select_variant == []) {
      # Avoid running command comparison at build time in variant builds for
      # now, as host Rust sanitizer variant flags are not yet forwarded to
      # Bazel.
      deps += [ ":verify_build_commands_for_example" ]
    }
  }
}
