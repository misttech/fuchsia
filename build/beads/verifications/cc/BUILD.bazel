load("@fuchsia_rules_common//build_flags:build_flags.bzl", "build_flags")
load("//build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")
load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")

package(default_applicable_licenses = ["//:license"])

build_flags(
    name = "beads_example_flags",
    cflags = ["-Wno-undef"],
    cflags_c = ["-Wno-missing-prototypes"],
    cflags_cc = ["-Wno-overloaded-virtual"],
    defines = ["EXAMPLE_MACRO=1"],
    include_dirs = ["build/beads/verifications/cc/include"],
)

fx_cc_library(
    name = "beads_c_example_lib",
    srcs = ["src/c_lib.c"],
    hdrs = ["include/c_lib.h"],
    build_flags = [":beads_example_flags"],
)

fx_cc_library(
    name = "beads_cc_example_lib",
    srcs = ["src/cc_lib.cc"],
    hdrs = ["include/cc_lib.h"],
    build_flags = [":beads_example_flags"],
)

fx_cc_library(
    name = "beads_asm_example_lib",
    srcs = ["src/asm_func.S"],
    hdrs = ["include/asm_func.h"],
    build_flags = [":beads_example_flags"],
)

fx_cc_binary(
    name = "beads_cc_example_bin",
    srcs = ["src/main.cc"],
    build_flags = [":beads_example_flags"],
    deps = [
        ":beads_asm_example_lib",
        ":beads_c_example_lib",
        ":beads_cc_example_lib",
    ],
)

fx_cc_binary(
    name = "beads_cc_example_shlib",
    srcs = ["src/main.cc"],
    build_flags = [":beads_example_flags"],
    linkshared = True,
    visibility = ["//build/beads/verifications:__pkg__"],
    deps = [
        ":beads_asm_example_lib",
        ":beads_c_example_lib",
        ":beads_cc_example_lib",
    ],
)
