config("beads_example_flags") {
  cflags = [ "-Wno-undef" ]
  asmflags = cflags
  cflags_c = [ "-Wno-missing-prototypes" ]
  cflags_cc = [ "-Wno-overloaded-virtual" ]
  defines = [ "EXAMPLE_MACRO=1" ]
  include_dirs = [ "include" ]
}

static_library("beads_c_example_lib") {
  sources = [
    "include/c_lib.h",
    "src/c_lib.c",
  ]
  public_configs = [ ":beads_example_flags" ]
}

static_library("beads_cc_example_lib") {
  sources = [
    "include/cc_lib.h",
    "src/cc_lib.cc",
  ]
  public_configs = [ ":beads_example_flags" ]
}

static_library("beads_asm_example_lib") {
  sources = [
    "include/asm_func.h",
    "src/asm_func.S",
  ]
  public_configs = [ ":beads_example_flags" ]
}

executable("beads_cc_example_bin") {
  sources = [ "src/main.cc" ]
  deps = [
    ":beads_asm_example_lib",
    ":beads_c_example_lib",
    ":beads_cc_example_lib",
  ]
  configs += [ ":beads_example_flags" ]
}
