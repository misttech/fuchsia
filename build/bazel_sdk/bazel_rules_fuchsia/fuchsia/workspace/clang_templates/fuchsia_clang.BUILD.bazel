load("@bazel_skylib//lib:selects.bzl", "selects")
load("@fuchsia_sdk//:generated_constants.bzl", sdk_constants = "constants")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_toolchain_suite")
load(
    "@rules_fuchsia//fuchsia:defs.bzl",
    "fuchsia_cpu_filter_dict",
)
load("//:generated_constants.bzl", clang_constants = "constants")
load(
    "//common:toolchains/clang/feature_flag.bzl",
    "feature_flag",
)
load(
    "//common:toolchains/clang/repository_utils.bzl",
    "setup_clang_repository",
)
load(
    "//common:toolchains/clang/toolchain_utils.bzl",
    "generate_clang_cc_toolchain",
)
load(
    ":sysroot_defs.bzl",
    "EXTRA_TARGET_COMPATIBLE_WITH",
    "FUCHSIA_SYSROOT_HEADERS_FILEGROUPS",
    "FUCHSIA_SYSROOT_LIBS_FILEGROUPS",
    "FUCHSIA_SYSROOT_PATHS",
)

licenses(["notice"])

package(default_visibility = ["//visibility:public"])

setup_clang_repository(clang_constants)

# This is the set of CPUs that the Fuchsia SDK provides sysroots for.
_SDK_SUPPORTED_TARGET_CPUS = sdk_constants.target_cpus

cc_toolchain_suite(
    name = "toolchain",
    toolchains = fuchsia_cpu_filter_dict(
        {
            "arm64": {
                "aarch64|llvm": ":cc-fuchsia-aarch64",
                "aarch64": ":cc-fuchsia--aarch64",
            },
            "x64": {
                "x86_64|llvm": ":cc-fuchsia-x86_64",
                "x86_64": ":cc-fuchsia-x86_64",
            },
            "riscv64": {
                "riscv64|llvm": ":cc-fuchsia-riscv64",
                "riscv64": ":cc-fuchsia-riscv64",
            },
        },
        _SDK_SUPPORTED_TARGET_CPUS,
    ),
)

_TO_BAZEL_CPU_MAP = {
    "x64": "x86_64",
    "arm64": "aarch64",
}

TARGET_CPUS = [_TO_BAZEL_CPU_MAP.get(cpu, cpu) for cpu in _SDK_SUPPORTED_TARGET_CPUS]

exports_files([
    "bin/clang-format",
    "bin/clang-tidy",
    "bin/llvm-readelf",

    # Referenced from @fuchsia_sdk//clang:BUILD.bazel
    "lib/debug/.build-id",
])

[
    generate_clang_cc_toolchain(
        name = "cc-fuchsia-" + cpu,
        host_os = "linux",
        host_arch = "x86_64",
        target_os = "fuchsia",
        target_arch = cpu,
        sysroot_header_files = [FUCHSIA_SYSROOT_HEADERS_FILEGROUPS[cpu]],
        sysroot_library_files = [FUCHSIA_SYSROOT_LIBS_FILEGROUPS[cpu]],
        sysroot_path = FUCHSIA_SYSROOT_PATHS[cpu],
        extra_target_compatible_with = EXTRA_TARGET_COMPATIBLE_WITH,

        # The Fuchsia SDK handles the API level with a custom scheme that
        # relies on transitions and does not provide a configured target
        # providing it to dependents.
        fuchsia_api_level = None,
    )
    for cpu in TARGET_CPUS
]

cc_library(
    name = "sources",
    srcs = glob(["src/**"], allow_empty = True),
    visibility = ["//visibility:public"],
)

config_setting(
    name = "aarch64_cpu_build",
    values = {"cpu": "aarch64"},
)

selects.config_setting_group(
    name = "arm64_build",
    match_any = [
        "@platforms//cpu:arm64",
        ":aarch64_cpu_build",
    ],
)

config_setting(
    name = "x86_64_cpu_build",
    values = {"cpu": "x86_64"},
)

config_setting(
    name = "k8_cpu_build",
    values = {"cpu": "k8"},
)

selects.config_setting_group(
    name = "x64_build",
    match_any = [
        "@platforms//cpu:x86_64",
        ":x86_64_cpu_build",
        ":k8_cpu_build",
    ],
)

config_setting(
    name = "riscv64_cpu_build",
    values = {"cpu": "riscv64"},
)

selects.config_setting_group(
    name = "riscv64_build",
    match_any = [
        "@platforms//cpu:riscv64",
        ":riscv64_cpu_build",
    ],
)

feature_flag(
    name = "asan_flag",
    feature_name = "asan",
    visibility = ["//visibility:private"],
)

feature_flag(
    name = "hwasan_flag",
    feature_name = "hwasan",
    visibility = ["//visibility:private"],
)

config_setting(
    name = "novariant",
    flag_values = {
        ":asan_flag": "False",
        ":hwasan_flag": "False",
    },
    visibility = ["//visibility:public"],
)

# IMPORTANT: The hwasan feature takes precedence over the asan one.
# Keep this in sync with the definition of sanitizer_features in
# //common:toolchains/clang/sanitizer.bzl
config_setting(
    name = "asan_variant",
    flag_values = {
        ":asan_flag": "True",
        ":hwasan_flag": "False",
    },
    visibility = ["//visibility:public"],
)

config_setting(
    name = "hwasan_variant",
    flag_values = {
        ":hwasan_flag": "True",
    },
    visibility = ["//visibility:public"],
)

selects.config_setting_group(
    name = "arm64_novariant",
    match_all = [
        ":arm64_build",
        ":novariant",
    ],
)

selects.config_setting_group(
    name = "arm64_asan_variant",
    match_all = [
        ":arm64_build",
        ":asan_variant",
    ],
)

selects.config_setting_group(
    name = "arm64_hwasan_variant",
    match_all = [
        ":arm64_build",
        ":hwasan_variant",
    ],
)

selects.config_setting_group(
    name = "x64_novariant",
    match_all = [
        ":x64_build",
        ":novariant",
    ],
)

selects.config_setting_group(
    name = "x64_asan_variant",
    match_all = [
        ":x64_build",
        ":asan_variant",
    ],
)

selects.config_setting_group(
    name = "x64_hwasan_variant",
    match_all = [
        ":x64_build",
        ":hwasan_variant",
    ],
)

selects.config_setting_group(
    name = "riscv64_novariant",
    match_all = [
        ":riscv64_build",
        ":novariant",
    ],
)

selects.config_setting_group(
    name = "riscv64_asan_variant",
    match_all = [
        ":riscv64_build",
        ":asan_variant",
    ],
)

selects.config_setting_group(
    name = "riscv64_hwasan_variant",
    match_all = [
        ":riscv64_build",
        ":hwasan_variant",
    ],
)
