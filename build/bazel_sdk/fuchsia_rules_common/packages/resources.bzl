"""Common resources and binary collection rules."""

load(
    "@fuchsia_rules_common//:utils.bzl",
    "get_target_deps_from_attributes",
    "make_resource_struct",
)
load(
    "@fuchsia_rules_common//debug_symbols:providers.bzl",
    "FuchsiaUnstrippedBinariesInfo",
    "FuchsiaUnstrippedBinaryInfo",
)
load(
    "@fuchsia_rules_common//packages:providers.bzl",
    "FuchsiaCollectedPackageResourcesInfo",
    "FuchsiaPackageResourcesInfo",
)
load("@rules_cc//cc/common:cc_info.bzl", "CcInfo")
load("@rules_cc//cc/common:cc_shared_library_info.bzl", "CcSharedLibraryInfo")
load("@rules_cc//cc/common:debug_package_info.bzl", "DebugPackageInfo")

# Providers emitted by compiled C++ and Rust binary or library rules.
COMPILED_BINARY_PROVIDERS = (
    DebugPackageInfo,
    CcSharedLibraryInfo,
    CcInfo,
    RunEnvironmentInfo,
)

# Providers emitted by Fuchsia binary packaging wrappers.
PACKAGED_BINARY_PROVIDERS = (
    FuchsiaUnstrippedBinariesInfo,
    FuchsiaUnstrippedBinaryInfo,
)

def _check_not_compiled_binary(label, rule_name, attr_name, target):
    if any([p in target for p in PACKAGED_BINARY_PROVIDERS]):
        fail(
            "{}() target '{}' cannot wrap '{}' in `{}`. Pass `fx_packaged_binary()` targets directly to `fx_component(deps = ...)` or `fx_package(resources = ...)` instead of wrapping them in `{}()`.".format(
                rule_name,
                label,
                target.label,
                attr_name,
                rule_name,
            ),
        )
    if any([p in target for p in COMPILED_BINARY_PROVIDERS]):
        fail(
            "{}() target '{}' cannot reference compiled binary or library target '{}' in `{}` because it would be packaged unstripped and without runtime dependencies or debug symbols. Use `fx_packaged_binary()` instead.".format(
                rule_name,
                label,
                target.label,
                attr_name,
            ),
        )

def _check_dest_not_binary_dir(label, rule_name, dest, allow_binary_output_dir):
    normalized_dest = dest.removeprefix("/")
    if not allow_binary_output_dir and (
        normalized_dest == "bin" or normalized_dest.startswith("bin/")
    ):
        fail(
            "{}() target '{}' cannot install to '{}' (`bin/` is reserved for packaged binaries; use `fx_packaged_binary()` or set `allow_binary_output_dir = True` for non-ELF files such as shell scripts).".format(
                rule_name,
                label,
                dest,
            ),
        )

# Package Resource providers & rules

def package_resources_providers(ctx, resources):
    return [
        FuchsiaPackageResourcesInfo(resources = resources),
        # Note: We create a package_resource for our cc_binary distributions
        # in the SDK and we need to export the default info as a root symlink
        # to access them. This needs to exist until fuchsia_cc.bzl does not
        # need to access the root_symlinks.
        DefaultInfo(
            runfiles = ctx.runfiles(
                root_symlinks = {r.dest: r.src for r in resources},
            ),
        ),
    ]

def _resource_impl(ctx):
    if len(ctx.attr.dest) == 0:
        fail("dest must not be an empty string")

    _check_not_compiled_binary(ctx.label, "resource", "src", ctx.attr.src)
    _check_dest_not_binary_dir(
        ctx.label,
        "resource",
        ctx.attr.dest,
        ctx.attr.allow_binary_output_dir,
    )

    return package_resources_providers(ctx, [make_resource_struct(
        src = ctx.files.src[0],
        dest = ctx.attr.dest,
    )])

resource = rule(
    doc = """Declares a resource to be included in a Fuchsia package.

`src` can be a static file or something generated by another rule. Compiled
binaries and libraries cannot be packaged as resources; use
`fx_packaged_binary()` instead.

`dest` must be a path relative to /. Installing directly into `bin/` is
disallowed unless `allow_binary_output_dir = True` (intended only for non-ELF
files like shell scripts).

This rule can be added as a dependency of a fuchsia_package and it
will be added to the final package contents.
""",
    implementation = _resource_impl,
    attrs = {
        "src": attr.label(
            doc = "The resource to include in the package.",
            mandatory = True,
            allow_single_file = True,
        ),
        "dest": attr.string(
            doc = "The path where this will be installed in the package. Cannot start with `bin/` unless `allow_binary_output_dir` is True.",
            mandatory = True,
        ),
        "allow_binary_output_dir": attr.bool(
            doc = "Whether to allow installing non-ELF files (such as shell scripts) into `bin/`.",
            default = False,
        ),
    },
)

def _fuchsia_package_resource_collection_impl(ctx):
    resources = []

    for dep in ctx.attr.resources:
        resources.extend(dep[FuchsiaPackageResourcesInfo].resources)

    return package_resources_providers(ctx, resources)

fuchsia_package_resource_collection = rule(
    doc = """Declares a collection of resources to be included in a Fuchsia package.
""",
    implementation = _fuchsia_package_resource_collection_impl,
    attrs = {
        "resources": attr.label_list(
            doc = "The resources to include in the package.",
            mandatory = True,
        ),
    },
)

def _fuchsia_package_resource_group_impl(ctx):
    resources = []
    dest = ctx.attr.dest.removesuffix("/")

    for src_target in ctx.attr.srcs:
        _check_not_compiled_binary(
            ctx.label,
            "fuchsia_package_resource_group",
            "srcs",
            src_target,
        )
    _check_dest_not_binary_dir(
        ctx.label,
        "fuchsia_package_resource_group",
        dest,
        ctx.attr.allow_binary_output_dir,
    )

    for src in ctx.files.srcs:
        if ctx.attr.basename_only:
            name = src.basename
        else:
            name = src.path
            if src.root:
                # Remove gen directories, e.g. bazel-bin
                name = name.removeprefix(src.root.path + "/")
            if src.owner.workspace_root:
                # Remove workspace name, e.g. external/fuchsia_sdk
                name = name.removeprefix(src.owner.workspace_root + "/")
            name = name.removeprefix(ctx.label.package + "/").removeprefix(ctx.attr.strip_prefix).removeprefix("/")

        full_dest = dest + "/" + name
        _check_dest_not_binary_dir(
            ctx.label,
            "fuchsia_package_resource_group",
            full_dest,
            ctx.attr.allow_binary_output_dir,
        )
        resources.append(
            make_resource_struct(src = src, dest = full_dest),
        )

    return package_resources_providers(ctx, resources)

fuchsia_package_resource_group = rule(
    doc = """Declares a group of resources to be included in a Fuchsia package.

Compiled binaries and libraries cannot be packaged as resources; use
`fx_packaged_binary()` instead.

Installing directly into `bin/` is disallowed unless
`allow_binary_output_dir = True` (intended only for non-ELF files like shell
scripts).
""",
    implementation = _fuchsia_package_resource_group_impl,
    attrs = {
        "srcs": attr.label_list(
            doc = "The resource to include in the package.",
            mandatory = True,
            allow_files = True,
        ),
        "dest": attr.string(
            doc = "The path where this will be installed in the package. Cannot start with `bin/` unless `allow_binary_output_dir` is True.",
            mandatory = True,
        ),
        "strip_prefix": attr.string(
            doc = "A path to remove from the srcs",
            default = "",
        ),
        "basename_only": attr.bool(
            doc = "The dir will be removed from srcs attribute, and installed in dest + basename",
        ),
        "allow_binary_output_dir": attr.bool(
            doc = "Whether to allow installing non-ELF files (such as shell scripts) into `bin/`.",
            default = False,
        ),
    },
)

# Resources Collection Aspect & Rule

def _collect_package_resources_info(deps):
    resource_depsets = []
    for t in deps:
        if FuchsiaCollectedPackageResourcesInfo in t:
            resource_depsets.append(t[FuchsiaCollectedPackageResourcesInfo].collected_resources)
    return resource_depsets

def _collect_all_package_resources_aspect_impl(target, aspect_ctx):
    direct = []
    if FuchsiaPackageResourcesInfo in target:
        direct.extend(target[FuchsiaPackageResourcesInfo].resources)

    return FuchsiaCollectedPackageResourcesInfo(
        collected_resources = depset(
            direct = direct,
            transitive = _collect_package_resources_info(
                get_target_deps_from_attributes(
                    aspect_ctx.rule.attr,
                    aspect_ctx.rule.kind,
                ),
            ),
        ),
    )

_collect_all_package_resources_aspect = aspect(
    doc = """An apsect which collects all of the package resources in the dependency
    chain. The resources will be added to a FuchsiaCollectedPackageResourcesInfo
    provider.""",
    implementation = _collect_all_package_resources_aspect_impl,
    attr_aspects = ["*"],
    provides = [FuchsiaCollectedPackageResourcesInfo],
)

def _find_all_package_resources_impl(ctx):
    return FuchsiaCollectedPackageResourcesInfo(
        collected_resources = depset(
            direct = [],
            transitive = _collect_package_resources_info(
                ctx.attr.deps,
            ),
        ),
    )

fuchsia_find_all_package_resources = rule(
    doc = """A rule which collects all of the FuchsiaPackageResourcesInfo providers.

    This rule will take a set of deps and runs through all of their dependencies
    to find any rules which export the FuchsiaPackageResourcesInfo provider. It
    then will collect all of the resources and expose them in a FuchsiaCollectedPackageResourcesInfo
    provider.
        """,
    implementation = _find_all_package_resources_impl,
    provides = [FuchsiaCollectedPackageResourcesInfo],
    attrs = {
        "deps": attr.label_list(
            doc = "A list of roots for the DAG of dependencies to scan.",
            mandatory = True,
            aspects = [_collect_all_package_resources_aspect],
        ),
    },
)
