import("//build/host.gni")
import("//build/product.gni")
import("//build/python/python_action.gni")

# Declares metadata for a set of tests and the product bundle to run them on.
#
# By default tests will run on the default product bundle from the build.
# With multi-product builds, we may want to target a specific non-default
# product bundle for a set of tests.

# We can now use this GN template for declaring this desire.

# product_bundle_test_group("target") {
#   product_bundle_name = "foo"
#   tests = [ ... ]
# }

#
# Parameters:
#
#   tests (optional; default=[])
#     DEPRECATED: prefer target_tests or host_tests
#     [list] List of targets to walk to find test specs.
#
#   target_tests (optional; default=[])
#     [list] List of target targets to walk to find test specs.
#     Either this or host_tests must be defined.
#
#   host_tests (optional; default=[])
#     [list] List of host targets to walk to find test specs.
#     Either this or target_tests must be defined.
#
#   product_bundle (optional)
#     [label] The product_bundle target to run the tests against.
#     This is preferred over `product_bundle_name`.
#
#   product_bundle_name (optional; default = target_name)
#     [str] The name of the product bundle to assign the tests to.
#     DEPRECATED: Use `product_bundle` instead.
#
#   environments (optional)
#     [list of scopes] The environments that all tests in this group must use,
#     overriding any environments set by individual tests.
#     Cannot be specified with `allowed_environments` or `default_environments`.
#     See //docs/contribute/testing/environments.md.
#
#   allowed_environments (optional)
#     [list of scopes] The environments that tests in this group may use if
#     they explicitly specify environments.
#     Cannot be specified with `environments`.
#
#   default_environments (optional; default = allowed_environments)
#     [list of scopes] The environments that tests in this group will use as
#     their default if they do not specify environments. Must be a subset of
#     `allowed_environments`.
#     Cannot be specified with `environments`.
#
#   build_only (optional; default = false)
#     [bool] If true, the tests in this group are built but not run.
#
template("product_bundle_test_group") {
  assert(defined(invoker.tests) || defined(invoker.target_tests) ||
             defined(invoker.host_tests),
         "Either 'tests' or 'target_tests' or 'host_tests' must be defined")
  assert(
      !(defined(invoker.product_bundle) && defined(invoker.product_bundle_name)),
      "Cannot define both 'product_bundle' and 'product_bundle_name) in ${target_name}")

  # The test_spec should always be generate in the default toolchain even if
  # these are e2e (host) tests, because we want to avoid accidentally creating
  # two test specs for the same test.
  if (is_host) {
    group(target_name) {
      testonly = true
      not_needed(invoker, "*")
      public_deps = [ ":${target_name}($default_toolchain)" ]
    }
  } else {
    _product_bundle_deps = []
    if (defined(invoker.product_bundle)) {
      # The name of the product bundle is the name of the target.
      _product_bundle_name = get_label_info(invoker.product_bundle, "name")
      _product_bundle_deps += [ invoker.product_bundle ]
    } else if (defined(invoker.product_bundle_name)) {
      _product_bundle_name = invoker.product_bundle_name
    } else {
      # The default product_bundle_name is the target_name.
      _product_bundle_name = target_name
    }

    _build_only = defined(invoker.build_only) && invoker.build_only
    _environments = []
    _allowed_environments = []
    _default_environments = []
    if (_build_only) {
      assert(
          !defined(invoker.environments) &&
              !defined(invoker.allowed_environments) &&
              !defined(invoker.default_environments),
          "build_only test groups should not specify environments, allowed_environments, or default_environments")
    } else if (defined(invoker.environments)) {
      assert(invoker.environments != [],
             "'environments' cannot be empty if provided.")
      assert(
          !defined(invoker.allowed_environments) &&
              !defined(invoker.default_environments),
          "Cannot specify 'environments' with 'allowed_environments' or 'default_environments'")
      _environments = invoker.environments
    } else {
      if (defined(invoker.allowed_environments)) {
        assert(invoker.allowed_environments != [],
               "'allowed_environments' cannot be empty if provided.")
        _allowed_environments = invoker.allowed_environments
      }
      if (defined(invoker.default_environments)) {
        assert(invoker.default_environments != [],
               "'default_environments' cannot be empty if provided.")
        _default_environments = invoker.default_environments
        assert(_default_environments + _allowed_environments -
                   _allowed_environments == [],
               "default_environments must be a subset of allowed_environments")
      } else {
        _default_environments = _allowed_environments
      }
    }

    _tests_json = "${target_out_dir}/${target_name}/tests.json"
    _bazel_target_test_suites =
        "${target_out_dir}/${target_name}/bazel_target_test_suites.txt"

    _deps = _product_bundle_deps
    if (defined(invoker.tests)) {
      _deps += invoker.tests
    }
    if (defined(invoker.target_tests)) {
      _deps += invoker.target_tests
    }
    if (defined(invoker.host_tests)) {
      foreach(host_test, invoker.host_tests) {
        host_test_label = get_label_info(host_test, "label_no_toolchain") +
                          "($host_toolchain)"
        _deps += [ host_test_label ]
      }
    }

    generated_file("${target_name}.bazel_target_test_suites") {
      visibility = [ ":*" ]
      testonly = true
      data_keys = [ "bazel_target_test_suite" ]
      walk_keys = [
        "bazel_target_test_suite_barrier",
        "tests_barrier",
      ]
      outputs = [ _bazel_target_test_suites ]
      output_conversion = "list lines"
      deps = _deps

      metadata = {
        # Avoid walking `_deps` a second time through this helper target.
        tests_barrier = []
        bazel_target_test_suite_barrier = []
      }
    }

    generated_file(target_name) {
      testonly = true
      data_keys = [ "tests" ]
      walk_keys = [ "tests_barrier" ]
      outputs = [ _tests_json ]
      output_conversion = "json"

      deps = _deps + [ ":${target_name}.bazel_target_test_suites" ]

      metadata = {
        tests_barrier = []
        pb_test_groups = [
          {
            product_bundle_name = _product_bundle_name
            build_only = _build_only
            environments = _environments
            allowed_environments = _allowed_environments
            default_environments = _default_environments
            tests_json = rebase_path(_tests_json, root_build_dir)
            bazel_target_test_suites =
                rebase_path(_bazel_target_test_suites, root_build_dir)
          },
        ]
      }
    }
  }
}
