import("//build/config/zircon/standard.gni")
import("//build/toolchain/zircon/zircon_toolchain_suite.gni")

if (current_toolchain == default_toolchain) {
  foreach(cpu, standard_fuchsia_cpus) {
    zircon_toolchain_suite("user.basic_$cpu") {
      cpu = cpu
      os = "fuchsia"
      strip = "--strip-sections"
      environment = "user.basic"

      configs = [ "//build/config/zircon:user-link" ]
      source_deps = [ "//build/config/zircon:user_deps" ]

      executable_configs = [ "//build/config/zircon:user-executable" ]

      tags = [
        "no-compiler-abi",
        "no-floating-point",
        "standalone",
      ]
      exclude_variant_tags = [ "needs-compiler-abi" ]

      # LINT.IfChange(sysroot_variants)
      # Enable variants that do not have "needs-compiler-abi" and are enabled
      # in //sdk/lib/c:user.libc_$cpu, since user_basic_redirect() redirects
      # basic_abi targets in user.libc_$cpu-<variant> to
      # user.basic_$cpu-<variant>-shared.
      enable_variants = [
        "coverage",
        "ubsan",
      ]

      # LINT.ThenChange(
      #   //sdk/lib/c/BUILD.gn:sysroot_variants,
      #   //sdk/lib/c/sysroot_entries.gni:sysroot_variants,
      # )
    }
  }
}
