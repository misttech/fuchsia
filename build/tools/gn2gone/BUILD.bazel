load("@fuchsia_build_config//:defs.bzl", "build_config")
load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("@platforms//host:constraints.bzl", "HOST_CONSTRAINTS")
load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules:cipd_prebuilt.bzl", "cipd_prebuilt_file")
load("//build/bazel/rules/host:defs.bzl", "go_binary_host_tool")
load("//build/bazel/rules/host_tests:host_go_test.bzl", "host_go_test")
load("//build/bazel/rules/host_tests:host_test_data.bzl", "host_test_data_files")

package(default_applicable_licenses = ["//:license"])

go_library(
    name = "gn2gone_lib",
    srcs = [
        "gnast.go",
        "index.go",
        "load.go",
        "resolve.go",
        "scan.go",
        "testwiring.go",
        "unsync.go",
    ],
    importpath = "go.fuchsia.dev/fuchsia/build/tools/gn2gone",
    target_compatible_with = HOST_CONSTRAINTS,
    deps = [
        "//build/tools/bazel2gn:bazel2gn_lib",
        "//third_party/golibs:go.starlark.net/syntax",
    ],
)

go_binary_host_tool(
    name = "gn2gone",
    srcs = [
        "cmd/main.go",
    ],
    target_compatible_with = HOST_CONSTRAINTS,
    deps = [
        ":gn2gone_lib",
    ],
)

# The tests run the real gn to parse fixture files.
cipd_prebuilt_file(
    name = "gn",
    testonly = True,
    path = "//prebuilt/third_party/gn/%s/gn" % build_config.host_tag,
)

host_test_data_files(
    name = "gn2gone_test_data",
    testonly = True,
    srcs = [":gn"],
    dest_dir = select({
        "@platforms//cpu:aarch64": "host_arm64/test_data/gn2gone",
        "@platforms//cpu:x86_64": "host_x64/test_data/gn2gone",
    }),
    target_compatible_with = HOST_OS_CONSTRAINTS,
)

host_go_test(
    name = "gn2gone_tests",
    srcs = [
        "gn2gone_test.go",
    ],
    embed = [
        ":gn2gone_lib",
    ],
    target_compatible_with = HOST_CONSTRAINTS,
    test_data = [":gn2gone_test_data"],
    visibility = [
        "//build/tools:__pkg__",
    ],
    deps = [
        "//build/tools/bazel2gn:bazel2gn_lib",
        "//third_party/golibs:github.com/google/go-cmp/cmp",
    ],
)
