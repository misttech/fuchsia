load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("@platforms//host:constraints.bzl", "HOST_CONSTRAINTS")
load("//build/bazel/rules/host:defs.bzl", "go_binary_host_tool")
load("//build/bazel/rules/host_tests:host_go_test.bzl", "host_go_test")

package(default_applicable_licenses = ["//:license"])

go_library(
    name = "bazel2gn_lib",
    srcs = [
        "bazel2gn.go",
        "compiled_action.go",
        "constants.go",
        "fx_component.go",
        "fx_test_package.go",
        "fx_unittest_package.go",
        "genrule.go",
        "rust_check_cfg.go",
        "rust_test_crate.go",
        "rustenv.go",
        "select.go",
        "sentinel.go",
        "tags.go",
        "transformers.go",
    ],
    embedsrcs = [
        "third_party_target_map.json",
    ],
    importpath = "go.fuchsia.dev/fuchsia/build/tools/bazel2gn",
    target_compatible_with = HOST_CONSTRAINTS,
    # gn2gone shares the sentinel string and discovery rules.
    visibility = ["//build/tools/gn2gone:__pkg__"],
    deps = [
        "//third_party/golibs:go.starlark.net/syntax",
    ],
)

go_binary_host_tool(
    name = "bazel2gn",
    srcs = [
        "cmd/main.go",
    ],
    target_compatible_with = HOST_CONSTRAINTS,
    deps = [
        ":bazel2gn_lib",
        "//third_party/golibs:github.com/google/go-cmp/cmp",
        "//tools/lib/color",
        "//tools/lib/logger",
    ],
)

host_go_test(
    name = "bazel2gn_tests",
    srcs = [
        "bazel2gn_test.go",
        "compiled_action_test.go",
        "constants_test.go",
        "exec_properties_test.go",
        "fx_component_test.go",
        "fx_test_package_test.go",
        "genrule_test.go",
        "rust_check_cfg_test.go",
        "rust_test_crate_test.go",
        "rustenv_test.go",
        "select_test.go",
        "sentinel_test.go",
        "tags_test.go",
        "transformers_test.go",
    ],
    embed = [
        ":bazel2gn_lib",
    ],
    target_compatible_with = HOST_CONSTRAINTS,
    visibility = [
        "//build/tools:__pkg__",
    ],
    deps = [
        "//third_party/golibs:github.com/google/go-cmp/cmp",
        "//third_party/golibs:go.starlark.net/syntax",
    ],
)

host_go_test(
    name = "bazel2gn_cmd_tests",
    srcs = [
        "cmd/main.go",
        "cmd/main_test.go",
    ],
    target_compatible_with = HOST_CONSTRAINTS,
    visibility = [
        "//build/tools:__pkg__",
    ],
    deps = [
        ":bazel2gn_lib",
        "//third_party/golibs:github.com/google/go-cmp/cmp",
        "//tools/lib/color",
        "//tools/lib/logger",
    ],
)
