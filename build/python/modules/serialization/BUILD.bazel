    name = "serialization",
    srcs = [
        "__init__.py",
        "serialization.py",
    ],
    imports = [".."],
    visibility = [
        "//build:__pkg__",
        "//build/assembly:__subpackages__",
        "//build/python:__subpackages__",
        "//build/rbe:__pkg__",
        "//build/resultstore:__pkg__",
        "//build/scripts:__pkg__",
        "//tools/devshell:__subpackages__",
    ],
)
