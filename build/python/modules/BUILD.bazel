load("@rules_python//python:defs.bzl", "py_library")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//build/assembly/scripts:__pkg__"],
)

py_library(
    name = "serialization",
    srcs = [
        "serialization/__init__.py",
        "serialization/serialization.py",
    ],
    imports = ["."],
)

py_library(
    name = "depfile",
    srcs = [
        "depfile/__init__.py",
        "depfile/depfile.py",
    ],
    imports = ["."],
)

py_library(
    name = "assembly",
    srcs = [
        "assembly/__init__.py",
        "assembly/assembly_input_bundle.py",
        "assembly/common.py",
        "assembly/image_assembly_config.py",
        "assembly/package_copier.py",
        "assembly/package_manifest.py",
    ],
    imports = ["."],
    deps = [
        ":depfile",
        ":serialization",
    ],
)

py_library(
    name = "elf",
    srcs = [
        "elf/__init__.py",
        "elf/elfinfo.py",
        "elf/verify_manifest_elf_binaries.py",
    ],
    imports = ["."],
    visibility = [
        "//build/bazel/debug_symbols/tests:__pkg__",
    ],
)
