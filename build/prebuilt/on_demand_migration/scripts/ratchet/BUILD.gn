assert(is_host, "Only include ratchet scripts via the host toolchain")

import("//build/python/python_host_test.gni")

python_host_test("languages_test") {
  main_source = "languages_test.py"
  sources = [ "languages.py" ]
}

python_host_test("ratchet_test") {
  main_source = "ratchet_test.py"
  sources = [
    "languages.py",
    "ratchet.py",
  ]
}

group("tests") {
  testonly = true
  deps = [
    ":languages_test",
    ":ratchet_test",
  ]
}
