import("//build/bazel/bazel_inputs.gni")
import("//build/python/python_binary.gni")
import("//build/python/python_host_test.gni")

python_binary("dtc_py") {
  main_source = "//build/devicetree/dtc.py"
  deps = [ "//build/python/modules/assembly" ]
}

if (is_host) {
  python_host_test("dtc_test") {
    main_source = "dtc_test.py"
    sources = [ "dtc.py" ]
  }
}

group("tests") {
  testonly = true
  deps = [ ":dtc_test($host_toolchain)" ]
}
