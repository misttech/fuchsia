load("@bazel_skylib//lib:selects.bzl", "selects")
load("@fuchsia_build_info//:args.bzl", "clang_ml_inliner")
load("@fuchsia_rules_common//build_flags:build_flags.bzl", "build_flags")
load("@fuchsia_rules_common//build_flags:compiler_build_flags.bzl", "compiler_build_flags")
load(
    "@fuchsia_rules_common//build_flags:default_flag_values.bzl",
    "THREAD_SAFETY_CFLAGS",
    "THREAD_SAFETY_DEFINES",
)
load(
    "//build/bazel/config/derived:fuchsia_cxx_version.bzl",
    "fuchsia_cxx_version",
    "fuchsia_sdk_cxx_supported_versions",
)
load(":compress_debuginfo.bzl", "compress_debuginfo_build_flags")
load(":dwarf_version.bzl", "dwarf_version_build_flags")

package(default_applicable_licenses = ["//:license"])

# LINT.IfChange(relative_paths)
# NOTE: This assumes is_gcc=false && is_pecoff=false in Bazel.
compiler_build_flags(
    name = "relative_paths",
    c_family_flags = [
        # Make builds independent of the absolute file path. -ffile-prefix-map= can
        # be used to the same effect, but it requires putting the absolute path to
        # the build directory in the compile command, thus making it dependent on
        # the absolute path of build directory. -ffile-compilation-dir is designed
        # to address this issue, making both debug info and coverage mapping
        # independent of the absolute path of the build directory.
        "-ffile-compilation-dir=.",

        # This makes sure that include directories in the toolchain are represented
        # as relative to the build directory (because that's how we invoke the
        # compiler), rather than absolute.  This can affect __FILE__ expansions
        # (e.g. assertions in system headers).  We normally run a compiler that's
        # someplace within the source tree, so its absolute installation path will
        # have a prefix matching `absolute_path` and hence be mapped to
        # `relative_path` in the debugging information, so this should actually be
        # superfluous for purposes of the debugging information.
        "-no-canonical-prefixes",
    ],
    # `-Zremap-cwd-prefix` ensures that absolute paths do not leak into
    # outputs for universal reproducibility while keeping the command line
    # free of absolute paths for remote caching benefit.
    # Available since: https://github.com/rust-lang/rust/pull/87320
    rustflags = ["-Zremap-cwd-prefix=."],
    visibility = ["//visibility:public"],
)
# LINT.ThenChange(BUILD.gn:relative_paths)

# LINT.IfChange(libcxx_include)
# This is separate from :compiler so it can be removed from configs when also
# adding :no-libc++-include.
# NOTE: This assumes zircon_toolchain=false in Bazel.
build_flags(
    name = "libc++-include",
    visibility = ["//visibility:public"],
)

# Adding this must always be paired with removing :libc++-include.
# NOTE: This assumes is_gcc=false in Bazel.
build_flags(
    name = "no-libc++-include",
    cflags_cc = ["-nostdinc++"],
    visibility = ["//visibility:public"],
)
# LINT.ThenChange(BUILD.gn:libcxx_include)

# LINT.IfChange(debug)
build_flags(
    name = "debug",
    visibility = ["//visibility:public"],
)
# LINT.ThenChange(//build/config/BUILD.gn:debug)

# LINT.IfChange(symbol_visibility_hidden)
# NOTE: This assumes zircon_toolchain == false in Bazel.
build_flags(
    name = "symbol_visibility_hidden",
    cflags = ["-fvisibility=hidden"],
    # Disable libc++ visibility annotations to make sure that the compiler option
    # has effect on symbols defined in libc++ headers. Note that we don't want to
    # disable these annotations altogether to ensure that our toolchain is usable
    # outside of our build since not every user uses hidden visibility by default.
    defines = ["_LIBCPP_DISABLE_VISIBILITY_ANNOTATIONS"],
    # NOTE: asmflags is not supported. Bazel passes cflags to assembly actions.
    # asmflags = cflags
    visibility = ["//visibility:public"],
)
# LINT.ThenChange(BUILD.gn:symbol_visibility_hidden)

# LINT.IfChange(symbol_no_undefined)
compiler_build_flags(
    name = "symbol_no_undefined",
    # Because of its interaction with build variants (host sanitizer builds
    # must not pass --no-undefined when linking shared libraries), the
    # --no-undefined flag is handled directly in the Bazel C++ toolchain
    # configuration (cc_features.bzl) and cannot be added here.
    #
    # Consequently, `disable_build_flags = ["//build/config:symbol_no_undefined"]`
    # has no effect in Bazel; use `build_flags = ["//build/config:symbol_allow_undefined"]`
    # instead, and restrict visibility here to @fuchsia_build_info to prevent
    # accidental misuse.
    # linker_flags = [ "--no-undefined" ],
    visibility = ["@fuchsia_build_info//:__subpackages__"],
)

# Allow undefined symbols when linking shared libraries, overriding the default
# -Wl,--no-undefined injected by the C++ toolchain configuration.
compiler_build_flags(
    name = "symbol_allow_undefined",
    linker_flags = [
        "-z",
        "undefs",
    ],
    visibility = ["//visibility:public"],
)

# LINT.ThenChange(
#   BUILD.gn:symbol_no_undefined,
#   //build/bazel_sdk/bazel_rules_fuchsia/common/toolchains/clang/cc_features.bzl:symbol_no_undefined,
# )
# LINT.IfChange(shared_library_config)
build_flags(
    name = "shared_library_config",
    cflags = select({
        "@platforms//os:linux": ["-fPIC"],
        "//conditions:default": [],
    }),
    subflags = select({
        "@platforms//os:fuchsia": ["//build/config/fuchsia:shared_library_config"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
)
# LINT.ThenChange(BUILD.gn:shared_library_config)

# LINT.IfChange(executable_config)
build_flags(
    name = "executable_config",
    subflags = select({
        "@platforms//os:fuchsia": ["//build/config/fuchsia:executable_config"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
)
# LINT.ThenChange(BUILD.gn:executable_config)

# LINT.IfChange(default_libs)
build_flags(
    name = "default_libs",
    visibility = ["//visibility:public"],
)
# LINT.ThenChange(//build/config/BUILD.gn:default_libs)

# LINT.IfChange(language)
build_flags(
    name = "language",
    cflags_c = ["-std=c11"],
    cflags_cc = ["-std=c++{}".format(fuchsia_cxx_version)],
    visibility = ["//visibility:public"],
)
# LINT.ThenChange(//build/config/BUILD.gn:language)

# LINT.IfChange(cxx_versions)
# These configs can be used to override the C++ version for a particular
# target.  This is used primarily for tests to specifically validate building
# under supported modes other than $fuchsia_cxx_version.
[
    build_flags(
        name = "c++{}".format(cxx_version),
        cflags_cc = ["-std=c++{}".format(cxx_version)],

        # TODO(https://fxbug.dev/42064981): libc++ now marks the C++20
        # synchronization primitives as deprecated in older C++ standards which
        # affects Fuchsia since we use these primitives across the codebase. We
        # temporarily suppress these warnings until C++20 becomes the default.
        defines = ["_LIBCPP_DISABLE_DEPRECATION_WARNINGS"] if cxx_version < 20 else [],
        visibility = ["//visibility:public"],
    )
    for cxx_version in fuchsia_sdk_cxx_supported_versions
]
# LINT.ThenChange(BUILD.gn:cxx_versions)

# LINT.IfChange(icf)
compiler_build_flags(
    name = "icf",
    # This changes C/C++ semantics and might be incompatible with third-party
    # code that relies on function pointers comparison.
    # TODO(https://fxbug,dev/572722205): Consider --icf=safe.
    # Assume GN condition 'is_pecoff == false && linker == "lld"' is always true in Bazel.
    linker_flags = ["--icf=all"],
    visibility = ["//visibility:public"],
)
# LINT.ThenChange(BUILD.gn:icf)

# LINT.IfChange(auto_var_init)
# NOTE: This assumes is_gcc=false in Bazel.
build_flags(
    name = "auto_var_init",
    # Automatically initialize variables with a pattern.
    cflags = ["-ftrivial-auto-var-init=pattern"],
    visibility = ["//visibility:public"],
)
# LINT.ThenChange(BUILD.gn:auto_var_init)

# LINT.IfChange(thread_safety_annotations)
# NOTE: This assumes is_gcc=false in Bazel.
build_flags(
    name = "thread_safety_annotations",
    cflags = THREAD_SAFETY_CFLAGS,
    defines = THREAD_SAFETY_DEFINES,
    visibility = ["//visibility:public"],
)
# LINT.ThenChange(
#     BUILD.gn:thread_safety_annotations,
#     //build/bazel_sdk/fuchsia_rules_common/build_flags/default_flag_values.bzl:thread_safety_annotations,
# )

# LINT.IfChange(libcpp_remove_transitive_includes)
build_flags(
    name = "libcpp_remove_transitive_includes",
    defines = ["_LIBCPP_REMOVE_TRANSITIVE_INCLUDES"],
    visibility = ["//visibility:public"],
)
# LINT.ThenChange(//build/config/BUILD.gn:libcpp_remove_transitive_includes)

# LINT.IfChange(no-template-backtrace-limit)
build_flags(
    name = "no-template-backtrace-limit",
    cflags_cc = ["-ftemplate-backtrace-limit=0"],
    visibility = ["//visibility:public"],
)
# LINT.ThenChange(//build/config/BUILD.gn:no-template-backtrace-limit)

# LINT.IfChange(no_exceptions)
build_flags(
    name = "no_exceptions",
    cflags_cc = ["-fno-exceptions"],
    ldflags = ["-fno-exceptions"],
    visibility = ["//visibility:public"],
)
# LINT.ThenChange(//build/config/BUILD.gn:no_exceptions)

# LINT.IfChange(rtti)
build_flags(
    name = "rtti",
    cflags_cc = ["-frtti"],
    # cflags_objcc is not supported in Bazel.
    ldflags = ["-frtti"],
    visibility = ["//visibility:public"],
)

build_flags(
    name = "no_rtti",
    cflags_cc = ["-fno-rtti"],
    # cflags_objcc is not supported in Bazel.
    ldflags = ["-fno-rtti"],
    visibility = ["//visibility:public"],
)
# LINT.ThenChange(BUILD.gn:rtti)

# LINT.IfChange(default_include_dirs)
build_flags(
    name = "default_include_dirs",
    # This target is intentionally empty in Bazel because:
    #
    # - Bazel already sets the top-level workspace directory
    #   as default include directory, through the execroot.
    #
    # The root_gen_dir is a GN-specific concept with no Bazel
    # equivalent, and is likely incorrect (GN targets should be
    # fixed to not depend on this default path, and the entry
    # removed from the list.
    visibility = ["//visibility:public"],
)
# LINT.ThenChange(BUILD.bazel:default_include_dirs)

# LINT.IfChange(dwarf_version)
# This uses a custom rule to extract the value of the
# dwarf_version at analysis time and generate a target
# that produces the corresponding BuildFlagsInfo value.
dwarf_version_build_flags(
    name = "dwarf_version",
    visibility = ["//visibility:public"],
)
# LINT.ThenChange(BUILD.gn:dwarf_version)

# LINT.IfChange(debuginfo_configs)

# Each of the debuginfo_<level> configs below corresponds to a single setting
# that controls the amount of debugging information used and is controlled by
# the debuginfo argument. The default_debuginfo level is set to
# debuginfo_{debuginfo} for convenience, but individual targets can override
# their debuginfo level by manually applying one of the configs below.

build_flags(
    name = "debuginfo_none",
    cflags = ["-g0"],
    # NOTE: asmflags is not supported. Bazel uses cflags.
    # asmflags = [ "-g0" ],
    ldflags = ["-g0"],
    rustflags = ["-Cdebuginfo=0"],
    visibility = ["//visibility:public"],
)

build_flags(
    name = "debuginfo_backtrace",
    cflags = ["-g1"],
    # NOTE: asmflags is not supported. Bazel uses cflags.
    # asmflags = [ "-g1" ],
    ldflags = ["-g1"],
    rustflags = ["-Cdebuginfo=1"],
    visibility = ["//visibility:public"],
)

build_flags(
    name = "debuginfo_debug",
    cflags = [
        "-g3",

        # Add command-line details to each TU's DW_AT_producer to aid build
        # diagnosis working backwards from debug files.  Clang aliases this switch
        # to -grecord-command-line, but both compilers accept this spelling for it.
        "-grecord-gcc-switches",
    ],
    # NOTE: asmflags is not supported. Bazel uses cflags.
    # asmflags = [ "-g3", "-grecord-gcc-switches" ],
    ldflags = [
        "-g3",
        "-grecord-gcc-switches",
    ],
    rustflags = ["-Cdebuginfo=2"],
    visibility = ["//visibility:public"],
)

# LINT.ThenChange(BUILD.gn:debuginfo_configs)

# LINT.IfChange(compress_debuginfo)
# Use a custom rule which produces a BuildFlagsInfo value that
# depends on the toolchain-specific compress_debuginfo variable.
compress_debuginfo_build_flags(
    name = "compress_debuginfo",
    visibility = ["//visibility:public"],
)
# LINT.ThenChange(BUILD.gn:compress_debuginfo)

# LINT.IfChange(default_debuginfo)
build_flags(
    name = "default_debuginfo",
    # Assume is_gcc == false && is_pecoff == false && is_dwarf == true in Bazel.
    cflags = [
        # This option forces Clang to only emit class type information when
        # constructors are emitted which can significantly reduce debug info
        # size. Eventually, this option will enabled by default in Clang when
        # -fno-standalone-debug is used.
        "-Xclang",
        "-debug-info-kind=constructor",
    ],
    subflags = select({
        "//build/bazel/config/select/debuginfo:none": [":debuginfo_none"],
        "//build/bazel/config/select/debuginfo:backtrace": [":debuginfo_backtrace"],
        "//build/bazel/config/select/debuginfo:debug": [":debuginfo_debug"],
    }) + [
        ":dwarf_version",
        ":compress_debuginfo",
    ],
    visibility = ["//visibility:public"],
)
# LINT.ThenChange(BUILD.gn:default_debuginfo)

# LINT.IfChange(standalone)
# This should be used by executables that avoid the normal libc dependencies.
# These must also omit toolchain-provided instrumentation runtimes that will
# themselves depend on libc.
# NOTE: This assumes is_gcc=false in Bazel.
build_flags(
    name = "standalone",
    ldflags = [
        # The sanitizer runtimes need libc ABIs that aren't provided here.
        "-fno-sanitize-link-runtime",

        # The standard profiling runtime can't be used in standalone contexts.  The
        # instrumentation works fine to collect data, and //src/lib/llvm-profdata
        # can be used to wire up a custom runtime if possible in context.
        "-noprofilelib",

        # Make sure the unwinder isn't implicitly brought in for any reason.
        "-unwindlib=none",
    ],
    subflags = ["//build/config/zircon:nolibc"],
    visibility = ["//visibility:public"],
)
# LINT.ThenChange(BUILD.gn:standalone)

# LINT.IfChange(bp_compression_sort)
# Enable LLD's balanced partitioning for ordering function sections.
compiler_build_flags(
    name = "bp-compression-sort",
    linker_flags = ["--bp-compression-sort=function"],
    visibility = ["//visibility:public"],
)
# LINT.ThenChange(BUILD.gn:bp_compression_sort)

# LINT.IfChange(linker_string_merging)
compiler_build_flags(
    name = "linker_string_merging",
    # Assume is_pecoff == false in Bazel
    linker_flags = ["-O2"],
    visibility = ["//visibility:public"],
)
# LINT.ThenChange(BUILD.gn:linker_string_merging)

# LINT.IfChange(optimize_configs)

# Each 'optimize_$optimize' config below corresponds to a single setting that's
# controlled by a 'foo_optimize' argument. The 'default_optimize' level is set
# to an 'optimize_$optimize' for convenience, but individual targets can
# override their optimization level by removing default_optimize and manually
# applying one of
# the configs below.

build_flags(
    name = "default_optimize",
    subflags = select({
        "//build/bazel/config/select/optimize:{}".format(opt): [":optimize_{}".format(opt)]
        for opt in [
            "none",
            "debug",
            "minimal",
            "moderate",
            "moderate_lto",
            "moderate_thinlto",
            "sanitizer",
            "profile",
            "coverage",
            "size",
            "size_lto",
            "size_thinlto",
            "size_thinlto_clang",
            "speed",
            "speed_lto",
            "speed_thinlto",
        ]
    }),
    visibility = ["//visibility:public"],
)

build_flags(
    name = "optimize_none",
    cflags = ["-O0"],
    ldflags = ["-O0"],
    rustflags = ["-Copt-level=0"],
    visibility = ["//visibility:public"],
)

build_flags(
    name = "optimize_debug",
    cflags = ["-Og"],
    ldflags = ["-Og"],

    # Rust doesn't recognize opt level "g", the closest is "1".
    # See: https://doc.rust-lang.org/rustc/codegen-options/index.html#opt-level
    rustflags = ["-Copt-level=1"],
    visibility = ["//visibility:public"],
)

build_flags(
    name = "optimize_minimal",
    cflags = ["-O1"],
    ldflags = ["-O1"],
    rustflags = ["-Copt-level=1"],
    visibility = ["//visibility:public"],
)

build_flags(
    name = "optimize_moderate",
    cflags = ["-O2"],
    ldflags = ["-O2"],
    rustflags = ["-Copt-level=2"],
    visibility = ["//visibility:public"],
)

build_flags(
    name = "optimize_size",
    cflags = ["-Os"] + (
        [
            # `release` uses AOT model embedded inside the compiler.
            "-mllvm",
            "-enable-ml-inliner=release",
        ] if clang_ml_inliner else []
    ),
    ldflags = ["-Os"],
    rustflags = ["-Copt-level=s"],

    # Assume is_elf == true in Bazel
    subflags = [
        ":linker_string_merging",

        # Enable LLD's Balanced Partitioning (BP) to reorder functions for better
        # binary compression. This optimization is specific to the ELF linker (ld.lld)
        # and is not supported by the Windows/COFF linker (lld-link) used for EFI.
        ":bp-compression-sort",
    ],
    visibility = ["//visibility:public"],
)

build_flags(
    name = "optimize_speed",
    cflags = ["-O3"],
    ldflags = ["-O3"],
    rustflags = ["-Copt-level=3"],
    subflags = [":linker_string_merging"],
    visibility = ["//visibility:public"],
)

# Each of those "well-optimized" primary optimization modes gets corresponding
# _lto and _thinlto modes.
[
    build_flags(
        name = "optimize_{}_{}".format(primary, lto),
        subflags = [
            ":optimize_{}".format(primary),
            "//build/config/lto:{}-if-compatible".format(lto),
        ],
        visibility = ["//visibility:public"],
    )
    for primary in ("moderate", "size", "speed")
    for lto in ("lto", "thinlto")
]

selects.config_setting_group(
    name = "toolchain_is_instrumented_or_lto",
    match_any = [
        "//build/bazel/config/toolchain_tags/instrumented:true",
        "//build/bazel/config/toolchain_tags/lto:true",
    ],
)

# TODO(https://fxbug.dev/517626589): Remove this and just use
# optimize_size_thinlto when compiler issues are resolved.
build_flags(
    name = "optimize_size_thinlto_clang",
    # Primarily optimize for size.
    # Do not enable LTO for the instrumented variants.
    # Do not enable LTO (here) for the lto or thinlto variants.
    subflags = [":optimize_size"] + select({
        ":toolchain_is_instrumented_or_lto": [],
        "//conditions:default": ["//build/config/lto:thinlto-clang"],
    }),
    visibility = ["//visibility:public"],
)
# LINT.ThenChange(BUILD.gn:optimize_configs)

# LINT.IfChange(optimize_sanitizer)
build_flags(
    name = "optimize_sanitizer",
    # Instrumentation adds overhead that is greatly improved by optimization.
    # -O1 is well-tested with the instrumentation modes and does not degrade the
    # comprehensibility of backtraces produced by sanitizer failures.
    cflags = ["-O1"],
    ldflags = ["-O1"],
    rustflags = ["-Copt-level=1"],
    visibility = ["//visibility:public"],
)
# LINT.ThenChange(BUILD.gn:optimize_sanitizer)

# LINT.IfChange(optimize_profile)
build_flags(
    name = "optimize_profile",
    cflags = ["-O1"],
    ldflags = ["-O1"],
    rustflags = ["-Copt-level=1"],
    visibility = ["//visibility:public"],
)
# LINT.ThenChange(BUILD.gn:optimize_profile)

# LINT.IfChange(optimize_coverage)
build_flags(
    name = "optimize_coverage",
    cflags = ["-O1"],
    ldflags = ["-O1"],
    rustflags = ["-Copt-level=1"],
    visibility = ["//visibility:public"],
)
# LINT.ThenChange(BUILD.gn:optimize_coverage)
