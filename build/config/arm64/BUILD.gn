import("//build/config/compiler_config.gni")

# LINT.IfChange(arm64_configs)

# Platform baseline.
# This tracks the minimum hardware requirements for Fuchsia on AArch64.
compiler_config("arm64") {
  compiler_configs = [ ":abi" ]

  if (toolchain_environment == "kernel") {
    # TODO(https://fxbug.dev/537458631): This is only enabled for the kernel
    # now to facilitate cross-language inlining, but it should really be part
    # of the default target features for fuchsia on aarch64. This is disabled
    # in userspace because passing this un-stabilized LLVM feature via
    # `-Ctarget-feature` causes rustc to emit an 'unknown and unstable feature'
    # warning on every crate. Once upstream rustc enables this by default in
    # the `aarch64-unknown-fuchsia` target spec (matching Clang), this config
    # shouldn't be needed at all. We'd just need a separate config for toggling
    # it on/off as needed.
    compiler_configs += [ ":fix-cortex-a53-835769" ]
  }

  c_family_flags = [ "-mtune=generic" ]

  if (!rust_custom_target) {
    c_family_flags += [ "-march=armv8-a+simd+crc+crypto" ]

    # For supported target features see:
    # rustc --target=aarch64-unknown-fuchsia --print target-features
    # `armv8a` and `simd` features are assumed by the target triple
    # `aarch64-unknown-fuchsia`.
    rustflags = [ "-Ctarget-feature=+crc,+aes,+sha2" ]
  } else {
    c_family_flags += [ "-march=armv8-a+crc" ]
  }
}

# These are aspects of the Fuchsia ABI distinct from available CPU features.
# They are required regardless of the specific target CPU features.
compiler_config("abi") {
  visibility = [ ":*" ]

  if (toolchain_environment != "kernel") {
    rustflags = [
      "-Zsanitizer=shadow-call-stack",
      "-Zfixed-x18",
    ]
  }
}

foreach(v,
        [
          "v9",
          "v9.1",
          "v9.2",
          "v9.3",
          "v9.4",
          "v9.5",
        ]) {
  compiler_config(v) {
    compiler_configs = [ ":abi" ]
    c_family_flags = [ "-march=arm${v}-a" ]
    rust_target_features = [
      "+${v}a",

      # These are in the built-in target's default list, but are not entirely
      # overridden by +v9... coming later, so remove them.
      "-v8a",
      "-fix-cortex-a53-835769",
    ]
  }
}

compiler_config("cortex-a53") {
  c_family_flags = [ "-mcpu=cortex-a53" ]

  # TODO(https://fxbug.dev/42168343): consider the below.
  #rustflags = [ "-Ctarget-cpu=cortex-a53" ]

  rustflags = [ "-Ctarget-feature=+crc,+aes,+sha2,+neon" ]

  # The CPU doesn't support the new atomics, so don't pay conditionalization
  # overhead at runtime.
  configs = [
    ":no-outline-atomics",
    ":fix-cortex-a53-835769",
  ]
}

# The compiler default for aarch64 targets uses outcalls to compiler-rt
# (libgcc) functions that can do runtime switching between old and new atomic
# insns.  This needs to be disabled when the standard runtime is not available.
compiler_config("no-outline-atomics") {
  cflags = [ "-mno-outline-atomics" ]
  rust_target_features = [ "-outline-atomics" ]
}

compiler_config("fix-cortex-a53-835769") {
  cflags = [ "-mfix-cortex-a53-835769" ]
  rust_target_features = [ "+fix-cortex-a53-835769" ]
}
# LINT.ThenChange(BUILD.bazel:arm64_configs)
