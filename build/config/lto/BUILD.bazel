load("@bazel_skylib//lib:selects.bzl", "selects")
load("@fuchsia_build_info//:args.bzl", "fat_lto_objects", "thinlto_jobs")
load("@fuchsia_rules_common//build_flags:build_flags.bzl", "build_flags")
load("@fuchsia_rules_common//build_flags:compiler_build_flags.bzl", "compiler_build_flags")

package(default_applicable_licenses = ["//:license"])

# LINT.IfChange(fat_lto_objects)

build_flags(
    name = "fat-lto-objects",
    # Assume is_kernel == false in Bazel
    subflags = [
        ":fat-lto-objects-compilation",
        ":fat-lto-objects-linking",
    ],
    visibility = ["//visibility:public"],
)

build_flags(
    name = "fat-lto-objects-compilation",
    # Assume is_gcc == false && is_elf == true in Bazel
    # TODO(https://fxbug.dev/340553826): - Add FatLTO support for Mach-O and COFF file formats
    # Currently, FatLTO requires ELF, so its only valid on non-EFI Fuchsia and
    # Linux
    cflags = ["-ffat-lto-objects"] if fat_lto_objects else [],
    visibility = ["//visibility:public"],
)

compiler_build_flags(
    name = "fat-lto-objects-linking",
    # Assume is_gcc == false && is_elf == true in Bazel
    ldflags = ["-ffat-lto-objects"] if fat_lto_objects else [],

    # TODO(https://fxbug.dev/520129672): Enabling this on non-CFI builds leads to
    # unexpected TLS effects, so let's enable this only on CFI builds for now.
    rust_linker_flags = select({
        "//build/bazel/config/toolchain_tags/cfi:true": ["--fat-lto-objects"],
        "//conditions:default": [],
    }) if fat_lto_objects else [],
    visibility = ["//visibility:public"],
)

build_flags(
    name = "no-fat-lto-objects-compilation",
    # Assume is_gcc == false && is_elf == true in Bazel
    # TODO(https://fxbug.dev/340553826): - Add FatLTO support for Mach-O and COFF file formats
    # Currently, FatLTO requires ELF, so its only valid on non-EFI Fuchsia and
    # Linux
    cflags = ["-fno-fat-lto-objects"] if fat_lto_objects else [],
    visibility = ["//visibility:public"],
)

compiler_build_flags(
    name = "no-fat-lto-objects-linking",
    # Assume is_gcc == false && is_elf == true in Bazel
    # The --no-fat-lto-objects option is only valid in LLD

    # TODO(https://fxbug.dev/340553826): - Add FatLTO support for Mach-O and COFF file formats
    # Currently, FatLTO requires ELF, so its only valid on non-EFI Fuchsia and
    # Linux
    linker_flags = ["--no-fat-lto-objects"] if fat_lto_objects else [],
    visibility = ["//visibility:public"],
)

build_flags(
    name = "no-fat-lto-objects",
    subflags = [
        ":no-fat-lto-objects-compilation",
        ":no-fat-lto-objects-linking",
    ],
    visibility = ["//visibility:public"],
)
# LINT.ThenChange(BUILD.gn:fat_lto_objects)

# LINT.IfChange(lto_workarounds)
compiler_build_flags(
    name = "lto-workarounds",
    linker_llvm_flags = [
        # Assume toolchain_environment is never kernel.xxx in Bazel

        # TODO(https://fxbug.dev/42079915): LLD lets --no-pie trump the code
        # generation switches, since we default to PIC, specify that to LTO links
        # outside of x86_32 and EFI.
        "-relocation-model=pic",

        # TODO(https://fxbug.dev/481320391): Remove the TLSDESC workaround when the
        # toolchain propagates the target information correctly in LTO builds.
        "--enable-tlsdesc",
    ],
    visibility = ["//visibility:public"],
)
# LINT.ThenChange(BUILD.gn:lto_workarounds)

# LINT.IfChange(lto_whole_program_devirtualization)
# This enables whole program devirtualization when LTO is enabled. Individual
# binaries can opt-in to using this for LTO builds. This can be turned on safely
# for self-contained binaries that do not expose the C++ ABI (such as the
# kernel or fdio). This should only be used for LTO builds.
#
# Users should be careful when using this because this can lead to virtual
# function calls unexpectedly being devirtualized if the compiler determines
# that a virtual call can resolve to a function from only one vtable.
# https://fxbug.dev/42075686 contains an example of this. For these cases, if
# the C++ ABI is expected to be exposed from a shared library, then adding
# [[clang::lto_visibility_public]] to the public/exported class will tell the
# compiler that other subclasses may exist outside this LTO unit. See
# https://clang.llvm.org/docs/LTOVisibility.html for more information on the
# annotation.
compiler_build_flags(
    name = "lto-whole-program-devirtualization",
    c_family_flags = [
        # Opt-in for whole-program devirtualization and virtual constant
        # propagation.
        "-fwhole-program-vtables",
    ],

    # TODO(https://fxbug.dev/42061844): Temporarily disable branch funneling on
    # lto. Branch funneling likely generates bad code involving return values not
    # propagated correctly to other functions. Once this is resolved, come back
    # and remove this.
    #
    # Note this would be a no-op if WPD were disabled anyway.
    linker_llvm_flags = select({
        "@platforms//os:fuchsia": ["-wholeprogramdevirt-branch-funnel-threshold=0"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
)

compiler_build_flags(
    name = "no-lto-whole-program-devirtualization",
    c_family_flags = ["-fno-whole-program-vtables"],
    visibility = ["//visibility:public"],
)
# LINT.ThenChange(BUILD.gn:lto_whole_program_devirtualization)

# LINT.IfChange(lto_rust_linker_plugin)
# Enables linker plugin LTO.
#
# If an rlib is only ever going to get used later with a -Clto compilation then
# you can pass -Clinker-plugin-lto to speed up compilation and avoid generating
# object files that aren't used.
#
# See
# https://doc.rust-lang.org/rustc/codegen-options/index.html#linker-plugin-lto
# for details.
build_flags(
    name = "lto-rust-linker-plugin",
    # Assume is_kernel == false in Bazel.
    rustflags = select({
        "//build/bazel/platforms:is_host_os": [
            # TODO(https://fxbug.dev/529449843): `-Clinker-plugin-lto` forces rust to just emit LLVM
            # bitcode and punt LTO to the linker. During the link, LTO can eliminate
            # dead code which could contain references to symbols defined in a normal
            # rlib that would be linked with this bitcode. If we're building a shared
            # library, this can result in symbols which should be exported in the shared
            # library from not being defined in the shared lib because there's nothing
            # which would extract them from the rlib. This only occurs when LLD drives
            # LTO. When rustc drives LTO, it creates a list of symbols that LTO should
            # never omit which allows these symbols to make it to the final lib.
            # Ideally, this would be fixed upstream, and ideally the quick workaround
            # would be to gate this flag on `current_toolchain != shlib_toolchain`, but
            # all rust targets which would use the shared library toolchain actually use
            # the non-shared normal toolchain. As a backup workaround, we only limit
            # this flag to the kernel since this would break rust shared lib targets.
            "-Zsplit-lto-unit",
            "-Clinker-plugin-lto",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
)
# LINT.ThenChange(BUILD.gn:lto_rust_linker_plugin)

# LINT.IfChange(lto)

# This can be appended with:
# ```
#   configs += [ "//build/config/lto:no-lto" ]
# ```
# in any particular target to disable LTO.
compiler_build_flags(
    name = "no-lto",
    c_family_flags = ["-fno-lto"],
    rustflags = ["-Clto=off"],
    subflags = [":no-lto-whole-program-devirtualization"],
    visibility = ["//visibility:public"],
)

compiler_build_flags(
    name = "lto",
    c_family_flags = ["-flto"],
    rustflags = [
        "-Clto=fat",
        "-Zdylib-lto",
    ],
    subflags = [
        ":fat-lto-objects",
        ":lto-workarounds",
        ":lto-rust-linker-plugin",
    ] + select({
        # Whole program devirtualization is safe for self-contained binaries that do
        # not expose the C++ ABI, such as host tools or the kernel.
        "@platforms//os:fuchsia": [],
        "//conditions:default": [":lto-whole-program-devirtualization"],
    }),
    visibility = ["//visibility:public"],
)

selects.config_setting_group(
    name = "toolchain_is_instrumented_or_lto",
    match_any = [
        "//build/bazel/config/toolchain_tags/instrumented:true",
        "//build/bazel/config/toolchain_tags/lto:true",
    ],
)

# This config is used to opt-in targets to LTO while automatically excluding
# scenarios where LTO is incompatible or redundant.
build_flags(
    name = "lto-if-compatible",
    # Do not enable LTO for the instrumented variants.
    # Do not enable LTO (here) for the lto or thinlto variants.
    # Assume is_gcc == false in Bazel.
    subflags = select({
        ":toolchain_is_instrumented_or_lto": [],
        "//conditions:default": [":lto"],
    }),
    visibility = ["//visibility:public"],
)

# LINT.ThenChange(BUILD.gn:lto)

# LINT.IfChange(thinlto)
build_flags(
    name = "thinlto-clang",
    # asmflags = ["-flto=thin"],
    cflags = ["-flto=thin"],
    ldflags = [
        "-flto=thin",

        # The ThinLTO driver launches a number of threads in parallel whose
        # number is by default equivalent to the number of cores.  We need
        # to limit the parallelism to avoid aggressive competition between
        # different linker jobs.
        "-Wl,--thinlto-jobs={}".format(thinlto_jobs),

        # Set the ThinLTO cache directory which is used to cache native
        # object files for ThinLTO incremental builds.  This directory is
        # not managed by Ninja and has to be cleaned manually, but it is
        # periodically garbage-collected by the ThinLTO driver.

        # IMPORTANT: The ThinLTO cache directory is not compatible with
        # Bazel's sandboxing and remote builds, so this is ignored here.
        # Intentionally disabled (see note above)
        # "-Wl,--thinlto-cache-dir={}".format(thinlto_cache_dir),
    ],
    subflags = [
        ":fat-lto-objects",
        ":lto-workarounds",

        # As thin lto is multi-threaded, use the larger RBE workers
        # Intentionally commented out.
        # "//build/config/rbe:big_rbe_machine",
    ],
    visibility = ["//visibility:public"],
)

compiler_build_flags(
    name = "thinlto-rust",
    rustflags = [
        "-Clto=thin",
        "-Zdylib-lto",
    ],

    # IMPORTANT: The ThinLTO cache directory is not compatible with
    # Bazel's sandboxing and remote builds, so this is ignored here.
    # Intentionally disabled (see note above)
    # rust_linker_flags = [ "--thinlto-cache-dir={}".format(thinlto_cache_dir) ],
    subflags = [
        ":lto-rust-linker-plugin",
        ":lto-workarounds",

        # As thin lto is multi-threaded, use the larger RBE workers
        #
        # Bazel doesn't support modifying the exec properties of specific
        # LTO linking actions through target definitions / providers.
        #
        # The alternative is adding a line like:
        # build --modify_execution_info=LTOIndexing=+Pool=large_worker,Rustclink=+Pool=large_worker
        # to the global .bazelrc file when LTO is enabled by default.
        #
        # Intentionally disabled (see note above).
        # "//build/config/rbe:big_rbe_machine",
    ],
    visibility = ["//visibility:public"],
)

build_flags(
    name = "thinlto",
    subflags = [
        ":thinlto-clang",
        ":thinlto-rust",
    ],
    visibility = ["//visibility:public"],
)

# This config is used to opt-in targets to ThinLTO while automatically excluding
# scenarios where LTO is incompatible or redundant.
build_flags(
    name = "thinlto-if-compatible",
    # Do not enable ThinLTO for the instrumented variants.
    # Do not enable ThinLTO (here) for the lto or thinlto variants.
    # Assume is_gcc == false in Bazel
    subflags = select({
        ":toolchain_is_instrumented_or_lto": [],
        "//conditions:default": [":thinlto"],
    }),
    visibility = ["//visibility:public"],
)

# LINT.ThenChange(BUILD.gn:thinlto)
