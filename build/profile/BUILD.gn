import("//build/bazel/bazel_test_suite.gni")
import("//build/python/python_library.gni")
import("//build/testing/python_build_time_tests.gni")

group("tests") {
  testonly = true

  deps = [
    ":bazel_tests",
    ":hardware_profiler_test($host_toolchain)",
    ":procfs_test($host_toolchain)",
    ":system_profiler_test($host_toolchain)",
  ]
}

bazel_test_suite("bazel_tests") {
  host_tests = [
    "//build/profile:hardware_profiler_test",
    "//build/profile:procfs_test",
    "//build/profile:system_profiler_test",
  ]
}

if (is_host) {
  # GN copies of the host_py_test() targets in BUILD.bazel, which bazel2gn
  # can't translate yet. These run the same tests at build time.
  python_build_time_tests("procfs_test") {
    tests = [ "procfs_test.py" ]
    deps = [ ":procfs" ]
  }

  python_build_time_tests("system_profiler_test") {
    tests = [ "system_profiler_test.py" ]
    deps = [
      ":procfs",
      ":system_profiler",
    ]
  }

  python_build_time_tests("hardware_profiler_test") {
    tests = [ "hardware_profiler_test.py" ]
    deps = [
      ":hardware_profiler",
      ":procfs",
    ]
  }
}

