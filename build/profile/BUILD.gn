import("//build/tools/bazel2gn/bazel_migration.gni")

if (is_host) {
  python_library("procfs") {
    sources = [ "procfs.py" ]
    visibility = [
      ":*",
      "//build/scripts:*",
    ]
  }
}
if (is_host) {
  python_library("system_profiler") {
    sources = [ "system_profiler.py" ]
    deps = [ ":procfs" ]
  }
}
if (is_host) {
  python_library("hardware_profiler") {
    sources = [ "hardware_profiler.py" ]
    deps = [ ":procfs" ]
  }
}
