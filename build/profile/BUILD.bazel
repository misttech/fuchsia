load("@rules_python//python:py_library.bzl", "py_library")
load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_py_test.bzl", "host_py_test")

package(default_applicable_licenses = ["//:license"])

py_library(
    name = "procfs",
    srcs = ["procfs.py"],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//build/scripts:__pkg__"],
)

py_library(
    name = "system_profiler",
    srcs = ["system_profiler.py"],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = [":procfs"],
)

py_library(
    name = "hardware_profiler",
    srcs = ["hardware_profiler.py"],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = [":procfs"],
)

# The tests below import the module under test from their own directory,
# hence `imports = ["."]`.
host_py_test(
    name = "procfs_test",
    srcs = ["procfs_test.py"],
    imports = ["."],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = [":procfs"],
)

host_py_test(
    name = "system_profiler_test",
    srcs = ["system_profiler_test.py"],
    imports = ["."],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = [
        ":procfs",
        ":system_profiler",
    ],
)

host_py_test(
    name = "hardware_profiler_test",
    srcs = ["hardware_profiler_test.py"],
    imports = ["."],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = [
        ":hardware_profiler",
        ":procfs",
    ],
)
