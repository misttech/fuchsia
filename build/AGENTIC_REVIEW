# Note: Writing new .bzl rules/macros under //build/bazel/rules/, porting
# //build/config/ flags, or updating //bundles/assembly/ are hand-authored
# build infrastructure CLs (not Bazel target migrations), where engineers run
# /review.

# Porting GN config() and compiler_config() targets to Bazel build_flags().
conditional_capability_groups {
  path_expression: "config/....gn"
  path_expression: "config/....gni"
  path_expression: "config/....bazel"
  path_expression: "config/....bzl"
  path_expression: "bazel/config/....bzl"
  path_expression: "bazel_sdk/fuchsia_rules_common/build_flags/....bzl"
  review_capability_skills: ".agents/skills/port-gn-config-to-bazel-build-flags/SKILL.md"
}

# Creating non-SDK in-tree Bazel rules and dependency boundaries.
conditional_capability_groups {
  path_expression: "bazel/rules/....bzl"
  path_expression: "bazel/rules/....bazel"
  path_expression: "bazel_sdk/fuchsia_rules_common/....bzl"
  path_expression: "bazel_sdk/fuchsia_rules_common/....bazel"
  review_capability_skills: "build/bazel/skills/create-non-sdk-rule/SKILL.md"
}
