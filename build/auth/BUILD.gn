import("//build/tools/bazel2gn/bazel_migration.gni")

if (is_host) {
  python_library("apt") {
    sources = [ "apt.py" ]
    visibility = [
      ":*",
      "//build/scripts:*",
    ]
  }
}
if (is_host) {
  python_library("gcloud") {
    sources = [ "gcloud.py" ]
    visibility = [
      ":*",
      "//build/scripts:*",
    ]
    deps = [ ":apt" ]
  }
}
if (is_host) {
  python_library("gcloud_creds") {
    sources = [ "gcloud_creds.py" ]
    visibility = [
      ":*",
      "//build/scripts:*",
    ]
    deps = [
      ":apt",
      ":gcloud",
    ]
  }
}
if (is_host) {
  python_library("select_auth_method") {
    sources = [ "select_auth_method.py" ]
    visibility = [
      ":*",
      "//build/scripts:*",
    ]
    deps = [ ":gcloud" ]
  }
}
