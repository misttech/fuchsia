load("@fuchsia_rules_common//build_flags:build_flags.bzl", "build_flags")
load("@fuchsia_rules_common//build_flags:compiler_build_flags.bzl", "compiler_build_flags")
load("@fuchsia_rules_common//build_flags:extra_linker_flags.bzl", "extra_linker_flags")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")
load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")
load("//build/bazel/rules/cc:fx_cc_test.bzl", "fx_cc_test")
load("//build/bazel/rules/host_tests:host_test.bzl", "host_test")
load(
    ":host_tests.bzl",
    "build_flags_cc_binary_host_test",
    "build_flags_cc_library",
    "verify_build_flags_labels_test",
)

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    visibility = ["//build/bazel/rules/build_flags/tests:__pkg__"],
)

# A single build_flags() target defining several attributes for C and C++
build_flags(
    name = "flags1",
    cflags = ["-DCFLAGS=1"],
    cflags_c = ["-DCONLYFLAG=1"],
    cflags_cc = ["-DCPPFLAG=1"],
    defines = ["A_MACRO=42"],
)

# NOTE: Many tests in this file are designed such that they will fail to build if build_flags
# flags are not propagated correctly to compilation and linking actions. Other tests actually
# perform runtime checks instead.

# Define a list of test names, each one will correspond to
# a build_flags_cc_binary_host_test() definition that uses
# either ${name}.cc or ${name}.c in its `srcs` value, based
# on the name. All these use 'build_flags = ":flags1"'
TEST_NAMES = [
    # Two tests that check that 'cflags' is pased to both
    # C++ and C source files.
    "check_cflags_conly",
    "check_cflags_cpp",

    # Two tests to check that 'cflags_c' is only passed
    # to C source files.
    "check_cflags_c_conly",
    "check_cflags_c_cpp",

    # Two tests to check that 'cflags_cc' is only passed
    # to C++ source files.
    "check_cflags_cc_conly",
    "check_cflags_cc_cpp",

    # Two tests to check that 'defines' is passed to
    # both C and C++ source files.
    "check_defines_conly",
    "check_defines_cpp",
]

# Now define all tests using a loop expression
[
    build_flags_cc_binary_host_test(
        name = test_name,
        srcs = [
            "{}.c".format(test_name),
        ] if test_name.endswith("_conly") else [
            "{}.cc".format(test_name),
        ],
        build_flags = [":flags1"],
    )
    for test_name in TEST_NAMES
]

# A test that verify that disable_build_flags removes flags
# that were passed to build_flags, even when using
# different label expressions to address the same build_flags()
# target.
build_flags_cc_binary_host_test(
    name = "check_with_and_without_remove_flags",
    srcs = ["check_with_and_without_remove_flags.cc"],
    build_flags = [":flags1"],
    disable_build_flags = ["//build/bazel/rules/build_flags/tests/cc:flags1"],
)

# A test to verify that 'includes' (via include_dirs) and 'lib_dirs'
# attributes of build_flags() are correctly passed to compiler & linker.

build_flags(
    name = "flags_includes_and_lib_dirs",
    include_dirs = ["build/bazel/rules/build_flags/tests/cc/test_include_dir"],
    ldflags = ["-ltest_prebuilt"],
    lib_dirs = ["build/bazel/rules/build_flags/tests/cc/test_lib_dir"],
)

build_flags_cc_binary_host_test(
    name = "check_includes_and_lib_dirs",
    srcs = [
        "check_includes_and_lib_dirs.cc",
        # Ensure that this header file appears in the sandbox. However,
        # it is included as "test_header.h" in the .cc source file,
        # which works because of the 'include_dirs' attribute of
        # 'flags_includes_and_lib_dirs'.
        "test_include_dir/test_header.h",
    ],

    # This is required to ensure that the test library appears in the
    # sandbox of the linking action. This does *not* add this path to the
    # link command though, which uses '-L<path> -ltest_prebuilt' based on
    # the definition of 'flags_includes_and_lib_dirs'.
    additional_linker_inputs = ["test_lib_dir/libtest_prebuilt.a"],
    build_flags = [":flags_includes_and_lib_dirs"],
)

# A test to verify that 'ldflags' on a cc_library do not transitively propagate
# and fail the build of dependent binaries.

build_flags(
    name = "flags_invalid_ldflags",
    ldflags = ["-Wl,--this-is-an-invalid-linker-flag-xyz"],
)

build_flags_cc_library(
    name = "check_library_with_ldflags_lib",
    srcs = ["check_library_with_ldflags.cc"],
    build_flags = [":flags_invalid_ldflags"],
)

build_flags_cc_binary_host_test(
    name = "check_library_with_ldflags",
    srcs = ["check_library_with_ldflags_main.cc"],
    deps = [":check_library_with_ldflags_lib"],
)

# Checks for fx_cc_binary() and fx_cc_library()

build_flags(
    name = "fx_cc_library_flags",
    defines = ["IN_FX_CC_LIBRARY=1"],
)

fx_cc_library(
    name = "fx_cc_library_for_test",
    srcs = ["fx_cc_library_for_test.cc"],
    build_flags = [":fx_cc_library_flags"],
    disable_build_flags = [":flags2"],
)

build_flags(
    name = "flags2",
    defines = ["SHOULD_NOT_BE_DEFINED"],
)

fx_cc_binary(
    name = "fx_cc_binary_test_bin",
    srcs = ["fx_cc_binary_test.cc"],
    build_flags = [
        ":flags1",
        ":flags2",
    ],
    disable_build_flags = [":flags2"],
    deps = [":fx_cc_library_for_test"],
)

host_test(
    name = "fx_cc_binary_test",
    binary = ":fx_cc_binary_test_bin",
)

# Checks for fx_cc_test(): implicit `testonly = True` (verified by depending on
# a testonly library without setting `testonly` on `fx_cc_test`), `build_flags`
# / `disable_build_flags` forwarding, and `disable_lto = False` + explicit
# `testonly = True`.
fx_cc_library(
    name = "fx_cc_testonly_lib",
    testonly = True,
)

fx_cc_test(
    name = "fx_cc_test_bin",
    srcs = ["fx_cc_binary_test.cc"],
    build_flags = [":flags1"] + select({
        "//conditions:default": [":flags2"],
    }),
    disable_build_flags = [":flags2"],
    deps = [
        ":fx_cc_library_for_test",
        ":fx_cc_testonly_lib",
    ],
)

host_test(
    name = "fx_cc_test_test",
    binary = ":fx_cc_test_bin",
)

fx_cc_test(
    name = "fx_cc_test_lto_enabled_bin",
    testonly = True,
    srcs = ["fx_cc_binary_test.cc"],
    build_flags = select({
        "//conditions:default": [":flags1"],
    }),
    disable_lto = False,
    deps = [":fx_cc_library_for_test"],
)

host_test(
    name = "fx_cc_test_lto_enabled_test",
    binary = ":fx_cc_test_lto_enabled_bin",
)

fx_cc_test(
    name = "fx_cc_test_default_flags_bin",
    srcs = ["check_library_with_ldflags_main.cc"],
    deps = [":check_library_with_ldflags_lib"],
)

host_test(
    name = "fx_cc_test_default_flags_test",
    binary = ":fx_cc_test_default_flags_bin",
)

fx_cc_test(
    name = "fx_cc_test_lto_enabled_default_flags_bin",
    srcs = ["check_library_with_ldflags_main.cc"],
    disable_lto = False,
    deps = [":check_library_with_ldflags_lib"],
)

host_test(
    name = "fx_cc_test_lto_enabled_default_flags_test",
    binary = ":fx_cc_test_lto_enabled_default_flags_bin",
)

verify_build_flags_labels_test(
    name = "verify_fx_cc_test_build_flags",
    expected_ordered_labels = [
        "//build/config/fuchsia:fdio_config",
        ":flags1",
        "//build/config/lto:no-fat-lto-objects-linking",
    ],
    target_under_test = ":fx_cc_test_bin",
    unexpected_labels = [":flags2"],
)

verify_build_flags_labels_test(
    name = "verify_fx_cc_test_default_flags",
    expected_ordered_labels = [
        "//build/config/fuchsia:fdio_config",
        "//build/config/lto:no-fat-lto-objects-linking",
    ],
    target_under_test = ":fx_cc_test_default_flags_bin",
)

verify_build_flags_labels_test(
    name = "verify_fx_cc_test_lto_enabled_build_flags",
    expected_ordered_labels = [
        "//build/config/fuchsia:fdio_config",
        ":flags1",
    ],
    target_under_test = ":fx_cc_test_lto_enabled_bin",
    unexpected_labels = ["//build/config/lto:no-fat-lto-objects-linking"],
)

verify_build_flags_labels_test(
    name = "verify_fx_cc_test_lto_enabled_default_flags",
    expected_ordered_labels = ["//build/config/fuchsia:fdio_config"],
    target_under_test = ":fx_cc_test_lto_enabled_default_flags_bin",
    unexpected_labels = ["//build/config/lto:no-fat-lto-objects-linking"],
)

# Verify compiler_build_flags() with configurable (select()) attributes in C++.
compiler_build_flags(
    name = "compiler_flags_select_cc",
    c_family_flags = select({
        "@platforms//os:fuchsia": ["-DCFLAGS=0"],
        "//conditions:default": ["-DCFLAGS=1"],
    }),
)

build_flags_cc_binary_host_test(
    name = "check_compiler_build_flags_select_cpp",
    srcs = ["check_cflags_cpp.cc"],
    build_flags = [":compiler_flags_select_cc"],
)

# Tests for extra_linker_flags(): link_inputs, link_deps, and disable_build_flags.

extra_linker_flags(
    name = "flags_link_inputs",
    ldflags = ["-ltest_prebuilt"],
    link_inputs = ["test_lib_dir/libtest_prebuilt.a"],
)

build_flags(
    name = "flags_includes_lib_dirs_and_link_inputs",
    include_dirs = ["build/bazel/rules/build_flags/tests/cc/test_include_dir"],
    lib_dirs = ["build/bazel/rules/build_flags/tests/cc/test_lib_dir"],
    subflags = [":flags_link_inputs"],
)

# Notice: Unlike check_includes_and_lib_dirs above, this target does NOT set
# additional_linker_inputs manually on the binary; link_inputs is automatically
# passed through flags_includes_lib_dirs_and_link_inputs -> flags_link_inputs!
build_flags_cc_binary_host_test(
    name = "check_extra_linker_flags_link_inputs",
    srcs = [
        "check_includes_and_lib_dirs.cc",
        "test_include_dir/test_header.h",
    ],
    build_flags = [":flags_includes_lib_dirs_and_link_inputs"],
)

# A library with `defines = ["SHOULD_NOT_BE_DEFINED"]` in its compilation
# context. `fx_cc_binary_test.cc` fails to compile if `SHOULD_NOT_BE_DEFINED`
# is defined, verifying that `extra_linker_flags` (`link_deps` and
# `executable_link_deps`) only propagates `CcInfo.linking_context` and never
# leaks `CcInfo.compilation_context`.
fx_cc_library(
    name = "fx_cc_library_for_link_deps_test",
    srcs = ["fx_cc_library_for_test.cc"],
    build_flags = [":fx_cc_library_flags"],
    defines = ["SHOULD_NOT_BE_DEFINED"],
)

extra_linker_flags(
    name = "flags_link_deps",
    link_deps = [":fx_cc_library_for_link_deps_test"],
)

# Notice: Unlike fx_cc_binary_test_bin above, this target does NOT set
# deps = [":fx_cc_library_for_test"] manually on the binary; the library is
# automatically linked via flags_link_deps without propagating its
# compilation_context!
build_flags_cc_binary_host_test(
    name = "check_extra_linker_flags_link_deps",
    srcs = ["fx_cc_binary_test.cc"],
    build_flags = [
        ":flags1",
        ":flags_link_deps",
    ],
)

extra_linker_flags(
    name = "extra_flags_invalid_ldflags",
    ldflags = ["-Wl,--this-is-an-invalid-linker-flag-xyz"],
)

# Verify that disable_build_flags removes extra_linker_flags targets.
build_flags_cc_binary_host_test(
    name = "check_disable_extra_linker_flags",
    srcs = ["check_cflags_cpp.cc"],
    build_flags = [
        ":flags1",
        ":extra_flags_invalid_ldflags",
    ],
    disable_build_flags = [":extra_flags_invalid_ldflags"],
)

extra_linker_flags(
    name = "flags_executable_link_deps",
    executable_link_deps = [":fx_cc_library_for_link_deps_test"],
)

# Notice: Like check_extra_linker_flags_link_deps, this executable binary
# does NOT set deps = [":fx_cc_library_for_test"] manually; it is linked
# via executable_link_deps!
build_flags_cc_binary_host_test(
    name = "check_extra_linker_flags_executable_link_deps",
    srcs = ["fx_cc_binary_test.cc"],
    build_flags = [
        ":flags1",
        ":flags_executable_link_deps",
    ],
)

# Create an undefined symbol in a library with alwayslink = True
cc_library(
    name = "undefined_symbol_lib",
    srcs = ["undefined_symbol_for_test.cc"],
    alwayslink = True,
)

extra_linker_flags(
    name = "flags_executable_link_deps_with_undefined",
    executable_link_deps = [":undefined_symbol_lib"],
)

# A shared library that includes flags_executable_link_deps_with_undefined.
# If executable_link_deps were mistakenly linked into shared libraries,
# this target would fail to build because undefined_symbol_lib has an unresolved symbol
# and shared libraries are linked with -Wl,--no-undefined.
fx_cc_binary(
    name = "shared_lib_ignoring_exec_link_deps",
    srcs = ["check_cflags_cpp.cc"],
    build_flags = [
        ":flags1",
        ":flags_executable_link_deps_with_undefined",
    ],
    linkshared = True,
)

build_flags_cc_binary_host_test(
    name = "check_shared_library_ignores_executable_link_deps",
    srcs = ["check_cflags_cpp.cc"],
    build_flags = [":flags1"],
    data = [":shared_lib_ignoring_exec_link_deps"],
)

# A shared library that directly depends on undefined_symbol_lib and uses
# //build/config:symbol_allow_undefined to override the default -Wl,--no-undefined.
fx_cc_binary(
    name = "shared_lib_with_symbol_allow_undefined",
    srcs = ["check_cflags_cpp.cc"],
    build_flags = [
        ":flags1",
        "//build/config:symbol_allow_undefined",
    ],
    linkshared = True,
    deps = [":undefined_symbol_lib"],
)

build_flags_cc_binary_host_test(
    name = "check_shared_library_symbol_allow_undefined",
    srcs = ["check_cflags_cpp.cc"],
    build_flags = [":flags1"],
    data = [":shared_lib_with_symbol_allow_undefined"],
)
