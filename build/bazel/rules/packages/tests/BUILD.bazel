# Tests `fx_unittest_package()` with a single unit test binary.
fx_unittest_package(
    name = "example_unittest_package",
    package_name = "fx-unittest-package-example",
    unit_tests = [":example_test_bin"],
)

verify_fx_test_realms(
    name = "verify_example_unittest_package_realms",
    testonly = True,
    expected_realms = {
        "fx-unittest-package-example": "",
    },
    test = ":example_unittest_package",
)

# Tests that `fx_unittest_package()` names the package and component after
# `name` when `package_name` is omitted.
fx_unittest_package(
    name = "example_unittest_package_default_name",
    unit_tests = [":example_test_bin"],
)

verify_fx_test_realms(
    name = "verify_example_unittest_package_default_name_realms",
    testonly = True,
    expected_realms = {
        "example_unittest_package_default_name": "",
    },
    test = ":example_unittest_package_default_name",
)

