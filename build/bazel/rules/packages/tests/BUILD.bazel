    name = "example_compiled_manifest_consumer",
    testonly = True,
    srcs = ["example_compiled_manifest_consumer.rs"],
    compile_data = [
        ":example_compiled_manifest",
        ":example_compiled_manifest_custom_output_name",
    ],
    edition = "2024",
    rustc_env = {
        "CUSTOM_OUTPUT_NAME_CM_PATH": "$(execpath :example_compiled_manifest_custom_output_name)",
        "EXAMPLE_CM_PATH": "$(execpath :example_compiled_manifest)",
    },
)

