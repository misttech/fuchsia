    name = "example_compiled_manifest_custom_output_name",
    manifest = "meta/example_helper.cml",
    output_name = "custom/example_helper.cm",
)

genrule(
    name = "verify_example_compiled_manifest_paths",
    testonly = True,
    srcs = [
        ":example_compiled_manifest",
        ":example_compiled_manifest_custom_output_name",
    ],
    outs = ["verify_example_compiled_manifest_paths.stamp"],
    cmd = """
case "$(execpath :example_compiled_manifest)" in
  */build/bazel/rules/packages/tests/cml/example_compiled_manifest/example_dynamic_dictionary.cm) ;;
  *) echo "Unexpected default output path: $(execpath :example_compiled_manifest)" >&2; exit 1 ;;
esac
case "$(execpath :example_compiled_manifest_custom_output_name)" in
  */build/bazel/rules/packages/tests/custom/example_helper.cm) ;;
  *) echo "Unexpected custom output path: $(execpath :example_compiled_manifest_custom_output_name)" >&2; exit 1 ;;
esac
touch $@
""",
)

# Embeds the compiled manifests in a Rust library, like component_manager does.
