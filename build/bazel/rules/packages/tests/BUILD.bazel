fx_unittest_package(
    name = "example_multi_unittest_package",
    package_name = "fx-multi-unittest-package-example",
    unit_tests = [
        ":example_test_bin",
        ":example_second_test_bin",
    ],
)

verify_fx_test_realms(
    name = "verify_example_multi_unittest_package_realms",
    testonly = True,
    expected_realms = {
        "example_test_bin": "",
        "example_second_test_bin": "",
    },
    test = ":example_multi_unittest_package",
)
