"""Tests for the platform Bazel package and device test rules."""

load("//build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")
load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load("//build/bazel/rules/packages:fx_packaged_binary.bzl", "fx_packaged_binary")
load("//build/bazel/rules/rust:defs.bzl", "rustc_test")
load(
    "//build/bazel/rules/testing:defs.bzl",
    "analysis_failure_test",
    "verify_fx_test_environments",
    "verify_fx_test_realms",
    "verify_runner_shard",
)
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")
load(
    "//build/bazel/rules/testing:fx_test_environment.bzl",
    "fx_test_environment",
    "fx_test_environment_variant",
)
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")
load("//build/testing/environments:device_types.bzl", "device_types")
load(":fx_test_validation_tests.bzl", "fx_test_validation_tests")

package(default_applicable_licenses = ["//:license"])

fx_cc_binary(
    name = "example_test_bin",
    testonly = True,
    srcs = ["example_test.cc"],
    tags = ["manual"],
)

fx_packaged_binary(
    name = "example_test_packaged_bin",
    testonly = True,
    binary = ":example_test_bin",
    binary_name = "example_test",
)

fx_component_manifest(
    name = "example_test_manifest",
    testonly = True,
    component_name = "example_test",
    includes = [
        "//sdk/lib/sys/testing:elf_test_runner.shard.cml",
        "//sdk/lib/syslog:client.shard.cml",

        # `cmc` resolves includes transitively, so the shards that
        # client.shard.cml itself includes must be declared as inputs too.
        "//sdk/lib/syslog:offer.shard.cml",
        "//sdk/lib/syslog:use.shard.cml",
    ],
    manifest = "meta/example_test.cml",
)

fx_test_component(
    name = "example_test_component",
    compiled_manifest = ":example_test_manifest",
    component_name = "example_test",
    deps = [
        ":example_test_packaged_bin",
    ],
)

fx_component_manifest(
    name = "example_helper_manifest",
    component_name = "example_helper",
    manifest = "meta/example_helper.cml",
)

fx_component(
    name = "example_helper_component",
    compiled_manifest = ":example_helper_manifest",
    component_name = "example_helper",
)

fx_package(
    name = "example_test_package",
    package_name = "fx-test-package-example",
    components = [
        ":example_helper_component",
    ],
    test_components = [
        ":example_test_component",
    ],
)

# Tests `fx_test()` and `fx_package(test_components = ...)`. This is a real
# test that can be run with `fx test fx-test-package-example`, provided it is
# exported to the GN build with a `bazel_test_suite()` target.
fx_test(
    name = "example_test",
    package = ":example_test_package",
)

# Each `verify_fx_test_environments()` target below is an analysis-time
# assertion on the `FuchsiaTestInfo` provider of the `fx_test()` it points at:
# building it fails if the test's `environments` or `build_only` don't match
# the expected values. They have no outputs and only need to be built (via
# `build_only_tests`) to take effect. This guards how `fx_test()` collects
# environments from its `environments` targets; it does not check what the
# tests.json cquery extracts from the provider, which is covered by
# `FuchsiaTestInfoCqueryTest` in //build/bazel/scripts/bazel_tests_utils_test.py.
verify_fx_test_environments(
    name = "verify_example_test_default_environments",
    testonly = True,
    expected_environments = [],
    test = ":example_test",
)

fx_test(
    name = "example_test_with_environments",
    environments = [
        "//build/testing/environments:aemu_env",
        "//build/testing/environments:nuc11_env",
        "//build/testing/environments:sherlock_env",
    ],
    package = ":example_test_package",
)

verify_fx_test_environments(
    name = "verify_example_test_with_environments",
    testonly = True,
    expected_environments = [
        {"dimensions": {"device_type": device_types.aemu}},
        {"dimensions": {"device_type": device_types.nuc11}},
        {"dimensions": {"device_type": device_types.sherlock}},
    ],
    test = ":example_test_with_environments",
)

fx_test_environment(
    name = "example_custom_env",
    dimensions = {"device_type": device_types.qemu},
    emulator = {
        "device": "x64-emu-min",
        "name": "example",
    },
    env_tags = ["example-tag"],
    netboot = True,
    service_account = "example@fuchsia.iam.gserviceaccount.com",
)

# An environment identical to `example_custom_env`, to check that `fx_test()`
# dedupes it.
fx_test_environment(
    name = "example_custom_copy_env",
    dimensions = {"device_type": device_types.qemu},
    emulator = {
        "device": "x64-emu-min",
        "name": "example",
    },
    env_tags = ["example-tag"],
    netboot = True,
    service_account = "example@fuchsia.iam.gserviceaccount.com",
)

fx_test_environment(
    name = "example_tagged_env",
    dimensions = {"device_type": device_types.vim3},
    env_tags = ["example-tag"],
)

# Variant tags are appended to the base's tags, without duplicates.
fx_test_environment_variant(
    name = "example_tagged_variant_env",
    base = ":example_tagged_env",
    env_tags = [
        "example-tag",
        "other-tag",
    ],
    service_account = "variant@fuchsia.iam.gserviceaccount.com",
)

fx_test(
    name = "example_test_with_custom_environments",
    environments = [
        ":example_custom_env",
        ":example_tagged_variant_env",
        ":example_custom_copy_env",
    ],
    package = ":example_test_package",
)

verify_fx_test_environments(
    name = "verify_example_test_with_custom_environments",
    testonly = True,
    expected_environments = [
        {
            "dimensions": {"device_type": device_types.qemu},
            "emulator": {
                "device": "x64-emu-min",
                "name": "example",
            },
            "netboot": True,
            "service_account": "example@fuchsia.iam.gserviceaccount.com",
            "tags": ["example-tag"],
        },
        {
            "dimensions": {"device_type": device_types.vim3},
            "service_account": "variant@fuchsia.iam.gserviceaccount.com",
            "tags": [
                "example-tag",
                "other-tag",
            ],
        },
    ],
    test = ":example_test_with_custom_environments",
)

# Environments are labels, so they can be chosen with `select()`.
fx_test(
    name = "example_test_with_selected_environments",
    environments = select({
        "//conditions:default": ["//build/testing/environments:vim3_env"],
    }),
    package = ":example_test_package",
)

verify_fx_test_environments(
    name = "verify_example_test_with_selected_environments",
    testonly = True,
    expected_environments = [{"dimensions": {"device_type": device_types.vim3}}],
    test = ":example_test_with_selected_environments",
)

fx_test(
    name = "example_build_only_test",
    build_only = True,
    package = ":example_test_package",
)

verify_fx_test_environments(
    name = "verify_example_build_only_test",
    testonly = True,
    expected_build_only = True,
    expected_environments = [],
    test = ":example_build_only_test",
)

verify_fx_test_realms(
    name = "verify_example_test_default_realm",
    testonly = True,
    expected_realms = {"example_test": ""},
    test = ":example_test",
)

fx_test(
    name = "example_test_with_test_type",
    package = ":example_test_package",
    test_type = "system",
)

verify_fx_test_realms(
    name = "verify_example_test_with_test_type",
    testonly = True,
    expected_realms = {"example_test": "/core/testing/system-tests"},
    test = ":example_test_with_test_type",
)

fx_component_manifest(
    name = "example_starnix_test_manifest",
    testonly = True,
    component_name = "example_starnix_test",
    includes = [
        "//sdk/lib/sys/testing:elf_test_runner.shard.cml",
        "//sdk/lib/syslog:client.shard.cml",
        "//sdk/lib/syslog:offer.shard.cml",
        "//sdk/lib/syslog:use.shard.cml",
    ],
    manifest = "meta/example_test.cml",
)

fx_test_component(
    name = "example_starnix_test_component",
    compiled_manifest = ":example_starnix_test_manifest",
    component_name = "example_starnix_test",
    test_type = "starnix",
    deps = [
        ":example_test_packaged_bin",
    ],
)

fx_package(
    name = "example_multi_component_test_package",
    package_name = "fx-test-multi-component-example",
    test_components = [
        ":example_test_component",
        ":example_starnix_test_component",
    ],
)

fx_test(
    name = "example_multi_component_test",
    package = ":example_multi_component_test_package",
)

verify_fx_test_realms(
    name = "verify_example_multi_component_test_realms",
    testonly = True,
    expected_realms = {
        "example_test": "",
        "example_starnix_test": "/core/testing/starnix-tests",
    },
    test = ":example_multi_component_test",
)

# Checks that invalid `fx_test()` arguments fail analysis with a helpful error.
fx_test_validation_tests(
    name = "fx_test_validation_tests",
    package = ":example_test_package",
)

filegroup(
    name = "build_only_tests",
    testonly = True,
    srcs = [
        ":example_build_only_test",
        ":example_test",
        ":example_test_with_custom_environments",
        ":example_test_with_environments",
        ":example_test_with_selected_environments",
        ":fx_test_validation_tests",
        ":verify_example_build_only_test",
        ":verify_example_test_default_environments",
        ":verify_example_test_with_custom_environments",
        ":verify_example_test_with_environments",
        ":verify_example_test_with_selected_environments",
    ],
    visibility = ["//build/bazel/rules/tests:__pkg__"],
)

# Builds targets for which building successfully is the test.
filegroup(
    name = "quick_build_only_tests",
    testonly = True,
    srcs = [
        ":example_conflicting_runners_failure_test",
        ":example_gtest_unittest_package",
        ":example_multi_component_test",
        ":example_multi_unittest_package",
        ":example_rust_unittest_package",
        ":example_test",
        ":example_test_with_test_type",
        ":example_unittest_package",
        ":example_unittest_package_default_name",
        ":example_zxtest_unittest_package",
        ":verify_example_gtest_runner_shard",
        ":verify_example_multi_component_test_realms",
        ":verify_example_multi_unittest_package_realms",
        ":verify_example_rust_runner_shard",
        ":verify_example_test_default_realm",
        ":verify_example_test_with_test_type",
        ":verify_example_unittest_package_default_name_realms",
        ":verify_example_unittest_package_realms",
        ":verify_example_zxtest_runner_shard",
    ],
    visibility = ["//build/bazel/rules/tests:__pkg__"],
)

fx_cc_binary(
    name = "example_second_test_bin",
    testonly = True,
    srcs = ["example_test.cc"],
    tags = ["manual"],
)

fx_cc_binary(
