// Declares a dynamic dictionary (a dictionary with a `path`), which `cmc` only
// accepts with the "dynamic_dictionaries" restricted feature.
{
    capabilities: [
        {
            dictionary: "output",
            path: "/svc/fuchsia.component.runtime.DictionaryRouter",
        },
    ],
    expose: [
        {
            dictionary: "output",
            from: "self",
        },
    ],
}
