"""Bazel equivalent of the GN `rustc_bindgen_golden()` template.

`rustc_bindgen_golden()` runs bindgen on C headers and checks that the result
matches a checked-in Rust file. Add the target to the `validations` of the
`rustc_library()` that compiles the checked-in file, so the check runs whenever
the library is built, in both Bazel and the GN build generated by bazel2gn.
"""

load("@bazel_tools//tools/cpp:toolchain_utils.bzl", "find_cpp_toolchain")
load("@fuchsia_build_info//:args.bzl", "update_goldens")
load("@rules_cc//cc/common:cc_common.bzl", "cc_common")
load("@rules_cc//cc/common:cc_info.bzl", "CcInfo")

# LINT.IfChange(default_bindgen_rust_version)
_DEFAULT_BINDGEN_RUST_VERSION = "nightly"

# LINT.ThenChange(//build/rust/rustc_bindgen.gni:default_bindgen_rust_version)

def _clang_resource_dir(cc_toolchain):
    """Returns the execroot-relative Clang resource directory of `cc_toolchain`."""

    # The resource directory is `.../lib/clang/<version>`, and contains the
    # Clang built-in headers such as `include/stddef.h`.
    suffix = "/include/stddef.h"
    for f in cc_toolchain.all_files.to_list():
        path = f.path
        if path.endswith(suffix) and "/lib/clang/" in path:
            return path[:-len(suffix)]
    fail("Could not find the Clang resource directory in the files of the C++ toolchain")

def _clang_target(ctx):
    """Returns the Clang target triple of the platform `ctx` is configured for."""

    def has(attr):
        return ctx.target_platform_has_constraint(attr[platform_common.ConstraintValueInfo])

    if has(ctx.attr._linux):
        os = "unknown-linux-gnu"
    elif has(ctx.attr._macos):
        os = "apple-darwin"
    else:
        fail("Unsupported host OS for rustc_bindgen_golden()")
    if has(ctx.attr._x86_64):
        cpu = "x86_64"
    elif has(ctx.attr._aarch64):
        cpu = "aarch64"
    else:
        fail("Unsupported host CPU for rustc_bindgen_golden()")
    return cpu + "-" + os

def _bindgen_attrs(**kwargs):
    """Returns the attributes shared by `_rustc_bindgen` and `rustc_bindgen_golden`.

    Each attribute corresponds to a parameter of the GN `rustc_bindgen()`
    template in //build/rust/rustc_bindgen.gni with the same name, and to a
    flag of //build/rust/new-bindgen.py.

    Args:
      **kwargs: Extra arguments for each `attr.*()` call, such as
        `configurable = False` for symbolic macros.

    Returns:
      A dict of attributes.
    """
    return {
        "rust_version": attr.string(
            doc = "The Rust version to generate code for (bindgen `--rust-target`).",
            default = _DEFAULT_BINDGEN_RUST_VERSION,
            **kwargs
        ),
        "rust_edition": attr.string(
            doc = "The Rust edition to generate code for (bindgen `--rust-edition`). Defaults to the latest edition supported by `rust_version`.",
            **kwargs
        ),
        "expect_lints": attr.string_list(
            doc = "Lints to expect in the generated code (adds `#![expect(lint)]`).",
            **kwargs
        ),
        "notice_year": attr.int(
            doc = "The year in the copyright notice of the generated file.",
            mandatory = True,
            **kwargs
        ),
        "raw_lines": attr.string_list(
            doc = "Lines of code to add at the beginning of the generated file.",
            **kwargs
        ),
        "explicit_padding": attr.bool(
            doc = "Whether to generate explicit padding fields in structs.",
            default = True,
            **kwargs
        ),
        "layout_tests": attr.bool(
            doc = "Whether to generate layout tests.",
            default = False,
            **kwargs
        ),
        "std_impls": attr.string_list(
            doc = "Standard traits to implement when they cannot be derived (bindgen `--impl-<trait>`).",
            **kwargs
        ),
        "std_derives": attr.string_list(
            doc = "Standard traits to derive (bindgen `--with-derive-<trait>`).",
            **kwargs
        ),
        "function_allowlist": attr.string_list(
            doc = "Regexes. Free-standing functions that match none of them are not generated.",
            **kwargs
        ),
        "var_allowlist": attr.string_list(
            doc = "Regexes. Free-standing variables that match none of them are not generated.",
            **kwargs
        ),
        "type_allowlist": attr.string_list(
            doc = "Regexes. Types that match none of them are not generated.",
            **kwargs
        ),
        "function_blocklist": attr.string_list(
            doc = "Regexes. Free-standing functions that match any of them are not generated.",
            **kwargs
        ),
        "type_blocklist": attr.string_list(
            doc = "Regexes. Types that match any of them are not generated.",
            **kwargs
        ),
        "var_blocklist": attr.string_list(
            doc = "Regexes. Free-standing variables that match any of them are not generated.",
            **kwargs
        ),
        "opaque_types": attr.string_list(
            doc = "Regexes. Types that match any of them are generated as opaque blobs.",
            **kwargs
        ),
        "no_debug_types": attr.string_list(
            doc = "Regexes. `Debug` is not derived or implemented for types that match any of them.",
            **kwargs
        ),
        "rustified_enum": attr.string_list(
            doc = "Regexes. Enums that match any of them are generated as Rust enums.",
            **kwargs
        ),
        "use_core": attr.bool(
            doc = "Whether to use types from `core` instead of `std`.",
            default = True,
            **kwargs
        ),
        "additional_bindgen_flags": attr.string_list(
            doc = "Additional flags to pass to bindgen.",
            **kwargs
        ),
        "additional_clang_flags": attr.string_list(
            doc = "Additional flags to pass to Clang.",
            **kwargs
        ),
    }

def _rustc_bindgen_impl(ctx):
    cc_toolchain = find_cpp_toolchain(ctx)
    rust_toolchain = ctx.toolchains["@rules_rust//rust:toolchain_type"]

    compilation_context = cc_common.merge_compilation_contexts(
        compilation_contexts = [dep[CcInfo].compilation_context for dep in ctx.attr.deps],
    )

    # `headers` are source paths (as in GN), which are resolved against the
    # headers of `deps`. This avoids requiring the packages that own the
    # headers to export them with `exports_files()`.
    headers_by_path = {f.short_path: f for f in compilation_context.headers.to_list()}
    headers = []
    for path in ctx.attr.headers:
        if not path.startswith("//"):
            fail("`headers` must be source paths starting with \"//\", got %r" % path)
        header = headers_by_path.get(path[2:])
        if not header:
            fail("%r is not a header of any of `deps`" % path)
        headers.append(header)

    output = ctx.actions.declare_file(ctx.label.name + ".rs")

    args = ctx.actions.args()
    for header in headers:
        args.add("--input", header)
    args.add("--output", output)
    args.add("--bindgen", ctx.file._bindgen)
    args.add("--rustfmt", rust_toolchain.rustfmt)
    args.add("--clang-target", _clang_target(ctx))
    args.add("--clang-resource-dir", _clang_resource_dir(cc_toolchain))
    args.add("--rust-version=" + ctx.attr.rust_version)
    if ctx.attr.rust_edition:
        args.add("--rust-edition=" + ctx.attr.rust_edition)
    args.add_all(ctx.attr.expect_lints, format_each = "--expect-lint=%s")
    args.add("--notice-year", str(ctx.attr.notice_year))
    args.add("--generator-label", ctx.attr.generator_label)
    args.add_all(ctx.attr.raw_lines, format_each = "--raw-line=%s")
    args.add("--explicit-padding" if ctx.attr.explicit_padding else "--no-explicit-padding")
    args.add("--layout-tests" if ctx.attr.layout_tests else "--no-layout-tests")
    args.add_all(ctx.attr.std_impls, format_each = "--std-impl=%s")
    args.add_all(ctx.attr.std_derives, format_each = "--std-derive=%s")
    args.add_all(ctx.attr.function_allowlist, format_each = "--allowlist-function=%s")
    args.add_all(ctx.attr.var_allowlist, format_each = "--allowlist-var=%s")
    args.add_all(ctx.attr.type_allowlist, format_each = "--allowlist-type=%s")
    args.add_all(ctx.attr.function_blocklist, format_each = "--blocklist-function=%s")
    args.add_all(ctx.attr.type_blocklist, format_each = "--blocklist-type=%s")
    args.add_all(ctx.attr.var_blocklist, format_each = "--blocklist-var=%s")
    args.add_all(ctx.attr.opaque_types, format_each = "--opaque-type=%s")
    args.add_all(ctx.attr.no_debug_types, format_each = "--no-debug=%s")
    args.add_all(ctx.attr.rustified_enum, format_each = "--rustified-enum=%s")
    args.add("--use-core" if ctx.attr.use_core else "--no-use-core")
    args.add_all(ctx.attr.additional_bindgen_flags, format_each = "--bindgen-flag=%s")

    # All arguments after "--" go directly to Clang. These match the
    # `{{defines}}`, `{{include_dirs}}` and `--sysroot` that the GN template
    # passes when it runs bindgen in the host toolchain.
    args.add("--")
    args.add_all(compilation_context.defines, format_each = "-D%s")
    args.add_all(compilation_context.includes, format_each = "-I%s")
    args.add_all(compilation_context.quote_includes, format_each = "-iquote%s")
    args.add_all(compilation_context.system_includes, format_each = "-isystem%s")
    args.add_all(compilation_context.external_includes, format_each = "-isystem%s")
    if cc_toolchain.sysroot:
        args.add("--sysroot=" + cc_toolchain.sysroot)
    args.add_all(ctx.attr.additional_clang_flags)

    ctx.actions.run(
        executable = ctx.executable._bindgen_script,
        arguments = [args],
        inputs = depset(
            headers,
            transitive = [compilation_context.headers, cc_toolchain.all_files],
        ),
        # rustfmt dynamically links the shared libraries in `rustc_lib`.
        tools = depset(
            [ctx.file._bindgen, rust_toolchain.rustfmt],
            transitive = [rust_toolchain.rustc_lib],
        ),
        outputs = [output],
        mnemonic = "RustBindgen",
        progress_message = "Generating Rust bindings %{label}",
    )
    return [DefaultInfo(files = depset([output]))]

_rustc_bindgen = rule(
    doc = """Runs bindgen on C headers. Use `rustc_bindgen_golden()` instead.

The target must be built in the exec configuration (see
`_verify_rustc_bindgen_golden`), which matches the host toolchain that the GN
`rustc_bindgen_golden()` template uses. That keeps the output independent of
the target build configuration.""",
    implementation = _rustc_bindgen_impl,
    toolchains = [
        "@bazel_tools//tools/cpp:toolchain_type",
        "@rules_rust//rust:toolchain_type",
    ],
    fragments = ["cpp"],
    attrs = {
        "headers": attr.string_list(
            doc = "Source paths (e.g. \"//sdk/lib/foo/include/lib/foo/foo.h\") of the C header files to generate bindings for. Each must be a header of `deps`.",
            mandatory = True,
        ),
        "deps": attr.label_list(
            doc = "Libraries that provide `headers` and the headers they include.",
            providers = [CcInfo],
        ),
        "generator_label": attr.string(
            doc = "The label named in the header comment of the generated file.",
            mandatory = True,
        ),
        "_linux": attr.label(default = "@platforms//os:linux"),
        "_macos": attr.label(default = "@platforms//os:macos"),
        "_x86_64": attr.label(default = "@platforms//cpu:x86_64"),
        "_aarch64": attr.label(default = "@platforms//cpu:aarch64"),
        "_bindgen": attr.label(
            default = "//build/rust:bindgen",
            allow_single_file = True,
            cfg = "exec",
        ),
        "_bindgen_script": attr.label(
            default = "//build/rust:new_bindgen",
            executable = True,
            cfg = "exec",
        ),
    } | _bindgen_attrs(),
)

def _verify_rustc_bindgen_golden_impl(ctx):
    candidate = ctx.file.candidate
    golden = ctx.file.checked_in_source
    stamp = ctx.actions.declare_file(ctx.label.name + ".verified")

    comparisons = ctx.actions.declare_file(ctx.label.name + ".comparisons.json")
    ctx.actions.write(
        output = comparisons,
        content = json.encode_indent(
            [{"candidate": candidate.path, "golden": golden.path}],
            indent = "  ",
        ),
    )

    args = ctx.actions.args()
    args.add("--stamp-file", stamp)
    args.add("--source-root", ".")  # Paths are relative to the execroot.
    args.add("--label", ctx.label)
    args.add("--comparisons", comparisons)
    args.add("--paths-relative-to-source-root")

    execution_requirements = {}
    if update_goldens:
        args.add("--bless")

        # Updating the checked-in file requires writing outside the sandbox,
        # so it cannot run remotely or be cached either.
        execution_requirements = {
            "no-cache": "1",
            "no-remote": "1",
            "no-sandbox": "1",
        }

    ctx.actions.run(
        executable = ctx.executable._verify_script,
        arguments = [args],
        inputs = [candidate, golden, comparisons],
        outputs = [stamp],
        mnemonic = "VerifyRustBindgenGolden",
        progress_message = "Verifying Rust bindings %{label}",
        execution_requirements = execution_requirements,
    )

    # Only provide a validation output, so depending on this target from
    # `rustc_library(validations = ...)` (which adds it to `compile_data`)
    # adds no inputs to the Rust compile action. Bazel runs the validation
    # whenever a target that depends on this one is built.
    return [
        DefaultInfo(files = depset()),
        OutputGroupInfo(_validation = depset([stamp])),
    ]

_verify_rustc_bindgen_golden = rule(
    doc = "Verifies the output of a `_rustc_bindgen()` target against a checked-in file.",
    implementation = _verify_rustc_bindgen_golden_impl,
    attrs = {
        "candidate": attr.label(
            doc = "The `_rustc_bindgen()` target to verify.",
            allow_single_file = [".rs"],
            mandatory = True,
            # Generate the bindings in the exec configuration (the host), like
            # the GN template, so they do not depend on the target platform.
            cfg = "exec",
        ),
        "checked_in_source": attr.label(
            doc = "The checked-in Rust file.",
            allow_single_file = [".rs"],
            mandatory = True,
        ),
        "_verify_script": attr.label(
            default = "//build/testing:verify_golden_files",
            executable = True,
            cfg = "exec",
        ),
    },
)

def _rustc_bindgen_golden_impl(
        name,
        visibility,
        headers,
        checked_in_source,
        deps,
        fuchsia_api_level,
        testonly,
        **kwargs):
    # LINT.IfChange(fuchsia_api_level)
    # The GN template only accepts "HEAD", which the host toolchain sets by
    # default, so the value does not change how bindgen runs.
    if fuchsia_api_level and fuchsia_api_level != "HEAD":
        fail("`fuchsia_api_level` must be \"HEAD\" if set, got %r" % fuchsia_api_level)

    # LINT.ThenChange(//build/rust/rustc_bindgen.gni:fuchsia_api_level)

    generated_name = name + "_generated"
    _rustc_bindgen(
        name = generated_name,
        headers = headers,
        deps = deps,
        generator_label = "//%s:%s" % (native.package_name(), name),
        testonly = testonly,
        visibility = ["//visibility:private"],
        # Only build this target through `name`, which builds it in the exec
        # configuration. Wildcards like `:all` would build it for the target
        # platform instead.
        tags = ["manual"],
        **kwargs
    )
    _verify_rustc_bindgen_golden(
        name = name,
        candidate = ":" + generated_name,
        checked_in_source = checked_in_source,
        testonly = testonly,
        visibility = visibility,
    )

rustc_bindgen_golden = macro(
    doc = """Checks that bindgen output for C headers matches a checked-in Rust file.

Equivalent to the GN `rustc_bindgen_golden()` template in
//build/rust/rustc_bindgen.gni, which bazel2gn generates from this macro. The
attributes have the same names and meanings as the GN parameters.

Add the target to `validations` of the `rustc_library()` that compiles
`checked_in_source` so the check runs whenever the library is built:

```
rustc_bindgen_golden(
    name = "foo_bindgen_golden",
    headers = ["//sdk/lib/foo/include/lib/foo/foo.h"],
    checked_in_source = "src/bindings.rs",
    notice_year = 2026,
    deps = ["//sdk/lib/foo"],
)

rustc_library(
    name = "foo-sys",
    srcs = ["src/bindings.rs", "src/lib.rs"],
    validations = [":foo_bindgen_golden"],
)
```

To update the checked-in file, build with `update_goldens = true` in GN args,
like other golden files.

Like the GN template, bindgen always runs for the host (the exec platform), so
the checked-in file does not depend on the target platform.
""",
    implementation = _rustc_bindgen_golden_impl,
    attrs = {
        "headers": attr.string_list(
            doc = """Source paths of the C header files to generate bindings for.

These are paths, not labels, like in GN (e.g.
`"//sdk/lib/foo/include/lib/foo/foo.h"`), and each must be a header of `deps`.
That way the packages that own the headers do not need to export them.""",
            mandatory = True,
            configurable = False,
        ),
        "checked_in_source": attr.label(
            doc = "The checked-in Rust file to compare the bindings with.",
            mandatory = True,
            configurable = False,
        ),
        "deps": attr.label_list(
            doc = "Libraries that provide `headers` and the headers they include.",
            configurable = False,
        ),
        "testonly": attr.bool(default = False, configurable = False),
        "fuchsia_api_level": attr.string(
            doc = "Must be \"HEAD\" if set. Kept for parity with the GN template.",
            configurable = False,
        ),
    } | _bindgen_attrs(configurable = False),
)
