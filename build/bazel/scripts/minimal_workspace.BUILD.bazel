load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@rules_license//rules:license.bzl", "license")
load("//build/bazel/rbe:rbe.bzl", "RBE_USE_LARGE_WORKER")

# These actions can all be run remotely, and do not require any toolchain.

# The working directory depends on local vs. remote execution.
genrule(
    name = "pwd",
    cmd = "pwd > $@",
    outs = ["pwd.txt"],
)

# This test will pass only if :pwd was run remotely.
diff_test(
    name = "remote_pwd_test",
    file1 = "expect_pwd.txt",
    file2 = ":pwd",
)

# Explicitly test remote execution on the larger worker pool.
genrule(
    name = "pwd_large",
    cmd = "pwd > $@",
    outs = ["pwd_large.txt"],
    exec_properties = RBE_USE_LARGE_WORKER,
)

# This test will pass only if :pwd_large was run remotely on the large worker pool.
diff_test(
    name = "remote_pwd_large_test",
    file1 = "expect_pwd.txt",
    file2 = ":pwd_large",
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-2-Clause"],
    license_text = "LICENSE",
)
