if (is_host) {
  # Python scripts in this directory that aren't part of any other Python
  # target, usually because they're run directly by action() or Bazel rules.
  # Listing them here makes them subject to type checking.
  python_library("type_checked_scripts") {
    testonly = true

    # This target only exists for type checking; depending on it would package
    # a grab-bag of unrelated scripts.
    visibility = [
      ":*",
      "//build:*",
    ]
    sources = [
      "bazel_tool.py",
      "check_regenerator_inputs.py",
      "copy_assembled_system_outputs.py",
      "copy_bazel_build_group_outputs.py",
      "copy_bazel_debug_symbols.py",
      "create_gn_targets_dir.py",
      "export_rules_fuchsia.py",
      "generate-bazel-install.py",
      "git-clone-then-apply-bundle.py",
      "hardlink-directory.py",
      "merge_bazel_compdb.py",
      "parse-workspace-event-log.py",
      "prepare-fuchsia-checkout.py",
      "refresh-bazel-compdb-bin.py",
      "symlink-directory.py",
      "update_bazel_vendor_dir.py",
    ]
    library_deps = [
      # For copy_bazel_debug_symbols.py.
      "//build/api:debug_symbols",
    ]
  }
