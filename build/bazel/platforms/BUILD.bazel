"""Bazel platform() definitions for the Fuchsia platform build."""

# The Fuchsia build will use transitions that change the --platforms=<label>
# value to modify the current build configuration. As such, each platform
# instance represents:
#
#  - A separate output directory for generated artifacts.
#  - An execution environment for generated binaries.
#  - A separate set of configuration variable values.
#
# The `//build/bazel/platforms:common` platform is used for all targets
# that do not generate os- or arch-specific binaries (e.g. Java bytecode,
# auto-generated headers and more). It is set to be the default platforms
# by using --platforms=//build/bazel/platforms:common in the auto-generated
# .bazelrc
#
# In theory, it should be possible to define additionnal platforms that
# correspond to specific Fuchsia product configurations, which will allow
# performing system assembly for several Fuchsia devices in a single
# build invocation (provided the right transitions are used).
#

load("@fuchsia_build_config//:defs.bzl", "build_config")
load("@fuchsia_build_info//:args.bzl", fuchsia_target_cpu = "target_cpu")
load("@fuchsia_build_info//:platforms_flags.bzl", "fuchsia_has_lto", "host_has_lto", "platform_flags_map")

# The platform_flags_map dictionary is generated from the content of
# 'args.gn` and //build/bazel/config/bazel_args.gni and contains for
# each platform defined in this file a set of 'flags' values which
# will force the corresponding build_setting() target values and
# --features list to match the desired configuration.
#
# These values are reset properly in each transition where the
# --platforms value changes, including implicit transitions to the
# "exec" platform that occur when building host tools that build
# actions depend on.

# LINT.IfChange(bazel_platforms_list)
_flags_for_linux_x64 = platform_flags_map["linux_x64"]

_flags_for_linux_arm64 = platform_flags_map["linux_arm64"]

_flags_for_linux_starnix_x64 = platform_flags_map["linux_starnix_x64"]

_flags_for_linux_starnix_arm64 = platform_flags_map["linux_starnix_arm64"]

_flags_for_linux_starnix_riscv64 = platform_flags_map["linux_starnix_riscv64"]

_flags_for_linux_starnix_arm = platform_flags_map["linux_starnix_arm"]

_flags_for_fuchsia_sdk_x64 = platform_flags_map["fuchsia_sdk_x64"]

_flags_for_fuchsia_sdk_arm64 = platform_flags_map["fuchsia_sdk_arm64"]

_flags_for_fuchsia_sdk_riscv64 = platform_flags_map["fuchsia_sdk_riscv64"]

_flags_for_fuchsia_platform_x64 = platform_flags_map["fuchsia_platform_x64"]

_flags_for_fuchsia_platform_arm64 = platform_flags_map["fuchsia_platform_arm64"]

_flags_for_fuchsia_platform_riscv64 = platform_flags_map["fuchsia_platform_riscv64"]
# LINT.ThenChange(//build/bazel/scripts/workspace_utils.py:bazel_platforms_list)

package(default_applicable_licenses = ["//:license"])

# The `//build/bazel/platforms:common` platform should be used for
# the default build configuration, and will contain all build
# artifacts which do not depend on a specific operating system
# or CPU architecture.
platform(
    name = "common",
    constraint_values = [],
    visibility = ["//:__subpackages__"],
)

# The //build/bazel/platforms:host platform is used to target
# the build configuration matching the current host machine.
alias(
    name = "host",
    actual = ":" + build_config.host_tag_alt,
    visibility = ["//:__subpackages__"],
)

alias(
    name = "default",
    actual = ":fuchsia_sdk_" + fuchsia_target_cpu,
    visibility = ["//:__subpackages__"],
)

# The following platforms will be used to generate binaries
# for Fuchsia and Linux systems, respectively. Other
# parts of Bazel should define C++ and Rust toolchain instances
# and configs that match the same constraint values to be
# selected for them.

# The fuchsia_sdk_$cpu platform definitions are used to build
# Fuchsia binaries with our Bazel SDK rules. As a consequence
# they require a working @fuchsia_sdk and @fuchsia_clang
# repository to provide a sysroot and SDK atoms to access
# platform libraries.
platform(
    name = "fuchsia_sdk_x64",
    constraint_values = [
        "@platforms//os:fuchsia",
        "@platforms//cpu:x86_64",
        ":fuchsia_artifacts_build_with_sdk_rules",
    ],
    flags = _flags_for_fuchsia_sdk_x64,
    visibility = ["//:__subpackages__"],
)

platform(
    name = "fuchsia_sdk_arm64",
    constraint_values = [
        "@platforms//os:fuchsia",
        "@platforms//cpu:arm64",
        ":fuchsia_artifacts_build_with_sdk_rules",
    ],
    flags = _flags_for_fuchsia_sdk_arm64,
    visibility = ["//:__subpackages__"],
)

platform(
    name = "fuchsia_sdk_riscv64",
    constraint_values = [
        "@platforms//os:fuchsia",
        "@platforms//cpu:riscv64",
        ":fuchsia_artifacts_build_with_sdk_rules",
    ],
    flags = _flags_for_fuchsia_sdk_riscv64,
    visibility = ["//:__subpackages__"],
)

# The fuchsia_platform_$cpu platform definitions are used to
# build Fuchsia binaries *without* Bazel SDK rules. These artifacts
# are considered part of the Fuchsia platform itself and are used
# to generate the SDK atoms that the fuchsia_$cpu platform targets
# rely on.
platform(
    name = "fuchsia_platform_x64",
    constraint_values = [
        "@platforms//os:fuchsia",
        "@platforms//cpu:x86_64",
        ":fuchsia_artifacts_build_without_sdk_rules",
    ],
    flags = _flags_for_fuchsia_platform_x64,
    visibility = ["//:__subpackages__"],
)

platform(
    name = "fuchsia_platform_arm64",
    constraint_values = [
        "@platforms//os:fuchsia",
        "@platforms//cpu:arm64",
        ":fuchsia_artifacts_build_without_sdk_rules",
    ],
    flags = _flags_for_fuchsia_platform_arm64,
    visibility = ["//:__subpackages__"],
)

platform(
    name = "fuchsia_platform_riscv64",
    constraint_values = [
        "@platforms//os:fuchsia",
        "@platforms//cpu:riscv64",
        ":fuchsia_artifacts_build_without_sdk_rules",
    ],
    flags = _flags_for_fuchsia_platform_riscv64,
    visibility = ["//:__subpackages__"],
)

# Host platform definitions.

# TODO(https://fxbug.dev/484422864): Use "host_*" for host platforms and use
# "linux_*" other purposes, such as Starnix binaries. Consider renaming
# "linux_*" to "starnix_linux_*" to avoid ambiguity.
# @rules_cc rules (cc_binary, cc_test, cc_library) assign CppLink actions to
# the "cpp_link" execution group (exec_group). Prefixing execution property
# keys with "cpp_link." overrides those properties specifically for CppLink
# actions while keeping CppCompile and other default-group actions on the
# default RBE worker pool.
#
# When LTO or ThinLTO is enabled, link actions require significantly more
# memory and can OOM on default RBE workers, so route them to the large RBE
# worker pool (see https://fxbug.dev/575721833).
#
# Note: Bazel reads `exec_properties` from the *execution* platform
# (`--host_platform=//build/bazel/platforms:host`, which resolves to
# `:linux_x64`), not from the *target* platform (`--platforms=...`). Because
# `:linux_x64` executes link actions for both Fuchsia and host targets,
# enable the large worker pool when either `fuchsia_has_lto` or `host_has_lto`
# is true.
_linux_x64_exec_properties = build_config.rbe_remote_exec_properties | (
    {
        "cpp_link." + k: v
        for k, v in build_config.rbe_large_exec_properties.items()
    } if (fuchsia_has_lto or host_has_lto) else {}
)

platform(
    name = "linux_x64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    exec_properties = _linux_x64_exec_properties,
    flags = _flags_for_linux_x64,
    visibility = ["//:__subpackages__"],
)

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
    flags = _flags_for_linux_arm64,
    visibility = ["//:__subpackages__"],
)

# Linux platforms for binaries that run in Starnix, e.g. the Starnix vDSO.
#
# Unlike the linux_$cpu platforms above, which are used for host binaries,
# build tools and binaries distributed out-of-tree (e.g. in the IDK) and must
# keep using the older Linux sysroot, these use the newer sysroot that GN
# uses for non-host Linux toolchains. They carry the :linux_flavor_starnix
# constraint value so that they never resolve to the host C++ toolchains (and
# vice versa), see define_starnix_prebuilt_clang_cc_toolchains() in
# //build/bazel/toolchains/clang/toolchains.bzl.
#
# linux_starnix_arm (32-bit arm) is only used to build the 32-bit ("arch32")
# vDSO that arm64 devices ship for 32-bit Linux programs.
platform(
    name = "linux_starnix_x64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        ":linux_flavor_starnix",
    ],
    flags = _flags_for_linux_starnix_x64,
    visibility = ["//:__subpackages__"],
)

platform(
    name = "linux_starnix_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
        ":linux_flavor_starnix",
    ],
    flags = _flags_for_linux_starnix_arm64,
    visibility = ["//:__subpackages__"],
)

platform(
    name = "linux_starnix_riscv64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:riscv64",
        ":linux_flavor_starnix",
    ],
    flags = _flags_for_linux_starnix_riscv64,
    visibility = ["//:__subpackages__"],
)

platform(
    name = "linux_starnix_arm",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:arm",
        ":linux_flavor_starnix",
    ],
    flags = _flags_for_linux_starnix_arm,
    visibility = ["//:__subpackages__"],
)

# TODO(https://fxbug.dev/484422864): Make these standalone platforms that use
# the more permissive sysroot.
alias(
    name = "host_linux_x64",
    actual = ":linux_x64",
    visibility = ["//:__subpackages__"],
)

alias(
    name = "host_linux_arm64",
    actual = ":linux_arm64",
    visibility = ["//:__subpackages__"],
)

# Configuration conditions for the platform values above.
# Like `"@platforms//os:fuchsia"`, the `is_fuchsia_${target_cpu}` settings are
# true for both Fuchsia platform and Bazel SDK-using platforms.

config_setting(
    name = "is_fuchsia_with_sdk_rules",
    constraint_values = [
        "@platforms//os:fuchsia",
        ":fuchsia_artifacts_build_with_sdk_rules",
    ],
    visibility = [
        "//:__subpackages__",
        "@googletest_fuchsia_sdk//:__subpackages__",
    ],
)

config_setting(
    name = "is_fuchsia_platform",
    constraint_values = [
        "@platforms//os:fuchsia",
        ":fuchsia_artifacts_build_without_sdk_rules",
    ],
    visibility = [
        "//:__subpackages__",
        "@googletest_fuchsia_sdk//:__subpackages__",
    ],
)

config_setting(
    name = "is_fuchsia_x64",
    constraint_values = [
        "@platforms//os:fuchsia",
        "@platforms//cpu:x86_64",
    ],
    visibility = ["//:__subpackages__"],
)

config_setting(
    name = "is_fuchsia_arm64",
    constraint_values = [
        "@platforms//os:fuchsia",
        "@platforms//cpu:arm64",
    ],
    visibility = ["//:__subpackages__"],
)

config_setting(
    name = "is_fuchsia_riscv64",
    constraint_values = [
        "@platforms//os:fuchsia",
        "@platforms//cpu:riscv64",
    ],
    visibility = ["//:__subpackages__"],
)

config_setting(
    name = "is_linux_x64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    visibility = ["//:__subpackages__"],
)

config_setting(
    name = "is_linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
    visibility = ["//:__subpackages__"],
)

# Use this to match the host operating system, independent of its CPU.
# This will match `target_compatible_with = HOST_OS_CONSTRAINTS` where
# HOST_OS_CONSTRAINTS is defined by //build/bazel/platforms:constraints.bzl.
config_setting(
    name = "is_host_os",
    constraint_values = [
        build_config.host_platform_os_constraint,
    ],
    visibility = ["//:__subpackages__"],
)

# A constraint dimension which indiciates whether Fuchsia artifacts
# are generated using SDK rules or not. Platform binaries cannot use
# SDK rules.
constraint_setting(
    name = "fuchsia_artifacts_build_mode",
    default_constraint_value = ":fuchsia_artifacts_build_with_sdk_rules",
)

constraint_value(
    name = "fuchsia_artifacts_build_without_sdk_rules",
    constraint_setting = ":fuchsia_artifacts_build_mode",
    visibility = [
        "//:__subpackages__",
        "@prebuilt_clang//:__subpackages__",
    ],
)

constraint_value(
    name = "fuchsia_artifacts_build_with_sdk_rules",
    constraint_setting = ":fuchsia_artifacts_build_mode",
    visibility = [
        "//:__subpackages__",
        "@fuchsia_clang//:__subpackages__",
    ],
)

# A constraint dimension which distinguishes the Linux platforms used for host
# binaries, build tools and out-of-tree binaries (the default) from the ones
# used for Linux binaries that run in Starnix (linux_starnix_$cpu), which use
# a different sysroot and C++ toolchains.
constraint_setting(
    name = "linux_flavor",
    default_constraint_value = ":linux_flavor_host",
)

constraint_value(
    name = "linux_flavor_host",
    constraint_setting = ":linux_flavor",
    visibility = [
        "//:__subpackages__",
        "@prebuilt_clang//:__subpackages__",
    ],
)

constraint_value(
    name = "linux_flavor_starnix",
    constraint_setting = ":linux_flavor",
    visibility = [
        "//:__subpackages__",
        "@prebuilt_clang//:__subpackages__",
    ],
)
