Subject: [rules_cc] Support PIE executables in dbg and fastbuild modes

In upstream rules_cc, `use_pic_for_binaries` forces PIC for binaries
whenever `compilation_mode != "opt"`. On Fuchsia, executables and their
static library dependencies are compiled with -fPIE across all
compilation modes (matching the GN build).

Do not force PIC for binaries in dbg and fastbuild modes so that
executables can use non-PIC objects and compile with -fPIE.
---
--- a/third_party/bazel_vendor/fuchsia_in_tree/rules_cc+/cc/common/cc_helper.bzl
+++ b/third_party/bazel_vendor/fuchsia_in_tree/rules_cc+/cc/common/cc_helper.bzl
@@ -791,11 +791,12 @@ def _should_use_pic(ctx, cc_toolchain, feature_configuration):
     Returns:
         (bool)
     """
+    # Fuchsia: Do not force PIC for binaries in non-opt (dbg, fastbuild)
+    # compilation modes, so executables and their static dependencies are
+    # compiled with -fPIE across all compilation modes to match the GN build.
     return ctx.fragments.cpp.force_pic() or (
-        cc_toolchain.needs_pic_for_dynamic_libraries(feature_configuration = feature_configuration) and (
-            ctx.var["COMPILATION_MODE"] != "opt" or
-            cc_common.is_enabled(feature_configuration = feature_configuration, feature_name = "prefer_pic_for_opt_binaries")
-        )
+        cc_toolchain.needs_pic_for_dynamic_libraries(feature_configuration = feature_configuration) and
+        cc_common.is_enabled(feature_configuration = feature_configuration, feature_name = "prefer_pic_for_opt_binaries")
     )
 
 SYSROOT_FLAG = "--sysroot="
--- a/third_party/bazel_vendor/fuchsia_in_tree/rules_cc+/cc/common/cc_helper_internal.bzl
+++ b/third_party/bazel_vendor/fuchsia_in_tree/rules_cc+/cc/common/cc_helper_internal.bzl
@@ -418,9 +418,12 @@ def use_pic_for_binaries(cpp_config, feature_configuration):
     """
     Returns whether binaries must be compiled with position independent code.
     """
+    # Fuchsia: Do not force PIC for binaries in non-opt (dbg, fastbuild)
+    # compilation modes, so executables and their static dependencies are
+    # compiled with -fPIE across all compilation modes to match the GN build.
     return cpp_config.force_pic() or (
         feature_configuration.is_enabled("supports_pic") and
-        (cpp_config.compilation_mode() != "opt" or feature_configuration.is_enabled("prefer_pic_for_opt_binaries"))
+        feature_configuration.is_enabled("prefer_pic_for_opt_binaries")
     )
 
 def use_pic_for_dynamic_libs(cpp_config, feature_configuration):
