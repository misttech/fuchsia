Subject: [rules_rust] Fix elided lifetimes in process_wrapper

Fuchsia's Rust toolchain passes its default lint flags, including
-Wrust-2018-idioms, to exec-configuration crates as well. process_wrapper
is built in the exec configuration without --cap-lints=allow, so every
`fmt::Formatter` without an explicit lifetime emits an
elided_lifetimes_in_paths warning.

Spell out the anonymous lifetime (`fmt::Formatter<'_>`) so that
process_wrapper builds cleanly.

Drop this patch once upstream rules_rust includes the same fix.
---
--- a/third_party/bazel_vendor/rules_rust+/util/process_wrapper/flags.rs
+++ b/third_party/bazel_vendor/rules_rust+/util/process_wrapper/flags.rs
@@ -28,7 +28,7 @@
 }
 
 impl fmt::Display for FlagParseError {
-    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
         match self {
             Self::UnknownFlag(ref flag) => write!(f, "unknown flag \"{flag}\""),
             Self::ValueMissing(ref flag) => write!(f, "flag \"{flag}\" missing parameter(s)"),
@@ -50,13 +50,13 @@
 }
 
 impl<T> fmt::Display for FlagDef<'_, T> {
-    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
         write!(f, "{}\t{}", self.name, self.help)
     }
 }
 
 impl<T> fmt::Debug for FlagDef<'_, T> {
-    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
         f.debug_struct("FlagDef")
             .field("name", &self.name)
             .field("help", &self.help)
