import("//build/bazel/bazel_build_action.gni")

# Get the host_tools_dir and host_tools_base_path_override vars, but don't
# expose them (or any other variables or templates in host.gni) to any other
# files that import this one.
_temp = {
  import("//build/host.gni")
}
_host_tools_dir = _temp.host_tools_dir
_host_tools_base_path_override = _temp.host_tools_base_path_override

# bazel_host_tool() is a wrapper around bazel_build_action that provides
# the tool_paths metadata that BUILDCONFIG.gn provides for GN executable
# targets.
#
# In sub-builds (see //build/subbuild.gni), where
# `host_tools_base_path_override` is set, it doesn't build anything. Instead it
# copies the binary from the parent build directory, like install_host_tools()
# does. The parent build must already depend on the tool, otherwise the
# sub-build fails with a missing input.
#
# Params
#  bazel_target: (label) the label of the bazel target to build
#
#  output_name: (string, optional) name of the output binary.
#    Defaults to 'target_name'.
#
#  bazel_output_path: (path, required) see documentation for
#     `<bazel_path>` in `bazel_build_action()`.
#
#  install_host_tool: (bool, optional) if true, the binary will also be
#     copied to the `host_tools_dir` - see //build/host.gni.
#
#  companion_files: (list of strings, optional) basenames of companion files
#     in `{{BAZEL_TARGET_OUT_DIR}}` to copy alongside the binary into
#     `root_out_dir` (and `host_tools_dir` when `install_host_tool` is true).
#
#  All other bazel_build_action() inputs *except* 'copy_outputs'
#     are forwarded to bazel_build_action().  The template creates
#     the 'copy_outputs' list itself.
#
template("bazel_host_tool") {
  # This needs to be called in a host toolchain, so that the outputs can be
  # copied to the correct `root_out_dir` folder for variant toolchains.
  assert(is_host, "bazel_host_tool() can only be called in a host toolchain.")

  assert(!defined(invoker.copy_outputs),
         "This template creates copy_outputs, don't provide it.")

  if (defined(invoker.companion_files)) {
    foreach(_companion_file, invoker.companion_files) {
      assert(
          _companion_file != "" &&
              get_path_info(_companion_file, "file") == _companion_file,
          "companion_files must be non-empty basenames, got ${_companion_file}.")
    }
  }

  if (defined(invoker.output_name)) {
    _output_name = invoker.output_name
  } else {
    _output_name = target_name
  }

  if (current_toolchain == toolchain_variant.base) {
    _output_path = "${root_out_dir}/${_output_name}"

    _install_host_tool =
        defined(invoker.install_host_tool) && invoker.install_host_tool &&
        # Only install in the "real" host toolchain.
        current_toolchain == host_toolchain

    _companion_files = []
    if (defined(invoker.companion_files)) {
      _companion_files = invoker.companion_files
    }
    _runtime_files = []
    foreach(_companion_file, _companion_files) {
      _runtime_files +=
          [ rebase_path("${root_out_dir}/${_companion_file}", root_build_dir) ]
    }

    _metadata = {
      tool_paths = [
        {
          cpu = current_cpu
          label = get_label_info(":${target_name}", "label_with_toolchain")
          name = _output_name
          os = current_os
          path = rebase_path(_output_path, root_build_dir)
          if (_runtime_files != []) {
            runtime_files = _runtime_files
          }
        },
      ]
    }
  }

  if (current_toolchain == toolchain_variant.base &&
      _host_tools_base_path_override != "") {
    # build/subbuild.py runs `gn gen` and Ninja directly, without
    # build/regenerator.py, so sub-builds have no Bazel workspace or Ninja
    # delayed-action worker and can't run bazel_action() targets. Like
    # install_host_tools(), reuse the parent build's binary instead. This
    # relies on the parent build having built the tool before starting the
    # sub-build (see the `deps` of the subbuild() action).
    _parent_build_files = []
    foreach(_file, [ _output_name ] + _companion_files) {
      _parent_build_file_rebased =
          "${_host_tools_base_path_override}/" +
          rebase_path("${root_out_dir}/${_file}", root_build_dir)
      _parent_build_files += [ "//" + rebase_path(_parent_build_file_rebased,
                                                  "//",
                                                  root_build_dir) ]
    }

    _install_deps = []
    if (_install_host_tool) {
      _install_target = "${target_name}.install"
      _install_deps += [ ":${_install_target}" ]
      copy(_install_target) {
        forward_variables_from(invoker, [ "testonly" ])
        visibility = [ ":*" ]
        sources = _parent_build_files
        outputs = [ "${_host_tools_dir}/{{source_file_part}}" ]
      }
    }

    copy(target_name) {
      forward_variables_from(invoker,
                             [
                               "testonly",
                               "visibility",
                             ])
      sources = _parent_build_files
      outputs = [ "${root_out_dir}/{{source_file_part}}" ]
      deps = _install_deps
      metadata = _metadata
    }
    not_needed(invoker, "*")
  } else if (current_toolchain == toolchain_variant.base) {
    # If in the base toolchain, copy the Bazel outputs as normal. Variant
    # toolchains need to be handled separately (see the else case below)

    bazel_build_action(target_name) {
      forward_variables_from(invoker,
                             "*",
                             [
                               "output_name",
                               "bazel_output_path",
                               "install_host_tool",
                               "companion_files",

                               # standard "deep-forwarded" params
                               "testonly",
                               "visibility",
                             ])
      forward_variables_from(invoker,
                             [
                               "testonly",
                               "visibility",
                             ])

      bazel_config = "host"

      # We want to copy the binary to `//out/default/host_x64/my_tool` but
      # the 'ninja_base_dir' defaults to `target_out_dir`, which is
      # `//out/default/host_x64/some/path/`.
      # Set `ninja_base_dir` to `root_build_dir` (ie, `//out/default`), so that
      # here we can use an output path that's relative to the root of the build.
      # This also allows us to install files in `host_tools_dir` if requested,
      # which `root_out_dir` would not support.
      ninja_base_dir = root_build_dir

      copy_outputs = [
        {
          bazel = invoker.bazel_output_path

          # We want to copy the binary to `//out/default/host_x64/my_tool` but
          # the default 'ninja_base_dir' is `//out/default/host_x64/some/path/`
          # and so above we forcibly set the `ninja_base_dir` to
          # `//out/default`, so that here we can use an output path that's
          # relative to the root of the build.
          ninja = rebase_path(_output_path, root_build_dir)
        },
      ]

      foreach(_companion_file, _companion_files) {
        copy_outputs += [
          {
            bazel = "{{BAZEL_TARGET_OUT_DIR}}/${_companion_file}"
            ninja = rebase_path("${root_out_dir}/${_companion_file}",
                                root_build_dir)
          },
        ]
      }

      # Add an additional copy in the host tools outdir if requested.
      if (_install_host_tool) {
        copy_outputs += [
          {
            bazel = invoker.bazel_output_path

            # The use of 'root_build_dir' as 'ninja_base_dir' is why we can
            # also copy to the `host_tools_dir` here, as it's also able to
            # be expressed relative to the root_build_dir.
            ninja = rebase_path("${_host_tools_dir}/${_output_name}",
                                root_build_dir)
          },
        ]

        foreach(_companion_file, _companion_files) {
          copy_outputs += [
            {
              bazel = "{{BAZEL_TARGET_OUT_DIR}}/${_companion_file}"
              ninja = rebase_path("${_host_tools_dir}/${_companion_file}",
                                  root_build_dir)
            },
          ]
        }
      }

      metadata = _metadata
    }
  } else {
    # If in a variant toolchain, the expectation is to find the host binary
    # in the _variant_'s toolchain outdir.  For non-Bazel targets, this is
    # where they are compiled to, and then they're copied to the base
    # toolchain location.  However, we need to do the opposite and copy it
    # to the variant toolchain outdir.
    #
    # If `host_out_dir` would point at the non-variant path, then we could
    # use that and avoid this copy.  Actions that are using `host_out_dir`
    # to locate the binary for compiled_action() expect to find the
    # binary at the variant path, so we need this copy.  If they used the
    # copy in the non-variant location, then we could do a group with public
    # deps here instead of the copy().

    base_target = ":${target_name}(${toolchain_variant.base})"
    base_target_outdir = get_label_info(base_target, "root_out_dir")

    copy(target_name) {
      forward_variables_from(invoker,
                             [
                               "testonly",
                               "visibility",
                             ])
      sources = [ "${base_target_outdir}/${_output_name}" ]
      if (defined(invoker.companion_files)) {
        foreach(_companion_file, invoker.companion_files) {
          sources += [ "${base_target_outdir}/${_companion_file}" ]
        }
      }
      outputs = [ "${root_out_dir}/{{source_file_part}}" ]
      deps = [ base_target ]
    }
    not_needed(invoker, "*")
  }
}
