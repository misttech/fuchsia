import("//build/bazel/bazel_action.gni")
import("//build/bazel/config/bazel_args.gni")
import("//build/rust/config.gni")

# Generate a JSON file that describes the Bazel arguments computed
# from bazel_args.gni. The content is parsed by regenerator to populate
# the workspace's .bazelrc file with matching --config entries.
generated_file("bazel_args_json") {
  if (is_host) {
    _config_name = "host"
  } else if (is_fuchsia) {
    _config_name = "fuchsia"
  } else {
    # This should not be necessary but just in case.
    _config_name = "${current_os}_${current_cpu}"
  }

  # LINT.IfChange(bazel_args_json_path)
  outputs = [ "$root_build_dir/bazel_args/${_config_name}.json" ]

  # LINT.ThenChange(//build/bazel/scripts/workspace_utils.py:bazel_args_json_path)
  contents = bazel_args
  output_conversion = "json"
}

generated_file("global_args.json") {
  outputs = [ "$root_build_dir/bazel_args/global_args.json" ]
  contents = {
    auto_refresh_compdb = bazel_auto_refresh_compdb
    rust_sysroot = rebased_rustc_prefix

    # Used by bazel_action_impl.py to extract the archives of packages listed
    # in `package_outputs`. Each such bazel_action() depends on the binary.
    package_tool = bazel_action_package_tool_rebased
  }
  output_conversion = "json"
}

# Generate a JSON file describing the list of default GN config() labels
# for various types of C++ and Rust targets.
generated_file("bazel_default_configs_json") {
  if (is_host) {
    _config_name = "host"
  } else if (is_fuchsia) {
    _config_name = "fuchsia"
  } else {
    _config_name = "${current_os}_${current_cpu}"
  }
  outputs = [ "$root_build_dir/bazel_default_configs/${_config_name}.json" ]
  output_conversion = "json"

  # LINT.IfChange(fdio_config)
  # Exclude //build/config/fuchsia:fdio_config because it injects a C++
  # library dependency (//sdk/lib/fdio) that cannot be attached to
  # cc_toolchain without forming a dependency cycle; fx_cc_binary() applies
  # it via build_flags instead. Add it first so the removal does not fail
  # when it is absent (e.g. for host toolchains).
  default_executable_configs += [ "//build/config/fuchsia:fdio_config" ]
  default_executable_configs -= [ "//build/config/fuchsia:fdio_config" ]

  # LINT.ThenChange(//build/bazel/rules/cc/fx_cc_binary.bzl:fdio_config)

  _common_configs = filter_exclude(default_common_binary_configs,
                                   [
                                     "//build/config:executable_config",
                                     "//build/config:shared_library_config",
                                   ])

  # Keep these definitions in sync with the set_defaults() calls in
  # //build/config/BUILDCONFIG.gn
  contents = {
    # LINT.IfChange(DefaultConfigsJsonSchema)

    # List of configs that apply to all C++ targets
    cxx_common = _common_configs

    # List of extra configs that apply to C++ executables.
    cxx_executable_extra =
        filter_exclude(default_executable_configs, _common_configs)

    # List of extra configs that apply to C++ shared libraries.
    cxx_shared_library_extra =
        filter_exclude(default_shared_library_configs, _common_configs)

    # List of configs that apply to all Rust targets.
    rust_common = _common_configs

    # List of extra configs that apply to Rust executables.
    rust_executable_extra = []

    # List of extra configs that apply to Rust shared libraries.
    rust_shared_library_extra = []

    # LINT.ThenChange(//build/bazel/scripts/bazel_build_flags.py:DefaultConfigsJsonSchema)
  }
}
