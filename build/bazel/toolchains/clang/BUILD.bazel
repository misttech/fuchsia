    actual = "@prebuilt_clang//:asan-sancov_variant",
    visibility = ["@fuchsia_platform_sysroot//:__pkg__"],
)

alias(
    name = "asan-ubsan_variant",
    actual = "@prebuilt_clang//:asan-ubsan_variant",
    visibility = ["@fuchsia_platform_sysroot//:__pkg__"],
)

alias(
    name = "hwasan-ubsan_variant",
    actual = "@prebuilt_clang//:hwasan-ubsan_variant",
    visibility = ["@fuchsia_platform_sysroot//:__pkg__"],
)

alias(
    name = "ubsan_variant",
