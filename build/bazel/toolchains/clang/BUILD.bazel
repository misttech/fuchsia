load("@fuchsia_clang//:generated_constants.bzl", clang_constants = "constants")
load("@fuchsia_rules_common//debug_symbols:debug_symbols.bzl", "fuchsia_debug_symbols")
load(
    "@fuchsia_rules_common//packages:clang_package_resources.bzl",
    "get_clang_package_resources",
)
load(
    "@fuchsia_rules_common//packages:resources.bzl",
    "fuchsia_package_resource_group",
)
load(":toolchains.bzl", "define_fuchsia_api_level_info")

package(default_applicable_licenses = ["//:license"])

define_fuchsia_api_level_info(name = "_fuchsia_api_level_info")

fuchsia_debug_symbols(
    name = "debug_symbols",
    build_id_dirs = ["@fuchsia_clang//:lib/debug/.build-id"],
    source_search_root = "@fuchsia_clang//:BUILD.bazel",
    visibility = ["//:__subpackages__"],
)

_clang_package_resources = get_clang_package_resources(
    clang_repo_prefix = "@fuchsia_clang//",
    lib_clang_internal_dir = clang_constants.lib_clang_internal_dir,
    supported_cpus = [
        "arm64",
        "riscv64",
        "x64",
    ],
)

fuchsia_package_resource_group(
    name = "libcxx_resources",
    srcs = select(_clang_package_resources.libcxx_srcs_select_map),
    dest = select(_clang_package_resources.libcxx_dest_select_map),
    strip_prefix = select(_clang_package_resources.libcxx_strip_prefix_select_map),
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = ["//:__subpackages__"],
)

fuchsia_package_resource_group(
    name = "sanitizer_resources",
    srcs = select(_clang_package_resources.sanitizers_srcs_select_map),
    dest = select(_clang_package_resources.sanitizers_dest_select_map),
    strip_prefix = select(_clang_package_resources.sanitizers_strip_prefix_select_map),
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = ["//:__subpackages__"],
)

# @prebuilt_clang is bootstrapped lazily at Bazel fetch/analysis time via a
# repository_rule (`use_repo_rule` in toplevel.MODULE.bazel) rather than a
# pre-generated Bzlmod module with a MODULE.bazel file.
#
# Repositories defined via `bazel_dep` + `local_path_override` (such as
# @fuchsia_platform_sysroot) have isolated Bzlmod repository mappings and cannot
# `bazel_dep` on or directly reference root-module `use_repo_rule` repositories
# like `@prebuilt_clang`. Exposing these aliases in the root module (`@@//`)
# allows `local_path_override` repositories to select on `@prebuilt_clang`'s
# sanitizer variant config_settings via `@@//build/bazel/toolchains/clang:...`.
# LINT.IfChange(sysroot_variants)
alias(
    name = "novariant",
    actual = "@prebuilt_clang//:novariant",
    visibility = ["@fuchsia_platform_sysroot//:__pkg__"],
)

alias(
    name = "asan_variant",
    actual = "@prebuilt_clang//:asan_variant",
    visibility = ["@fuchsia_platform_sysroot//:__pkg__"],
)

alias(
    name = "hwasan_variant",
    actual = "@prebuilt_clang//:hwasan_variant",
    visibility = ["@fuchsia_platform_sysroot//:__pkg__"],
)

alias(
