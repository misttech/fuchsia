"""Top level BUILD.bazel in the @fuchsia_rust_toolchain repository."""

load("@//build/bazel/versioning:rustc_api_level.bzl", "get_rustc_api_level_flags")
load("@fuchsia_build_config//:defs.bzl", "build_config")
load("@fuchsia_rules_common//build_flags:toolchain.bzl", "rust_toolchain_with_build_flags")
load("@rules_rust//rust:toolchain.bzl", "rust_stdlib_filegroup", "rust_toolchain")
load("@rules_rust//rust/private:lto.bzl", "rust_lto_flag")
load("//:generated_constants.bzl", rust_constants = "constants")

# LTO flags for Rust are managed via build_flags() in //build/config/lto.
# Setting @rules_rust's LTO mode to "manual" prevents it from passing
# `-Cembed-bitcode=no` by default, which conflicts with `-Clto=*`.
rust_lto_flag(
    name = "lto_manual",
    build_setting_default = "manual",
)

host_os = build_config.host_os

host_arch = build_config.host_arch

host_triple = build_config.host_target_triple

# Fuchsia binaries are linked with -Cprefer-dynamic, so they need the prebuilt
# libstd shared library at runtime. Expose it per CPU so that packaging rules
# can select the right one. The file name embeds a hash that changes on every
# toolchain roll, hence the generated constants.
[
    filegroup(
        name = "libstd_dist_" + cpu,
        srcs = [dist],
        visibility = ["//visibility:public"],
    )
    for cpu, dist in rust_constants.libstd_dist.items()
]

# Debug symbols for the prebuilt runtime libraries above, laid out as a
# .build-id directory in the same way as the prebuilt Clang toolchain.
#
# The directory itself is exported, rather than a glob of its content, because
# FuchsiaDebugSymbolInfo consumers expect .build-id directories (e.g.
# `ffx debug symbol-index add` rejects individual files). Bazel tracks the
# content of source directories used as action inputs.
#
# BUILD.bazel is used as the source search root for these debug symbols.
exports_files([
    "BUILD.bazel",
    "lib/debug/.build-id",
])

exports_files(
    [
        "bin/cargo",
        "bin/rustc",
    ],
    visibility = ["@//tools/cargo-gnaw/tests:__pkg__"],
)

# LINT.IfChange
_HOST_DEBUG_INFO = {
    "dbg": "2",
    "fastbuild": "1",  # default "0", i.e. no symbols.
    "opt": "1",  # default "0", i.e. no symbols.
}

_HOST_STRIP_LEVEL = {
    "dbg": "none",
    "fastbuild": "none",
    "opt": "none",
}

# Fuchsia binaries are always built with debug info, which is later extracted
# into a .build-id directory and strips the copy from the packaged ELF by fx_package.
# This matches GN, where //build/config:default_debuginfo (which selects
# //build/config:debuginfo_debug by default) is applied to every Fuchsia target
# regardless of the optimization level.
_TARGET_DEBUG_INFO = {
    "dbg": "2",
    "fastbuild": "2",
    "opt": "2",
}

_TARGET_STRIP_LEVEL = {
    "dbg": "none",
    "fastbuild": "none",
    "opt": "none",
}
# LINT.ThenChange(//build/bazel/debug_symbols/README.md)

_DEFAULT_COMMON_EXEC_RUST_FLAGS = [
    # GN: //build/config/rust:next_solver
    # TODO(https://fxbug.dev/556328773): Use next generation trait solver after compile time regression is addressed.
    "-Znext-solver=coherence",

    # GN: //build/config:stack-size-section
    "-Zemit-stack-sizes",
    "-Clink-arg=-Wl,-mllvm=--stack-size-section",

    # GN: //build/config:rust-depinfo
    "-Zbinary-dep-depinfo",

    # GN: //build/config/rust:default_debug_assertions
    #
    # TODO(jayzhuang): Enable debug-assertions for non-release builds.
    "-Cdebug-assertions=no",

    # GN: //build/config:linker_gc.compiler
    # `-Zfunction-sections` flag controls both text and data sections.
    "-Zfunction-sections",

    # GN: //build/config:relative_paths
    #
    # `-Zremap-cwd-prefix` ensures that absolute paths do not leak into
    # outputs for universal reproducibility while keeping the command line
    # free of absolute paths for remote caching benefit.
    # Available since: https://github.com/rust-lang/rust/pull/87320
    "-Zremap-cwd-prefix=.",

    # GN: //build/config/rust:no_features
    "-Zallow-features=",
    "-Cdefault-linker-libraries",
]

# Lint flags are excluded from _DEFAULT_COMMON_EXEC_RUST_FLAGS because
# @rules_rust builds internal exec tools (e.g. process_wrapper) without
# --cap-lints=allow, which would fail under -Wrust-2018-idioms -Dwarnings.
_DEFAULT_COMMON_RUST_FLAGS = _DEFAULT_COMMON_EXEC_RUST_FLAGS + [
    # GN: //build/config/rust:2018_idioms
    "-Wrust-2018-idioms",

    # GN: //build/config:werror
    "-Dwarnings",
]

# TODO(https://fxbug.dev/529296820): Currently, using the "common" subset of default
# build flags from @fuchsia_rules_common//build_flags:toolchain_type is sufficient
# because the GN default config lists for Rust are identical for all crate types
# (executables vs. shared libraries). If different flags per crate type become
# necessary in the future, rust_toolchain_with_build_flags will need to populate
# extra_rustc_flags_for_crate_types.
_EXTRA_HOST_RUST_FLAGS = _DEFAULT_COMMON_RUST_FLAGS
_EXTRA_HOST_EXEC_RUST_FLAGS = _DEFAULT_COMMON_EXEC_RUST_FLAGS

_EXTRA_TARGET_RUST_FLAGS = _DEFAULT_COMMON_RUST_FLAGS + [
    # GN: //build/config:frame_pointers
    "-Cforce-frame-pointers",

    # GN: //build/config/rust:panic_abort
    #
    # The prebuilt Rust standard library for Fuchsia targets is built with
    # panic=abort, so everything linked against it must agree. Without this,
    # linking any Fuchsia executable or test fails with "the crate `std`
    # requires panic strategy `abort`".
    #
    # -Zpanic_abort_tests is required for #[test] harnesses, which default to
    # unwind even when the rest of the crate graph uses abort.
    "-Cpanic=abort",
    "-Cforce-unwind-tables=yes",
    "-Zpanic_abort_tests",

    # GN: //build/config/fuchsia:dynamic_rust_standard_library
    #
    # Fuchsia links the Rust standard library dynamically so a single copy of
    # libstd is shared by all Rust components in a package set.
    "-Cprefer-dynamic",

    # GN: //build/config/fuchsia:large_rust_stack
    #
    # Rust's default main thread stack is too small for several in-tree
    # components, so GN raises it to 2 MiB globally.
    #
    # GN spells this "-Clink-args=-zstack-size=0x200000" because it links Rust
    # with -Clinker=.../bin/lld, passing raw linker flags. rules_rust links
    # through the clang driver instead, which rejects the joined -z form, so
    # the flag has to be routed with -Wl,.
    "-Clink-arg=-Wl,-z,stack-size=0x200000",

    # No GN equivalent, as GN links Rust with lld directly.
    #
    # rustc passes -pie to the linker for Fuchsia executables, but clang's
    # Fuchsia driver always adds -pie itself and never claims the one it is
    # given, so every link prints "argument unused during compilation: '-pie'"
    # through rustc's linker_messages lint. The output is PIE either way.
    #
    # TODO(https://fxbug.dev/567308599): Remove once the clang Fuchsia driver
    # claims -pie, or GN and Bazel converge on how Rust is linked.
    "-Clink-arg=-Wno-unused-command-line-argument",

    # GN: //build/config/rust:v0_symbol_mangling
    #
    # TODO(https://fxbug.dev/421888626): GN gates this on the
    # `rust_v0_symbol_mangling` build arg, which defaults to true. Propagate
    # that setting instead of hardcoding the default here.
    "-Csymbol-mangling-version=v0",
]

filegroup(
    name = "rustc_lib",
    srcs = glob(
        ["lib/*.so"],
        allow_empty = True,  # This is empty on Mac builders.
    ),
    visibility = ["@//tools/cargo-gnaw/tests:__pkg__"],
)

# Define the linux_x64 Rust toolchain.

rust_stdlib_filegroup(
    name = "rust_std_linux_x64",
    srcs = glob(["lib/rustlib/x86_64-unknown-linux-gnu/lib/*"]),
)

rust_toolchain(
    name = "rust_linux_x64_toolchain_base",
    binary_ext = "",
    clippy_driver = "//:bin/clippy-driver",

    # Ensure debug symbols are preserved even with --compilation_mode is
    # set to 'fastbuild' or 'opt', as there are no separate actions to produce
    # stripped and unstripped binaries in rules_rust.
    #
    # debug_info controls whether debug info is generated during compilation,
    # and strip_level controls whether they are removed during linking.
    debug_info = _HOST_DEBUG_INFO,
    dylib_ext = ".so",
    exec_triple = "x86_64-unknown-linux-gnu",
    extra_exec_rustc_flags = _EXTRA_HOST_EXEC_RUST_FLAGS,
    extra_rustc_flags = _EXTRA_HOST_RUST_FLAGS,
    llvm_cov = "@fuchsia_clang//:bin/llvm-cov",
    llvm_profdata = "@fuchsia_clang//:bin/llvm-profdata",
    lto = "//:lto_manual",
    rust_doc = "//:bin/rustdoc",
    rust_std = "//:rust_std_linux_x64",
    rustc = "//:bin/rustc",
    rustc_lib = "//:rustc_lib",
    rustfmt = "//:bin/rustfmt",
    staticlib_ext = ".a",
    stdlib_linkflags = [
        "-lpthread",
        "-ldl",
    ],
    strip_level = _HOST_STRIP_LEVEL,
    target_triple = "x86_64-unknown-linux-gnu",
)

rust_toolchain_with_build_flags(
    name = "rust_linux_x64_toolchain",
    extra_rustc_flags = get_rustc_api_level_flags(),
    toolchain = ":rust_linux_x64_toolchain_base",
)

toolchain(
    name = "rust_linux_x64",
    exec_compatible_with = [
        build_config.host_platform_cpu_constraint,
        build_config.host_platform_os_constraint,
    ],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    toolchain = ":rust_linux_x64_toolchain",
    toolchain_type = "@rules_rust//rust:toolchain",
)

# Define the linux_arm64 Rust toolchain.

rust_stdlib_filegroup(
    name = "rust_std_linux_arm64",
    srcs = glob(["lib/rustlib/aarch64-unknown-linux-gnu/lib/*"]),
)

rust_toolchain(
    name = "rust_linux_arm64_toolchain_base",
    binary_ext = "",
    clippy_driver = "//:bin/clippy-driver",

    # Ensure debug symbols are preserved even with --compilation_mode is
    # set to 'fastbuild' or 'opt', as there are no separate actions to produce
    # stripped and unstripped binaries in rules_rust.
    #
    # debug_info controls whether debug info is generated during compilation,
    # and strip_level controls whether they are removed during linking.
    debug_info = _HOST_DEBUG_INFO,
    dylib_ext = ".so",
    exec_triple = "aarch64-unknown-linux-gnu",
    extra_exec_rustc_flags = _EXTRA_HOST_EXEC_RUST_FLAGS,
    extra_rustc_flags = _EXTRA_HOST_RUST_FLAGS,
    llvm_cov = "@fuchsia_clang//:bin/llvm-cov",
    llvm_profdata = "@fuchsia_clang//:bin/llvm-profdata",
    lto = "//:lto_manual",
    rust_doc = "//:bin/rustdoc",
    rust_std = "//:rust_std_linux_arm64",
    rustc = "//:bin/rustc",
    rustc_lib = "//:rustc_lib",
    rustfmt = "//:bin/rustfmt",
    staticlib_ext = ".a",
    stdlib_linkflags = [
        "-lpthread",
        "-ldl",
    ],
    strip_level = _HOST_STRIP_LEVEL,
    target_triple = "aarch64-unknown-linux-gnu",
)

rust_toolchain_with_build_flags(
    name = "rust_linux_arm64_toolchain",
    extra_rustc_flags = get_rustc_api_level_flags(),
    toolchain = ":rust_linux_arm64_toolchain_base",
)

toolchain(
    name = "rust_linux_arm64",
    exec_compatible_with = [
        build_config.host_platform_cpu_constraint,
        build_config.host_platform_os_constraint,
    ],
    target_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
    toolchain = ":rust_linux_arm64_toolchain",
    toolchain_type = "@rules_rust//rust:toolchain",
)

# Define the Fuchsia/x64 Rust toolchain

rust_stdlib_filegroup(
    name = "rust_std_fuchsia_x64",
    srcs = glob(["lib/rustlib/x86_64-unknown-fuchsia/lib/*"]) + [
        "@//build/config/profile:llvm_profile_counter_bias.ld",
    ],
)

rust_toolchain(
    name = "rust_fuchsia_x64_toolchain_base",
    binary_ext = "",
    clippy_driver = "//:bin/clippy-driver",

    # Keep debug symbols in the linked binary regardless of --compilation_mode.
    # fx_package extracts them into a .build-id directory and strips the copy
    # that goes into the package, mirroring how GN handles Fuchsia binaries.
    debug_info = _TARGET_DEBUG_INFO,
    dylib_ext = ".so",
    exec_triple = "x86_64-unknown-fuchsia",
    extra_rustc_flags = _EXTRA_TARGET_RUST_FLAGS,
    llvm_cov = "@fuchsia_clang//:bin/llvm-cov",
    llvm_profdata = "@fuchsia_clang//:bin/llvm-profdata",
    lto = "//:lto_manual",
    rust_doc = "//:bin/rustdoc",
    rust_std = "//:rust_std_fuchsia_x64",
    rustc = "//:bin/rustc",
    rustc_lib = "//:rustc_lib",
    rustfmt = "//:bin/rustfmt",
    staticlib_ext = ".a",
    stdlib_linkflags = [],
    strip_level = _TARGET_STRIP_LEVEL,
    target_triple = "x86_64-unknown-fuchsia",
)

rust_toolchain_with_build_flags(
    name = "rust_fuchsia_x64_toolchain",
    extra_rustc_flags = get_rustc_api_level_flags(),
    toolchain = ":rust_fuchsia_x64_toolchain_base",
)

toolchain(
    name = "rust_fuchsia_x64",
    exec_compatible_with = [
        build_config.host_platform_cpu_constraint,
        build_config.host_platform_os_constraint,
    ],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:fuchsia",
    ],
    toolchain = ":rust_fuchsia_x64_toolchain",
    toolchain_type = "@rules_rust//rust:toolchain",
)

# Define the Fuchsia/arm64 Rust toolchain

rust_stdlib_filegroup(
    name = "rust_std_fuchsia_arm64",
    srcs = glob(["lib/rustlib/aarch64-unknown-fuchsia/lib/*"]) + [
        "@//build/config/profile:llvm_profile_counter_bias.ld",
    ],
)

rust_toolchain(
    name = "rust_fuchsia_arm64_toolchain_base",
    binary_ext = "",
    clippy_driver = "//:bin/clippy-driver",

    # Keep debug symbols in the linked binary regardless of --compilation_mode.
    # fx_package extracts them into a .build-id directory and strips the copy
    # that goes into the package, mirroring how GN handles Fuchsia binaries.
    debug_info = _TARGET_DEBUG_INFO,
    dylib_ext = ".so",
    exec_triple = "aarch64-unknown-fuchsia",
    extra_rustc_flags = _EXTRA_TARGET_RUST_FLAGS + [
        # See https://fuchsia.dev/fuchsia-src/concepts/kernel/shadow_call_stack#use_in_zircon_fuchsia
        # Rust compilers are detecting incompatible ABIs in rust builds. Any Rust
        # code that is targeted for ARM64 Fuchsia must be compiled with shadow
        # call stack to avoid build failures due to ABI mismatch. This also
        # requires setting fixed-x18, which is the SCS register on ARM64 Fuchsia.
        "-Zsanitizer=shadow-call-stack",
        "-Zfixed-x18",
    ],
    llvm_cov = "@fuchsia_clang//:bin/llvm-cov",
    llvm_profdata = "@fuchsia_clang//:bin/llvm-profdata",
    lto = "//:lto_manual",
    rust_doc = "//:bin/rustdoc",
    rust_std = "//:rust_std_fuchsia_arm64",
    rustc = "//:bin/rustc",
    rustc_lib = "//:rustc_lib",
    rustfmt = "//:bin/rustfmt",
    staticlib_ext = ".a",
    stdlib_linkflags = [],
    strip_level = _TARGET_STRIP_LEVEL,
    target_triple = "aarch64-unknown-fuchsia",
)

rust_toolchain_with_build_flags(
    name = "rust_fuchsia_arm64_toolchain",
    extra_rustc_flags = get_rustc_api_level_flags(),
    toolchain = ":rust_fuchsia_arm64_toolchain_base",
)

toolchain(
    name = "rust_fuchsia_arm64",
    exec_compatible_with = [
        build_config.host_platform_cpu_constraint,
        build_config.host_platform_os_constraint,
    ],
    target_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:fuchsia",
    ],
    toolchain = ":rust_fuchsia_arm64_toolchain",
    toolchain_type = "@rules_rust//rust:toolchain",
)

# Define the Fuchsia/riscv64 Rust toolchain

rust_stdlib_filegroup(
    name = "rust_std_fuchsia_riscv64",
    # See https://doc.rust-lang.org/rustc/platform-support/riscv64gc-unknown-linux-gnu.html
    # which this uses a "riscv64gc" prefix, while C++ uses only "riscv64" for the same
    # ABI.
    srcs = glob(["lib/rustlib/riscv64gc-unknown-fuchsia/lib/*"]) + [
        "@//build/config/profile:llvm_profile_counter_bias.ld",
    ],
)

rust_toolchain(
    name = "rust_fuchsia_riscv64_toolchain_base",
    binary_ext = "",
    clippy_driver = "//:bin/clippy-driver",

    # Keep debug symbols in the linked binary regardless of --compilation_mode.
    # fx_package extracts them into a .build-id directory and strips the copy
    # that goes into the package, mirroring how GN handles Fuchsia binaries.
    debug_info = _TARGET_DEBUG_INFO,
    dylib_ext = ".so",
    exec_triple = "riscv64gc-unknown-fuchsia",
    extra_rustc_flags = _EXTRA_TARGET_RUST_FLAGS + [
        # See https://fuchsia.dev/fuchsia-src/concepts/kernel/shadow_call_stack#use_in_zircon_fuchsia
        # Rust compilers are detecting incompatible ABIs in rust builds. Any Rust
        # code that is targeted for RISC-V64 Fuchsia must be compiled with shadow
        # call stack to avoid build failures due to ABI mismatch.
        "-Zsanitizer=shadow-call-stack",

        # TODO(https://fxbug.dev/501183733) remove once rustc's frontend does this automatically
        "-Ctarget-feature=+v",
    ],
    llvm_cov = "@fuchsia_clang//:bin/llvm-cov",
    llvm_profdata = "@fuchsia_clang//:bin/llvm-profdata",
    lto = "//:lto_manual",
    rust_doc = "//:bin/rustdoc",
    rust_std = "//:rust_std_fuchsia_riscv64",
    rustc = "//:bin/rustc",
    rustc_lib = "//:rustc_lib",
    rustfmt = "//:bin/rustfmt",
    staticlib_ext = ".a",
    stdlib_linkflags = [],
    strip_level = _TARGET_STRIP_LEVEL,
    target_triple = "riscv64gc-unknown-fuchsia",
)

rust_toolchain_with_build_flags(
    name = "rust_fuchsia_riscv64_toolchain",
    extra_rustc_flags = get_rustc_api_level_flags(),
    toolchain = ":rust_fuchsia_riscv64_toolchain_base",
)

toolchain(
    name = "rust_fuchsia_riscv64",
    exec_compatible_with = [
        build_config.host_platform_cpu_constraint,
        build_config.host_platform_os_constraint,
    ],
    target_compatible_with = [
        "@platforms//cpu:riscv64",
        "@platforms//os:fuchsia",
    ],
    toolchain = ":rust_fuchsia_riscv64_toolchain",
    toolchain_type = "@rules_rust//rust:toolchain",
)
