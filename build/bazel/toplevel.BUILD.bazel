"""
This is the top-level BUILD.bazel for the Fuchsia platform build.
See //build/bazel/README.md for details about this file.
"""

load("@fuchsia_build_config//:defs.bzl", "build_config")
load(
    "@rules_fuchsia//fuchsia:defs.bzl",
    "fuchsia_devicetree_toolchain_info",
)
load("@rules_license//rules:license.bzl", "license")
load(
    "//build/bazel/toolchains:linux_sysroot.bzl",
    "linux_sysroot_headers",
    "linux_sysroot_libs",
)

# This exclude is needed as there are files in the folder that have space
# in the filename. Bazel does not support spaces in filename.
_python_prebuilt_files = glob(
    ["prebuilt/third_party/python3/%s/**/*" % build_config.host_tag],
    exclude = ["**/* *"],
)

# Used by host_shac_test(), which runs shac checks hermetically.
exports_files(
    [
        "prebuilt/tools/shac/shac",
        "shac.textproto",
    ],
    visibility = ["//build/bazel/rules/host_tests:__pkg__"],
)

# Executed by some shac tests, rather than mocked.
exports_files(
    glob(["prebuilt/third_party/keep-sorted/*/keep-sorted"]),
    visibility = ["//scripts/shac/tests:__pkg__"],
)

exports_files(
    # Export these files for the benefit of the //build/bazel/toolchains/clang package.
    glob(["prebuilt/third_party/clang/**"]) +
    glob(["prebuilt/third_party/sysroot/linux/**"]) +

    # Used by code generators in vendor/google:
    glob(["prebuilt/third_party/gn/*/gn"]) +
    glob(["prebuilt/third_party/buildifier/*/buildifier"]) +

    # Used by //build/bazel/toolchains/python:
    _python_prebuilt_files +

    # vbmeta tools, keys and metadata.
    [
        "third_party/android/platform/external/avb/avbtool.py",
        "third_party/android/platform/external/avb/test/data/testkey_atx_psk.pem",
        "third_party/android/platform/external/avb/test/data/atx_metadata.bin",

        # This test key is used for Verified Booting in the context of Android
        # protected VMs, which do not support the ATX format.
        "third_party/android/platform/external/avb/test/data/testkey_rsa4096.pem",
    ] +
    # Bootloader images used in partition configs for product bundles.
    glob(
        ["prebuilt/vendor/amlogic/*/firmware/**/*"],
        allow_empty = True,  # This could be empty on some infra builders.
    ) +

    # OSPO license verification tool
    glob(
        ["prebuilt/third_party/ospo/licenseclassifier/*/identify_license"],
        allow_empty = True,  # This could be empty on some infra builders.
    ) +

    # DTC tool for devicetree compile
    glob(["prebuilt/third_party/dtc/**/*"]) +

    # vim3 bootloader
    ["prebuilt/third_party/firmware/vim3/u-boot.bin.unsigned"] +

    # zoneinfo resources
    glob(["prebuilt/third_party/zoneinfo/**"]) +
    glob(["prebuilt/third_party/tzres/*"]) +

    # prebuilt drivers
    glob(
        ["prebuilt/vendor/google/drivers/**/*.far"],
        allow_empty = True,  # This could be empty on some infra builders.
    ) +

    # mcu firmwares
    glob(
        ["prebuilt/mcu/firmware/**/*"],
        allow_empty = True,  # This could be empty on some infra builders.
    ) +

    # prebuilt firmware
    glob(
        ["prebuilt/vendor/google_devices/*/prebuilts/firmware/**/*"],
        allow_empty = True,  # This could be empty on some infra builders.
    ) +

    # audio config files
    glob(
        ["prebuilt/vendor/google_devices/*/prebuilts/audio/**/*"],
        allow_empty = True,  # This could be empty on some infra builders.
    ) +

    # build/info
    [
        "fuchsia_build_generated/git",
        "fuchsia_build_generated/jiri_snapshot.xml",
    ] +
    [
        "fuchsia_build_generated/fuchsia_in_tree_idk.hash",
    ] +

    # ICU git commit info, compiled into //src/lib/assembly/config_schema.
    [
        "fuchsia_build_generated/icu_build_config.json",
    ] +

    # Format files for FIDL/Zither
    [
        ".clang-format",
        "rustfmt.toml",
    ] +

    # MILESTONE file, used in //src/developer/ffx/lib/sdk.
    [
        "integration/MILESTONE",
    ] +

    # Unicode data, used in //src/storage/fxfs/unicode.
    ["prebuilt/third_party/ucd/UCD.zip"] +

    # end of list.
    [],
)

linux_sysroot_headers(
    name = "linux_sysroot_headers",
)

linux_sysroot_libs(
    name = "linux_sysroot_libs_x64",
    sysroot_arch = "x86_64",
)

linux_sysroot_libs(
    name = "linux_sysroot_libs_arm64",
    sysroot_arch = "aarch64",
)

filegroup(
    name = "prebuilt_python_files",
    srcs = _python_prebuilt_files,
    visibility = [
        "//build/bazel/toolchains/python:__pkg__",
        # Used by host_shac_test() targets that execute Python-based shac
        # checks, which invoke prebuilt/third_party/python3 directly via
        # ctx.os.exec() rather than using a Bazel py_* rule.
        "//scripts/shac/tests:__pkg__",
    ],
)

filegroup(
    name = "cobalt_config_files",
    srcs = glob(["third_party/cobalt_config/**"]),
    visibility = ["//visibility:public"],
)

# AVB test key, compiled into //src/lib/assembly/test_keys with include_str!().
# third_party/android/platform/external/avb has no BUILD.bazel file, so this
# target gives Bazel packages a root package label without a slash.
filegroup(
    name = "avb_testkey_atx_psk",
    srcs = ["third_party/android/platform/external/avb/test/data/testkey_atx_psk.pem"],
    visibility = ["//src/lib/assembly/test_keys:__pkg__"],
)

# Perfetto .proto files used by //src/starnix/modules/perfetto_consumer/lib/perfetto.
# third_party/perfetto has no Fuchsia BUILD.bazel file, so these filegroups give
# Bazel packages root package labels without a slash.
filegroup(
    name = "perfetto_ipc_consumer_port_proto",
    srcs = ["third_party/perfetto/protos/perfetto/ipc/consumer_port.proto"],
    visibility = ["//src/starnix/modules/perfetto_consumer/lib/perfetto:__pkg__"],
)

filegroup(
    name = "perfetto_ipc_producer_port_proto",
    srcs = ["third_party/perfetto/protos/perfetto/ipc/producer_port.proto"],
    visibility = ["//src/starnix/modules/perfetto_consumer/lib/perfetto:__pkg__"],
)

filegroup(
    name = "perfetto_ipc_wire_protocol_proto",
    srcs = ["third_party/perfetto/protos/perfetto/ipc/wire_protocol.proto"],
    visibility = ["//src/starnix/modules/perfetto_consumer/lib/perfetto:__pkg__"],
)

filegroup(
    name = "perfetto_trace_proto",
    srcs = ["third_party/perfetto/protos/perfetto/trace/perfetto_trace.proto"],
    visibility = ["//src/starnix/modules/perfetto_consumer/lib/perfetto:__pkg__"],
)

filegroup(
    name = "frameworks_native_trace_packet_proto",
    srcs = ["third_party/perfetto/protos/third_party/android/frameworks/native/tracing/frameworks_native_trace_packet.proto"],
    visibility = ["//src/starnix/modules/perfetto_consumer/lib/perfetto:__pkg__"],
)

filegroup(
    name = "perfetto_proto_files",
    srcs = glob(["third_party/perfetto/protos/**/*.proto"]),
    visibility = ["//src/starnix/modules/perfetto_consumer/lib/perfetto:__pkg__"],
)

fuchsia_devicetree_toolchain_info(
    name = "fuchsia_devicetree_toolchain_info",
    dtc = "//:prebuilt/third_party/dtc/%s/dtc" % build_config.host_tag,
)

toolchain(
    name = "fuchsia_sdk_devicetree_toolchain",
    toolchain = ":fuchsia_devicetree_toolchain_info",
    toolchain_type = "@rules_fuchsia//fuchsia:devicetree_toolchain_type",
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-2-Clause"],
    license_text = "LICENSE",
    visibility = ["//visibility:public"],
)
