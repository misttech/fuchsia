import("//build/components.gni")
import("//build/rust/rustc_library.gni")

rustc_library("debug_telemetry") {
  edition = "2024"
  with_unit_tests = true

  deps = [ "//sdk/rust/zx" ]

  test_deps = [ "//src/lib/fuchsia" ]

  configs += [ "//build/config/rust/lints:clippy_warn_all" ]

  sources = [ "src/lib.rs" ]
}

fuchsia_unittest_package("debug_telemetry_tests") {
  deps = [ ":debug_telemetry_test" ]
}

group("tests") {
  testonly = true
  deps = [ ":debug_telemetry_tests" ]
}
