import("//build/components.gni")
import("//build/rust/rustc_library.gni")
import("//tools/cmc/build/expect_includes.gni")

expect_includes("diagnostic_overlay_includes") {
  includes = [ "meta/client.shard.cml" ]
}

rustc_library("diagnostic_overlay") {
  edition = "2024"
  with_unit_tests = true

  deps = [
    ":diagnostic_overlay_includes",
    "//sdk/fidl/fuchsia.ui.input:fuchsia.ui.input_rust",
    "//sdk/fidl/fuchsia.ui.policy:fuchsia.ui.policy_rust",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
  ]

  test_deps = [ "//src/lib/fuchsia" ]

  configs += [ "//build/config/rust/lints:clippy_warn_all" ]

  sources = [
    "src/lib.rs",
    "src/overlay.rs",
  ]
}

fuchsia_unittest_package("diagnostic_overlay_tests") {
  deps = [ ":diagnostic_overlay_test" ]
}

group("tests") {
  testonly = true
  deps = [ ":diagnostic_overlay_tests" ]
}
