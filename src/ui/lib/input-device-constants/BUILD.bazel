load("//build/bazel/rules/rust:defs.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "lib",
    srcs = ["src/lib.rs"],
    crate_name = "input_device_constants",
    edition = "2024",
    visibility = [
        "//src/lib/assembly/config_schema:__pkg__",
        "//src/ui/lib/input_pipeline:__pkg__",
    ],
    with_unit_tests = True,
    deps = [
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:schemars",
        "//third_party/rust_crates/vendor:serde",
    ],
)
