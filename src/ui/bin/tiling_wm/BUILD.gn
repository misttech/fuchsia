import("//build/bazel/bazel_test_suite.gni")
import("//build/components.gni")

# Kept in GN because `bazel2gn` skips `fx_package` and GN session packages
# (`//products/terminal/terminal_session`,
# `//products/workbench/workbench_session`) include `//src/ui/bin/tiling_wm` in
# `subpackages`.
fuchsia_package("tiling_wm") {
  package_name = "tiling_wm"
  deps = [
    ":tiling_wm_component",
    ":tiling_wm_component_manifest",
  ]
}

bazel_test_suite("bazel_tests") {
  target_tests = [ "//src/ui/bin/tiling_wm:tiling_wm_tests" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    ":tiling_wm_tests",
  ]
}

