    {
        "parent": "pdev",
        "tests": [
            {
                "name": "Match devicetree",
                "expected": "match",
                "device": {
                    "fuchsia.BIND_PLATFORM_DEV_VID": "fuchsia.platform.BIND_PLATFORM_DEV_VID.GENERIC",
                    "fuchsia.BIND_PLATFORM_DEV_DID": "fuchsia.platform.BIND_PLATFORM_DEV_DID.DEVICETREE",
                    "fuchsia.devicetree.FIRST_COMPATIBLE": "\"fuchsia,gpio-buttons\""
                }
            }
        ]
    },
    {
        "parent": "gpio-init",
        "tests": [
            {
                "name": "Match",
                "expected": "match",
                "device": {
                    "fuchsia.BIND_INIT_STEP": "fuchsia.gpio.BIND_INIT_STEP.GPIO"
                }
            }
        ]
    },
    {
        "parent": "mic-privacy",
        "tests": [
            {
                "name": "MatchMicPrivacy",
                "expected": "match",
                "device": {
                    "fuchsia.Service": "\"fuchsia.hardware.gpio.Service\"",
                    "fuchsia.NAME": "\"MIC_MUTE\""
                }
            },
            {
                "name": "MicWrongGpioFunction",
                "expected": "abort",
                "device": {
                    "fuchsia.Service": "\"fuchsia.hardware.gpio.Service\"",
                    "fuchsia.NAME": "\"NOT_A_KNOWN_FUNCTION\""
                }
            }
        ]
    },
