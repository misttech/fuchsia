{
    name: "hid-input-report",
    include: [ "driver_component/driver.shard.cml" ],
    program: {
        colocate: "true",
        bind: {
            service: "fuchsia.hardware.input.Service",
            one_of: [
                {
                    rules: { "fuchsia.hid.CONSUMER__CONSUMER_CONTROL": true },
                },
                {
                    rules: { "fuchsia.hid.DIGITIZER__TOUCH_PAD": true },
                },
                {
                    rules: { "fuchsia.hid.DIGITIZER__TOUCH_SCREEN": true },
                },
                {
                    rules: { "fuchsia.hid.DIGITIZER__TOUCH_SCREEN_CONFIGURATION": true },
                },
                {
                    rules: { "fuchsia.hid.GENERIC_DESKTOP__KEYBOARD": true },
                },
                {
                    rules: { "fuchsia.hid.GENERIC_DESKTOP__MOUSE": true },
                },
                {
                    rules: { "fuchsia.hid.SENSOR": true },
                },
            ],
        },
    },
    capabilities: [
        { service: "fuchsia.input.report.Service" },
    ],
    use: [
        {
            name: "default",
            service: "fuchsia.hardware.input.Service",
            generate_bind_rule: false,
        },
    ],
    expose: [
        {
            service: "fuchsia.input.report.Service",
            from: "self",
        },
    ],
}
