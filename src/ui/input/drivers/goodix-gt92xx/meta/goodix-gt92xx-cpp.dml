{
    name: "goodix-gt92xx",
    composite_name: "gt92xx_touch",
    include: [ "//sdk/lib/driver/compat/compat.shard.cml" ],
    program: {
        compat: "driver/goodix-gt92xx-cpp.so",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        allowed_scheduler_roles: [ "fuchsia.ui.input.drivers.goodix-gt92xx.device" ],
    },
    capabilities: [
        { service: "fuchsia.input.report.Service" },
    ],
    use: [
        { protocol: "fuchsia.scheduler.RoleManager" },
        {
            name: "gpio-int",
            service: "fuchsia.hardware.gpio.Service",
            bind: {
                rules: { "fuchsia.NAME": "gpio-int" },
            },
        },
        {
            name: "i2c",
            service: "fuchsia.hardware.i2c.Service",
            primary: true,
            bind: {
                service: "fuchsia.hardware.i2c.Service",
                rules: { "fuchsia.NAME": "i2c" },
            },
        },
        {
            name: "gpio-reset",
            service: "fuchsia.hardware.gpio.Service",
            bind: {
                rules: { "fuchsia.NAME": "gpio-reset" },
            },
        },
        {
            name: "pdev",
            availability: "optional",
            bind: {
                compat: "goodix,gt92xx",
                vid: "fuchsia.platform.BIND_PLATFORM_DEV_VID.GENERIC",
            },
        },
        {
            name: "gpio-init-0",
            service: "fuchsia.gpio.Init",
            availability: "optional",
        },
    ],
    expose: [
        {
            service: "fuchsia.input.report.Service",
            from: "self",
        },
    ],
}
