import("//build/bind/bind.gni")
import("//build/cipd.gni")
import("//build/components.gni")
import("//build/drivers.gni")
import("//build/test.gni")

config_9364_path = "gt6853/goodix_cfg_group_fiti9364.bin"
config_9365_path = "gt6853/goodix_cfg_group_fiti9365.bin"
firmware_path = "gt6853/goodix_firmware.bin"

declare_args() {
  # Toggles between the C++ and Rust driver implementations.
  #
  # TODO(https://fxbug.dev/527194998): Remove the toggle after the Rust port is completed.
  # Valid values: "cpp", "rust"
  goodix_gt6853_driver_flavor = "cpp"
}

if (internal_access) {
  resource("config-9364") {
    sources = [ "//prebuilt/touch/$config_9364_path" ]
    outputs = [ "lib/firmware/$config_9364_path" ]
  }
  resource("config-9365") {
    sources = [ "//prebuilt/touch/$config_9365_path" ]
    outputs = [ "lib/firmware/$config_9365_path" ]
  }
  resource("firmware") {
    sources = [ "//prebuilt/touch/$firmware_path" ]
    outputs = [ "lib/firmware/$firmware_path" ]
  }
}

group("common") {
  public_deps = [
    "//sdk/fidl/fuchsia.hardware.gpio:fuchsia.hardware.gpio_cpp",
    "//sdk/fidl/fuchsia.input.report:fuchsia.input.report_cpp",
    "//sdk/fidl/fuchsia.mem:fuchsia.mem_cpp",
    "//sdk/lib/async-loop:async-loop-cpp",
    "//sdk/lib/async-loop:async-loop-default",
    "//src/devices/i2c/lib/i2c-channel-legacy",
    "//src/devices/lib/driver",
    "//src/devices/lib/driver:driver_runtime",
    "//src/graphics/display/lib/device-protocol-display",
    "//src/lib/ddk",
    "//src/lib/ddktl",
    "//src/ui/input/lib/hid",
    "//src/ui/input/lib/input-report-reader",
    "//zircon/system/ulib/fbl",
    "//zircon/system/ulib/fzl",
    "//zircon/system/ulib/inspect",
    "//zircon/system/ulib/sync",
    "//zircon/system/ulib/zircon-internal",
    "//zircon/system/ulib/zx",
  ]
}

driver_bind_rules("goodix-gt6853-bind") {
  rules = "meta/goodix-gt6853.bind"
  tests = "meta/goodix-gt6853-bind-test.json"
  deps = [
    "//sdk/fidl/fuchsia.hardware.gpio:fuchsia.hardware.gpio_bindlib",
    "//sdk/fidl/fuchsia.hardware.i2c:fuchsia.hardware.i2c_bindlib",
    "//sdk/fidl/fuchsia.hardware.pin:fuchsia.hardware.pin_bindlib",
    "//src/devices/bind/fuchsia",
    "//src/devices/bind/fuchsia.amlogic.platform.s905d3",
    "//src/devices/bind/fuchsia.goodix.platform",
    "//src/devices/bind/fuchsia.gpio",
    "//src/devices/bind/fuchsia.platform",
  ]
}

fuchsia_cc_driver("driver-cpp") {
  legacy = true
  output_name = "goodix-gt6853-cpp"
  sources = [
    "cpp/goodix-gt6853-nelson.cc",
    "cpp/goodix-gt6853.cc",
  ]
  configs += [
    "//build/config:all_source",
    "//build/config/fuchsia:enable_zircon_asserts",
  ]
  deps = [
    ":common",
    ":goodix-gt6853-bind",
  ]
  defines = [
    "GT6853_CONFIG_9364_PATH=\"$config_9364_path\"",
    "GT6853_CONFIG_9365_PATH=\"$config_9365_path\"",
    "GT6853_FIRMWARE_PATH=\"$firmware_path\"",
  ]
}

fuchsia_rust_driver("driver-rust") {
  edition = "2024"
  source_root = "rust/src/lib.rs"
  output_name = "goodix-gt6853-rust"
  with_unit_tests = true
  sources = [
    "rust/src/driver.rs",
    "rust/src/lib.rs",
  ]
  deps = [
    ":goodix-gt6853-bind",
    "//sdk/fidl/fuchsia.driver.framework:fuchsia.driver.framework_rust",
    "//sdk/lib/driver/component/rust",
    "//sdk/rust/zx",
    "//third_party/rust_crates:log",
  ]
}

fuchsia_driver_component("component-cpp") {
  info = "meta/goodix-gt6853-module-info.json"
  component_name = "goodix-gt6853"
  manifest = "meta/goodix-gt6853-cpp.cml"
  deps = [ ":driver-cpp" ]
}

fuchsia_driver_component("component-rust") {
  info = "meta/goodix-gt6853-module-info.json"
  component_name = "goodix-gt6853"
  manifest = "meta/goodix-gt6853-rust.cml"
  deps = [ ":driver-rust" ]
}

group("component") {
  if (goodix_gt6853_driver_flavor == "rust") {
    deps = [ ":component-rust" ]
  } else {
    deps = [ ":component-cpp" ]
  }
}

# Active Package: always use "goodix-gt6853" to align with the board
# configuration's dependencies.
fuchsia_driver_package("goodix-gt6853") {
  export_to_bazel = true
  package_name = "goodix-gt6853"
  driver_components = [ ":component" ]

  deps = []
  if (internal_access) {
    deps += [
      ":config-9364",
      ":config-9365",
      ":firmware",
    ]
  }
}

test("goodix-gt6853-test") {
  output_name = "goodix-gt6853-test"
  configs += [ "//build/config:all_source" ]
  sources = [
    "cpp/goodix-gt6853-nelson.cc",
    "cpp/goodix-gt6853-test.cc",
    "cpp/goodix-gt6853.cc",
  ]
  deps = [
    ":common",
    "//sdk/fidl/fuchsia.hardware.gpio:fuchsia.hardware.gpio_cpp",
    "//sdk/lib/async_patterns/testing/cpp",
    "//sdk/lib/component/outgoing/cpp",
    "//sdk/lib/inspect/testing/cpp:zxtest",
    "//src/devices/gpio/testing/fake-gpio",
    "//src/devices/i2c/testing/fake-i2c",
    "//src/devices/testing/mock-ddk",
    "//zircon/system/ulib/mock-function",
    "//zircon/system/ulib/zxtest",
  ]
  defines = [
    "GT6853_CONFIG_9364_PATH=\"$config_9364_path\"",
    "GT6853_CONFIG_9365_PATH=\"$config_9365_path\"",
    "GT6853_FIRMWARE_PATH=\"$firmware_path\"",
    "GT6853_TEST",
  ]
}

fuchsia_unittest_package("goodix-gt6853-test-package") {
  package_name = "goodix-gt6853-test"
  deps = [ ":goodix-gt6853-test" ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}

# The Rust unit test package: compiled and run in CI/CQ regardless of flavor.
fuchsia_unittest_package("goodix-gt6853-rust-test-package") {
  package_name = "goodix-gt6853-rust-test"
  deps = [ ":driver-rust_test" ]
}

group("tests") {
  testonly = true
  deps = [
    ":goodix-gt6853-bind_test",
    ":goodix-gt6853-rust-test-package",
    ":goodix-gt6853-test-package",
  ]
}
