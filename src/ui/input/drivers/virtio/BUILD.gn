import("//build/bind/bind.gni")
import("//build/components.gni")
import("//build/drivers.gni")
import("//build/test.gni")

fuchsia_driver_dml("virtio_input-cpp-dml") {
  dml = "meta/virtio_input-cpp.dml"
  golden_bind = "meta/virtio_input.bind"
  driver_name = "virtio_input-cpp"
  component_name = "virtio_input"
}

driver_bind_rules("virtio_input_bind") {
  dml_label = ":virtio_input-cpp-dml"
  tests = "meta/bind_tests.json"
  deps = [
    "//src/devices/bind/fuchsia",
    "//src/devices/bind/fuchsia.acpi",
    "//src/devices/bind/fuchsia.pci",
  ]
}

fuchsia_cc_driver("driver-cpp") {
  legacy = true
  output_name = "virtio_input-cpp"
  configs += [
    "//build/config:all_source",
    "//build/config/fuchsia:enable_zircon_asserts",
  ]
  sources = [
    "cpp/input.cc",
    "cpp/input_driver.cc",
    "cpp/input_kbd.cc",
    "cpp/input_mouse.cc",
    "cpp/input_touch.cc",
  ]
  deps = [
    ":virtio_input_bind",
    "//sdk/fidl/fuchsia.input.report:fuchsia.input.report_cpp",
    "//src/devices/bus/lib/virtio:virtio-dfv1",
    "//src/devices/lib/driver",
    "//src/devices/lib/driver:driver_runtime",
    "//src/lib/ddktl",
    "//src/ui/input/lib/hid",
    "//src/ui/input/lib/input-report-reader",
    "//zircon/system/ulib/inspect",
  ]
}

fuchsia_driver_component("component-cpp") {
  component_name = "virtio_input"
  info = "meta/virtio_input-info.json"
  dml_label = ":virtio_input-cpp-dml"
  deps = [ ":driver-cpp" ]
}

# The virtio-input driver component included in products.
group("virtio_input") {
  public_deps = [ ":component-cpp" ]
}

fuchsia_driver_package("package") {
  package_name = "virtio_input"
  driver_components = [ ":component-cpp" ]
}

test("virtio-input-test") {
  if (is_fuchsia) {
    fdio_config = [ "//build/config/fuchsia:fdio_config" ]
    if (configs + fdio_config - fdio_config != configs) {
      configs -= fdio_config
    }
  }
  sources = [
    "cpp/input_kbd.cc",
    "cpp/input_mouse.cc",
    "cpp/input_test.cc",
    "cpp/input_touch.cc",
  ]
  deps = [
    "//sdk/fidl/fuchsia.input.report:fuchsia.input.report_cpp",
    "//sdk/lib/async-default",
    "//sdk/lib/async-loop:async-loop-cpp",
    "//sdk/lib/async-loop:async-loop-default",
    "//sdk/lib/async_patterns/testing/cpp",
    "//src/devices/bus/lib/virtio:virtio-dfv1",
    "//src/devices/testing/fake-bti",
    "//src/devices/testing/no_ddk",
    "//src/lib/ddktl",
    "//src/ui/input/lib/hid-input-report",
    "//src/ui/input/lib/hid-parser",
    "//src/ui/input/lib/input-report-reader",
    "//zircon/system/ulib/fbl",
    "//zircon/system/ulib/trace",
    "//zircon/system/ulib/zxtest",
  ]

  # TODO(https://fxbug.dev/42176699): This target uses mutable tables which are deprecated,
  # rather than builders.
  configs += [ "//build/cpp:fidl-wire-deprecated-mutable-tables" ]
}

fuchsia_unittest_package("virtio-input-test-package") {
  package_name = "virtio-input-test"
  deps = [ ":virtio-input-test" ]
}

group("tests") {
  testonly = true
  deps = [
    ":virtio-input-test-package",
    ":virtio_input_bind_test",
  ]
}
