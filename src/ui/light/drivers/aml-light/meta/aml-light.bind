composite aml_light;
using fuchsia;
using fuchsia.amlogic.platform;
using fuchsia.gpio;
using fuchsia.platform;

primary parent "pdev" {
  if fuchsia.COMPATIBLE == "amlogic,aml-light" {
    true;
  } else {
    fuchsia.BIND_PROTOCOL == fuchsia.platform.BIND_PROTOCOL.DEVICE;
    fuchsia.BIND_PLATFORM_DEV_VID == fuchsia.amlogic.platform.BIND_PLATFORM_DEV_VID.AMLOGIC;
    fuchsia.BIND_PLATFORM_DEV_PID == fuchsia.platform.BIND_PLATFORM_DEV_PID.GENERIC;
    fuchsia.BIND_PLATFORM_DEV_DID == fuchsia.platform.BIND_PLATFORM_DEV_DID.GPIO_LIGHT;
  }
}

parent "gpio-amber-led" {
  fuchsia.Service == "fuchsia.hardware.gpio.Service";
  fuchsia.NAME == "gpio-amber-led";
}

parent "pwm-amber-led" {
  fuchsia.Service == "fuchsia.hardware.pwm.Service";
  fuchsia.NAME == "pwm-amber-led";
}

optional parent "gpio-green-led" {
  fuchsia.Service == "fuchsia.hardware.gpio.Service";
  fuchsia.NAME == "gpio-green-led";
}

optional parent "pwm-green-led" {
  fuchsia.Service == "fuchsia.hardware.pwm.Service";
  fuchsia.NAME == "pwm-green-led";
}

optional parent "gpio-init" {
  fuchsia.BIND_INIT_STEP == fuchsia.gpio.BIND_INIT_STEP.GPIO;
}

optional parent "pin-states-0" {
  fuchsia.Service == "fuchsia.hardware.pin.PinStatesService";
}
