import("//build/python/python_mobly_test.gni")
import("//build/testing/environments.gni")

if (is_host) {
  _honeydew_config = {
    transports = {
      adb = {
        attempts = 1
      }
    }
  }

  python_mobly_test("usb_enumeration_test") {
    main_source = "usb_enumeration_test.py"
    libraries = [
      "//src/testing/end_to_end/honeydew",
      "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
      "//src/tests/end_to_end/usb/lib:usb_lib",
    ]
    test_data_deps = [
      "//src/developer/ffx/plugins/inspect:ffx_inspect_tool_test_data",
      "//src/developer/ffx/tools/driver:ffx_driver_tool_test_data",
    ]
    params = {
      # Speed the peripheral link must negotiate, one of "low", "full",
      # "high", "super".
      expected_usb_link_speed = "high"
    }
    environments = [
      sorrel_env,
      iris_env,
    ]
    honeydew_config = _honeydew_config
  }

  python_mobly_test("usb_fastboot_e2e_test") {
    main_source = "test_fastboot_usb.py"
    libraries = [
      "//src/testing/end_to_end/honeydew",
      "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
      "//src/tests/end_to_end/usb/lib:usb_lib",
    ]
    test_data_deps = [
      "//src/developer/ffx/plugins/inspect:ffx_inspect_tool_test_data",
      "//src/developer/ffx/tools/driver:ffx_driver_tool_test_data",
    ]
    environments = [
      sorrel_env,
      iris_env,
    ]
    honeydew_config = _honeydew_config
  }

  python_mobly_test("usb_config_switch_test") {
    main_source = "usb_config_switch_test.py"
    libraries = [
      "//src/testing/end_to_end/honeydew",
      "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
      "//src/tests/end_to_end/usb/lib:usb_lib",
    ]

    # This test switches the DUT's USB functions over the serial console and
    # checks them from the host, so it can only run on Iris devices hosted by
    # a Fuchsia cell.
    environments = [ iris_cell_env ]
    honeydew_config = _honeydew_config
  }
}

group("zero_function_test") {
  testonly = true
  public_deps = [ "zero_function:tests($host_toolchain)" ]
}

group("tests") {
  testonly = true
  public_deps = [
    ":usb_config_switch_test($host_toolchain)",
    ":usb_enumeration_test($host_toolchain)",
    ":usb_fastboot_e2e_test($host_toolchain)",
    "zero_function:tests($host_toolchain)",
  ]
}
