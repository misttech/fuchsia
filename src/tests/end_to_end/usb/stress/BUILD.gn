import("//build/python/python_mobly_test.gni")
import("//build/testing/environments.gni")

if (is_host) {
  _honeydew_config = {
    transports = {
      adb = {
        attempts = 1
      }
    }
  }

  python_mobly_test("usb_virtual_disconnect_test") {
    main_source = "test_usb_disconnect.py"
    libraries = [
      "//src/testing/end_to_end/honeydew",
      "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
      "//src/tests/end_to_end/usb/lib:usb_lib",
    ]
    test_data_deps =
        [ "//src/developer/ffx/plugins/inspect:ffx_inspect_tool_test_data" ]
    params = {
      num_iterations = 10
      disconnect_duration_sec = 10

      # Toggle the host's USB `authorized` attribute instead of using a
      # physical power hub at desk
      # //src/tests/end_to_end/usb/lib/disconnect/udev.sh for host udev
      use_virtual_usb_hub = true

      # Assert the link comes back at HighSpeed after every reconnect.
      expected_usb_link_speed = "high"

      # Retry the virtual hub's USB bus ID lookup before each unplug in case
      # the DUT is still re-enumerating after the previous reconnect.
      bus_id_lookup_attempts = 10
      bus_id_lookup_timeout_sec = 15
    }

    environments = [ sorrel_env ]
    timeout_secs = 600
    honeydew_config = _honeydew_config
  }

  python_mobly_test("usb_reset_test") {
    main_source = "test_usb_disconnect.py"
    libraries = [
      "//src/testing/end_to_end/honeydew",
      "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
      "//src/tests/end_to_end/usb/lib:usb_lib",
    ]
    test_data_deps =
        [ "//src/developer/ffx/plugins/inspect:ffx_inspect_tool_test_data" ]
    params = {
      num_iterations = 10

      # Reset the DUT's USB port with the host's USBDEVFS_RESET ioctl instead
      # of using a physical power hub at desk. A reset has no "off" phase, so
      # there is no disconnect duration. See
      # //src/tests/end_to_end/usb/lib/disconnect/udev.sh for the host udev
      # rules it requires.
      use_virtual_usb_hub = true
      virtual_usb_hub_mode = "reset"
      disconnect_method = "reset"

      # Assert the link comes back at HighSpeed after every reset.
      expected_usb_link_speed = "high"

      # Retry the virtual hub's USB bus ID lookup before each reset in case
      # the DUT is still re-enumerating after the previous one.
      bus_id_lookup_attempts = 10
      bus_id_lookup_timeout_sec = 15
      test_case_prefix = "test_usb_reset"
    }

    environments = [ iris_env ]
    timeout_secs = 600
    honeydew_config = _honeydew_config
  }

  python_mobly_test("usb_disconnect_test") {
    main_source = "test_usb_disconnect.py"
    libraries = [
      "//src/testing/end_to_end/honeydew",
      "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
      "//src/tests/end_to_end/usb/lib:usb_lib",
    ]
    test_data_deps =
        [ "//src/developer/ffx/plugins/inspect:ffx_inspect_tool_test_data" ]
    params = {
      num_usb_disconnects = 5
      verify_mdns = true
      mdns_timeout_sec = 12

      # Assert the link comes back at HighSpeed after every reconnect.
      expected_usb_link_speed = "high"
    }
    local_config_source = "UsbDisconnectTestbed.yaml"
    environments = [
      iris_env,
      vim3_env,
      nuc11_env,
      nelson_env,
      sherlock_env,
      sorrel_env,
    ]
    timeout_secs = 600
    honeydew_config = _honeydew_config
  }

  python_mobly_test("usb_disconnect_stress_test") {
    main_source = "test_usb_disconnect.py"
    libraries = [
      "//src/testing/end_to_end/honeydew",
      "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
      "//src/tests/end_to_end/usb/lib:usb_lib",
    ]
    params = {
      num_usb_disconnects = 100
      verify_mdns = true
      mdns_timeout_sec = 12
    }
    local_config_source = "UsbDisconnectTestbed.yaml"
    environments = [ iris_env ]
    timeout_secs = 3900
    honeydew_config = _honeydew_config
  }

  # Verifies that the device stays discoverable over mDNS across repeated
  # physical cable replugs with a shorter disconnect window.
  python_mobly_test("usb_mdns_hotplug_test") {
    main_source = "test_usb_disconnect.py"
    libraries = [
      "//src/testing/end_to_end/honeydew",
      "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
      "//src/tests/end_to_end/usb/lib:usb_lib",
    ]
    params = {
      num_iterations = 10
      disconnect_duration_sec = 2
      verify_mdns = true
      mdns_timeout_sec = 12

      # Each case also checks mDNS, so don't name it test_usb_disconnect_N.
      test_case_prefix = "test_usb_mdns_hotplug"
    }
    local_config_source = "UsbDisconnectTestbed.yaml"
    environments = [
      iris_env,
      sorrel_env,
    ]
    timeout_secs = 1800
    honeydew_config = _honeydew_config
  }

  # Verifies that no unhandled IRQ storm or driver dispatcher spin-loop occurs
  # across repeated physical cable replugs. A separate target so that the other
  # test_usb_disconnect.py targets are unaffected (verify_no_irq_storm defaults
  # to false).
  python_mobly_test("usb_disconnect_irq_storm_test") {
    main_source = "test_usb_disconnect.py"
    libraries = [
      "//src/testing/end_to_end/honeydew",
      "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
      "//src/tests/end_to_end/usb/lib:usb_lib",
    ]

    # The DWC3 IRQ check reads Inspect through `ffx inspect`.
    test_data_deps =
        [ "//src/developer/ffx/plugins/inspect:ffx_inspect_tool_test_data" ]
    params = {
      num_iterations = 10
      verify_no_irq_storm = true

      # Each case also checks for IRQ storms, so don't name it
      # test_usb_disconnect_N.
      test_case_prefix = "test_usb_disconnect_irq_storm"
    }
    local_config_source = "UsbDisconnectTestbed.yaml"
    environments = [
      iris_env,
      sorrel_env,
    ]
    timeout_secs = 1200
    honeydew_config = _honeydew_config
  }

  python_mobly_test("cdc_stress_test") {
    main_source = "test_cdc_stress.py"
    libraries = [
      "//src/testing/end_to_end/honeydew",
      "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
    ]
    params = {
      packet_iterations = 10
      large_transfer_iterations = 5
      transfer_size_mb = 5
      varying_burst_count = 50
      toggle_iterations = 10
      power_iterations = 2
      disconnect_duration_sec = 5
    }
    local_config_source = "UsbDisconnectTestbed.yaml"
    environments = [
      sorrel_env,
      iris_env,
    ]
    timeout_secs = 635
    honeydew_config = _honeydew_config
  }

  python_mobly_test("usb_fastboot_loop_test") {
    main_source = "test_fastboot_loop.py"
    libraries = [
      "//src/testing/end_to_end/honeydew",
      "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
      "//src/tests/end_to_end/usb/lib:usb_lib",
    ]
    params = {
      num_iterations = 5
      disconnect_duration_sec = 1
    }
    local_config_source = "UsbDisconnectTestbed.yaml"
    product_bundle = "minimal.sorrel"
    environments = [
      iris_env,
      sorrel_env,
    ]
    timeout_secs = 900
    honeydew_config = _honeydew_config
  }

  python_mobly_test("adb_root_unroot_stress_test") {
    main_source = "test_adb_root_unroot_stress.py"
    libraries = [
      "//src/testing/end_to_end/honeydew",
      "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
    ]
    params = {
      num_iterations = 10
    }
    environments = [ iris_env ]
    timeout_secs = 420
    honeydew_config = _honeydew_config
  }

  python_mobly_test("adb_fastboot_stress_test") {
    main_source = "test_adb_fastboot_stress.py"
    libraries = [
      "//src/testing/end_to_end/honeydew",
      "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
    ]
    params = {
      num_iterations = 10
    }
    environments = [ iris_env ]
    timeout_secs = 1200
    honeydew_config = _honeydew_config
  }

  python_mobly_test("adb_random_stress_test") {
    main_source = "test_adb_random_stress.py"
    libraries = [
      "//src/testing/end_to_end/honeydew",
      "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
    ]
    params = {
      num_iterations = 20
    }
    environments = [ iris_env ]
    timeout_secs = 840
    honeydew_config = _honeydew_config
  }

  python_mobly_test("adb_server_restart_stress_test") {
    main_source = "test_adb_server_restart_stress.py"
    libraries = [
      "//src/testing/end_to_end/honeydew",
      "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
    ]
    params = {
      num_iterations = 10
      recovery_timeout_sec = 90
      max_acceptable_recovery_sec = 60
    }
    environments = [ iris_env ]
    timeout_secs = 1200
  }

  python_mobly_test("adbd_restart_stress_test") {
    main_source = "test_adbd_restart_stress.py"
    libraries = [
      "//src/testing/end_to_end/honeydew",
      "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
    ]
    params = {
      num_iterations = 10
      respawn_timeout_sec = 60
    }
    environments = [ iris_env ]
    timeout_secs = 700
  }
}

group("zero_function_stress_test") {
  testonly = true
  public_deps = [ "zero_function:tests($host_toolchain)" ]
}

group("tests") {
  testonly = true
  public_deps = [
    ":adb_fastboot_stress_test($host_toolchain)",
    ":adb_random_stress_test($host_toolchain)",
    ":adb_root_unroot_stress_test($host_toolchain)",
    ":adb_server_restart_stress_test($host_toolchain)",
    ":adbd_restart_stress_test($host_toolchain)",
    ":cdc_stress_test($host_toolchain)",
    ":usb_disconnect_irq_storm_test($host_toolchain)",
    ":usb_disconnect_stress_test($host_toolchain)",
    ":usb_disconnect_test($host_toolchain)",
    ":usb_fastboot_loop_test($host_toolchain)",
    ":usb_mdns_hotplug_test($host_toolchain)",
    ":usb_reset_test($host_toolchain)",
    ":usb_virtual_disconnect_test($host_toolchain)",
    "zero_function:tests($host_toolchain)",
  ]
}
