import("//build/python/python_host_test.gni")
import("//build/python/python_library.gni")

python_library("usb_lib") {
  testonly = true
  library_name = "usb_lib"
  sources = [
    "__init__.py",
    "fastboot_utils.py",
    "irq_storm.py",
    "link_speed.py",
    "linux_virtual_usb_hub.py",
    "sysfs_usb.py",
    "usb_config.py",
    "usb_power_hub_base_test.py",
  ]
  library_deps = [
    "//sdk/fidl/fuchsia.developer.remotecontrol:fuchsia.developer.remotecontrol_python",
    "//sdk/fidl/fuchsia.driver.development:fuchsia.driver.development_python",
    "//sdk/fidl/fuchsia.hardware.power.statecontrol:fuchsia.hardware.power.statecontrol_python",
    "//sdk/fidl/fuchsia.kernel:fuchsia.kernel_python",
    "//sdk/fidl/fuchsia.sys2:fuchsia.sys2_python",
    "//src/testing/end_to_end/honeydew",
    "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
  ]
}

if (is_host) {
  python_host_test("irq_storm_test") {
    main_source = "irq_storm_test.py"
    libraries = [
      ":usb_lib",
      "//src/testing/end_to_end/honeydew",
      "//third_party/mobly",
    ]
    main_callable = "unittest.main"
    extra_args = [ "-v" ]
  }

  python_host_test("linux_virtual_usb_hub_test") {
    main_source = "linux_virtual_usb_hub_test.py"
    libraries = [
      ":usb_lib",
      "//src/testing/end_to_end/honeydew",
    ]
    main_callable = "unittest.main"
    extra_args = [ "-v" ]
  }
}

group("tests") {
  testonly = true
  public_deps = [
    ":irq_storm_test($host_toolchain)",
    ":linux_virtual_usb_hub_test($host_toolchain)",
    "testusb:tests",
    "zero_function:tests",
  ]
}
