import("//build/python/python_mobly_test.gni")
import("//build/testing/environments.gni")

if (is_host) {
  python_mobly_test("suspend_resume_test") {
    main_source = "suspend_resume_test.py"
    libraries = [ "//src/tests/end_to_end/power/suspend_resume_test_cases" ]

    environments = [ nelson_env ]
  }

  python_mobly_test("no_suspend_on_usb_test") {
    main_source = "no_suspend_on_usb_test.py"
    libraries = [ "//src/tests/end_to_end/power/suspend_resume_test_cases" ]

    environments = [ nelson_env ]
  }
}

group("tests") {
  testonly = true
  public_deps = [
    ":no_suspend_on_usb_test($host_toolchain)",
    ":suspend_resume_test($host_toolchain)",
  ]
}
