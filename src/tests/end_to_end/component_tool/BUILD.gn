import("//build/go/go_library.gni")
import("//build/go/go_test.gni")
import("//build/images/paths.gni")

group("tests") {
  testonly = true

  deps = []

  if (host_os == "linux") {
    deps += [ ":component_tool_test($host_toolchain)" ]
  }
}

if (is_linux) {
  go_library("component_tool_test_lib") {
    testonly = true
    source_dir = "//src/tests/end_to_end/component_tool"
    deps = [ "//tools/emulator/emulatortest" ]
    sources = [ "component_tool_test.go" ]
  }

  go_test("component_tool_test") {
    embed = [ ":component_tool_test_lib" ]
    args = [
      "--emulator.pb-path",
      rebase_path(files.product_bundle_dir, root_build_dir),
    ]
    non_go_deps =
        [ "//build/images/fuchsia:default_product_bundle_for_emulator.go" ]
  }
}
