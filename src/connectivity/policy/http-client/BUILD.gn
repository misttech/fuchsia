import("//build/bazel/bazel_test_suite.gni")
import("//build/components.gni")

bazel_test_suite("bazel_tests") {
  target_tests = [ "//src/connectivity/policy/http-client:http-client-test" ]
}

group("tests") {
  testonly = true

  deps = [
    ":bazel_tests",
    ":http-client-test",
    "integration:tests",
  ]
}

# Kept in GN for
# `//bundles/assembly/bazel_inputs/src/connectivity/policy/http-client` because
# `bazel2gn` does not translate `fx_package` (`noGNEquivalent`), and
# `//bundles/assembly` still consumes the GN packages via `bazel_inputs` until
# `collect_debug_symbols_manifest_aspect` in
# `//build/bazel/debug_symbols/aspects.bzl` collects debug symbols for
# `rust_dylib_library` (`//src/storage/lib/vfs/rust:vfs_dylib`), which otherwise
# causes `export_last_build_debug_symbols` to fail on assembled images.
fuchsia_package("package") {
  package_name = "http-client"
  deps = [ ":component" ]
  visibility = [ "//bundles/assembly/*" ]
}

fuchsia_package("google_package") {
  package_name = "google-http-client"
  deps = [ ":google_component" ]
  visibility = [ "//bundles/assembly/*" ]
}

# fuchsia_hyper::new_https_client fails if there isn't a file at
# /config/ssl/cert.pem, but the unit tests don't actually make https connections
# and so don't need any certs, so we can just give them an empty file instead of
# making them a system test and giving them the system certs.
resource("fake-ssl-certs") {
  sources = [ "fake_cert_for_test.pem" ]
  outputs = [ "fake-ssl-certs/cert.pem" ]
  visibility = [ ":*" ]
}

# Kept in GN because `http-client-test` packages
# `//src/connectivity/network/dns:component` and
# `//src/connectivity/network/netstack3:component-for-tests`, which have no
# Bazel build yet.
fuchsia_unittest_package("http-client-test") {
  package_name = "http-client-test-gn"
  manifest = "meta/http_client_test.cml"
  deps = [
    ":fake-ssl-certs",
    ":http_client_test",
    "//src/connectivity/network/dns:component",
    "//src/connectivity/network/netstack3:component-for-tests",
  ]
}

