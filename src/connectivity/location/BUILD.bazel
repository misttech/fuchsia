# Location device tests defined in Bazel. These are exported to `fx test` and
# infra builders through //src/connectivity:target_tests.
test_suite(
    name = "target_tests",
    target_compatible_with = ["@platforms//os:fuchsia"],
    tests = [
        "//src/connectivity/location/emergency:emergency-tests",
        "//src/connectivity/location/gnss:gnss-unittests",
        "//src/connectivity/location/regulatory_region:regulatory-region-tests",
    ],
    visibility = ["//src/connectivity:__pkg__"],
)
