import("//build/tools/bazel2gn/bazel_migration.gni")

if (is_fuchsia) {
  executable("bin") {
    sources = [
      "gnss_service.cc",
      "gnss_service.h",
      "main.cc",
    ]
    output_name = "gnss_service_bin"
    deps = [
      "//sdk/fidl/fuchsia.location.gnss:fuchsia.location.gnss_cpp",
      "//sdk/lib/async-loop:async-loop-default",
      "//sdk/lib/component/outgoing/cpp",
      "//sdk/lib/syslog/cpp",
    ]
  }
}
if (is_fuchsia) {
  executable("unittests") {
    testonly = true
    sources = [
      "gnss_service.cc",
      "gnss_service.h",
      "gnss_unittest.cc",
    ]
    deps = [
      "//sdk/fidl/fuchsia.location.gnss:fuchsia.location.gnss_cpp",
      "//sdk/lib/async-loop:async-loop-default",
      "//sdk/lib/async-testing",
      "//sdk/lib/component/outgoing/cpp",
      "//sdk/lib/syslog/cpp",
      "//src/lib/fxl/test:gtest_main",
      "//src/lib/testing/predicates",
      "//zircon/system/ulib/sync:sync-cpp",
    ]
  }
}

fuchsia_unittest_package("gnss-unittests") {
  package_name = "gnss-unittests-gn"
  component_name = "gnss-unittests"
  deps = [ ":unittests" ]
  visibility = [
    ":*",
    "//src/connectivity/location:*",
  ]
}
