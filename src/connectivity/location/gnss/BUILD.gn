import("//build/components.gni")

fuchsia_package_with_single_component("gnss_service") {
  manifest = "meta/gnss-service.cml"
  deps = [ ":bin" ]
}

group("tests") {
  testonly = true
  deps = [ ":gnss-unittests" ]
}

