import("//build/bind/bind.gni")
import("//build/components.gni")
import("//build/drivers.gni")

group("tests") {
  testonly = true
  deps = [
    ":gvnic-tests",
    ":gvnic_bind_test",
  ]
}

fuchsia_driver_dml("gvnic-dml") {
  dml = "meta/gvnic.dml"
  driver_name = "gvnic"
}

driver_bind_rules("gvnic_bind") {
  dml_label = ":gvnic-dml"
  bind_output = "gvnic.bindbc"
  tests = "meta/bind-tests.json"
  deps = [
    "//src/devices/bind/fuchsia",
    "//src/devices/bind/fuchsia.acpi",
    "//src/devices/bind/fuchsia.pci",
  ]
}

fuchsia_rust_driver("gvnic-driver") {
  edition = "2024"
  output_name = "gvnic"
  with_unit_tests = true
  sources = [
    "src/abi.rs",
    "src/dma.rs",
    "src/driver.rs",
    "src/lib.rs",
  ]
  deps = [
    "//sdk/fidl/fuchsia.hardware.network:fuchsia.hardware.network_rust_next_internal",
    "//sdk/fidl/fuchsia.hardware.network.driver:fuchsia.hardware.network.driver_rust_next_internal",
    "//sdk/fidl/fuchsia.hardware.pci:fuchsia.hardware.pci_rust_next_internal",
    "//sdk/fidl/fuchsia.net:fuchsia.net_rust_next_internal",
    "//sdk/lib/driver/component/rust",
    "//sdk/lib/driver/mmio/rust:mmio",
    "//sdk/lib/driver/runtime/rust/fidl",
    "//sdk/rust/zx",
    "//src/devices/lib/dma-buffer/rust",
    "//src/lib/diagnostics/inspect/rust",
    "//src/lib/fidl/rust_next/fidl_next:fidl_next_internal",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//src/lib/fuchsia-sync",
    "//src/lib/mapped-vmo",
    "//third_party/rust_crates:bitflags",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:zerocopy",
  ]
  test_deps = [
    "//sdk/fidl/fuchsia.inspect:fuchsia.inspect_rust",
    "//sdk/lib/driver/fake-bti/rust",
    "//sdk/lib/driver/fake-pci/rust",
    "//sdk/lib/driver/runtime/rust",
    "//src/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
    "//src/lib/fuchsia",
  ]
  configs += [
    "//build/config/lto:lto-if-compatible",
    "//build/config/rust/lints:clippy_warn_all",
  ]
}

fuchsia_driver_component("gvnic") {
  dml_label = ":gvnic-dml"
  component_name = "gvnic"
  deps = [
    ":gvnic-driver",
    ":gvnic_bind",
  ]
  info = "meta/gvnic-info.json"
}

fuchsia_driver_package("gvnic-package") {
  package_name = "gvnic"
  driver_components = [ ":gvnic" ]
}

fuchsia_unittest_package("gvnic-tests") {
  deps = [ ":gvnic-driver_test" ]
}
