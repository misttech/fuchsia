    "//src/connectivity/lib/net-types",
    "//src/connectivity/lib/packet-formats-dhcp",
    "//src/lib/network/packet",
    "//third_party/rust_crates:arrayvec",
    "//third_party/rust_crates:assert_matches",
    "//third_party/rust_crates:either",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:num-rational",
    "//third_party/rust_crates:num-traits",
    "//third_party/rust_crates:rand",
    "//third_party/rust_crates:thiserror",
    "//third_party/rust_crates:zerocopy",
  ]
}
rustc_test("core_test") {
  sources = [
    "src/client.rs",
    "src/lib.rs",
  ]
  edition = "2024"
  proc_macro_deps = [ "//third_party/rust_crates:derivative" ]
  deps = [
           "//src/connectivity/lib/net-types",
           "//src/connectivity/lib/packet-formats-dhcp",
           "//src/lib/network/packet",
           "//third_party/rust_crates:arrayvec",
           "//third_party/rust_crates:assert_matches",
           "//third_party/rust_crates:either",
           "//third_party/rust_crates:log",
           "//third_party/rust_crates:num-rational",
           "//third_party/rust_crates:num-traits",
           "//third_party/rust_crates:rand",
           "//third_party/rust_crates:thiserror",
           "//third_party/rust_crates:zerocopy",
         ] +
         [
           "//src/connectivity/lib/net-declare",
           "//third_party/rust_crates:test-case",
         ]
  configs += [ "//build/config/rust/lints:deny_unused_results" ]
  output_name = "dhcpv6_core_lib_test"
}
fuchsia_unittest_package("dhcpv6-core-test") {
  package_name = "dhcpv6-core-test-gn"
