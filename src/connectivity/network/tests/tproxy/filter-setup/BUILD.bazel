load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")

package(default_applicable_licenses = ["//:license"])

rustc_binary(
    name = "bin",
    testonly = True,
    srcs = ["src/main.rs"],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate_name = "filter_setup",
    edition = "2024",
    deps = [
        "//sdk/fidl/fuchsia.net.filter:fuchsia.net.filter_rust",
        "//sdk/fidl/fuchsia.net:fuchsia.net_rust",
        "//src/connectivity/lib/net-declare",
        "//src/connectivity/network/testing/netemul/sync-manager/rust:lib",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component",
        "//src/lib/network/fidl_fuchsia_net_filter_ext",
        "//src/lib/network/fidl_fuchsia_net_matchers_ext",
        "//third_party/rust_crates/vendor:futures",
    ],
)

fx_packaged_binary(
    name = "filter_setup_packaged_bin",
    testonly = True,
    binary = ":bin",
    binary_name = "filter_setup",
)

fx_component_manifest(
    name = "filter-setup-manifest",
    testonly = True,
    component_name = "filter-setup",
    includes = [
        "//sdk/lib/syslog:client.shard",
        "//src/connectivity/network/testing/netemul/sync-manager/meta:client.shard",
    ],
    manifest = "meta/filter-setup.cml",
)

fx_component(
    name = "filter-setup",
    testonly = True,
    compiled_manifest = ":filter-setup-manifest",
    component_name = "filter-setup",
    visibility = ["//src/connectivity/network/tests/tproxy:__pkg__"],
    deps = [":filter_setup_packaged_bin"],
)
