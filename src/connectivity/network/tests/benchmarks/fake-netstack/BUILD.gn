import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_binary("bin") {
  testonly = true
  sources = [ "src/main.rs" ]
  configs += [ "//build/config/rust/lints:deny_unused_results" ]
  output_name = "fake_netstack"
  edition = "2024"
  deps = [
    "//sdk/fidl/fuchsia.net:fuchsia.net_rust",
    "//sdk/fidl/fuchsia.net.power:fuchsia.net.power_rust",
    "//sdk/fidl/fuchsia.net.resources:fuchsia.net.resources_rust",
    "//sdk/fidl/fuchsia.posix:fuchsia.posix_rust",
    "//sdk/fidl/fuchsia.posix.socket:fuchsia.posix.socket_rust",
    "//sdk/rust/zx",
    "//src/connectivity/lib/net-types",
    "//src/connectivity/lib/packet-formats",
    "//src/lib/async-utils",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//src/lib/network/fidl_fuchsia_net_ext",
    "//src/lib/network/packet",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:assert_matches",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:rand",
  ]
}
fuchsia_component_manifest("fake-netstack-manifest") {
  testonly = true
  component_name = "fake-netstack"
  manifest = "meta/fake-netstack.cml"
}
fuchsia_component("fake-netstack") {
  testonly = true
  cm_label = ":fake-netstack-manifest"
  component_name = "fake-netstack"
  visibility = [
    ":*",
    "//src/connectivity/network/tests/benchmarks/socket-loopback:*",
  ]
  deps = [ ":bin" ]
}
