load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")

package(default_applicable_licenses = ["//:license"])

rustc_binary(
    name = "server",
    testonly = True,
    srcs = ["src/main.rs"],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate_name = "multi_nic_test_server",
    edition = "2024",
    visibility = ["//src/connectivity/network/tests/multi_nic:__pkg__"],
    deps = [
        "//src/connectivity/network/testing/netemul/sync-manager/rust:lib",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//third_party/rust_crates/vendor:log",
    ],
)
