load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//build/bazel/rules/rust:rustc_proc_macro.bzl", "rustc_proc_macro")

package(default_applicable_licenses = ["//:license"])

rustc_proc_macro(
    name = "netstack_testing_macros",
    srcs = ["src/proc_macros.rs"],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate_root = "src/proc_macros.rs",
    edition = "2024",
    # @bazel2gn:skip
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = [
        "//src/bringup/bin/netsvc/test/integration:__pkg__",
        "//src/connectivity/network:__subpackages__",
        "//src/connectivity/policy/tests/integration/management:__pkg__",
        "//src/connectivity/policy/tests/integration/reachability:__pkg__",
        "//src/lib/network/fidl_fuchsia_posix_socket_ext:__pkg__",
        "//third_party/tcpdump/tests:__pkg__",
    ],
    deps = [
        "//third_party/rust_crates/vendor:either",
        "//third_party/rust_crates/vendor:itertools",
        "//third_party/rust_crates/vendor:proc-macro2",
        "//third_party/rust_crates/vendor:quote",
        "//third_party/rust_crates/vendor:syn",
    ],
)

# @bazel2gn:skip
host_rustc_test(
    name = "netstack_testing_macros_test",
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate = ":netstack_testing_macros",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = ["//third_party/rust_crates/vendor:test-case"],
)
