    "//src/bringup/bin/netsvc/test/integration:*",
    "//src/connectivity/network/*",
    "//src/connectivity/policy/tests/integration/management:*",
    "//src/connectivity/policy/tests/integration/reachability:*",
    "//src/lib/network/fidl_fuchsia_posix_socket_ext:*",
    "//third_party/tcpdump/tests:*",
  ]
  deps = [
    "//third_party/rust_crates:either",
    "//third_party/rust_crates:itertools",
    "//third_party/rust_crates:proc-macro2",
    "//third_party/rust_crates:quote",
    "//third_party/rust_crates:syn",
  ]
}
