import("//build/bazel/bazel_host_tool.gni")
import("//build/bazel/bazel_test_suite.gni")

if (is_host) {
  bazel_host_tool("host") {
    bazel_target = "//src/connectivity/network/tools/sockscripter:bin"
    bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/bin"
    output_name = "sockscripter"
    install_host_tool = true
  }
}

bazel_test_suite("sockscripter-unittest") {
  target_tests =
      [ "//src/connectivity/network/tools/sockscripter:sockscripter-unittest" ]
  host_tests =
      [ "//src/connectivity/network/tools/sockscripter:sockscripter_host_test" ]
}

group("tests") {
  testonly = true
  deps = [
    ":host($host_toolchain)",
    ":sockscripter-unittest",
  ]
}
