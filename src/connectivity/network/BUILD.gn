import("//build/components.gni")

fuchsia_package("netstack3") {
  package_name = "netstack3"
  deps = [ "netstack3:component" ]

  visibility = [
    ":*",
    "//bundles/assembly/*",
  ]
}

# LINT.IfChange(performance_critical_rust_crate)
config("performance_critical_rust_crate") {
  if (is_release && !is_host) {
    configs = [ "//build/config:optimize_speed" ]
  }
}

# LINT.ThenChange(//src/connectivity/network/BUILD.bazel:performance_critical_rust_crate)

group("drivers") {
  deps = [ "drivers/network-device" ]
}

group("benchmarks") {
  testonly = true
  deps = [
    "drivers/network-device/device:benchmarks",
    "netstack3:benchmarks",
    "tests/benchmarks",
  ]
}

group("e2e_tests") {
  testonly = true

  deps = [ "//src/connectivity/network/testing/conformance/emulator:e2e_tests" ]
}

group("tests") {
  testonly = true
  deps = [
    "dhcpv4:tests",
    "dhcpv6:tests",
    "dns:tests",
    "drivers:tests",
    "lib:tests",
    "mdns:tests",
    "net-cli:tests",
    "netlink:tests",
    "netstack3:tests",
    "testing:tests",
    "tests",
    "tools:tests",
    "tun:tests",
  ]
}
