rustc_test("lib_test") {
  sources = [
    "src/async_resolver.rs",
    "src/config.rs",
    "src/lib.rs",
    "src/tcp.rs",
    "src/test_util.rs",
    "src/udp.rs",
  ]
  edition = "2024"
  proc_macro_deps = [ "//third_party/rust_crates:async-trait" ]
  deps = [
           "//sdk/fidl/fuchsia.net:fuchsia.net_rust",
           "//sdk/rust/zx",
           "//src/lib/fuchsia-async",
           "//src/lib/fuchsia-sync",
           "//src/lib/network/fidl_fuchsia_net_ext",
           "//third_party/rust_crates:futures",
           "//third_party/rust_crates:trust-dns-proto",
           "//third_party/rust_crates:trust-dns-resolver",
         ] +
         [
           "//src/connectivity/lib/net-declare",
           "//src/lib/fuchsia",
         ]
  configs += [ "//build/config/rust/lints:deny_unused_results" ]
  output_name = "dns_lib_test"
