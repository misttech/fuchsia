import("//build/bazel/bazel_test_suite.gni")

bazel_test_suite("dhcpv4_protocol_test") {
  target_tests =
      [ "//src/connectivity/network/dhcpv4/protocol:dhcpv4_protocol_test" ]
  host_tests =
      [ "//src/connectivity/network/dhcpv4/protocol:protocol_host_test" ]
}

group("tests") {
  testonly = true
  deps = [ ":dhcpv4_protocol_test" ]
}

