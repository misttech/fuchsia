{
    children: [
        {
            name: "netstack",
            url: "fuchsia-pkg://fuchsia.com/netstack3#meta/netstack3.cm",
            on_terminate: "reboot",
        },
    ],
    offer: [
        {
            dictionary: "netstack3-config",
            from: "parent",
            to: "#netstack",
            availability: "same_as_target",
        },
        {
            config: [
                "fuchsia.netstack3.DebugLogs",
                "fuchsia.netstack3.OpaqueIids",
            ],
            from: "void",
            to: "#netstack",
            availability: "optional",
        },
    ],
}
