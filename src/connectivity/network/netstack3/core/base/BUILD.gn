import("//build/bazel/bazel_test_suite.gni")

bazel_test_suite("netstack3-core-base-test") {
  target_tests = [
    "//src/connectivity/network/netstack3/core/base:netstack3-core-base-test",
  ]
  host_tests = [
    "//src/connectivity/network/netstack3/core/base:netstack3-base-host-test",
  ]
}

group("tests") {
  testonly = true
  deps = [ ":netstack3-core-base-test" ]
}

