load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "wrap_host_rust_test")
load("//build/bazel/rules/rust:rustc_check_cfg_build_flags.bzl", "rustc_check_cfg_build_flags")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_check_cfg_build_flags(
    name = "check_cfg_flags",
    cfgs = ["test"],
    features = [
        "instrumented",
        "testutils",
    ],
)

_COMMON_SRCS = [
    "src/actions.rs",
    "src/api.rs",
    "src/conntrack.rs",
    "src/conntrack/tcp.rs",
    "src/context.rs",
    "src/lib.rs",
    "src/logic.rs",
    "src/logic/nat.rs",
    "src/matchers.rs",
    "src/packets.rs",
    "src/state.rs",
    "src/state/validation.rs",
]

_COMMON_BUILD_FLAGS = [
    ":check_cfg_flags",
    "//build/config/rust/lints:deny_unused_results",
    "//src/connectivity/network/netstack3:netstack3_configs",
]

# @bazel2gn:transformer=deps
_COMMON_PROC_MACRO_DEPS = ["//third_party/rust_crates/vendor:derivative"]

# @bazel2gn:transformer=deps
_COMMON_DEPS = [
    "//src/connectivity/lib/net-types",
    "//src/connectivity/lib/packet-formats",
    "//src/connectivity/network/netstack3/core/hashmap",
    "//src/lib/network/packet",
    "//src/lib/replace-with",
    "//third_party/rust_crates/vendor:assert_matches",
    "//third_party/rust_crates/vendor:log",
    "//third_party/rust_crates/vendor:rand",
    "//third_party/rust_crates/vendor:zerocopy",
]

rustc_library(
    name = "netstack3-filter",
    srcs = _COMMON_SRCS,
    build_flags = _COMMON_BUILD_FLAGS,
    edition = "2024",
    proc_macro_deps = _COMMON_PROC_MACRO_DEPS,
    visibility = ["//src/connectivity/network/netstack3/core:__subpackages__"],
    deps = _COMMON_DEPS + [
        "//src/connectivity/network/netstack3/core/base:netstack3-base",
    ],
)

rustc_library(
    name = "netstack3-filter-instrumented",
    srcs = _COMMON_SRCS,
    build_flags = _COMMON_BUILD_FLAGS,
    crate_features = ["instrumented"],
    crate_name = "netstack3_filter",
    edition = "2024",
    proc_macro_deps = _COMMON_PROC_MACRO_DEPS,
    visibility = ["//src/connectivity/network/netstack3/core:__subpackages__"],
    deps = _COMMON_DEPS + [
        "//src/connectivity/network/netstack3/core/base:netstack3-base-instrumented",
    ],
)

rustc_library(
    name = "netstack3-filter-testutils",
    testonly = True,
    srcs = _COMMON_SRCS,
    build_flags = _COMMON_BUILD_FLAGS,
    crate_features = [
        "testutils",
        "instrumented",
    ],
    crate_name = "netstack3_filter",
    edition = "2024",
    proc_macro_deps = _COMMON_PROC_MACRO_DEPS,
    visibility = ["//src/connectivity/network/netstack3/core:__subpackages__"],
    deps = _COMMON_DEPS + [
        "//src/connectivity/network/netstack3/core/base:netstack3-base-testutils",
    ],
)

rustc_library(
    name = "netstack3-filter-benchmarks",
    testonly = True,
    srcs = _COMMON_SRCS,
    build_flags = _COMMON_BUILD_FLAGS,
    crate_features = ["testutils"],
    crate_name = "netstack3_filter",
    edition = "2024",
    proc_macro_deps = _COMMON_PROC_MACRO_DEPS,
    visibility = ["//src/connectivity/network/netstack3/core:__subpackages__"],
    deps = _COMMON_DEPS + [
        "//src/connectivity/network/netstack3/core/base:netstack3-base-benchmarks",
    ],
)

rustc_library(
    name = "netstack3-filter-loom",
    testonly = True,
    srcs = _COMMON_SRCS,
    build_flags = _COMMON_BUILD_FLAGS + ["//src/connectivity/network/netstack3/core:loom"],
    crate_features = ["testutils"],
    crate_name = "netstack3_filter",
    edition = "2024",
    proc_macro_deps = _COMMON_PROC_MACRO_DEPS,
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//src/connectivity/network/netstack3/core:__subpackages__"],
    deps = _COMMON_DEPS + [
        "//src/connectivity/network/netstack3/core/base:netstack3-base-loom",
    ],
)

# Cannot attach to `:netstack3-filter-instrumented` via `crate` because unit
# tests require `netstack3-base-testutils`.
# @bazel2gn:skip
rustc_test(
    name = "netstack3-filter-instrumented_test",
    srcs = _COMMON_SRCS,
    build_flags = _COMMON_BUILD_FLAGS,
    crate_features = ["instrumented"],
    edition = "2024",
    proc_macro_deps = _COMMON_PROC_MACRO_DEPS + [
        "//src/connectivity/lib/ip-test-macro",
    ],
    deps = _COMMON_DEPS + [
        "//src/connectivity/lib/net-declare",
        "//src/connectivity/network/netstack3/core/base:netstack3-base-testutils",
        "//third_party/rust_crates/vendor:test-case",
    ] + select({
        "@platforms//os:fuchsia": [
            "//src/connectivity/network/lib/diagnostics-traits",
            "//src/lib/diagnostics/inspect/rust:fuchsia-inspect",
            "//src/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
            "//src/lib/fuchsia-async",
        ],
        "//conditions:default": [],
    }),
)

# @bazel2gn:skip
wrap_host_rust_test(
    name = "netstack3-filter-host-test",
    binary_name = "netstack3-filter-instrumented_test",
)

# @bazel2gn:skip
fx_unittest_package(
    name = "netstack3-filter-test",
    unit_tests = [":netstack3-filter-instrumented_test"],
)
