import("//build/bazel/bazel_test_suite.gni")

bazel_test_suite("bazel_tests") {
  target_tests = [ "//src/connectivity/network/netstack3/core/filter/tests:netstack3-core-filter-integration-test" ]
  host_tests = [ "//src/connectivity/network/netstack3/core/filter/tests:netstack3_filter_integration_test_host_test" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    ":netstack3-core-filter-integration-test",
    ":netstack3_filter_integration_test($host_toolchain)",
  ]
}

