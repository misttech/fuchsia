rustc_test("netstack3_filter_integration_test") {
  sources = [ "src/lib.rs" ]
  configs += [
    "//build/config/rust/lints:deny_unused_results",
    "//src/connectivity/network/netstack3:netstack3_configs",
  ]
  edition = "2024"
  proc_macro_deps = [ "//src/connectivity/lib/ip-test-macro" ]
  deps = [
    "//src/connectivity/lib/net-types",
    "//src/connectivity/lib/packet-formats",
    "//src/connectivity/network/netstack3/core:netstack3-core-testutils",
    "//src/connectivity/network/netstack3/core/base:netstack3-base-testutils",
    "//src/lib/network/packet",
    "//third_party/rust_crates:assert_matches",
    "//third_party/rust_crates:test-case",
  ]
}
fuchsia_unittest_package("netstack3-core-filter-integration-test") {
  package_name = "netstack3-core-filter-integration-test-gn"
  component_name = "netstack3-core-filter-integration-test"
  deps = [ ":netstack3_filter_integration_test" ]
}
