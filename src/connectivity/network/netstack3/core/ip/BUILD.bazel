load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "wrap_host_rust_test")
load("//build/bazel/rules/rust:rustc_check_cfg_build_flags.bzl", "rustc_check_cfg_build_flags")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_check_cfg_build_flags(
    name = "check_cfg_flags",
    cfgs = ["test"],
    features = [
        "testutils",
        "instrumented",
    ],
)

_COMMON_SRCS = [
    "src/api.rs",
    "src/base.rs",
    "src/base/tests.rs",
    "src/counters.rs",
    "src/device.rs",
    "src/device/api.rs",
    "src/device/config.rs",
    "src/device/dad.rs",
    "src/device/nud.rs",
    "src/device/nud/api.rs",
    "src/device/opaque_iid.rs",
    "src/device/route_discovery.rs",
    "src/device/router_solicitation.rs",
    "src/device/slaac.rs",
    "src/device/state.rs",
    "src/fragmentation.rs",
    "src/gmp.rs",
    "src/gmp/igmp.rs",
    "src/gmp/mld.rs",
    "src/gmp/testutil.rs",
    "src/gmp/v1.rs",
    "src/gmp/v2.rs",
    "src/gso.rs",
    "src/icmp.rs",
    "src/icmp/counters.rs",
    "src/ipv6.rs",
    "src/lib.rs",
    "src/local_delivery.rs",
    "src/multicast_forwarding.rs",
    "src/multicast_forwarding/api.rs",
    "src/multicast_forwarding/counters.rs",
    "src/multicast_forwarding/packet_queue.rs",
    "src/multicast_forwarding/route.rs",
    "src/multicast_forwarding/state.rs",
    "src/path_mtu.rs",
    "src/raw.rs",
    "src/raw/checksum.rs",
    "src/raw/counters.rs",
    "src/raw/filter.rs",
    "src/raw/protocol.rs",
    "src/raw/state.rs",
    "src/reassembly.rs",
    "src/routing.rs",
    "src/routing/rules.rs",
    "src/sas.rs",
    "src/socket.rs",
    "src/types.rs",
    "src/uninstantiable.rs",
]

_COMMON_BUILD_FLAGS = [
    ":check_cfg_flags",
    "//build/config/rust/lints:deny_unused_results",
    "//src/connectivity/network/netstack3:netstack3_configs",
]

# @bazel2gn:transformer=deps
_COMMON_PROC_MACRO_DEPS = [
    "//src/connectivity/network/netstack3/core/macros:netstack3-macros",
    "//third_party/rust_crates/vendor:derivative",
]

# @bazel2gn:transformer=deps
_COMMON_DEPS = [
    "//src/connectivity/lib/net-declare",
    "//src/connectivity/lib/net-types",
    "//src/connectivity/lib/packet-formats",
    "//src/connectivity/network/lib/diagnostics-traits",
    "//src/connectivity/network/lib/explicit",
    "//src/connectivity/network/netstack3/core/hashmap",
    "//src/connectivity/network/netstack3/core/lock-order",
    "//src/lib/network/packet",
    "//third_party/rust_crates/vendor:arrayvec",
    "//third_party/rust_crates/vendor:assert_matches",
    "//third_party/rust_crates/vendor:either",
    "//third_party/rust_crates/vendor:hmac",
    "//third_party/rust_crates/vendor:log",
    "//third_party/rust_crates/vendor:lru",
    "//third_party/rust_crates/vendor:rand",
    "//third_party/rust_crates/vendor:ref-cast",
    "//third_party/rust_crates/vendor:sha2",
    "//third_party/rust_crates/vendor:static_assertions",
    "//third_party/rust_crates/vendor:thiserror",
    "//third_party/rust_crates/vendor:zerocopy",
]

rustc_library(
    name = "netstack3-ip",
    srcs = _COMMON_SRCS,
    build_flags = _COMMON_BUILD_FLAGS,
    edition = "2024",
    proc_macro_deps = _COMMON_PROC_MACRO_DEPS,
    visibility = ["//src/connectivity/network/netstack3/core:__subpackages__"],
    deps = _COMMON_DEPS + [
        "//src/connectivity/network/netstack3/core/base:netstack3-base",
        "//src/connectivity/network/netstack3/core/filter:netstack3-filter",
        "//src/connectivity/network/netstack3/core/trace:netstack3-trace",
    ],
)

# A variant of the netstack3-ip library that exposes test utilities.
rustc_library(
    name = "netstack3-ip-testutils",
    testonly = True,
    srcs = _COMMON_SRCS,
    build_flags = _COMMON_BUILD_FLAGS,
    crate_features = [
        "testutils",
        "instrumented",
    ],
    crate_name = "netstack3_ip",
    edition = "2024",
    proc_macro_deps = _COMMON_PROC_MACRO_DEPS,
    visibility = ["//src/connectivity/network/netstack3/core:__subpackages__"],
    deps = _COMMON_DEPS + [
        "//src/connectivity/network/netstack3/core/base:netstack3-base-testutils",
        "//src/connectivity/network/netstack3/core/filter:netstack3-filter-testutils",
        "//src/connectivity/network/netstack3/core/trace:netstack3-trace-testutils",
    ],
)

rustc_library(
    name = "netstack3-ip-benchmarks",
    testonly = True,
    srcs = _COMMON_SRCS,
    build_flags = _COMMON_BUILD_FLAGS + ["//src/connectivity/network/netstack3/core:benchmark"],
    crate_features = ["testutils"],
    crate_name = "netstack3_ip",
    edition = "2024",
    proc_macro_deps = _COMMON_PROC_MACRO_DEPS,
    visibility = ["//src/connectivity/network/netstack3/core:__subpackages__"],
    deps = _COMMON_DEPS + [
        "//src/connectivity/network/netstack3/core/base:netstack3-base-benchmarks",
        "//src/connectivity/network/netstack3/core/filter:netstack3-filter-benchmarks",
        "//src/connectivity/network/netstack3/core/trace:netstack3-trace-testutils",
    ],
)

rustc_library(
    name = "netstack3-ip-instrumented",
    srcs = _COMMON_SRCS,
    build_flags = _COMMON_BUILD_FLAGS,
    crate_features = ["instrumented"],
    crate_name = "netstack3_ip",
    edition = "2024",
    proc_macro_deps = _COMMON_PROC_MACRO_DEPS,
    visibility = ["//src/connectivity/network/netstack3/core:__subpackages__"],
    deps = _COMMON_DEPS + [
        "//src/connectivity/network/netstack3/core/base:netstack3-base-instrumented",
        "//src/connectivity/network/netstack3/core/filter:netstack3-filter-instrumented",
        "//src/connectivity/network/netstack3/core/trace:netstack3-trace-instrumented",
    ],
)

rustc_library(
    name = "netstack3-ip-loom",
    testonly = True,
    srcs = _COMMON_SRCS,
    build_flags = _COMMON_BUILD_FLAGS + ["//src/connectivity/network/netstack3/core:loom"],
    crate_features = [
        "testutils",
        "instrumented",
    ],
    crate_name = "netstack3_ip",
    edition = "2024",
    proc_macro_deps = _COMMON_PROC_MACRO_DEPS,
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//src/connectivity/network/netstack3/core:__subpackages__"],
    deps = _COMMON_DEPS + [
        "//src/connectivity/network/netstack3/core/base:netstack3-base-loom",
        "//src/connectivity/network/netstack3/core/filter:netstack3-filter-loom",
        "//src/connectivity/network/netstack3/core/trace:netstack3-trace-loom",
    ],
)

# Cannot attach to `:netstack3-ip-instrumented` via `crate` because unit tests
# require `netstack3-base-testutils`, `netstack3-filter-testutils`, and
# `netstack3-trace-testutils`.
# @bazel2gn:skip
rustc_test(
    name = "netstack3-ip-instrumented_test",
    srcs = _COMMON_SRCS,
    build_flags = _COMMON_BUILD_FLAGS,
    crate_features = ["instrumented"],
    edition = "2024",
    proc_macro_deps = _COMMON_PROC_MACRO_DEPS + [
        "//src/connectivity/lib/ip-test-macro",
    ],
    deps = _COMMON_DEPS + [
        "//src/connectivity/network/netstack3/core/base:netstack3-base-testutils",
        "//src/connectivity/network/netstack3/core/filter:netstack3-filter-testutils",
        "//src/connectivity/network/netstack3/core/trace:netstack3-trace-testutils",
        "//third_party/rust_crates/vendor:itertools",
        "//third_party/rust_crates/vendor:proptest",
        "//third_party/rust_crates/vendor:test-case",
    ],
)

# @bazel2gn:skip
wrap_host_rust_test(
    name = "netstack3-ip-host-test",
    binary_name = "netstack3-ip-instrumented_test",
)

# @bazel2gn:skip
fx_unittest_package(
    name = "netstack3-core-ip-test",
    unit_tests = [":netstack3-ip-instrumented_test"],
)
