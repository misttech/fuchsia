load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "wrap_host_rust_test")
load("//build/bazel/rules/rust:defs.bzl", "rustc_library", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "lock-order",
    srcs = [
        "src/lib.rs",
        "src/lock.rs",
        "src/relation.rs",
        "src/wrap.rs",
    ],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    edition = "2024",
    visibility = ["//src/connectivity/network/netstack3/core:__subpackages__"],
)

rustc_test(
    name = "lock-order_test",
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate = ":lock-order",
    edition = "2024",
    visibility = ["//visibility:private"],
)

wrap_host_rust_test(
    name = "lock-order_host_test",
    binary_name = "lock-order_test",
    visibility = ["//visibility:public"],
)

fx_unittest_package(
    name = "lock-order-test-package",
    package_name = "lock-order-test",
    unit_tests = [":lock-order_test"],
    visibility = ["//visibility:public"],
)
