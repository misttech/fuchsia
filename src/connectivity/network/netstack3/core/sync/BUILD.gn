import("//build/bazel/bazel_test_suite.gni")

bazel_test_suite("netstack3-sync-tests") {
  target_tests = [
    "//src/connectivity/network/netstack3/core/sync:netstack3-sync-instrumented-package",
    "//src/connectivity/network/netstack3/core/sync:netstack3-sync-package",
  ]
  host_tests = [ "//src/connectivity/network/netstack3/core/sync:netstack3-sync-instrumented_host_test" ]
}

group("tests") {
  testonly = true
  public_deps = [
    ":netstack3-sync($host_toolchain)",
    ":netstack3-sync-instrumented-package",
    ":netstack3-sync-instrumented_test($host_toolchain)",
    ":netstack3-sync-package",
    ":netstack3-sync-tests",
  ]
}

