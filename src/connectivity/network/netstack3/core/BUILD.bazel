# LINT.IfChange(loom)
# The loom crate documentation recommends compiling with optimizations since
# the number of iterations can be large enough to make tests unreasonably slow
# otherwise.
# @bazel2gn:skip
build_flags(
    name = "loom",
    rustflags = ["--cfg=loom"],
    subflags = ["//build/config:optimize_moderate"],
    visibility = ["//src/connectivity/network/netstack3/core:__subpackages__"],
)
# LINT.ThenChange(//src/connectivity/network/netstack3/core/BUILD.gn:loom)

# LINT.IfChange(benchmark)
# @bazel2gn:skip
build_flags(
    name = "benchmark",
    rustflags = ["--cfg=benchmark"],
    visibility = ["//src/connectivity/network/netstack3:__subpackages__"],
)
# LINT.ThenChange(//src/connectivity/network/netstack3/core/BUILD.gn:benchmark)

# LINT.IfChange(no_lock_order)
# Disable lock ordering to speed-up compilation.
# @bazel2gn:skip
build_flags(
    name = "no_lock_order",
    rustflags = ["--cfg=no_lock_order"],
)
# LINT.ThenChange(//src/connectivity/network/netstack3/core/BUILD.gn:no_lock_order)

# LINT.IfChange(no_lock_order_except_debug_device)
# Only re-enabled lock order checks for debug non-host configurations.
#
# Keeping it disabled for host builds makes it easier to spot
# conditional compilation problems when building a debug image.
# @bazel2gn:skip
build_flags(
    name = "no_lock_order_except_debug_device",
    rustflags = select({
        "//build/bazel/platforms:is_host_os": ["--cfg=no_lock_order"],
        "//conditions:default": [],
    }) if is_debug else ["--cfg=no_lock_order"],
)
# LINT.ThenChange(//src/connectivity/network/netstack3/core/BUILD.gn:no_lock_order_except_debug_device)

rustc_check_cfg_build_flags(
    name = "check_cfg_flags",
    cfgs = [
        "benchmark",
        "loom",
        "no_lock_order",
        "test",
    ],
    features = [
        "instrumented",
        "testutils",
    ],
)

