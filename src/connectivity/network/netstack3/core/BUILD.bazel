# @bazel2gn:raw_attribute:assert_no_deps = _ALL_CORE_CRATES - _CORE_DEPS
rustc_library(
    name = "netstack3-core",
    srcs = _COMMON_SRCS,
    build_flags = _COMMON_BUILD_FLAGS + [":no_lock_order"],
    edition = "2024",
    proc_macro_deps = _COMMON_PROC_MACRO_DEPS,
    # Guard against bad crate variants.
    tags = assert_no_deps_tags(_ALL_CORE_CRATES, _CORE_DEPS),  # @bazel2gn:skip
    visibility = ["//src/connectivity/network/netstack3:__pkg__"],
    deps = _COMMON_DEPS + _CORE_DEPS,
)

# A variant of the netstack3-core library that has additional
# instrumentation that is useful for debugging and testing.
# @bazel2gn:raw_attribute:assert_no_deps = _ALL_CORE_CRATES - _INSTRUMENTED_CORE_DEPS
rustc_library(
    name = "netstack3-core-instrumented",
    srcs = _COMMON_SRCS,
    build_flags = _COMMON_BUILD_FLAGS + [":no_lock_order_except_debug_device"],
    crate_features = ["instrumented"],
    crate_name = "netstack3_core",
    edition = "2024",
    proc_macro_deps = _COMMON_PROC_MACRO_DEPS,
    # Guard against bad crate variants.
    tags = assert_no_deps_tags(_ALL_CORE_CRATES, _INSTRUMENTED_CORE_DEPS),  # @bazel2gn:skip
    visibility = ["//src/connectivity/network/netstack3:__pkg__"],
    deps = _COMMON_DEPS + _INSTRUMENTED_CORE_DEPS,
)

# A variant of the netstack3-core library that exposes test utilities.
# @bazel2gn:raw_attribute:assert_no_deps = _ALL_CORE_CRATES - _TESTUTILS_CORE_DEPS
rustc_library(
    name = "netstack3-core-testutils",
    testonly = True,
    srcs = _COMMON_SRCS,
    build_flags = _COMMON_BUILD_FLAGS + [":no_lock_order"],
    crate_features = [
        "instrumented",
        "testutils",
    ],
    crate_name = "netstack3_core",
    edition = "2024",
    proc_macro_deps = _COMMON_PROC_MACRO_DEPS,
    # Guard against bad crate variants.
    tags = assert_no_deps_tags(_ALL_CORE_CRATES, _TESTUTILS_CORE_DEPS),  # @bazel2gn:skip
    visibility = ["//src/connectivity/network/netstack3:__subpackages__"],
    deps = _COMMON_DEPS + _TESTUTILS_DEPS + _TESTUTILS_CORE_DEPS,
)

# A variant of the netstack3-core library that is built for running
# benchmarks.
# @bazel2gn:raw_attribute:assert_no_deps = _ALL_CORE_CRATES - _BENCHMARKS_CORE_DEPS
rustc_library(
    name = "netstack3-core-benchmarks",
    testonly = True,
    srcs = _COMMON_SRCS,
    build_flags = _COMMON_BUILD_FLAGS + [
        ":benchmark",
        ":no_lock_order",
    ],
    crate_features = ["testutils"],
    crate_name = "netstack3_core",
    edition = "2024",
    proc_macro_deps = _COMMON_PROC_MACRO_DEPS,
    # Guard against bad crate variants.
    tags = assert_no_deps_tags(_ALL_CORE_CRATES, _BENCHMARKS_CORE_DEPS),  # @bazel2gn:skip
    visibility = ["//src/connectivity/network/netstack3/bench:__pkg__"],
    deps = _COMMON_DEPS + _TESTUTILS_DEPS + _BENCHMARKS_CORE_DEPS,
)

# A variant of the netstack3-core library that is built for running loom
# tests, by using instrumented loom-provided types for all
# synchronization.
# @bazel2gn:raw_attribute:assert_no_deps = _ALL_CORE_CRATES - _LOOM_CORE_DEPS
rustc_library(
    name = "netstack3-core-loom",
    testonly = True,
    srcs = _COMMON_SRCS,
    build_flags = _COMMON_BUILD_FLAGS + [
        ":loom",
        ":no_lock_order",
    ],
    crate_features = [
        "instrumented",
        "testutils",
    ],
    crate_name = "netstack3_core",
    edition = "2024",
    proc_macro_deps = _COMMON_PROC_MACRO_DEPS,
    # Guard against bad crate variants.
    tags = assert_no_deps_tags(_ALL_CORE_CRATES, _LOOM_CORE_DEPS),  # @bazel2gn:skip
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//src/connectivity/network/netstack3/core/tests:__pkg__"],
    deps = _COMMON_DEPS + _TESTUTILS_DEPS + _LOOM_CORE_DEPS,
)

# Cannot attach to `:netstack3-core-instrumented` via `crate` because unit tests
# require `-testutils` variants of core subcrates.
rustc_test(
    name = "netstack3-core-instrumented_test",
    srcs = _COMMON_SRCS,
    build_flags = _COMMON_BUILD_FLAGS + [":no_lock_order_except_debug_device"],
    crate_features = ["instrumented"],
    edition = "2024",
    proc_macro_deps = _COMMON_PROC_MACRO_DEPS,
    deps = _COMMON_DEPS + _TESTUTILS_DEPS + _TESTUTILS_CORE_DEPS,
)

wrap_host_rust_test(
    name = "netstack3-core-host-test",
    binary_name = "netstack3-core-instrumented_test",
    visibility = ["//src/connectivity/network:__pkg__"],
)

fx_unittest_package(
    name = "netstack3-core-test-package",
    package_name = "netstack3-core-test",
    unit_tests = [":netstack3-core-instrumented_test"],
    visibility = ["//src/connectivity/network:__pkg__"],
)
