import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("sockaddr") {
  sources = [ "src/lib.rs" ]
  configs += [ "//build/config/rust/lints:deny_unused_results" ]
  edition = "2024"
  visibility = [
    ":*",
    "//src/connectivity/network/*",
    "//src/lib/network/fidl_fuchsia_posix_socket_ext:*",
  ]
  deps = [
    "//src/connectivity/lib/net-types",
    "//src/connectivity/lib/packet-formats",
    "//third_party/rust_crates:libc",
    "//third_party/rust_crates:socket2",
  ]
}
