import("//build/bazel/bazel_test_suite.gni")

bazel_test_suite("sockaddr-tests") {
  target_tests = [ "//src/connectivity/network/lib/sockaddr:sockaddr-tests" ]
  if (host_os == "linux") {
    host_tests =
        [ "//src/connectivity/network/lib/sockaddr:sockaddr_host_test" ]
  }
}

group("tests") {
  testonly = true
  deps = [ ":sockaddr-tests" ]
}

