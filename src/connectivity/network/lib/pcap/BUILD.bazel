load("//build/bazel/rules/rust:rustc_check_cfg_build_flags.bzl", "rustc_check_cfg_build_flags")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_check_cfg_build_flags(
    name = "check_cfg_flags",
    cfgs = ["test"],
    features = ["compile"],
)

_COMMON_SRCS = [
    "src/bindings.rs",
    "src/compile.rs",
    "src/lib.rs",
]

_COMMON_BUILD_FLAGS = [
    ":check_cfg_flags",
    "//build/config/rust/lints:deny_unused_results",
]

# @bazel2gn:transformer=deps
_COMMON_PROC_MACRO_DEPS = [
    "//third_party/rust_crates/vendor:strum_macros",
]

# @bazel2gn:transformer=deps
_COMMON_DEPS = [
    "//third_party/rust_crates/vendor:nom",
    "//third_party/rust_crates/vendor:thiserror",
    "//third_party/rust_crates/vendor:zerocopy",
]

rustc_library(
    name = "pcap",
    srcs = _COMMON_SRCS,
    build_flags = _COMMON_BUILD_FLAGS,
    edition = "2024",
    proc_macro_deps = _COMMON_PROC_MACRO_DEPS,
    visibility = ["//src/connectivity/network:__subpackages__"],
    deps = _COMMON_DEPS,
)

rustc_library(
    name = "pcap-compile",
    srcs = _COMMON_SRCS,
    build_flags = _COMMON_BUILD_FLAGS,
    crate_features = ["compile"],
    crate_name = "pcap",
    edition = "2024",
    link_deps = [
        "//third_party/libpcap",
    ],
    proc_macro_deps = _COMMON_PROC_MACRO_DEPS,
    visibility = ["//src/connectivity/network:__subpackages__"],
    deps = _COMMON_DEPS + [
        "//sdk/fidl/fuchsia.ebpf:fuchsia.ebpf_rust",
        "//sdk/fidl/fuchsia.net.debug:fuchsia.net.debug_rust",
        "//src/starnix/lib/ebpf",
        "//src/starnix/lib/ebpf_api",
        "//src/starnix/lib/linux_uapi",
    ],
)

rustc_test(
    name = "pcap_test",
    build_flags = _COMMON_BUILD_FLAGS,
    crate = ":pcap",
)

fx_unittest_package(
    name = "pcap-tests",
    unit_tests = [":pcap_test"],
)
