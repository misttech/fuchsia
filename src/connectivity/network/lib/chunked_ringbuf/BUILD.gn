import("//build/bazel/bazel_test_suite.gni")

bazel_test_suite("chunked-ringbuf-tests") {
  target_tests =
      [ "//src/connectivity/network/lib/chunked_ringbuf:chunked-ringbuf-tests" ]
}

group("tests") {
  testonly = true
  deps = [ ":chunked-ringbuf-tests" ]
}

