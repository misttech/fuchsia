import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("oneshot-sync") {
  sources = [ "src/lib.rs" ]
  configs += [ "//build/config/rust/lints:deny_unused_results" ]
  edition = "2024"
  rustflags = [
    "--check-cfg=cfg(loom)",
    "--check-cfg=cfg(test)",
  ]
  visibility = [
    ":*",
    "//src/connectivity/network/netlink:*",
  ]
}
if (is_host) {
  rustc_test("oneshot-sync-tests") {
    sources = [ "src/lib.rs" ]
    configs += [ "//build/config/rust/lints:deny_unused_results" ]
    edition = "2024"
    features = [
      "-asan",
      "-lsan",
    ]
    rustflags = [
      "--cfg=loom",
      "--check-cfg=cfg(loom)",
      "--check-cfg=cfg(test)",
    ]
    deps = [ "//third_party/rust_crates:loom" ]
  }
}
