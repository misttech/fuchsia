import("//build/bazel/bazel_test_suite.gni")

bazel_test_suite("bazel_tests") {
  host_tests =
      [ "//src/connectivity/network/lib/oneshot-sync:oneshot-sync-tests" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    ":oneshot-sync-tests($host_toolchain)",
  ]
}

