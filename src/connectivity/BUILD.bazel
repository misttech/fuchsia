load("@platforms//host:constraints.bzl", "HOST_CONSTRAINTS")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "target_tests",
    target_compatible_with = ["@platforms//os:fuchsia"],
    tests = [
        "//src/connectivity/bluetooth:target_tests",
        "//src/connectivity/location:target_tests",
        "//src/connectivity/lowpan/lib/spinel_pack:spinel-pack-tests",
        "//src/connectivity/network:target_tests",
    ],
)

test_suite(
    name = "host_tests",
    target_compatible_with = HOST_CONSTRAINTS,
    tests = [
        "//src/connectivity/lib/at-commands:host_tests",
        "//src/connectivity/lib/at-commands/codegen:host_tests",
        "//src/connectivity/lowpan/lib/spinel_pack:spinel_pack_host_test",
        "//src/connectivity/network:host_tests",
    ],
)
