import("//build/components.gni")
import("//build/test.gni")

group("tests") {
  testonly = true
  deps = [ ":ot-rcp-fuchsia-mock-spinel-host-unittests" ]
}

# A mock spinel FIDL client.
source_set("mock-spinel-host") {
  testonly = true
  visibility = [ "//src/connectivity/openthread/tests/ot-rcp-fuchsia/*" ]
  sources = [
    "mock_spinel_host.cc",
    "mock_spinel_host.h",
    "spinel_frame.cc",
    "spinel_frame.h",
  ]
  public_deps = [
    "//sdk/fidl/fuchsia.lowpan.spinel:fuchsia.lowpan.spinel_cpp",
    "//sdk/lib/async",
    "//sdk/lib/fidl/cpp",
    "//sdk/lib/fit",
    "//third_party/openthread:libopenthread-spinel-rcp",
    "//third_party/openthread/include/openthread",
    "//zircon/system/ulib/zx",
  ]
}

# Builders for IEEE 802.15.4 MAC frames (PSDUs) carried in Spinel STREAM_RAW.
source_set("mac-frame") {
  testonly = true
  visibility = [ "//src/connectivity/openthread/tests/ot-rcp-fuchsia/*" ]
  sources = [
    "mac_frame.cc",
    "mac_frame.h",
  ]
}

# gtest fixture that drives a MockSpinelHost the way lowpan-ot-driver drives an
# RCP (Open + reset sync, GET/SET with TID matching, raw link bring-up). The
# derived fixture launches the RCP and supplies the DeviceSetup client.
source_set("mock-spinel-host-fixture") {
  testonly = true
  visibility = [ "//src/connectivity/openthread/tests/ot-rcp-fuchsia/*" ]
  sources = [
    "mock_spinel_host_fixture.cc",
    "mock_spinel_host_fixture.h",
  ]
  public_deps = [
    ":mock-spinel-host",
    "//src/lib/testing/loop_fixture:gtest",
    "//third_party/googletest:gtest",
    "//zircon/system/ulib/zx",
  ]
  deps = [ "//src/lib/testing/predicates" ]
}

test("mock_spinel_host_unittests") {
  output_name = "ot_rcp_fuchsia_mock_spinel_host_unittests"
  visibility = [ ":*" ]
  sources = [ "spinel_frame_unittest.cc" ]
  deps = [
    ":mock-spinel-host",
    "//src/lib/fxl/test:gtest_main",
    "//third_party/googletest:gtest",
  ]
}

fuchsia_unittest_package("ot-rcp-fuchsia-mock-spinel-host-unittests") {
  visibility = [ ":*" ]
  deps = [ ":mock_spinel_host_unittests" ]
}
