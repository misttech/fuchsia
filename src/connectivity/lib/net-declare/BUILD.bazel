load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "wrap_host_rust_test")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_proc_macro.bzl", "rustc_proc_macro")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_proc_macro(
    name = "net-declare-macros",
    srcs = ["src/macros.rs"],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate_root = "src/macros.rs",
    edition = "2024",
    # @bazel2gn:skip
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = [
        "//src/connectivity/lib/net-types",
        "//third_party/rust_crates/vendor:proc-macro2",
        "//third_party/rust_crates/vendor:quote",
        "//third_party/rust_crates/vendor:syn",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)

# @bazel2gn:skip
rustc_test(
    name = "net-declare-macros_test",
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate = ":net-declare-macros",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = ["//third_party/rust_crates/vendor:assert_matches"],
)

# @bazel2gn:skip
wrap_host_rust_test(
    name = "net-declare-macros_host_test",
    binary_name = "net-declare-macros_test",
)

rustc_library(
    name = "net-declare",
    srcs = ["src/lib.rs"],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    edition = "2024",
    proc_macro_deps = [":net-declare-macros"],
    visibility = ["//visibility:public"],
    deps = ["//sdk/fidl/fuchsia.net:fuchsia.net_rust_common"],
)

# @bazel2gn:skip
rustc_test(
    name = "net-declare_test",
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate = ":net-declare",
    deps = ["//src/connectivity/lib/net-types"],
)

# @bazel2gn:skip
wrap_host_rust_test(
    name = "net-declare_host_test",
    binary_name = "net-declare_test",
)

fx_unittest_package(
    name = "net-declare-tests",
    unit_tests = [":net-declare_test"],
)
