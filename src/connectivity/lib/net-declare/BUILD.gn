import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_macro("net-declare-macros") {
  sources = [ "src/macros.rs" ]
  configs += [ "//build/config/rust/lints:deny_unused_results" ]
  source_root = "src/macros.rs"
  edition = "2024"
  deps = [
    "//src/connectivity/lib/net-types",
    "//third_party/rust_crates:proc-macro2",
    "//third_party/rust_crates:quote",
    "//third_party/rust_crates:syn",
    "//third_party/rust_crates:thiserror",
  ]
}
rustc_library("net-declare") {
  sources = [ "src/lib.rs" ]
  configs += [ "//build/config/rust/lints:deny_unused_results" ]
  edition = "2024"
  proc_macro_deps = [ ":net-declare-macros" ]
  visibility = [ "*" ]
  deps = [ "//sdk/fidl/fuchsia.net:fuchsia.net_rust_common" ]
}
