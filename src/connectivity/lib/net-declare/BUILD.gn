import("//build/bazel/bazel_test_suite.gni")

bazel_test_suite("net-declare-tests") {
  target_tests = [ "//src/connectivity/lib/net-declare:net-declare-tests" ]
  host_tests = [
    "//src/connectivity/lib/net-declare:net-declare-macros_host_test",
    "//src/connectivity/lib/net-declare:net-declare_host_test",
  ]
}

group("tests") {
  testonly = true
  deps = [ ":net-declare-tests" ]
}

