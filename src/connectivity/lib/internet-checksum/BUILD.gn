import("//build/tools/bazel2gn/bazel_migration.gni")

config("check_cfg_flags") {
  rustflags = [
    "--check-cfg=cfg(test)",
    "--check-cfg=cfg(feature, values(\"benchmark\"))",
  ]
}
rustc_library("internet-checksum") {
  sources = [ "src/lib.rs" ]
  configs += [
    ":check_cfg_flags",
    "//build/config/rust/lints:deny_unused_results",
    "//src/connectivity/network:performance_critical_rust_crate",
  ]
  edition = "2024"
  visibility = [
    ":*",
    "//src/connectivity/lib/*",
    "//src/connectivity/network/netstack3/core/device:*",
  ]
}
