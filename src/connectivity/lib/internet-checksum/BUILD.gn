import("//build/bazel/bazel_test_suite.gni")

bazel_test_suite("internet-checksum-tests") {
  target_tests =
      [ "//src/connectivity/lib/internet-checksum:internet-checksum-test" ]
  host_tests =
      [ "//src/connectivity/lib/internet-checksum:internet-checksum_host_test" ]
}

group("tests") {
  testonly = true
  public_deps = [ ":internet-checksum-tests" ]
}

group("benchmarks") {
  testonly = true
  deps = [ "benchmarks" ]
}

