load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "fidl_fuchsia_net_stack_ext",
    srcs = [
        "src/error.rs",
        "src/lib.rs",
    ],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    edition = "2024",
    visibility = [
        "//src/connectivity/lib:__pkg__",
        "//src/connectivity/network/net-cli:__pkg__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.net.stack:fuchsia.net.stack_rust_common",
        "//src/lib/fidl/rust/fidl",
        "//third_party/rust_crates/vendor:anyhow",
    ],
)

rustc_test(
    name = "fidl_fuchsia_net_stack_ext_test",
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate = ":fidl_fuchsia_net_stack_ext",
    edition = "2024",
)

fx_unittest_package(
    name = "fidl-fuchsia-net-stack-ext-tests",
    unit_tests = [":fidl_fuchsia_net_stack_ext_test"],
)
