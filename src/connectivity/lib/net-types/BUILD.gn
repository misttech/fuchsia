    "src/ethernet.rs",
    "src/ip.rs",
    "src/lib.rs",
  ]
  configs += [
    "//build/config/rust/lints:deny_unused_results",
    "//src/connectivity/network:performance_critical_rust_crate",
  ]
  features = [ "std" ]
  edition = "2024"
  proc_macro_deps = [ ":net-types-macros" ]
  visibility = [
    ":*",
    "//src/bringup/bin/netsvc/test/integration:*",
    "//src/connectivity/*",
    "//src/lib/network/*",
    "//src/starnix/kernel/core:*",
    "//src/starnix/modules/procfs:*",
    "//vendor/google/*",
  ]
  deps = [ "//third_party/rust_crates:zerocopy" ]
}
rustc_library("net-types-nostd") {
  sources = [
    "src/ethernet.rs",
    "src/ip.rs",
    "src/lib.rs",
  ]
  configs += [ "//build/config/rust/lints:deny_unused_results" ]
  edition = "2024"
  proc_macro_deps = [ ":net-types-macros" ]
  deps = [ "//third_party/rust_crates:zerocopy" ]
}
rustc_macro("net-types-macros") {
  sources = [ "src/macros.rs" ]
  configs += [ "//build/config/rust/lints:deny_unused_results" ]
  source_root = "src/macros.rs"
  edition = "2024"
  deps = [
    "//third_party/rust_crates:assert_matches",
    "//third_party/rust_crates:proc-macro2",
    "//third_party/rust_crates:quote",
    "//third_party/rust_crates:syn",
  ]
