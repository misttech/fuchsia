import("//build/bazel/bazel_test_suite.gni")

bazel_test_suite("bazel_tests") {
  target_tests = [ "//src/connectivity/lib/net-types:net-types-test-package" ]
  host_tests = [
    "//src/connectivity/lib/net-types:net-types-nostd_host_test",
    "//src/connectivity/lib/net-types:net-types-redaction_host_test",
    "//src/connectivity/lib/net-types:net-types_host_test",
  ]
}

group("tests") {
  testonly = true
  public_deps = [ ":bazel_tests" ]

  deps = [
    ":net-types-test-package",
    ":net-types_test($host_toolchain)",
  ]
}

