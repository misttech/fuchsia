load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "wrap_host_rust_test")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_proc_macro.bzl", "rustc_proc_macro")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "net-types",
    srcs = [
        "src/ethernet.rs",
        "src/ip.rs",
        "src/lib.rs",
    ],
    build_flags = [
        "//build/config/rust/lints:deny_unused_results",
        "//src/connectivity/network:performance_critical_rust_crate",
    ],
    crate_features = ["std"],
    edition = "2024",
    proc_macro_deps = [":net-types-macros"],
    visibility = [
        "//src/bringup/bin/netsvc/test/integration:__pkg__",
        "//src/connectivity:__subpackages__",
        "//src/lib/network:__subpackages__",
        "//src/starnix/kernel/core:__pkg__",
        "//src/starnix/modules/procfs:__pkg__",
        "//vendor/google:__subpackages__",
    ],
    deps = [
        "//src/diagnostics/lib/redactor",
        "//third_party/rust_crates/vendor:zerocopy",
    ],
)

# The net-types-nostd target is only used in tests, which run in Bazel.
# @bazel2gn:skip
rustc_library(
    name = "net-types-nostd",
    srcs = [
        "src/ethernet.rs",
        "src/ip.rs",
        "src/lib.rs",
    ],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    edition = "2024",
    proc_macro_deps = [":net-types-macros"],
    deps = [
        "//src/diagnostics/lib/redactor",
        "//third_party/rust_crates/vendor:zerocopy",
    ],
)

rustc_proc_macro(
    name = "net-types-macros",
    srcs = ["src/macros.rs"],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate_root = "src/macros.rs",
    edition = "2024",
    # @bazel2gn:skip
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = [
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:proc-macro2",
        "//third_party/rust_crates/vendor:quote",
        "//third_party/rust_crates/vendor:syn",
    ],
)

rustc_test(
    name = "net-types_test",
    build_flags = [
        "//build/config/rust/lints:deny_unused_results",
        "//src/connectivity/network:performance_critical_rust_crate",
    ],
    crate = ":net-types",
    deps = ["//third_party/rust_crates/vendor:test-case"],
)

# The net-types-nostd target is only used in tests, which run in Bazel.
# @bazel2gn:skip
rustc_test(
    name = "net-types-nostd_test",
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate = ":net-types-nostd",
    deps = ["//third_party/rust_crates/vendor:test-case"],
)

wrap_host_rust_test(
    name = "net-types_host_test",
    binary_name = "net-types_test",
)

wrap_host_rust_test(
    name = "net-types-nostd_host_test",
    binary_name = "net-types-nostd_test",
)

# Exercises the process-global redactor, so it must be its own binary.
rustc_test(
    name = "net-types-redaction_test",
    srcs = ["tests/redaction.rs"],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate_root = "tests/redaction.rs",
    edition = "2024",
    deps = [
        ":net-types",
        "//src/diagnostics/lib/redactor",
    ],
)

wrap_host_rust_test(
    name = "net-types-redaction_host_test",
    binary_name = "net-types-redaction_test",
)

fx_unittest_package(
    name = "net-types-test-package",
    package_name = "net-types-test",
    unit_tests = [
        ":net-types_test",
        # @bazel2gn:skip
        ":net-types-nostd_test",
        ":net-types-redaction_test",
    ],
)
