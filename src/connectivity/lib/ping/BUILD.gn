import("//build/bazel/bazel_test_suite.gni")

bazel_test_suite("bazel_tests") {
  target_tests = [ "//src/connectivity/lib/ping:ping-tests" ]
  host_tests = [ "//src/connectivity/lib/ping:ping_host_test" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    ":ping-tests",
    ":ping_test($host_toolchain)",
  ]
}

