load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "wrap_host_rust_test")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "packet-formats",
    srcs = [
        "src/arp.rs",
        "src/error.rs",
        "src/ethernet.rs",
        "src/gmp.rs",
        "src/icmp/common.rs",
        "src/icmp/icmpv4.rs",
        "src/icmp/icmpv6.rs",
        "src/icmp/macros.rs",
        "src/icmp/mld.rs",
        "src/icmp/mod.rs",
        "src/icmp/ndp.rs",
        "src/icmp/testdata.rs",
        "src/igmp/messages.rs",
        "src/igmp/mod.rs",
        "src/igmp/testdata.rs",
        "src/igmp/types.rs",
        "src/ip.rs",
        "src/ipv4.rs",
        "src/ipv6/ext_hdrs.rs",
        "src/ipv6/mod.rs",
        "src/lib.rs",
        "src/macros.rs",
        "src/tcp.rs",
        "src/testdata.rs",
        "src/testutil.rs",
        "src/udp.rs",
        "src/utils.rs",
    ],
    build_flags = [
        "//build/config/rust/lints:deny_unused_results",
        "//src/connectivity/network:performance_critical_rust_crate",
    ],
    edition = "2024",
    proc_macro_deps = [
        "//third_party/rust_crates/vendor:derivative",
    ],
    visibility = [
        "//src/bringup/bin/netsvc/test/integration:__pkg__",
        "//src/connectivity:__subpackages__",
        "//src/lib/network/fidl_fuchsia_net_ndp_ext:__pkg__",
        "//src/lib/network/fidl_fuchsia_posix_socket_ext:__pkg__",
    ],
    deps = [
        "//src/connectivity/lib/internet-checksum",
        "//src/connectivity/lib/net-types",
        "//src/connectivity/network/lib/explicit",
        "//src/lib/network/packet",
        "//third_party/rust_crates/vendor:byteorder",
        "//third_party/rust_crates/vendor:either",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:thiserror",
        "//third_party/rust_crates/vendor:zerocopy",
    ],
)

# @bazel2gn:skip
rustc_test(
    name = "packet-formats_test",
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate = ":packet-formats",
    proc_macro_deps = ["//src/connectivity/lib/ip-test-macro"],
    deps = [
        "//src/connectivity/lib/net-declare",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:test-case",
    ],
)

# @bazel2gn:skip
wrap_host_rust_test(
    name = "packet-formats_host_test",
    binary_name = "packet-formats_test",
)

fx_unittest_package(
    name = "packet-formats-test",
    unit_tests = [":packet-formats_test"],
)
