import("//build/components.gni")
import("//build/rust/rustc_test.gni")

# The library is defined in BUILD.bazel. The unit and integration tests stay in
# GN: netdev-rust-client-tests packages
# //src/connectivity/network/tun/network-tun:component, which is not built by
# Bazel yet.
rustc_test("rust_test") {
  output_name = "netdevice_client_lib_test"
  edition = "2024"

  sources = [
    "src/client.rs",
    "src/error.rs",
    "src/lib.rs",
    "src/port_slab.rs",
    "src/session/buffer/mod.rs",
    "src/session/buffer/pool.rs",
    "src/session/buffer/sys.rs",
    "src/session/mod.rs",
    "src/session/tx.rs",
  ]

  deps = [
    "//sdk/fidl/fuchsia.hardware.network:fuchsia.hardware.network_rust",
    "//sdk/rust/zx",
    "//src/connectivity/network/lib/explicit",
    "//src/lib/async-utils",
    "//src/lib/const-unwrap",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fidl_table_validation",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-runtime",
    "//src/lib/fuchsia-sync",
    "//src/lib/network/packet",
    "//third_party/rust_crates:arrayvec",
    "//third_party/rust_crates:assert_matches",
    "//third_party/rust_crates:derivative",
    "//third_party/rust_crates:event-listener",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:scopeguard",
    "//third_party/rust_crates:static_assertions",
    "//third_party/rust_crates:test-case",
    "//third_party/rust_crates:thiserror",
    "//third_party/rust_crates:zerocopy",
  ]

  configs += [ "//build/config/rust/lints:deny_unused_results" ]
  configs += [ "//src/connectivity/network:performance_critical_rust_crate" ]
}

rustc_test("tun-test") {
  edition = "2024"
  source_root = "tests/tun.rs"
  deps = [
    ":rust",
    "//sdk/fidl/fuchsia.hardware.network:fuchsia.hardware.network_rust",
    "//sdk/fidl/fuchsia.net.tun:fuchsia.net.tun_rust",
    "//sdk/rust/zx",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//third_party/rust_crates:assert_matches",
    "//third_party/rust_crates:futures",
  ]
  sources = [ "tests/tun.rs" ]

  configs += [ "//build/config/rust/lints:deny_unused_results" ]
}

fuchsia_component("tun-test-component") {
  testonly = true
  manifest = "tests/meta/tun-test.cml"
  deps = [ ":tun-test" ]
}

fuchsia_unittest_component("netdev-rust-client-unittest-component") {
  deps = [ ":rust_test" ]
}

fuchsia_test_package("netdev-rust-client-tests") {
  test_components = [
    ":tun-test-component",
    ":netdev-rust-client-unittest-component",
  ]
  deps = [ "//src/connectivity/network/tun/network-tun:component" ]
}

group("tests") {
  testonly = true

  deps = [ ":netdev-rust-client-tests" ]
}

