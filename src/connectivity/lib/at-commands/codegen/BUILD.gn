import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("codegen_lib") {
  sources = [
    "src/codegen/common.rs",
    "src/codegen/error.rs",
    "src/codegen/lower.rs",
    "src/codegen/raise.rs",
    "src/codegen/toplevel.rs",
    "src/codegen/types.rs",
    "src/definition.rs",
    "src/grammar.rs",
    "src/lib.rs",
    "src/parser.rs",
  ]
  configs += [ "//build/config/rust/lints:deny_unused_results" ]
  edition = "2024"
  proc_macro_deps = [ "//third_party/rust_crates:pest_derive" ]
  deps = [
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:pest",
    "//third_party/rust_crates:thiserror",
  ]
}
if (is_host) {
  rustc_binary("codegen") {
    sources = [ "src/main.rs" ]
    configs += [ "//build/config/rust/lints:deny_unused_results" ]
    output_name = "at_command_gen"
    edition = "2024"
    visibility = [
      ":*",
      "//src/connectivity/lib/at-commands:*",
    ]
    deps = [
      ":codegen_lib",
      "//third_party/rust_crates:anyhow",
      "//third_party/rust_crates:argh",
      "//third_party/rust_crates:log",
      "//third_party/rust_crates:simplelog",
    ]
  }
}
if (is_host) {
  rustc_test("codegen_parser_tests") {
    sources = [ "src/parser_tests.rs" ]
    configs += [ "//build/config/rust/lints:deny_unused_results" ]
    source_root = "src/parser_tests.rs"
    edition = "2024"
    deps = [ ":codegen_lib" ]
  }
}
