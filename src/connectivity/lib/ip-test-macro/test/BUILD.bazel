load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "wrap_host_rust_test")
load("//build/bazel/rules/rust:rustc_proc_macro.bzl", "rustc_proc_macro")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_proc_macro(
    name = "fake-test-case",
    srcs = ["fake_test_case/lib.rs"],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate_root = "fake_test_case/lib.rs",
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = [
        "//third_party/rust_crates/vendor:quote",
        "//third_party/rust_crates/vendor:syn",
    ],
)

rustc_test(
    name = "ip-test-macro_test",
    srcs = ["src/lib.rs"],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate_name = "ip_test_macro_integration_test",
    edition = "2024",
    proc_macro_deps = [
        ":fake-test-case",
        "//src/connectivity/lib/ip-test-macro",
    ],
    deps = ["//third_party/rust_crates/vendor:test-case"],
)

wrap_host_rust_test(
    name = "ip-test-macro_host_test",
    binary_name = "ip-test-macro_test",
)

fx_unittest_package(
    name = "ip-test-macro-test-package",
    package_name = "ip-test-macro-test",
    unit_tests = [":ip-test-macro_test"],
)
