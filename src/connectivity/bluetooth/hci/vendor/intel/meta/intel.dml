{
  name: "intel",
  include: [
    "driver_component/driver.shard.cml",
  ],
  program: {
    binary: "driver/bt-hci-intel.so",
    colocate: "true",
    default_dispatcher_opts: [
      "allow_sync_calls",
    ],
    bind: {
      protocol: "fuchsia.bluetooth.BIND_PROTOCOL.TRANSPORT",
      rules: {
        "fuchsia.BIND_USB_VID": "fuchsia.usb.BIND_USB_VID.INTEL",
        "fuchsia.BIND_USB_PID": [
          "0x07dc",
          "0x0a2a",
          "0x0aa7",
          "0x0025",
          "0x0026",
          "0x0032",
          "0x0a2b",
          "0x0aaa",
        ],
      },
    },
  },
  capabilities: [
    {
      service: "fuchsia.hardware.bluetooth.Service",
    },
  ],
  use: [
    {
      service: "fuchsia.hardware.bluetooth.HciService",
      name: "default",
      generate_bind_rule: false,
    },
  ],
  expose: [
    {
      service: "fuchsia.hardware.bluetooth.Service",
      from: "self",
    },
  ],
}
