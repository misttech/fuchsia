{
  name: "bt-transport-usb",
  include: [
    "//sdk/lib/driver/compat/compat.shard.cml",
  ],
  program: {
    compat: "driver/bt-transport-usb.so",
    default_dispatcher_opts: [
      "allow_sync_calls",
    ],
    colocate: "true",
    bind: {
      protocol: "fuchsia.usb.BIND_PROTOCOL.DEVICE",
      rules: {
        "fuchsia.BIND_USB_CLASS": "fuchsia.usb.BIND_USB_CLASS.WIRELESS",
        "fuchsia.BIND_USB_PROTOCOL": "fuchsia.usb.wireless.BIND_USB_PROTOCOL.BLUETOOTH",
        "fuchsia.BIND_USB_SUBCLASS": "fuchsia.usb.wireless.BIND_USB_SUBCLASS.MISC",
      },
    },
  },
  capabilities: [
    {
      service: "fuchsia.hardware.bluetooth.HciService",
    },
  ],
  expose: [
    {
      service: "fuchsia.hardware.bluetooth.HciService",
      from: "self",
    },
  ],
  use: [],
}
