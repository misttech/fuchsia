load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

# TODO(https://fxbug.dev/571945302): Migrate the unit tests, which remain in
# BUILD.gn.
rustc_library(
    name = "fuchsia-audio-dai",
    srcs = [
        "src/audio.rs",
        "src/discover.rs",
        "src/driver.rs",
        "src/lib.rs",
        "src/test.rs",
    ],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    edition = "2024",
    proc_macro_deps = ["//third_party/rust_crates/vendor:derivative"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = [
        "//src/connectivity/bluetooth/lib:__subpackages__",
        "//src/connectivity/bluetooth/profiles/tests/bt-hfp-audio-gateway-integration-tests:__pkg__",
        "//src/connectivity/bluetooth/tests/bt-manifest-integration-tests:__pkg__",
        "//src/connectivity/bluetooth/tools/dai-info:__pkg__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.hardware.audio:fuchsia.hardware.audio_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/fidl/fuchsia.media:fuchsia.media_rust",
        "//sdk/rust/zx",
        "//src/lib/fdio/rust:fdio",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-fs",
        "//src/lib/fuchsia-sync",
        "//src/storage/lib/vfs/rust:vfs",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
    ],
)
