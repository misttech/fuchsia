load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "bt-avdtp",
    srcs = [
        "src/lib.rs",
        "src/rtp.rs",
        "src/stream_endpoint.rs",
        "src/tests.rs",
        "src/types.rs",
    ],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    edition = "2024",
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = [
        "//src/connectivity/bluetooth/lib:__subpackages__",
        "//src/connectivity/bluetooth/profiles/bt-a2dp:__pkg__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.bluetooth.bredr:fuchsia.bluetooth.bredr_rust",
        "//sdk/rust/zx",
        "//src/connectivity/bluetooth/lib/fuchsia-bluetooth",
        "//src/connectivity/bluetooth/lib/packet-encoding",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-sync",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:bitfield",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:slab",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)

# @bazel2gn:skip
rustc_test(
    name = "bt-avdtp_test",
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate = ":bt-avdtp",
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//sdk/fidl/fuchsia.bluetooth:fuchsia.bluetooth_rust",
        "//src/connectivity/bluetooth/testing/bt-channel-test-support",
        "//src/lib/async-utils",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:test-case",
    ],
)

# @bazel2gn:skip
fx_unittest_package(
    name = "bt-avdtp-tests",
    package_name = "bt-avdtp-tests",
    max_log_severity = "ERROR",
    unit_tests = [":bt-avdtp_test"],
    visibility = ["//src/connectivity/bluetooth:__pkg__"],
)
