load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "async-helpers",
    srcs = [
        "src/hanging_get/async_server.rs",
        "src/hanging_get/mod.rs",
        "src/lib.rs",
        "src/maybe_stream.rs",
        "src/responding_channel.rs",
    ],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    edition = "2024",
    visibility = ["//src/connectivity/bluetooth:__subpackages__"],
    deps = [
        "//src/lib/async-utils",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
    ],
)

rustc_test(
    name = "async_helpers_lib_test",
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate = ":async-helpers",
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
    ],
)

rustc_library(
    name = "async-test-helpers",
    testonly = True,
    srcs = ["src/test/lib.rs"],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate_root = "src/test/lib.rs",
    edition = "2024",
    visibility = ["//src/connectivity/bluetooth:__subpackages__"],
    deps = [
        "//src/lib/async-utils",
        "//src/lib/fuchsia-async",
        "//third_party/rust_crates/vendor:futures",
    ],
)

fx_unittest_package(
    name = "async-helpers-tests",
    package_name = "async-helpers-tests",
    unit_tests = [":async_helpers_lib_test"],
    visibility = ["//src/connectivity/bluetooth:__pkg__"],
)
