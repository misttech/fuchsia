    ":*",
    "//src/connectivity/bluetooth/*",
  ]
  deps = [
    "//src/lib/async-utils",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
  ]
}
if (is_fuchsia) {
  rustc_test("async_helpers_lib_test") {
    sources = [
      "src/hanging_get/async_server.rs",
      "src/hanging_get/mod.rs",
      "src/lib.rs",
      "src/maybe_stream.rs",
      "src/responding_channel.rs",
    ]
    edition = "2024"
    deps = [
             "//src/lib/async-utils",
             "//third_party/rust_crates:anyhow",
             "//third_party/rust_crates:futures",
           ] +
           [
             "//src/lib/fuchsia",
             "//src/lib/fuchsia-async",
           ]
    configs += [ "//build/config/rust/lints:deny_unused_results" ]
  }
}

rustc_library("async-test-helpers") {
  testonly = true
  sources = [ "src/test/lib.rs" ]
  configs += [ "//build/config/rust/lints:deny_unused_results" ]
  source_root = "src/test/lib.rs"
  edition = "2024"
  visibility = [
    ":*",
    "//src/connectivity/bluetooth/*",
  ]
  deps = [
    "//src/lib/async-utils",
    "//src/lib/fuchsia-async",
    "//third_party/rust_crates:futures",
  ]
}

fuchsia_unittest_package("async-helpers-tests") {
  package_name = "async-helpers-tests-gn"
  component_name = "async-helpers-tests"
  deps = [ ":async_helpers_lib_test" ]
  visibility = [
    ":*",
    "//src/connectivity/bluetooth:*",
  ]
}
