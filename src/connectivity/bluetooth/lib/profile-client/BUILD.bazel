load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "profile-client",
    srcs = [
        "src/error.rs",
        "src/lib.rs",
    ],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    edition = "2024",
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = [
        "//src/connectivity/bluetooth:__subpackages__",
        "//vendor/google:__subpackages__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.bluetooth.bredr:fuchsia.bluetooth.bredr_rust",
        "//sdk/fidl/fuchsia.bluetooth:fuchsia.bluetooth_rust",
        "//src/connectivity/bluetooth/lib/fuchsia-bluetooth",
        "//src/lib/fidl/rust/fidl",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)

# @bazel2gn:skip
rustc_test(
    name = "profile-client_test",
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate = ":profile-client",
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//src/connectivity/bluetooth/testing/bt-channel-test-support",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//third_party/rust_crates/vendor:futures-test",
        "//third_party/rust_crates/vendor:test-case",
    ],
)

rustc_library(
    name = "test-profile-server",
    testonly = True,
    srcs = ["src/test/lib.rs"],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate_root = "src/test/lib.rs",
    edition = "2024",
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = [
        "//src/connectivity/bluetooth/lib/bt-hfp:__pkg__",
        "//src/connectivity/bluetooth/profiles/bt-hfp-hands-free:__pkg__",
        "//src/connectivity/bluetooth/profiles/bt-hid:__pkg__",
    ],
    deps = [
        ":profile-client",
        "//sdk/fidl/fuchsia.bluetooth.bredr:fuchsia.bluetooth.bredr_rust",
        "//sdk/fidl/fuchsia.bluetooth:fuchsia.bluetooth_rust",
        "//src/connectivity/bluetooth/lib/fuchsia-bluetooth",
        "//src/lib/fidl/rust/fidl",
        "//third_party/rust_crates/vendor:futures",
    ],
)

# @bazel2gn:skip
fx_unittest_package(
    name = "profile-client-tests",
    package_name = "profile-client-tests",
    unit_tests = [":profile-client_test"],
    visibility = ["//src/connectivity/bluetooth:__pkg__"],
)
