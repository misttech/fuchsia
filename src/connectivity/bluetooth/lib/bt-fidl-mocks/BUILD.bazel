load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "bt-fidl-mocks",
    srcs = [
        "src/expect.rs",
        "src/gatt.rs",
        "src/gatt2.rs",
        "src/hci.rs",
        "src/le.rs",
        "src/lib.rs",
        "src/sys.rs",
    ],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    edition = "2024",
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = [
        "//src/connectivity/bluetooth/lib:__pkg__",
        "//src/connectivity/bluetooth/tools/bt-cli:__pkg__",
        "//src/connectivity/bluetooth/tools/bt-fct-hci:__pkg__",
        "//src/connectivity/bluetooth/tools/bt-le-central:__pkg__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.bluetooth:fuchsia.bluetooth_rust",
        "//sdk/fidl/fuchsia.bluetooth.gatt:fuchsia.bluetooth.gatt_rust",
        "//sdk/fidl/fuchsia.bluetooth.gatt2:fuchsia.bluetooth.gatt2_rust",
        "//sdk/fidl/fuchsia.bluetooth.le:fuchsia.bluetooth.le_rust",
        "//sdk/fidl/fuchsia.bluetooth.sys:fuchsia.bluetooth.sys_rust",
        "//sdk/fidl/fuchsia.hardware.bluetooth:fuchsia.hardware.bluetooth_rust",
        "//sdk/rust/zx",
        "//src/connectivity/bluetooth/lib/fuchsia-bluetooth",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-async",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
    ],
)

rustc_test(
    name = "bt-fidl-mocks_test",
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate = ":bt-fidl-mocks",
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//src/lib/fuchsia",
    ],
)

fx_unittest_package(
    name = "bt-fidl-mocks-tests",
    package_name = "bt-fidl-mocks-tests",
    unit_tests = [":bt-fidl-mocks_test"],
    visibility = ["//src/connectivity/bluetooth:__pkg__"],
)
