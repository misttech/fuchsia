import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("objects") {
  sources = [
    "src/error.rs",
    "src/folder_listing.rs",
    "src/lib.rs",
  ]
  configs += [ "//build/config/rust/lints:deny_unused_results" ]
  edition = "2024"
  visibility = [
    ":*",
    "//src/connectivity/bluetooth/lib/bt-map:*",
    "//src/connectivity/bluetooth/lib/bt-obex:*",
    "//src/connectivity/bluetooth/profiles/bt-map-mce:*",
  ]
  deps = [
    "//third_party/rust_crates:bitflags",
    "//third_party/rust_crates:chrono",
    "//third_party/rust_crates:thiserror",
    "//third_party/rust_crates:xml",
  ]
}
if (is_fuchsia) {
  rustc_test("objects_test") {
    sources = [
      "src/error.rs",
      "src/folder_listing.rs",
      "src/lib.rs",
    ]
    edition = "2024"
    deps = [
             "//third_party/rust_crates:bitflags",
             "//third_party/rust_crates:chrono",
             "//third_party/rust_crates:thiserror",
             "//third_party/rust_crates:xml",
           ] + [ "//src/lib/fuchsia" ]
    configs += [ "//build/config/rust/lints:deny_unused_results" ]
  }
}
