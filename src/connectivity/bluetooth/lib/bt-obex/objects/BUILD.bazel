load(
    "@fuchsia_rules_common//packages:resources.bzl",
    "fuchsia_package_resource_group",
)
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

exports_files(
    ["test/bad_sample.xml"],
    visibility = ["//src/connectivity/bluetooth/lib/bt-map:__pkg__"],
)

rustc_library(
    name = "objects",
    srcs = [
        "src/error.rs",
        "src/folder_listing.rs",
        "src/lib.rs",
    ],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    edition = "2024",
    visibility = [
        "//src/connectivity/bluetooth/lib/bt-map:__pkg__",
        "//src/connectivity/bluetooth/lib/bt-obex:__pkg__",
        "//src/connectivity/bluetooth/profiles/bt-map-mce:__pkg__",
    ],
    deps = [
        "//third_party/rust_crates/vendor:bitflags",
        "//third_party/rust_crates/vendor:chrono",
        "//third_party/rust_crates/vendor:thiserror",
        "//third_party/rust_crates/vendor:xml",
    ],
)

rustc_test(
    name = "objects_test",
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate = ":objects",
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//src/lib/fuchsia",
    ],
)

# @bazel2gn:skip
fuchsia_package_resource_group(
    name = "objects-test-files",
    testonly = True,
    srcs = [
        "test/bad_sample.xml",
        "test/bad_sample_folder_listing_1.xml",
        "test/bad_sample_folder_listing_2.xml",
        "test/bad_sample_folder_listing_3.xml",
        "test/bad_sample_folder_listing_4.xml",
        "test/bad_sample_folder_listing_5.xml",
        "test/bad_sample_folder_listing_6.xml",
        "test/bad_sample_folder_listing_7.xml",
        "test/bad_sample_folder_listing_8.xml",
        "test/sample_folder_listing_1.xml",
        "test/sample_folder_listing_2.xml",
        "test/sample_folder_listing_3.xml",
    ],
    basename_only = True,
    dest = "data",
)

# @bazel2gn:skip
fx_unittest_package(
    name = "bt-obex-objects-tests",
    resources = [":objects-test-files"],
    unit_tests = [":objects_test"],
    visibility = ["//src/connectivity/bluetooth:__pkg__"],
)
