load("//build/bazel/rules/rust:defs.bzl", "rustc_library")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "bt-obex",
    srcs = [
        "src/client/get.rs",
        "src/client/mod.rs",
        "src/client/put.rs",
        "src/error.rs",
        "src/header/header_set.rs",
        "src/header/mod.rs",
        "src/header/obex_string.rs",
        "src/lib.rs",
        "src/operation.rs",
        "src/profile.rs",
        "src/server/get.rs",
        "src/server/handler.rs",
        "src/server/mod.rs",
        "src/server/put.rs",
        "src/transport.rs",
    ],
    edition = "2024",
    proc_macro_deps = ["//third_party/rust_crates/vendor:async-trait"],
    rustc_flags = ["-Dunused_results"],
    # @bazel2gn:skip
    test_deps = [
        "//src/connectivity/bluetooth/lib/async-helpers:async-test-helpers",
        "//src/connectivity/bluetooth/testing/bt-channel-test-support",
        "//src/lib/async-utils",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:test-case",
    ],
    visibility = [
        "//src/connectivity/bluetooth/examples/bt-opp-client:__pkg__",
        "//src/connectivity/bluetooth/lib:__subpackages__",
        "//src/connectivity/bluetooth/profiles/bt-map-mce:__pkg__",
    ],
    # @bazel2gn:skip
    with_unit_tests = True,
    deps = [
        "//sdk/fidl/fuchsia.bluetooth.bredr:fuchsia.bluetooth.bredr_rust",
        "//sdk/fidl/fuchsia.bluetooth:fuchsia.bluetooth_rust",
        "//sdk/rust/zx",
        "//src/connectivity/bluetooth/lib/bt-obex/objects",
        "//src/connectivity/bluetooth/lib/bt-rfcomm",
        "//src/connectivity/bluetooth/lib/fuchsia-bluetooth",
        "//src/connectivity/bluetooth/lib/packet-encoding",
        "//src/lib/fuchsia-sync",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:bitflags",
        "//third_party/rust_crates/vendor:chrono",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)

# @bazel2gn:skip
fx_unittest_package(
    name = "bt-obex-tests",
    package_name = "bt-obex-tests",
    unit_tests = [":bt-obex_test"],
    visibility = ["//src/connectivity/bluetooth:__pkg__"],
)
