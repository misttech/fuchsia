import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("vigil") {
  sources = [
    "src/dropped.rs",
    "src/lib.rs",
    "src/vigil.rs",
  ]
  configs += [ "//build/config/rust/lints:deny_unused_results" ]
  edition = "2024"
  visibility = [
    ":*",
    "//src/connectivity/bluetooth/lib/*",
    "//src/connectivity/bluetooth/profiles/bt-hfp-audio-gateway:*",
    "//src/connectivity/bluetooth/profiles/bt-hfp-hands-free:*",
  ]
  deps = [
    "//src/lib/diagnostics/inspect/derive",
    "//src/lib/diagnostics/inspect/rust",
    "//src/lib/fuchsia-sync",
    "//third_party/rust_crates:futures",
  ]
}
if (is_fuchsia) {
  rustc_test("vigil_test") {
    sources = [
      "src/dropped.rs",
      "src/lib.rs",
      "src/vigil.rs",
    ]
    edition = "2024"
    deps = [
             "//src/lib/diagnostics/inspect/derive",
             "//src/lib/diagnostics/inspect/rust",
             "//src/lib/fuchsia-sync",
             "//third_party/rust_crates:futures",
           ] +
           [
             "//src/lib/async-utils",
             "//third_party/rust_crates:futures-test",
           ]
    configs += [ "//build/config/rust/lints:deny_unused_results" ]
  }
}

fuchsia_unittest_package("vigil-tests") {
  package_name = "vigil-tests-gn"
  component_name = "vigil-tests"
  deps = [ ":vigil_test" ]
  visibility = [
    ":*",
    "//src/connectivity/bluetooth:*",
  ]
}
