    ]
  }
}
if (is_fuchsia) {
  rustc_test("battery-client_test") {
    sources = [
      "src/error.rs",
      "src/lib.rs",
    ]
    edition = "2024"
    proc_macro_deps = [ "//third_party/rust_crates:derivative" ]
    deps =
        [
