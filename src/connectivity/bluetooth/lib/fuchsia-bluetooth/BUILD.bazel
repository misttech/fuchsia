load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "fuchsia-bluetooth",
    srcs = [
        "src/assigned_numbers.rs",
        "src/assigned_numbers/constants.rs",
        "src/assigned_numbers/ltv.rs",
        "src/constants.rs",
        "src/detachable_map.rs",
        "src/error.rs",
        "src/expectation.rs",
        "src/expectation/asynchronous.rs",
        "src/expectation/host_driver.rs",
        "src/expectation/peer.rs",
        "src/expectation/test.rs",
        "src/inspect.rs",
        "src/lib.rs",
        "src/profile.rs",
        "src/profile/avrcp.rs",
        "src/types.rs",
        "src/types/address.rs",
        "src/types/bonding_data.rs",
        "src/types/channel.rs",
        "src/types/channel/fidl_client.rs",
        "src/types/channel/fidl_server.rs",
        "src/types/channel/socket.rs",
        "src/types/host_info.rs",
        "src/types/id.rs",
        "src/types/io_capabilities.rs",
        "src/types/le.rs",
        "src/types/pairing_options.rs",
        "src/types/peer.rs",
        "src/types/uuid.rs",
        "src/util.rs",
    ],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    edition = "2024",
    visibility = [
        "//src/connectivity/bluetooth:__subpackages__",
        "//src/developer/ffx/tools/bluetooth:__subpackages__",
        "//src/media/stream_processors/test:__pkg__",
        "//src/testing/sl4f:__pkg__",
        "//vendor/google:__subpackages__",
    ],
    # TODO(armansito): Split out testing code into a separate library and move
    # test-specific dependencies out.
    deps = [
        "//sdk/fidl/fuchsia.bluetooth.bredr:fuchsia.bluetooth.bredr_rust",
        "//sdk/fidl/fuchsia.bluetooth:fuchsia.bluetooth_rust",
        "//sdk/fidl/fuchsia.bluetooth.le:fuchsia.bluetooth.le_rust",
        "//sdk/fidl/fuchsia.bluetooth.sys:fuchsia.bluetooth.sys_rust",
        "//sdk/fidl/fuchsia.hardware.audio:fuchsia.hardware.audio_rust",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fidl_table_validation",
        "//src/lib/fuchsia-sync",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:bitflags",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:pretty",
        "//third_party/rust_crates/vendor:proptest",
        "//third_party/rust_crates/vendor:rand",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:thiserror",
        "//third_party/rust_crates/vendor:uuid",
    ] + select({
        "@platforms//os:fuchsia": [
            "//sdk/rust/zx",
            "//sdk/rust/zx-status-ext",
            "//src/lib/async-utils",
            "//src/lib/diagnostics/inspect/contrib/rust",
            "//src/lib/diagnostics/inspect/derive",
            "//src/lib/diagnostics/inspect/rust",
            "//src/lib/fuchsia-async",
            "//third_party/rust_crates/vendor:futures",
            "//third_party/rust_crates/vendor:slab",
        ],
        "//conditions:default": [],
    }),
)

rustc_test(
    name = "fuchsia-bluetooth_test",
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate = ":fuchsia-bluetooth",
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//src/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
        "//src/lib/fuchsia",
        "//third_party/rust_crates/vendor:assert_matches",
    ],
)

fx_unittest_package(
    name = "bluetooth-crate-tests",
    package_name = "bluetooth-crate-tests",
    unit_tests = [":fuchsia-bluetooth_test"],
    visibility = ["//src/connectivity/bluetooth:__pkg__"],
)
