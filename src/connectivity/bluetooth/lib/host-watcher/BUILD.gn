if (is_fuchsia) {
  rustc_library("host-watcher") {
    sources = [ "src/lib.rs" ]
    configs += [ "//build/config/rust/lints:deny_unused_results" ]
    edition = "2024"
    visibility = [
      ":*",
      "//src/connectivity/bluetooth/lib:*",
      "//src/connectivity/bluetooth/profiles/bt-fastpair-provider:*",
    ]
    deps = [
      "//sdk/fidl/fuchsia.bluetooth.sys:fuchsia.bluetooth.sys_rust",
      "//src/connectivity/bluetooth/lib/fuchsia-bluetooth",
      "//src/lib/async-utils",
      "//third_party/rust_crates:futures",
      "//third_party/rust_crates:log",
    ]
  }
}
if (is_fuchsia) {
  rustc_test("host-watcher_test") {
    sources = [ "src/lib.rs" ]
    edition = "2024"
    deps = [
             "//sdk/fidl/fuchsia.bluetooth.sys:fuchsia.bluetooth.sys_rust",
             "//src/connectivity/bluetooth/lib/fuchsia-bluetooth",
             "//src/lib/async-utils",
             "//third_party/rust_crates:futures",
             "//third_party/rust_crates:log",
           ] +
           [
             "//src/lib/fidl/rust/fidl",
             "//src/lib/fuchsia",
             "//src/lib/fuchsia-async",
             "//third_party/rust_crates:assert_matches",
           ]
    configs += [ "//build/config/rust/lints:deny_unused_results" ]
  }
}

fuchsia_unittest_package("host-watcher-tests") {
  package_name = "host-watcher-tests-gn"
  component_name = "host-watcher-tests"
  deps = [ ":host-watcher_test" ]
  visibility = [
    ":*",
    "//src/connectivity/bluetooth:*",
  ]
}
