# Bluetooth device tests defined in Bazel. These are exported to `fx test` and
# infra builders through //src/connectivity:target_tests.
test_suite(
    name = "target_tests",
    target_compatible_with = ["@platforms//os:fuchsia"],
    tests = [
        "//src/connectivity/bluetooth/lib/async-helpers:async-helpers-tests",
        "//src/connectivity/bluetooth/lib/battery-client:battery-client-tests",
        "//src/connectivity/bluetooth/lib/bt-a2dp:bt-a2dp-lib-tests",
        "//src/connectivity/bluetooth/lib/bt-avctp:bt-avctp-tests",
        "//src/connectivity/bluetooth/lib/bt-avdtp:bt-avdtp-tests",
        "//src/connectivity/bluetooth/lib/bt-avrcp-vol-control:bt-avrcp-vol-control-tests",
        "//src/connectivity/bluetooth/lib/bt-fidl-mocks:bt-fidl-mocks-tests",
        "//src/connectivity/bluetooth/lib/bt-gatt-fuchsia:bt-gatt-fuchsia-tests",
        "//src/connectivity/bluetooth/lib/bt-map:bt-map-tests",
        "//src/connectivity/bluetooth/lib/bt-obex:bt-obex-tests",
        "//src/connectivity/bluetooth/lib/bt-obex/objects:bt-obex-objects-tests",
        "//src/connectivity/bluetooth/lib/bt-rfcomm:bt-rfcomm-lib-tests",
        "//src/connectivity/bluetooth/lib/fuchsia-audio-device:fuchsia-audio-device-tests",
        "//src/connectivity/bluetooth/lib/fuchsia-bluetooth:bluetooth-crate-tests",
        "//src/connectivity/bluetooth/lib/host-watcher:host-watcher-tests",
        "//src/connectivity/bluetooth/lib/packet-encoding:packet-encoding-tests",
        "//src/connectivity/bluetooth/lib/profile-client:profile-client-tests",
        "//src/connectivity/bluetooth/lib/vigil:vigil-tests",
        "//src/connectivity/bluetooth/profiles/bt-avrcp-target:bt-avrcp-target-tests",
        "//src/connectivity/bluetooth/profiles/bt-map-mce:bt-map-mce-unittests",
        "//src/connectivity/bluetooth/profiles/bt-peripheral-hub:bt-peripheral-hub-tests",
        "//src/connectivity/bluetooth/testing/bt-affordances/affordances:fuchsia_bt_test_affordances_tests",
        "//src/connectivity/bluetooth/testing/test-call-manager:test-call-manager-tests",
        "//src/connectivity/bluetooth/testing/test-harness-tests:test-harness-crate-tests",
    ],
    visibility = ["//src/connectivity:__pkg__"],
)
