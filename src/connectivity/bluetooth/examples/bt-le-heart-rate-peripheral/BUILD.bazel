load("//build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")

package(default_applicable_licenses = ["//:license"])

fx_cc_binary(
    name = "bt-le-heart-rate-peripheral",
    srcs = [
        "app.cc",
        "app.h",
        "fidl_helpers.cc",
        "fidl_helpers.h",
        "heart_model.cc",
        "heart_model.h",
        "main.cc",
        "service.cc",
        "service.h",
    ],
    visibility = ["//src/connectivity/bluetooth/examples:__pkg__"],
    deps = [
        "//sdk/fidl/fuchsia.bluetooth.le:fuchsia.bluetooth.le_hlcpp",
        "//sdk/lib/async-loop:async-loop-cpp",
        "//sdk/lib/async-loop:async-loop-default",
        "//sdk/lib/sys/cpp",
        "//src/lib/fsl",
        "//src/lib/fxl:fxl_cli",
    ],
)
