load("//build/bazel/rules/components:fx_component.bzl", "fx_component", "fx_component_manifest")
load("//build/bazel/rules/packages:fx_packaged_binary.bzl", "fx_packaged_binary")
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")

package(default_applicable_licenses = ["//:license"])

rustc_binary(
    name = "mock_a2dp_controller_bin",
    testonly = True,
    srcs = ["src/main.rs"],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate_name = "mock_a2dp_controller",
    edition = "2024",
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = ["//visibility:private"],
    deps = [
        "//sdk/fidl/fuchsia.bluetooth.internal.a2dp:fuchsia.bluetooth.internal.a2dp_rust",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
    ],
)

fx_packaged_binary(
    name = "mock_a2dp_controller_bin_packaged_bin",
    testonly = True,
    binary = ":mock_a2dp_controller_bin",
    binary_name = "mock_a2dp_controller",
    target_compatible_with = ["@platforms//os:fuchsia"],
)

fx_component_manifest(
    name = "manifest",
    testonly = True,
    component_name = "mock-a2dp-controller",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/mock-a2dp-controller.cml",
    target_compatible_with = ["@platforms//os:fuchsia"],
)

fx_component(
    name = "mock-a2dp-controller",
    testonly = True,
    compiled_manifest = ":manifest",
    component_name = "mock-a2dp-controller",
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = [
        "//src/connectivity/bluetooth/profiles/bt-hfp-audio-gateway:__pkg__",
        "//src/connectivity/bluetooth/profiles/tests/bt-hfp-audio-gateway-integration-tests:__pkg__",
        "//src/connectivity/bluetooth/testing:__pkg__",
    ],
    deps = [":mock_a2dp_controller_bin_packaged_bin"],
)
