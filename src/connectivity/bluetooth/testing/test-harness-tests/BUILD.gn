    "//third_party/rust_crates:assert_matches",
    "//third_party/rust_crates:futures",
  ]
}

fuchsia_unittest_package("test-harness-crate-tests") {
  package_name = "test-harness-crate-tests-gn"
  component_name = "test-harness-crate-tests"
  deps = [ ":tests_bin" ]
  visibility = [
    ":*",
    "//src/connectivity/bluetooth:*",
  ]
}
