load("//build/bazel/rules/rust:defs.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_test(
    name = "tests_bin",
    srcs = ["src/lib.rs"],
    crate_name = "test_harness_crate_tests",
    edition = "2024",
    rustc_flags = ["-Dunused_results"],
    deps = [
        "//src/connectivity/bluetooth/testing/test-harness",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-sync",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:futures",
    ],
)

fx_unittest_package(
    name = "test-harness-crate-tests",
    package_name = "test-harness-crate-tests",
    unit_tests = [":tests_bin"],
    visibility = ["//src/connectivity/bluetooth:__pkg__"],
)
