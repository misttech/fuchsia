load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "test-battery-manager",
    testonly = True,
    srcs = ["src/lib.rs"],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    edition = "2024",
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = [
        "//src/connectivity/bluetooth/profiles/bt-a2dp:__pkg__",
        "//src/connectivity/bluetooth/profiles/bt-hfp-audio-gateway:__pkg__",
        "//src/connectivity/bluetooth/testing:__pkg__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.power.battery:fuchsia.power.battery_rust",
        "//src/connectivity/bluetooth/lib/battery-client",
        "//src/lib/fidl/rust/fidl",
        "//third_party/rust_crates/vendor:futures",
    ],
)
