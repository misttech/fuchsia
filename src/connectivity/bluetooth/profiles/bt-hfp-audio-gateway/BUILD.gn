import("//build/components.gni")

fuchsia_package("bt-hfp-audio-gateway-default") {
  deps = [ ":component" ]
}

fuchsia_package("without-config") {
  package_name = "bt-hfp-audio-gateway"
  validate_structured_config = false
  deps = [ ":component" ]
}

group("bt-hfp-audio-gateway") {
  deps = [ ":bt-hfp-audio-gateway-default" ]
}

# GN copy of the Bazel `bt-hfp-audio-gateway-tests` package, written by hand
# because bazel2gn doesn't support `target_compatible_with` on an `fx_package`
# with `test_components`. Unlike the Bazel package, it keeps the
# `codec_factory_for_test` subpackage.
fuchsia_test_component("test-component") {
  manifest = "meta/bt-hfp-audio-gateway-tests.cml"
  deps = [ ":bt_hfp_audio_gateway_bin_test" ]
  test_type = "system"
}

fuchsia_test_package("bt-hfp-audio-gateway-tests") {
  package_name = "bt-hfp-audio-gateway-tests-gn"
  test_components = [ ":test-component" ]
  deps = [
    # The component mock for the `fuchsia.bluetooth.internal.a2dp.Controller`
    # capability.
    "//src/connectivity/bluetooth/testing/mock-a2dp-controller",
  ]
  subpackages = [ "//src/media/codec:codec_factory_for_test" ]
}

group("tests") {
  testonly = true
  deps = [ ":bt-hfp-audio-gateway-tests" ]
}

