load(
    "@rules_fuchsia//fuchsia:defs.bzl",
    "fuchsia_package_resource",
)
load("@rules_license//rules:license.bzl", "license")
load("//build/bazel/rules:cipd_prebuilt.bzl", "cipd_prebuilt_file")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

cipd_prebuilt_file(
    name = "license_text",
    applicable_licenses = [],
    path = "//prebuilt/connectivity/wlan/firmware/intel/iwlwifi/LICENCE.iwlwifi_firmware",
)

license(
    name = "license",
    package_name = "iwlwifi firmware",
    license_text = ":license_text",
)

cipd_prebuilt_file(
    name = "prebuilt_iwlwifi-7265D-29",
    path = "//prebuilt/connectivity/wlan/firmware/intel/iwlwifi/iwlwifi-7265D-29.ucode",
)

fuchsia_package_resource(
    name = "iwlwifi-firmware-iwlwifi-7265D-29",
    src = ":prebuilt_iwlwifi-7265D-29",
    dest = "lib/firmware/iwlwifi/iwlwifi-7265D-29.ucode",
)

