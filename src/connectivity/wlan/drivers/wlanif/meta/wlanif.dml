{
  name: "wlanif",
  include: [
    "driver_component/driver.shard.cml",
  ],
  program: {
    colocate: "true",
    default_dispatcher_opts: [
      "allow_sync_calls",
    ],
    bind: {
      service: "fuchsia.wlan.fullmac.Service",
    },
  },
  use: [
    {
      service: "fuchsia.wlan.fullmac.Service",
      name: "default",
      generate_bind_rule: false,
    },
  ],
}
