load("//build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

fx_cc_binary(
    name = "event_unittests",
    testonly = True,
    srcs = ["event_unittests.cc"],
    # TODO(https://fxbug.dev/42136089): delete the below and fix compiler warnings
    copts = ["-Wno-conversion"],
    tags = ["manual"],
    deps = [
        "//sdk/lib/async",
        "//src/connectivity/wlan/drivers/testing/lib/sim-env",
        "//src/lib/fxl/test:gtest_main",
    ],
)

fx_cc_binary(
    name = "rx_tests",
    testonly = True,
    srcs = ["rx_tests.cc"],
    # TODO(https://fxbug.dev/42136089): delete the below and fix compiler warnings
    copts = ["-Wno-conversion"],
    tags = ["manual"],
    deps = [
        "//src/connectivity/wlan/drivers/lib/macaddr",
        "//src/connectivity/wlan/drivers/testing/lib/sim-env",
        "//src/lib/fxl/test:gtest_main",
        # Bazel's gtest target bundles gmock; GN's :gmock publicly depends on :gtest.
        "@com_google_googletest//:gtest",  # @bazel2gn:path_overwrite://third_party/googletest:gmock
    ],
)

