load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "wlan-dev",
    srcs = [
        "src/lib.rs",
        "src/opts.rs",
    ],
    edition = "2024",
    visibility = ["//src/connectivity/wlan/tools/wlantool/cli:__pkg__"],
    deps = [
        "//sdk/fidl/fuchsia.wlan.common:fuchsia.wlan.common_rust",
        "//sdk/fidl/fuchsia.wlan.device.service:fuchsia.wlan.device.service_rust",
        "//sdk/fidl/fuchsia.wlan.ieee80211:fuchsia.wlan.ieee80211_rust",
        "//sdk/fidl/fuchsia.wlan.internal:fuchsia.wlan.internal_rust",
        "//sdk/fidl/fuchsia.wlan.sme:fuchsia.wlan.sme_rust",
        "//sdk/rust/zx-status",
        "//sdk/rust/zx-types",
        "//src/connectivity/wlan/lib/common/rust:wlan-common",
        "//src/connectivity/wlan/lib/ieee80211",
        "//src/lib/fidl/rust/fidl",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:clap",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:itertools",
    ] + select({
        "@platforms//os:fuchsia": [
            "//src/connectivity/wlan/lib/rsn:wlan-rsn",
            "//third_party/rust_crates/vendor:hex",
        ],
        "//conditions:default": [],
    }),
)

rustc_test(
    name = "wlan-dev_test",
    crate = ":wlan-dev",
    deps = [
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//third_party/rust_crates/vendor:assert_matches",
    ],
)

fx_unittest_package(
    name = "wlantool-tests",
    unit_tests = [":wlan-dev_test"],
    visibility = ["//src/connectivity/wlan:__pkg__"],
)
