# `wlancfg_lib_test`, `wlancfg_bin_test`, and `wlancfg-tests` remain in
# `BUILD.gn` above the sentinel because `wlancfg-tests` packages
# `//src/sys/stash:stash_secure_v2`, which is not built by Bazel yet.
rustc_test(
    name = "lib_test",
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate = ":lib",
    crate_name = "wlancfg_lib_lib_test",
    proc_macro_deps = [
        "//src/connectivity/wlan/wlancfg/src/util/testing/macros:proc_macros",
    ],
    deps = [
        "//sdk/fidl/fuchsia.net:fuchsia.net_rust",
        "//sdk/fidl/fuchsia.stash:fuchsia.stash_rust",
        "//src/connectivity/wlan/lib/ieee80211-testutils",
        "//src/connectivity/wlan/lib/power_manager:power_manager_testing",
        "//src/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
        "//src/lib/fuchsia",
        "//src/lib/test_util",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:hex",
        "//third_party/rust_crates/vendor:regex",
        "//third_party/rust_crates/vendor:test-case",
    ],
)

rustc_binary(
    name = "bin",
    srcs = ["src/main.rs"],
    binary_name = "wlancfg",
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    deps = [
        ":lib",
        ":wlancfg-config",
        "//sdk/fidl/fuchsia.location.namedplace:fuchsia.location.namedplace_rust",
        "//sdk/fidl/fuchsia.metrics:fuchsia.metrics_rust",
        "//sdk/fidl/fuchsia.power.broker:fuchsia.power.broker_rust",
        "//sdk/fidl/fuchsia.power.system:fuchsia.power.system_rust",
        "//sdk/fidl/fuchsia.process.lifecycle:fuchsia.process.lifecycle_rust",
        "//sdk/fidl/fuchsia.wlan.device.service:fuchsia.wlan.device.service_rust",
        "//sdk/fidl/fuchsia.wlan.policy:fuchsia.wlan.policy_rust",
        "//sdk/rust/zx",
        "//src/connectivity/wlan/lib/power_manager",
        "//src/connectivity/wlan/lib/trace:wlan-trace",
        "//src/lib/diagnostics/inspect/runtime/rust",
        "//src/lib/diagnostics/inspect/rust:fuchsia-inspect",
        "//src/lib/diagnostics/log/rust",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-runtime",
        "//src/lib/trace/rust:trace-provider",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
    ],
)

rustc_test(
    name = "bin_test",
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate = ":bin",
    crate_name = "wlancfg_bin_test",
    proc_macro_deps = [
        "//third_party/rust_crates/vendor:async-trait",
    ],
    deps = [
        "//src/connectivity/wlan/lib/ieee80211",
        "//third_party/rust_crates/vendor:assert_matches",
    ],
)

fx_packaged_binary(
    name = "wlancfg_packaged_bin",
    binary = ":bin",
    binary_name = "wlancfg",
)

fx_component_manifest(
    name = "wlancfg-manifest",
    component_name = "wlancfg",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/syslog:client.shard",
    ],
    manifest = "meta/wlancfg.cml",
)

fuchsia_structured_config_rust_lib(
    name = "wlancfg-config",
    cm_label = ":wlancfg-manifest",
)

fx_component(
    name = "service",
    compiled_manifest = ":wlancfg-manifest",
    deps = [":wlancfg_packaged_bin"],
)

metrics_registry(
    name = "wlan_metrics_registry",
    generate_rust = True,  # Generates a rust target with '_rustlib' appended
    # This must match the ID of our Cobalt project as specified in:
    # //third_party/cobalt_config/projects.yaml
    project_id = 3708719327,
)
