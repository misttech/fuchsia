load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")

package(default_applicable_licenses = ["//:license"])

rustc_binary(
    name = "bin",
    srcs = ["src/main.rs"],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate_name = "donut",
    edition = "2024",
    visibility = ["//src/connectivity/wlan/wlancfg/tool:__pkg__"],
    deps = [
        "//sdk/fidl/fuchsia.wlan.policy:fuchsia.wlan.policy_rust",
        "//sdk/fidl/fuchsia.wlan.product.deprecatedconfiguration:fuchsia.wlan.product.deprecatedconfiguration_rust",
        "//src/connectivity/wlan/wlancfg/tool/policy:donut-lib",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:clap",
    ],
)
