{
    include: [
        "inspect/client.shard.cml",
        "syslog/client.shard.cml",
    ],
    program: {
        runner: "elf",
        binary: "bin/wlandevicemonitor",
    },
    capabilities: [
        {
            protocol: [ "fuchsia.wlan.device.service.DeviceMonitor" ],
        },
    ],
    use: [
        { service: "fuchsia.wlan.phy.Service" },
        {
            config: "fuchsia.wlan.WepSupported",
            from: "parent",
            key: "wep_supported",
            type: "bool",
            availability: "optional",
            default: false,
        },
        {
            config: "fuchsia.wlan.Wpa1Supported",
            from: "parent",
            key: "wpa1_supported",
            type: "bool",
            availability: "optional",
            default: false,
        },
    ],
    expose: [
        {
            protocol: "fuchsia.wlan.device.service.DeviceMonitor",
            from: "self",
        },
    ],
}
