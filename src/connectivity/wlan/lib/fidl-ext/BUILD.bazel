load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "wlan-fidl-ext",
    srcs = [
        "src/lib.rs",
        "src/responder_ext.rs",
        "src/send_result_ext.rs",
        "src/tests.rs",
        "src/try_unpack.rs",
    ],
    edition = "2024",
    proc_macro_deps = ["//third_party/rust_crates/vendor:paste"],
    visibility = ["//src/connectivity/wlan:__subpackages__"],
    deps = [
        "//sdk/fidl/fuchsia.wlan.device.service:fuchsia.wlan.device.service_rust",
        "//sdk/fidl/fuchsia.wlan.softmac:fuchsia.wlan.softmac_rust",
        "//src/lib/fidl/rust/fidl",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:itertools",
    ],
)

rustc_test(
    name = "wlan-fidl-ext_test",
    crate = ":wlan-fidl-ext",
    deps = [
        "//sdk/rust/zx",
        "//third_party/rust_crates/vendor:test-case",
    ],
)

fx_unittest_package(
    name = "wlan-fidl-ext-tests",
    unit_tests = [":wlan-fidl-ext_test"],
    visibility = ["//src/connectivity/wlan:__pkg__"],
)
