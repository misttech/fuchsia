load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//third_party/cobalt:metrics_registry.bzl", "metrics_registry")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "wlan-storage",
    srcs = [
        "src/lib.rs",
        "src/policy.rs",
        "src/stash_store.rs",
        "src/storage_store.rs",
    ],
    edition = "2024",
    visibility = ["//src/connectivity/wlan/wlancfg:__pkg__"],
    deps = [
        ":wlan-storage-constants",
        ":wlan_metrics_registry_rustlib",
        "//sdk/fidl/fuchsia.metrics:fuchsia.metrics_rust",
        "//sdk/fidl/fuchsia.stash:fuchsia.stash_rust",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia_nix",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:serde_json",
    ],
)

# `wlan_storage_lib_test` and `wlan-storage-tests` remain in `BUILD.gn` above
# the sentinel because `wlan-storage-tests` packages
# `//src/sys/stash:stash_secure_v2` and `//src/sys/stash:stash_v2`, which are
# not built by Bazel yet.
rustc_test(
    name = "wlan-storage_test",
    crate = ":wlan-storage",
    crate_name = "wlan_storage_lib_test",
    deps = [
        "//src/connectivity/wlan/lib/ieee80211",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:rand",
    ],
)

rustc_library(
    name = "wlan-storage-constants",
    srcs = ["src/constants.rs"],
    crate_root = "src/constants.rs",
    edition = "2024",
    deps = ["//third_party/rust_crates/vendor:serde"],
)

metrics_registry(
    name = "wlan_metrics_registry",
    generate_binarypb = False,
    generate_rust = True,
    # This must match the ID of our Cobalt project as specified in:
    # third_party/cobalt_config/projects.yaml
    project_id = 3708719327,
)
