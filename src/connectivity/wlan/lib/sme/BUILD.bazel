load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "wlan-sme",
    srcs = [
        "src/ap/aid.rs",
        "src/ap/authenticator.rs",
        "src/ap/event.rs",
        "src/ap/mod.rs",
        "src/ap/remote_client/mod.rs",
        "src/ap/remote_client/state.rs",
        "src/ap/test_utils.rs",
        "src/client/event.rs",
        "src/client/inspect.rs",
        "src/client/mod.rs",
        "src/client/protection.rs",
        "src/client/rsn.rs",
        "src/client/scan.rs",
        "src/client/state/link_state.rs",
        "src/client/state/mod.rs",
        "src/client/test_utils.rs",
        "src/client/wpa.rs",
        "src/lib.rs",
        "src/serve/ap.rs",
        "src/serve/client.rs",
        "src/serve/mod.rs",
        "src/test_utils.rs",
    ],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    visibility = ["//src/connectivity/wlan:__subpackages__"],
    deps = [
        "//sdk/fidl/fuchsia.wlan.common:fuchsia.wlan.common_rust",
        "//sdk/fidl/fuchsia.wlan.ieee80211:fuchsia.wlan.ieee80211_rust",
        "//sdk/fidl/fuchsia.wlan.internal:fuchsia.wlan.internal_rust",
        "//sdk/fidl/fuchsia.wlan.mlme:fuchsia.wlan.mlme_rust",
        "//sdk/fidl/fuchsia.wlan.sme:fuchsia.wlan.sme_rust",
        "//sdk/fidl/fuchsia.wlan.stats:fuchsia.wlan.stats_rust",
        "//sdk/rust/zx",
        "//src/connectivity/wlan/lib/common/rust:wlan-common",
        "//src/connectivity/wlan/lib/eapol",
        "//src/connectivity/wlan/lib/ieee80211",
        "//src/connectivity/wlan/lib/power_manager",
        "//src/connectivity/wlan/lib/rsn:wlan-rsn",
        "//src/connectivity/wlan/lib/statemachine:wlan-statemachine",
        "//src/lib/diagnostics/inspect/contrib/rust",
        "//src/lib/diagnostics/inspect/rust:fuchsia-inspect",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-sync",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)

rustc_test(
    name = "wlan-sme_test",
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate = ":wlan-sme",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    deps = [
        "//src/connectivity/wlan/lib/fcg-crypto:wlan-fcg-crypto",
        "//src/connectivity/wlan/lib/power_manager:power_manager_testing",
        "//src/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:rand",
        "//third_party/rust_crates/vendor:regex",
        "//third_party/rust_crates/vendor:test-case",
    ],
)

fx_unittest_package(
    name = "wlan-sme-tests",
    unit_tests = [":wlan-sme_test"],
    visibility = ["//src/connectivity/wlan:__pkg__"],
)
