load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "wlan-statemachine",
    srcs = ["src/lib.rs"],
    edition = "2024",
    proc_macro_deps = [
        "//src/connectivity/wlan/lib/statemachine/macro:wlan-statemachine-macro",
    ],
    visibility = [
        "//src/connectivity/wlan/lib/fcg-crypto:__pkg__",
        "//src/connectivity/wlan/lib/mlme/rust:__pkg__",
        "//src/connectivity/wlan/lib/rsn:__pkg__",
        "//src/connectivity/wlan/lib/sme:__pkg__",
    ],
)

# @bazel2gn:skip
rustc_test(
    name = "wlan-statemachine_test",
    crate = ":wlan-statemachine",
)

fx_unittest_package(
    name = "wlan-statemachine-tests",
    unit_tests = [":wlan-statemachine_test"],
    visibility = ["//src/connectivity/wlan:__pkg__"],
)
