load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/rust:defs.bzl", "rustc_proc_macro")

package(default_applicable_licenses = ["//:license"])

rustc_proc_macro(
    name = "wlan-statemachine-macro",
    srcs = [
        "src/lib.rs",
        "src/statemachine.rs",
    ],
    edition = "2024",
    # GN `rustc_macro` switches to `host_toolchain` internally instead of
    # wrapping the target in `if (is_host)`.
    # TODO(https://fxbug.dev/543568916): Ignore `HOST_OS_CONSTRAINTS` on
    # `rustc_proc_macro` in `bazel2gn`.
    # @bazel2gn:skip
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//src/connectivity/wlan/lib/statemachine:__pkg__"],
    deps = [
        "//third_party/rust_crates/vendor:proc-macro2",
        "//third_party/rust_crates/vendor:quote",
        "//third_party/rust_crates/vendor:syn",
    ],
)
