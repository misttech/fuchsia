load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "wlan-ffi-transport",
    srcs = [
        "src/completers.rs",
        "src/lib.rs",
        "src/transport.rs",
    ],
    edition = "2024",
    visibility = [
        "//src/connectivity/wlan/drivers/wlanif:__pkg__",
        "//src/connectivity/wlan/drivers/wlansoftmac/rust_driver:__subpackages__",
        "//src/connectivity/wlan/lib/mlme/fullmac:__pkg__",
        "//src/connectivity/wlan/lib/mlme/rust:__pkg__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.wlan.softmac:fuchsia.wlan.softmac_rust",
        "//sdk/lib/driver/runtime/rust",
        "//sdk/rust/zx",
        "//src/connectivity/wlan/lib/fidl-ext:wlan-fidl-ext",
        "//src/connectivity/wlan/lib/trace:wlan-trace",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/trace/rust:trace",
        "//third_party/rust_crates/vendor:log",
    ],
)

rustc_test(
    name = "wlan-ffi-transport_test",
    crate = ":wlan-ffi-transport",
    deps = ["//third_party/rust_crates/vendor:futures"],
)

fx_unittest_package(
    name = "wlan-ffi-transport-tests",
    unit_tests = [":wlan-ffi-transport_test"],
    visibility = ["//src/connectivity/wlan:__pkg__"],
)
