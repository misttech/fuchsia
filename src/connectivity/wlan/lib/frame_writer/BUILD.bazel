load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "wlan-frame-writer",
    srcs = ["src/lib.rs"],
    edition = "2024",
    proc_macro_deps = ["//src/connectivity/wlan/lib/frame_writer/macro:wlan-frame-writer-macro"],
    visibility = [
        "//src/connectivity/wlan/lib/mlme/rust:__pkg__",
        "//src/connectivity/wlan/testing/hw-sim:__pkg__",
    ],
    deps = [
        "//sdk/lib/driver/runtime/rust",
        "//src/connectivity/wlan/lib/common/rust:wlan-common",
        "//third_party/rust_crates/vendor:zerocopy",
    ],
)
