import("//build/components.gni")
import("//build/rust/rustc_test.gni")

# The library is defined in BUILD.bazel. The unit tests stay in GN: they depend
# on //src/devices/bin/driver_runtime, which is not built by Bazel yet.
rustc_test("wlan-frame-writer_test") {
  output_name = "wlan_frame_writer_lib_test"
  edition = "2024"
  deps = [
    "//sdk/fidl/fuchsia.wlan.ieee80211:fuchsia.wlan.ieee80211_rust",
    "//sdk/lib/driver/runtime/rust",
    "//src/connectivity/wlan/lib/common/rust:wlan-common",
    "//src/connectivity/wlan/lib/frame_writer/macro:wlan-frame-writer-macro",
    "//src/connectivity/wlan/lib/ieee80211",
    "//src/devices/bin/driver_runtime",
    "//third_party/rust_crates:zerocopy",
  ]
  sources = [ "src/lib.rs" ]
}

fuchsia_unittest_package("wlan-frame-writer-tests") {
  deps = [ ":wlan-frame-writer_test" ]
}

