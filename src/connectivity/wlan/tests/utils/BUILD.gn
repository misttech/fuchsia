import("//build/python/python_host_test.gni")
import("//build/python/python_library.gni")

if (is_host) {
  python_library("wlan_test_utils") {
    testonly = true
    sources = [
      "__init__.py",
      "odpm_utils.py",
      "throughput_utils.py",
    ]
    library_deps = [
      "//src/performance/lib/perf_publish",
      "//src/performance/lib/reporting",
      "//src/performance/lib/trace_processing",
      "//src/testing/end_to_end/honeydew",
      "//src/testing/end_to_end/mobly_controller/legacy_access_point",
      "//src/testing/end_to_end/mobly_controller/openwrt_access_point",
      "//third_party/mobly",
    ]
  }

  python_host_test("odpm_utils_test") {
    main_source = "odpm_utils_test.py"
    libraries = [ ":wlan_test_utils" ]
  }
}
