import("//build/bazel/bazel_test_suite.gni")
import("//build/components.gni")
import("//build/rust/rustc_library.gni")
import("//build/rust/rustc_test.gni")

bazel_test_suite("bazel_tests") {
  host_tests = [ "//src/connectivity/overnet/lib/circuit:circuit_host_test" ]
  target_tests =
      [ "//src/connectivity/overnet/lib/circuit:overnet-circuit-tests" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    ":circuit_test($host_toolchain)",
    ":overnet-circuit-tests",
  ]
}

