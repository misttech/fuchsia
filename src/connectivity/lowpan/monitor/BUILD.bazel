load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")

package(default_applicable_licenses = ["//:license"])

rustc_binary(
    name = "bin",
    srcs = ["src/main.rs"],
    crate_name = "lowpan_monitor",
    edition = "2024",
    tags = ["manual"],
    deps = [
        "//sdk/fidl/fuchsia.component:fuchsia.component_rust",
        "//sdk/rust/zx",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:log",
    ],
)

fx_packaged_binary(
    name = "lowpan_monitor_packaged_bin",
    binary = ":bin",
    binary_name = "lowpan_monitor",
)

fx_component_manifest(
    name = "manifest",
    component_name = "lowpan-monitor",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/lowpan-monitor.cml",
)

fx_component(
    name = "lowpan-monitor",
    compiled_manifest = ":manifest",
    component_name = "lowpan-monitor",
    visibility = ["//src/connectivity/lowpan/drivers/lowpan-ot-driver:__pkg__"],
    deps = [":lowpan_monitor_packaged_bin"],
)
