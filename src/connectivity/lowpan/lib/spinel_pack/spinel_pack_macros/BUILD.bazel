load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/rust:rustc_proc_macro.bzl", "rustc_proc_macro")

package(default_applicable_licenses = ["//:license"])

rustc_proc_macro(
    name = "spinel_pack_macros",
    srcs = ["src/lib.rs"],
    edition = "2024",
    # GN `rustc_macro` redirects non-host toolchains to `$host_toolchain`
    # internally instead of wrapping the target in `if (is_host)`.
    # @bazel2gn:skip
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//src/connectivity/lowpan/lib/spinel_pack:__pkg__"],
    deps = [
        "//third_party/rust_crates/vendor:proc-macro2",
        "//third_party/rust_crates/vendor:quote",
        "//third_party/rust_crates/vendor:syn",
    ],
)
