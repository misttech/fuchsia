rustc_library("election") {
  sources = [ "src/lib.rs" ]
  edition = "2024"
  visibility = [
    ":*",
    "//src/power/battery-manager:*",
    "//vendor/google/*",
  ]
  deps = [
    "//src/lib/diagnostics/inspect/rust",
    "//src/lib/fuchsia-sync",
  ]
}
rustc_test("election_test") {
  sources = [ "src/lib.rs" ]
  edition = "2024"
  deps = [
           "//src/lib/diagnostics/inspect/rust",
           "//src/lib/fuchsia-sync",
         ] + [
           "//src/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
           "//src/lib/fuchsia",
         ]
}
fuchsia_unittest_package("election-tests") {
  package_name = "election-tests-gn"
  component_name = "election-tests"
  deps = [ ":election_test" ]
}
