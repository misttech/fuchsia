import("//build/bazel/bazel_test_suite.gni")

bazel_test_suite("bazel_tests") {
  target_tests = [ "//src/power/lib/governor:governor-tests" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    ":governor-tests",
  ]
}

