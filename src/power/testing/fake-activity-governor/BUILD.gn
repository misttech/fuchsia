import("//build/components.gni")
import("//build/rust/rustc_library.gni")

rustc_library("fake-activity-governor") {
  name = "fake_activity_governor"
  edition = "2024"
  testonly = true
  with_unit_tests = true

  configs += [ "//build/config/rust/lints:clippy_warn_all" ]

  sources = [ "src/lib.rs" ]
  deps = [
    "//sdk/fidl/fuchsia.power.system:fuchsia.power.system_rust_next",
    "//sdk/rust/zx",
    "//src/lib/fidl/rust_next/fidl_next",
    "//src/lib/fuchsia-async",
    "//third_party/rust_crates:futures",
  ]
  test_deps = [ "//src/lib/fuchsia" ]
}

fuchsia_unittest_package("fake-activity-governor-unittests") {
  deps = [ ":fake-activity-governor_test" ]
}

group("tests") {
  testonly = true
  deps = [ ":fake-activity-governor-unittests" ]
}
