load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "wrap_host_rust_test")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "parser",
    srcs = ["src/lib.rs"],
    crate_name = "system_power_mode_config",
    edition = "2024",
    visibility = ["//src/power/power-manager:__subpackages__"],
    deps = [
        "//sdk/fidl/fuchsia.power.clientlevel:fuchsia.power.clientlevel_rust_common",
        "//sdk/fidl/fuchsia.power.systemmode:fuchsia.power.systemmode_rust_common",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:serde_json5",
    ],
)

rustc_test(
    name = "system_power_mode_config_lib_test",
    crate = ":parser",
    edition = "2024",
    deps = [
        "//src/lib/fuchsia",
        "//third_party/rust_crates/vendor:assert_matches",
    ],
)

wrap_host_rust_test(
    name = "parser_host_test",
    binary_name = "system_power_mode_config_lib_test",
)

fx_unittest_package(
    name = "system-power-mode-config-parser-tests",
    unit_tests = [":system_power_mode_config_lib_test"],
)
