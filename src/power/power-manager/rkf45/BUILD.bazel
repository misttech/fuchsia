load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "lib",
    srcs = ["src/lib.rs"],
    crate_name = "rkf45",
    edition = "2024",
    visibility = ["//src/power/power-manager:__subpackages__"],
    deps = ["//third_party/rust_crates/vendor:anyhow"],
)

rustc_test(
    name = "rkf45_lib_test",
    crate = ":lib",
    edition = "2024",
    deps = [
        "//src/lib/fuchsia",
        "//src/lib/test_util",
    ],
)

fx_unittest_package(
    name = "rkf45-tests",
    unit_tests = [":rkf45_lib_test"],
)
