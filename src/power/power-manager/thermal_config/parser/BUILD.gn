import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("parser") {
  sources = [ "src/lib.rs" ]
  crate_name = "thermal_config"
  edition = "2024"
  proc_macro_deps = [ "//third_party/rust_crates:serde_derive" ]
  visibility = [
    ":*",
    "//src/power/power-manager/*",
    "//vendor/google/*",
  ]
  deps = [
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:serde",
    "//third_party/rust_crates:serde_json5",
  ]
}

rustc_test("thermal_config_lib_test") {
  sources = [ "src/lib.rs" ]
  edition = "2024"
  proc_macro_deps = [ "//third_party/rust_crates:serde_derive" ]
  deps = [
           "//third_party/rust_crates:anyhow",
           "//third_party/rust_crates:serde",
           "//third_party/rust_crates:serde_json5",
         ] +
         [
           "//src/lib/fuchsia",
           "//third_party/rust_crates:assert_matches",
         ]
}

fuchsia_unittest_package("thermal-config-parser-tests") {
  package_name = "thermal-config-parser-tests-gn"
  component_name = "thermal-config-parser-tests"
  deps = [ ":thermal_config_lib_test" ]
}
