import("//build/bazel/bazel_test_suite.gni")

bazel_test_suite("bazel_tests") {
  host_tests =
      [ "//src/power/power-manager/thermal_config/parser:parser_host_test" ]
  target_tests = [ "//src/power/power-manager/thermal_config/parser:thermal-config-parser-tests" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    ":thermal-config-parser-tests",
    ":thermal_config_lib_test($host_toolchain)",
  ]
}

