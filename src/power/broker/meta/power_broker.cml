// power-broker component manifest.
// For information on manifest format and features,
// see https://fuchsia.dev/fuchsia-src/concepts/components/component_manifests.
{
    include: [
        "inspect/client.shard.cml",
        "syslog/client.shard.cml",
        "trace/client.shard.cml",
    ],

    // Information about the program to run.
    program: {
        // Use the built-in ELF runner.
        runner: "elf",

        // The binary to run for this component.
        binary: "bin/power-broker",
    },
    capabilities: [
        { protocol: "fuchsia.power.broker.Topology" },
        {
            config: "fuchsia.power.broker.SetLevelTimeoutSeconds",
            type: "uint32",
            value: 60,
        },
        {
            config: "fuchsia.power.broker.RebootOnSetLevelTimeout",
            type: "bool",
            value: true,
        },
    ],
    use: [
        {
            protocol: [
                "fuchsia.feedback.CrashReporter",
                "fuchsia.hardware.power.statecontrol.Admin",
            ],
            availability: "optional",
        },

        // Timeout in seconds before filing a crash report for a stuck SetLevel call.
        // A value of 0 means never (disabled).
        {
            config: "fuchsia.power.broker.SetLevelTimeoutSeconds",
            from: "self",
            key: "set_level_timeout_seconds",
            type: "uint32",
        },
        {
            config: "fuchsia.power.broker.RebootOnSetLevelTimeout",
            from: "self",
            key: "reboot_on_set_level_timeout",
            type: "bool",
        },
    ],
    expose: [
        {
            protocol: "fuchsia.power.broker.Topology",
            from: "self",
        },
    ],
}
