{
    include: [
        "inspect/client.shard.cml",
        "syslog/client.shard.cml",
    ],
    program: {
        runner: "elf",
        binary: "bin/fake_telemetry_governor",
    },
    use: [
        // Provided by battery-manager through CreateChildArgs.additional_inputs, mirroring how
        // production governors (e.g. MSC) receive them.
        {
            protocol: [
                "fuchsia.hardware.power.battery.Battery",
                "fuchsia.hardware.power.charger.Charger",
                "fuchsia.hardware.power.charger.Controller",
            ],
            availability: "optional",
        },
    ],
}
