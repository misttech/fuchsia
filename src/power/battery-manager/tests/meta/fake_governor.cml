{
    include: [ "syslog/client.shard.cml" ],
    program: {
        runner: "elf",
        binary: "bin/fake_governor",
    },
    use: [
        // Provided by battery-manager through CreateChildArgs.additional_inputs, mirroring how
        // production governors (e.g. MSC) receive it.
        {
            protocol: "fuchsia.hardware.power.charger.Controller",
            availability: "optional",
        },
    ],
}
