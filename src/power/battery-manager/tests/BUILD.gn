import("//build/components.gni")
import("//build/rust/rustc_binary.gni")
import("//build/rust/rustc_test.gni")

rustc_test("battery_manager_integration_test") {
  edition = "2024"
  source_root = "src/integration_test.rs"
  sources = [
    "src/fake_governor_votes.rs",
    "src/fake_telemetry_governor_votes.rs",
    "src/integration_test.rs",
  ]
  deps = [
    "//sdk/fidl/fuchsia.component.test:fuchsia.component.test_rust",
    "//sdk/fidl/fuchsia.driver.test:fuchsia.driver.test_rust",
    "//sdk/fidl/fuchsia.hardware.power.battery:fuchsia.hardware.power.battery_rust",
    "//sdk/fidl/fuchsia.hardware.power.charger:fuchsia.hardware.power.charger_rust",
    "//sdk/fidl/fuchsia.power.battery:fuchsia.power.battery_rust",
    "//sdk/fidl/fuchsia.power.battery.test:fuchsia.power.battery.test_rust",
    "//sdk/fidl/fuchsia.power.system:fuchsia.power.system_rust",
    "//sdk/lib/driver_test_realm/realm_builder/rust",
    "//sdk/rust/zx",
    "//src/devices/bind/fuchsia.platform:fuchsia.platform_rust",
    "//src/lib/diagnostics/reader/rust",
    "//src/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
    "//src/lib/fake-clock/fidl:fidl_rust",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//src/lib/fuchsia-component-test",
    "//src/lib/fuchsia-sync",
    "//src/lib/test_util",
    "//src/power/testing/fake-hardware-power-control:test.hardwarepowercontrol_rust",
    "//src/sys/lib/cm_rust",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:serde_json",
    "//third_party/rust_crates:test-case",
  ]
}

rustc_binary("fake_governor_bin") {
  testonly = true
  edition = "2024"
  output_name = "fake_governor"
  source_root = "src/fake_governor.rs"
  sources = [
    "src/fake_governor.rs",
    "src/fake_governor_votes.rs",
  ]
  deps = [
    "//sdk/fidl/fuchsia.hardware.power.charger:fuchsia.hardware.power.charger_rust",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-component",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:log",
  ]
}

fuchsia_component("fake_governor") {
  testonly = true
  component_name = "fake_governor"
  manifest = "meta/fake_governor.cml"
  deps = [ ":fake_governor_bin" ]
}

rustc_binary("fake_telemetry_governor_bin") {
  testonly = true
  edition = "2024"
  output_name = "fake_telemetry_governor"
  source_root = "src/fake_telemetry_governor.rs"
  sources = [
    "src/fake_telemetry_governor.rs",
    "src/fake_telemetry_governor_votes.rs",
  ]
  deps = [
    "//sdk/fidl/fuchsia.hardware.power.charger:fuchsia.hardware.power.charger_rust",
    "//src/lib/fuchsia",
    "//src/power/lib/governor",
    "//third_party/rust_crates:anyhow",
  ]
}

fuchsia_component("fake_telemetry_governor") {
  testonly = true
  component_name = "fake_telemetry_governor"
  manifest = "meta/fake_telemetry_governor.cml"
  deps = [ ":fake_telemetry_governor_bin" ]
}

fuchsia_test_component("battery_manager_integration_test_component") {
  component_name = "battery_manager_integration_test"
  manifest = "meta/battery_manager_test.cml"
  deps = [ ":battery_manager_integration_test" ]
}

resource("test_config") {
  sources = [ "config/test_config.json" ]
  outputs = [ "config/test_config.json" ]
}

fuchsia_test_package("battery-manager-integration-tests") {
  package_name = "battery_manager_integration_test"
  test_components = [ ":battery_manager_integration_test_component" ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
  deps = [
    ":fake_governor",
    ":fake_telemetry_governor",
    ":test_config",
    "//src/devices/bus/drivers/platform:platform-bus",
    "//src/lib/fake-clock/svc",
    "//src/power/battery-manager:battery_manager_fake_time",
    "//src/power/testing/fake-battery:fake_battery_component",
  ]
}
