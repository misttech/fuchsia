import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("parser") {
  sources = [ "src/lib.rs" ]
  crate_name = "energy_model_config"
  edition = "2024"
  proc_macro_deps = [ "//third_party/rust_crates:serde_derive" ]
  visibility = [
    ":*",
    "//src/power/cpu-manager/energy_model_config/validator:*",
  ]
  deps = [
    "//sdk/rust/zx-types",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:serde",
    "//third_party/rust_crates:serde_json5",
  ]
}
rustc_test("parser_test") {
  sources = [ "src/lib.rs" ]
  edition = "2024"
  proc_macro_deps = [ "//third_party/rust_crates:serde_derive" ]
  deps = [
           "//sdk/rust/zx-types",
           "//third_party/rust_crates:anyhow",
           "//third_party/rust_crates:serde",
           "//third_party/rust_crates:serde_json5",
         ] +
         [
           "//src/lib/fuchsia",
           "//third_party/rust_crates:assert_matches",
         ]
  output_name = "energy_model_config_lib_test"
}
fuchsia_unittest_package("energy-model-config-parser-tests") {
  package_name = "energy-model-config-parser-tests-gn"
  component_name = "energy-model-config-parser-tests"
  deps = [ ":parser_test" ]
  visibility = [
    ":*",
    "//src/power:*",
  ]
}
