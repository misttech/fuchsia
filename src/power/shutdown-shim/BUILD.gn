import("//build/bazel/bazel_test_suite.gni")

bazel_test_suite("shutdown-shim-unittests") {
  target_tests = [ "//src/power/shutdown-shim:shutdown-shim-unittests" ]
}

group("shutdown-shim") {
  testonly = true
  deps = [
    ":bin",
    ":tests",
