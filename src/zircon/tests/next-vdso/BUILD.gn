import("//build/bazel/bazel_test_suite.gni")
import("//zircon/vdso/vdso.gni")

bazel_test_suite("next-vdso-test-pkg") {
  target_tests = [ "//src/zircon/tests/next-vdso:next-vdso-test-pkg" ]
}

group("tests") {
  testonly = true
  if (!exclude_testonly_syscalls) {
    deps = [ ":next-vdso-test-pkg" ]
  }
}
