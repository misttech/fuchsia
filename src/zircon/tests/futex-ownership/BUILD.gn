import("//build/bazel/bazel_test_suite.gni")
import("//build/test.gni")
import("//build/testing/bootfs_test.gni")

bazel_test_suite("futex-ownership-test") {
  target_tests = [ "//src/zircon/tests/futex-ownership:futex-ownership-test" ]
}

group("tests") {
  testonly = true

  # Note: Tests specified using `bootfs_test` are included via
  # //products/bringup_with_tests and not this target.
  deps = [ ":futex-ownership-test" ]
}

# Kept in GN because Bazel does not support `bootfs_test` yet, and `bazel2gn`
# translates `fx_cc_binary` to `executable()` rather than `test()`.
# LINT.IfChange
test("futex-ownership") {
  configs += [ "//build/config:all_source" ]
  sources = [
    "bad-handle.cc",
    "bad-handle.h",
    "ownership.cc",
    "utils.cc",
    "utils.h",
  ]
  deps = [
    "//sdk/lib/fdio",
    "//sdk/lib/stdcompat",
    "//src/zircon/lib/zircon",
    "//zircon/system/ulib/fbl",
    "//zircon/system/ulib/zx",
    "//zircon/system/ulib/zxtest",
  ]
}

# LINT.ThenChange(BUILD.bazel)

bootfs_test("futex-ownership-bootfs-test") {
  name = "futex-ownership"
  deps = [ ":futex-ownership" ]
}
