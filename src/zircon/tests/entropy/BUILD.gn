import("//build/testing/bootfs_test.gni")

if (is_fuchsia) {
  # Bazel cannot express bootfs_test() yet, so keep it in GN.
  bootfs_test("entropy-bootfs-test") {
    name = "entropy-test"
    deps = [ ":entropy" ]
  }
}

