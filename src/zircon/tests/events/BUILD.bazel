load("//build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

fx_cc_binary(
    name = "events",
    testonly = True,
    srcs = ["events.c"],
    defines = ["_ALL_SOURCE"],
    tags = ["manual"],
    deps = [
        "//sdk/lib/fdio",
        "//src/zircon/lib/zircon",
        "//zircon/system/ulib/zxtest",
    ],
)

fx_unittest_package(
    name = "events-test-pkg",
    package_name = "events-test",
    unit_tests = [":events"],
)
