load("//build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

fx_cc_binary(
    name = "handle-alias",
    testonly = True,
    srcs = ["handle-alias.c"],
    tags = ["manual"],
    deps = [
        "//sdk/lib/fdio",
        "//src/zircon/lib/zircon",
        "//zircon/system/ulib/zxtest",
    ],
)

fx_unittest_package(
    name = "handle-alias-test-pkg",
    package_name = "handle-alias-test",
    unit_tests = [":handle-alias"],
)
