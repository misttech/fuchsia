import("//build/bazel/bazel_test_suite.gni")

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    "bin:tests",
    "tests",
    "//zircon/kernel:tests",
    "//zircon/system/ulib:tests",
    "//zircon/system/utest:tests",
    "//zircon/tools:tests",
  ]
}

group("e2e_tests") {
  testonly = true
  deps = [ "//zircon/system/ulib:e2e_tests" ]
}

bazel_test_suite("bazel_tests") {
  target_tests = [ "//src/zircon:target_tests" ]
}
