import("//build/rust/rustc_library.gni")
import("//build/testing/boot_tests/boot_test.gni")
import("//build/testing/boot_tests/kernel_zbi_test.gni")
import("//src/bringup/bin/userboot/tests/rust_zbi_test_executable.gni")
import("//zircon/kernel/params.gni")

group("boot_tests") {
  testonly = true
  deps = [
    ":early-boot-bootfs-entries-test",
    ":early-boot-multiple-process-test",
    ":early-boot-single-process-test",
  ]
}

if (is_fuchsia) {
  static_library("fdio_stub") {
    testonly = true
    output_name = "fdio"
    output_dir = "$target_out_dir/fdio_stub"
    deps = [ "//sdk/lib/c/stubs" ]
  }

  rustc_library("helper") {
    testonly = true
    visibility = [ ":*" ]
    edition = "2024"
    source_root = "helper.rs"
    sources = [ "helper.rs" ]
    deps = [
      "//sdk/fidl/fuchsia.boot:fuchsia.boot_rust_next",
      "//sdk/fidl/fuchsia.debugdata:fuchsia.debugdata_rust_next",
      "//sdk/lib/c/rust",
      "//sdk/rust/zx",
      "//src/lib/fidl/rust_next/fidl_next",
      "//src/lib/fuchsia-runtime",
    ]
  }

  # Verify that the '/svc' and svc stash handle work correctly.
  rust_zbi_test_executable("early-boot-single-process-test-bin") {
    source_root = "svc_test.rs"
    sources = [ "svc_test.rs" ]
    deps = [
      ":helper",
      "//sdk/lib/c/rust",
      "//sdk/rust/zx",
    ]

    # This test needs to run as a 'boot' program, such that it is handed the
    # SvcStash handle.
    userboot_entry_type = "boot"
    userboot_next_is_test = true
  }

  # Verify that the '/svc' and svc stash handle work correctly.
  rust_zbi_test_executable("early-boot-multiple-process-test-bin") {
    source_root = "multiple_svc_test.rs"
    sources = [ "multiple_svc_test.rs" ]
    deps = [
      ":helper",
      "data-publisher:published-data",
      "//sdk/lib/c/rust",
      "//sdk/rust/zx",
    ]

    # This test needs to run as a 'boot' program, such that it is handed the
    # SvcStash handle.
    userboot_entry_type = "boot"
    userboot_next_is_test = true
  }

  rust_zbi_test_executable("early-boot-bootfs-entries-test-bin") {
    source_root = "bootfs_entries_test.rs"
    sources = [ "bootfs_entries_test.rs" ]
    deps = [
      ":helper",
      "//sdk/rust/zx",
      "//src/lib/fuchsia-runtime",
      "//third_party/rust_crates:libc",
    ]

    # This test needs to run as a 'boot' program, such that it is handed the
    # SvcStash handle.
    userboot_entry_type = "boot"
    userboot_next_is_test = true
  }
}

if (current_toolchain == default_toolchain) {
  kernel_zbi_test("early-boot-bootfs-entries-test") {
    generate_cuckoo = false
    deps = [ ":early-boot-bootfs-entries-test-bin" ]
    environments = kernel_test_environments
  }

  kernel_zbi_test("early-boot-single-process-test") {
    generate_cuckoo = false
    deps = [ ":early-boot-single-process-test-bin" ]
    environments = kernel_test_environments
  }

  kernel_zbi_test("early-boot-multiple-process-test") {
    generate_cuckoo = false
    deps = [
      ":early-boot-multiple-process-test-bin",
      "data-publisher:early-boot-data-publisher-bin",
    ]
    environments = kernel_test_environments
  }
}
