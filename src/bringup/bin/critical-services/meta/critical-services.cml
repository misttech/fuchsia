{
    include: [ "syslog/client.shard.cml" ],
    program: {
        runner: "elf",
        binary: "bin/critical-services",
    },
    capabilities: [
        { protocol: "fuchsia.power.button.Monitor" },
    ],
    use: [
        {
            directory: "input",
            rights: [ "r*" ],
            path: "/input",
        },
        {
            protocol: [
                "fuchsia.boot.WriteOnlyLog",
                "fuchsia.exception.Handler",
                "fuchsia.hardware.power.statecontrol.Admin",
                "fuchsia.kernel.RootJob",
            ],
        },
        {
            // For the storage stall watchdog's test-only boot argument.
            protocol: "fuchsia.boot.Arguments",
            availability: "optional",
        },
        {
            // The storage stall watchdog's dump includes the log tail and storage Inspect data.
            protocol: "fuchsia.diagnostics.ArchiveAccessor",
            availability: "optional",
        },
        {
            config: "fuchsia.diagnostics.ExceptionHandlerAvailable",
            key: "exception_handler_available",
            type: "bool",
        },
        {
            config: "fuchsia.diagnostics.StorageStallWatchdogEnabled",
            key: "storage_stall_watchdog_enabled",
            type: "bool",
            availability: "optional",
            default: false,
        },
    ],
    expose: [
        {
            protocol: "fuchsia.power.button.Monitor",
            from: "self",
        },
    ],
}
