load("//build/bazel/rules/rust:defs.bzl", "rustc_library", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "time_pretty",
    srcs = ["src/lib.rs"],
    edition = "2024",
    visibility = [
        "//src/starnix/kernel/core:__pkg__",
        "//src/sys/time/timekeeper:__subpackages__",
    ],
    deps = ["//sdk/rust/zx"],
)

# @bazel2gn:skip
rustc_test(
    name = "time_pretty_test",
    crate = ":time_pretty",
    edition = "2024",
    visibility = ["//visibility:private"],
    deps = ["//third_party/rust_crates/vendor:test-case"],
)

# @bazel2gn:skip
fx_unittest_package(
    name = "time_pretty_test_package",
    unit_tests = [":time_pretty_test"],
    visibility = ["//visibility:public"],
)
