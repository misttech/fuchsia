import("//build/bazel/bazel_test_suite.gni")

group("tests") {
  testonly = true
  public_deps = [ ":bazel_tests" ]
  deps = [ ":time_pretty_test_package" ]
}

bazel_test_suite("bazel_tests") {
  target_tests = [ "//src/sys/time/timekeeper/pretty:time_pretty_test_package" ]
}

