import("//build/components.gni")
import("//build/rust/rustc_library.gni")
import("//build/rust/rustc_test.gni")

group("tests") {
  testonly = true
  deps = [ ":httpdate-hyper-tests" ]
}

# Kept in GN because `httpdate-hyper-tests` packages
# `//src/connectivity/network/dns:component` and
# `//src/connectivity/network/netstack3:component-for-tests`, which have no
# Bazel build yet.
fuchsia_unittest_package("httpdate-hyper-tests") {
  manifest = "meta/httpdate-hyper-lib-test.cml"
  deps = [
    ":httpdate-hyper_test",
    "//src/connectivity/network/dns:component",
    "//src/connectivity/network/netstack3:component-for-tests",
  ]

  # This test depends on root ssl certificate which is a system capability.
  test_type = "system"

  if (current_cpu == "riscv64") {
    # TODO(https://fxbug.dev/298470623): Make this target pass on RISC-V and remove this.
    test_specs = {
      build_only = true
    }
  }
}

