rustc_library("httpdate-hyper") {
  sources = [ "src/lib.rs" ]
  inputs = [
    "certs/ca.cert",
    "certs/notafter",
    "certs/notbefore",
    "certs/server.certchain",
    "certs/server.rsa",
  ]
  edition = "2024"
  visibility = [
    ":*",
    "//src/sys/time/httpsdate_time_source:*",
  ]
  deps = [
    "//src/lib/fuchsia-hyper",
    "//src/lib/fuchsia-sync",
    "//src/lib/webpki-roots-fuchsia",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:chrono",
    "//third_party/rust_crates:hyper",
    "//third_party/rust_crates:rustls",
    "//third_party/rust_crates:rustls-webpki",
    "//third_party/rust_crates:thiserror",
  ]
}

rustc_test("httpdate-hyper_test") {
  sources = [ "src/lib.rs" ]
  inputs = [
    "certs/ca.cert",
    "certs/notafter",
    "certs/notbefore",
    "certs/server.certchain",
    "certs/server.rsa",
  ]
  edition = "2024"
  deps = [
           "//src/lib/fuchsia-hyper",
           "//src/lib/fuchsia-sync",
           "//src/lib/webpki-roots-fuchsia",
           "//third_party/rust_crates:anyhow",
           "//third_party/rust_crates:chrono",
           "//third_party/rust_crates:hyper",
           "//third_party/rust_crates:rustls",
           "//third_party/rust_crates:rustls-webpki",
           "//third_party/rust_crates:thiserror",
         ] +
         [
           "//src/lib/fuchsia",
           "//src/lib/fuchsia-async",
           "//third_party/rust_crates:base64",
           "//third_party/rust_crates:futures",
           "//third_party/rust_crates:http-body-util",
           "//third_party/rust_crates:hyper-util",
           "//third_party/rust_crates:tokio-rustls",
         ]
  output_name = "httpdate_hyper_lib_test"
}
