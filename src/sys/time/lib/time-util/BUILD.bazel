load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "time-util",
    srcs = ["src/lib.rs"],
    edition = "2024",
    visibility = ["//src/sys/time:__subpackages__"],
    deps = ["//sdk/rust/zx"],
)

rustc_test(
    name = "time-util_test",
    crate = ":time-util",
    edition = "2024",
    deps = [
        "//src/lib/fuchsia",
        "//src/lib/test_util",
    ],
)

fx_unittest_package(
    name = "time-util-tests",
    unit_tests = [":time-util_test"],
)
