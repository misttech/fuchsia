import("//build/bazel/bazel_test_suite.gni")

bazel_test_suite("bazel_tests") {
  target_tests =
      [ "//src/sys/time/lib/inspect-writable:inspect-writable-tests" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    ":inspect-writable-tests",
  ]
}

