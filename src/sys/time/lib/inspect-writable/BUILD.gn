rustc_library("inspect-writable") {
  sources = [ "src/lib.rs" ]
  edition = "2024"
  proc_macro_deps =
      [ "//src/sys/time/lib/inspect-writable/macro:inspect-writable-derive" ]
  visibility = [
    ":*",
    "//src/sys/time/timekeeper:*",
  ]
  deps = [ "//src/lib/diagnostics/inspect/rust" ]
}
rustc_test("test_bin") {
  sources = [ "tests/derive_test.rs" ]
  output_name = "inspect_writable_test"
  source_root = "tests/derive_test.rs"
  edition = "2024"
  deps = [
    ":inspect-writable",
    "//src/lib/diagnostics/inspect/rust",
    "//src/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
    "//src/lib/fuchsia",
  ]
}
fuchsia_unittest_package("inspect-writable-tests") {
  package_name = "inspect-writable-tests-gn"
  component_name = "inspect-writable-tests"
  deps = [ ":test_bin" ]
}
