import("//build/components.gni")

# For use as a subpackage in CTF and similar tests. Kept above the sentinel
# because bazel2gn does not translate fx_package.
fuchsia_package("pkg") {
  package_name = "dev_time_source"
  testonly = true
  deps = [ ":component" ]
}

