rustc_binary("bin") {
  testonly = true
  sources = [ "src/main.rs" ]
  output_name = "dev_time_source"
  edition = "2024"
  deps = [
    "//sdk/fidl/fuchsia.time.external:fuchsia.time.external_rust",
    "//sdk/rust/zx",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-component",
    "//src/sys/time/testing/fidl/test.time:fidl_rust",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
  ]
}
fuchsia_component_manifest("component-manifest") {
  testonly = true
  component_name = "dev_time_source"
  manifest = "meta/service.cml"
}
fuchsia_component("component") {
  testonly = true
  cm_label = ":component-manifest"
  component_name = "dev_time_source"
  visibility = [
    ":*",
    "//src/sys/time/testing/realm-proxy:*",
  ]
  deps = [ ":bin" ]
}
