fuchsia_unittest_package("httpsdate-time-source-tests") {
  package_name = "httpsdate-time-source-tests-gn"
  component_name = "httpsdate-time-source-tests"
  deps = [ ":httpsdate_time_source_bin_test" ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
  visibility = [
    ":*",
    "//src/sys:*",
  ]
}

fuchsia_component_manifest("manifest") {
  component_name = "httpsdate_time_source"
  manifest = "meta/service.cml"
}

fuchsia_component("service") {
  cm_label = ":manifest"
  visibility = [
    ":*",
    "//src/sys/time/httpsdate_time_source/tests:*",
  ]
  deps = [ ":bin" ]
}

fuchsia_structured_config_rust_lib("httpsdate_config") {
  cm_label = ":manifest"
}
