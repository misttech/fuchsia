load("//build/bazel/rules/rust:defs.bzl", "rustc_library", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "lib",
    srcs = ["src/lib.rs"],
    crate_name = "mock_boot_arguments",
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    visibility = ["//src/recovery/system:__pkg__"],
    deps = [
        "//sdk/fidl/fuchsia.boot:fuchsia.boot_rust",
        "//src/sys/pkg/lib/fuchsia-hash",
        "//third_party/rust_crates/vendor:futures",
    ],
)

# @bazel2gn:raw_attribute:output_name = "mock_boot_arguments_lib_test"
rustc_test(
    name = "lib_test",
    crate = ":lib",
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    visibility = ["//visibility:private"],
    deps = [
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//third_party/rust_crates/vendor:maplit",
    ],
)

fx_unittest_package(
    name = "mock-boot-arguments-tests",
    unit_tests = [":lib_test"],
)
