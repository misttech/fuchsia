    "//third_party/rust_crates:futures",
  ]
}

rustc_test("lib_test") {
  sources = [ "src/lib.rs" ]
  edition = "2024"
  deps = [
           "//sdk/fidl/fuchsia.boot:fuchsia.boot_rust",
           "//src/sys/pkg/lib/fuchsia-hash",
           "//third_party/rust_crates:futures",
         ] +
         [
           "//src/lib/fidl/rust/fidl",
           "//src/lib/fuchsia",
           "//src/lib/fuchsia-async",
           "//third_party/rust_crates:maplit",
         ]
  lint_config = "//build/config/rust/lints:clippy_warn_all"
  visibility = [ ":*" ]
  output_name = "mock_boot_arguments_lib_test"
}

fuchsia_unittest_package("mock-boot-arguments-tests") {
  package_name = "mock-boot-arguments-tests-gn"
  component_name = "mock-boot-arguments-tests"
  deps = [ ":lib_test" ]
}
