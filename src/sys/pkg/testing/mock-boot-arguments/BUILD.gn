import("//build/bazel/bazel_test_suite.gni")

bazel_test_suite("bazel_tests") {
  target_tests =
      [ "//src/sys/pkg/testing/mock-boot-arguments:mock-boot-arguments-tests" ]
}

group("hermetic_tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    ":mock-boot-arguments-tests",
  ]
}

