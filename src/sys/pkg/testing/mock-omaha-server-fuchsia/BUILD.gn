import("//build/components.gni")
import("//build/rust/rustc_test.gni")

# Kept in GN because `mock-omaha-server-fuchsia-tests` packages
# `//src/connectivity/network/netstack3:component-for-tests`, which uses the
# GN-only `network_unified_binary` template and has no Bazel build yet.
rustc_test("mock-omaha-server-fuchsia_test") {
  edition = "2024"
  output_name = "mock_omaha_server_fuchsia_lib_test"
  sources = [ "src/lib.rs" ]
  deps = [
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-hyper",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:hyper-util",
    "//third_party/rust_crates:mock-omaha-server",
  ]
}

fuchsia_unittest_package("mock-omaha-server-fuchsia-tests") {
  manifest = "meta/mock-omaha-server-fuchsia-tests.cml"
  deps = [
    ":mock-omaha-server-fuchsia_test",
    "//src/connectivity/network/netstack3:component-for-tests",
  ]
}

group("hermetic_tests") {
  testonly = true
  public_deps = [ ":mock-omaha-server-fuchsia-tests" ]
}

