load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "mock-health-verification",
    srcs = ["src/lib.rs"],
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    visibility = [
        "//src/sys/pkg/bin/system-update-committer:__pkg__",
        "//src/sys/pkg/tests/omaha-client:__pkg__",
        "//src/sys/pkg/tests/pkg-cache:__pkg__",
        "//src/sys/pkg/tests/system-update-checker:__pkg__",
        "//src/sys/pkg/tests/system-update-committer:__pkg__",
        "//vendor/google:__subpackages__",
    ],
    deps = [
        "//sdk/rust/zx",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-async",
        "//src/sys/pkg/fidl/fuchsia.update.verify:fuchsia.update.verify_rust",
        "//third_party/rust_crates/vendor:futures",
    ],
)

# @bazel2gn:skip
rustc_test(
    name = "mock-health-verification_test",
    crate = ":mock-health-verification",
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    visibility = ["//visibility:private"],
    deps = ["//src/lib/fuchsia"],
)

# @bazel2gn:skip
fx_unittest_package(
    name = "mock-health-verification-tests",
    unit_tests = [":mock-health-verification_test"],
    visibility = ["//visibility:public"],
)
