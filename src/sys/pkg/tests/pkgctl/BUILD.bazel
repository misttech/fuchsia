load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")

package(default_applicable_licenses = ["//:license"])

# `pkgctl_integration_test-component` and `pkgctl-integration-tests` stay in
# BUILD.gn above the bazel2gn sentinel because `pkgctl-integration-tests`
# packages GN-only `//src/connectivity/network/dns:component`,
# `//src/connectivity/network/netstack3:component-for-tests`,
# `//src/connectivity/policy/http-client:component`, and
# `//src/sys/pkg/bin/pkgctl:pkgctl-binary`.
rustc_test(
    name = "driver",
    srcs = ["src/lib.rs"],
    crate_name = "pkgctl_integration_test",
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    deps = [
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/fidl/fuchsia.net.http:fuchsia.net.http_rust",
        "//sdk/fidl/fuchsia.pkg:fuchsia.pkg_rust",
        "//sdk/fidl/fuchsia.pkg.garbagecollector:fuchsia.pkg.garbagecollector_rust",
        "//sdk/fidl/fuchsia.pkg.rewrite:fuchsia.pkg.rewrite_rust",
        "//sdk/rust/zx",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-fs",
        "//src/lib/fuchsia-sync",
        "//src/lib/fuchsia-url",
        "//src/lib/testing/fuchsia-hyper-test-support",
        "//src/storage/lib/vfs/rust:vfs",
        "//src/sys/lib/fidl-fuchsia-pkg-ext",
        "//src/sys/lib/fidl-fuchsia-pkg-rewrite-ext",
        "//src/sys/pkg/testing/shell-process",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:http",
        "//third_party/rust_crates/vendor:serde_json",
        "//third_party/rust_crates/vendor:tempfile",
    ],
)
