import("//build/assembly/bootfs_files_for_assembly.gni")
import("//build/components.gni")
import("//build/dist/component_manifest_resources.gni")
import("//build/rust/rustc_library.gni")
import("//build/testing/environments.gni")
import("//build/toolchain/concurrent_jobs.gni")
import("//src/storage/fshost/generated_fshost_config.gni")
import("//src/sys/pkg/bin/grand-swd-binary/gsb.gni")

fuchsia_structured_config_values2("config_values_from_gn") {
  cm_label = ":manifest"
  component_name = "pkg-cache"
  output_component_name = "pkg-cache-config"
  values = {
    # TODO(https://fxbug.dev/331302451) Populate this correctly.
    all_packages_executable = false
    require_system_image = true
    enable_upgradable_packages = false
  }
  visibility = [ ":*" ]
}

group("production-component-and-config") {
  testonly = true
  public_deps = [
    ":component",
    ":config_values_from_gn",
  ]
}

# Assembly consumes this package through its bazel_inputs export: a Bazel
# package would ship the vfs Rust dylib, whose debug symbols the Bazel
# build does not export yet.
fuchsia_package("pkg-cache") {
  deps = [ ":component" ]
}

# The binary and its unit-test binary (`:bin_test`) are defined in
# BUILD.bazel. Only the test component and package (`:pkg-cache-test` and
# `:pkg-cache-tests`) remain in GN above the sentinel because
# `pkg-cache-tests` packages `//src/storage/testing:storage_driver_test_realm`
# (which is GN-only).
fuchsia_component("pkg-cache-test") {
  testonly = true
  manifest = "meta/pkg-cache-bin-test.cml"
  deps = [ ":bin_test" ]
}

fuchsia_test_package("pkg-cache-tests") {
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
  test_components = [ ":pkg-cache-test" ]
  deps = [ "//src/storage/testing:storage_driver_test_realm" ]
}

group("hermetic_tests") {
  testonly = true
  public_deps = [ ":pkg-cache-tests" ]
}

