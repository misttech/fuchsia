import("//build/bazel/bazel_test_suite.gni")

bazel_test_suite("multi-universal-tool-tests") {
  target_tests =
      [ "//src/sys/pkg/bin/multi-universal-tool:multi-universal-tool-tests" ]
}

group("hermetic_tests") {
  testonly = true
  deps = [ ":multi-universal-tool-tests" ]
}

