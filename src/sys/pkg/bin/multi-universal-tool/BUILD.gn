rustc_binary("multi-universal-tool") {
  sources = [ "src/main.rs" ]
  output_name = "multi_universal_tool"
  edition = "2024"
  lint_config = "//build/config/rust/lints:clippy_warn_all"
  visibility = [
    ":*",
    "//src/sys/pkg/bin/pkgctl:*",
    "//src/sys/pkg/bin/update:*",
  ]
  deps = [
