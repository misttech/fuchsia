load("@platforms//host:constraints.bzl", "HOST_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")

package(default_applicable_licenses = ["//:license"])

exports_files(
    ["history"],
    visibility = ["//src/sys/pkg/bin/system-updater:__pkg__"],
)

_GENERATOR_SRCS = [
    "src/args.rs",
    "src/history.rs",
    "src/main.rs",
]

# @bazel2gn:transformer=deps
_GENERATOR_DEPS = [
    "//src/sys/pkg/lib/epoch",
    "//third_party/rust_crates/vendor:anyhow",
    "//third_party/rust_crates/vendor:argh",
    "//third_party/rust_crates/vendor:serde_json",
    "//third_party/rust_crates/vendor:thiserror",
]

rustc_binary(
    name = "generator",
    srcs = _GENERATOR_SRCS,
    crate_name = "epoch_generator",
    edition = "2024",
    target_compatible_with = HOST_CONSTRAINTS,
    visibility = ["//src/sys/pkg/bin/system-updater:__pkg__"],
    deps = _GENERATOR_DEPS,
)

# @bazel2gn:skip
host_rustc_test(
    name = "epoch-generator-tests",
    srcs = _GENERATOR_SRCS,
    crate_root = "src/main.rs",
    edition = "2024",
    proc_macro_deps = [
        "//third_party/rust_crates/vendor:indoc",
    ],
    target_compatible_with = HOST_CONSTRAINTS,
    deps = _GENERATOR_DEPS + [
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:proptest",
    ],
)
