{
    offer: [
        {
            protocol: "fuchsia.feedback.CrashReporter",
            from: "#feedback",
            to: "#system-update",
            dependency: "weak",
        },
        {
            protocol: [ "fuchsia.metrics.MetricEventLoggerFactory" ],
            from: "#cobalt",
            to: "#system-update",
        },
        {
            protocol: [
                "fuchsia.pkg.internal.OtaDownloader",
                "fuchsia.pkg.PackageResolver-ota",
            ],
            from: "parent",
            to: "#system-update",
        },
        {
            protocol: [
                "fuchsia.fxfs.BlobCreator",
                "fuchsia.fxfs.BlobReader",
                "fuchsia.pkg.garbagecollector.Manager",
                "fuchsia.pkg.PackageCache",
                "fuchsia.pkg.RetainedBlobs",
                "fuchsia.pkg.RetainedPackages",
            ],
            from: "parent",
            to: "#system-update",
        },
        {
            protocol: [ "fuchsia.hardware.power.statecontrol.Admin" ],
            from: "parent",
            to: "#system-update",
        },
        {
            protocol: "fuchsia.paver.Paver",
            from: "#paver",
            to: "#system-update",
        },
        {
            directory: [
                "build-info",
                "system",
            ],
            from: "parent",
            to: "#system-update",
        },
        {
            storage: "data",
            from: "self",
            to: "#system-update",
        },
        {
            config: [
                "fuchsia.system-updater.ExcessiveUpdateDurationSeconds",
                "fuchsia.system-updater.ManifestPublicKeys",
            ],
            from: "parent",
            to: "#system-update",
            availability: "same_as_target",
        },
        {
            protocol: "fuchsia.update.CommitStatusProvider",
            from: "#system-update",
            to: "self/toolbox",
            target_availability: "unknown",
        },
    ],
}
