load("//build/bazel/rules:compiled_action.bzl", "compiled_action")
load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
    "fx_test_component",
)
load(
    "//build/bazel/rules/components:structured_config.bzl",
    "fuchsia_structured_config_rust_lib",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

exports_files(
    [
        "meta/system_updater.core_shard.cml",
        "meta/system_updater.system_update_shard.cml",
    ],
    visibility = ["//bundles/assembly:__subpackages__"],
)

# The GN build uses `generate_epoch("epoch.json")` defined above the bazel2gn
# sentinel in BUILD.gn instead.
# @bazel2gn:skip
compiled_action(
    name = "generate_epoch",
    srcs = ["//src/sys/pkg/bin/system-updater/epoch:history"],
    outs = ["epoch.json"],
    args = [
        "--history",
        "$(location //src/sys/pkg/bin/system-updater/epoch:history)",
        "--output",
        "$(location :epoch.json)",
    ],
    tool = "//src/sys/pkg/bin/system-updater/epoch:generator",
)

rustc_binary(
    name = "bin",
    srcs = [
        "src/fidl.rs",
        "src/install_manager.rs",
        "src/main.rs",
        "src/update.rs",
        "src/update/config.rs",
        "src/update/crash_report.rs",
        "src/update/environment.rs",
        "src/update/history.rs",
        "src/update/history/version.rs",
        "src/update/metrics.rs",
        "src/update/paver.rs",
        "src/update/paver/configuration.rs",
        "src/update/reboot.rs",
        "src/update/resolver.rs",
        "src/update/state.rs",
    ],
    compile_data = [
        ":epoch.json",
    ],  # @bazel2gn:raw_overwrite:[ base_epoch_file ]
    crate_name = "system_updater",
    data = [
        ":epoch.json",
    ],  # @bazel2gn:raw_overwrite:[ ":epoch.json" ]
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    proc_macro_deps = [
        "//src/lib/include_str_from_working_dir",
    ],
    rustc_env = {
        "EPOCH_PATH": "$(location :epoch.json)",
    },  # @bazel2gn:raw_overwrite:[ "EPOCH_PATH=$rebased_epoch_file" ]
    deps = [
        ":config_lib",
        "//sdk/fidl/fuchsia.feedback:fuchsia.feedback_rust",
        "//sdk/fidl/fuchsia.hardware.power.statecontrol:fuchsia.hardware.power.statecontrol_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/fidl/fuchsia.mem:fuchsia.mem_rust",
        "//sdk/fidl/fuchsia.metrics:fuchsia.metrics_rust",
        "//sdk/fidl/fuchsia.paver:fuchsia.paver_rust",
        "//sdk/fidl/fuchsia.pkg:fuchsia.pkg_rust",
        "//sdk/fidl/fuchsia.pkg.garbagecollector:fuchsia.pkg.garbagecollector_rust",
        "//sdk/fidl/fuchsia.pkg.internal:fuchsia.pkg.internal_rust",
        "//sdk/rust/zx",
        "//src/lib/cobalt/rust/builders",
        "//src/lib/diagnostics/inspect/contrib/rust",
        "//src/lib/diagnostics/inspect/runtime/rust",
        "//src/lib/diagnostics/inspect/rust:fuchsia-inspect",  # @bazel2gn:path_overwrite://src/lib/diagnostics/inspect/rust
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fidl/rust/fidl-contrib",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-fs",
        "//src/lib/fuchsia-url",
        "//src/lib/http-uri-ext",
        "//src/lib/mapped-vmo",
        "//src/sys/lib/fidl-fuchsia-pkg-ext",
        "//src/sys/lib/fuchsia_backoff",
        "//src/sys/pkg/fidl/fuchsia.update.installer:fuchsia.update.installer_rust",
        "//src/sys/pkg/lib/async-generator",
        "//src/sys/pkg/lib/blobfs",
        "//src/sys/pkg/lib/bounded-node",
        "//src/sys/pkg/lib/epoch",
        "//src/sys/pkg/lib/event-queue",
        "//src/sys/pkg/lib/fetch-url",
        "//src/sys/pkg/lib/fidl-fuchsia-update-installer-ext",
        "//src/sys/pkg/lib/fuchsia-hash",
        "//src/sys/pkg/lib/fuchsia-merkle",
        "//src/sys/pkg/lib/fuchsia-pkg",
        "//src/sys/pkg/lib/metrics:cobalt_sw_delivery_registry_rustlib",
        "//src/sys/pkg/lib/update-package",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:chrono",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:hex",
        "//third_party/rust_crates/vendor:http",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:ring",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:serde_json",
        "//third_party/rust_crates/vendor:sha2",
        "//third_party/rust_crates/vendor:thiserror",
        "//third_party/rust_crates/vendor:uuid",
    ],
)

# The Bazel build defines an equivalent `fx_component_manifest("manifest")`
# target, so that `:config_lib` refers to the same label in both builds.
fx_component_manifest(
    name = "manifest",
    component_name = "system-updater",
    includes = [
        "meta/system-updater-common.shard.cml",
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/syslog:client.shard",
    ],
    manifest = "meta/system-updater.cml",
)

fuchsia_structured_config_rust_lib(
    name = "config_lib",
    cm_label = ":manifest",
    crate_name = "system_updater_config",
)

fx_packaged_binary(
    name = "system_updater_packaged_bin",
    binary = ":bin",
    binary_name = "system_updater",
)

fx_component(
    name = "component",
    compiled_manifest = ":manifest",
    component_name = "system-updater",
    visibility = [
        "//src/security/tests/pkg_test/tests:__subpackages__",
        "//src/sys/pkg:__subpackages__",
    ],
    deps = [":system_updater_packaged_bin"],
)

fx_component_manifest(
    name = "isolated-v2-manifest",
    component_name = "system-updater-isolated",
    includes = [
        "meta/system-updater-common.shard.cml",
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/syslog:client.shard",
    ],
    manifest = "meta/system-updater-isolated.cml",
)

fx_component(
    name = "isolated-v2",
    compiled_manifest = ":isolated-v2-manifest",
    component_name = "system-updater-isolated",
    visibility = ["//src/sys/pkg/tests/system-updater:__pkg__"],
    deps = [":system_updater_packaged_bin"],
)

# @bazel2gn:skip
rustc_test(
    name = "bin_test",
    compile_data = [":epoch.json"],
    crate = ":bin",
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    rustc_env = {
        "EPOCH_PATH": "$(location :epoch.json)",
    },
    deps = [
        "//src/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
        "//src/lib/fuchsia-sync",
        "//src/sys/pkg/lib/fuchsia-pkg-testing",
        "//src/sys/pkg/testing/mock-crash-reporter:lib",
        "//src/sys/pkg/testing/mock-paver",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:omaha_client",
        "//third_party/rust_crates/vendor:pretty_assertions",
        "//third_party/rust_crates/vendor:proptest",
        "//third_party/rust_crates/vendor:test-case",
    ],
)

fx_packaged_binary(
    name = "bin_test_packaged_bin",
    testonly = True,
    binary = ":bin_test",
    binary_name = "system_updater_bin_test",
)

fx_component_manifest(
    name = "test-component-manifest",
    testonly = True,
    component_name = "system-updater-tests",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/syslog:client.shard",
        "//src/storage/lib/fs_management:client.shard.cml",
        "//src/sys/test_runners:tmp_storage.shard.cml",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/system-updater-bin-test.cml",
)

fx_test_component(
    name = "test-component",
    compiled_manifest = ":test-component-manifest",
    component_name = "system-updater-tests",
    deps = [":bin_test_packaged_bin"],
)

# Bazel-only test, because `:bin_test` is skipped.
# @bazel2gn:skip
fx_package(
    name = "system-updater-tests-package",
    package_name = "system-updater-tests",
    test_components = [":test-component"],
)

fx_test(
    name = "system-updater-tests",
    max_log_severity = "ERROR",
    package = ":system-updater-tests-package",
)
