import("//build/bazel/bazel_host_tool.gni")
import("//build/components.gni")
import("//build/sdk/sdk_host_tool.gni")

if (is_host) {
  bazel_host_tool("bin") {
    bazel_target = ":host"
    bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/host"
    output_name = "far"
    install_host_tool = true
  }

  sdk_host_tool("bin_sdk") {
    category = "partner"
    output_name = "far"
    deps = [ ":bin" ]
  }
} else {
  fuchsia_package("far") {
    deps = [ ":bin" ]
  }
}

