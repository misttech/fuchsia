import("//build/components.gni")
import("//build/sdk/sdk_host_tool.gni")

if (is_host) {
  sdk_host_tool("bin_sdk") {
    category = "partner"
    output_name = "far"
    deps = [ ":bin" ]
  }
} else {
  fuchsia_package("far") {
    deps = [ ":bin" ]
  }
}

