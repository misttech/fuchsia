if (is_fuchsia) {
  executable("bin") {
    sources = [ "main.cc" ]
    visibility = [
      ":*",
      "//src/sys/pkg/tests/far:*",
    ]
    deps = [
      "//src/lib/fxl:fxl_cli",
      "//src/sys/pkg/lib/far/cpp:far",
    ]
    output_name = "far"
  }
}
