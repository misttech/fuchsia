import("//build/bazel/bazel_fuchsia_package.gni")
import("//build/bazel/bazel_host_tool.gni")
import("//build/sdk/sdk_host_tool.gni")

if (is_host) {
  bazel_host_tool("bin") {
    bazel_target = ":host"
    bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/host"
    output_name = "far"
    install_host_tool = true
  }

  # TODO(https://fxbug.dev/438572714): Remove once the IDK uses the Bazel atom.
  sdk_host_tool("bin_sdk") {
    category = "partner"
    output_name = "far"
    sdk_area = "Software Delivery"
    deps = [ ":bin" ]
  }
} else {
  bazel_fuchsia_package("far") {
    bazel_config = "fuchsia_platform"
  }
}
