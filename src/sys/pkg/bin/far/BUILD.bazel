load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/tools/bazel2gn/bazel_rules:defs.bzl", "install_host_tools")

package(default_applicable_licenses = ["//:license"])

cc_binary(
    name = "bin",
    srcs = ["main.cc"],  # @bazel2gn:raw_overwrite:[ "main.cc" ] output_name = "far"
    visibility = [
        "//build/packages:__pkg__",
        "//sdk:__pkg__",
        "//src/sys/pkg/tests/far:__pkg__",
    ],
    deps = [
        "//src/lib/fxl:fxl_cli",
        "//src/sys/pkg/lib/far/cpp:far",
    ],
)

install_host_tools(
    name = "host",
    implementation_deps = [":bin"],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    tool_output_names = ["far"],
    visibility = [
        "//bundles/tools:__pkg__",
        "//sdk/bundles:__pkg__",
    ],
)
