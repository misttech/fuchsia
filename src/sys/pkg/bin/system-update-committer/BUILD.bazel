load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
    "fx_test_component",
)
load(
    "//build/bazel/rules/components:structured_config.bzl",
    "fuchsia_structured_config_rust_lib",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

# `system-update-committer` is conceptually a binary, but it built as a lib here
# so it can be aggregated into //src/sys/pkg/bin/grand-swd-binary to save disk
# space.
rustc_library(
    name = "lib",
    srcs = [
        "src/fidl.rs",
        "src/main.rs",
        "src/metadata.rs",
        "src/metadata/commit.rs",
        "src/metadata/configuration_without_recovery.rs",
        "src/metadata/errors.rs",
        "src/metadata/inspect.rs",
        "src/metadata/policy.rs",
        "src/reboot.rs",
    ],
    crate_name = "system_update_committer",
    crate_root = "src/main.rs",
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    visibility = ["//src/sys/pkg/bin/grand-swd-binary:__pkg__"],
    deps = [
        ":system_update_committer_config",
        "//sdk/fidl/fuchsia.component.sandbox:fuchsia.component.sandbox_rust",
        "//sdk/fidl/fuchsia.hardware.power.statecontrol:fuchsia.hardware.power.statecontrol_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/fidl/fuchsia.paver:fuchsia.paver_rust",
        "//sdk/fidl/fuchsia.process.lifecycle:fuchsia.process.lifecycle_rust",
        "//sdk/fidl/fuchsia.update:fuchsia.update_rust",
        "//sdk/rust/zx",
        "//src/lib/detect-stall",
        "//src/lib/diagnostics/inspect/runtime/rust",
        "//src/lib/diagnostics/inspect/rust:fuchsia-inspect",  # @bazel2gn:path_overwrite://src/lib/diagnostics/inspect/rust
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-runtime",
        "//src/lib/fuchsia-sync",
        "//src/lib/sandbox",
        "//src/sys/pkg/fidl/fuchsia.update.verify:fuchsia.update.verify_rust",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)

# The Bazel build defines an equivalent `fx_component_manifest("manifest")`
# target, so that `:system_update_committer_config` refers to the same label in
# both builds.
fx_component_manifest(
    name = "manifest",
    component_name = "system-update-committer",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/syslog:client.shard",
    ],
    manifest = "meta/system-update-committer.cml",
)

fuchsia_structured_config_rust_lib(
    name = "system_update_committer_config",
    cm_label = ":manifest",
)

fx_packaged_binary(
    name = "bin",
    binary = "//src/sys/pkg/bin/grand-swd-binary",
    binary_name = "system_update_committer",
)

fx_component(
    name = "component",
    compiled_manifest = ":manifest",
    component_name = "system-update-committer",
    visibility = [
        "//src/security/tests/pkg_test/tests:__subpackages__",
        "//src/sys/pkg:__subpackages__",
    ],
    deps = [
        ":bin",  # @bazel2gn:path_overwrite::bin
    ],
)

# @bazel2gn:raw_attribute:output_name = "system_update_committer_lib_test"
rustc_test(
    name = "lib_test",
    crate = ":lib",
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    deps = [
        "//src/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
        "//src/sys/pkg/testing/mock-health-verification",
        "//src/sys/pkg/testing/mock-paver",
        "//src/sys/pkg/testing/mock-reboot",
        "//third_party/rust_crates/vendor:assert_matches",
    ],
)

fx_packaged_binary(
    name = "lib_test_packaged_bin",
    testonly = True,
    binary = ":lib_test",
    binary_name = "system_update_committer_lib_test",
)

fx_component_manifest(
    name = "unittest_manifest",
    testonly = True,
    component_name = "unittest_component",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/unittests.cml",
)

fx_test_component(
    name = "unittest_component",
    compiled_manifest = ":unittest_manifest",
    component_name = "unittest_component",
    deps = [":lib_test_packaged_bin"],
)

fx_package(
    name = "system-update-committer-tests-package",
    package_name = "system-update-committer-tests",
    test_components = [":unittest_component"],
)

fx_test(
    name = "system-update-committer-tests",
    package = ":system-update-committer-tests-package",
)
