load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component_manifest",
)
load(
    "//build/bazel/rules/components:structured_config.bzl",
    "fuchsia_structured_config_rust_lib",
)
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

# `system-update-committer` is conceptually a binary, but it built as a lib here
# so it can be aggregated into //src/sys/pkg/bin/grand-swd-binary to save disk
# space.
rustc_library(
    name = "lib",
    srcs = [
        "src/fidl.rs",
        "src/main.rs",
        "src/metadata.rs",
        "src/metadata/commit.rs",
        "src/metadata/configuration_without_recovery.rs",
        "src/metadata/errors.rs",
        "src/metadata/inspect.rs",
        "src/metadata/policy.rs",
        "src/reboot.rs",
    ],
    crate_name = "system_update_committer",
    crate_root = "src/main.rs",
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    visibility = ["//src/sys/pkg/bin/grand-swd-binary:__pkg__"],
    deps = [
        ":system_update_committer_config",
        "//sdk/fidl/fuchsia.component.sandbox:fuchsia.component.sandbox_rust",
        "//sdk/fidl/fuchsia.hardware.power.statecontrol:fuchsia.hardware.power.statecontrol_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/fidl/fuchsia.paver:fuchsia.paver_rust",
        "//sdk/fidl/fuchsia.process.lifecycle:fuchsia.process.lifecycle_rust",
        "//sdk/fidl/fuchsia.update:fuchsia.update_rust",
        "//sdk/rust/zx",
        "//src/lib/detect-stall",
        "//src/lib/diagnostics/inspect/runtime/rust",
        "//src/lib/diagnostics/inspect/rust:fuchsia-inspect",  # @bazel2gn:path_overwrite://src/lib/diagnostics/inspect/rust
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-runtime",
        "//src/lib/fuchsia-sync",
        "//src/lib/sandbox",
        "//src/sys/pkg/fidl/fuchsia.update.verify:fuchsia.update.verify_rust",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)

# The GN build uses the `fuchsia_component_manifest("manifest")` target defined
# above the bazel2gn sentinel in BUILD.gn instead.
# @bazel2gn:skip
fx_component_manifest(
    name = "manifest",
    component_name = "system-update-committer",
    includes = [
        "//sdk/lib/inspect:client.shard.cml",
        "//sdk/lib/inspect:offer.shard.cml",
        "//sdk/lib/inspect:use.shard.cml",
        "//sdk/lib/syslog:client.shard.cml",
        "//sdk/lib/syslog:offer.shard.cml",
        "//sdk/lib/syslog:use.shard.cml",
    ],
    manifest = "meta/system-update-committer.cml",
)

fuchsia_structured_config_rust_lib(
    name = "system_update_committer_config",
    cm_label = ":manifest",
)
