load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load(
    "//build/bazel/rules/components:structured_config.bzl",
    "fuchsia_structured_config_rust_lib",
)
load(
    "//build/bazel/rules/packages:fx_package.bzl",
    "fx_package",
)
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")

package(default_applicable_licenses = ["//:license"])

exports_files(
    [
        "meta/null_update_checker.core_shard.cml",
        "meta/null_update_checker.system_update_shard.cml",
    ],
    visibility = ["//bundles/assembly:__subpackages__"],
)

rustc_binary(
    name = "bin",
    srcs = ["src/main.rs"],
    crate_name = "null_update_checker",
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    tags = ["manual"],
    deps = [
        ":null_update_checker_config",
        "//sdk/fidl/fuchsia.process.lifecycle:fuchsia.process.lifecycle_rust",
        "//sdk/fidl/fuchsia.update.channel:fuchsia.update.channel_rust",
        "//sdk/fidl/fuchsia.update:fuchsia.update_rust",
        "//sdk/rust/zx",
        "//src/lib/detect-stall",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-runtime",
        "//src/lib/fuchsia-sync",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
    ],
)

# @bazel2gn:skip
fx_packaged_binary(
    name = "null_update_checker_packaged_bin",
    binary = ":bin",
    binary_name = "null_update_checker",
)

# The Bazel build defines an equivalent `fx_component_manifest("manifest")`
# target, so that `:null_update_checker_config` refers to the same label in
# both builds.
fx_component_manifest(
    name = "manifest",
    component_name = "null-update-checker",
    includes = [
        "//sdk/lib/syslog:client.shard",
    ],
    manifest = "meta/null-update-checker.cml",
)

fx_component(
    name = "component",
    compiled_manifest = ":manifest",
    deps = [
        ":null_update_checker_packaged_bin",
    ],
)

# @bazel2gn:skip
fx_package(
    name = "package",
    package_name = "null-update-checker",
    components = [
        ":component",
    ],
    visibility = ["//bundles/assembly:__subpackages__"],
)

fuchsia_structured_config_rust_lib(
    name = "null_update_checker_config",
    cm_label = ":manifest",
)
