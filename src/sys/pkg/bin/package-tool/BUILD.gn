import("//build/bazel/bazel_host_tool.gni")

if (is_host) {
  bazel_host_tool("package-tool") {
    bazel_target = ":package-tool"
    bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/package-tool"
    install_host_tool = true
  }

  group("host") {
    public_deps = [ ":package-tool" ]
  }
} else {
  group("package-tool") {
    deps = [ ":package-tool($host_toolchain)" ]
  }

  group("host") {
    deps = [ ":host($host_toolchain)" ]
  }
}

# Empty group for soft transitioning targets in other repos.
# TODO(b/519244675): Remove after soft transitioning.
group("bazel_input") {
}
