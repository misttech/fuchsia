load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component_manifest",
)
load(
    "//build/bazel/rules/components:structured_config.bzl",
    "fuchsia_structured_config_rust_lib",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")

package(default_applicable_licenses = ["//:license"])

exports_files(
    [
        "meta/system_update_checker.core_shard.cml",
        "meta/system_update_checker.system_update_shard.cml",
    ],
    visibility = ["//bundles/assembly:__subpackages__"],
)

rustc_binary(
    name = "bin",
    srcs = [
        "src/apply.rs",
        "src/channel.rs",
        "src/channel_handler.rs",
        "src/check.rs",
        "src/completion_responder.rs",
        "src/connect.rs",
        "src/errors.rs",
        "src/main.rs",
        "src/rate_limiter.rs",
        "src/update_manager.rs",
        "src/update_monitor.rs",
        "src/update_service.rs",
    ],
    crate_name = "system_update_checker",
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    deps = [
        ":system_update_checker_config",
        "//sdk/fidl/fuchsia.mem:fuchsia.mem_rust",
        "//sdk/fidl/fuchsia.paver:fuchsia.paver_rust",
        "//sdk/fidl/fuchsia.pkg:fuchsia.pkg_rust",
        "//sdk/fidl/fuchsia.pkg.garbagecollector:fuchsia.pkg.garbagecollector_rust",
        "//sdk/fidl/fuchsia.update.channel:fuchsia.update.channel_rust",
        "//sdk/fidl/fuchsia.update.channelcontrol:fuchsia.update.channelcontrol_rust",
        "//sdk/fidl/fuchsia.update:fuchsia.update_rust",
        "//sdk/rust/zx",
        "//src/lib/diagnostics/inspect/contrib/rust",
        "//src/lib/diagnostics/inspect/runtime/rust",
        "//src/lib/diagnostics/inspect/rust:fuchsia-inspect",  # @bazel2gn:path_overwrite://src/lib/diagnostics/inspect/rust
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-sync",
        "//src/lib/fuchsia-url",
        "//src/lib/mapped-vmo",
        "//src/sys/lib/fidl-fuchsia-pkg-ext",
        "//src/sys/pkg/fidl/fuchsia.update.installer:fuchsia.update.installer_rust",
        "//src/sys/pkg/lib/async-generator",
        "//src/sys/pkg/lib/event-queue",
        "//src/sys/pkg/lib/fidl-fuchsia-update-ext",
        "//src/sys/pkg/lib/fidl-fuchsia-update-installer-ext",
        "//src/sys/pkg/lib/fuchsia-hash",
        "//src/sys/pkg/lib/update-package",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:http",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:serde_json",
        "//third_party/rust_crates/vendor:sha2",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)

# The GN build uses the `fuchsia_component_manifest("manifest")` target defined
# above the bazel2gn sentinel in BUILD.gn instead.
# @bazel2gn:skip
fx_component_manifest(
    name = "manifest",
    component_name = "system-update-checker",
    includes = [
        "//sdk/lib/inspect:client.shard.cml",
        "//sdk/lib/inspect:offer.shard.cml",
        "//sdk/lib/inspect:use.shard.cml",
        "//sdk/lib/syslog:client.shard",
    ],
    manifest = "meta/system-update-checker.cml",
)

fuchsia_structured_config_rust_lib(
    name = "system_update_checker_config",
    cm_label = ":manifest",
)
