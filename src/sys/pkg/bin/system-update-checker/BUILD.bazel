load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
    "fx_test_component",
)
load(
    "//build/bazel/rules/components:structured_config.bzl",
    "fuchsia_structured_config_rust_lib",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

exports_files(
    [
        "meta/system_update_checker.core_shard.cml",
        "meta/system_update_checker.system_update_shard.cml",
    ],
    visibility = ["//bundles/assembly:__subpackages__"],
)

rustc_binary(
    name = "bin",
    srcs = [
        "src/apply.rs",
        "src/channel.rs",
        "src/channel_handler.rs",
        "src/check.rs",
        "src/completion_responder.rs",
        "src/connect.rs",
        "src/errors.rs",
        "src/main.rs",
        "src/rate_limiter.rs",
        "src/update_manager.rs",
        "src/update_monitor.rs",
        "src/update_service.rs",
    ],
    crate_name = "system_update_checker",
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    deps = [
        ":system_update_checker_config",
        "//sdk/fidl/fuchsia.mem:fuchsia.mem_rust",
        "//sdk/fidl/fuchsia.paver:fuchsia.paver_rust",
        "//sdk/fidl/fuchsia.pkg:fuchsia.pkg_rust",
        "//sdk/fidl/fuchsia.pkg.garbagecollector:fuchsia.pkg.garbagecollector_rust",
        "//sdk/fidl/fuchsia.update.channel:fuchsia.update.channel_rust",
        "//sdk/fidl/fuchsia.update.channelcontrol:fuchsia.update.channelcontrol_rust",
        "//sdk/fidl/fuchsia.update:fuchsia.update_rust",
        "//sdk/rust/zx",
        "//src/lib/diagnostics/inspect/contrib/rust",
        "//src/lib/diagnostics/inspect/runtime/rust",
        "//src/lib/diagnostics/inspect/rust:fuchsia-inspect",  # @bazel2gn:path_overwrite://src/lib/diagnostics/inspect/rust
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-sync",
        "//src/lib/fuchsia-url",
        "//src/lib/mapped-vmo",
        "//src/sys/lib/fidl-fuchsia-pkg-ext",
        "//src/sys/pkg/fidl/fuchsia.update.installer:fuchsia.update.installer_rust",
        "//src/sys/pkg/lib/async-generator",
        "//src/sys/pkg/lib/event-queue",
        "//src/sys/pkg/lib/fidl-fuchsia-update-ext",
        "//src/sys/pkg/lib/fidl-fuchsia-update-installer-ext",
        "//src/sys/pkg/lib/fuchsia-hash",
        "//src/sys/pkg/lib/update-package",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:http",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:serde_json",
        "//third_party/rust_crates/vendor:sha2",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)

fx_packaged_binary(
    name = "bin_packaged_bin",
    binary = ":bin",
    binary_name = "system_update_checker",
)

# The Bazel build defines an equivalent `fx_component_manifest("manifest")`
# target, so that `:system_update_checker_config` refers to the same label in
# both builds.
fx_component_manifest(
    name = "manifest",
    component_name = "system-update-checker",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/syslog:client.shard",
    ],
    manifest = "meta/system-update-checker.cml",
)

fuchsia_structured_config_rust_lib(
    name = "system_update_checker_config",
    cm_label = ":manifest",
)

fx_component(
    name = "component",
    compiled_manifest = ":manifest",
    component_name = "system-update-checker",
    visibility = ["//src/sys/pkg/tests/system-update-checker:__pkg__"],
    deps = [":bin_packaged_bin"],
)

# @bazel2gn:raw_attribute:output_name = "system_update_checker_bin_test"
rustc_test(
    name = "bin_test",
    crate = ":bin",
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    deps = [
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//src/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
        "//src/lib/fdio/rust:fdio",
        "//src/sys/pkg/testing/mock-paver",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:maplit",
        "//third_party/rust_crates/vendor:proptest",
        "//third_party/rust_crates/vendor:tempfile",
        "//third_party/rust_crates/vendor:test-case",
    ],
)

fx_packaged_binary(
    name = "bin_test_packaged_bin",
    testonly = True,
    binary = ":bin_test",
    binary_name = "system_update_checker_bin_test",
)

fx_component_manifest(
    name = "system-update-checker-bin-test-manifest",
    testonly = True,
    component_name = "system-update-checker-bin-test",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners:tmp_storage.shard.cml",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/system-update-checker-bin-test.cml",
)

fx_test_component(
    name = "system-update-checker-bin-test",
    compiled_manifest = ":system-update-checker-bin-test-manifest",
    deps = [":bin_test_packaged_bin"],
)

fx_package(
    name = "system-update-checker-tests-package",
    package_name = "system-update-checker-tests",
    test_components = [":system-update-checker-bin-test"],
)

fx_test(
    name = "system-update-checker-tests",
    max_log_severity = "ERROR",
    package = ":system-update-checker-tests-package",
)
