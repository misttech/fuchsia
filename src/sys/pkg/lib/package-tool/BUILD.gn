  # //src/developer/ffx/lib/pkg:empty-repo-metadata are migrated.
  # LINT.IfChange(package_tool_test)
  rustc_test("package-tool_test") {
    name = "package_tool_lib_test"
    version = "0.1.0"
    edition = "2024"

    deps = [
      "//src/developer/ffx/lib/pkg:empty-repo-keys",
      "//src/developer/ffx/lib/pkg:empty-repo-metadata",
      "//src/lib/assembly/partitions_config",
      "//src/lib/assembly/product_bundle",
