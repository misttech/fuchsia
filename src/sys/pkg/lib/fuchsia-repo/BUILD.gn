import("//build/rust/rustc_test.gni")

relative_root_out_dir = rebase_path(root_out_dir, root_build_dir)

# The library is defined in BUILD.bazel. Its unit tests stay in GN because
# :fuchsia-repo_test depends on //src/developer/ffx/lib/pkg:empty-repo-keys and
# //src/developer/ffx/lib/pkg:empty-repo-metadata, which are GN-only.
rustc_test("fuchsia-repo_test") {
  output_name = "fuchsia_repo_lib_test"
  edition = "2024"

  deps = [
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-url",
    "//src/lib/mundane",
    "//src/lib/versioning/version-history/rust",
    "//src/storage/lib/delivery_blob",
    "//src/sys/lib/fidl-fuchsia-pkg-ext",
    "//src/sys/pkg/lib/far/rust:fuchsia-archive",
    "//src/sys/pkg/lib/fuchsia-hash",
    "//src/sys/pkg/lib/fuchsia-merkle",
    "//src/sys/pkg/lib/fuchsia-pkg",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:assert_matches",
    "//third_party/rust_crates:bytes",
    "//third_party/rust_crates:camino",
    "//third_party/rust_crates:chrono",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:hex",
    "//third_party/rust_crates:http",
    "//third_party/rust_crates:http-body-util",
    "//third_party/rust_crates:hyper",
    "//third_party/rust_crates:libc",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:maplit",
    "//third_party/rust_crates:proptest",
    "//third_party/rust_crates:serde",
    "//third_party/rust_crates:serde_json",
    "//third_party/rust_crates:tempfile",
    "//third_party/rust_crates:thiserror",
    "//third_party/rust_crates:tuf",
    "//third_party/rust_crates:url",
    "//third_party/rust_crates:walkdir",
  ]

  if (is_host) {
    deps += [
      "//src/developer/ffx/lib/netext:lib",
      "//src/developer/ffx/lib/pkg:empty-repo-keys",
      "//src/developer/ffx/lib/pkg:empty-repo-metadata",
      "//src/developer/ffx/lib/target_net:lib",
      "//src/lib/fuchsia-fs",
      "//src/lib/fuchsia-hyper",
      "//src/lib/gcs",
      "//src/lib/http-sse:http_sse",
      "//src/sys/lib/notify-batch-watcher",
      "//third_party/rust_crates:async-lock",
      "//third_party/rust_crates:derivative",
      "//third_party/rust_crates:hyper-util",
      "//third_party/rust_crates:notify",
      "//third_party/rust_crates:pin-project",
      "//third_party/rust_crates:pretty_assertions",
      "//third_party/rust_crates:tokio",
    ]
  }

  sources = [
    "src/body.rs",
    "src/lib.rs",
    "src/manager.rs",
    "src/package_manifest_watcher.rs",
    "src/range.rs",
    "src/repo_builder.rs",
    "src/repo_client.rs",
    "src/repo_keys.rs",
    "src/repository.rs",
    "src/repository/file_system.rs",
    "src/repository/gcs_repository.rs",
    "src/repository/http_repository.rs",
    "src/repository/pm.rs",
    "src/repository/repo_tests.rs",
    "src/resource.rs",
    "src/server.rs",
    "src/test_utils.rs",
    "src/util.rs",
  ]

  configs += [ "//build/config/rust/lints:clippy_warn_all" ]
  rustenv = [ "ROOT_OUT_DIR=$relative_root_out_dir" ]
}

group("tests") {
  testonly = true
  deps = [
    ":fuchsia-repo_test",
    ":fuchsia-repo_test($host_toolchain)",
  ]
}

