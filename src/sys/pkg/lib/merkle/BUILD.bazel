load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_go_test.bzl", "host_go_test")

package(default_applicable_licenses = ["//:license"])

go_library(
    name = "merkle",
    srcs = ["merkle.go"],
    importpath = "go.fuchsia.dev/fuchsia/src/sys/pkg/lib/merkle",
    target_compatible_with = HOST_OS_CONSTRAINTS,  # @bazel2gn:skip
    visibility = [
        "//src/testing/host-target-testing/build:__pkg__",
        "//src/testing/host-target-testing/packages:__pkg__",
    ],
)

# @bazel2gn:skip
host_go_test(
    name = "go_merkle_test",
    srcs = ["merkle_test.go"],
    embed = [":merkle"],
    target_compatible_with = HOST_OS_CONSTRAINTS,
)
