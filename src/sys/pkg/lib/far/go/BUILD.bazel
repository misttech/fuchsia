load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_go_test.bzl", "host_go_test")
load("//build/bazel/rules/host_tests:host_test_data.bzl", "host_test_data_files")

package(default_applicable_licenses = ["//:license"])

go_library(
    name = "far",
    srcs = ["far.go"],
    importpath = "go.fuchsia.dev/fuchsia/src/sys/pkg/lib/far/go",
    target_compatible_with = HOST_OS_CONSTRAINTS,  # @bazel2gn:skip
    visibility = [
        "//src/sys/pkg/lib/far:__pkg__",
        "//src/testing/host-target-testing/build:__pkg__",
        "//src/testing/host-target-testing/packages:__pkg__",
    ],
)

host_test_data_files(
    name = "invalid_fars_test_data",
    testonly = True,
    srcs = ["//src/sys/pkg/testing/invalid-fars:generate-invalid-fars"],
    dest_dir = "invalid-fars",
)

# TODO(https://fxbug.dev/574121341): Run this test in GN too.
# @bazel2gn:skip
host_go_test(
    name = "go_far_test",
    srcs = [
        "far_test.go",
        "reject_invalid_fars_test.go",
    ],
    embed = [":far"],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    test_args = ["-test_data_dir=invalid-fars"],
    test_data = [":invalid_fars_test_data"],
)
