rustc_library("fuchsia-archive") {
  sources = [
    "src/async_read.rs",
    "src/async_utf8_reader.rs",
    "src/error.rs",
    "src/lib.rs",
    "src/name.rs",
    "src/read.rs",
    "src/utf8_reader.rs",
    "src/write.rs",
  ]
  edition = "2024"
  lint_config = "//build/config/rust/lints:clippy_warn_all"
  test_deps = [
    "//src/lib/fuchsia",
    "//third_party/rust_crates:assert_matches",
    "//third_party/rust_crates:itertools",
  ]
  visibility = [ "*" ]
  with_unit_tests = true
  deps = [
    "//src/lib/fuchsia-fs",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:static_assertions",
    "//third_party/rust_crates:thiserror",
    "//third_party/rust_crates:zerocopy",
  ]
}
if (is_fuchsia) {
  rustc_test("reject-invalid-fars-test") {
    sources = [ "tests/reject_invalid_fars.rs" ]
    source_root = "tests/reject_invalid_fars.rs"
    edition = "2024"
    deps = [
      ":fuchsia-archive",
      "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
      "//src/lib/fuchsia",
      "//src/lib/fuchsia-fs",
      "//third_party/rust_crates:assert_matches",
    ]
  }
}
