load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component_manifest",
    "fx_test_component",
)
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")

package(default_applicable_licenses = ["//:license"])

# The unit test package (`:omaha-client-fuchsia-tests`) stays in BUILD.gn
# because it packages GN-only components
# (`//src/connectivity/network/dns:component`,
# `//src/connectivity/network/netstack3:component-for-tests`,
# `//src/connectivity/policy/http-client:component`,
# `//src/power/shutdown-shim/tests:shutdown_shim_component`, and
# `//src/sys/stash:stash2_v2`).
rustc_library(
    name = "omaha-client-fuchsia",
    srcs = [
        "src/app_set.rs",
        "src/http_request.rs",
        "src/install_plan.rs",
        "src/installer.rs",
        "src/lib.rs",
        "src/timer.rs",
    ],
    edition = "2024",
    visibility = [
        "//src/sys/pkg/bin/omaha-client:__pkg__",
        "//src/sys/pkg/lib:__subpackages__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.mem:fuchsia.mem_rust",
        "//sdk/fidl/fuchsia.net.http:fuchsia.net.http_rust",
        "//sdk/fidl/fuchsia.pkg:fuchsia.pkg_rust",
        "//sdk/rust/zx",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-url",
        "//src/sys/lib/fidl-connector",
        "//src/sys/pkg/fidl/fuchsia.update.installer:fuchsia.update.installer_rust",
        "//src/sys/pkg/lib/channel-config",
        "//src/sys/pkg/lib/fidl-fuchsia-update-installer-ext",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:http",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:omaha_client",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)

# The library is defined in BUILD.bazel. Its unit tests stay in GN because
# `:omaha-client-fuchsia_test` depends on
# `//src/lib/testing/fuchsia-hyper-test-support` and
# `:omaha-client-fuchsia-tests` packages GN-only components
# (`//src/connectivity/network/dns:component`,
# `//src/connectivity/network/netstack3:component-for-tests`,
# `//src/connectivity/policy/http-client:component`,
# `//src/power/shutdown-shim/tests:shutdown_shim_component`, and
# `//src/sys/stash:stash2_v2`).
# @bazel2gn:skip
rustc_test(
    name = "omaha-client-fuchsia_test",
    crate = ":omaha-client-fuchsia",
    edition = "2024",
    deps = [
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-sync",
        "//src/lib/testing/fuchsia-hyper-test-support",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:hyper",
        "//third_party/rust_crates/vendor:serde_json",
    ],
)

# @bazel2gn:skip
fx_packaged_binary(
    name = "omaha-client-fuchsia_test_packaged_bin",
    testonly = True,
    binary = ":omaha-client-fuchsia_test",
    binary_name = "omaha_client_fuchsia_lib_test",
)

# @bazel2gn:skip
fx_component_manifest(
    name = "test-driver-manifest",
    testonly = True,
    component_name = "test-driver",
    includes = [
        "//sdk/lib/inspect:client.shard.cml",
        "//sdk/lib/inspect:offer.shard.cml",
        "//sdk/lib/inspect:use.shard.cml",
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners:tmp_storage.shard.cml",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/test-driver.cml",
)

# TODO(https://fxbug.dev/574121341): Run in GN too.
# @bazel2gn:skip
fx_test_component(
    name = "omaha-client-fuchsia-tests-test-driver",
    compiled_manifest = ":test-driver-manifest",
    component_name = "test-driver",
    deps = [":omaha-client-fuchsia_test_packaged_bin"],
)
