import("//build/components.gni")
import("//build/rust/rustc_test.gni")

# The library is defined in BUILD.bazel. Its unit tests stay in GN because
# `:omaha-client-fuchsia_test` depends on
# `//src/lib/testing/fuchsia-hyper-test-support` and
# `:omaha-client-fuchsia-tests` packages GN-only components
# (`//src/connectivity/network/dns:component`,
# `//src/connectivity/network/netstack3:component-for-tests`,
# `//src/connectivity/policy/http-client:component`,
# `//src/power/shutdown-shim/tests:shutdown_shim_component`, and
# `//src/sys/stash:stash2_v2`).
rustc_test("omaha-client-fuchsia_test") {
  output_name = "omaha_client_fuchsia_lib_test"
  edition = "2024"

  deps = [
    "//sdk/fidl/fuchsia.mem:fuchsia.mem_rust",
    "//sdk/fidl/fuchsia.net.http:fuchsia.net.http_rust",
    "//sdk/fidl/fuchsia.pkg:fuchsia.pkg_rust",
    "//sdk/rust/zx",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//src/lib/fuchsia-sync",
    "//src/lib/fuchsia-url",
    "//src/lib/testing/fuchsia-hyper-test-support",
    "//src/sys/lib/fidl-connector",
    "//src/sys/pkg/fidl/fuchsia.update.installer:fuchsia.update.installer_rust",
    "//src/sys/pkg/lib/channel-config",
    "//src/sys/pkg/lib/fidl-fuchsia-update-installer-ext",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:assert_matches",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:http",
    "//third_party/rust_crates:hyper",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:omaha_client",
    "//third_party/rust_crates:serde_json",
    "//third_party/rust_crates:thiserror",
  ]

  sources = [
    "src/app_set.rs",
    "src/http_request.rs",
    "src/install_plan.rs",
    "src/installer.rs",
    "src/lib.rs",
    "src/timer.rs",
  ]
}

fuchsia_component("omaha-client-fuchsia-tests-test-driver") {
  testonly = true
  component_name = "test-driver"
  manifest = "meta/test-driver.cml"
  deps = [ ":omaha-client-fuchsia_test" ]
}

fuchsia_unittest_package("omaha-client-fuchsia-tests") {
  manifest = "meta/omaha-client-fuchsia-test.cml"

  deps = [
    ":omaha-client-fuchsia-tests-test-driver",
    "//src/connectivity/network/dns:component",
    "//src/connectivity/network/netstack3:component-for-tests",
    "//src/connectivity/policy/http-client:component",
    "//src/power/shutdown-shim/tests:shutdown_shim_component",
    "//src/sys/pkg/bin/fake-channel-control",
    "//src/sys/pkg/testing:fake-ssl-certs",
    "//src/sys/stash:stash2_v2",
  ]
}

group("tests") {
  testonly = true
  deps = [ ":omaha-client-fuchsia-tests" ]
}

