load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "wrap_host_rust_test")
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")
load("//build/bazel/rules/testing:fx_unittest_component.bzl", "fx_unittest_component")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "work-queue",
    srcs = [
        "src/lib.rs",
        "src/state.rs",
    ],
    crate_name = "work_queue",
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    visibility = [
        "//src/sys/pkg/bin/pkg-cache:__pkg__",
        "//src/sys/pkg/bin/pkg-resolver:__pkg__",
        "//src/sys/pkg/lib:__pkg__",
    ],
    deps = [
        "//src/lib/diagnostics/inspect/rust:fuchsia-inspect",
        "//src/lib/fuchsia-sync",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:pin-project",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)

# @bazel2gn:skip
rustc_test(
    name = "work-queue_test",
    crate = ":work-queue",
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    deps = [
        "//src/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
    ],
)

# @bazel2gn:skip
wrap_host_rust_test(
    name = "work-queue_host_test",
    binary_name = "work-queue_test",
)

# @bazel2gn:skip
fx_unittest_component(
    name = "test-component",
    binary = ":work-queue_test",
    component_name = "work-queue-lib-test",
)

# @bazel2gn:skip
fx_package(
    name = "work-queue-tests-package",
    package_name = "work-queue-tests",
    test_components = [":test-component"],
)

# @bazel2gn:skip
fx_test(
    name = "work-queue-tests",
    package = ":work-queue-tests-package",
)
