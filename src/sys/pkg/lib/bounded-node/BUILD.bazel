load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "bounded-node",
    srcs = ["src/lib.rs"],
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    visibility = [
        "//src/sys/pkg/bin/omaha-client:__pkg__",
        "//src/sys/pkg/bin/system-updater:__pkg__",
        "//src/sys/pkg/lib:__pkg__",
    ],
    deps = [
        "//src/lib/diagnostics/inspect/contrib/rust",
        "//src/lib/diagnostics/inspect/rust:fuchsia-inspect",
    ],
)

# @bazel2gn:skip
rustc_test(
    name = "bounded-node_test",
    crate = ":bounded-node",
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    deps = [
        "//src/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
        "//src/lib/fuchsia",
    ],
)

# @bazel2gn:skip
fx_unittest_package(
    name = "bounded-node-tests",
    unit_tests = [":bounded-node_test"],
)
