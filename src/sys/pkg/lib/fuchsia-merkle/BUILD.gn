rustc_library("fuchsia-merkle") {
  sources = [
    "src/lib.rs",
    "src/merkle_root_builder.rs",
    "src/merkle_verifier.rs",
    "src/util.rs",
  ]
  edition = "2024"
  lint_config = "//build/config/rust/lints:clippy_warn_all"
  visibility = [
    ":*",
    "//src/bringup/*",
    "//src/developer/*",
    "//src/lib/assembly/*",
    "//src/recovery/*",
    "//src/security/*",
    "//src/storage/*",
    "//src/sys/*",
    "//tools/lib/*",
  ]
  deps = [
    "//sdk/rust/zx-status",
    "//src/storage/lib/ptr_slice",
    "//src/sys/pkg/lib/fuchsia-hash",
    "//third_party/boringssl/rust:bssl-crypto.no-ssl",
  ]
}
