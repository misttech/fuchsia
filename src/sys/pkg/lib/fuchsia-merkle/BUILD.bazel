load("//build/bazel/rules/rust:defs.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "fuchsia-merkle",
    srcs = [
        "src/lib.rs",
        "src/merkle_root_builder.rs",
        "src/merkle_verifier.rs",
        "src/util.rs",
    ],
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    test_deps = [
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:test-case",
    ],
    visibility = ["//:__subpackages__"],
    with_host_unit_tests = True,
    deps = [
        "//sdk/rust/zx-status",
        "//src/storage/lib/ptr_slice",
        "//src/sys/pkg/lib/fuchsia-hash",
        "//third_party/boringssl/rust:bssl-crypto.no-ssl",
    ],
)
