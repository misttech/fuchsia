load(
    "@fuchsia_rules_common//packages:resources.bzl",
    "resource",
)

package(default_applicable_licenses = ["//:license"])

exports_files(
    [
        "ca.cert",
        "test.fuchsia.com.certchain",
        "test.fuchsia.com.rsa",
        "wildcard.fuchsia-updates.googleusercontent.com.certchain",
        "wildcard.fuchsia-updates.googleusercontent.com.rsa",
    ],
    visibility = [
        "//src/sys/pkg/lib/fuchsia-pkg-testing:__pkg__",
        "//src/sys/pkg/tests/pkg-cache:__pkg__",
        "//src/sys/pkg/tests/pkg-resolver:__pkg__",
    ],
)

# @bazel2gn:skip
resource(
    name = "certs",
    testonly = True,
    src = "ca.cert",
    dest = "data/ssl/cert.pem",
    visibility = [
        "//src/sys/pkg/bin/pkg-resolver:__pkg__",
        "//src/sys/pkg/lib/isolated-swd:__pkg__",
        "//src/sys/pkg/testing/isolated-ota-env:__pkg__",
        "//src/sys/pkg/tests/isolated-ota:__pkg__",
    ],
)
