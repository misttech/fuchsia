import("//build/components.gni")
import("//build/rust/rustc_test.gni")

# The library is defined in BUILD.bazel. Its unit tests stay in GN because
# system-image-test-component packages
# //src/storage/testing:storage_driver_test_realm, and :system-image_test
# depends on //src/sys/pkg/lib/fuchsia-pkg-testing and
# //src/sys/pkg/testing/blobfs-ramdisk (which are GN-only and depend back on
# :system-image).
rustc_test("system-image_test") {
  output_name = "system_image_lib_test"
  edition = "2024"

  deps = [
    "//src/lib/buf-read-ext",
    "//src/lib/collections/sorted-vec-map",
    "//src/lib/diagnostics/inspect/rust",
    "//src/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-url",
    "//src/sys/pkg/lib/blobfs",
    "//src/sys/pkg/lib/fuchsia-hash",
    "//src/sys/pkg/lib/fuchsia-pkg",
    "//src/sys/pkg/lib/fuchsia-pkg-testing",
    "//src/sys/pkg/lib/package-directory",
    "//src/sys/pkg/testing/blobfs-ramdisk",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:assert_matches",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:proptest",
    "//third_party/rust_crates:serde",
    "//third_party/rust_crates:serde_json",
    "//third_party/rust_crates:thiserror",
  ]

  sources = [
    "src/anchored_packages.rs",
    "src/cache_packages.rs",
    "src/errors.rs",
    "src/lib.rs",
    "src/path_hash_mapping.rs",
    "src/system_image.rs",
  ]
  configs += [ "//build/config/rust/lints:clippy_warn_all" ]
}

group("tests") {
  testonly = true
  public_deps = [ ":system-image-tests" ]
}

fuchsia_component("system-image-test-component") {
  testonly = true
  component_name = "system-image-tests"
  manifest = "meta/system-image-lib-test.cml"
  deps = [
    ":system-image_test",
    "//src/storage/testing:storage_driver_test_realm",
  ]
}

fuchsia_test_package("system-image-tests") {
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
  test_components = [ ":system-image-test-component" ]
}

