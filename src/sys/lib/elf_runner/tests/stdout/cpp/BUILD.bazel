load("//build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")
load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)

package(default_applicable_licenses = ["//:license"])

# fx_cc_binary names the binary after the target; GN sets output_name.
# @bazel2gn:raw_attribute:output_name = "prints_when_launched_cpp"
fx_cc_binary(
    name = "bin",
    srcs = ["src/main.cc"],
    tags = ["manual"],
)

fx_packaged_binary(
    name = "bin_packaged_bin",
    binary = ":bin",
    binary_name = "prints_when_launched_cpp",
)

fx_component_manifest(
    name = "logs-stdout-and-stderr-cpp-manifest",
    component_name = "logs-stdout-and-stderr-cpp",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/logs_stdout_and_stderr_cpp.cml",
)

fx_component(
    name = "logs-stdout-and-stderr-cpp",
    compiled_manifest = ":logs-stdout-and-stderr-cpp-manifest",
    deps = [":bin_packaged_bin"],
)

fx_component_manifest(
    name = "logs-default-cpp-manifest",
    component_name = "logs-default-cpp",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/logs_default_cpp.cml",
)

fx_component(
    name = "logs-default-cpp",
    compiled_manifest = ":logs-default-cpp-manifest",
    deps = [":bin_packaged_bin"],
)

fx_component_manifest(
    name = "logs-stdout-cpp-manifest",
    component_name = "logs-stdout-cpp",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/logs_stdout_cpp.cml",
)

fx_component(
    name = "logs-stdout-cpp",
    compiled_manifest = ":logs-stdout-cpp-manifest",
    deps = [":bin_packaged_bin"],
)

fx_component_manifest(
    name = "logs-stderr-cpp-manifest",
    component_name = "logs-stderr-cpp",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/logs_stderr_cpp.cml",
)

fx_component(
    name = "logs-stderr-cpp",
    compiled_manifest = ":logs-stderr-cpp-manifest",
    deps = [":bin_packaged_bin"],
)
