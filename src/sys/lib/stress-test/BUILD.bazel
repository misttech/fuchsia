load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "stress-test",
    srcs = [
        "src/actor.rs",
        "src/actor_runner.rs",
        "src/counter.rs",
        "src/environment.rs",
        "src/lib.rs",
    ],
    edition = "2024",
    proc_macro_deps = [
        "//third_party/rust_crates/vendor:async-trait",
    ],
    visibility = [
        "//src/storage/stress-tests/blobfs:__pkg__",
        "//src/storage/stress-tests/fvm:__pkg__",
        "//src/storage/stress-tests/genericfs:__pkg__",
        "//src/ui/tests/scenic-stress-tests:__pkg__",
    ],
    deps = [
        "//src/lib/fuchsia-async",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:rand",
    ],
)
