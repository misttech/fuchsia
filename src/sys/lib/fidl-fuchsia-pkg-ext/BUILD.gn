import("//build/bazel/bazel_test_suite.gni")
import("//build/components.gni")
import("//build/rust/rustc_test.gni")

# The library is defined in BUILD.bazel. Its device unit tests stay in GN
# because fidl-fuchsia-pkg-ext-tests packages the GN-only
# //src/storage/fxfs:fxfs_component.
if (is_fuchsia) {
  rustc_test("fidl-fuchsia-pkg-ext_test") {
    output_name = "fidl_fuchsia_pkg_ext_lib_test"
    edition = "2024"

    deps = [
      ":measure_fuchsia_pkg",
      "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
      "//sdk/fidl/fuchsia.pkg:fuchsia.pkg_rust",
      "//sdk/rust/zx",
      "//sdk/rust/zx-status",
      "//sdk/rust/zx-types",
      "//src/lib/fidl/rust/fidl",
      "//src/lib/fuchsia",
      "//src/lib/fuchsia-async",
      "//src/lib/fuchsia-url",
      "//src/lib/http-uri-ext",
      "//src/storage/fxfs/fidl/fuchsia.fxfs:fuchsia.fxfs_rust",
      "//src/storage/lib/blob_writer:blob-writer",
      "//src/sys/pkg/lib/fuchsia-hash",
      "//src/sys/pkg/lib/fuchsia-pkg",
      "//third_party/rust_crates:anyhow",
      "//third_party/rust_crates:assert_matches",
      "//third_party/rust_crates:futures",
      "//third_party/rust_crates:hex",
      "//third_party/rust_crates:http",
      "//third_party/rust_crates:log",
      "//third_party/rust_crates:proptest",
      "//third_party/rust_crates:proptest-derive",
      "//third_party/rust_crates:schemars",
      "//third_party/rust_crates:serde",
      "//third_party/rust_crates:serde_json",
      "//third_party/rust_crates:thiserror",
      "//third_party/rust_crates:typed-builder",
    ]

    sources = [
      "src/base_package_index.rs",
      "src/cache.rs",
      "src/errors.rs",
      "src/fidl_iterator_to_stream.rs",
      "src/lib.rs",
      "src/measure.rs",
      "src/repo.rs",
      "src/serve_fidl_iterator.rs",
      "src/types.rs",
    ]
  }
}

fuchsia_unittest_package("fidl-fuchsia-pkg-ext-tests") {
  deps = [
    ":fidl-fuchsia-pkg-ext_test",
    "//src/storage/fxfs:fxfs_component",
  ]
}

bazel_test_suite("fidl-fuchsia-pkg-ext-host-tests") {
  host_tests =
      [ "//src/sys/lib/fidl-fuchsia-pkg-ext:fidl-fuchsia-pkg-ext_host_test" ]
}

group("tests") {
  testonly = true
  public_deps = [
    ":fidl-fuchsia-pkg-ext-host-tests",
    ":fidl-fuchsia-pkg-ext-tests",
  ]
}

