rustc_library("fuchsia-bootfs") {
  sources = [
    "src/bootfs.rs",
    "src/lib.rs",
  ]
  edition = "2024"
  visibility = [
    ":*",
    "//src/bringup/lib/userboot/rust:*",
    "//src/factory/factory_store_providers:*",
    "//src/firmware/lib/zircon_boot/test/rust/factory_bootfs_util:*",
    "//src/sys/component_manager:*",
  ]
  deps = [
    "//sdk/rust/zx",
    "//third_party/rust_crates:static_assertions",
    "//third_party/rust_crates:thiserror",
    "//third_party/rust_crates:zerocopy",
  ]
}
rustc_test("fuchsia-bootfs_test") {
  sources = [
    "src/bootfs.rs",
    "src/lib.rs",
  ]
  edition = "2024"
  deps = [
           "//sdk/rust/zx",
           "//third_party/rust_crates:static_assertions",
           "//third_party/rust_crates:thiserror",
           "//third_party/rust_crates:zerocopy",
         ] + [ "//third_party/rust_crates:anyhow" ]
}
