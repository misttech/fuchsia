import("//build/components.gni")

# Kept in GN because
# //src/sys/component_manager/tests/crash_introspect:panic_on_start is not yet
# in Bazel, and fuchsia_test_package calls get_target_outputs() on
# test_components so its component target must be defined earlier in the file.
fuchsia_test_component("task-exceptions-cmp-gn") {
  deps = [ ":task-exceptions_test" ]
  component_name = "task-exceptions-tests"
  manifest = "meta/task-exceptions-tests.cml"
}

fuchsia_test_package("task-exceptions-tests") {
  test_components = [ ":task-exceptions-cmp-gn" ]
  deps = [ "//src/sys/component_manager/tests/crash_introspect:panic_on_start" ]
}

group("tests") {
  testonly = true
  deps = [ ":task-exceptions-tests" ]
}

