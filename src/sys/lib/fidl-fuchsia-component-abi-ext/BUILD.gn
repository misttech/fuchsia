import("//build/components.gni")
import("//build/rust/rustc_test.gni")

# Kept in GN because the test depends on `//src/storage/lib/vfs/rust:vfs`
# (`rustc_dylib("vfs_dylib")`), which places two copies of `libvfs-<hash>.so`
# in Bazel `default_runfiles` and causes `fx_packaged_binary` + `fx_package` to
# fail with duplicate `lib/libvfs-*.so`.
rustc_test("fidl-fuchsia-component-abi-ext_test") {
  name = "fidl_fuchsia_component_abi_ext_lib_test"
  edition = "2024"
  sources = [ "src/lib.rs" ]
  deps = [
    "//sdk/fidl/fuchsia.component.resolution:fuchsia.component.resolution_rust",
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//sdk/rust/zx-status",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-fs",
    "//src/lib/versioning/version-history/rust",
    "//src/lib/versioning/version-history/rust/data",
    "//src/storage/lib/vfs/rust:vfs",
    "//third_party/rust_crates:thiserror",
  ]
}

fuchsia_unittest_package("fidl-fuchsia-component-abi-ext-tests") {
  deps = [ ":fidl-fuchsia-component-abi-ext_test" ]
}

group("tests") {
  testonly = true
  deps = [ ":fidl-fuchsia-component-abi-ext-tests" ]
}

