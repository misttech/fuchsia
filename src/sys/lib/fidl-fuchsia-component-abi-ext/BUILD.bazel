load("//build/bazel/rules/rust:defs.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

# NOTE: `fidl-fuchsia-component-abi-ext-tests` remains in BUILD.gn because its
# test binary depends on `//src/storage/lib/vfs/rust:vfs` (`rustc_dylib("vfs_dylib")`).
# `@rules_rust` puts both `src/storage/lib/vfs/rust/libvfs-<hash>.so` and its
# `_solib_*` symlink into `default_runfiles`, causing `fx_packaged_binary` +
# `fx_package` to fail with:
# "Multiple files are being installed into the package at lib/libvfs-<hash>.so".
rustc_library(
    name = "fidl-fuchsia-component-abi-ext",
    srcs = ["src/lib.rs"],
    edition = "2024",
    visibility = [
        "//src/lib/fuchsia-component-test/realm_builder_server:__pkg__",
        "//src/sys/component_manager:__pkg__",
        "//src/sys/pkg/bin/pkg-resolver:__pkg__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.component.resolution:fuchsia.component.resolution_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/rust/zx-status",
        "//src/lib/fuchsia-fs",
        "//src/lib/versioning/version-history/rust",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)
