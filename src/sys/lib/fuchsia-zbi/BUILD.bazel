load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "fuchsia-zbi",
    srcs = ["src/lib.rs"],
    edition = "2024",
    visibility = [
        "//src/firmware/lib/zircon_boot/test/rust/factory_bootfs_util:__pkg__",
        "//src/sys/component_manager:__subpackages__",
    ],
    deps = [
        "//sdk/rust/zx",
        "//src/sys/lib/fuchsia-zbi/abi",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:thiserror",
        "//third_party/rust_crates/vendor:zerocopy",
    ],
)

rustc_test(
    name = "fuchsia-zbi_test",
    crate = ":fuchsia-zbi",
    edition = "2024",
    deps = [
        "//src/lib/fuchsia",
        "//third_party/rust_crates/vendor:anyhow",
    ],
)

fx_unittest_package(
    name = "fuchsia-zbi-tests",
    unit_tests = [":fuchsia-zbi_test"],
)
