import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("fuchsia-zbi") {
  sources = [ "src/lib.rs" ]
  edition = "2024"
  visibility = [
    ":*",
    "//src/firmware/lib/zircon_boot/test/rust/factory_bootfs_util:*",
    "//src/sys/component_manager/*",
  ]
  deps = [
    "//sdk/rust/zx",
    "//src/sys/lib/fuchsia-zbi/abi",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:thiserror",
    "//third_party/rust_crates:zerocopy",
  ]
}
rustc_test("fuchsia-zbi_test") {
  sources = [ "src/lib.rs" ]
  edition = "2024"
  deps = [
           "//sdk/rust/zx",
           "//src/sys/lib/fuchsia-zbi/abi",
           "//third_party/rust_crates:log",
           "//third_party/rust_crates:thiserror",
           "//third_party/rust_crates:zerocopy",
         ] +
         [
           "//src/lib/fuchsia",
           "//third_party/rust_crates:anyhow",
         ]
}
fuchsia_unittest_package("fuchsia-zbi-tests") {
  package_name = "fuchsia-zbi-tests-gn"
  component_name = "fuchsia-zbi-tests"
  deps = [ ":fuchsia-zbi_test" ]
}
