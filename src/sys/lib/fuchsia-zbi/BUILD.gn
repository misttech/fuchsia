import("//build/bazel/bazel_test_suite.gni")

bazel_test_suite("bazel_tests") {
  target_tests = [ "//src/sys/lib/fuchsia-zbi:fuchsia-zbi-tests" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    ":fuchsia-zbi-tests",
  ]
}

