import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("abi") {
  sources = [ "src/lib.rs" ]
  configs += [ ":unused" ]
  crate_name = "fuchsia_zbi_abi"
  edition = "2024"
  proc_macro_deps = [ "//third_party/rust_crates:num-derive" ]
  visibility = [
    ":*",
    "//src/sys/lib/fuchsia-zbi:*",
  ]
  deps = [
    "//sdk/fidl/zbi:zbi_zither.rust",
    "//third_party/rust_crates:num-traits",
    "//third_party/rust_crates:zerocopy",
  ]
}
