import("//build/components.gni")
import("//build/rust/rustc_library.gni")
import("//build/rust/rustc_test.gni")

# Kept in GN because test-lib, abi_test, and fuchsia-zbi-abi-tests are unwired
# in the GN build graph and have pre-existing source compile errors
# (missing //sdk/lib/zbi-format:internal header and removed
# ZBI_TOPOLOGY_ARCHITECTURE_* constants in test/lib.cc, plus non-unsafe extern
# block under Rust 2024 in src/lib.rs) that cannot be fixed without source
# edits.
static_library("test-lib") {
  sources = [
    "test/lib.cc",
    "test/lib.h",
  ]
  deps = [ "//zircon/system/public" ]
}

rustc_test("abi_test") {
  name = "fuchsia_zbi_abi_lib_test"
  edition = "2024"
  sources = [ "src/lib.rs" ]
  deps = [
    ":test-lib",
    "//sdk/fidl/zbi:zbi_zither.rust",
    "//src/lib/fuchsia",
    "//third_party/rust_crates:num-derive",
    "//third_party/rust_crates:num-traits",
    "//third_party/rust_crates:zerocopy",
  ]
  configs += [ ":unused" ]
}

# LINT.IfChange(unused)
config("unused") {
  rustflags = [ "-Aunused-crate-dependencies" ]
}

# LINT.ThenChange(BUILD.bazel:unused)

fuchsia_unittest_package("fuchsia-zbi-abi-tests") {
  deps = [ ":abi_test" ]
}

group("tests") {
  testonly = true
}

