load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "cm_config",
    srcs = ["src/lib.rs"],
    # Some host tools use serde to serialize/deserialize moniker types. This
    # dependency is guarded in code via #[cfg(feature = "serde")] and
    # #[cfg_attr(feature = "serde", ...)] to prevent serde dependencies in
    # non-host builds.
    crate_features = select({
        "//build/bazel/platforms:is_host_os": ["serde"],
        "//conditions:default": [],
    }),
    edition = "2024",
    visibility = [
        "//src/lib/assembly/component_manager_config:__pkg__",
        "//src/lib/assembly/platform_configuration:__pkg__",
        "//src/security:__subpackages__",
        "//src/sys:__subpackages__",
        "//tools/lib/cm_fidl_analyzer:__subpackages__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.component.decl:fuchsia.component.decl_rust",
        "//sdk/fidl/fuchsia.component.internal:fuchsia.component.internal_rust",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/versioning/version-history/rust",
        "//src/sys/lib/cm_fidl_validator",
        "//src/sys/lib/cm_rust",
        "//src/sys/lib/cm_types",
        "//src/sys/lib/moniker",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:camino",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:thiserror",
    ] + select({
        "//build/bazel/platforms:is_host_os": [
            "//third_party/rust_crates/vendor:serde",
        ],
        "//conditions:default": [],
    }),
)

rustc_test(
    name = "cm_config_test",
    crate = ":cm_config",
    crate_features = select({
        "//build/bazel/platforms:is_host_os": ["serde"],
        "//conditions:default": [],
    }),
    edition = "2024",
    deps = [
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//third_party/rust_crates/vendor:assert_matches",
    ],
)

fx_unittest_package(
    name = "cm_config_tests",
    unit_tests = [":cm_config_test"],
)
