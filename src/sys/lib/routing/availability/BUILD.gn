import("//build/bazel/bazel_test_suite.gni")

bazel_test_suite("bazel_tests") {
  target_tests = [
    "//src/sys/lib/routing/availability:fuchsia-routing-availability-tests",
  ]
  host_tests = [ "//src/sys/lib/routing/availability:availability_host_test" ]
}

group("host-routing-availability-tests") {
  testonly = true
  public_deps = [ ":availability_test($host_toolchain)" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    ":fuchsia-routing-availability-tests",
    ":host-routing-availability-tests",
  ]
}

