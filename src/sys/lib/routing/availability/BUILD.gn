rustc_library("availability") {
  sources = [ "src/lib.rs" ]
  edition = "2024"
  visibility = [
    ":*",
    "//src/sys/lib/routing:*",
  ]
  deps = [
    "//sdk/rust/zx-status",
    "//src/sys/component_manager/lib/router_error",
    "//src/sys/lib/cm_types",
    "//src/sys/lib/moniker",
    "//third_party/rust_crates:thiserror",
  ]
}

rustc_test("availability_test") {
  sources = [ "src/lib.rs" ]
  edition = "2024"
  deps = [
           "//sdk/rust/zx-status",
           "//src/sys/component_manager/lib/router_error",
           "//src/sys/lib/cm_types",
           "//src/sys/lib/moniker",
           "//third_party/rust_crates:thiserror",
         ] + [ "//third_party/rust_crates:test-case" ]
}

fuchsia_unittest_package("fuchsia-routing-availability-tests") {
  package_name = "fuchsia-routing-availability-tests-gn"
  component_name = "fuchsia-routing-availability-tests"
  deps = [ ":availability_test" ]
}
