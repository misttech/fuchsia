import("//build/bazel/bazel_test_suite.gni")

group("host-routing-tests") {
  testonly = true
  public_deps = [ ":routing_test($host_toolchain)" ]
}

bazel_test_suite("bazel_tests") {
  target_tests = [ "//src/sys/lib/routing:fuchsia-routing-tests" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    ":fuchsia-routing-tests",
    "availability:tests",
  ]
}

