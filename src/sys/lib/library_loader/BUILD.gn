import("//build/bazel/bazel_test_suite.gni")
import("//build/dist/resource.gni")

# These are some extra files that are included in the test package under
# lib/config_test, for use in the config_test unit test. This is necessary
# because the library loader must be able to load the files using
# OPEN_RIGHT_EXECUTABLE/VMO_FLAG_EXEC, and the easiest way to provide a test
# directory that supports that is a real pkgfs directory.
# TODO(https://fxbug.dev/42061196): Replace this with a pseudo-directory backed by the Rust VFS.
resource("config_test_foo") {
  sources = [ "config_test_files/foo" ]
  outputs = [ "lib/config_test/foo" ]
}

resource("config_test_bar_baz") {
  sources = [ "config_test_files/bar/baz" ]
  outputs = [ "lib/config_test/bar/baz" ]
}

bazel_test_suite("library_loader_tests") {
  target_tests = [ "//src/sys/lib/library_loader:library_loader_tests" ]
}

group("tests") {
  testonly = true
  deps = [ ":library_loader_tests" ]
}

