load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "testing",
    testonly = True,
    srcs = ["src/lib.rs"],
    crate_name = "cm_rust_testing",
    edition = "2024",
    proc_macro_deps = [
        "//third_party/rust_crates/vendor:derivative",
    ],
    visibility = ["//:__subpackages__"],
    deps = [
        "//sdk/fidl/fuchsia.component.decl:fuchsia.component.decl_rust_common",
        "//sdk/fidl/fuchsia.data:fuchsia.data_rust_common",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust_common",
        "//src/sys/lib/cm_rust",
        "//src/sys/lib/cm_types",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:serde_json",
        "//tools/lib/cml",
    ],
)
