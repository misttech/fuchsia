    compiled_manifest = ":fidl-fuchsia-pkg-rewrite-ext-tests-manifest",
    component_name = "fidl-fuchsia-pkg-rewrite-ext-tests",
    visibility = ["//visibility:private"],
    deps = [
        ":fidl_fuchsia_pkg_rewrite_ext_test_packaged_bin",
    ],
)

# @bazel2gn:skip
fx_package(
