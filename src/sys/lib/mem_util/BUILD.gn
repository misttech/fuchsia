import("//build/components.gni")
import("//build/rust/rustc_test.gni")

# Kept in GN because `mem_util_test` depends on `//src/storage/lib/vfs/rust:vfs`
# (`rustc_dylib("vfs_dylib")`), which places two copies of `libvfs-<hash>.so` in
# Bazel `default_runfiles` and causes `fx_packaged_binary` + `fx_package` to
# fail with duplicate `lib/libvfs-*.so`.
rustc_test("mem_util_test") {
  edition = "2024"
  output_name = "mem_util_lib_test"
  sources = [ "src/lib.rs" ]
  deps = [
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//sdk/fidl/fuchsia.mem:fuchsia.mem_rust",
    "//sdk/rust/zx-status",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-fs",
    "//src/storage/lib/vfs/rust:vfs",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:thiserror",
  ]
  configs += [ "//build/config/rust/lints:clippy_warn_all" ]
}

fuchsia_unittest_package("mem_util_tests") {
  deps = [ ":mem_util_test" ]
}

group("tests") {
  testonly = true
  deps = [ ":mem_util_tests" ]
}

