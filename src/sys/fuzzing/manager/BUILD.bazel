load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

rustc_binary(
    name = "bin",
    srcs = [
        "src/diagnostics.rs",
        "src/events.rs",
        "src/fuzzer.rs",
        "src/main.rs",
        "src/manager.rs",
        "src/test_support.rs",
    ],
    crate_name = "fuzz_manager",
    edition = "2024",
    proc_macro_deps = ["//third_party/rust_crates/vendor:async-trait"],
    tags = ["manual"],
    visibility = ["//visibility:private"],
    deps = [
        "//sdk/fidl/fuchsia.diagnostics:fuchsia.diagnostics_rust",
        "//sdk/fidl/fuchsia.test.manager:fuchsia.test.manager_rust",
        "//sdk/rust/zx",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/sys/fuzzing/fidl:fuchsia.fuzzer_rust",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:url",
    ],
)

fx_packaged_binary(
    name = "bin_packaged_bin",
    binary = ":bin",
    binary_name = "fuzz_manager",
)

fx_component_manifest(
    name = "manifest",
    testonly = True,
    component_name = "fuzz-manager",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/fuzz-manager.cml",
)

fx_component(
    name = "manager",
    testonly = True,
    compiled_manifest = ":manifest",
    component_name = "fuzz-manager",
    visibility = [
        "//src/sys/fuzzing:__pkg__",
        "//src/sys/test_runners/fuzz/tests:__pkg__",
    ],
    deps = [":bin_packaged_bin"],
)

rustc_test(
    name = "bin_test",
    crate = ":bin",
    # Needed for bazel2gn output_name to match meta/unittests.cml program.binary.
    crate_name = "fuzz_manager_bin_test",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = ["//sdk/fidl/fuchsia.mem:fuchsia.mem_rust"],
)

fx_packaged_binary(
    name = "bin_test_packaged_bin",
    testonly = True,
    binary = ":bin_test",
    binary_name = "fuzz_manager_bin_test",
)

fx_component_manifest(
    name = "unittests-manifest",
    testonly = True,
    component_name = "unittests",
    includes = [
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/unittests.cml",
)

fx_test_component(
    name = "unittests-component",
    compiled_manifest = ":unittests-manifest",
    component_name = "unittests",
    visibility = ["//visibility:private"],
    deps = [":bin_test_packaged_bin"],
)

fx_package(
    name = "unittests-pkg",
    package_name = "fuzz-manager-unittests",
    test_components = [":unittests-component"],
)

fx_test(
    name = "fuzz-manager-unittests",
    package = ":unittests-pkg",
    visibility = ["//src/sys:__pkg__"],
)
