load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")

package(default_applicable_licenses = ["//:license"])

rustc_binary(
    name = "echo_client_testing",
    srcs = ["src/main.rs"],
    edition = "2024",
    visibility = ["//src/lib/fuchsia-component-test/tests:__pkg__"],
    deps = [
        "//examples/components/routing/fidl:echo_rust",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:log",
    ],
)

fx_packaged_binary(
    name = "echo_client_testing_packaged_bin",
    binary = ":echo_client_testing",
    binary_name = "echo_client_testing",
)

fx_component_manifest(
    name = "echo_client_manifest",
    component_name = "echo_client",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/echo_client.cml",
)

fx_component(
    name = "echo_client",
    compiled_manifest = ":echo_client_manifest",
    component_name = "echo_client",
    visibility = ["//src/lib/fuchsia-component-test/tests:__pkg__"],
    deps = [":echo_client_testing_packaged_bin"],
)
