load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load("//build/bazel/rules/packages:fx_packaged_binary.bzl", "fx_packaged_binary")
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")

package(default_applicable_licenses = ["//:license"])

rustc_binary(
    name = "lifecycle_placeholder",
    srcs = ["src/main.rs"],
    edition = "2024",
    tags = ["manual"],
    deps = [
        "//sdk/fidl/fuchsia.process.lifecycle:fuchsia.process.lifecycle_rust",
        "//sdk/rust/zx",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-runtime",
        "//third_party/rust_crates/vendor:futures-util",
        "//third_party/rust_crates/vendor:log",
    ],
)

fx_packaged_binary(
    name = "lifecycle_placeholder_packaged_bin",
    binary = ":lifecycle_placeholder",
    binary_name = "lifecycle_placeholder",
)

fx_component_manifest(
    name = "lifecycle-manifest",
    testonly = True,
    component_name = "lifecycle",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/lifecycle.cml",
)

fx_component(
    name = "lifecycle",
    testonly = True,
    compiled_manifest = ":lifecycle-manifest",
    component_name = "lifecycle",
    visibility = [
        "//src/sys/component_manager:__pkg__",
        "//src/sys/lib/elf_runner:__subpackages__",
    ],
    deps = [":lifecycle_placeholder_packaged_bin"],
)
