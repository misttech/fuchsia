load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load("//build/bazel/rules/packages:fx_packaged_binary.bzl", "fx_packaged_binary")
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")

package(default_applicable_licenses = ["//:license"])

rustc_binary(
    name = "provider-bin",
    srcs = ["src/main.rs"],
    crate_name = "services_provider_test",
    edition = "2024",
    tags = ["manual"],
    deps = [
        "//examples/components/services/fidl:fuchsia.examples.services_rust",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
    ],
)

fx_packaged_binary(
    name = "provider-bin_packaged_bin",
    binary = ":provider-bin",
    binary_name = "services_provider_test",
)

fx_component_manifest(
    name = "provider-a-cmp-manifest",
    testonly = True,
    component_name = "provider-a",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/provider-a.cml",
)

fx_component(
    name = "provider-a-cmp",
    testonly = True,
    compiled_manifest = ":provider-a-cmp-manifest",
    component_name = "provider-a",
    visibility = ["//src/sys/component_manager/tests/services:__pkg__"],
    deps = [":provider-bin_packaged_bin"],
)

fx_component_manifest(
    name = "provider-b-cmp-manifest",
    testonly = True,
    component_name = "provider-b",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/provider-b.cml",
)

fx_component(
    name = "provider-b-cmp",
    testonly = True,
    compiled_manifest = ":provider-b-cmp-manifest",
    component_name = "provider-b",
    visibility = ["//src/sys/component_manager/tests/services:__pkg__"],
    deps = [":provider-bin_packaged_bin"],
)
