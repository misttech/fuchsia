fuchsia_component_manifest("trigger-manifest") {
  testonly = true
  component_name = "trigger"
  manifest = "meta/trigger.cml"
}
fuchsia_component("trigger") {
  testonly = true
  cm_label = ":trigger-manifest"
  component_name = "trigger"
  deps = [ ":trigger_bin" ]
}
