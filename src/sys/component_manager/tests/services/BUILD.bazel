load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")

package(default_applicable_licenses = ["//:license"])

rustc_binary(
    name = "service-routing-branch-bin",
    srcs = ["src/branch.rs"],
    crate_name = "service_routing_branch_bin",
    crate_root = "src/branch.rs",
    edition = "2024",
    deps = [
        "//sdk/fidl/fuchsia.component.decl:fuchsia.component.decl_rust",
        "//sdk/fidl/fuchsia.component:fuchsia.component_rust",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component",
        "//src/sys/component_manager/tests/fidl:components_rust",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:argh",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
    ],
)

rustc_test(
    name = "service-routing-test-bin",
    srcs = ["src/service_routing_test.rs"],
    crate_root = "src/service_routing_test.rs",
    edition = "2024",
    deps = [
        "//examples/components/services/fidl:fuchsia.examples.services_rust",
        "//sdk/fidl/fuchsia.component.decl:fuchsia.component.decl_rust",
        "//sdk/fidl/fuchsia.component:fuchsia.component_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/fidl/fuchsia.sys2:fuchsia.sys2_rust",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-component-test:fuchsia-component-test-lib",  # @bazel2gn:path_overwrite://src/lib/fuchsia-component-test
        "//src/lib/fuchsia-fs",
        "//src/storage/lib/vfs/rust:vfs",
        "//src/sys/component_manager/tests/fidl:components_rust",
        "//src/sys/component_manager/tests/services/src/fidl:fuchsia.examples_rust",
        "//src/sys/lib/cm_rust",
        "//src/sys/lib/cm_types",
        "//src/sys/lib/component-events",
        "//src/sys/lib/moniker",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:test-case",
    ],
)

rustc_test(
    name = "filtered-service-routing-test-bin",
    srcs = ["src/filtered_service_routing_test.rs"],
    crate_root = "src/filtered_service_routing_test.rs",
    edition = "2024",
    deps = [
        "//sdk/fidl/fuchsia.component.decl:fuchsia.component.decl_rust",
        "//sdk/fidl/fuchsia.component:fuchsia.component_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-fs",
        "//src/sys/component_manager/tests/services/src/fidl:fuchsia.examples_rust",
        "//third_party/rust_crates/vendor:log",
    ],
)

rustc_binary(
    name = "service-routing-client-bin",
    testonly = True,
    srcs = ["src/service_client.rs"],
    crate_name = "service_routing_client_bin",
    crate_root = "src/service_client.rs",
    edition = "2024",
    deps = [
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component",
        "//src/sys/component_manager/tests/services/src/fidl:fuchsia.examples_rust",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
    ],
)

rustc_binary(
    name = "multi_instance_echo_service_bin",
