load("//build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")
load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

fx_cc_binary(
    name = "bin",
    testonly = True,
    srcs = ["test.cc"],
    tags = ["manual"],
    deps = [
        "//sdk/lib/async-default",
        "//sdk/lib/fdio",
        "//zircon/system/ulib/zxtest",
    ],
)

fx_packaged_binary(
    name = "bin_packaged_bin",
    testonly = True,
    binary = ":bin",
    binary_name = "cm_fuchsia_io",
    install_root = "test/",
)

fx_component_manifest(
    name = "test_component-manifest",
    testonly = True,
    component_name = "cm_fuchsia_io",
    includes = [
        "//sdk/lib/sys/testing:elf_test_runner.shard.cml",
        "//sdk/lib/syslog:client.shard",
    ],
    manifest = "meta/test.cml",
)

fx_test_component(
    name = "test_component",
    compiled_manifest = ":test_component-manifest",
    component_name = "cm_fuchsia_io",
    deps = [":bin_packaged_bin"],
)

fx_component_manifest(
    name = "child-manifest",
    testonly = True,
    component_name = "child",
    manifest = "meta/child.cml",
)

fx_component(
    name = "child",
    testonly = True,
    compiled_manifest = ":child-manifest",
    component_name = "child",
)

fx_package(
    name = "tests",
    package_name = "cm_fuchsia_io",
    components = [":child"],
    test_components = [":test_component"],
)

fx_test(
    name = "cm_fuchsia_io",
    package = ":tests",
)
