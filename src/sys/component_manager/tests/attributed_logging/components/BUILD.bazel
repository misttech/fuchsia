fx_component_manifest(
    name = "optional-use-from-void-component-manifest",
    testonly = True,
    component_name = "optional-use-from-void",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/optional-use-from-void.cml",
)

fx_component(
    name = "optional-use-from-void-component",
    testonly = True,
    compiled_manifest = ":optional-use-from-void-component-manifest",
    component_name = "optional-use-from-void",
    deps = [":use-unoffered_packaged_bin"],
)

fx_component_manifest(
    name = "offers-to-children-unavailable-manifest",
    testonly = True,
    component_name = "offers-to-children-unavailable",
    includes = [
        "//sdk/lib/inspect:offer.shard",
