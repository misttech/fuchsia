    includes = [
        "//sdk/lib/inspect:offer.shard",
        "//sdk/lib/syslog:offer.shard",
    ],
    manifest = "meta/offers-to-children-unavailable-but-optional.cml",
)

fx_component(
    name = "offers-to-children-unavailable-but-optional",
    testonly = True,
    compiled_manifest = ":offers-to-children-unavailable-but-optional-manifest",
    component_name = "offers-to-children-unavailable-but-optional",
)

fx_component_manifest(
    name = "routing-tests-manifest",
    testonly = True,
    component_name = "routing-tests",
    includes = [
        "//sdk/lib/inspect:offer.shard",
        "//sdk/lib/syslog:offer.shard",
    ],
    manifest = "meta/routing-tests.cml",
)

fx_component(
    name = "routing-tests",
    testonly = True,
    compiled_manifest = ":routing-tests-manifest",
    component_name = "routing-tests",
)
