import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_binary("bin") {
  testonly = true
  sources = [ "src/main.rs" ]
  output_name = "structured_config_rust_receiver"
  edition = "2024"
  visibility = [
    ":*",
    "//src/sys/component_manager/tests/structured_config/different_values:*",
  ]
  deps = [
    ":config_lib",
    "//src/lib/diagnostics/inspect/runtime/rust",
    "//src/lib/diagnostics/inspect/rust",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-component",
    "//src/sys/component_manager/tests/structured_config/fidl:test.structuredconfig.receiver_rust",
    "//third_party/rust_crates:futures",
  ]
}

fuchsia_structured_config_rust_lib("config_lib") {
  testonly = true
  cm_label = ":manifest"
  name = "receiver_config"
}

fuchsia_component("component") {
  testonly = true
  cm_label = ":manifest"
  deps = [ ":bin" ]
}

rustc_test("rust_sc_client_test_bin") {
  sources = [ "src/test.rs" ]
  source_root = "src/test.rs"
  edition = "2024"
  deps = [
    "//src/lib/fuchsia",
    "//src/sys/component_manager/tests/structured_config/client_integration:sc_client_integration_support",
  ]
}
