load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load(
    "//build/bazel/rules/components:structured_config.bzl",
    "fuchsia_structured_config_rust_lib",
)
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")

package(default_applicable_licenses = ["//:license"])

rustc_binary(
    name = "bin",
    testonly = True,
    srcs = ["src/main.rs"],
    crate_name = "structured_config_rust_receiver",
    edition = "2024",
    visibility = [
        "//src/sys/component_manager/tests/structured_config/different_values:__pkg__",
    ],
    deps = [
        ":config_lib",
        "//src/lib/diagnostics/inspect/runtime/rust",
        "//src/lib/diagnostics/inspect/rust:fuchsia-inspect",  # @bazel2gn:path_overwrite://src/lib/diagnostics/inspect/rust
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component",
        "//src/sys/component_manager/tests/structured_config/fidl:test.structuredconfig.receiver_rust",
        "//third_party/rust_crates/vendor:futures",
    ],
)

fx_packaged_binary(
    name = "bin_packaged_bin",
    testonly = True,
    binary = ":bin",
    binary_name = "structured_config_rust_receiver",
)

# The GN build uses the `fuchsia_component_manifest("manifest")` target defined
# above the bazel2gn sentinel in BUILD.gn instead, because
# `fuchsia_structured_config_values("values")` calls
# `get_target_outputs(":manifest")`.
# @bazel2gn:skip
fx_component_manifest(
    name = "manifest",
    testonly = True,
    component_name = "rust_receiver",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/syslog:client.shard",
        "//src/sys/component_manager/tests/structured_config:all_config_types.shard.cml",
    ],
    manifest = "meta/receiver.cml",
)

fuchsia_structured_config_rust_lib(
    name = "config_lib",
    testonly = True,
    cm_label = ":manifest",
    crate_name = "receiver_config",
)

fx_component(
    name = "component",
    testonly = True,
    compiled_manifest = ":manifest",
    deps = [":bin_packaged_bin"],
)

rustc_test(
    name = "rust_sc_client_test_bin",
    srcs = ["src/test.rs"],
    crate_root = "src/test.rs",
    edition = "2024",
    deps = [
        "//src/lib/fuchsia",
        "//src/sys/component_manager/tests/structured_config/client_integration:sc_client_integration_support",
    ],
)
