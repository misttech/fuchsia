load("//build/bazel/rules/fidl:fidl_library.bzl", "fidl_library")
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")

package(default_applicable_licenses = ["//:license"])

rustc_test(
    name = "security_policy_capability_allowlist_integration_test_bin",
    srcs = ["security_policy_capability_allowlist_integration_test.rs"],
    crate_name = "security_policy_capability_allowlist_integration_test",
    crate_root = "security_policy_capability_allowlist_integration_test.rs",
    edition = "2024",
    deps = [
        ":test.policy_rust",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component",
        "//src/sys/component_manager/tests/security_policy/util:security_policy_test_util",
        "//third_party/rust_crates/vendor:anyhow",
    ],
)

fidl_library(
    name = "test.policy",
    testonly = True,
    srcs = ["policy.test.fidl"],
    # TODO(https://fxbug.dev/381096879): Fix lint warnings and remove.
    excluded_checks = ["string-bounds-not-specified"],
    deps = ["//zircon/vdso/zx"],
)

rustc_binary(
    name = "policy_service_bin",
    testonly = True,
    srcs = ["policy_service.rs"],
    crate_root = "policy_service.rs",
    edition = "2024",
    deps = [
        ":test.policy_rust",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
    ],
)

rustc_binary(
    name = "dir_service_bin",
    testonly = True,
    srcs = ["dir_service.rs"],
    crate_root = "dir_service.rs",
    edition = "2024",
    deps = [
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component",
        "//src/storage/lib/vfs/rust:vfs",
        "//third_party/rust_crates/vendor:futures",
    ],
)

rustc_binary(
    name = "cap_getter_bin",
    testonly = True,
    srcs = ["cap_getter.rs"],
    crate_root = "cap_getter.rs",
    edition = "2024",
    deps = [
        ":test.policy_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//src/lib/fdio/rust:fdio",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
    ],
)
