rustc_binary("bin") {
  testonly = true
  sources = [ "src/main.rs" ]
  output_name = "component_lifecycle_benchmark"
  edition = "2024"
  deps = [
    "//sdk/fidl/fuchsia.component:fuchsia.component_rust",
    "//sdk/fidl/fuchsia.component.decl:fuchsia.component.decl_rust",
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//sdk/fidl/fuchsia.process:fuchsia.process_rust",
    "//sdk/rust/zx",
    "//src/developer/fuchsia-criterion",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component-test",
    "//src/lib/fuchsia-runtime",
    "//src/lib/fuchsia-sync",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:rand",
  ]
}
fuchsia_component_manifest("root_component_manifest") {
  testonly = true
  component_name = "root_component"
  manifest = "meta/root_component.cml"
}
fuchsia_component("root_component") {
  testonly = true
  cm_label = ":root_component_manifest"
}
