load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")

package(default_applicable_licenses = ["//:license"])

rustc_test(
    name = "reboot_on_terminate_test_bin",
    srcs = ["src/integration_test.rs"],
    crate_root = "src/integration_test.rs",
    edition = "2024",
    deps = [
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-component-test:fuchsia-component-test-lib",  # @bazel2gn:path_overwrite://src/lib/fuchsia-component-test
        "//src/sys/component_manager/tests/fidl:components_rust",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
    ],
)

rustc_binary(
    name = "reboot_on_terminate_success_bin",
    testonly = True,
    srcs = ["src/reboot_on_terminate_success.rs"],
    crate_root = "src/reboot_on_terminate_success.rs",
    edition = "2024",
    deps = [
        "//sdk/fidl/fuchsia.process.lifecycle:fuchsia.process.lifecycle_rust",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-runtime",
        "//src/sys/component_manager/tests/fidl:components_rust",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
    ],
)

rustc_binary(
    name = "reboot_on_terminate_policy_bin",
    testonly = True,
    srcs = ["src/reboot_on_terminate_policy.rs"],
    crate_root = "src/reboot_on_terminate_policy.rs",
    edition = "2024",
    deps = [
        "//examples/components/routing/fidl:echo_rust",
        "//sdk/fidl/fuchsia.component.decl:fuchsia.component.decl_rust",
        "//sdk/fidl/fuchsia.component:fuchsia.component_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/rust/zx",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component",
        "//src/sys/component_manager/tests/fidl:components_rust",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
    ],
)

rustc_binary(
    name = "crash_bin",
    testonly = True,
    srcs = ["src/crash.rs"],
    crate_root = "src/crash.rs",
    edition = "2024",
)
