load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")

package(default_applicable_licenses = ["//:license"])

# The test component and package (`:cast_resolver_test_component` and
# `:cast_resolver_test`) stay in BUILD.gn because they use RealmBuilder
# (`//src/lib/fuchsia-component-test/realm_builder_server` is GN-only) and
# embed `//src/sys/component_manager:component-manager-realm-builder-cmp`
# (GN-only).
rustc_test(
    name = "cast_resolver_bin",
    srcs = ["integration_test.rs"],
    crate_name = "cast_resolver",
    crate_root = "integration_test.rs",
    edition = "2024",
    deps = [
        "//sdk/fidl/fuchsia.component.decl:fuchsia.component.decl_rust",
        "//sdk/fidl/fuchsia.component.resolution:fuchsia.component.resolution_rust",
        "//sdk/fidl/fuchsia.mem:fuchsia.mem_rust",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-component-test:fuchsia-component-test-lib",  # @bazel2gn:path_overwrite://src/lib/fuchsia-component-test
        "//src/lib/versioning/version-history/rust/data",
        "//src/sys/lib/cm_rust",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
    ],
)
