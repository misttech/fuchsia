rustc_binary("trigger-bin") {
  testonly = true
  sources = [ "src/main.rs" ]
  output_name = "component_manager_test_trigger_bin"
  edition = "2024"
  visibility = [
    ":*",
    "//src/sys/component_manager/tests/resolvers/custom:*",
  ]
  deps = [
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-component",
    "//src/sys/component_manager/tests/fidl:components_rust",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
  ]
}
fuchsia_component_manifest("trigger-cmp-manifest") {
  testonly = true
  component_name = "trigger"
  manifest = "meta/trigger.cml"
}
fuchsia_component("trigger-cmp") {
  testonly = true
  cm_label = ":trigger-cmp-manifest"
  component_name = "trigger"
  deps = [ ":trigger-bin" ]
}
