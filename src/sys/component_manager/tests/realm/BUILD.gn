    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//src/lib/fuchsia-fs",
  ]
}

rustc_test("realm_namespace_test_bin") {
  sources = [ "src/namespace_test.rs" ]
  source_root = "src/namespace_test.rs"
  edition = "2024"
  deps = [
    "//examples/components/routing/fidl:echo_rust",
    "//sdk/fidl/fuchsia.sys2:fuchsia.sys2_rust",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-component",
  ]
}

fuchsia_component_manifest("no_program-manifest") {
  testonly = true
  component_name = "no_program"
  manifest = "meta/no_program.cml"
}

fuchsia_component("no_program") {
  testonly = true
  cm_label = ":no_program-manifest"
  component_name = "no_program"
}
