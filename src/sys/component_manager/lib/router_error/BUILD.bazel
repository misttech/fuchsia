    name = "router_error",
    srcs = ["src/lib.rs"],
    edition = "2024",
    visibility = [
        "//src/sys/component_manager:__subpackages__",
        "//src/sys/lib/routing:__subpackages__",
        "//src/sys/lib/runtime_capabilities:__subpackages__",
        "//tools/lib/cm_fidl_analyzer:__subpackages__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.component.runtime:fuchsia.component.runtime_rust",
        "//sdk/fidl/fuchsia.component.sandbox:fuchsia.component.sandbox_rust",
        "//sdk/rust/zx-status",
        "//src/sys/lib/moniker",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)
