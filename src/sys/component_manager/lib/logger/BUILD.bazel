load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load("//build/bazel/rules/packages:fx_packaged_binary.bzl", "fx_packaged_binary")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "logger",
    srcs = [
        "src/klog.rs",
        "src/lib.rs",
    ],
    crate_name = "cm_logger",
    edition = "2024",
    visibility = ["//src/sys/component_manager:__pkg__"],
    deps = [
        "//sdk/rust/zx",
        "//src/lib/fdio/rust:fdio",
        "//third_party/rust_crates/vendor:log",
    ],
)

# @bazel2gn:raw_attribute:output_name = "cm_logger_lib_test"
rustc_test(
    name = "logger_test",
    crate = ":logger",
    edition = "2024",
    deps = [
        "//sdk/fidl/fuchsia.boot:fuchsia.boot_rust",
        "//src/lib/fuchsia-component",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:rand",
    ],
)

fx_packaged_binary(
    name = "logger_test_packaged_bin",
    testonly = True,
    binary = ":logger_test",
    binary_name = "cm_logger_lib_test",
)

fx_component_manifest(
    name = "component_manager_logger_test-manifest",
    testonly = True,
    component_name = "component_manager_logger_test",
    includes = [
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/component_manager_logger_test.cml",
)

fx_test_component(
    name = "component_manager_logger_test-component",
    compiled_manifest = ":component_manager_logger_test-manifest",
    component_name = "component_manager_logger_test",
    deps = [":logger_test_packaged_bin"],
)

fx_package(
    name = "component_manager_logger_test-package",
    package_name = "component_manager_logger_test",
    test_components = [":component_manager_logger_test-component"],
)

fx_test(
    name = "component_manager_logger_test",
    package = ":component_manager_logger_test-package",
    test_type = "system",
)
