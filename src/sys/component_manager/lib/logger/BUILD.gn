    "src/klog.rs",
    "src/lib.rs",
  ]
  crate_name = "cm_logger"
  edition = "2024"
  visibility = [
    ":*",
    "//src/sys/component_manager:*",
  ]
  deps = [
    "//sdk/rust/zx",
    "//src/lib/fdio/rust:fdio",
    "//third_party/rust_crates:log",
  ]
}

rustc_test("logger_test") {
  sources = [
    "src/klog.rs",
    "src/lib.rs",
  ]
  edition = "2024"
  deps = [
           "//sdk/rust/zx",
           "//src/lib/fdio/rust:fdio",
           "//third_party/rust_crates:log",
         ] +
         [
           "//sdk/fidl/fuchsia.boot:fuchsia.boot_rust",
           "//src/lib/fuchsia-component",
           "//third_party/rust_crates:anyhow",
           "//third_party/rust_crates:rand",
         ]
  output_name = "cm_logger_lib_test"
}

fuchsia_component_manifest("component_manager_logger_test-manifest") {
  testonly = true
  component_name = "component_manager_logger_test"
  manifest = "meta/component_manager_logger_test.cml"
}

fuchsia_test_component("component_manager_logger_test-component") {
  cm_label = ":component_manager_logger_test-manifest"
  component_name = "component_manager_logger_test"
  deps = [ ":logger_test" ]
  test_type = "system"
}

fuchsia_test_package("component_manager_logger_test-package") {
  package_name = "component_manager_logger_test-gn"
  test_components = [ ":component_manager_logger_test-component" ]
}
