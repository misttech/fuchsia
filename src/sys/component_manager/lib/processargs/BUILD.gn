import("//build/bazel/bazel_test_suite.gni")
import("//build/components.gni")
import("//build/rust/rustc_library.gni")

bazel_test_suite("bazel_tests") {
  target_tests =
      [ "//src/sys/component_manager/lib/processargs:processargs-unittests" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    ":processargs-unittests",
  ]
}

