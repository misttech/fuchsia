    "//sdk/rust/zx",
    "//src/lib/fuchsia-runtime",
    "//src/lib/process_builder",
  ]
}

rustc_test("processargs_test") {
  sources = [ "src/lib.rs" ]
  edition = "2024"
  deps = [
    "//sdk/rust/zx",
    "//src/lib/fuchsia-runtime",
    "//src/lib/process_builder",
  ]
}

fuchsia_unittest_package("processargs-unittests") {
  package_name = "processargs-unittests-gn"
  component_name = "processargs-unittests"
  deps = [ ":processargs_test" ]
}
