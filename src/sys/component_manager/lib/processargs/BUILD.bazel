load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "processargs",
    srcs = ["src/lib.rs"],
    edition = "2024",
    deps = [
        "//sdk/rust/zx",
        "//src/lib/fuchsia-runtime",
        "//src/lib/process_builder",
    ],
)

rustc_test(
    name = "processargs_test",
    crate = ":processargs",
    edition = "2024",
)

# Run with `fx test processargs-unittests`.
fx_unittest_package(
    name = "processargs-unittests",
    unit_tests = [":processargs_test"],
)
