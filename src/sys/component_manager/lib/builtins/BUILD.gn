import("//build/bazel/bazel_test_suite.gni")
import("//build/components.gni")

fuchsia_test_component("test_component") {
  deps = [ ":builtins_test" ]
  component_name = "builtins_tests"
  manifest = "meta/test.cml"
  test_type = "system"
}

fuchsia_test_package("builtins_tests") {
  package_name = "builtins_tests-gn"
  test_components = [ ":test_component" ]
}

bazel_test_suite("bazel_tests") {
  target_tests = [ "//src/sys/component_manager/lib/builtins:builtins_tests" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    ":builtins_tests",
  ]
}

