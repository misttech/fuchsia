# This is a low-level action that compiles `elf_runner.cml`
# without also adding the compiled `.cm` as a `resource`, which would
# otherwise get funneled into bootfs.
fx_compiled_manifest(
    name = "elf_runner_cm",
    component_name = "elf_runner",
    manifest = "meta/elf_runner.cml",
)

fx_compiled_manifest(
    name = "dispatcher_cm",
    component_name = "dispatcher",
    manifest = "meta/dispatcher.cml",
    restricted_features = ["dynamic_dictionaries"],
    visibility = ["//tools/cmc/build/restricted_features:__pkg__"],
)

fuchsia_structured_config_rust_lib(
    name = "dispatcher_config",
    cm_label = ":dispatcher_cm",
)

rustc_binary(
    name = "bin",
    srcs = _COMPONENT_MANAGER_SRCS,
    build_flags = [
        "//build/config/rust:bootfs",
        ":optimize-for-size",
    ],
    compile_data = [
        ":dispatcher_cm",  # @bazel2gn:path_overwrite:${dispatcher_cm}
        ":elf_runner_cm",  # @bazel2gn:path_overwrite:${elf_runner_cm}
    ],
    crate_name = "component_manager",
    data = [
        ":dispatcher_cm",  # @bazel2gn:path_overwrite::dispatcher_cm($default_toolchain)
        ":elf_runner_cm",  # @bazel2gn:path_overwrite::elf_runner_cm($default_toolchain)
    ],
    edition = "2024",
    # As this is a large binary that uses many resources to compile (and takes
    # minutes when LTO is enabled, shift it to the large RBE worker pool)
    exec_properties = RBE_USE_LARGE_WORKER,
    proc_macro_deps = _COMPONENT_MANAGER_PROC_MACRO_DEPS,
    rustc_env = {
        "DISPATCHER_CM_PATH": "$(location :dispatcher_cm)",  # @bazel2gn:value_overwrite:${dispatcher_cm_path}
        "ELF_RUNNER_CM_PATH": "$(location :elf_runner_cm)",  # @bazel2gn:value_overwrite:${elf_runner_cm_path}
    },
    tags = [
        # For tracing support, :bin_with_tracing is required
        "assert_no_deps=//src/lib/trace/rust:trace-provider",
        # regex crate is large
        "assert_no_deps=//third_party/rust_crates/vendor:regex",
        # component_manager should not depend on json5
        "assert_no_deps=//third_party/rust_crates/vendor:serde_json5",  # @bazel2gn:path_overwrite://third_party/rust_crates:serde_json5($current_toolchain)
        "exclude_toolchain_tags=heapdump",
    ],
    deps = _COMPONENT_MANAGER_DEPS,
)

