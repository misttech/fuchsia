        "//src/sys/lib/fuchsia-bootfs:testdata_bootfs",
    ],
    edition = "2024",
    exec_properties = RBE_USE_LARGE_WORKER,
    proc_macro_deps = [
        "//third_party/rust_crates/vendor:paste",
    ],
    tags = [
        "exclude_toolchain_tags=heapdump",
    ],
    deps = _COMPONENT_MANAGER_TEST_DEPS + [
        "//src/lib/test_util",
        "//src/sys/pkg/lib/fuchsia-pkg-testing",
