# "opt-level=z" saves 400 KiB compared to "s" on component framework binary
# On arm64 release build, component_manager size goes from 4216440 to 3884664
# bytes.
# LINT.IfChange(optimize-for-size)
# @bazel2gn:skip
build_flags(
    name = "optimize-for-size",
    rustflags = [
        "-Copt-level=z",
        "-Cpanic=abort",
    ],
)
