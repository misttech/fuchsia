cm("elf_runner_cm") {
  manifest = "meta/elf_runner.cml"
  output_name = "cml/elf_runner_cm/elf_runner.cm"
  config_values_package_path = "meta/elf_runner.cvf"
}

cm("dispatcher_cm") {
  manifest = "meta/dispatcher.cml"
  output_name = "cml/dispatcher_cm/dispatcher.cm"
  config_values_package_path = "meta/dispatcher.cvf"
  restricted_features = [ "dynamic_dictionaries" ]
  visibility = [
    ":*",
    "//tools/cmc/build/restricted_features:*",
  ]
}

fuchsia_structured_config_rust_lib("dispatcher_config") {
  cm_label = ":dispatcher_cm"
}

rustc_binary("bin") {
  sources = _COMPONENT_MANAGER_SRCS
  configs += [
    "//build/config/rust:bootfs",
    ":optimize-for-size",
  ]
  inputs = [
    "${dispatcher_cm}",
    "${elf_runner_cm}",
  ]
  output_name = "component_manager"
  non_rust_deps = [
    ":dispatcher_cm($default_toolchain)",
    ":elf_runner_cm($default_toolchain)",
  ]
  edition = "2024"
  _concurrent_jobs = concurrent_jobs.rust_highmem
  configs += _concurrent_jobs.configs
  forward_variables_from(_concurrent_jobs.vars, "*")
  proc_macro_deps = _COMPONENT_MANAGER_PROC_MACRO_DEPS
  rustenv = [
    "DISPATCHER_CM_PATH=${dispatcher_cm_path}",
    "ELF_RUNNER_CM_PATH=${elf_runner_cm_path}",
  ]
  assert_no_deps = [
    "//src/lib/trace/rust:trace-provider",
    "//third_party/rust_crates:regex",
    "//third_party/rust_crates:serde_json5($current_toolchain)",
  ]
  exclude_toolchain_tags = [ "heapdump" ]
  deps = _COMPONENT_MANAGER_DEPS
}

rustc_test("bin_test") {
  sources = _COMPONENT_MANAGER_SRCS
  inputs = [
    "${dispatcher_cm}",
    "${elf_runner_cm}",
  ]
  edition = "2024"
  proc_macro_deps =
      _COMPONENT_MANAGER_PROC_MACRO_DEPS + [ "//third_party/rust_crates:paste" ]
  rustenv = [
    "DISPATCHER_CM_PATH=${dispatcher_cm_path}",
    "ELF_RUNNER_CM_PATH=${elf_runner_cm_path}",
  ]
  deps = _COMPONENT_MANAGER_DEPS + _COMPONENT_MANAGER_TEST_DEPS + [
           "//src/lib/test_util",
           "//src/sys/pkg/lib/fuchsia-pkg-testing",
           "//third_party/rust_crates:pretty_assertions",
           "//third_party/rust_crates:proptest",
         ]
  source_root = "src/main.rs"
  configs += [
    "//build/config/rust:bootfs",
    ":optimize-for-size",
  ]
  non_rust_deps = [
    ":dispatcher_cm($default_toolchain)",
    ":elf_runner_cm($default_toolchain)",
    "//src/sys/lib/fuchsia-bootfs:testdata_bootfs",
  ]
  _concurrent_jobs = concurrent_jobs.rust_highmem
  configs += _concurrent_jobs.configs
  forward_variables_from(_concurrent_jobs.vars, "*")
  exclude_toolchain_tags = [ "heapdump" ]
  output_name = "component_manager_bin_test"
}

