import("//build/bazel/bazel_test_suite.gni")
import("//build/icu/third_party_icu_headers.gni")

group("intl") {
  testonly = true
  public_deps = [
    "example",
    "intl_services",
    "strings_to_fidl",
    "strings_to_json",
    "time_zone_info_service",
    "tzdata_provider",
  ]
}

bazel_test_suite("bazel_tests") {
  host_tests = [ "//src/intl:host_tests" ]
}

group("tests") {
  testonly = true
  public_deps = [
    ":bazel_tests",
    "intl_services:tests",
    "time_zone_info_service:tests",
    "tzdata_provider:tests",
  ]
}

# For targets that use icu flavoring, e.g. icu_fuchsia_component, use
#
# icu_deps = [ "//src/lib/icu:icudtl" ]
#
# directly instead of:
#
# deps = [ "//src/intl:icudtl" ]
group("icudtl") {
  public_deps = [ "//src/lib/icu:icudtl" ]
}

group("icudtl_root") {
  public_deps = [ "//src/lib/icu:icudtl_root" ]
}
