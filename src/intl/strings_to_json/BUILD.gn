import("//build/bazel/bazel_host_tool.gni")

if (is_host) {
  bazel_host_tool("strings_to_json_bin") {
    bazel_target = ":strings_to_json_bin"
    bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/strings_to_json_bin"
    output_name = "strings_to_json"
    install_host_tool = true
  }
}

group("strings_to_json") {
  public_deps = [ ":strings_to_json_bin($host_toolchain)" ]
}
