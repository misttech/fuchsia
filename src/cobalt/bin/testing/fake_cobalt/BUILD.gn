import("//build/components.gni")
import("//build/rust/rustc_test.gni")

# Kept in GN because `bin` transitively depends on
# `//src/storage/lib/vfs/rust:vfs` (`rustc_dylib("vfs_dylib")`), which places
# duplicate `lib/libvfs-*.so` entries in Bazel `default_runfiles` and causes
# `fx_packaged_binary` + `fx_package` to fail.
rustc_test("bin_test") {
  edition = "2024"
  output_name = "fake_cobalt_bin_test"
  source_root = "src/main.rs"
  sources = [ "src/main.rs" ]
  deps = [
    "//sdk/fidl/fuchsia.metrics:fuchsia.metrics_rust",
    "//sdk/fidl/fuchsia.metrics.test:fuchsia.metrics.test_rust",
    "//src/lib/async-utils",
    "//src/lib/cobalt/rust/builders",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
  ]
}

fuchsia_component("component_v2") {
  component_name = "fake_cobalt"
  testonly = true
  manifest = "meta/fake_cobalt.cml"
  deps = [ ":bin" ]
}

fuchsia_package("fake_cobalt") {
  testonly = true
  deps = [ ":component_v2" ]
}

fuchsia_unittest_package("fake-cobalt-tests") {
  deps = [ ":bin_test" ]
}

group("tests") {
  testonly = true
  deps = [ ":fake-cobalt-tests" ]
}

