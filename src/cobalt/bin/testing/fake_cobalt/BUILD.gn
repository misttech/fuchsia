import("//build/bazel/bazel_test_suite.gni")
import("//build/components.gni")

fuchsia_package("fake_cobalt") {
  testonly = true
  deps = [ ":component_v2" ]
}

bazel_test_suite("bazel_tests") {
  target_tests = [ "//src/cobalt/bin/testing/fake_cobalt:fake-cobalt-tests" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    ":fake-cobalt-tests",
  ]
}

