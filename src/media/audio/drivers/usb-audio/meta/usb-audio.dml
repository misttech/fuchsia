{
    name: "usb-audio",
    include: [ "driver_component/driver.shard.cml" ],
    program: {
        colocate: "true",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        allowed_scheduler_roles: [ "fuchsia.devices.usb.audio" ],
        bind: {
            one_of: [
                {
                    protocol: "fuchsia.usb.BIND_PROTOCOL.INTERFACE",
                    usb: {
                        class: "fuchsia.usb.BIND_USB_CLASS.AUDIO",
                        subclass: "fuchsia.usb.audio.BIND_USB_SUBCLASS.AUDIO_CONTROL",
                        protocol: 0,
                    },
                },
                {
                    protocol: "fuchsia.usb.BIND_PROTOCOL.INTERFACE_ASSOCIATION",
                    usb: {
                        class: "fuchsia.usb.BIND_USB_CLASS.AUDIO",
                        subclass: [
                            "fuchsia.usb.audio.BIND_USB_SUBCLASS.AUDIO_CONTROL",
                            "fuchsia.usb.audio.BIND_USB_SUBCLASS.AUDIO_STREAMING",
                        ],
                        protocol: 0,
                    },
                },
            ],
        },
    },
    use: [
        { protocol: "fuchsia.scheduler.RoleManager" },
        {
            name: "default",
            service: "fuchsia.driver.compat.Service",
            generate_bind_rule: false,
        },
        {
            name: "default",
            service: "fuchsia.hardware.usb.UsbService",
            generate_bind_rule: false,
        },
        {
            name: "default",
            service: "fuchsia.hardware.usb.endpoint.Endpoint",
            generate_bind_rule: false,
        },
    ],
}
