composite tas58xx;

using fuchsia;
using fuchsia.hardware.pin;
using fuchsia.gpio;
using fuchsia.hardware.gpio;
using fuchsia.hardware.i2c;
using fuchsia.ti.platform;
using fuchsia.platform;

primary parent "i2c" {
  fuchsia.Service == "fuchsia.hardware.i2c.Service";
  fuchsia.BIND_PLATFORM_DEV_VID == fuchsia.ti.platform.BIND_PLATFORM_DEV_VID.TI;
  fuchsia.BIND_PLATFORM_DEV_DID == fuchsia.ti.platform.BIND_PLATFORM_DEV_DID.TAS58xx;
}

parent "gpio-fault" {
  fuchsia.Service == "fuchsia.hardware.gpio.Service";
  fuchsia.NAME == "gpio-fault";
}

optional parent "gpio-init" {
  fuchsia.BIND_INIT_STEP == fuchsia.gpio.BIND_INIT_STEP.GPIO;
}

parent "pdev" {
  fuchsia.BIND_PROTOCOL == fuchsia.platform.BIND_PROTOCOL.DEVICE;
  fuchsia.BIND_PLATFORM_DEV_VID == fuchsia.ti.platform.BIND_PLATFORM_DEV_VID.TI;
  fuchsia.BIND_PLATFORM_DEV_DID == fuchsia.ti.platform.BIND_PLATFORM_DEV_DID.TAS58xx;
}

optional parent "pin-states-0" {
  fuchsia.Service == "fuchsia.hardware.pin.PinStatesService";
}
