load("//build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")
load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")
load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

fx_cc_library(
    name = "wav",
    srcs = [
        "wav_internal.h",
        "wav_reader.cc",
        "wav_writer.cc",
    ],
    hdrs = [
        "wav_reader.h",
        "wav_writer.h",
    ],
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = [
        "//src/media/audio:__subpackages__",
        "//src/media/codec/examples/use_media_decoder:__pkg__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.media:fuchsia.media_hlcpp",
        "//sdk/lib/fdio",
        "//sdk/lib/syslog/cpp",
        "//src/lib/fxl",
        "//zircon/system/ulib/fbl",
    ],
    alwayslink = True,
)

# The test needs a custom manifest (tmp storage), which bazel2gn can't
# translate, so its GN copy is defined by hand in BUILD.gn.
# @bazel2gn:skip
fx_cc_binary(
    name = "unittest_bin",
    testonly = True,
    srcs = ["wav_unittest.cc"],
    tags = ["manual"],
    deps = [
        ":wav",
        "//src/lib/fxl/test:gtest_main",
    ],
)

# @bazel2gn:skip
fx_packaged_binary(
    name = "unittest_bin_packaged",
    testonly = True,
    binary = ":unittest_bin",
    binary_name = "audio_lib_wav_unittests",
    install_root = "test/",
)

# @bazel2gn:skip
fx_component_manifest(
    name = "audio_lib_wav_unittests_manifest",
    testonly = True,
    component_name = "audio_lib_wav_unittests",
    includes = [
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners:tmp_storage.shard.cml",
        "//src/sys/test_runners/gtest:default.shard.cml",
    ],
    manifest = "meta/audio_lib_wav_unittests.cml",
)

# @bazel2gn:skip
fx_test_component(
    name = "audio_lib_wav_unittests_component",
    compiled_manifest = ":audio_lib_wav_unittests_manifest",
    component_name = "audio_lib_wav_unittests",
    deps = [":unittest_bin_packaged"],
)

# @bazel2gn:skip
fx_package(
    name = "audio_lib_wav_unittests_package",
    package_name = "audio_lib_wav_unittests",
    test_components = [":audio_lib_wav_unittests_component"],
)

# @bazel2gn:skip
fx_test(
    name = "audio_lib_wav_unittests",
    package = ":audio_lib_wav_unittests_package",
    visibility = ["//src/media:__pkg__"],
)
