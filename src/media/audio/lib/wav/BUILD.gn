import("//build/components.gni")
import("//build/test.gni")

# GN copy of the Bazel test; bazel2gn can't translate its custom manifest.
test("unittest_bin") {
  visibility = [ ":*" ]
  testonly = true
  output_name = "audio_lib_wav_unittests"
  sources = [ "wav_unittest.cc" ]
  deps = [
    ":wav",
    "//src/lib/fxl/test:gtest_main",
  ]
}

fuchsia_unittest_package("audio_lib_wav_unittests") {
  package_name = "audio_lib_wav_unittests-gn"
  component_name = "audio_lib_wav_unittests"
  manifest = "meta/audio_lib_wav_unittests.cml"
  deps = [ ":unittest_bin" ]
}

group("tests") {
  testonly = true
  deps = [ ":audio_lib_wav_unittests" ]
}

