# Media device tests defined in Bazel. These are exported to `fx test` and
# infra builders through the `bazel_tests` target in //src/media/BUILD.gn.
test_suite(
    name = "target_tests",
    target_compatible_with = ["@platforms//os:fuchsia"],
    tests = [
        "//src/media/codec/codecs/test:timestamp_extrapolator_tests",
        "//src/media/lib/blocking_mpsc_queue:blocking_mpsc_queue_unittests",
        "//src/media/lib/extend_bits/unit_tests:extend-bits-tests",
        "//src/media/stream_processors/test:stream_processor_lib_test",
    ],
)
