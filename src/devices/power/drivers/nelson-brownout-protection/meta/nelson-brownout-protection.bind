composite brownout_protection;

using fuchsia;
using fuchsia.amlogic.platform.s905d3;
using fuchsia.gpio;

primary parent "codec" {
  fuchsia.Service == "fuchsia.hardware.audio.CodecService";
}

parent "power-sensor" {
  fuchsia.Service == "fuchsia.hardware.power.sensor.Service";
  fuchsia.BIND_POWER_SENSOR_DOMAIN == fuchsia.amlogic.platform.s905d3.BIND_POWER_SENSOR_DOMAIN.AUDIO;
}

parent "alert-gpio" {
  fuchsia.Service == "fuchsia.hardware.gpio.Service";
  fuchsia.NAME == "alert-gpio";
}

optional parent "gpio-init" {
  fuchsia.BIND_INIT_STEP == fuchsia.gpio.BIND_INIT_STEP.GPIO;
}

optional parent "pin-states-0" {
  fuchsia.Service == "fuchsia.hardware.pin.PinStatesService";
}
