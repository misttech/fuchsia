import("//build/assembly/bootfs_files_for_assembly.gni")
import("//build/bazel/export_fuchsia_package_to_bazel.gni")
import("//build/components.gni")
import("//build/rust/rustc_binary.gni")

rustc_binary("bin") {
  output_name = "odpm_util"
  edition = "2024"
  with_unit_tests = true
  sources = [ "src/main.rs" ]
  deps = [
    "//sdk/fidl/fuchsia.hardware.google.odpm:fuchsia.hardware.google.odpm_rust",
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//sdk/rust/zx",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-component",
    "//src/lib/fuchsia-fs",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:argh",
  ]
  test_deps = [
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia-async",
    "//third_party/rust_crates:futures",
  ]
}

fuchsia_package("odpm_util") {
  package_name = "odpm_util"
  deps = [ ":bin" ]
}

export_fuchsia_package_to_bazel("odpm_util_export") {
  package = ":odpm_util"
}

bootfs_files_for_assembly("bootfs") {
  deps = [ ":bin" ]
}

fuchsia_unittest_package("odpm_util_unit_test") {
  deps = [ ":bin_test" ]
}

group("tests") {
  testonly = true
  deps = [ ":odpm_util_unit_test" ]
}
