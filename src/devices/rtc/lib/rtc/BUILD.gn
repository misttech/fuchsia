import("//build/components.gni")
import("//build/rust/rustc_library.gni")
import("//build/zircon/zx_library.gni")

group("tests") {
  testonly = true
  deps = [
    ":fuchsia-rtc-test",
    "tests",
  ]
}

zx_library("rtc") {
  sdk = "source"
  sdk_headers = [ "librtc.h" ]
  sources = [ "librtc.c" ]
  public_deps = [ "//zircon/system/public" ]
}

zx_library("rtc_llcpp") {
  sdk = "source"
  sdk_headers = [ "librtc_llcpp.h" ]
  sources = [ "librtc_llcpp.cc" ]
  deps = [ "//sdk/fidl/fuchsia.hardware.rtc:fuchsia.hardware.rtc_cpp" ]
}

rustc_library("fuchsia_rtc") {
  name = "fuchsia_rtc"
  edition = "2024"
  sources = [ "src/lib.rs" ]
  with_unit_tests = true
  deps = [
    "//sdk/fidl/fuchsia.hardware.rtc:fuchsia.hardware.rtc_rust_next",
    "//third_party/rust_crates:log",
  ]
}

fuchsia_unittest_package("fuchsia-rtc-test") {
  deps = [ ":fuchsia_rtc_test" ]
}
