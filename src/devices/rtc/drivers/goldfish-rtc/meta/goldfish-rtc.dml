{
    name: "goldfish-rtc",
    include: [ "driver/platform-device.shard.cml" ],
    program: {
        bind: {
            vid: "fuchsia.google.platform.BIND_PLATFORM_DEV_VID.GOOGLE",
            pid: "fuchsia.google.platform.BIND_PLATFORM_DEV_PID.GOLDFISH",
            did: "fuchsia.google.platform.BIND_PLATFORM_DEV_DID.GOLDFISH_RTC",
        },
    },
    capabilities: [
        { service: "fuchsia.hardware.rtc.Service" },
    ],
    expose: [
        {
            service: "fuchsia.hardware.rtc.Service",
            from: "self",
        },
    ],
}
