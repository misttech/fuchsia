load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "driver_manager_types",
    srcs = [
        "src/bind_result.rs",
        "src/bind_result_tracker.rs",
        "src/lib.rs",
        "src/node_types.rs",
    ],
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    visibility = ["//src/devices/bin/driver_manager_rust:__subpackages__"],
    deps = [
        "//sdk/fidl/fuchsia.component.decl:fuchsia.component.decl_rust",
        "//sdk/fidl/fuchsia.component.runner:fuchsia.component.runner_rust",
        "//sdk/fidl/fuchsia.component.sandbox:fuchsia.component.sandbox_rust",
        "//sdk/fidl/fuchsia.driver.development:fuchsia.driver.development_rust",
        "//sdk/fidl/fuchsia.driver.framework:fuchsia.driver.framework_rust",
        "//sdk/rust/zx",
        "//src/lib/fidl/rust/fidl",
        "//third_party/rust_crates/vendor:futures",
    ],
)

rustc_test(
    name = "driver_manager_types_test",
    crate = ":driver_manager_types",
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
)

fx_unittest_package(
    name = "driver-manager-types-unittests",
    unit_tests = [":driver_manager_types_test"],
    visibility = ["//src/devices/bin/driver_manager_rust:__pkg__"],
)
