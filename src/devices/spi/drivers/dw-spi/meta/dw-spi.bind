composite dw_spi;
using fuchsia;
using fuchsia.hardware.reset;
using fuchsia.gpio;

primary parent "pdev" {
  fuchsia.COMPATIBLE == "google,spi";
}

parent "bus" {
  fuchsia.Service == "fuchsia.hardware.clock.Service";
  fuchsia.NAME == "bus";
}

parent "registers" {
  fuchsia.Service == "fuchsia.hardware.clock.Service";
  fuchsia.NAME == "registers";
}

parent "reset" {
  fuchsia.hardware.reset.Service == fuchsia.hardware.reset.Service.ZirconTransport;
  fuchsia.NAME == "reset";
}

parent "power-domain" {
  fuchsia.Service == "fuchsia.hardware.powerdomain.Service";
}

optional parent "cs-0" {
  fuchsia.Service == "fuchsia.hardware.gpio.Service";
  fuchsia.NAME == "cs-0";
}

optional parent "gpio-init-0" {
  fuchsia.BIND_INIT_STEP == fuchsia.gpio.BIND_INIT_STEP.GPIO;
  fuchsia.BIND_GPIO_CONTROLLER == 0;
}

optional parent "gpio-init-1" {
  fuchsia.BIND_INIT_STEP == fuchsia.gpio.BIND_INIT_STEP.GPIO;
  fuchsia.BIND_GPIO_CONTROLLER == 1;
}

optional parent "pin-states-0" {
  fuchsia.Service == "fuchsia.hardware.pin.PinStatesService";
}
optional parent "pin-states-1" {
  fuchsia.Service == "fuchsia.hardware.pin.PinStatesService";
}
