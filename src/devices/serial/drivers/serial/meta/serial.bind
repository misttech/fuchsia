using fuchsia;
using fuchsia.serial;

fuchsia.Service == "fuchsia.hardware.serialimpl.Service";
// Don't bind to our own node.
fuchsia.BIND_PROTOCOL != fuchsia.serial.BIND_PROTOCOL.DEVICE;
