{
  name: "aml-uart",
  include: [
  ],
  program: {
    default_dispatcher_opts: [
      "allow_sync_calls"
    ]
  },
  capabilities: [
    { service: "fuchsia.hardware.serialimpl.Service" },
    { service: "fuchsia.boot.metadata.MacAddressMetadata" }
  ],
  use: [
    {
      config: "fuchsia.power.SuspendEnabled",
      key: "enable_suspend",
      type: "bool"
    },
    { protocol: "fuchsia.power.broker.Topology" },
    { protocol: "fuchsia.power.system.ActivityGovernor" },
    { service: "fuchsia.boot.metadata.MacAddressMetadata" },
    {
      service: "fuchsia.hardware.platform.device.Service",
      name: "pdev",
      primary: true,
      bind: {
        one_of: [
          {
            compat: "amlogic,bt-uart"
          },
          {
            protocol: "fuchsia.platform.BIND_PROTOCOL.DEVICE",
            vid: "fuchsia.amlogic.platform.BIND_PLATFORM_DEV_VID.AMLOGIC",
            pid: "fuchsia.platform.BIND_PLATFORM_DEV_PID.GENERIC",
            did: "fuchsia.amlogic.platform.BIND_PLATFORM_DEV_DID.UART"
          }
        ]
      }
    },
    {
      service: "fuchsia.pwm.Init",
      name: "pwm"
    },
    {
      service: "fuchsia.gpio.Init",
      name: "gpio-init",
      availability: "optional"
    },
    {
      service: "fuchsia.hardware.pin.PinStatesService",
      name: "pin-states-0",
      availability: "optional"
    }
  ],
  expose: [
    {
      service: "fuchsia.hardware.serialimpl.Service",
      from: "self"
    },
    {
      service: "fuchsia.boot.metadata.MacAddressMetadata",
      from: "self"
    }
  ]
}
