{
  children: [
    {
      name: "usb-phy-ffe09000",
      url: "fuchsia-pkg://fuchsia.com/aml-usb-phy#meta/aml-usb-phy.cm",
      compatible: "amlogic,g12b-usb-phy"
    },
    {
      name: "fusb302-22",
      url: "fuchsia-pkg://fuchsia.com/fusb302#meta/fusb302.cm"
    },
    {
      name: "usb-ff400000",
      url: "fuchsia-pkg://fuchsia.com/dwc2#meta/dwc2.cm",
      compatible: "snps,dwc2"
    },
    {
      name: "usb-ff500000",
      url: "fuchsia-pkg://fuchsia.com/xhci#meta/xhci.cm",
      compatible: "generic-xhci"
    }
  ],
  offers: [
    {
      from: "parent",
      service: "fuchsia.hardware.platform.device.Service",
      name: "pdev",
      to: "#usb-phy-ffe09000",
      constraints: {
        mmio: [
          {
            name: "usb-ctrl",
            address: 0xffe09000,
            size: 0x2000
          },
          {
            name: "usb2-phy",
            address: 0xff636000,
            size: 0x2000
          },
          {
            name: "usb2-otg-phy",
            address: 0xff63a000,
            size: 0x2000
          },
          {
            name: "usb3-phy",
            address: 0xff646000,
            size: 0x2000
          }
        ],
        interrupts: [
          {
            name: "primary",
            number: 48,
            mode: "EdgeHigh"
          }
        ],
        btis: [
          {
            name: "usb-phy-ffe09000",
            id: 5
          }
        ]
      }
    },
    {
      service: "fuchsia.hardware.registers.Service",
      name: "aml-usb-phy",
      from: "#register-controller-1000",
      to: "#usb-phy-ffe09000",
      constraints: {
        mmio_id: 0,
        masks: [
          {
            offset: 0x08,
            size: 0x4,
            mask: 0x10004
          },
          {
            offset: 0x84,
            size: 0x4,
            mask: 0x30000
          }
        ]
      }
    },
    {
      service: "fuchsia.hardware.i2c.Service",
      name: "fusb302-22",
      from: "#i2c-5000",
      to: "#fusb302-22",
      constraints: {
        address: 0x22
      }
    },
    {
      service: "fuchsia.hardware.gpio.Service",
      name: "gpio-usb-pd",
      from: "#gpio-controller-ff634400",
      to: "#fusb302-22",
      constraints: {
        pin: 93,
        name: "gpio-int",
        pull: "Up",
        buffer_mode: "Input"
      }
    },
    {
      from: "parent",
      service: "fuchsia.hardware.platform.device.Service",
      name: "pdev",
      to: "#usb-ff400000",
      constraints: {
        mmio: [
          {
            name: "usb-ff400000",
            address: 0xff400000,
            size: 0x100000
          }
        ],
        interrupts: [
          {
            name: "primary",
            number: 63,
            mode: "EdgeHigh",
            wake_vector: true
          }
        ],
        btis: [
          {
            id: 4
          }
        ],
        boot_metadata: [
          {
            zbi_type: 0x43414d6d,
            zbi_extra: 0
          },
          {
            zbi_type: 0x4e4c5253,
            zbi_extra: 0
          }
        ]
      }
    },
    {
      service: "fuchsia.hardware.usb.phy.Service",
      name: "dwc2-phy",
      from: "#usb-phy-ffe09000",
      to: "#usb-ff400000",
      constraints: {
        did: 5
      }
    },
    {
      from: "parent",
      service: "fuchsia.hardware.platform.device.Service",
      name: "pdev",
      to: "#usb-ff500000",
      constraints: {
        mmio: [
          {
            name: "usb-ff500000",
            address: 0xff500000,
            size: 0x100000
          }
        ],
        interrupts: [
          {
            name: "primary",
            number: 62,
            mode: "EdgeHigh",
            wake_vector: true
          }
        ],
        btis: [
          {
            id: 6
          }
        ]
      }
    },
    {
      service: "fuchsia.hardware.usb.phy.Service",
      name: "xhci-phy",
      from: "#usb-phy-ffe09000",
      to: "#usb-ff500000",
      constraints: {
        did: 31
      }
    },
    {
      service: "fuchsia.hardware.pin.PinStatesService",
      name: "pin-states-0",
      from: "#gpio-controller-ff634400",
      to: "#usb-phy-ffe09000",
      constraints: {
        states: [
          {
            name: "default",
            pins: [
              { pin: 22, call: { buffer_mode: "OutputHigh" } }
            ]
          }
        ]
      }
    }
  ]
}
