{
  children: [
    {
      name: "mmc-ffe03000",
      url: "fuchsia-pkg://fuchsia.com/aml-sdmmc#meta/aml-sdmmc.cm",
      compatible: "amlogic,meson-axg-mmc"
    },
    {
      name: "mmc-ffe05000",
      url: "fuchsia-pkg://fuchsia.com/aml-sdmmc#meta/aml-sdmmc.cm",
      compatible: "amlogic,meson-axg-mmc"
    },
    {
      name: "mmc-ffe07000",
      url: "fuchsia-pkg://fuchsia.com/aml-sdmmc#meta/aml-sdmmc.cm",
      compatible: "amlogic,meson-axg-mmc"
    }
  ],
  offers: [
    {
      from: "#pwm-init",
      service: "fuchsia.pwm.Init",
      name: "pwm-ffd1b000",
      to: "#mmc-ffe03000"
    },
    {
      service: "fuchsia.hardware.gpio.Service",
      name: "gpio-sdio-reset",
      from: "#gpio-controller-ff634400",
      to: "#mmc-ffe03000",
      constraints: {
        pin: 62,
        name: "gpio-reset"
      }
    },
    {
      from: "parent",
      service: "fuchsia.hardware.platform.device.Service",
      name: "pdev",
      to: "#mmc-ffe03000",
      constraints: {
        mmio: [
          {
            name: "sdio",
            address: 0xffe03000,
            size: 0x2000
          }
        ],
        interrupts: [
          {
            name: "sdio",
            number: 221,
            mode: "EdgeHigh"
          }
        ],
        btis: [
          {
            id: 7
          }
        ]
      }
    },
    {
      from: "parent",
      service: "fuchsia.hardware.platform.device.Service",
      name: "pdev",
      to: "#mmc-ffe05000",
      constraints: {
        mmio: [
          {
            name: "sdcard",
            address: 0xffe05000,
            size: 0x2000
          }
        ],
        interrupts: [
          {
            name: "sdcard",
            number: 222,
            mode: "EdgeHigh"
          }
        ],
        btis: [
          {
            id: 8
          }
        ]
      }
    },
    {
      service: "fuchsia.hardware.clock.Service",
      name: "clock-gate",
      from: "#clock-controller-ff63c000",
      to: "#mmc-ffe07000",
      constraints: {
        id: 65548
      }
    },
    {
      service: "fuchsia.hardware.gpio.Service",
      name: "gpio-emmc-reset",
      from: "#gpio-controller-ff634400",
      to: "#mmc-ffe07000",
      constraints: {
        pin: 44,
        name: "gpio-reset"
      }
    },
    {
      from: "parent",
      service: "fuchsia.hardware.platform.device.Service",
      name: "pdev",
      to: "#mmc-ffe07000",
      constraints: {
        mmio: [
          {
            name: "emmc",
            address: 0xffe07000,
            size: 0x2000
          }
        ],
        interrupts: [
          {
            name: "emmc",
            number: 223,
            mode: "EdgeHigh"
          }
        ],
        btis: [
          {
            id: 9
          }
        ],
        boot_metadata: [
          {
            zbi_type: 1414680685,
            zbi_extra: 0
          }
        ]
      }
    },
    {
      service: "fuchsia.hardware.pin.PinStatesService",
      name: "pin-states-0",
      from: "#gpio-controller-ff634400",
      to: "#mmc-ffe07000",
      constraints: {
        states: [
          {
            name: "default",
            pins: [
              { pin: 32, call: { pin_config: { function: 1 } } },
              { pin: 33, call: { pin_config: { function: 1 } } },
              { pin: 34, call: { pin_config: { function: 1 } } },
              { pin: 35, call: { pin_config: { function: 1 } } },
              { pin: 36, call: { pin_config: { function: 1 } } },
              { pin: 37, call: { pin_config: { function: 1 } } },
              { pin: 38, call: { pin_config: { function: 1 } } },
              { pin: 39, call: { pin_config: { function: 1 } } },
              { pin: 40, call: { pin_config: { function: 1 } } },
              { pin: 42, call: { pin_config: { function: 1 } } },
              { pin: 45, call: { pin_config: { function: 1 } } },
              { pin: 46, call: { buffer_mode: "OutputHigh" } }
            ]
          }
        ]
      }
    },
    {
      service: "fuchsia.hardware.pin.PinStatesService",
      name: "pin-states-0",
      from: "#gpio-controller-ff634400",
      to: "#mmc-ffe05000",
      constraints: {
        states: [
          {
            name: "default",
            pins: [
              { pin: 48, call: { pin_config: { function: 1 } } },
              { pin: 49, call: { pin_config: { function: 1 } } },
              { pin: 50, call: { pin_config: { function: 1 } } },
              { pin: 51, call: { pin_config: { function: 1 } } },
              { pin: 52, call: { pin_config: { function: 1 } } },
              { pin: 53, call: { pin_config: { function: 1 } } }
            ]
          }
        ]
      }
    },
    {
      service: "fuchsia.hardware.pin.PinStatesService",
      name: "pin-states-0",
      from: "#gpio-controller-ff634400",
      to: "#mmc-ffe03000",
      constraints: {
        states: [
          {
            name: "default",
            pins: [
              { pin: 56, call: { pin_config: { function: 1, pull: "None", drive_strength_ua: 4000 } } },
              { pin: 57, call: { pin_config: { function: 1, pull: "None", drive_strength_ua: 4000 } } },
              { pin: 58, call: { pin_config: { function: 1, pull: "None", drive_strength_ua: 4000 } } },
              { pin: 59, call: { pin_config: { function: 1, pull: "None", drive_strength_ua: 4000 } } },
              { pin: 60, call: { pin_config: { function: 1, pull: "None", drive_strength_ua: 4000 } } },
              { pin: 61, call: { pin_config: { function: 1, pull: "None", drive_strength_ua: 4000 } } }
            ]
          }
        ]
      }
    }
  ]
}
