import("//build/components.gni")
import("//build/drivers.gni")
import("//build/rust/rustc_test.gni")
import("//build/test.gni")

# The test suite consists of:
# fakes: Test fakes (FakeRootServer, FakeEcam) used by pci-unit-test and downstream
#        adapter tests.
# pci-unit-test: C++ unit tests (in unit/) testing allocation, bus, config,
#                device, and MSI-X against mock DDK and fakes.
# pci-driver-test: Rust integration test (driver/driver_tests.rs) running in
#                  DriverTestRealm to test all PCI protocol operations.
# fake-bus-pci (target: pci_fake): A fake bus driver loaded in DriverTestRealm
# to configure a fake device and serve fuchsia.hardware.pci.Service.

source_set("fakes") {
  testonly = true
  visibility = [
    ":*",
    "//src/devices/pci/drivers/pciroot-banjo-adapter/*",
  ]
  public = [
    "fakes/fake_ecam.h",
    "fakes/fake_root_service.h",
  ]
  public_deps = [
    "//sdk/fidl/fuchsia.hardware.pci.root:fuchsia.hardware.pci.root_cpp_testing",
    "//sdk/lib/driver/mmio/testing/cpp",
    "//src/devices/pci/lib/cpp:headers",
    "//src/devices/testing/fake-bti",
    "//src/devices/testing/fake-resource",
    "//zircon/system/ulib/fbl",
    "//zircon/system/ulib/hwreg",
    "//zircon/system/ulib/zx",
  ]
}

test("pci-unit") {
  output_name = "pci-unit-test"
  sources = [
    "unit/allocation_tests.cc",
    "unit/bus_tests.cc",
    "unit/config_tests.cc",
    "unit/device_tests.cc",
    "unit/msix_tests.cc",
  ]

  deps = [
    ":fakes",
    "..:user_pci",
    "//sdk/lib/async-loop:async-loop-cpp",
    "//sdk/lib/async-loop:async-loop-default",
    "//sdk/lib/async_patterns/testing/cpp",
    "//sdk/lib/component/outgoing/cpp",
    "//sdk/lib/driver/metadata/cpp",
    "//sdk/lib/driver/mmio/testing/cpp",
    "//src/devices/testing/fake-bti",
    "//src/devices/testing/fake-msi",
    "//src/devices/testing/mock-ddk",
    "//src/lib/fxl/test:gtest_main",
    "//src/lib/testing/loop_fixture",
    "//src/lib/testing/predicates",
    "//src/sys/test_runners/gtest:death_test",
    "//third_party/googletest:gtest",
  ]

  public_deps = [ "//src/devices/testing/fake-resource" ]

  # TODO(https://fxbug.dev/42136089): delete the below and fix compiler warnings
  configs += [ "//build/config:Wno-conversion" ]
}

rustc_test("pci-driver") {
  edition = "2024"
  output_name = "pci_driver_test"
  testonly = true
  source_root = "driver/driver_tests.rs"
  sources = [ "driver/driver_tests.rs" ]
  deps = [
    "//sdk/fidl/fuchsia.driver.test:fuchsia.driver.test_rust",
    "//sdk/fidl/fuchsia.hardware.pci:fuchsia.hardware.pci_rust",
    "//sdk/lib/driver_test_realm/realm_builder/rust",
    "//sdk/rust/zx",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//src/lib/fuchsia-component-test",
    "//src/lib/fuchsia-runtime",
  ]
}

# These drivers are not 'test' drivers because at the moment having other
# drivers in test/ breaks ddkltl integration tests.
fuchsia_cc_driver("pci_fake-driver") {
  legacy = true
  output_name = "fake-bus-pci"
  configs += [
    "//build/config:all_source",
    "//build/config/fuchsia:enable_zircon_asserts",
  ]
  testonly = true
  sources = [ "driver/fake_bus_driver.cc" ]
  public_deps = [
    "..:user_pci",
    "driver:fake_pci_bus_driver_bind",
    "//src/devices/lib/driver",
    "//src/devices/testing/fake-bti",
    "//src/devices/testing/fake-msi",
    "//src/devices/testing/fake-resource",
    "//src/lib/ddk",
    "//src/lib/ddktl",
    "//zircon/system/ulib/pretty",
    "//zircon/system/ulib/zxtest",
  ]
}

fuchsia_driver_component("pci_fake") {
  testonly = true
  component_name = "fake-bus-pci"
  deps = [ ":pci_fake-driver" ]
  info = "meta/pci_fake-info.json"
  manifest = "meta/pci_fake.cml"
}

fuchsia_unittest_package("pci-unit-test") {
  deps = [ ":pci-unit" ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}

fuchsia_unittest_package("pci_driver_test") {
  package_name = "pci-driver-test"
  manifest = "meta/pci-driver-test.cml"
  test_type = "system"
  deps = [
    ":pci-driver",
    ":pci_fake",
    "..",
    "//src/devices/bus/drivers/platform",
  ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}
