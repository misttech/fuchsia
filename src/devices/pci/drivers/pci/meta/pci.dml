{
    name: "bus-pci",
    include: [ "//sdk/lib/driver/compat/compat.shard.cml" ],
    program: {
        compat: "driver/bus-pci.so",
        colocate: "true",
        bind: { service: "fuchsia.hardware.pci.root.RootService" },
    },
    capabilities: [
        { service: "fuchsia.hardware.pci.Service" },
        { service: "fuchsia.hardware.pci.DebugService" },
    ],
    use: [
        {
            name: "default",
            service: "fuchsia.hardware.pci.BoardConfiguration",
            generate_bind_rule: false,
        },
        {
            name: "default",
            service: "fuchsia.hardware.pci.root.RootService",
            generate_bind_rule: false,
        },
        {
            name: "default",
            service: "fuchsia.hardware.pci.root.ConfigService",
            availability: "optional",
            generate_bind_rule: false,
        },
    ],
    expose: [
        {
            service: "fuchsia.hardware.pci.Service",
            from: "self",
        },
        {
            service: "fuchsia.hardware.pci.DebugService",
            from: "self",
        },
    ],
}
