{
    name: "pciroot-banjo-adapter",
    program: {
        // banjo ops and context pointers are only valid in the parent's process.
        colocate: "true",
        bind: { banjo: "fuchsia.pci.BIND_PROTOCOL.ROOT" },
    },
    capabilities: [
        { service: "fuchsia.hardware.pci.root.RootService" },
        { service: "fuchsia.hardware.pci.root.ConfigService" },
        { service: "fuchsia.hardware.pci.BoardConfiguration" },
    ],
    use: [
        { service: "fuchsia.driver.compat.Service" },
        {
            service: "fuchsia.hardware.pci.BoardConfiguration",
            availability: "optional",
            generate_bind_rule: false,
        },
    ],
    expose: [
        {
            service: "fuchsia.hardware.pci.root.RootService",
            from: "self",
        },
        {
            service: "fuchsia.hardware.pci.root.ConfigService",
            from: "self",
        },
        {
            service: "fuchsia.hardware.pci.BoardConfiguration",
            from: "self",
        },
    ],
}
