    "//third_party/rust_crates:serde",
  ]
}
if (is_host) {
  rustc_test("fidl_ir_lib_test") {
    sources = [
      "src/fidl.rs",
      "src/lib.rs",
    ]
    edition = "2024"
    deps = [
      "//third_party/rust_crates:anyhow",
      "//third_party/rust_crates:heck",
