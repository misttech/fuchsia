import("//build/bazel/bazel_test_suite.gni")

bazel_test_suite("bazel_tests") {
  host_tests = [ "//src/devices/lib/fidl-ir:fidl_ir_lib_test" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    ":fidl_ir_lib_test($host_toolchain)",
  ]
}

