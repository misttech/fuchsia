load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "lib",
    srcs = [
        "src/fidl.rs",
        "src/lib.rs",
    ],
    crate_name = "fidl_ir_lib",
    edition = "2024",
    visibility = [
        "//src/devices/tools/fidlgen_banjo:__subpackages__",
    ],
    deps = [
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:heck",
        "//third_party/rust_crates/vendor:regex",
        "//third_party/rust_crates/vendor:serde",
    ],
)

host_rustc_test(
    name = "fidl_ir_lib_test",
    crate = ":lib",
    edition = "2024",
)
