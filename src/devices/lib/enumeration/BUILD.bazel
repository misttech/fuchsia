load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "driver-host-enumeration-lib",
    srcs = ["src/lib.rs"],
    edition = "2024",
    visibility = [
        "//src/devices/board/drivers/astro:__pkg__",
        "//src/devices/board/drivers/nelson:__pkg__",
        "//src/devices/board/drivers/sherlock:__pkg__",
        "//vendor/google:__subpackages__",
