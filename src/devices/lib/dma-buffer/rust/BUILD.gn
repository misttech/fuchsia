import("//build/components.gni")
import("//build/rust/rustc_library.gni")

rustc_library("rust") {
  name = "dma_buffer"
  version = "0.1.0"
  edition = "2024"
  with_unit_tests = true

  deps = [
    "//sdk/rust/zx",
    "//src/lib/fuchsia-runtime",
    "//src/lib/mapped-vmo",
    "//third_party/rust_crates:zerocopy",
  ]

  test_deps = [
    "//sdk/lib/driver/fake-bti/rust",
    "//src/lib/fuchsia",
    "//third_party/rust_crates:test-case",
  ]

  sources = [
    "src/lib.rs",
    "src/phys_iter.rs",
  ]

  configs += [ "//build/config/rust/lints:clippy_warn_all" ]
}

fuchsia_unittest_package("dma-buffer-rust-tests") {
  deps = [ ":rust_test" ]
}

group("tests") {
  testonly = true
  deps = [ ":dma-buffer-rust-tests" ]
}
