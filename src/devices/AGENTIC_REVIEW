# Rust driver skills and rubric.
conditional_capability_groups {
  path_expression: "....rs"
  review_capability_skills: ".agents/skills/rust_best_practices/SKILL.md"
  review_capability_skills: "src/devices/skills/rust_driver_best_practices/SKILL.md"
  review_capability_skills: "docs/development/drivers/developer_guide/rust-rubric.md"
}

# C++ driver skills and rubric.
conditional_capability_groups {
  path_expression: "....c"
  path_expression: "....cc"
  path_expression: "....cpp"
  path_expression: "....h"
  path_expression: "....hpp"
  review_capability_skills: ".agents/skills/fuchsia-cpp-guidelines/SKILL.md"
  review_capability_skills: "docs/development/drivers/developer_guide/cpp-rubric.md"
}

# Driver directory structure and suspend/resume integration.
conditional_capability_groups {
  path_expression: "....rs"
  path_expression: "....cc"
  path_expression: "....h"
  path_expression: "....cml"
  review_capability_skills: "src/devices/skills/driver_file_structure/SKILL.md"
  review_capability_skills: "src/devices/skills/fuchsia-suspendable/SKILL.md"
}

# Driver bind rules and board devicetree files.
conditional_capability_groups {
  path_expression: "....bind"
  path_expression: "....dts"
  path_expression: "....dtsi"
  path_expression: "....dts.S"
  review_capability_skills: "src/devices/skills/driver_bind_devicetree/SKILL.md"
  review_capability_skills: "src/devices/skills/driver_bind_find_instance_name/SKILL.md"
}
