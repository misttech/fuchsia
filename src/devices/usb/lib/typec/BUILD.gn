import("//build/components.gni")
import("//build/rust/rustc_library.gni")

rustc_library("typec") {
  edition = "2024"
  with_unit_tests = true

  sources = [
    "src/cc.rs",
    "src/lib.rs",
    "src/tests/cc.rs",
    "src/tests/mod.rs",
  ]

  deps = [ "//sdk/fidl/fuchsia.hardware.usb.connector:fuchsia.hardware.usb.connector_rust_next" ]

  test_deps = [ "//src/lib/fuchsia" ]
}

fuchsia_unittest_package("typec-tests") {
  deps = [ ":typec_test" ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}

group("tests") {
  testonly = true
  deps = [ ":typec-tests" ]
}
