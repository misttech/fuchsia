{
    name: "ufs-pci-bind",
    composite_name: "ufs_pci",
    include: [ "driver_component/driver.shard.cml" ],
    program: {
        binary: "driver/ufs-pci.so",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        allowed_scheduler_roles: [
            "fuchsia.devices.storage.ufs.irq",
            "fuchsia.devices.storage.ufs.worker",
        ],
        suspend_enabled: "true",
    },
    capabilities: [
        { service: "fuchsia.hardware.block.volume.Service" },
        { service: "fuchsia.hardware.ufs.Service" },
        { service: "fuchsia.hardware.rpmb.Service" },
    ],
    use: [
        {
            config: "fuchsia.power.StoragePowerManagementEnabled",
            key: "storage_power_management_enabled",
            type: "bool",
            availability: "optional",
            default: false,
        },
        {
            config: "fuchsia.power.SuspendEnabled",
            key: "enable_suspend",
            type: "bool",
        },
        {
            config: "fuchsia.storage.ufs.AutoHibernateTimerUs",
            key: "auto_hibernate_timer_us",
            type: "uint32",
            availability: "optional",
            default: 2000,
        },
        {
            config: "fuchsia.storage.ufs.EnableAutoHibernate",
            key: "enable_auto_hibernate",
            type: "bool",
            availability: "optional",
            default: true,
        },
        {
            // Runtime link-idle timer as a multiple of the Auto-Hibern8 idle timer: once the link
            // has been idle this long the PHY is asked to drop its link-idle clock votes.
            config: "fuchsia.storage.ufs.LinkIdleAhitMultiplier",
            key: "link_idle_ahit_multiplier",
            type: "uint32",
            availability: "optional",
            default: 2,
        },
        { protocol: "fuchsia.power.system.CpuElementManager" },
        { protocol: "fuchsia.scheduler.RoleManager" },
        {
            name: "pci",
            service: "fuchsia.hardware.pci.Service",
            primary: true,
            bind: {
                service: "fuchsia.hardware.pci.Service",
                pci: {
                    class: "fuchsia.pci.BIND_PCI_CLASS.MASS_STORAGE",
                    subclass: "fuchsia.pci.massstorage.BIND_PCI_SUBCLASS.UFS",
                    interface: "1",
                },
            },
        },
        {
            name: "acpi",
            availability: "optional",
            bind: { protocol: "fuchsia.acpi.BIND_PROTOCOL.DEVICE" },
        },
    ],
    expose: [
        {
            service: "fuchsia.hardware.block.volume.Service",
            from: "self",
        },
        {
            service: "fuchsia.hardware.ufs.Service",
            from: "self",
        },
        {
            service: "fuchsia.hardware.rpmb.Service",
            from: "self",
        },
    ],
}
