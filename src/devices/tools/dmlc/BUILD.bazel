load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//build/bazel/rules/rust:defs.bzl", "rustc_binary")

package(default_applicable_licenses = ["//:license"])

rustc_binary(
    name = "dmlc",
    srcs = [
        "src/bind_generator.rs",
        "src/board_compiler.rs",
        "src/cml_generator.rs",
        "src/cpp_generator.rs",
        "src/driver_compiler.rs",
        "src/main.rs",
        "src/parser.rs",
        "src/property_def.rs",
        "src/rust_generator.rs",
        "src/workarounds.rs",
    ],
    compile_data = ["dml.schema.json"],
    crate_name = "dmlc",
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//build/bazel/rules:__subpackages__"],
    deps = [
        "//sdk/fidl/fuchsia.driver.metadata:fuchsia.driver.metadata_rust",
        "//src/devices/board/lib/dml-config",
        "//src/lib/fidl/rust/fidl",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:argh",
        "//third_party/rust_crates/vendor:chrono",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:serde_json",
        "//third_party/rust_crates/vendor:serde_json5",
    ],
)

host_rustc_test(
    name = "dmlc_test",
    compile_data = ["dml.schema.json"],
    crate = ":dmlc",
    edition = "2024",
    deps = [
        "//sdk/fidl/fuchsia.driver.metadata:fuchsia.driver.metadata_rust",
        "//src/devices/board/lib/dml-config",
        "//src/lib/fidl/rust/fidl",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:argh",
        "//third_party/rust_crates/vendor:chrono",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:serde_json",
        "//third_party/rust_crates/vendor:serde_json5",
    ],
)

rustc_binary(
    name = "decode_config",
    srcs = ["src/decode_config.rs"],
    crate_root = "src/decode_config.rs",
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = [
        "//sdk/fidl/fuchsia.driver.metadata:fuchsia.driver.metadata_rust",
        "//src/devices/board/lib/dml-config",
        "//src/lib/fidl/rust/fidl",
        "//third_party/rust_crates/vendor:anyhow",
    ],
)
