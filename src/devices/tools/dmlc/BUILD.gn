import("//build/bazel/bazel_host_tool.gni")
import("//build/bazel/bazel_test_suite.gni")

if (is_host) {
  bazel_host_tool("bin") {
    bazel_target = ":dmlc"
    bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/dmlc"
    output_name = "dmlc"
  }

  bazel_host_tool("decode_config") {
    bazel_target = ":decode_config"
    bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/decode_config"
  }
}

group("dmlc") {
  deps = [
    ":bin($host_toolchain)",
    ":decode_config($host_toolchain)",
  ]
}

bazel_test_suite("dmlc-tests") {
  host_tests = [ "//src/devices/tools/dmlc:dmlc_test" ]
}

group("tests") {
  testonly = true
  deps = [ ":dmlc-tests" ]
}
