import("//build/sdk/sdk_host_tool.gni")

group("fidlgen_banjo") {
  deps = [ ":bin($host_toolchain)" ]
}

group("tests") {
  testonly = true
  deps = [
    ":fidlgen_banjo_lib_test($host_toolchain)",
    "tests",
  ]
}

if (is_host) {
  sdk_host_tool("fidlgen_banjo_bin_sdk") {
    category = "partner"
    output_name = "fidlgen_banjo"
    deps = [ ":bin" ]
  }
}

