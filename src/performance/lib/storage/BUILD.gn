import("//build/python/python_library.gni")

python_library("storage") {
  testonly = true
  library_name = "storage"
  sources = [
    "__init__.py",
    "block_io.py",
  ]
  library_deps = [
    "//src/performance/lib/perf_publish",
    "//src/performance/lib/reporting",
    "//src/performance/lib/trace_processing",
  ]
}

group("tests") {
  testonly = true
  public_deps = [ "tests($host_toolchain)" ]
}
