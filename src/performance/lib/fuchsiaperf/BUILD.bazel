load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "wrap_host_rust_test")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "fuchsiaperf",
    srcs = ["src/lib.rs"],
    edition = "2024",
    visibility = ["//:__subpackages__"],
    deps = ["//third_party/rust_crates/vendor:serde"],
)

rustc_test(
    name = "fuchsiaperf_test",
    crate = ":fuchsiaperf",
    deps = ["//third_party/rust_crates/vendor:serde_json"],
)

wrap_host_rust_test(
    name = "fuchsiaperf_host_test",
    binary_name = "fuchsiaperf_test",
)

fx_unittest_package(
    name = "fuchsiaperf_tests",
    unit_tests = [":fuchsiaperf_test"],
)
