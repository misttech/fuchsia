import("//build/components.gni")
import("//build/rust/rustc_library.gni")

fuchsia_unittest_package("fxt_unittests") {
  deps = [ ":rust_test" ]
}

group("tests") {
  testonly = true
  deps = [
    ":fxt-layout_test($host_toolchain)",
    ":fxt_unittests",
    ":rust_test($host_toolchain)",
    "tests",
  ]
}

