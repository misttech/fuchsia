import("//build/bazel/bazel_test_suite.gni")

bazel_test_suite("bazel_tests") {
  target_tests = [ "//src/performance/memory:target_tests" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    "attribution:tests",
    "heapdump:tests",
    "index_table_builder:tests",
    "memory_mapped_vmo:tests",
    "pprof:tests",
    "sampler:tests",
    "stacktrack:tests",
    "tests",
    "thrasher:tests",
  ]
}
