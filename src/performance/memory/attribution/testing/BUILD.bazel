load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "testing",
    testonly = True,
    srcs = ["src/lib.rs"],
    crate_name = "attribution_testing",
    edition = "2024",
    # @bazel2gn:skip
    lint_config = "//build/config/rust/lints:clippy_warn_default",
    visibility = [
        "//examples/components/runner/colocated/integration_tests:__pkg__",
        "//src/starnix/tests/memory_attribution:__pkg__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.component:fuchsia.component_rust",
        "//sdk/fidl/fuchsia.memory.attribution:fuchsia.memory.attribution_rust",
        "//sdk/rust/zx",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/mapped-vmo",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:pin-project",
    ],
)
