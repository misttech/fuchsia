import("//build/python/python_host_test.gni")

if (is_host) {
  python_host_test("adb_test") {
    main_source = "adb_test.py"
    libraries = [
      "//src/testing/end_to_end/honeydew",
      "//third_party/mobly",
    ]
    main_callable = "unittest.main"
    extra_args = [ "-v" ]
  }

  python_host_test("adb_server_test") {
    main_source = "adb_server_test.py"
    libraries = [ "//src/testing/end_to_end/honeydew" ]
    main_callable = "unittest.main"
    extra_args = [ "-v" ]
  }
}

group("tests") {
  testonly = true
  public_deps = [
    ":adb_server_test($host_toolchain)",
    ":adb_test($host_toolchain)",
  ]
}
