import("//build/python/python_mobly_test.gni")
import("//build/testing/environments.gni")

if (is_host) {
  python_mobly_test("tracing_test") {
    main_source = "test_tracing.py"
    libraries = [
      "//src/performance/lib/trace_processing",
      "//src/testing/end_to_end/honeydew",
      "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
      "//third_party/parameterized",
    ]
    environments = [
      # Only enable for AEMU-x64 as host-tests aren't supported on QEMU-arm64.
      aemu_env,
      nuc11_env,
      vim3_env,
      nelson_env,
      sherlock_env,
    ]
    honeydew_config = {
      transports = {
        adb = {
          enabled = false
        }
      }
    }
  }

  python_mobly_test("tracing_ffx_test") {
    main_source = "test_tracing.py"
    libraries = [
      "//src/performance/lib/trace_processing",
      "//src/testing/end_to_end/honeydew",
      "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
      "//third_party/parameterized",
    ]
    environments = [
      # Only enable for AEMU-x64 as host-tests aren't supported on QEMU-arm64.
      aemu_env,
      nuc11_env,
      vim3_env,
      nelson_env,
      sherlock_env,
    ]
    honeydew_config = {
      affordances = {
        tracing = {
          implementation = "ffx"
        }
      }
      transports = {
        adb = {
          enabled = false
        }
      }
    }
  }
}

# Group containing all of the tracing affordance functional test cases and its
# dependencies.
group("tests") {
  testonly = true
  public_deps = [
    ":tracing_ffx_test($host_toolchain)",
    ":tracing_test($host_toolchain)",
  ]
}
