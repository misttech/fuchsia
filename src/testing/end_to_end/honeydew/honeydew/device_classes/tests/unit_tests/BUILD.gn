import("//build/python/python_host_test.gni")

if (is_host) {
  python_host_test("android_device_test") {
    main_source = "android_device_test.py"
    libraries = [
      "//src/testing/end_to_end/honeydew",
      "//third_party/mobly",
      "//third_party/parameterized",
    ]
    main_callable = "unittest.main"
    extra_args = [ "-v" ]
  }

  python_host_test("smart_display_test") {
    main_source = "smart_display_test.py"
    libraries = [
      "//src/testing/end_to_end/honeydew",
      "//third_party/parameterized",
    ]
    main_callable = "unittest.main"
    extra_args = [ "-v" ]
  }

  python_host_test("workbench_test") {
    main_source = "workbench_test.py"
    libraries = [
      "//src/testing/end_to_end/honeydew",
      "//third_party/parameterized",
    ]
    main_callable = "unittest.main"
    extra_args = [ "-v" ]
  }
}

group("tests") {
  testonly = true
  public_deps = [
    ":android_device_test($host_toolchain)",
    ":smart_display_test($host_toolchain)",
    ":workbench_test($host_toolchain)",
  ]
}
