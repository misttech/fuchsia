import("//build/testing/environments.gni")
import("//src/testing/end_to_end/antlion/antlion_host_test.gni")

assert(is_host, "antlion tests only supported for host testing")

antlion_host_test("wlan_security_type_test") {
  main_source = "SecurityTypeTest.py"
  environments = wlan_ap_envs
  timeout_secs = 660
  libraries = [
    "//sdk/fidl/fuchsia.wlan.policy:fuchsia.wlan.policy_python",
    "//src/testing/end_to_end/honeydew",
    "//src/testing/end_to_end/mobly_base_tests:fuchsia_wlan_base_test",
    "//src/testing/end_to_end/mobly_controller/legacy_access_point",
    "//src/testing/end_to_end/mobly_controller/openwrt_access_point",
  ]
}
