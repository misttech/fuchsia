import("//build/python/python_host_test.gni")

if (is_host) {
  python_host_test("dhcp_config_test") {
    main_source = "dhcp_config_test.py"
    libraries = [
      "//src/testing/end_to_end/antlion",
      "//src/testing/end_to_end/mobly_controller/legacy_access_point",
    ]
    main_callable = "unittest.main"
    extra_args = [ "-v" ]
  }

  python_host_test("hostapd_test") {
    main_source = "hostapd_test.py"
    libraries = [
      "//src/testing/end_to_end/antlion",
      "//src/testing/end_to_end/honeydew",
      "//src/testing/end_to_end/libs",
      "//src/testing/end_to_end/mobly_controller/legacy_access_point",
    ]
    main_callable = "unittest.main"
    extra_args = [ "-v" ]
  }

  python_host_test("radio_measurement_test") {
    main_source = "radio_measurement_test.py"
    libraries = [
      "//src/testing/end_to_end/antlion",
      "//src/testing/end_to_end/honeydew",
      "//src/testing/end_to_end/mobly_controller/legacy_access_point",
    ]
    main_callable = "unittest.main"
    extra_args = [ "-v" ]
  }

  python_host_test("radvd_test") {
    main_source = "radvd_test.py"
    libraries = [
      "//src/testing/end_to_end/antlion",
      "//src/testing/end_to_end/mobly_controller/legacy_access_point",
    ]
    main_callable = "unittest.main"
    extra_args = [ "-v" ]
  }

  python_host_test("wireless_network_management_test") {
    main_source = "wireless_network_management_test.py"
    libraries = [
      "//src/testing/end_to_end/antlion",
      "//src/testing/end_to_end/honeydew",
      "//src/testing/end_to_end/mobly_controller/legacy_access_point",
    ]
    main_callable = "unittest.main"
    extra_args = [ "-v" ]
  }
}

group("tests") {
  testonly = true
  public_deps = [
    ":dhcp_config_test($host_toolchain)",
    ":hostapd_test($host_toolchain)",
    ":radio_measurement_test($host_toolchain)",
    ":radvd_test($host_toolchain)",
    ":wireless_network_management_test($host_toolchain)",
  ]
}
