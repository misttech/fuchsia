import("//build/python/python_host_test.gni")

if (is_host) {
  python_host_test("attenuator_test") {
    main_source = "attenuator_test.py"
    libraries = [
      "//src/testing/end_to_end/mobly_controller/attenuator",
      "//src/testing/end_to_end/libs",
      "//third_party/mobly:mobly",
    ]
    main_callable = "unittest.main"
    extra_args = [ "-v" ]
  }
}

group("tests") {
  testonly = true
  public_deps = [ ":attenuator_test($host_toolchain)" ]
}
