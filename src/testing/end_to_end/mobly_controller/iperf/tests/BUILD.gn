import("//build/python/python_host_test.gni")

if (is_host) {
  python_host_test("iperf_server_test") {
    main_source = "iperf_server_test.py"
    libraries = [
      "//src/testing/end_to_end/mobly_controller/iperf",
      "//src/testing/end_to_end/libs",
      "//third_party/mobly:mobly",
    ]
    main_callable = "unittest.main"
    extra_args = [ "-v" ]
  }

  python_host_test("iperf_client_test") {
    main_source = "iperf_client_test.py"
    libraries = [
      "//src/testing/end_to_end/mobly_controller/iperf",
      "//src/testing/end_to_end/libs",
      "//third_party/mobly:mobly",
    ]
    main_callable = "unittest.main"
    extra_args = [ "-v" ]
  }
}

group("tests") {
  testonly = true
  public_deps = [
    ":iperf_client_test($host_toolchain)",
    ":iperf_server_test($host_toolchain)",
  ]
}
