import("//build/tools/bazel2gn/bazel_migration.gni")

if (is_host) {
  go_library("omaha_tool") {
    testonly = true
    non_go_deps = [ ":test_tools" ]
    sources = [
      "omaha.go",
      "omaha_structs.go",
      "omaha_test.go",
    ]
    visibility = [
      ":*",
      "//src/testing/host-target-testing/artifacts:*",
      "//src/testing/host-target-testing/cli:*",
      "//src/testing/host-target-testing/updater:*",
    ]
    deps = [
      "//tools/lib/color",
      "//tools/lib/logger",
    ]
  }
}
