load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_go_test.bzl", "host_go_test")

package(default_applicable_licenses = ["//:license"])

go_library(
    name = "paver",
    srcs = [
        "paver.go",
    ],
    importpath = "go.fuchsia.dev/fuchsia/src/testing/host-target-testing/paver",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = [
        "//src/firmware/paver/e2e_tests:__pkg__",
        "//src/testing/host-target-testing:__subpackages__",
    ],
    deps = [
        "//third_party/golibs:golang.org/x/crypto/ssh",  # @bazel2gn:path_overwrite://third_party/golibs:golang.org/x/crypto
        "//tools/lib/logger",
    ],
)

# @bazel2gn:skip
host_go_test(
    name = "host-target-testing-paver-test",
    srcs = [
        "paver_test.go",
    ],
    embed = [":paver"],
    target_compatible_with = HOST_OS_CONSTRAINTS,
)
