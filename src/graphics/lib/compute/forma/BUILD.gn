import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("forma") {
  sources = [
    "src/buffer.rs",
    "src/composition/interner.rs",
    "src/composition/layer.rs",
    "src/composition/mod.rs",
    "src/composition/state.rs",
    "src/layer.rs",
    "src/lib.rs",
    "src/renderer/cpu.rs",
    "src/renderer/mod.rs",
    "src/small_bit_set.rs",
    "src/utils.rs",
  ]
  configs += [ ":forma-performance" ]
  edition = "2024"
  visibility = [
    ":*",
    "//src/graphics/lib/compute:*",
    "//src/lib/ui/carnelian:*",
  ]
  deps = [
    "//src/graphics/lib/compute/surpass",
    "//src/lib/trace/rust:trace",
    "//third_party/rust_crates:rustc-hash",
  ]
}
rustc_test("forma_test") {
  sources = [
    "src/buffer.rs",
    "src/composition/interner.rs",
    "src/composition/layer.rs",
    "src/composition/mod.rs",
    "src/composition/state.rs",
    "src/layer.rs",
    "src/lib.rs",
    "src/renderer/cpu.rs",
    "src/renderer/mod.rs",
    "src/small_bit_set.rs",
    "src/utils.rs",
  ]
  edition = "2024"
  deps = [
    "//src/graphics/lib/compute/surpass",
    "//src/lib/trace/rust:trace",
    "//third_party/rust_crates:rustc-hash",
  ]
  configs += [ ":forma-performance" ]
  deps += [ "//build/config/sanitizers:suppress-lsan.DO-NOT-USE-THIS" ]
}
fuchsia_unittest_package("forma-tests") {
  package_name = "forma-tests-gn"
  component_name = "forma-tests"
  deps = [ ":forma_test" ]
  visibility = [
    ":*",
    "//src/graphics:*",
    "//src/graphics/lib/compute:*",
  ]
}
