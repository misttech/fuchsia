import("//build/components.gni")

fuchsia_package_with_single_component("display-tweak") {
  component_name = "display_tweak"
  manifest = "meta/display-tweak.cml"
  deps = [ ":bin" ]
}

group("tests") {
  testonly = true
  deps = [ ":display-tweak-tests" ]
}

