load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "display-mocks",
    srcs = ["src/lib.rs"],
    edition = "2024",
    visibility = ["//src/graphics/display/lib/rust/display-utils:__pkg__"],
    deps = [
        "//sdk/fidl/fuchsia.hardware.display:fuchsia.hardware.display_rust",
        "//sdk/fidl/fuchsia.hardware.display.types:fuchsia.hardware.display.types_rust",
        "//sdk/rust/zx",
        "//src/lib/fidl/rust/fidl",
        "//third_party/rust_crates/vendor:itertools",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)

rustc_test(
    name = "display-mocks_test",
    crate = ":display-mocks",
    edition = "2024",
    deps = [
        "//src/lib/fuchsia",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
    ],
)

fx_unittest_package(
    name = "display-mocks-test",
    unit_tests = [":display-mocks_test"],
    visibility = ["//src/graphics:__pkg__"],
)
