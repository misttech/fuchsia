import("//build/components.gni")
import("//build/rust/rustc_library.gni")

# Driver-side implementation of the virtio 1.x PCI transport, shared by Rust
# virtio drivers.
rustc_library("virtio-driver") {
  edition = "2024"
  with_unit_tests = true
  sources = [
    "src/common.rs",
    "src/common/device_status.rs",
    "src/common/feature_bits.rs",
    "src/common/queue.rs",
    "src/common/queue/abi.rs",
    "src/common/queue/buffer.rs",
    "src/common/queue/descriptor_table.rs",
    "src/common/queue/layout.rs",
    "src/common/queue/rings.rs",
    "src/lib.rs",
    "src/pci.rs",
    "src/pci/bar_map.rs",
    "src/pci/capabilities.rs",
    "src/pci/capability_type.rs",
    "src/pci/common_configuration.rs",
    "src/pci/device.rs",
    "src/pci/pci_notifications.rs",
    "src/pci/pci_queue.rs",
  ]
  deps = [
    "//sdk/fidl/fuchsia.hardware.pci:fuchsia.hardware.pci_rust_next",
    "//sdk/lib/driver/mmio/rust:mmio",
    "//sdk/rust/zx",
    "//sdk/rust/zx-sys",
    "//src/lib/fidl/rust_next/fidl_next",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-runtime",
    "//third_party/rust_crates:bitfield",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:zerocopy",
  ]
  test_deps = [ "//src/lib/fuchsia" ]
}

fuchsia_unittest_package("virtio-driver-test-package") {
  package_name = "virtio-driver-rust-test"
  deps = [ ":virtio-driver_test" ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}

group("tests") {
  testonly = true
  deps = [ ":virtio-driver-test-package" ]
}
