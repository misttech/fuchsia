{
    include: [
        "inspect/client.shard.cml",
        "syslog/client.shard.cml",
    ],
    program: {
        runner: "elf",
        binary: "bin/vulkan_loader",
        lifecycle: { stop_event: "notify" },
    },
    collections: [
        {
            name: "icd-loaders",
            environment: "#icd-loader-env",
            durability: "transient",
        },
    ],
    capabilities: [
        {
            protocol: [ "fuchsia.vulkan.loader.Loader" ],
        },
        {
            service: [ "fuchsia.vulkan.loader.TrustedService" ],
        },
        {
            runner: "icd_runner",
            path: "/svc/fuchsia.component.runner.ComponentRunner",
        },
    ],
    use: [
        {
            // This service replaces the directory capability above.
            service: [
                "fuchsia.gpu.magma.DependencyInjectionService",
                "fuchsia.gpu.magma.Service",
                "fuchsia.gpu.magma.TrustedService",
            ],
        },
        {
            // TODO(https://fxbug.dev/324273348): Remove this capability once the clients have
            // been migrated to services. The service capability has been added below.
            directory: "dev-goldfish-pipe",
            rights: [ "r*" ],
            path: "/dev/class/goldfish-pipe",
        },
        {
            // This service replaces the directory capability above.
            service: "fuchsia.hardware.goldfish.ControllerService",
        },
        {
            // TODO(https://fxbug.dev/324273348): Remove this capability once the clients have
            // been migrated to services. The service capability has been added below.
            directory: "dev-goldfish-control",
            rights: [ "r*" ],
            path: "/dev/class/goldfish-control",
        },
        {
            // This service replaces the directory capability above.
            service: "fuchsia.hardware.goldfish.ControlService",
        },
        {
            // TODO(https://fxbug.dev/324273348): Remove this capability once the clients have
            // been migrated to services. The service capability has been added below.
            directory: "dev-goldfish-address-space",
            rights: [ "r*" ],
            path: "/dev/class/goldfish-address-space",
        },
        {
            // This service replaces the directory capability above.
            service: "fuchsia.hardware.goldfish.AddressSpaceService",
        },
        {
            // TODO(https://fxbug.dev/324273348): Remove this capability once the clients have
            // been migrated to services. The service capability has been added below.
            directory: "dev-goldfish-sync",
            rights: [ "r*" ],
            path: "/dev/class/goldfish-sync",
        },
        {
            // This service replaces the directory capability above.
            service: "fuchsia.hardware.goldfish.SyncService",
        },
        {
            protocol: "fuchsia.component.Realm",
            from: "framework",
        },
        {
            protocol: "fuchsia.kernel.VmexResource",
            from: "parent",
            availability: "optional",
        },
        {
            protocol: "fuchsia.memorypressure.Provider",
            from: "parent",
            availability: "optional",
        },
        {
            config: "fuchsia.vulkan.loader.AllowMagmaIcds",
            key: "allow_magma_icds",
            type: "bool",
            availability: "optional",
            default: false,
        },
        {
            config: "fuchsia.vulkan.loader.AllowGoldfishIcd",
            key: "allow_goldfish_icd",
            type: "bool",
            availability: "optional",
            default: false,
        },
        {
            config: "fuchsia.vulkan.loader.AllowLavapipeIcd",
            key: "allow_lavapipe_icd",
            type: "bool",
            availability: "optional",
            default: false,
        },
        {
            config: "fuchsia.vulkan.loader.LavapipeIcdUrl",
            key: "lavapipe_icd_url",
            type: "string",
            max_size: 120,
            availability: "optional",
            default: "fuchsia-pkg://fuchsia.com/libvulkan_lavapipe#meta/vulkan.cm",
        },
    ],
    expose: [
        {
            protocol: "fuchsia.vulkan.loader.Loader",
            from: "self",
        },
        {
            service: "fuchsia.vulkan.loader.TrustedService",
            from: "self",
        },
    ],
    environments: [
        {
            name: "icd-loader-env",
            extends: "realm",
            runners: [
                {
                    runner: "icd_runner",
                    from: "self",
                },
            ],
        },
    ],
}
