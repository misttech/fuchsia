import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("framework") {
  testonly = true
  sources = [
    "src/block_device.rs",
    "src/directory_benchmarks.rs",
    "src/filesystem.rs",
    "src/io_benchmarks.rs",
    "src/lib.rs",
    "src/testing.rs",
  ]
  crate_name = "storage_benchmarks"
  edition = "2024"
  proc_macro_deps = [ "//third_party/rust_crates:async-trait" ]
  visibility = [
    ":*",
    "//src/storage/benchmarks/fuchsia:*",
    "//src/storage/benchmarks/host:*",
    "//src/storage/benchmarks/starnix:*",
    "//src/storage/benchmarks/verity:*",
  ]
  deps = []
  deps += [
    "//src/performance/lib/fuchsiaperf",
    "//src/storage/lib/trace",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:libc",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:prettytable-rs",
    "//third_party/rust_crates:rand",
    "//third_party/rust_crates:rand_xorshift",
    "//third_party/rust_crates:regex",
    "//third_party/rust_crates:serde_json",
    "//third_party/rust_crates:tempfile",
  ]
  if (is_fuchsia) {
    deps += [ "//src/storage/lib/fs_management/rust:fs_management" ]
  }
}

rustc_test("framework_test") {
  sources = [
    "src/block_device.rs",
    "src/directory_benchmarks.rs",
    "src/filesystem.rs",
    "src/io_benchmarks.rs",
    "src/lib.rs",
    "src/testing.rs",
  ]
  edition = "2024"
  proc_macro_deps = [ "//third_party/rust_crates:async-trait" ]
  deps = []
  deps += [
    "//src/performance/lib/fuchsiaperf",
    "//src/storage/lib/trace",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:libc",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:prettytable-rs",
    "//third_party/rust_crates:rand",
    "//third_party/rust_crates:rand_xorshift",
    "//third_party/rust_crates:regex",
    "//third_party/rust_crates:serde_json",
    "//third_party/rust_crates:tempfile",
  ]
  if (is_fuchsia) {
    deps += [ "//src/storage/lib/fs_management/rust:fs_management" ]
  }
  deps += [ "//src/lib/fuchsia" ]
  deps += [ "//src/sys/test_runners:tmp_storage" ]
  output_name = "storage_benchmarks_lib_test"
}

fuchsia_unittest_package("storage-benchmarks-framework-tests") {
  package_name = "storage-benchmarks-framework-tests-gn"
  component_name = "storage-benchmarks-framework-tests"
  deps = [ ":framework_test" ]
  visibility = [
    ":*",
    "//src/storage:*",
  ]
}
