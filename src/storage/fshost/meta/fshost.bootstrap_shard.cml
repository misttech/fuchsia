{
    children: [
        {
            name: "fshost",
            url: "fuchsia-boot:///fshost#meta/fshost.cm",
            environment: "#fshost-env",
            on_terminate: "reboot",
        },
    ],
    capabilities: [
        { dictionary: "starnix-volume" },
    ],
    offer: [
        {
            directory: "boot",
            from: "parent",
            to: "#fshost",
            rights: [ "rx*" ],
        },
        {
            protocol: [
                "fuchsia.boot.Items",
                "fuchsia.boot.WriteOnlyLog",
                "fuchsia.feedback.CrashReporter",
                "fuchsia.metrics.MetricEventLoggerFactory",
                "fuchsia.process.Launcher",
            ],
            from: "parent",
            to: "#fshost",
        },
        {
            protocol: "fuchsia.driver.token.NodeBusTopology",
            from: "#driver_manager",
            to: "#fshost",
        },
        {
            protocol: [
                "fuchsia.memorypressure.Provider",
                "fuchsia.tracing.provider.Registry",
            ],
            from: "parent",
            to: "#fshost",
            availability: "optional",
        },
        {
            protocol: "fuchsia.memory.attribution.PagerStatsSink",
            from: "parent",
            to: "#fshost",
            dependency: "weak",
            availability: "optional",
            source_availability: "unknown",
        },
        {
            protocol: "fuchsia.scheduler.RoleManager",
            from: "#role_manager",
            to: [ "#fshost" ],
        },

        // Needed for kms_stateless (/dev/class/tee) and so component_manager stops #fshost before
        // #devfs (which triggers boot driver shutdown and zx_system_powerctl).
        {
            directory: "dev-topological",
            from: "#devfs",
            to: [ "#fshost" ],
        },

        // Route volume service instances for boot storage devices from
        // #boot-drivers to #fshost. Removable and external peripheral storage
        // must be isolated or filtered via NodeBusTopology to prevent
        // unauthenticated media from matching as system storage partitions.
        {
            service: "fuchsia.hardware.block.volume.Service",
            from: "#boot-drivers",
            to: "#fshost",
        },
        {
            dictionary: "diagnostics",
            from: "self",
            to: "#fshost",
        },
        {
            config: [
                "fuchsia.fshost.Blobfs",
                "fuchsia.fshost.BlobfsInitialInodes",
                "fuchsia.fshost.BlobfsUseDeprecatedPaddedFormat",
                "fuchsia.fshost.BlobMaxBytes",
                "fuchsia.fshost.CheckFilesystems",
                "fuchsia.fshost.Data",
                "fuchsia.fshost.DataFilesystemFormat",
                "fuchsia.fshost.DataMaxBytes",
                "fuchsia.fshost.DisableBlockWatcher",
                "fuchsia.fshost.Factory",
                "fuchsia.fshost.FormatDataOnCorruption",
                "fuchsia.fshost.Fvm",
                "fuchsia.fshost.FvmSliceSize",
                "fuchsia.fshost.FxfsBlob",
                "fuchsia.fshost.FxfsCryptUrl",
                "fuchsia.fshost.Gpt",
                "fuchsia.fshost.GptAll",
                "fuchsia.fshost.InlineCrypto",
                "fuchsia.fshost.MergeSuperAndUserdata",
                "fuchsia.fshost.NoZxcrypt",
                "fuchsia.fshost.ProvisionFxfs",
                "fuchsia.fshost.RamdiskImage",
                "fuchsia.fshost.StarnixVolumeName",
            ],
            from: "parent",
            to: "#fshost",
        },
        {
            config: [
                "fuchsia.fshost.DisableAutomount",
                "fuchsia.fshost.StartupProfilingSeconds",
                "fuchsia.pkgcache.UseDriverBlobPaging",
            ],
            from: "parent",
            to: "#fshost",
            availability: "optional",
        },
        {
            config: "fuchsia.diagnostics.StorageStallWatchdogEnabled",
            from: "parent",
            to: "#fshost",
            availability: "transitional",
        },
        {
            protocol: [
                "fuchsia.security.keymint.Admin",
                "fuchsia.security.keymint.SealingKeys",
            ],
            from: "parent",
            to: "#fshost",
            availability: "optional",
        },
        {
            directory: [
                "blob",
                "data",
                "tmp",
            ],
            from: "#fshost",
            to: "self/toolbox-directories",
            target_availability: "unknown",
        },
        {
            directory: [ "debug_block" ],
            from: "#fshost",
            as: "block",
            to: "self/toolbox-directories",
            availability: "optional",
            target_availability: "unknown",
        },
        {
            protocol: [
                "fuchsia.fshost.StarnixVolumeProvider",
                "fuchsia.hardware.inlineencryption.Device",
            ],
            from: "#fshost",
            to: "self/starnix-volume",
            availability: "optional",
            target_availability: "unknown",
        },
        {
            protocol: "fuchsia.power.battery.BatteryManager",
            from: "parent",
            to: "#fshost",
            availability: "optional",
        },
    ],
    expose: [
        {
            directory: [
                "blob",
                "block",
                "data",
                "factory",
                "tmp",
                "volumes",
            ],
            from: "#fshost",
        },
        {
            directory: "debug_block",
            from: "#fshost",
            availability: "optional",
        },
        {
            protocol: [
                "fuchsia.fs.startup.Volumes",
                "fuchsia.fshost.Admin",
                "fuchsia.fxfs.BlobCreator",
                "fuchsia.update.verify.ComponentOtaHealthCheck",
            ],
            from: "#fshost",
        },
        {
            protocol: [
                "fuchsia.storage.block.Mapper",
                "fuchsia.storage.mapping.MappingProvider",
            ],
            from: "#fshost",
            availability: "same_as_target",
        },
        {
            protocol: [
                "fuchsia.fshost.Recovery",
                "fuchsia.fxfs.FileBackedVolumeProvider",
                "fuchsia.storage.partitions.PartitionsAdmin",
                "fuchsia.storage.partitions.PartitionsManager",
            ],
            from: "#fshost",
            availability: "optional",
        },
        {
            protocol: "fuchsia.storage.blobfs.OverwriteConfiguration",
            from: "#fshost",
            availability: "same_as_target",
        },
        {
            service: "fuchsia.storage.partitions.PartitionService",
            from: "#fshost",
            availability: "optional",
        },
        {
            dictionary: "starnix-volume",
            from: "self",
        },
    ],
    environments: [
        {
            name: "fshost-env",
            extends: "realm",

            // 20 minutes
            __stop_timeout_ms: 1200000,
        },
    ],
}
