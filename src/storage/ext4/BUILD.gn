import("//build/bazel/bazel_test_suite.gni")
import("//build/components.gni")
import("//build/dist/resource.gni")

group("ext4") {
  deps = [
    "lib/parser",
    "server:bin",
  ]
}

bazel_test_suite("bazel_tests") {
  target_tests = [ "//src/storage/ext4:ext4-lib-tests" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    ":ext4-lib-tests",
    "lib:tests",
    "server:tests",
    "tests",
  ]
}

# GN copy of the Bazel test "ext4-lib-tests", while the library is used in both
# build systems. bazel2gn can't translate fuchsia_package_resource_group() yet.
# LINT.IfChange
resource("test-images") {
  testonly = true
  sources = [
    "test_files/1file.img",
    "test_files/extents.img",
    "test_files/longdir.img",
    "test_files/nest.img",
    "test_files/nest64.img",
    "test_files/xattr.img",
  ]
  outputs = [ "data/{{source_file_part}}" ]
}

fuchsia_unittest_package("ext4-lib-tests") {
  package_name = "ext4-lib-tests-gn"
  component_name = "ext4-lib-tests"
  deps = [
    ":ext4-lib_test",
    ":test-images",
  ]
}

