import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("fprint") {
  sources = [ "fprint/src/lib.rs" ]
  source_root = "fprint/src/lib.rs"
  edition = "2024"
  proc_macro_deps = [ ":macros" ]
  visibility = [
    ":*",
    "//src/storage/fxfs/*",
    "//src/storage/lib/blob_metadata:*",
  ]
  with_unit_tests = true
  deps = [ "//third_party/rust_crates:bit-vec" ]
}
if (is_host) {
  rustc_macro("macros") {
    sources = [ "macros/src/lib.rs" ]
    source_root = "macros/src/lib.rs"
    edition = "2024"
    deps = [
      "//third_party/rust_crates:proc-macro2",
      "//third_party/rust_crates:quote",
      "//third_party/rust_crates:syn",
    ]
  }
}
