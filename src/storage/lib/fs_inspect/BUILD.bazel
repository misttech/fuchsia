    name = "fs_inspect",
    srcs = ["src/lib.rs"],
    edition = "2024",
    proc_macro_deps = ["//third_party/rust_crates/vendor:async-trait"],
    visibility = ["//src/storage/fxfs/platform:__pkg__"],
