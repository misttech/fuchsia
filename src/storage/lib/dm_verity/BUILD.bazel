load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "dm_verity",
    srcs = ["src/lib.rs"],
    edition = "2024",
    visibility = ["//src/starnix/modules/device_mapper:__pkg__"],
    deps = [
        "//sdk/rust/zx-status",
        "//src/storage/lib/fsverity-merkle",
        "//third_party/rust_crates/vendor:hex",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)

rustc_test(
    name = "dm_verity_test",
    crate = ":dm_verity",
    edition = "2024",
    deps = ["//third_party/rust_crates/vendor:test-case"],
)

fx_unittest_package(
    name = "dm_verity_tests",
    unit_tests = [":dm_verity_test"],
)
