import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("dm_verity") {
  sources = [ "src/lib.rs" ]
  edition = "2024"
  visibility = [
    ":*",
    "//src/starnix/modules/device_mapper:*",
  ]
  deps = [
    "//sdk/rust/zx-status",
    "//src/storage/lib/fsverity-merkle",
    "//third_party/rust_crates:hex",
    "//third_party/rust_crates:thiserror",
  ]
}

rustc_test("dm_verity_test") {
  sources = [ "src/lib.rs" ]
  edition = "2024"
  deps = [
           "//sdk/rust/zx-status",
           "//src/storage/lib/fsverity-merkle",
           "//third_party/rust_crates:hex",
           "//third_party/rust_crates:thiserror",
         ] + [ "//third_party/rust_crates:test-case" ]
}

fuchsia_unittest_package("dm_verity_tests") {
  package_name = "dm_verity_tests-gn"
  component_name = "dm_verity_tests"
  deps = [ ":dm_verity_test" ]
}
