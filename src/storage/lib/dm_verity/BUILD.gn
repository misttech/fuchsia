import("//build/bazel/bazel_test_suite.gni")

bazel_test_suite("bazel_tests") {
  target_tests = [ "//src/storage/lib/dm_verity:dm_verity_tests" ]
}

group("tests") {
  testonly = true
  public_deps = [
    ":bazel_tests",
    ":dm_verity_tests",
  ]
}

