import("//build/bazel/bazel_test_suite.gni")

bazel_test_suite("bazel_tests") {
  target_tests = [ "//src/storage/lib/buddy_allocator:buddy-allocator-tests" ]
  host_tests = [ "//src/storage/lib/buddy_allocator:buddy_allocator_host_test" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    ":buddy-allocator-tests",
    ":buddy_allocator_test($host_toolchain)",
  ]
}

