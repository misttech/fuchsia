import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("fscrypt") {
  sources = [
    "src/direntry.rs",
    "src/hkdf.rs",
    "src/lib.rs",
    "src/proxy_filename.rs",
  ]
  edition = "2024"
  test_deps = [ "//third_party/rust_crates:hex" ]
  visibility = [
    ":*",
    "//src/storage/crypt/fxfs/common:*",
    "//src/storage/crypt/starnix:*",
    "//src/storage/f2fs_reader/*",
    "//src/storage/fxfs/*",
    "//src/storage/lib/block_server/vmo_backed:*",
    "//vendor/google/*",
  ]
  with_unit_tests = true
  deps = [
    "//src/storage/fxfs/unicode",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:base64",
    "//third_party/rust_crates:hmac",
    "//third_party/rust_crates:sha2",
    "//third_party/rust_crates:siphasher",
    "//third_party/rust_crates:zerocopy",
  ]
}
