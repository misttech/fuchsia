load("//build/bazel/rules/rust:defs.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "blob-writer",
    srcs = [
        "src/errors.rs",
        "src/lib.rs",
    ],
    edition = "2024",
    test_deps = [
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-sync",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:rand",
    ],
    visibility = [
        "//src/connectivity/policy/http-client:__pkg__",
        "//src/storage/benchmarks/fuchsia:__pkg__",
        "//src/storage/fshost/integration:__pkg__",
        "//src/storage/fxfs/platform:__pkg__",
        "//src/storage/fxfs/test:__pkg__",
        "//src/storage/lib/fs_management/rust:__pkg__",
        "//src/storage/stress-tests/blobfs:__pkg__",
        "//src/sys/lib/fidl-fuchsia-pkg-ext:__pkg__",
        "//src/sys/pkg/testing/blobfs-ramdisk:__pkg__",
        "//src/sys/pkg/tests/pkg-cache:__pkg__",
    ],
    with_unit_tests = True,
    deps = [
        "//sdk/rust/zx",
        "//src/lib/fidl/rust/fidl",
        "//src/storage/fxfs/fidl/fuchsia.fxfs:fuchsia.fxfs_rust",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)
