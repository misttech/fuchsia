import("//build/components.gni")
import("//build/rust/rustc_test.gni")

lib_srcs = [
  "src/buffer_allocator.rs",
  "src/buffer.rs",
  "src/fake_device.rs",
  "src/file_backed_device.rs",
  "src/lib.rs",
  "src/ranged_device.rs",
  "src/splittable_buffer.rs",
]

lib_deps = [
  "//src/lib/fuchsia-sync",
  "//src/storage/lib/block_protocol",
  "//src/storage/lib/buddy_allocator",
  "//src/storage/lib/ptr_slice",
  "//third_party/rust_crates:anyhow",
  "//third_party/rust_crates:async-trait",
  "//third_party/rust_crates:event-listener",
  "//third_party/rust_crates:futures",
  "//third_party/rust_crates:log",
  "//third_party/rust_crates:rand",
]

if (is_fuchsia) {
  lib_srcs += [
    "src/block_device.rs",
    "src/pinned_buffer_allocator.rs",
  ]
  lib_deps += [
    "//sdk/fidl/fuchsia.storage.block:fuchsia.storage.block_rust",
    "//sdk/rust/zx",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia-runtime",
    "//src/storage/lib/block_client/rust",
  ]
}

# The library is defined in BUILD.bazel. Its unit tests stay in GN because
# //sdk/lib/driver/fake-bti/rust has no Bazel build yet.
rustc_test("storage_device_test") {
  output_name = "storage_device_lib_test"
  edition = "2024"
  deps = lib_deps
  deps += [
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/storage/lib/block_client/rust:fake-block-client",
  ]
  if (is_fuchsia) {
    deps += [ "//sdk/lib/driver/fake-bti/rust" ]
  }
  sources = lib_srcs
}

fuchsia_component("storage-device-test") {
  testonly = true
  deps = [ ":storage_device_test" ]
  manifest = "meta/storage_device_test.cml"
}

fuchsia_test_package("storage-device-tests") {
  test_components = [ ":storage-device-test" ]
}

group("tests") {
  testonly = true
  deps = [ ":storage-device-tests" ]
}

