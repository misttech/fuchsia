import("//build/components.gni")
import("//build/rust/rustc_library.gni")

rustc_library("profile") {
  name = "storage_profile"
  edition = "2024"
  with_unit_tests = true

  sources = [ "src/lib.rs" ]

  deps = [
    "//sdk/rust/zx",
    "//src/storage/lib/ptr_slice",
    "//src/sys/pkg/lib/fuchsia-hash",
    "//third_party/rust_crates:arrayref",
  ]
  test_deps = [ "//src/lib/fuchsia" ]
}

fuchsia_unittest_package("storage-profile-tests") {
  deps = [ ":profile_test" ]
}

group("tests") {
  testonly = true
  deps = [ ":storage-profile-tests" ]
}
