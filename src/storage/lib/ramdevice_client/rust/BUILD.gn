  rustc_library("ramdevice_client") {
    sources = [ "src/lib.rs" ]
    edition = "2024"
    visibility = [
      ":*",
      "//src/storage/blackout/target/lib:*",
      "//src/storage/lib/blob_writer:*",
      "//src/storage/lib/fs_management/rust:*",
      "//src/storage/lib/ramdevice_client:*",
      "//vendor/google/*",
    ]
    deps = [
      "//sdk/fidl/fuchsia.hardware.ramdisk:fuchsia.hardware.ramdisk_rust",
      "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
      "//sdk/fidl/fuchsia.storage.block:fuchsia.storage.block_rust",
      "//sdk/rust/zx",
      "//src/lib/fidl/rust/fidl",
      "//src/lib/fuchsia-component/client",
      "//src/lib/fuchsia-fs",
      "//src/storage/lib/fs_management/rust:fs_management",
      "//third_party/rust_crates:anyhow",
    ]
  }
}
