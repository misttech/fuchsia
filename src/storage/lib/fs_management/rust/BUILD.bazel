load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

# This does not include any filesystems. Callers should depend on the
# filesystems they need.
#
# The unit tests (`:fs_management_test` and `:static-child-test`) stay in
# BUILD.gn because they depend on //src/storage/lib/ramdevice_client and
# //src/storage/testing:storage_driver_test_realm, which have no Bazel build
# yet.
rustc_library(
    name = "fs_management",
    srcs = [
        "src/error.rs",
        "src/filesystem.rs",
        "src/format.rs",
        "src/format/constants.rs",
        "src/lib.rs",
    ],
    edition = "2024",
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = [
        "//src/storage:__subpackages__",
        "//src/sys:__subpackages__",
        "//vendor/google:__subpackages__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.component.decl:fuchsia.component.decl_rust",
        "//sdk/fidl/fuchsia.component:fuchsia.component_rust",
        "//sdk/fidl/fuchsia.device:fuchsia.device_rust",
        "//sdk/fidl/fuchsia.fs:fuchsia.fs_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/fidl/fuchsia.storage.block:fuchsia.storage.block_rust",
        "//sdk/fidl/fuchsia.storage.partitions:fuchsia.storage.partitions_rust",
        "//sdk/rust/zx",
        "//src/lib/fdio/rust:fdio",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-component/client",
        "//src/lib/fuchsia-fs",
        "//src/lib/fuchsia-runtime",
        "//src/storage/fidl/fuchsia.fs.startup:fuchsia.fs.startup_rust",
        "//src/storage/lib/block_client/rust:block-client",  # @bazel2gn:path_overwrite://src/storage/lib/block_client/rust
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)
