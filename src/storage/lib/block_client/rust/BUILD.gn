import("//build/components.gni")
import("//build/rust/rustc_test.gni")
import("//src/storage/testing/driver_test_realm.gni")

group("rust") {
  public_deps = [ ":block-client" ]
}

# The libraries are defined in BUILD.bazel. The block-client unit tests stay
# in GN because //src/storage/lib/block_server and
# //src/storage/lib/ramdevice_client have no Bazel build yet.
rustc_test("block-client_test") {
  edition = "2024"
  output_name = "block_client_lib_test"
  deps = [
    "//sdk/fidl/fuchsia.storage.block:fuchsia.storage.block_rust",
    "//sdk/rust/zx",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-sync",
    "//src/storage/lib/block_protocol",
    "//src/storage/lib/block_server",
    "//src/storage/lib/ramdevice_client",
    "//src/storage/lib/trace",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:linked-hash-map",
    "//third_party/rust_crates:log",
  ]

  sources = [
    "src/cache.rs",
    "src/lib.rs",
  ]
}

# Uses GN-only storage_driver_test_realm_component template and wraps
# :block-client_test, which depends on //src/storage/lib/block_server and
# //src/storage/lib/ramdevice_client (not in Bazel yet).
storage_driver_test_realm_component("block-client-tests-component") {
  component_name = "block-client-tests"
  deps = [ ":block-client_test" ]
}

# Stays in GN with :block-client-tests-component and :block-client_test because
# //src/storage/lib/block_server and //src/storage/lib/ramdevice_client have no
# Bazel build yet.
fuchsia_test_package("block-client-tests") {
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
  test_components = [ ":block-client-tests-component" ]
}

group("tests") {
  testonly = true
  deps = [ ":block-client-tests" ]
}

