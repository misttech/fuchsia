  rustc_library("fake-block-client") {
    sources = [ "src/fake_block_client.rs" ]
    source_root = "src/fake_block_client.rs"
    edition = "2024"
    visibility = [
      ":*",
      "//src/storage/fvm:*",
      "//src/storage/lib/storage_device:*",
      "//vendor/google/*",
    ]
    deps = [
      ":block-client",
      "//sdk/fidl/fuchsia.storage.block:fuchsia.storage.block_rust",
      "//sdk/rust/zx",
      "//src/lib/fuchsia-sync",
    ]
  }
