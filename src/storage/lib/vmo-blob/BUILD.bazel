load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load("//build/bazel/rules/packages:fx_packaged_binary.bzl", "fx_packaged_binary")
load("//build/bazel/rules/rust:defs.bzl", "rustc_library", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "vmo-blob",
    srcs = ["src/lib.rs"],
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    visibility = ["//src/sys/pkg/lib/blobfs:__pkg__"],
    deps = [
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/rust/zx",
        "//src/storage/lib/vfs/rust:vfs",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:log",
    ],
)

# @bazel2gn:skip
rustc_test(
    name = "vmo-blob_test",
    crate = ":vmo-blob",
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    visibility = ["//visibility:private"],
    deps = [
        "//src/lib/fuchsia",
    ],
)

# @bazel2gn:skip
fx_packaged_binary(
    name = "vmo_blob_test_packaged_bin",
    testonly = True,
    binary = ":vmo-blob_test",
    binary_name = "vmo_blob_lib_test",
    visibility = ["//visibility:private"],
)

# @bazel2gn:skip
fx_component_manifest(
    name = "vmo-blob-tests-manifest",
    testonly = True,
    component_name = "vmo-blob-tests",
    includes = [
        "//sdk/lib/syslog:use.shard.cml",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/vmo_blob_tests.cml",
    visibility = ["//visibility:private"],
)

# @bazel2gn:skip
fx_test_component(
    name = "vmo-blob-tests-component",
    compiled_manifest = ":vmo-blob-tests-manifest",
    component_name = "vmo-blob-tests",
    visibility = ["//visibility:private"],
    deps = [
        ":vmo_blob_test_packaged_bin",
    ],
)

# @bazel2gn:skip
fx_package(
    name = "vmo-blob-tests-package",
    package_name = "vmo-blob-tests",
    test_components = [
        ":vmo-blob-tests-component",
    ],
    visibility = ["//visibility:private"],
)

# @bazel2gn:skip
fx_test(
    name = "vmo-blob-tests",
    max_log_severity = "ERROR",
    package = ":vmo-blob-tests-package",
    visibility = ["//visibility:public"],
)
