load("//build/bazel/rules/rust:defs.bzl", "rustc_library", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "vmo-blob",
    srcs = ["src/lib.rs"],
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    visibility = [
        "//src/storage/lib/blob_pager_and_verifier:__pkg__",
        "//src/sys/pkg/lib/blobfs:__pkg__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/rust/zx",
        "//src/storage/lib/vfs/rust:vfs",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:log",
    ],
)

# @bazel2gn:skip
rustc_test(
    name = "vmo-blob_test",
    crate = ":vmo-blob",
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    visibility = ["//visibility:private"],
    deps = [
        "//src/lib/fuchsia",
    ],
)

# @bazel2gn:skip
fx_unittest_package(
    name = "vmo-blob-tests",
    max_log_severity = "ERROR",
    unit_tests = [":vmo-blob_test"],
    visibility = ["//visibility:public"],
)
