# On Fuchsia, `:vfs` is a Rust dylib (libvfs_rust.so) shared by all the
# components that use it. Rust dylibs are only supported on Fuchsia, so on
# host it is a regular Rust library.
alias(
    name = "vfs",
    actual = select({
        "@platforms//os:fuchsia": ":vfs_dylib",
        "//conditions:default": ":vfs_host",
    }),
    visibility = ["//visibility:public"],
)

# NOTE: This does not depend on the log crate on purpose. Doing so would make
# this dylib the source of the global logger, which can cause problems for
# things that dynamically link Rust libraries (like drivers) and cause link
# errors at worst, or incorrect log attribution at best.
rustc_dylib(
    name = "vfs_dylib",
    srcs = _SRCS,
    build_flags = ["//build/config/rust:bootfs"],
    crate_name = "vfs",
    edition = "2024",
    output_name = "vfs_rust",
    proc_macro_deps = _COMMON_PROC_MACRO_DEPS,
    public_deps = [
        # TODO(https://fxbug.dev/42137337): Figure out why this is not properly
        # propagated to dependents in GN.
        #
        # Without this public dep, libtrace-engine doesn't seem to be properly
        # propagated to dependents even it's a transitive dependency. E.g. There's
        # the following dep path.
        #
        #   //src/storage/lib/vfs/rust:vfs_dylib --[public]-->
        #   //src/storage/lib/vfs/rust:vfs_dylib.actual --[private]-->
        #   //src/storage/lib/trace:trace --[public]-->
        #   //src/storage/lib/trace:trace.actual --[private]-->
        #   //src/lib/trace/rust:trace --[public]-->
        #   //src/lib/trace/rust:trace.actual --[private]-->
        #   //zircon/system/ulib/trace-engine:trace-engine
        #
        "//zircon/system/ulib/trace-engine",
    ],
    target_compatible_with = ["@platforms//os:fuchsia"],
    test_deps = _COMMON_TEST_DEPS + _FUCHSIA_TEST_DEPS + [
        "//src/testing/fidl:placeholders_rust_flex",
        "//third_party/rust_crates/vendor:log",
    ],
    version = "0.1.0",
    visibility = [":__pkg__"],
    with_unit_tests = True,
    deps = _COMMON_DEPS + _FUCHSIA_DEPS,
)

# Statically linked version of the vfs.
#
# Filesystems interact frequently with the vfs. Due to this heavy usage,
# linking them against the dynamically linked vfs introduces significant
# performance overhead. To avoid this, filesystems should use this static
# version. Other components should use the dynamically linked vfs.
rustc_library(
    name = "vfs_static",
    srcs = _SRCS,
    build_flags = ["//build/config/rust:bootfs"],
    crate_features = ["use_log"],
    crate_name = "vfs",
    edition = "2024",
    # Keeps the GN output at its pre-migration path (libvfs_rust.rlib). With a
    # different name, a stale libvfs_rust.rlib left in incremental GN build
    # directories would also match rustc's search for the `vfs` crate.
    output_name = "vfs_rust",
    proc_macro_deps = _COMMON_PROC_MACRO_DEPS,
    target_compatible_with = ["@platforms//os:fuchsia"],
    version = "0.1.0",
    visibility = [
        "//src/storage/fxfs:__subpackages__",
        "//src/storage/lib/pseudo_fs:__subpackages__",
    ],
    deps = _COMMON_DEPS + _FUCHSIA_DEPS + [
        "//third_party/rust_crates/vendor:log",
    ],
)

rustc_library(
    name = "vfs_host",
    srcs = _SRCS,
    crate_features = [
        "use_log",
        "fdomain",
    ],
    crate_name = "vfs",
    edition = "2024",
    proc_macro_deps = _COMMON_PROC_MACRO_DEPS,
    target_compatible_with = HOST_OS_CONSTRAINTS,
    test_deps = _COMMON_TEST_DEPS + [
        "//src/lib/fdomain/local",
        "//src/lib/fdomain/local:local_fdomain_flex",
        "//src/lib/fuchsia-fs:fuchsia-fs_fdomain",
        "//src/testing/fidl:placeholders_rust_fdomain_flex",
    ],
    version = "0.1.0",
    # Use `:vfs` instead.
    #
    # Before the Bazel migration, the GN host library had a visibility
    # allowlist to avoid proliferation of host users. That can't be expressed
    # here: dependents go through the `:vfs` alias, which must be public for
    # Fuchsia users, and Bazel's `visibility` attribute is not configurable, so
    # the alias can't use a different allowlist on host. Restricting this
    # target doesn't help either, since Bazel checks its visibility against
    # the alias's package, not the package that depends on the alias.
    visibility = [":__pkg__"],
    with_unit_tests = True,
    deps = _COMMON_DEPS + [
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust_fdomain_flex",
        "//src/lib/fdomain/client:flex_fdomain",
        "//third_party/rust_crates/vendor:log",
    ],
)
