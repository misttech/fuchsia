import("//build/components.gni")

fuchsia_unittest_package("vfs-tests") {
  deps = [ ":vfs_dylib_test" ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}

group("tests") {
  testonly = true
  deps = [
    ":vfs-tests",
    ":vfs_host_test($host_toolchain)",
    "name:tests",
  ]
}

