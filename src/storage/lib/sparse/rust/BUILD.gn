import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("lib") {
  sources = [
    "src/builder.rs",
    "src/format.rs",
    "src/lib.rs",
    "src/reader.rs",
  ]
  crate_name = "sparse"
  edition = "2024"
  version = "0.1.0"
  visibility = [
    ":*",
    "//src/developer/ffx/lib/fastboot:*",
    "//src/developer/ffx/lib/fastboot/interface:*",
    "//src/developer/ffx/plugins/emulator/engines:*",
    "//src/developer/ffx/plugins/target/fastboot:*",
    "//src/storage/ext4/lib/ext4_extract:*",
    "//src/storage/fxfs/make-blob-image:*",
    "//src/storage/fxfs/tools:*",
    "//tools/make-fuchsia-vol:*",
  ]
  deps = []
  deps += [
    "//third_party/rust_crates:bincode",
    "//third_party/rust_crates:byteorder",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:serde",
    "//third_party/rust_crates:static_assertions",
    "//third_party/rust_crates:tempfile",
    "//third_party/rust_crates:thiserror",
  ]
  if (is_fuchsia) {
    deps += [ "//sdk/rust/zx" ]
  }
}
if (is_fuchsia) {
  rustc_test("sparse_lib_test") {
    sources = [
      "src/builder.rs",
      "src/format.rs",
      "src/lib.rs",
      "src/reader.rs",
    ]
    edition = "2024"
    deps = []
    deps += [
      "//third_party/rust_crates:bincode",
      "//third_party/rust_crates:byteorder",
      "//third_party/rust_crates:log",
      "//third_party/rust_crates:serde",
      "//third_party/rust_crates:static_assertions",
      "//third_party/rust_crates:tempfile",
      "//third_party/rust_crates:thiserror",
    ]
    if (is_fuchsia) {
      deps += [ "//sdk/rust/zx" ]
    }
    deps += [ "//third_party/rust_crates:rand" ]
    testonly = true
  }
}

fuchsia_component_manifest("sparse-test-manifest") {
  testonly = true
  component_name = "sparse-test"
  manifest = "meta/sparse_test.cml"
}

fuchsia_test_component("sparse-test-component") {
  cm_label = ":sparse-test-manifest"
  component_name = "sparse-test"
  deps = [ ":sparse_lib_test" ]
}

fuchsia_test_package("sparse-test-package") {
  package_name = "sparse-test-gn"
  test_components = [ ":sparse-test-component" ]
}
