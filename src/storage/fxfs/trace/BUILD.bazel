load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "wrap_host_rust_test")
load("//build/bazel/rules/rust:defs.bzl", "rustc_library", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "trace",
    srcs = ["src/lib.rs"],
    crate_name = "fxfs_trace",
    edition = "2024",
    proc_macro_deps = ["//src/storage/fxfs/trace/macros:fxfs_trace_macros"],
    visibility = ["//src/storage/fxfs:__subpackages__"],
    deps = ["//src/storage/lib/trace"],
)

# The tests run through Bazel only, via the //src/storage test suites.
# @bazel2gn:skip
rustc_test(
    name = "fxfs-trace-tests",
    srcs = ["tests/compile_tests.rs"],
    crate_root = "tests/compile_tests.rs",
    edition = "2024",
    deps = [
        ":trace",
        "//src/lib/fuchsia",
    ],
)

# @bazel2gn:skip
wrap_host_rust_test(
    name = "fxfs-trace-host-tests",
    binary_name = "fxfs-trace-tests",
    visibility = ["//src/storage:__pkg__"],
)

# TODO(https://fxbug.dev/574121341): Run this test in GN too.
# @bazel2gn:skip
fx_unittest_package(
    name = "fxfs-trace-tests-package",
    package_name = "fxfs-trace-tests",
    unit_tests = [":fxfs-trace-tests"],
    visibility = ["//src/storage:__pkg__"],
)
