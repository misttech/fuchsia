import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("unicode") {
  sources = [
    "src/lib.rs",
    "src/lookup.rs",
    "src/nfd.rs",
  ]
  crate_name = "fxfs_unicode"
  edition = "2024"
  visibility = [
    ":*",
    "//src/starnix/kernel/core:*",
    "//src/storage/fxfs/*",
    "//src/storage/lib/fscrypt:*",
  ]
  deps = [
    ":types",
    ":unicode_gen",
    "//src/storage/type-fprint:fprint",
    "//third_party/rust_crates:arbitrary",
    "//third_party/rust_crates:serde",
    "//third_party/rust_crates:smallvec",
  ]
}

rustc_library("unicode_gen") {
  sources = [ "${target_gen_dir}/unicode_gen.rs" ]
  source_root = "${target_gen_dir}/unicode_gen.rs"
  non_rust_deps = [ ":generate_unicode_gen" ]
  edition = "2024"
  deps = [ ":types" ]
}

compiled_action("generate_unicode_gen") {
  sources = [ "//prebuilt/third_party/ucd/UCD.zip" ]
  outputs = [ "$target_gen_dir/unicode_gen.rs" ]
  args = [
    rebase_path("//prebuilt/third_party/ucd/UCD.zip", root_build_dir),
    rebase_path("$target_gen_dir/unicode_gen.rs", root_build_dir),
  ]
  tool = ":unicode_gen_builder"
}
if (is_host) {
  rustc_test("fxfs_unicode_test") {
    sources = [
      "src/lib.rs",
      "src/lookup.rs",
      "src/nfd.rs",
    ]
    non_rust_deps = [ ":ucd_zip" ]
    edition = "2024"
    rustenv = [ "UCD_ZIP=" + rebase_path("//prebuilt/third_party/ucd/UCD.zip",
                                         root_build_dir) ]
    deps = [
      ":types",
      ":unicode_gen",
      "//src/storage/type-fprint:fprint",
      "//third_party/rust_crates:arbitrary",
      "//third_party/rust_crates:regex",
      "//third_party/rust_crates:serde",
      "//third_party/rust_crates:smallvec",
      "//third_party/rust_crates:zip",
    ]
  }
}
if (is_host) {
  rustc_binary("unicode_gen_builder") {
    sources = [ "src/generator.rs" ]
    source_root = "src/generator.rs"
    edition = "2024"
    deps = [
      ":types",
      "//third_party/rust_crates:regex",
      "//third_party/rust_crates:zip",
    ]
  }
}

rustc_library("types") {
  sources = [ "src/types.rs" ]
  source_root = "src/types.rs"
  edition = "2024"
}
