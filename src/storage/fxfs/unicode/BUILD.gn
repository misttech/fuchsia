import("//build/testing/host_test_data.gni")

if (is_host) {
  host_test_data("ucd_zip") {
    sources = [ "//prebuilt/third_party/ucd/UCD.zip" ]
  }
}

group("tests") {
  testonly = true
  deps = [ ":fxfs_unicode_test($host_toolchain)" ]
}

