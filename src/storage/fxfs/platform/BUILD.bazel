# @bazel2gn:transformer=deps
_PLATFORM_PROC_MACRO_DEPS = [
    "//src/storage/fxfs:fxfs_macros",
    "//third_party/rust_crates/vendor:async-trait",
]

# @bazel2gn:transformer=deps
_PLATFORM_LINK_DEPS = [
    "//third_party/zstd",
]

# The unit tests (`:platform_test`) stay in BUILD.gn because they depend on
# //src/storage/blobfs/bin:blobfs-component, which has no Bazel build yet, and
# are packaged by //src/storage/fxfs:fxfs-tests.
rustc_library(
    name = "platform",
    srcs = _PLATFORM_SRCS,
    crate_name = "fxfs_platform",
    edition = "2024",
    link_deps = _PLATFORM_LINK_DEPS,
    proc_macro_deps = _PLATFORM_PROC_MACRO_DEPS,
    visibility = [
        "//src/storage/f2fs_reader/migrate:__pkg__",
        "//src/storage/fxfs:__subpackages__",
    ],
    deps = _PLATFORM_DEPS,
)

rustc_library(
    name = "platform_testing",
    testonly = True,
    srcs = _PLATFORM_SRCS,
    crate_features = ["testing"],
    crate_name = "fxfs_platform_testing",
    edition = "2024",
    link_deps = _PLATFORM_LINK_DEPS,
    proc_macro_deps = _PLATFORM_PROC_MACRO_DEPS,
    deps = _PLATFORM_DEPS + [
        "//src/storage/crypt/fxfs/common:lib",
        "//src/storage/fxfs/crypto/insecure",
    ],
)

rustc_library(
    name = "fxfs-testing",
    testonly = True,
    srcs = ["src/testing.rs"],
    crate_features = ["testing"],
    crate_root = "src/testing.rs",
    edition = "2024",
    visibility = [
        "//sdk/lib/zxio/tests:__pkg__",
        "//src/starnix/kernel/core:__pkg__",
        "//src/starnix/modules/overlayfs:__pkg__",
        "//src/storage/conformance/conformance_harness/fxfs:__pkg__",
    ],
    deps = [":platform_testing"],
)
