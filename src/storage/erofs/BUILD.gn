import("//build/bazel/bazel_test_suite.gni")
import("//build/components.gni")

bazel_test_suite("erofs-tests") {
  target_tests = [ "//src/storage/erofs:erofs-tests" ]
}

fuchsia_unittest_package("erofs-tests-gn") {
  deps = [
    ":erofs_test",
    "testing:simple_erofs_image",
    "testing:simple_raw_files",
  ]
}

group("tests") {
  testonly = true
  deps = [
    ":erofs-tests",
    ":erofs-tests-gn",
    "component:tests",
    "serializer:tests",
  ]
}

