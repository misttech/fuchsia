import("//build/components.gni")
import("//build/components/fuchsia_unittest_component.gni")
import("//build/rust/rustc_test.gni")

# The library is defined in BUILD.bazel. Its unit tests stay in GN because
# //src/storage/lib/block_server/vmo_backed:test_vmo_backed_block_server has no
# Bazel build yet.
rustc_test("lib_test") {
  output_name = "starnix_crypt_lib_test"
  edition = "2024"
  deps = [
    "//sdk/fidl/fuchsia.hardware.inlineencryption:fuchsia.hardware.inlineencryption_rust",
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//sdk/fidl/fuchsia.storage.block:fuchsia.storage.block_rust",
    "//sdk/rust/zx",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-sync",
    "//src/starnix/lib/linux_uapi",
    "//src/starnix/lib/starnix_uapi",
    "//src/storage/fxfs/crypto",
    "//src/storage/fxfs/fidl/fuchsia.fxfs:fuchsia.fxfs_rust",
    "//src/storage/lib/block_client/rust",
    "//src/storage/lib/block_server/vmo_backed:test_vmo_backed_block_server",
    "//src/storage/lib/fscrypt",
    "//src/storage/lib/storage_device",
    "//third_party/rust_crates:aes-gcm-siv",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:assert_matches",
    "//third_party/rust_crates:async-trait",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:hkdf",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:rand",
    "//third_party/rust_crates:sha2",
  ]
  sources = [ "src/lib.rs" ]
}

# The unit test component and package stay in GN because :lib_test depends on
# //src/storage/lib/block_server/vmo_backed:test_vmo_backed_block_server, which
# has no Bazel build yet.
fuchsia_unittest_component("starnix-crypt-test") {
  deps = [ ":lib_test" ]
}

# Stays in GN with :starnix-crypt-test and :lib_test until
# //src/storage/lib/block_server/vmo_backed:test_vmo_backed_block_server is in
# Bazel.
fuchsia_test_package("starnix-crypt-tests") {
  test_components = [ ":starnix-crypt-test" ]
}

group("tests") {
  testonly = true
  deps = [ ":starnix-crypt-tests" ]
}

