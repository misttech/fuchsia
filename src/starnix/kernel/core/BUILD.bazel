# In GN, //src/starnix/kernel/vdso and //src/storage/ext4/tests:test_img are
# resource() targets propagated to starnix_core_tests through deps.
# @bazel2gn:raw_attribute:deps += [ "//src/starnix/kernel/vdso", "//src/storage/ext4/tests:test_img" ]
rustc_test(
    name = "starnix_core_test",
    crate = ":core",
    crate_features = ["debug_and_trace_logs_enabled"] if (
        compilation_mode != "release" or
        starnix_enable_trace_and_debug_logs_in_release
    ) else [],
    crate_name = "starnix_core_lib_test",
    edition = "2024",
    # Linking the lib tests requires a lot of memory.
    # Notes: if (is_asan || target_cpu == "riscv64"), linking is known to
    # OOM on n2-standard-2.
    # For other configurations, building on n2-standard-8 is significantly
    # faster due to the memory usage.
    exec_properties = RBE_USE_LARGE_WORKER,
    link_deps = ["//src/starnix/kernel/syscall_loop:module_changes_breakpoint"],
    lint_config = "//src/starnix/config:starnix_clippy_lints_test",
    # TODO(https://fxbug.dev/42059075): Re-enable starnix in these environments.
    tags = [
        "exclude_toolchain_tags=asan",
        "exclude_toolchain_tags=hwasan",
    ],
    deps = [
        "//src/connectivity/lib/net-declare",
        "//src/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
        "//src/lib/fuchsia",
        "//src/lib/test_util",
        "//src/storage/fxfs/platform:fxfs-testing",
        "//src/storage/lib/block_server/vmo_backed",
        "//src/storage/lib/storage_device",
        "//src/sys/time/testing/fake-wake-alarms:lib",
        "//src/testing/fidl:placeholders_rust",
        "//third_party/rust_crates/vendor:maplit",
        "//third_party/rust_crates/vendor:test-case",
    ],
)

