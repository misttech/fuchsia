fx_component_manifest(
    name = "starnix_core_tests-manifest",
    testonly = True,
    component_name = "starnix_core_tests",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/starnix:unit_test.shard.cml",
    ],
    manifest = "meta/starnix_core_tests.cml",
)

fx_test_component(
    name = "starnix_core_tests-component",
    compiled_manifest = ":starnix_core_tests-manifest",
    component_name = "starnix_core_tests",
    test_type = "starnix",
    deps = [
        ":starnix_core_test_packaged_bin",
        ":test_files",
        "//src/starnix/examples/hello_starnix:hello_starnix_bin",
        "//src/starnix/kernel/vdso",
        "//src/storage/ext4/tests:test_img",
    ],
)

fx_package(
    name = "starnix_core_tests-package",
    package_name = "starnix_core_tests",
    test_components = [":starnix_core_tests-component"],
)

fx_test(
    name = "starnix_core_tests",
    # Tests exercise failure cases, so ERROR logs are expected.
    max_log_severity = "ERROR",
    package = ":starnix_core_tests-package",
)
