import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_test("remote_unified_aspace_tests") {
  sources = [ "remote_unified_aspace_tests.rs" ]
  source_root = "remote_unified_aspace_tests.rs"
  edition = "2024"
  exclude_toolchain_tags = [
    "asan",
    "hwasan",
  ]
  deps = [
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//sdk/fidl/fuchsia.unknown:fuchsia.unknown_rust",
    "//sdk/rust/zx",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/starnix/kernel/core",
    "//src/starnix/lib/starnix_types",
    "//src/starnix/lib/starnix_uapi",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:smallvec",
  ]
}

fuchsia_component_manifest("remote_unified_aspace_tests-manifest") {
  testonly = true
  component_name = "remote_unified_aspace_tests"
  manifest = "meta/remote_unified_aspace_tests.cml"
}

fuchsia_test_component("remote_unified_aspace_tests-component") {
  cm_label = ":remote_unified_aspace_tests-manifest"
  component_name = "remote_unified_aspace_tests"
  test_type = "starnix"
  deps = [
    ":remote_unified_aspace_tests",
    "//src/starnix/kernel/vdso",
  ]
}

fuchsia_test_package("remote_unified_aspace_tests-package") {
  package_name = "remote_unified_aspace_tests-gn"
  test_components = [ ":remote_unified_aspace_tests-component" ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}
