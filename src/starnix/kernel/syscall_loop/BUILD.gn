static_library("restricted_trampoline") {
  if (current_cpu == "arm64") {
    sources = [ "src/trampoline_arm64.S" ]
  } else if (current_cpu == "riscv64") {
    sources = [ "src/trampoline_riscv64.S" ]
  } else if (current_cpu == "x64") {
    sources = [ "src/trampoline_x64.S" ]
  }
  deps = [ "//src/starnix/lib/asm_utils" ]
}

static_library("module_changes_breakpoint") {
  if (current_cpu == "arm64") {
    sources = [ "src/breakpoint_arm64.S" ]
  } else if (current_cpu == "riscv64") {
    sources = [ "src/breakpoint_riscv64.S" ]
  } else if (current_cpu == "x64") {
    sources = [ "src/breakpoint_x64.S" ]
  }
  deps = [ "//src/starnix/lib/asm_utils" ]
  visibility = [
    ":*",
    "//src/starnix/kernel/core:*",
  ]
}

