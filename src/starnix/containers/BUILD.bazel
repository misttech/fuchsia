load("@fuchsia_rules_common//packages:resources.bzl", "resource")
load(":linux_resource.bzl", "linux_resource")

package(default_applicable_licenses = ["//:license"])

exports_files(
    [
        "container.shard.cml",
        "container_config.shard.cml",
    ],
    visibility = [
        "//src/starnix:__subpackages__",
        "//vendor/google:__subpackages__",
    ],
)

# LINT.IfChange
# The default init executable. Used if the starnix kernel configuration has no
# init.
linux_resource(
    name = "default_init",
    src = "//src/starnix/containers/default_init",
    dest = "data/init",
    visibility = [
        "//src/starnix/containers:__subpackages__",
        "//src/starnix/kernel:__pkg__",
        "//src/starnix/tests/selinux/userspace:__pkg__",
        "//vendor/google:__subpackages__",
    ],
)

# This target creates a placeholder in data/tmp, allowing the tests to mount
# things there.
resource(
    name = "data_tmp_target",
    src = "placeholder",
    dest = "data/tmp/.placeholder",
    visibility = ["//src/starnix/containers/debian:__pkg__"],
)
# LINT.ThenChange(BUILD.gn)
