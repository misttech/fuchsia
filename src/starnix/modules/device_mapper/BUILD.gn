import("//build/components.gni")
import("//build/rust/rustc_library.gni")

group("tests") {
  testonly = true
  deps = [ ":starnix-device-mapper-tests" ]
}

rustc_library("device_mapper") {
  name = "starnix-modules-device_mapper"
  edition = "2024"
  with_unit_tests = true

  # TODO(https://fxbug.dev/42059075): Re-enable starnix in these environments.
  exclude_toolchain_tags = [
    "asan",
    "hwasan",
  ]

  source_root = "lib.rs"
  sources = [ source_root ]

  configs += [ "//src/starnix/build:kernel_library_config" ]

  visibility = [ "//src/starnix/modules/*" ]

  deps = [
    "//src/lib/mundane",
    "//src/starnix/kernel/core",
    "//src/starnix/lib/linux_uapi",
    "//src/starnix/lib/starnix_ext",
    "//src/starnix/lib/starnix_logging",
    "//src/starnix/lib/starnix_sync",
    "//src/starnix/lib/starnix_syscalls",
    "//src/starnix/lib/starnix_uapi",
    "//src/storage/lib/dm_verity",
    "//third_party/rust_crates:bitflags",
  ]

  test_deps = [ "//src/lib/fuchsia" ]
}

fuchsia_unittest_package("starnix-device-mapper-tests") {
  manifest = "meta/starnix_device_mapper_tests.cml"
  deps = [ ":device_mapper_test" ]
  test_type = "starnix"
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}
