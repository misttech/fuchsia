import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("device_mapper") {
  sources = [ "lib.rs" ]
  crate_name = "starnix_modules_device_mapper"
  source_root = "lib.rs"
  edition = "2024"
  lint_config = "//src/starnix/build:kernel_library_config"
  visibility = [
    ":*",
    "//src/starnix/modules:*",
  ]
  deps = [
    "//src/lib/mundane",
    "//src/starnix/kernel/core",
    "//src/starnix/lib/linux_uapi",
    "//src/starnix/lib/starnix_ext",
    "//src/starnix/lib/starnix_logging",
    "//src/starnix/lib/starnix_sync",
    "//src/starnix/lib/starnix_syscalls",
    "//src/starnix/lib/starnix_uapi",
    "//src/storage/lib/dm_verity",
    "//third_party/rust_crates:bitflags",
  ]
}

rustc_test("device_mapper_test") {
  sources = [ "lib.rs" ]
  source_root = "lib.rs"
  edition = "2024"
  deps = [
           "//src/lib/mundane",
           "//src/starnix/kernel/core",
           "//src/starnix/lib/linux_uapi",
           "//src/starnix/lib/starnix_ext",
           "//src/starnix/lib/starnix_logging",
           "//src/starnix/lib/starnix_sync",
           "//src/starnix/lib/starnix_syscalls",
           "//src/starnix/lib/starnix_uapi",
           "//src/storage/lib/dm_verity",
           "//third_party/rust_crates:bitflags",
         ] + [ "//src/lib/fuchsia" ]
  lint_config = "//src/starnix/config:starnix_clippy_lints_test"
  exclude_toolchain_tags = [
    "asan",
    "hwasan",
  ]
  output_name = "starnix_modules_device_mapper_lib_test"
}

fuchsia_component_manifest("starnix-device-mapper-tests-manifest") {
  testonly = true
  component_name = "starnix-device-mapper-tests"
  manifest = "meta/starnix_device_mapper_tests.cml"
}

fuchsia_test_component("starnix-device-mapper-tests-component") {
  cm_label = ":starnix-device-mapper-tests-manifest"
  component_name = "starnix-device-mapper-tests"
  test_type = "starnix"
  deps = [
    ":device_mapper_test",
    "//src/starnix/kernel/vdso",
  ]
}

fuchsia_test_package("starnix-device-mapper-tests-package") {
  package_name = "starnix-device-mapper-tests-gn"
  test_components = [ ":starnix-device-mapper-tests-component" ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}
