load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load(
    "//build/bazel/rules/packages:fx_package.bzl",
    "fx_package",
)

package(default_applicable_licenses = ["//:license"])

exports_files(
    [
        "meta/backlight.core_shard.cml",
        "meta/display.core_shard.cml",
        "meta/nanohub.core_shard.cml",
        "meta/sockettunnel.core_shard.cml",
    ],
    visibility = ["//bundles/assembly:__subpackages__"],
)

# google_display

fx_package(
    name = "google_display",
    package_name = "google_display",
    components = [
        ":google_display_component",
    ],
    visibility = ["//bundles/assembly:__subpackages__"],
)

fx_component(
    name = "google_display_component",
    compiled_manifest = ":google_display_manifest",
    component_name = "google_display",
)

fx_component_manifest(
    name = "google_display_manifest",
    component_name = "google_display",
    includes = [
        "//sdk/lib/syslog:client.shard",
    ],
    manifest = "meta/display.cml",
)

