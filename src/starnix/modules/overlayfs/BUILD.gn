import("//build/components.gni")
import("//build/rust/rustc_library.gni")

group("tests") {
  testonly = true
  deps = [ ":starnix-overlayfs-tests" ]
}

rustc_library("overlayfs") {
  name = "starnix-modules-overlayfs"
  edition = "2024"
  version = "0.1.0"
  source_root = "lib.rs"
  with_unit_tests = true

  sources = [ "lib.rs" ]

  # TODO(https://fxbug.dev/42059075): Re-enable starnix in these environments.
  exclude_toolchain_tags = [
    "asan",
    "hwasan",
  ]

  configs += [ "//src/starnix/build:kernel_library_config" ]

  visibility = [ "//src/starnix/modules/*" ]

  deps = [
    "//src/lib/fuchsia-rcu",
    "//src/starnix/kernel/core",
    "//src/starnix/lib/starnix_logging",
    "//src/starnix/lib/starnix_sync",
    "//src/starnix/lib/starnix_uapi",
    "//src/starnix/lib/syncio",
    "//third_party/rust_crates:once_cell",
    "//third_party/rust_crates:rand",
  ]

  test_deps = [
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//sdk/rust/zx",
    "//src/lib/fuchsia",
    "//src/storage/fxfs/platform:fxfs-testing",
    "//src/storage/lib/storage_device",
  ]
}

fuchsia_unittest_package("starnix-overlayfs-tests") {
  manifest = "meta/starnix_overlayfs_tests.cml"
  deps = [ ":overlayfs_test" ]
  test_type = "starnix"
}
