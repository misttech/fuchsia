import("//build/components.gni")
import("//build/rust/rustc_library.gni")

rustc_library("power_residency") {
  name = "starnix-modules-power-residency"
  edition = "2024"
  version = "0.1.0"
  source_root = "lib.rs"
  with_unit_tests = true

  # TODO(https://fxbug.dev/42059075): Re-enable starnix in these environments.
  exclude_toolchain_tags = [
    "asan",
    "hwasan",
  ]

  sources = [ "lib.rs" ]

  configs += [ "//src/starnix/build:kernel_library_config" ]

  visibility = [ "//src/starnix/modules/*" ]

  deps = [
    "//sdk/fidl/fuchsia.hardware.power.stats:fuchsia.hardware.power.stats_rust",
    "//src/starnix/kernel/core",
    "//src/starnix/lib/starnix_logging",
    "//src/starnix/lib/starnix_uapi",
  ]

  test_deps = [
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//third_party/rust_crates:futures",
  ]
}

group("tests") {
  testonly = true
  deps = [ ":starnix-power-residency-tests" ]
}

fuchsia_unittest_package("starnix-power-residency-tests") {
  manifest = "meta/starnix_power_residency_tests.cml"
  deps = [ ":power_residency_test" ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
  test_type = "starnix"
}
