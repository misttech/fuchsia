import("//build/components.gni")

# Keep perfetto_consumer_tests in GN because exclude_toolchain_tags cannot be
# expressed on Bazel fx_test and the unit test depends on
# //zircon/system/ulib/trace-test-utils which is not yet migrated to Bazel.
fuchsia_unittest_package("perfetto_consumer_tests") {
  package_name = "perfetto_consumer_tests"
  manifest = "meta/perfetto_consumer_tests.cml"
  deps = [ ":perfetto_consumer_test" ]
  test_type = "starnix"
}

group("tests") {
  testonly = true
  deps = [
    ":perfetto_consumer_tests",
    "lib/perfetto:tests",
  ]
}

