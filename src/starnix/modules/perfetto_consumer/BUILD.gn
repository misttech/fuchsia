rustc_library("perfetto_consumer") {
  sources = [
    "atrace.rs",
    "blob_sink.rs",
    "lib.rs",
    "packet_forwarder.rs",
    "testing.rs",
  ]
  crate_name = "starnix_modules_perfetto_consumer"
  source_root = "lib.rs"
  edition = "2024"
  lint_config = "//src/starnix/build:kernel_library_config"
  visibility = [
    ":*",
    "//src/starnix/modules:*",
  ]
  deps = [
    "//sdk/rust/zx",
    "//src/lib/trace/rust:trace",
    "//src/lib/trace/rust:trace-observer",
    "//src/performance/lib/fxt/rust",
    "//src/starnix/kernel/core",
    "//src/starnix/lib/starnix_logging",
    "//src/starnix/lib/starnix_uapi",
    "//src/starnix/modules/perfetto_consumer/lib/perfetto",
    "//src/starnix/modules/perfetto_consumer/lib/perfetto:perfetto_protos",
    "//src/starnix/modules/perfetto_consumer/lib/perfetto:perfetto_trace_protos",
    "//src/starnix/modules/perfetto_consumer/lib/perfetto/trace_decoder",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
  ]
  with_unit_tests = true
  exclude_toolchain_tags = [
    "asan",
    "hwasan",
  ]
  test_deps = [
    "//src/lib/fuchsia",
    "//zircon/system/ulib/trace-test-utils",
  ]
}
