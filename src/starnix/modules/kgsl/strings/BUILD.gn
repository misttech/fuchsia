group("strings") {
  public_deps = [ ":kgsl_strings" ]
}

copy("copy_lib") {
  visibility = [ ":*" ]
  sources = [ "lib.rs" ]
  outputs = [ "$target_gen_dir/{{source_file_part}}" ]
}

