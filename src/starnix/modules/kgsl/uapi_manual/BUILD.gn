import("//build/compiled_action.gni")
import("//build/testing/golden_files.gni")

group("uapi_manual") {
  public_deps = [ ":check_golden" ]
}

compiled_action("do_codegen") {
  tool = ":kgsl_codegen"
  input_path = "//src/starnix/lib/linux_uapi/src/arm64.rs"
  output_path = "$target_gen_dir/arm_manual_kgsl.rs"
  args = [
    rebase_path(input_path, root_build_dir),
    rebase_path(output_path, root_build_dir),
  ]
  inputs = [ input_path ]
  outputs = [ output_path ]
}

golden_files("check_golden") {
  comparisons = [
    {
      golden = "//src/starnix/lib/linux_uapi/src/arm_manual_kgsl.rs"
      candidate = "$target_gen_dir/arm_manual_kgsl.rs"
    },
  ]
  deps = [ ":do_codegen" ]
}

