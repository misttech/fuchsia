if (is_host) {
  rustc_binary("kgsl_codegen") {
    sources = [ "main.rs" ]
    source_root = "main.rs"
    edition = "2024"
    lint_config = "//src/starnix/build:kernel_library_config"
    deps = [
      "//third_party/rust_crates:anyhow",
      "//third_party/rust_crates:syn",
    ]
  }
}
