import("//build/components.gni")
import("//build/rust/rustc_test.gni")

# Kept hand-written in GN: the unit tests use the starnix unit test runner
# and must stay out of the asan and hwasan variants
# (`exclude_toolchain_tags`), which Bazel cannot express yet.
rustc_test("input_report_event_conversion_test") {
  output_name = "starnix_modules_input_report_event_conversion_lib_test"
  edition = "2024"
  source_root = "lib.rs"

  sources = [
    "consumer_control.rs",
    "keyboard.rs",
    "lib.rs",
    "mouse.rs",
    "touch.rs",
  ]

  deps = [
    "//sdk/fidl/fuchsia.input:fuchsia.input_rust",
    "//sdk/fidl/fuchsia.input.report:fuchsia.input.report_rust",
    "//sdk/rust/zx",
    "//src/lib/collections/sorted-vec-map",
    "//src/lib/fuchsia",
    "//src/starnix/lib/starnix_types",
    "//src/starnix/lib/starnix_uapi",
    "//src/starnix/modules/input/event_conversion/app_event_conversion",
    "//third_party/rust_crates:bit-vec",
  ]

  # TODO(https://fxbug.dev/42059075): Re-enable starnix in these environments.
  exclude_toolchain_tags = [
    "asan",
    "hwasan",
  ]
}

fuchsia_unittest_package("starnix-input-report-event-conversion-tests") {
  manifest = "meta/starnix_input_report_event_conversion_tests.cml"
  deps = [ ":input_report_event_conversion_test" ]
}

group("tests") {
  testonly = true
  deps = [ ":starnix-input-report-event-conversion-tests" ]
}

