import("//build/components.gni")
import("//build/rust/rustc_test.gni")

# Kept hand-written in GN: the unit tests use the starnix unit test runner
# and must stay out of the asan and hwasan variants
# (`exclude_toolchain_tags`), which Bazel cannot express yet.
rustc_test("event_conversion_test") {
  output_name = "starnix_modules_input_event_conversion_lib_test"
  edition = "2024"
  source_root = "lib.rs"

  sources = [
    "button_fuchsia_to_linux.rs",
    "key_fuchsia_to_linux.rs",
    "key_linux_to_fuchsia.rs",
    "keymap.rs",
    "lib.rs",
    "mouse_fuchsia_to_linux.rs",
    "touch_fuchsia_to_linux.rs",
    "touch_linux_to_fuchsia.rs",
  ]

  deps = [
    "//sdk/fidl/fuchsia.input:fuchsia.input_rust",
    "//sdk/fidl/fuchsia.input.report:fuchsia.input.report_rust",
    "//sdk/fidl/fuchsia.ui.input:fuchsia.ui.input_rust",
    "//sdk/fidl/fuchsia.ui.input3:fuchsia.ui.input3_rust",
    "//sdk/fidl/fuchsia.ui.pointer:fuchsia.ui.pointer_rust",
    "//sdk/fidl/fuchsia.ui.test.input:fuchsia.ui.test.input_rust",
    "//sdk/rust/zx",
    "//src/lib/collections/sorted-vec-map",
    "//src/starnix/lib/starnix_logging",
    "//src/starnix/lib/starnix_types",
    "//src/starnix/lib/starnix_uapi",
    "//third_party/rust_crates:assert_matches",
    "//third_party/rust_crates:bit-vec",
    "//third_party/rust_crates:pretty_assertions",
    "//third_party/rust_crates:test-case",
    "//third_party/rust_crates:thiserror",
  ]

  # TODO(https://fxbug.dev/42059075): Re-enable starnix in these environments.
  exclude_toolchain_tags = [
    "asan",
    "hwasan",
  ]
}

fuchsia_unittest_package("starnix-input-event-conversion-tests") {
  manifest = "meta/starnix_input_event_conversion_tests.cml"
  deps = [ ":event_conversion_test" ]
}

group("tests") {
  testonly = true
  deps = [ ":starnix-input-event-conversion-tests" ]
}

