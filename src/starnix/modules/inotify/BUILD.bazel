load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "inotify",
    srcs = [
        "inotify.rs",
        "lib.rs",
        "syscalls.rs",
    ],
    crate_name = "starnix_modules_inotify",
    crate_root = "lib.rs",
    edition = "2024",
    lint_config = "//src/starnix/build:kernel_library_config",
    visibility = [
        "//src/starnix/kernel/syscall_loop:__pkg__",
        "//src/starnix/modules:__pkg__",
    ],
    deps = [
        "//src/starnix/kernel/core",
        "//src/starnix/lib/starnix_sync",
        "//src/starnix/lib/starnix_syscalls",
        "//src/starnix/lib/starnix_uapi",
        "//third_party/rust_crates/vendor:zerocopy",
    ],
)

rustc_test(
    name = "inotify_test",
    crate = ":inotify",
    crate_name = "starnix_modules_inotify_lib_test",
    edition = "2024",
    lint_config = "//src/starnix/build:kernel_library_config",
    # TODO(https://fxbug.dev/42059075): Re-enable starnix in these environments.
    tags = [
        "exclude_toolchain_tags=asan",
        "exclude_toolchain_tags=hwasan",
    ],
    deps = ["//src/lib/fuchsia"],
)

fx_packaged_binary(
    name = "inotify_test_packaged_bin",
    testonly = True,
    binary = ":inotify_test",
    binary_name = "starnix_modules_inotify_lib_test",
)

fx_component_manifest(
    name = "starnix-inotify-tests-manifest",
    testonly = True,
    component_name = "starnix-inotify-tests",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/starnix:unit_test.shard.cml",
    ],
    manifest = "meta/starnix_inotify_tests.cml",
)

fx_test_component(
    name = "starnix-inotify-tests-component",
    compiled_manifest = ":starnix-inotify-tests-manifest",
    component_name = "starnix-inotify-tests",
    test_type = "starnix",
    deps = [
        ":inotify_test_packaged_bin",
        # In GN, //src/starnix/kernel/vdso is a resource() propagated through
        # //src/starnix/kernel/core's deps.
        "//src/starnix/kernel/vdso",
    ],
)

fx_package(
    name = "starnix-inotify-tests-package",
    package_name = "starnix-inotify-tests",
    test_components = [":starnix-inotify-tests-component"],
)

fx_test(
    name = "starnix-inotify-tests",
    package = ":starnix-inotify-tests-package",
)
