import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("inotify") {
  sources = [
    "inotify.rs",
    "lib.rs",
    "syscalls.rs",
  ]
  crate_name = "starnix_modules_inotify"
  source_root = "lib.rs"
  edition = "2024"
  lint_config = "//src/starnix/build:kernel_library_config"
  visibility = [
    ":*",
    "//src/starnix/kernel/syscall_loop:*",
    "//src/starnix/modules:*",
  ]
  deps = [
    "//src/starnix/kernel/core",
    "//src/starnix/lib/starnix_sync",
    "//src/starnix/lib/starnix_syscalls",
    "//src/starnix/lib/starnix_uapi",
    "//third_party/rust_crates:zerocopy",
  ]
}

rustc_test("inotify_test") {
  sources = [
    "inotify.rs",
    "lib.rs",
    "syscalls.rs",
  ]
  source_root = "lib.rs"
  edition = "2024"
  deps = [
           "//src/starnix/kernel/core",
           "//src/starnix/lib/starnix_sync",
           "//src/starnix/lib/starnix_syscalls",
           "//src/starnix/lib/starnix_uapi",
           "//third_party/rust_crates:zerocopy",
         ] + [ "//src/lib/fuchsia" ]
  output_name = "starnix_modules_inotify_lib_test"
  lint_config = "//src/starnix/build:kernel_library_config"
  exclude_toolchain_tags = [
    "asan",
    "hwasan",
  ]
}

fuchsia_component_manifest("starnix-inotify-tests-manifest") {
  testonly = true
  component_name = "starnix-inotify-tests"
  manifest = "meta/starnix_inotify_tests.cml"
}

fuchsia_test_component("starnix-inotify-tests-component") {
  cm_label = ":starnix-inotify-tests-manifest"
  component_name = "starnix-inotify-tests"
  test_type = "starnix"
  deps = [
    ":inotify_test",
    "//src/starnix/kernel/vdso",
  ]
}

fuchsia_test_package("starnix-inotify-tests-package") {
  package_name = "starnix-inotify-tests-gn"
  test_components = [ ":starnix-inotify-tests-component" ]
}
