import("//build/rust/rustc_library.gni")

rustc_library("serial") {
  name = "starnix-modules-serial"
  edition = "2024"
  version = "0.1.0"
  source_root = "lib.rs"

  sources = [ "lib.rs" ]

  configs += [ "//src/starnix/build:kernel_library_config" ]

  visibility = [ "//src/starnix/modules/*" ]

  deps = [
    "//sdk/fidl/fuchsia.hardware.serial:fuchsia.hardware.serial_rust",
    "//sdk/rust/zx",
    "//src/lib/fidl/rust/fidl",
    "//src/starnix/kernel/core",
    "//src/starnix/lib/starnix_uapi",
    "//src/starnix/modules/devpts",
    "//third_party/rust_crates:anyhow",
  ]
}
