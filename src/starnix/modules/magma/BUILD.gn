import("//build/components.gni")
import("//build/rust/rustc_library.gni")

rustc_library("magma") {
  name = "starnix-modules-magma"
  edition = "2024"
  version = "0.1.0"
  source_root = "lib.rs"
  with_unit_tests = true

  # TODO(https://fxbug.dev/297311726): Re-enable starnix in these environments.
  exclude_toolchain_tags = [
    "asan",
    "hwasan",
  ]

  sources = [
    "ffi.rs",
    "file.rs",
    "gpu_class_directory.rs",
    "image_file.rs",
    "init.rs",
    "lib.rs",
    "magma.rs",
  ]

  configs += [ "//src/starnix/build:kernel_library_config" ]

  visibility = [ "//src/starnix/modules/*" ]

  deps = [
    "//sdk/fidl/fuchsia.gpu.magma:fuchsia.gpu.magma_rust",
    "//sdk/fidl/fuchsia.logger:fuchsia.logger_rust",
    "//sdk/fidl/fuchsia.power.broker:fuchsia.power.broker_rust",
    "//sdk/fidl/fuchsia.ui.composition:fuchsia.ui.composition_rust",
    "//sdk/rust/zx",
    "//src/graphics/lib/magma/src/libmagma",
    "//src/lib/fdio/rust:fdio",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//src/starnix/kernel/core",
    "//src/starnix/lib/magma",
    "//src/starnix/lib/starnix_crypto",
    "//src/starnix/lib/starnix_lifecycle",
    "//src/starnix/lib/starnix_logging",
    "//src/starnix/lib/starnix_sync",
    "//src/starnix/lib/starnix_syscalls",
    "//src/starnix/lib/starnix_types",
    "//src/starnix/lib/starnix_uapi",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:argh",
    "//third_party/rust_crates:bstr",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:itertools",
    "//third_party/rust_crates:zerocopy",
  ]

  test_deps = [
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
  ]
}

group("tests") {
  testonly = true
  deps = [ ":starnix-magma-tests" ]
}

fuchsia_unittest_package("starnix-magma-tests") {
  manifest = "meta/starnix_magma_tests.cml"
  deps = [ ":magma_test" ]
  test_type = "starnix"
}
