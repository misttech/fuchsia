import("//build/components.gni")
import("//build/rust/rustc_library.gni")

group("tests") {
  testonly = true
  deps = [ ":starnix-mmcblk-stub-tests" ]
}

rustc_library("mmcblk_stub") {
  name = "starnix-modules-mmcblk-stub"
  edition = "2024"
  version = "0.1.0"
  source_root = "lib.rs"
  with_unit_tests = true

  # TODO(https://fxbug.dev/42059075): Re-enable starnix in these environments.
  exclude_toolchain_tags = [
    "asan",
    "hwasan",
  ]

  sources = [ "lib.rs" ]

  configs += [ "//src/starnix/build:kernel_library_config" ]

  visibility = [ "//src/starnix/modules/*" ]

  deps = [
    "//src/starnix/kernel/core",
    "//src/starnix/lib/starnix_logging",
    "//src/starnix/lib/starnix_uapi",
  ]

  test_deps = [ "//src/lib/fuchsia" ]
}

fuchsia_unittest_package("starnix-mmcblk-stub-tests") {
  manifest = "meta/starnix_mmcblk_stub_tests.cml"
  deps = [ ":mmcblk_stub_test" ]
  test_type = "starnix"
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}
