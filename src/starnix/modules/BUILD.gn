import("//build/rust/rustc_library.gni")

group("tests") {
  testonly = true
  deps = [
    "android_usb:tests",
    "binderfs:tests",
    "boot:tests",
    "cgroupfs:tests",
    "devpts:tests",
    "ext4:tests",
    "fastrpc:tests",
    "functionfs:tests",
    "inotify:tests",
    "input:tests",
    "kgsl:tests",
    "layeredfs:tests",
    "loop:tests",
    "nanohub:tests",
    "nmfs:tests",
    "odpm:tests",
    "perfetto_consumer:tests",
    "power_residency:tests",
    "selinuxfs:tests",
    "syscalls:tests",
    "tracefs:tests",
  ]
}

rustc_library("modules") {
  name = "starnix-modules"
  edition = "2024"
  version = "0.1.0"
  source_root = "lib.rs"

  sources = [ "lib.rs" ]

  configs += [ "//src/starnix/build:kernel_library_config" ]

  visibility = [ "//src/starnix/kernel/runner/*" ]

  deps = [
    "//src/lib/diagnostics/inspect/rust",
    "//src/starnix/kernel/core",
    "//src/starnix/lib/starnix_logging",
    "//src/starnix/lib/starnix_uapi",
    "//src/starnix/modules/android_usb",
    "//src/starnix/modules/ashmem",
    "//src/starnix/modules/binderfs",
    "//src/starnix/modules/boot",
    "//src/starnix/modules/cgroupfs",
    "//src/starnix/modules/consent_sync",
    "//src/starnix/modules/debugfs",
    "//src/starnix/modules/device_mapper",
    "//src/starnix/modules/devpts",
    "//src/starnix/modules/erofs",
    "//src/starnix/modules/ext4",
    "//src/starnix/modules/fastrpc",
    "//src/starnix/modules/framebuffer",
    "//src/starnix/modules/functionfs",
    "//src/starnix/modules/fuse",
    "//src/starnix/modules/gpu",
    "//src/starnix/modules/gralloc",
    "//src/starnix/modules/hvdcp_opti:hvdcp_opti_module",
    "//src/starnix/modules/inotify",
    "//src/starnix/modules/input",
    "//src/starnix/modules/kgsl",
    "//src/starnix/modules/layeredfs",
    "//src/starnix/modules/loop",
    "//src/starnix/modules/magma",
    "//src/starnix/modules/nanohub",
    "//src/starnix/modules/nmfs",
    "//src/starnix/modules/odpm",
    "//src/starnix/modules/overlayfs",
    "//src/starnix/modules/perfetto_consumer",
    "//src/starnix/modules/power_residency",
    "//src/starnix/modules/procfs",
    "//src/starnix/modules/pstore",
    "//src/starnix/modules/rtc",
    "//src/starnix/modules/selinuxfs",
    "//src/starnix/modules/thermal",
    "//src/starnix/modules/touch_power_policy",
    "//src/starnix/modules/tracefs",
    "//src/starnix/modules/tun",
    "//src/starnix/modules/wakeup_test",
    "//src/starnix/modules/zram",
    "//third_party/rust_crates:anyhow",
  ]
}
