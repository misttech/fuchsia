}

fuchsia_component_manifest("starnix-thermal-module-tests-manifest") {
  testonly = true
  component_name = "starnix-thermal-module-tests"
  manifest = "meta/starnix_thermal_module_tests.cml"
}

fuchsia_test_component("starnix-thermal-module-tests-component") {
  cm_label = ":starnix-thermal-module-tests-manifest"
  component_name = "starnix-thermal-module-tests"
  test_type = "starnix"
  deps = [
    ":thermal_test",
    "//src/starnix/kernel/vdso",
  ]
}

fuchsia_test_package("starnix-thermal-module-tests-package") {
  package_name = "starnix-thermal-module-tests-gn"
  test_components = [ ":starnix-thermal-module-tests-component" ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}
