import("//build/components.gni")

group("tests") {
  testonly = true

  deps = [ ":starnix_kernel_manager-tests" ]
}

# starnix_kernel_manager-tests cannot be migrated to Bazel yet due to
# //src/starnix/kernel/core's GN-only //src/starnix/kernel/vdso runtime
# dependency.
fuchsia_unittest_package("starnix_kernel_manager-tests") {
  deps = [ ":kernel_manager_test" ]
  manifest = "meta/kernel_manager_tests.cml"
}

