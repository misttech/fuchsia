{
    offer: [
        {
            config: "fuchsia.starnix.config.container.ExtraFeatures",
            from: "#config",
            to: "#core",
        },
        {
            config: "fuchsia.starnix.config.Prefetch",
            from: "#config",
            to: "#core",
        },
        {
            config: [
                "fuchsia.kernel.oom.CriticalMb",
                "fuchsia.kernel.oom.OutOfMemoryMb",
                "fuchsia.kernel.oom.WarningMb",
            ],
            from: "#config",
            to: "#core",
            availability: "optional",
        },
        {
            config: "fuchsia.starnix.runner.EnableDataCollection",
            from: "#config",
            to: "#core",
        },
    ],
}
