import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("devicetree") {
  sources = [
    "src/lib.rs",
    "src/parser.rs",
    "src/types.rs",
  ]
  crate_name = "devicetree"
  edition = "2024"
  version = "0.1.0"
  with_unit_tests = true
  deps = [ "//third_party/rust_crates:zerocopy" ]
}
