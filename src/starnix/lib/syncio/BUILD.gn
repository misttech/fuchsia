import("//build/components.gni")

group("tests") {
  testonly = true
  deps = [ ":starnix_syncio-tests" ]
}

fuchsia_unittest_package("starnix_syncio-tests") {
  manifest = "meta/syncio_tests.cml"
  deps = [ ":syncio_test" ]
}

# zxio is C++, so every binary that links syncio also needs the C++ standard
# library. Bazel's C++ toolchain adds it at link time, but GN links Rust
# binaries with rustc and needs the dynamic_cpp_standard_library config on
# each of them. The generated rustc_library below can only list zxio as a
# private dep, which would stop zxio_static's public configs at syncio, so
# BUILD.bazel maps its zxio dep to this group, which forces the config onto
# all dependents.
group("zxio_static") {
  visibility = [ ":*" ]
  public_deps = [ "//sdk/lib/zxio:zxio_static" ]
  all_dependent_configs =
      [ "//build/config/fuchsia:dynamic_cpp_standard_library" ]
}

