import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("syncio") {
  sources = [
    "src/lib.rs",
    "src/zxio.rs",
  ]
  edition = "2024"
  link_deps = [ ":zxio_static" ]
  lint_config = "//src/starnix/build:kernel_library_config"
  test_deps = [
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-fs",
    "//third_party/rust_crates:anyhow",
  ]
  visibility = [
    ":*",
    "//sdk/lib/zxio/tests:*",
    "//src/starnix/kernel/core:*",
    "//src/starnix/lib/*",
    "//src/starnix/modules/fuse:*",
    "//src/starnix/modules/overlayfs:*",
    "//src/storage/lib/sync_io_client:*",
  ]
  with_unit_tests = true
  deps = [
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//sdk/fidl/fuchsia.net:fuchsia.net_rust",
    "//sdk/rust/zx",
    "//src/lib/fidl/rust/fidl",
    "//third_party/rust_crates:bitflags",
    "//third_party/rust_crates:bstr",
    "//third_party/rust_crates:pin-weak",
    "//third_party/rust_crates:zerocopy",
  ]
}
