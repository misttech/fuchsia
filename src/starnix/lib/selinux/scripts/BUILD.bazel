load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_py_test.bzl", "host_py_test")
load("//build/bazel/rules/host_tests:host_test_data.bzl", "host_test_data_files")

package(default_applicable_licenses = ["//:license"])

host_test_data_files(
    name = "merge_policies_testdata",
    srcs = [
        "//src/starnix/lib/selinux:testdata/scripts/merge_policies/a_policy.conf",
        "//src/starnix/lib/selinux:testdata/scripts/merge_policies/b_policy.conf",
        "//src/starnix/lib/selinux:testdata/scripts/merge_policies/golden_a_b_policy.conf",
        "//src/starnix/lib/selinux:testdata/scripts/merge_policies/invalid_policy.conf",
    ],
    dest_dir = "testdata/scripts/merge_policies",
    target_compatible_with = HOST_OS_CONSTRAINTS,
)

host_test_data_files(
    name = "merge_policies_initial_sids",
    srcs = [
        "//src/starnix/lib/selinux:testdata/composite_policies/initial_sids",
    ],
    dest_dir = "testdata/scripts/merge_policies",
    target_compatible_with = HOST_OS_CONSTRAINTS,
)

host_py_test(
    name = "merge_policies_test",
    srcs = [
        "merge_policies.py",
        "merge_policies_test.py",
    ],
    imports = ["."],
    main = "merge_policies_test.py",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    test_args = [
        "--testdata-dir",
        "testdata/scripts/merge_policies",
    ],
    test_data = [
        ":merge_policies_initial_sids",
        ":merge_policies_testdata",
    ],
)

host_py_test(
    name = "verify_or_compile_policy_test",
    srcs = [
        "merge_policies.py",
        "verify_or_compile_policy.py",
        "verify_or_compile_policy_test.py",
    ],
    imports = ["."],
    main = "verify_or_compile_policy_test.py",
    target_compatible_with = HOST_OS_CONSTRAINTS,
)
