# --- Handle Unknown Variants ---

foreach(mode,
        [
          "allow",
          "deny",
          "reject",
        ]) {
  sestarnix_test_policy("handle_unknown_policy-$mode") {
    output_name = "handle_unknown_policy-$mode"
    prebuilt = "composite_policies/compiled/handle_unknown_policy-$mode"
    handle_unknown = mode
    base_policy = false
    test_policy = false
    fragments = [ "composite_policies/new_file/handle_unknown_policy.conf" ]
  }
}

# --- Standalone / Legacy Micro Policies (Single .conf file) ---

