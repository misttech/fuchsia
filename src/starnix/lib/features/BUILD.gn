rustc_library("starnix_features") {
  sources = [ "src/lib.rs" ]
  crate_name = "starnix_features"
  edition = "2024"
  lint_config = "//src/starnix/build:kernel_library_config"
  proc_macro_deps = [ "//third_party/rust_crates:strum_macros" ]
  with_unit_tests = true
  deps = [
    "//third_party/rust_crates:strum",
    "//third_party/rust_crates:thiserror",
  ]
}
