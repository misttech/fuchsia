    "src/file_mode.rs",
    "src/fs_type.rs",
    "src/inotify_mask.rs",
    "src/iptables_flags.rs",
    "src/kcmp.rs",
    "src/lib.rs",
    "src/math.rs",
    "src/mount_flags.rs",
    "src/open_flags.rs",
    "src/personality.rs",
    "src/range_ext.rs",
    "src/resource_limits.rs",
    "src/restricted_aspace.rs",
    "src/seal_flags.rs",
    "src/selinux.rs",
    "src/signals.rs",
    "src/syslog.rs",
    "src/termios.rs",
    "src/uapi.rs",
    "src/union.rs",
    "src/unmount_flags.rs",
    "src/user_address.rs",
    "src/user_value.rs",
    "src/version.rs",
    "src/vfs.rs",
  ]
  if (current_cpu == "x64") {
    sources += [ "src/x64.rs" ]
  } else if (current_cpu == "arm64") {
    sources += [
      "src/arm.rs",
      "src/arm64.rs",
    ]
  } else if (current_cpu == "riscv64") {
    sources += [ "src/riscv64.rs" ]
  }
  crate_name = "starnix_uapi"
  edition = "2024"
  lint_config = "//src/starnix/build:kernel_library_config"
  test_deps = [ "//src/lib/fuchsia" ]
  version = "0.1.0"
  visibility = [
    ":*",
    "//src/starnix/kernel/*",
    "//src/starnix/lib/*",
    "//src/starnix/modules/*",
    "//src/starnix/runner/lib/kernel_manager:*",
    "//src/starnix/tests/selinux/bench:*",
    "//src/storage/crypt/starnix:*",
  ]
  with_unit_tests = true
  deps = [
    "//sdk/rust/zx-status",
    "//sdk/rust/zx-types",
    "//src/lib/diagnostics/inspect/contrib/stubs:inspect_stubs",
    "//src/lib/fuchsia-rcu",
    "//src/starnix/lib/atomic_bitflags",
    "//src/starnix/lib/linux_uapi",
    "//src/starnix/lib/range_map",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:bitflags",
    "//third_party/rust_crates:bstr",
    "//third_party/rust_crates:ref-cast",
    "//third_party/rust_crates:static_assertions",
    "//third_party/rust_crates:zerocopy",
  ]
}
