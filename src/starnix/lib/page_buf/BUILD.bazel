load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load("//build/bazel/rules/packages:fx_packaged_binary.bzl", "fx_packaged_binary")
load("//build/bazel/rules/rust:defs.bzl", "rustc_library", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "page_buf",
    srcs = ["src/lib.rs"],
    edition = "2024",
    lint_config = "//src/starnix/build:kernel_library_config",
    visibility = ["//src/starnix/kernel/core:__pkg__"],
    deps = [
        "//sdk/rust/zx",
        "//src/lib/fuchsia-runtime",
    ],
)

# The unit tests are declared separately instead of with `with_unit_tests`
# because Bazel would apply the library's `lint_config`, which includes the
# production-only lints, to the test code as well.
rustc_test(
    name = "page_buf_lib_test",
    srcs = ["src/lib.rs"],
    edition = "2024",
    lint_config = "//src/starnix/config:starnix_clippy_lints_test",
    deps = [
        "//sdk/rust/zx",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-runtime",
    ],
)

fx_packaged_binary(
    name = "page_buf_lib_test_packaged_bin",
    testonly = True,
    binary = ":page_buf_lib_test",
    binary_name = "page_buf_lib_test",
)

fx_component_manifest(
    name = "page_buf_tests-manifest",
    testonly = True,
    component_name = "page_buf_tests",
    includes = [
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/starnix:unit_test.shard.cml",
    ],
    manifest = "meta/page_buf_tests.cml",
)

fx_test_component(
    name = "page_buf_tests-component",
    compiled_manifest = ":page_buf_tests-manifest",
    component_name = "page_buf_tests",
    # Runs in the Starnix test realm, which provides the
    # `starnix_unit_test_runner` used by `unit_test.shard.cml`.
    test_type = "starnix",
    deps = [":page_buf_lib_test_packaged_bin"],
)

fx_package(
    name = "page_buf_tests-package",
    package_name = "page_buf_tests",
    test_components = [":page_buf_tests-component"],
)

fx_test(
    name = "page_buf_tests",
    package = ":page_buf_tests-package",
    visibility = ["//src/starnix/lib:__pkg__"],
)
