load("//build/bazel/rules/rust:defs.bzl", "rustc_library")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "seq_lock",
    srcs = ["src/lib.rs"],
    edition = "2024",
    lint_config = "//src/starnix/build:kernel_library_config",
    visibility = [
        "//src/starnix/kernel/core:__pkg__",
        "//src/starnix/modules/selinuxfs:__pkg__",
    ],
    with_unit_tests = True,
    deps = [
        "//sdk/rust/zx",
        "//src/lib/fuchsia-runtime",
        "//src/starnix/lib/starnix_logging",
        "//third_party/rust_crates/vendor:zerocopy",
    ],
)

fx_unittest_package(
    name = "seq_lock_tests",
    unit_tests = [":seq_lock_test"],
    visibility = ["//src/starnix/lib:__pkg__"],
)
