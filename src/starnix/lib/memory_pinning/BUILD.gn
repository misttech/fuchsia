import("//build/components.gni")

# Kept in GN because `memory_pinning` transitively depends on
# `//src/storage/lib/vfs/rust:vfs` (`rustc_dylib("vfs_dylib")`), which places
# two copies of `libvfs-<hash>.so` in Bazel `default_runfiles` and causes
# `fx_packaged_binary` + `fx_package` to fail with duplicate `lib/libvfs-*.so`.
fuchsia_unittest_package("memory_pinning_tests") {
  deps = [ ":memory_pinning_test" ]
  manifest = "meta/memory_pinning_tests.cml"
}

group("tests") {
  testonly = true
  deps = [ ":memory_pinning_tests" ]
}

