load("//build/bazel/rules/rust:defs.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "starnix_rcu",
    srcs = [
        "src/lib.rs",
        "src/rcu_atomic.rs",
        "src/rcu_cache.rs",
        "src/rcu_hash_map.rs",
        "src/rcu_string.rs",
        "src/rcu_vfs_conformance_tests.rs",
    ],
    edition = "2024",
    visibility = [
        "//examples/rcu:__pkg__",
        "//src/starnix/kernel/core:__pkg__",
        "//src/starnix/modules/android_usb:__pkg__",
    ],
    with_unit_tests = True,
    deps = [
        "//src/lib/fuchsia-rcu",
        "//src/lib/fuchsia-rcu-collections",
        "//src/lib/fuchsia-sync",
        "//src/starnix/lib/starnix_sync",
        "//src/starnix/lib/starnix_types",
        "//third_party/rust_crates/vendor:rapidhash",
    ],
)
