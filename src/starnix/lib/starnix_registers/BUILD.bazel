load("//build/bazel/rules/rust:defs.bzl", "rustc_library")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "starnix_registers",
    srcs = ["src/lib.rs"] + select({
        "@platforms//cpu:x86_64": ["src/x64.rs"],
        "@platforms//cpu:arm64": ["src/arm64.rs"],
        "@platforms//cpu:riscv64": ["src/riscv64.rs"],
    }),
    edition = "2024",
    visibility = [
        "//src/starnix/kernel/core:__pkg__",
        "//src/starnix/kernel/syscall_loop:__pkg__",
    ],
    # @bazel2gn:skip
    with_unit_tests = True,
    deps = [
        "//sdk/rust/zx",
        "//src/lib/fuchsia-runtime",
        "//src/lib/trace/rust:trace",
        "//src/starnix/lib/starnix_logging",
        "//src/starnix/lib/starnix_uapi",
        "//third_party/rust_crates/vendor:memoffset",
    ],
)

# @bazel2gn:skip
fx_unittest_package(
    name = "starnix_registers_tests",
    unit_tests = [":starnix_registers_test"],
    visibility = ["//src/starnix/lib:__pkg__"],
)
