import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("starnix_registers") {
  sources = []
  sources += [ "src/lib.rs" ]
  if (current_cpu == "x64") {
    sources += [ "src/x64.rs" ]
  } else if (current_cpu == "arm64") {
    sources += [ "src/arm64.rs" ]
  } else if (current_cpu == "riscv64") {
    sources += [ "src/riscv64.rs" ]
  }
  edition = "2024"
  visibility = [
    ":*",
    "//src/starnix/kernel/core:*",
    "//src/starnix/kernel/syscall_loop:*",
  ]
  with_unit_tests = true
  deps = [
    "//sdk/rust/zx",
    "//src/lib/fuchsia-runtime",
    "//src/lib/trace/rust:trace",
    "//src/starnix/lib/starnix_logging",
    "//src/starnix/lib/starnix_uapi",
    "//third_party/rust_crates:memoffset",
  ]
}
fuchsia_unittest_package("starnix_registers_tests") {
  package_name = "starnix_registers_tests-gn"
  component_name = "starnix_registers_tests"
  deps = [ ":starnix_registers_test" ]
  visibility = [
    ":*",
    "//src/starnix/lib:*",
  ]
}
