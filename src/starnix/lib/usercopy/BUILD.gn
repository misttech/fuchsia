import("//build/tools/bazel2gn/bazel_migration.gni")

static_library("usercopy_cpp_reference_routines") {
  sources = [
    "hermetic_common.h",
    "hermetic_copy.cc",
    "hermetic_copy.h",
    "hermetic_copy_common.h",
    "hermetic_copy_until_null_byte.cc",
    "hermetic_copy_until_null_byte.h",
    "hermetic_zero.cc",
    "hermetic_zero.h",
  ]
  configs += [
    "//build/config:optimize_speed",
    "//build/config:frame_pointers",
    ":leaf-frame-pointer",
  ]
}
static_library("usercopy_assembly_routines") {
  if (current_cpu == "x64") {
    sources = [
      "arch/x64/atomic_compare_exchange.S",
      "arch/x64/atomic_error.S",
      "arch/x64/atomic_load.S",
      "arch/x64/atomic_store.S",
      "arch/x64/hermetic_copy.S",
      "arch/x64/hermetic_copy_error.S",
      "arch/x64/hermetic_copy_until_null_byte.S",
      "arch/x64/hermetic_zero.S",
    ]
  } else if (current_cpu == "arm64") {
    sources = [
      "arch/arm64/atomic_compare_exchange.S",
      "arch/arm64/atomic_error.S",
      "arch/arm64/atomic_load.S",
      "arch/arm64/atomic_store.S",
      "arch/arm64/hermetic_copy.S",
      "arch/arm64/hermetic_copy_error.S",
      "arch/arm64/hermetic_copy_until_null_byte.S",
      "arch/arm64/hermetic_zero.S",
    ]
  } else if (current_cpu == "riscv64") {
    sources = [
      "arch/riscv64/atomic_compare_exchange.S",
      "arch/riscv64/atomic_error.S",
      "arch/riscv64/atomic_load.S",
      "arch/riscv64/atomic_store.S",
      "arch/riscv64/hermetic_copy.S",
      "arch/riscv64/hermetic_copy_error.S",
      "arch/riscv64/hermetic_copy_until_null_byte.S",
      "arch/riscv64/hermetic_zero.S",
    ]
  }
}
rustc_library("usercopy") {
  sources = [ "src/lib.rs" ]
  crate_name = "usercopy"
  edition = "2024"
  link_deps = [ ":usercopy_assembly_routines" ]
  lint_config = "//src/starnix/build:kernel_library_config"
  test_deps = [
    "//src/lib/fuchsia",
    "//third_party/rust_crates:test-case",
  ]
  visibility = [
    ":*",
    "//src/starnix/kernel/core:*",
  ]
  with_unit_tests = true
  deps = [
    "//sdk/rust/zx",
    "//src/lib/fuchsia-runtime",
    "//third_party/rust_crates:zerocopy",
  ]
}
