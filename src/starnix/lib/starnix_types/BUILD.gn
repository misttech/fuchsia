rustc_library("starnix_types") {
  sources = [
    "src/arch.rs",
    "src/atomic.rs",
    "src/augmented.rs",
    "src/convert.rs",
    "src/errors.rs",
    "src/futex_address.rs",
    "src/lib.rs",
    "src/math.rs",
    "src/ownership.rs",
    "src/stats.rs",
    "src/string.rs",
    "src/thread_start_info.rs",
    "src/time.rs",
    "src/user_buffer.rs",
    "src/vfs.rs",
  ]
  edition = "2024"
  lint_config = "//src/starnix/build:kernel_library_config"
  test_deps = [ "//src/lib/fuchsia" ]
  visibility = [
    ":*",
    "//src/starnix/kernel/core/*",
    "//src/starnix/kernel/runner:*",
    "//src/starnix/lib/*",
    "//src/starnix/modules/*",
  ]
  with_unit_tests = true
  deps = [
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//sdk/fidl/fuchsia.starnix.binder:fuchsia.starnix.binder_rust",
    "//sdk/rust/zx",
    "//src/starnix/lib/linux_uapi",
    "//src/starnix/lib/starnix_uapi",
    "//src/starnix/lib/syncio",
    "//third_party/rust_crates:bstr",
    "//third_party/rust_crates:cfg-if",
    "//third_party/rust_crates:memoffset",
    "//third_party/rust_crates:smallvec",
    "//third_party/rust_crates:static_assertions",
    "//third_party/rust_crates:zerocopy",
  ]
}
