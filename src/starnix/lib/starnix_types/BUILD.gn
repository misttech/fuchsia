import("//build/components.gni")

fuchsia_unittest_package("starnix_types-tests") {
  deps = [ ":starnix_types_test" ]

  test_specs = {
    log_settings = {
      # Tests exercise failure cases, so ERROR logs are expected.
      max_severity = "ERROR"
    }
  }
}

group("tests") {
  testonly = true
  deps = [ ":starnix_types-tests" ]
}

