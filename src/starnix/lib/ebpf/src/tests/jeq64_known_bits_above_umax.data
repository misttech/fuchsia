# Verify 64-bit jeq constant-folds to false when operands have compatible known
# bits and overlapping urange ([2, 5] vs [4, 7]) whose bitwise OR exceeds umax.
-- mem
00 00
-- asm
ldxb %r3, [%r1]
ldxb %r4, [%r1+1]
and %r3, 5
or %r3, 2
jle %r3, 5, +2
mov %r0, 0
exit
and %r4, 3
or %r4, 4
jeq %r3, %r4, +2
mov %r0, 0
exit
stdw [%r3], 0
exit
-- result
0
