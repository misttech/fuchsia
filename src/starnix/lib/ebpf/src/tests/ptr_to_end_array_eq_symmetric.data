# Verify symmetric PtrToEndArray == PtrToArray equality comparison (jne fallthrough)
# updates array_bounds so packet/array reads within bounds succeed.
-- mem
11 11 11 11 11 11 11 11
-- asm
call 202
ldxdw %r2, [%r0+8]
ldxdw %r1, [%r0]
mov %r3, %r1
add %r3, 8
jne %r2, %r3, +2
ldxdw %r0, [%r3-8]
exit
mov %r0, 0
exit
-- result
0x1111111111111111
