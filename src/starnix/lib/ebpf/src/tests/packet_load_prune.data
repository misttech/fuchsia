# Two branches converge on a packet load (`ldpb +0`), differing in %r0 (which is overwritten by the
# load), a caller-saved scratch register (%r2), and an unused callee-saved register (%r8). Both
# branches satisfy the packet load's data dependencies (%r6 is the packet), so the second branch is
# pruned at the packet load and the program verifies and returns the loaded byte.
-- asm
mov %r6, %r1
ldxw %r7, [%r6]
jeq %r7, 0, +3
mov %r2, 1
mov %r8, 10
ja +3
mov %r0, %r6
mov %r2, 2
mov %r8, %r6
ldpb +0
exit
-- mem
00000000000000002a00000000000000
-- result
0x2a
