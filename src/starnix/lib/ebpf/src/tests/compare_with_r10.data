# Comparing directly against the read-only frame pointer %r10 in either src or
# dst position must not attempt to write refined constraints back into %r10, and
# equality constraints refine variable-offset stack pointers symmetrically.
-- asm
call 2
and %r0, 8
mov %r1, %r10
sub %r1, %r0
mov %r2, %r1
jne %r1, %r10, +5
jne %r10, %r2, +4
stdw [%r1-8], 0
stdw [%r2-8], 0x2a
ldxdw %r0, [%r10-8]
exit
mov %r0, 0
exit
-- result
0x2a
