# Verify MapValueParameter stack slots are tracked as data dependencies so
# pruned branches cannot leak spilled pointers into BPF maps.
-- asm
call 2
mov %r6, %r0
stdw [%r10-24], 0
stdw [%r10-8], 0
lddw %r1, map[2]
mov %r2, %r10
add %r2, -24
mov %r3, %r10
add %r3, -16
jne %r6, 0, +2
stdw [%r10-16], 0
ja +1
stxdw [%r10-16], %r10
call 110
mov %r0, 0
exit
-- error
reading non scalar value from the stack
