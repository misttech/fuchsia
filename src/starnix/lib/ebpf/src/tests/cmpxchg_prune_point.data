# Each cmpxchg branches into two states (r0 == dst and r0 != dst) that rejoin at the next
# instruction. Without marking the instruction following a 64-bit or 32-bit cmpxchg as a prune
# point, a straight-line sequence of 16 cmpxchg and 16 cmpxchg32 instructions without any jumps
# would explore 2^16 states per group and fail verification.
#
# The atomics target a map value, as atomic operations are allowed only on map values and the
# stack, and the content of a map value is unknown to the verifier.
-- asm
mov %r2, 0
stxw [%r10-4], %r2
lddw %r1, map[2]
mov %r2, %r10
add %r2, -4
call 109
jne %r0, 0, +2
mov %r0, 1
exit
mov %r1, %r0
mov %r2, 1
ldxdw %r0, [%r1]
lock cmpxchg [%r1], %r2
lock cmpxchg [%r1], %r2
lock cmpxchg [%r1], %r2
lock cmpxchg [%r1], %r2
lock cmpxchg [%r1], %r2
lock cmpxchg [%r1], %r2
lock cmpxchg [%r1], %r2
lock cmpxchg [%r1], %r2
lock cmpxchg [%r1], %r2
lock cmpxchg [%r1], %r2
lock cmpxchg [%r1], %r2
lock cmpxchg [%r1], %r2
lock cmpxchg [%r1], %r2
lock cmpxchg [%r1], %r2
lock cmpxchg [%r1], %r2
lock cmpxchg [%r1], %r2
lock cmpxchg32 [%r1], %r2
lock cmpxchg32 [%r1], %r2
lock cmpxchg32 [%r1], %r2
lock cmpxchg32 [%r1], %r2
lock cmpxchg32 [%r1], %r2
lock cmpxchg32 [%r1], %r2
lock cmpxchg32 [%r1], %r2
lock cmpxchg32 [%r1], %r2
lock cmpxchg32 [%r1], %r2
lock cmpxchg32 [%r1], %r2
lock cmpxchg32 [%r1], %r2
lock cmpxchg32 [%r1], %r2
lock cmpxchg32 [%r1], %r2
lock cmpxchg32 [%r1], %r2
lock cmpxchg32 [%r1], %r2
lock cmpxchg32 [%r1], %r2
mov %r0, 0
exit
-- result
0
