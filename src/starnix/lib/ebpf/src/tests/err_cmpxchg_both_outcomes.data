# The two outcomes of a cmpxchg are successors of the same state. The value loaded from the stack
# after the cmpxchg is either the stored byte (<= 255) or 1000, and the out of bound access at the
# end is only reachable in the second case when r2 == 0. Both outcomes must be explored for each
# incoming state: proving that one outcome terminates must not prune the other one.
-- asm
ldxb %r2, [%r1]
and %r2, 0xff
stxdw [%r10-8], %r2
mov %r0, 0
mov %r4, 1000
jeq %r2, 0, +2
mov %r7, 0
ja +1
mov %r7, 100
lock cmpxchg [%r10-8], %r4
ldxdw %r5, [%r10-8]
jgt %r5, 255, +2
mov %r0, 0
exit
mov %r3, %r1
add %r3, %r7
ldxb %r0, [%r3]
exit
-- mem
00000000000000000000000000000000
00000000000000000000000000000000
00000000000000000000000000000000
00000000000000000000000000000000
-- error
out of bound access
