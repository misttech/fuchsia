# A bounded loop with 1024 iterations. The loop counter is a known scalar that differs on each
# iteration, so the states of the iterations are incomparable and the loop is fully unrolled by
# the verifier. The memory access depends on the counter and is in bounds on every iteration.
-- asm
mov %r0, 0
mov %r6, 0
mov %r2, %r6
and %r2, 7
add %r2, %r1
ldxb %r3, [%r2]
add %r0, %r3
add %r6, 1
jlt %r6, 1024, -7
exit
-- mem
0102030405060708
-- result
0x1200
