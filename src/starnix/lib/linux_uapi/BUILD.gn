import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("linux_uapi") {
  sources = []
  sources += [
    "src/lib.rs",
    "src/macros.rs",
    "src/manual.rs",
    "src/types.rs",
  ]
  if (current_cpu == "x64") {
    sources += [
      "src/arch32_stub.rs",
      "src/x86_64.rs",
    ]
  } else if (current_cpu == "arm64") {
    sources += [
      "src/arm.rs",
      "src/arm64.rs",
      "src/arm_manual.rs",
      "src/arm_manual_kgsl.rs",
    ]
  } else if (current_cpu == "riscv64") {
    sources += [
      "src/arch32_stub.rs",
      "src/riscv64.rs",
    ]
  }
  crate_name = "linux_uapi"
  disable_clippy = true
  edition = "2024"
  lint_config = "//src/starnix/build:kernel_library_config"
  with_unit_tests = true
  deps = [
    "//third_party/rust_crates:static_assertions",
    "//third_party/rust_crates:zerocopy",
  ]
}
