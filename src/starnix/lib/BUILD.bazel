# Starnix library device tests defined in Bazel. These are exported to `fx test`
# and infra builders through //src/starnix:target_tests and
# //src/starnix/lib:tests.
test_suite(
    name = "target_tests",
    target_compatible_with = ["@platforms//os:fuchsia"],
    tests = [
        "//src/starnix/lib/crash_throttling:crash-throttling-tests",
        "//src/starnix/lib/ebpf:starnix-ebpf-tests",
        "//src/starnix/lib/page_buf:page_buf_tests",
        "//src/starnix/lib/paged_ring_buffer:starnix-paged-ring-buffer-tests",
        "//src/starnix/lib/selinux:starnix-selinux-unit-tests",
        "//src/starnix/lib/seq_lock:seq_lock_tests",
        "//src/starnix/lib/starnix_registers:starnix_registers_tests",
    ],
    visibility = ["//src/starnix:__pkg__"],
)
