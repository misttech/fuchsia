import("//build/components.gni")
import("//build/rust/rustc_library.gni")
import("//build/rust/rustc_test.gni")
import("remotevol_tests.gni")

group("tests") {
  testonly = true

  deps = [
    ":starnix_remotevol_in_process_integration_test",
    ":starnix_remotevol_key_file_integration_test",
    ":starnix_remotevol_shutdown_integration_test",
    "//src/starnix/tests/remotevol/rename:tests",
    "//src/starnix/tests/remotevol/stat:tests",
    "//src/starnix/tests/remotevol/symlinks:tests",
  ]
}

rustc_library("remotevol_fuchsia_test_util") {
  testonly = true
  name = "remotevol_fuchsia_test_util"
  edition = "2024"
  source_root = "lib/fuchsia.rs"
  sources = [ source_root ]
  deps = [
    "//sdk/fidl/fuchsia.component:fuchsia.component_rust",
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//src/lib/diagnostics/reader/rust",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component-test",
    "//src/lib/fuchsia-fs",
    "//third_party/rust_crates:log",
  ]
}

rustc_library("remotevol_linux_test_util") {
  testonly = true
  name = "remotevol_linux_test_util"
  edition = "2024"
  source_root = "lib/linux.rs"
  sources = [ source_root ]
  deps = [
    "//src/starnix/lib/linux_uapi",
    "//third_party/rust_crates:libc",
    "//third_party/rust_crates:zerocopy",
  ]
}

rustc_test("remotevol_shutdown_integration_test_bin") {
  edition = "2024"
  source_root = "src/shutdown.rs"
  sources = [ source_root ]
  deps = [
    ":remotevol_fuchsia_test_util",
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//src/lib/diagnostics/reader/rust",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-component-test",
    "//src/lib/fuchsia-fs",
    "//src/sys/lib/component-events",
    "//third_party/rust_crates:assert_matches",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
  ]
}

rustc_test("remotevol_key_file_integration_test_bin") {
  edition = "2024"
  source_root = "src/key_file.rs"
  sources = [ source_root ]
  deps = [
    ":remotevol_fuchsia_test_util",
    "//sdk/fidl/fuchsia.component:fuchsia.component_rust",
    "//src/lib/diagnostics/reader/rust",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-component",
    "//src/lib/fuchsia-component-test",
    "//src/lib/fuchsia-fs",
    "//src/storage/fxfs/test-fxfs/fidl/fuchsia.test.fxfs:fuchsia.test.fxfs_rust",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
  ]
}

rustc_test("remotevol_in_process_integration_test_bin") {
  edition = "2024"
  source_root = "src/in_process.rs"
  sources = [ source_root ]
  deps = [
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-component-test",
    "//src/lib/fuchsia-fs",
    "//src/sys/lib/component-events",
    "//third_party/rust_crates:assert_matches",
    "//third_party/rust_crates:log",
  ]
}

fuchsia_test_component("remotevol_shutdown_test") {
  manifest = "meta/shutdown_integration_test.cml"

  # fuchsia-component-test has an expect_includes on the realm_builder.shard.cml
  # but this test requires a persistent storage realm builder shard instead.
  check_includes = false
  deps = [ ":remotevol_shutdown_integration_test_bin" ]
  test_type = "starnix"
}

fuchsia_test_component("remotevol_key_file_test") {
  manifest = "meta/key_file_integration_test.cml"

  # fuchsia-component-test has an expect_includes on the realm_builder.shard.cml
  # but this test requires a persistent storage realm builder shard instead.
  check_includes = false
  deps = [ ":remotevol_key_file_integration_test_bin" ]
  test_type = "starnix"
}

fuchsia_test_component("remotevol_in_process_test") {
  manifest = "meta/in_process_integration_test.cml"

  # fuchsia-component-test has an expect_includes on the realm_builder.shard.cml
  # but this test requires a persistent storage realm builder shard instead.
  check_includes = false
  deps = [ ":remotevol_in_process_integration_test_bin" ]
  test_type = "starnix"
}

remotevol_tests_group("starnix_remotevol_shutdown_integration_test") {
  test_components = [ ":remotevol_shutdown_test" ]
  kernel_base_manifest = "meta/kernel_with_container.base.cml"
  subpackages = [
    "//src/starnix/kernel:starnix_kernel_package",
    "//src/storage/fxfs/test-fxfs:test-fxfs-package",
    "//src/starnix/containers/debian:debian_package",
  ]
  test_specs = {
    package_resolution_timeout_secs = 660
  }
}

remotevol_tests_group("starnix_remotevol_key_file_integration_test") {
  test_components = [ ":remotevol_key_file_test" ]
  kernel_base_manifest = "meta/kernel_with_container.base.cml"
  subpackages = [
    "//src/starnix/kernel:starnix_kernel_package",
    "//src/storage/fxfs/test-fxfs:test-fxfs-package",
    "//src/starnix/containers/debian:debian_package",
  ]
  test_specs = {
    package_resolution_timeout_secs = 660
  }
}

remotevol_tests_group("starnix_remotevol_in_process_integration_test") {
  test_components = [ ":remotevol_in_process_test" ]
  kernel_base_manifest = "meta/kernel_with_container.base.cml"
  subpackages = [
    "//src/starnix/kernel:starnix_kernel_package",
    "//src/storage/fxfs/test-fxfs:test-fxfs-package",
    "//src/starnix/containers/debian:debian_package",
  ]
  container_config = {
    extra_features = [ "remotevol_in_process" ]
  }
  test_specs = {
    log_settings = {
      # TODO(https://fxbug.dev/570053567): this error log exception only exists because the feature
      # is currently not implemented. Remove it once the tests actually test
      # something and don't just crash starnix.
      max_severity = "ERROR"
    }
    package_resolution_timeout_secs = 660
  }
}
