{
    program: {
        runner: "starnix_container",

        // The path that the container lists in `stop_last_on_shutdown`.
        binary: "/container/tests/exit_on_sigterm_bin",
        args: [
            "STOPPED_LAST",
            "0",
        ],
        uid: "0",
    },
}
