{
    program: {
        runner: "starnix_container",
        binary: "data/tests/crash_during_shutdown_bin",

        // Longer than the 1s SIGTERM timeout, shorter than the 3s deferred shutdown deadline.
        args: [ "1500" ],
        uid: "0",
    },
}
