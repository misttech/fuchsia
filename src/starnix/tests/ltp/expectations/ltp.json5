{
    actions: [
        {
            type: "expect_pass",
            matchers: [
                "*",

                // TODO(https://fxbug.dev/391599171): Requires event-based userfaultfd
                "cve-2022-2590",

                // TODO(https://fxbug.dev/287114514): Pass all userfaultfd* tests
                "userfaultfd02",
                "userfaultfd03",
                "userfaultfd04",
                "userfaultfd05",
                "userfaultfd06",

                // Requires AF_ALG
                "cve-2026-31431",

                // Requires CONFIG_USER_NS, CONFIG_XFRM, CONFIG_INET_ESP, CONFIG_CRYPTO_GCM
                "cve-2026-43284",
                "cve-2026-46300",

                // TODO(https://fxbug.dev/465929750): Requires CONFIG_AF_UNIX_OOB.
                "cve-2025-38236",

                // Requires CONFIG_BLK_DEV_INTEGRITY
                "ioctl_getlbmd01",

                // TODO(https://fxbug.dev/536048049): io_pgetevents AIO syscall is not implemented.
                "io_pgetevents01",

                // TODO(https://fxbug.dev/287705521): Requires key management support
                "cve-2017-12192",

                // fanotify support
                "fanotify24",
                "fanotify25",

                // TODO(https://fxbug.dev/465929299): Requires __NR_file_[getattr|setattr].
                "file_attr01",
                "file_attr02",
                "file_attr03",
                "file_attr04",

                // Requires name_to_handle
                "name_to_handle_at03",

                // Needs to run on ext4
                "statx06",
            ],
        },
        {
            type: "expect_failure",
            matchers: [
                // TODO(https://fxbug.dev/546542432): Starnix does not support ACL filesystem perms.
                "acl_file_ops01",
                "acl_inherit01",
                "acl_link01",
                "acl_mask01",
                "acl_other01",
                "acl_user_obj01",

                // adjtimex not supported
                "adjtimex01",
                "adjtimex02",
                "adjtimex03",

                // This test checks that you cannot trick the kernel into chmoding a symlink node
                // directly by opening a O_NOFOLLOW fd, and then chmoding that fd via a path in /proc.
                //
                // Right now Starnix actually chmods the underlying file, because it ends up following
                // the entire symlink chain even when chmoding through proc. However, the test also
                // verifies that the underlying file was not chmod'ed, in addition to the symlink, so it
                // still fails.
                "chmod09",
                "clock_adjtime01",
                "clock_adjtime02",
                "clock_settime01",
                "clock_settime02",
                "clock_settime04",

                // TODO(https://fxbug.dev/42066087): Requires CLONE_VM without CLONE_THREAD.
                // Currently, we implement this combination of flags by making a copy-on-write
                // clone of the VM, which is insufficient to pass this test because the test uses
                // a volatile write to communicate the status of the child process.
                "clone05",

                // Requires CLONE_NEWNET. In order to implement CLONE_NEWNET, we would need to
                // support network namespaces. Additionally, even if we supported network
                // namespaces, this test would still fail until we implement CLONE_VM without
                // CLONE_THREAD because the test uses a shared VM to send back the result.
                "clone09",
                "cpuacct_1_1",

                // TODO(https://fxbug.dev/574136788): Support ELF core dump generation
                "coredump01",
                "coredump02",

                // Depends on real contents in /proc/sys/kernel/perf_event_mlock_kb
                "cve-2015-3290",
                "cve-2016-9793",
                "cve-2017-7308",
                "cve-2017-17807",
                "cve-2017-18075",
                "cve-2018-11508",
                "cve-2018-19854",
                "cve-2018-5803",
                "cve-2018-9568",
                "cve-2020-11494",
                "cve-2021-4034",

                // TODO(https://fxbug.dev/465930802)
                "epoll_pwait06",

                // TODO(https://fxbug.dev/546549247): A variety of nuances in epoll handling.
                "epoll_ctl06",
                "epoll_wait10",
                "epoll_wait16",

                // Requires SEEK_HOLE.
                "fallocate04",

                // Fails due to: "No supported filesystems"
                "getxattr03",

                // TODO(https://fxbug.dev/547878640): Does not run on tmpfs.
                "fcntl24",
                "fcntl24_64",

                // TODO(https://fxbug.dev/547878640): Does not run on tmpfs.
                "fcntl25",
                "fcntl25_64",

                // TODO(https://fxbug.dev/547878640): Does not run on tmpfs.
                "fcntl26",
                "fcntl26_64",

                // 31 requires F_SETSIG.
                "fcntl31",
                "fcntl31_64",

                // TODO(https://fxbug.dev/547878640): Does not run on tmpfs.
                "fcntl32",
                "fcntl32_64",

                // 33 requires F_GETSIG.
                "fcntl33",
                "fcntl33_64",

                // TODO(https://fxbug.dev/546552617): Nuances in Futex table handling validations.
                "futex_cmp_requeue03",
                "futex_wake05",

                // TODO(https://fxbug.dev/547878640): Skipped with tmpfs.
                "fdatasync03",
                "fsetxattr02",
                "futimesat01",
                "getitimer01",

                // TODO: https://fxbug.dev/287118373 - depends on PRIO_PGRP and PRIO_USER support.
                "getpriority01", // https://fxbug.dev/287118373
                "getpriority02", // https://fxbug.dev/287118373

                // AIO operations on non-seekable devices
                "io_submit04",

                // Does not run on tmpfs
                "ioctl_fiemap01",

                // TODO(https://fxbug.dev/547878640): Skipped with tmpfs.
                "ioctl_loop05",
                "ioprio_get01",
                "ioprio_set01",
                "ioprio_set02",
                "ioprio_set03",
                "leapsec01",
                "madvise02",
                "madvise08",
                "membarrier01",

                // TODO(https://fxbug.dev/568892309): Requires cgroup v1 memory controller.
                "madvise09",
                "memcg_control",
                "memcg_regression",
                "memcg_test_3",
                "memcontrol02",
                "swapon01",
                "mincore01",
                "mincore02",
                "mincore03",
                "mincore04",
                "mlock201",
                "mlock203",
                "mlockall01",
                "mlockall02",
                "mlockall03",
                "mmap14",
                "mount02",
                "mprotect01",
                "msync03",

                // TODO(https://fxbug.dev/547878640): Requires O_DIRECT support.
                "msync04",
                "munlockall01",

                // TODO(https://fxbug.dev/391599171): Requires event-based userfaultfd
                "mremap07",

                // TODO(https://fxbug.dev/322874684): Requires /proc/sys/vm/max_map_count
                // and the enforcement of maximum number of mappings during munmap() call
                "munmap04",

                // Needs /proc/sys/fs/pipe-user-pages-soft
                "pipe15",
                "prctl02",

                // TODO(https://fxbug.dev/547878640): Requires O_DIRECT support.
                "pwritev03",
                "pwritev03_64",
                "quotactl04",
                "quotactl08",
                "quotactl09",

                // Depends on IO stats in /proc/<pid>/io .
                "readahead02",
                "remap_file_pages02",

                // TODO: https://fxbug.dev/287120797 - maybe we'll implement sched_getattr?
                "sched_getattr01", // https://fxbug.dev/287120797
                "sched_getattr02", // https://fxbug.dev/287120797

                // TODO: https://fxbug.dev/297292100 - maybe we'll implement sched_rr_get_interval?
                "sched_rr_get_interval02", // https://fxbug.dev/297292100
                "sched_rr_get_interval03", // https://fxbug.dev/297292100

                // TODO: https://fxbug.dev/287114492 - maybe we'll implement sched_setattr?
                "sched_setattr01", // https://fxbug.dev/287114492
                "send02",
                "setitimer01",
                "setitimer02",

                // TODO: https://fxbug.dev/287121196 - depends on PRIO_PGRP and PRIO_USER support.
                "setpriority01", // https://fxbug.dev/287121196
                "setrlimit03",
                "settimeofday01",
                "settimeofday02",
                "setxattr03",
                "splice07",
                "sockioctl01",
                "statx04",
                "statx11",

                // TODO(https://fxbug.dev/547878640): Requires block device write accounting.
                "sync01",
                "time-schedule01",

                // TODO(https://fxbug.dev/297374270): Requires system load and ram usage information
                // in sysinfo()
                "sysinfo01",

                // Needs working sched_getcpu()
                "perf_event_open02",

                // https://fxbug.dev/42078242
                "times03",
                "umount2_01",
                "umount2_02",

                // TODO(https://fxbug.dev/42080241): unshare(CLONE_FILES) needs to return EMFILE
                // if number of file descriptors is higher than /proc/sys/fs/nr_open
                "unshare03",

                // TODO(https://fxbug.dev/42080241): CLONE_NEWNS needs to also do the CLONE_FS
                "unshare04",

                // TODO(https://fxbug.dev/322873462): Requires /proc/sys/kernel/hostname
                "newuname01",

                // TODO(https://fxbug.dev/349188105) these need CLOCK_{PROCESS,THREAD}_CPUTIME_ID
                "timer_create01",
                "timer_delete01",
                "timer_settime02",

                // TODO(https://fxbug.dev/374802310)
                "inotify03",

                // TODO(https://fxbug.dev/377877724)
                "getsockopt01",
                "mlock05",

                // Requires FS_APPEND_FL and FS_IMMUTABLE_FL
                // We can implement these for tmpfs, but getting them to persist in fxfs is
                // non-trivial.
                "unlink09",

                // TODO(https://fxbug.dev/399387742): fix invocation path and re-enable
                "vma05",

                // TODO(https://fxbug.dev/297431387): Require more io_uring feature
                "cve-2020-29373",

                // TODO(https://fxbug.dev/496317235): Upstream LTP roll, require investigation
                "clone11",
                "clone304",
                "file_attr05",

                // TODO(https://fxbug.dev/287114514): Pass all userfaultfd* tests
                "userfaultfd01",

                // TODO(https://fxbug.dev/287705521): Key management support
                "add_key01",
                "add_key03",
                "cve-2015-7550",
                "cve-2016-9604",
                "cve-2017-12193",
                "cve-2017-15274",
                "cve-2017-15299",
                "cve-2017-17807",
                "cve-2017-15951",
                "cve-2017-6951",
                "cve-2017-7472",
                "keyctl01",
                "keyctl03",
                "keyctl06",
                "keyctl10",
                "keyctl11",
                "keyctl12",
                "keyctl13",
                "keyctl14",
                "keyctl15",
                "keyctl16",
                "keyctl17",
                "keyctl18",
                "keyctl19",
                "keyctl20",
                "keyctl21",
                "keyctl22",
                "keyctl24",
                "request_key01",
                "request_key02",
                "request_key03",
                "request_key04",
                "request_key05",
                "request_key06",
            ],
        },
        {
            type: "skip",
            matchers: [
                // Flaky tests.
                "ptrace06",

                // TODO(https://fxbug.dev/536096605): Test sendmsg on TCP socket with SCM_RIGHTS.
                // Linux silently ignores it, but Starnix returns EINVAL.
                "recvmsg01",

                // TODO(https://fxbug.dev/534918239): This test intentionally exhausts disk space to
                // verify fallocate behavior under that condition. Intentionally exhausting space in
                // Starnix causes an OOM and subsequent crash of the test environment.
                "fallocate05",

                // These tests hang
                "fork14",

                // TODO(https://fxbug.dev/322874889) requires a working sched_setaffinity
                "getcpu01",

                // TODO(https://fxbug.dev/540074260): These tests pass but are time-consuming, so
                // they often cause timeouts in the corresponding suites. Consider moving them to
                // separate bundles.
                "cve-2011-0999",
                "cve-2014-0196",
                "cve-2016-7117",
                "cve-2017-10661",
                "hackbench02",
                "mtest06",

                // TODO(https://fxbug.dev/547878640): Attempts to fill up the filesystem lead to OOM
                // when run on tmpfs.
                "fs_fill",

                // TODO(https://fxbug.dev/536929400): Test runs a shell script that calls rm in a
                // loop, causing 2000 execve calls.
                "fs_inod01",

                // TODO(https://fxbug.dev/544688052): Resolve the flake and re-enable.
                "starvation",

                // TODO(https://fxbug.dev/328694820) Re-enable once flake is resolved.
                "ptrace01",

                // TODO(https://fxbug.dev/353535860) deflake and enable
                "pidfd_open03",

                // TODO(https://fxbug.dev/559170416) deflake and re-enable
                "pidfd_send_signal01",

                // TODO(https://fxbug.dev/403612570): This test requires CLONE_INTO_CGROUP.
                "clone303",

                // TODO(https://fxbug.dev/390870202): Re-enable once flake is resolved.
                "clock_nanosleep02",

                // TODO(https://fxbug.dev/395053835): Re-enable once flake is resolved.
                "setrlimit01",

                // TODO(https://fxbug.dev/442531248): Seems premised on getting the scheduling of
                // a process that may be alive or may be a zombie; since we don't (yet?) support
                // the latter, this flakes.
                "sched_setscheduler04",

                // Flaking, see b/457451482.
                "fork06",

                // Times out, see b/457525944
                "epoll01",
            ],
        },
    ],
}
