{
    include: [
        "//src/power/system-activity-governor/meta/no-suspending-token-for-test-sag.shard.cml",
        "inspect/offer.shard.cml",
        "syslog/offer.shard.cml",
        "trace/offer.shard.cml",
    ],
    program: {
        runner: "starnix_test_runner",
    },
    children: [
        {
            name: "kernel",
            url: "starnix_kernel#meta/starnix_kernel.cm",
        },
        {
            name: "runner",
            url: "starnix#meta/starnix_runner.cm",
        },
        {
            name: "ui",
            url: "test-ui-stack#meta/test-ui-stack.cm",
        },
        {
            name: "netstack",
            url: "netstack#meta/netstack3.cm",
        },
        {
            name: "network-tun",
            url: "network-tun#meta/network-tun.cm",
        },
        {
            name: "power-broker",
            url: "power-broker#meta/power-broker.cm",
        },
        {
            name: "test-system-activity-governor",
            url: "system-activity-governor#meta/system-activity-governor.cm",
        },
        {
            name: "fake-hrtimer",
            url: "fake-hrtimer#meta/default.cm",
        },
        {
            name: "timekeeper",
            url: "timekeeper-for-starnix-tests#meta/timekeeper.cm",
        },
        {
            name: "utc-handle-vendor",
            url: "utc-handle-vendor#meta/default.cm",
        },
        {
            name: "cobalt",
            url: "fake_cobalt#meta/fake_cobalt.cm",
        },
        {
            name: "erofs",
            url: "erofs#meta/erofs.cm",
        },
    ],
    capabilities: [
        { protocol: "fuchsia.test.Suite" },
    ],
    use: [
        {
            protocol: [ "fuchsia.component.Realm" ],
            from: "framework",
        },
    ],

    // The test runner will dispatch the permissions that the starnix kernel
    // need from the test to the runner.
    offer: [
        {
            protocol: [
                "fuchsia.buildinfo.Provider",
                "fuchsia.diagnostics.ArchiveAccessor",
                "fuchsia.diagnostics.LogStream",
                "fuchsia.feedback.CrashReporter",
                "fuchsia.kernel.Stats",
                "fuchsia.kernel.VmexResource",
                "fuchsia.sysinfo.SysInfo",
                "fuchsia.sysmem.Allocator",
                "fuchsia.sysmem2.Allocator",
                "fuchsia.tracing.provider.Registry",
                "fuchsia.vulkan.loader.Loader",
            ],
            from: "parent",
            to: [ "#kernel" ],
        },

        // Get profiler from parent (#testing, whose parent is /core).
        {
            protocol: [ "fuchsia.cpu.profiler.Session" ],
            from: "parent",
            to: [ "#kernel" ],
            availability: "optional",
        },
        {
            protocol: [ "fuchsia.starnix.runner.Manager" ],
            from: "#runner",
            to: [ "#kernel" ],
        },
        {
            protocol: [ "fuchsia.erofs.Erofs" ],
            from: "#erofs",
            to: [ "#kernel" ],
        },
        {
            protocol: [ "fuchsia.power.broker.Topology" ],
            from: "#power-broker",
            to: [
                "#fake-hrtimer",
                "#kernel",
                "#test-system-activity-governor",
                "#timekeeper",
            ],
        },
        {
            protocol: [
                "fuchsia.power.suspend.Stats",
                "fuchsia.power.system.ActivityGovernor",
            ],
            from: "#test-system-activity-governor",
            to: [
                "#kernel",
                "#timekeeper",
            ],
        },
        {
            protocol: [
                "fuchsia.scheduler.RoleManager",
                "fuchsia.sysmem.Allocator",
                "fuchsia.sysmem2.Allocator",
                "fuchsia.tracing.provider.Registry",
                "fuchsia.vulkan.loader.Loader",
            ],
            from: "parent",
            to: "#ui",
        },
        {
            protocol: [
                "fuchsia.ui.composition.Allocator",
                "fuchsia.ui.composition.Flatland",
                "fuchsia.ui.composition.FlatlandFactory",
                "fuchsia.ui.display.singleton.Info",
                "fuchsia.ui.input.DeviceListenerRegistry",
                "fuchsia.ui.input3.Keyboard",
                "fuchsia.ui.policy.DeviceListenerRegistry",
                "fuchsia.ui.test.input.Registry",
            ],
            from: "#ui",
            to: [ "#kernel" ],
        },
        {
            protocol: [
                "fuchsia.net.filter.Control",
                "fuchsia.net.filter.SocketControl",
                "fuchsia.net.interfaces.admin.Installer",
                "fuchsia.net.interfaces.State",
                "fuchsia.net.ndp.RouterAdvertisementOptionWatcherProvider",
                "fuchsia.net.neighbor.Controller",
                "fuchsia.net.neighbor.View",
                "fuchsia.net.power.WakeGroupProvider",
                "fuchsia.net.root.Interfaces",
                "fuchsia.net.routes.admin.RouteTableProviderV4",
                "fuchsia.net.routes.admin.RouteTableProviderV6",
                "fuchsia.net.routes.admin.RouteTableV4",
                "fuchsia.net.routes.admin.RouteTableV6",
                "fuchsia.net.routes.admin.RuleTableV4",
                "fuchsia.net.routes.admin.RuleTableV6",
                "fuchsia.net.routes.StateV4",
                "fuchsia.net.routes.StateV6",
                "fuchsia.net.settings.Control",
                "fuchsia.net.settings.State",
                "fuchsia.net.sockets.Control",
                "fuchsia.net.sockets.Diagnostics",
                "fuchsia.posix.socket.packet.Provider",
                "fuchsia.posix.socket.Provider",
                "fuchsia.posix.socket.raw.Provider",
            ],
            from: "#netstack",
            to: [ "#kernel" ],
        },
        {
            protocol: [
                "fuchsia.time.alarms.WakeAlarms",
                "fuchsia.time.external.Adjust",
            ],
            from: "#timekeeper",
            to: [
                "#kernel",
                "#runner",
            ],
            availability: "optional",
        },
        {
            protocol: [ "fuchsia.net.tun.Control" ],
            from: "#network-tun",
            to: [ "#kernel" ],
        },
        {
            // TODO(https://fxbug.dev/324273348): Remove this capability once the clients have
            // been migrated to services. The service capability has been added below.
            directory: "dev-gpu",
            from: "parent",
            to: [ "#kernel" ],
        },
        {
            // This service replaces the directory capability above.
            service: "fuchsia.gpu.magma.Service",
            from: "parent",
            to: [ "#kernel" ],
        },
        {
            directory: "boot-kernel",
            from: "parent",
            to: [ "#kernel" ],
        },
        {
            // TODO(https://fxbug.dev/324273348): Remove this capability once the clients have
            // been migrated to services. The service capability has been added below.
            directory: "dev-hrtimer",
            from: "#fake-hrtimer",
            to: [ "#timekeeper" ],
        },
        {
            // This service replaces the directory capability above.
            service: "fuchsia.hardware.hrtimer.Service",
            from: "#fake-hrtimer",
            to: [ "#timekeeper" ],
        },
        {
            // Provides a fake UTC clock handle to programs that need to manipulate
            // the UTC handle in tests. This should *never* be done in production.
            protocol: [ "fuchsia.time.Maintenance" ],
            from: "#utc-handle-vendor",
            to: [
                "#kernel",
                "#timekeeper",
            ],
        },
        {
            // Note: fuchsia.time.config.WritableUTCTime is not routed here because
            // Starnix test realms (e.g. syscall_test.gni and gvisor_tests.gni) already
            // offer it per-test from #config to #timekeeper via
            // starnix_container_config_offers.
            config: [
                "fuchsia.time.config.BackOffTimeBetweenPullSamplesSec",
                "fuchsia.time.config.FirstSamplingDelaySec",
                "fuchsia.time.config.MaxFrequencyErrorPpm",
                "fuchsia.time.config.MinAcceptableBootTimeForUtcUpdateMinutes",
                "fuchsia.time.config.MinUtcReferenceToBackstopDiffMinutes",
                "fuchsia.time.config.PrimaryTimeSourceUrl",
                "fuchsia.time.config.PrimaryUsesPull",
                "fuchsia.time.config.ServeFuchsiaTimeAlarms",
                "fuchsia.time.config.UtcMaxAllowedDeltaFutureSec",
                "fuchsia.time.config.UtcMaxAllowedDeltaPastSec",
            ],
            from: "#utc-handle-vendor",
            to: [ "#timekeeper" ],
        },
        {
            // Route remaining Timekeeper configuration capabilities from void so they use their
            // manifest defaults (e.g. false for DisableDelays and ServeTestProtocols, matching the
            // legacy starnix-tests.json5 configuration).
            config: [
                "fuchsia.time.config.DisableDelays",
                "fuchsia.time.config.EarlyExit",
                "fuchsia.time.config.HasAlwaysOnCounter",
                "fuchsia.time.config.HasRealTimeClock",
                "fuchsia.time.config.InitialFrequencyPpm",
                "fuchsia.time.config.MonitorTimeSourceUrl",
                "fuchsia.time.config.MonitorUsesPull",
                "fuchsia.time.config.OscillatorErrorStdDevPpm",
                "fuchsia.time.config.PeriodicRtcUpdateIntervalMinutes",
                "fuchsia.time.config.PowerTopologyIntegrationEnabled",
                "fuchsia.time.config.RtcAllowSettingPastUtc",
                "fuchsia.time.config.ServeTestProtocols",
                "fuchsia.time.config.TimeSourceEndpointUrl",
                "fuchsia.time.config.UseConnectivity",
                "fuchsia.time.config.UtcStartAtStartup",
                "fuchsia.time.config.UtcStartAtStartupWhenInvalidRtc",
            ],
            from: "void",
            to: [ "#timekeeper" ],
            availability: "optional",
        },
        {
            protocol: [ "fuchsia.metrics.MetricEventLoggerFactory" ],
            from: "#cobalt",
            to: [ "#timekeeper" ],
        },
    ],
    environments: [
        {
            name: "starnix_runner_env",
            extends: "realm",
            runners: [
                {
                    runner: "starnix",
                    from: "#kernel",
                },
            ],
        },
    ],
}
