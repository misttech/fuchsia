load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")

package(default_applicable_licenses = ["//:license"])

rustc_binary(
    name = "bin",
    testonly = True,
    srcs = ["src/main.rs"],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate_name = "starnix_kernel_core_bench",
    edition = "2024",
    deps = [
        "//sdk/rust/zx",
        "//src/developer/fuchsia-criterion",
        "//src/lib/fuchsia-runtime",
        "//src/starnix/kernel/core",
    ],
)
