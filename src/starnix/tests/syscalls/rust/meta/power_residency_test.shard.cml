// Serves fake power stats to the Starnix kernel for power_residency_test.
{
    children: [
        {
            name: "fake_power_stats",
            url: "#meta/fake_power_stats.cm",
        },
    ],
    offer: [
        {
            service: "fuchsia.hardware.power.stats.Service",
            from: "#fake_power_stats",
            to: "#kernel",
        },
    ],
}
