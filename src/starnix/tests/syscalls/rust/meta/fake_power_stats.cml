{
    include: [ "syslog/client.shard.cml" ],
    program: {
        runner: "elf",
        binary: "bin/fake_power_stats",
    },
    capabilities: [
        { service: "fuchsia.hardware.power.stats.Service" },
    ],
    expose: [
        {
            service: "fuchsia.hardware.power.stats.Service",
            from: "self",
        },
    ],
}
