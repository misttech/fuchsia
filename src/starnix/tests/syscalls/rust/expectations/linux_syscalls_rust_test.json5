{
    actions: [
        {
            type: "skip",
            matchers: [
                // device_mapper_test.rs test failures, from the initial Rust syscall bootstrap.
                "tests::create_dm_device",
                "tests::dm_dev_status",
                "tests::dm_list_devices",
            ],
        },
        {
            type: "expect_failure",
            matchers: [
                // device_mapper_test.rs test failures, from the initial Rust syscall bootstrap.
                "tests::dm_list_versions",
                "tests::dm_table_status_buffer_full",
                "tests::dm_table_status_corrupt::create_verity_target_shared_loop_device_expects",
                "tests::dm_table_status_corrupt::create_verity_target_two_loop_devices_sha256_expects",
                "tests::dm_table_status_corrupt::create_verity_target_two_loop_devices_sha512_expects",
                "tests::dm_table_status_flag",
                "tests::dm_table_status_no_active_table",
                "tests::dm_table_status_valid",
                "tests::list_devices_buffer_full",
                "tests::read_corrupted_dm_verity_device::create_verity_target_shared_loop_device_expects",
                "tests::read_corrupted_dm_verity_device::create_verity_target_two_loop_devices_sha256_expects",
                "tests::read_corrupted_dm_verity_device::create_verity_target_two_loop_devices_sha512_expects",
                "tests::read_dm_device_no_active_table",
                "tests::read_loaded_and_resumed_dm_device::create_verity_target_shared_loop_device_expects",
                "tests::read_loaded_and_resumed_dm_device::create_verity_target_two_loop_devices_sha256_expects",
                "tests::read_loaded_and_resumed_dm_device::create_verity_target_two_loop_devices_sha512_expects",
                "tests::remove_dm_device_cached_handle_in_scope",
                "tests::remove_dm_device_in_scope",
                "tests::suspend_and_resume_dm_device",
                "tests::test_dm_table_load_invalid_root_hash::create_verity_target_shared_loop_device_expects",
                "tests::test_dm_table_load_invalid_root_hash::create_verity_target_two_loop_devices_sha256_expects",
                "tests::test_dm_table_load_invalid_root_hash::create_verity_target_two_loop_devices_sha512_expects",

                // ebpf.rs test failures, from the initial Rust syscall bootstrap.
                "tests::ebpf_egress::dual_stack_ipv4",
                "tests::ebpf_egress::dual_stack_ipv6",
                "tests::ebpf_egress::ipv4",
                "tests::ebpf_getsockopt",
                "tests::ebpf_ingress::dual_stack_ipv4",
                "tests::ebpf_ingress::dual_stack_ipv6",
                "tests::ebpf_ingress::ipv4",
                "tests::ebpf_setsockopt",
                "tests::ebpf_sk_storage",
                "tests::ebpf_udp_recv",
                "tests::ebpf_udp_send",
                "tests::ebpf_udp_send_connected",
            ],
        },
    ],
}
