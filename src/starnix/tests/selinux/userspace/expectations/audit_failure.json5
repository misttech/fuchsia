{
    "audit-failure": [
        // TODO: https://fxbug.dev/509488263 - Make (SE)Starnix match the (SE)Linux behavior
        // demonstrated in this test.
        "BpfMapCreateTestSuite/BpfMapCreateTest.Create/create",

        // The permission is checked correctly, but Linux adds multiple logs for the same denial.
        "CapabilitiesTest.ChmodSgidChecksFsgid",
        "CapabilitiesTest.ChmodSgidDifferentOwnerAndGroup",
        "CapabilitiesTest.ChmodSgidSameOwnerDifferentGroup",

        // Linux audits the denial using an unrelated permission of the socket class (since the
        // "watch" permissions are not defined for socket-like classes), while Starnix denies
        // the watch without auditing.
        "InotifyTest.WatchSocketDenied",

        // Starnix checks CAP_SYS_ADMIN without auditing in perf_event_open(), and skips the
        // capability check for a tracepoint on the calling task that excludes the kernel, so it
        // generates fewer perfmon/sys_admin capability denials than Linux does.
        "PerfEventTest.OpenEventsNoPerfmon",
        "PerfEventTest.OpenEventsNoPerfmonWithSysAdmin",
        "PerfEventTest.OpenEventsNoTracepointNoPerfmon",

        // Starnix does not generate the sys_nice capability denial that Linux does
        // because Starnix avoids the unnecessary capability check when EUIDs match.
        "SchedTest.SchedSetschedulerDeniedWithoutSetsched",
        "SchedTest.SchedSetschedulerSucceedsWithSetsched",

        // The permission is checked correctly, but Linux adds multiple logs for the same denial.
        "SyslogTest.ProcKmsgReadDeniedIfDroppedPermission",

        // TUNSETQUEUE is not supported in Starnix.
        "TunTapTests/TunTapAttachTest.AttachQueue/2",
        "TunTapTests/TunTapAttachTest.AttachQueue/3",

        // TUNSETPERSIST is not supported in Starnix.
        "TunTapTests/TunTapRelabelTest.Relabel/2",
        "TunTapTests/TunTapRelabelTest.Relabel/3",
        "TunTapTests/TunTapRelabelTest.Relabel/4",
        "TunTapTests/TunTapRelabelTest.Relabel/5",
    ],
}
