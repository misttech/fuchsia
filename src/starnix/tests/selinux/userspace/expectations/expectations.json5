{
    actions: [
        {
            type: "expect_pass",
            matchers: [
                "*",
            ],
        },
        {
            type: "expect_failure",
            matchers: [
                // TODO: https://fxbug.dev/398662840 - Support SELinux context= and rootcontext=
                // mount options on cgroupfs v2.
                "CgroupFs/CgroupFsTest.SecondMountWithDifferentOptionsChangesLabels/Context",
                "CgroupFs/CgroupFsTest.SecondMountWithDifferentOptionsChangesLabels/RootContext",

                // TODO: https://fxbug.dev/532921178 - io_uring memory accounting is not implemented
                // in Starnix.
                "IoUringTest.IoUringSetupMemlockLimitCumulative",
                "IoUringTest.IoUringSetupMemlockLimit",

                // TODO: https://fxbug.dev/334094811 - Reject SELinux mount options before a
                // policy is loaded.
                "MountTests/MountOptionValidationTest.RejectedBeforePolicyLoad/*",

                // TODO: https://fxbug.dev/501038871 - Make (SE)Starnix match the (SE)Linux behavior
                // regarding perf_event_open with invalid tracepoint ID.
                "PerfEventTest.InvalidTracepointIdAndNoPermission",

                // TODO: https://fxbug.dev/561468765 - Return EPERM when ptrace access check
                // fails in sys_pidfd_getfd.
                "PidFdTest/PidFdGetFdTest.PidFdGetFd/DeniedWithoutPtrace",

                // TODO: Support reading pre-policy procattrs in Starnix.
                "ProcAttrTest.PrePolicyAttrs",

                // TODO: https://fxbug.dev/568759264 - Cache tracer credentials at ptrace
                // attachment time for capability checks on exec.
                "PtraceTest.PtraceExecVanillaCapCheckUsesCachedCreds",
                "PtraceTest.PtraceExecSelinuxCapCheckUsesCachedCreds",

                // TODO: https://fxbug.dev/574857992 - Reject subsequent writes with EBUSY even if
                // the initial write failed.
                "SeLinuxFsContext.OneRequestPerInstanceFailedWrite",

                // TODO: https://fxbug.dev/574857992 - Fix SELinuxFS API handling of unknown policy class Ids.
                "SeLinuxFsCreate.InvalidComputeCreateClassId",
                "SeLinuxFsAccess.UnknownClassIdIsAccepted",

                // TODO: https://fxbug.dev/574857992 - Fix SELinuxFS API validation of fields.
                "SeLinuxFsAccess.ClassIdMayHaveTrailingNonNumericData",
                "SeLinuxFsAccess.FourthArgumentIsNotValidated",

                // TODO: https://fxbug.dev/566091911 - Label new sysfs nodes via
                // `kernfs_init_security` when their parent has a `security.selinux` xattr.
                "SysFs/SysFsTest.SubdirectoryLabels/InheritsParentXattrLabel",
                "SysFs/SysFsTest.SubdirectoryLabels/AppliesTypeTransitionWhenParentHasXattr",
                "SysFs/SysFsTest.SubdirectoryLabels/UsesFscreateLabelWhenParentHasXattr",

                // TODO: https://fxbug.dev/507820778 - Default unlabeled filesystems to the
                // `unlabeled` initial SID.
                "UnlabeledFsTest.CreateFileInUnlabeledFs",
            ],
        },
        {
            type: "skip",
            matchers: [
                // TODO: https://fxbug.dev/439799293 - Wait on `PTRACE_ATTACH` to finish.
                "PtraceTest.PtraceAttachAllowed",
                "PtraceTest.PtraceAttachThenExecDenied",
                "PtraceTest.PtraceAttachThenExecAllowed",
            ],
        },
    ],
}
