import("//build/components.gni")
import("//build/rust/rustc_test.gni")

group("tests") {
  testonly = true
  deps = [ ":psi_provider-tests" ]
}

fuchsia_component("psi_provider") {
  manifest = "meta/psi_provider.cml"
  deps = [ ":psi_provider-bin" ]
}

# Kept in GN because `psi_provider-bin_test` transitively depends on
# `//src/storage/lib/vfs/rust:vfs` (`rustc_dylib("vfs_dylib")`), which places
# two copies of `libvfs-<hash>.so` in Bazel `default_runfiles` and causes
# `fx_packaged_binary` + `fx_package` to fail with duplicate `lib/libvfs-*.so`.
rustc_test("psi_provider-bin_test") {
  edition = "2024"
  output_name = "psi_provider-bin_bin_test"
  source_root = "src/main.rs"
  sources = [
    "src/history.rs",
    "src/main.rs",
  ]
  deps = [
    "//sdk/fidl/fuchsia.kernel:fuchsia.kernel_rust",
    "//sdk/fidl/fuchsia.starnix.psi:fuchsia.starnix.psi_rust",
    "//sdk/rust/zx",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//src/lib/fuchsia-sync",
    "//src/starnix/lib/starnix_sync",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
  ]
  configs += [ "//src/starnix/config:starnix_clippy_lints" ]
}

fuchsia_unittest_package("psi_provider-tests") {
  deps = [ ":psi_provider-bin_test" ]
}

