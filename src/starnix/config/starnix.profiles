{
  "scope": "core",

  "profiles": {
    // LINT.IfChange
    // Include `"affinity": "all"` so that transitioning a thread from an
    // affinity-restricted role override back to a default Starnix role resets
    // its Zircon soft CPU affinity mask instead of leaving the previous mask
    // sticky.
    "fuchsia.starnix.fair.0": { "priority": 0, "affinity": "all" },
    "fuchsia.starnix.fair.1": { "priority": 1, "affinity": "all" },
    "fuchsia.starnix.fair.2": { "priority": 2, "affinity": "all" },
    "fuchsia.starnix.fair.3": { "priority": 3, "affinity": "all" },
    "fuchsia.starnix.fair.4": { "priority": 4, "affinity": "all" },
    "fuchsia.starnix.fair.5": { "priority": 5, "affinity": "all" },
    "fuchsia.starnix.fair.6": { "priority": 6, "affinity": "all" },
    "fuchsia.starnix.fair.7": { "priority": 7, "affinity": "all" },
    "fuchsia.starnix.fair.8": { "priority": 8, "affinity": "all" },
    "fuchsia.starnix.fair.9": { "priority": 9, "affinity": "all" },
    "fuchsia.starnix.fair.10": { "priority": 10, "affinity": "all" },
    "fuchsia.starnix.fair.11": { "priority": 11, "affinity": "all" },
    "fuchsia.starnix.fair.12": { "priority": 12, "affinity": "all" },
    "fuchsia.starnix.fair.13": { "priority": 13, "affinity": "all" },
    "fuchsia.starnix.fair.14": { "priority": 14, "affinity": "all" },
    "fuchsia.starnix.fair.15": { "priority": 15, "affinity": "all" },
    "fuchsia.starnix.fair.16": { "priority": 16, "affinity": "all" },
    "fuchsia.starnix.fair.17": { "priority": 17, "affinity": "all" },
    "fuchsia.starnix.fair.18": { "priority": 18, "affinity": "all" },
    "fuchsia.starnix.fair.19": { "priority": 19, "affinity": "all" },
    "fuchsia.starnix.fair.20": { "priority": 20, "affinity": "all" },
    "fuchsia.starnix.fair.21": { "priority": 21, "affinity": "all" },
    "fuchsia.starnix.fair.22": { "priority": 22, "affinity": "all" },
    "fuchsia.starnix.fair.23": { "priority": 23, "affinity": "all" },
    "fuchsia.starnix.fair.24": { "priority": 24, "affinity": "all" },
    "fuchsia.starnix.fair.25": { "priority": 25, "affinity": "all" },
    "fuchsia.starnix.fair.26": { "priority": 26, "affinity": "all" },
    "fuchsia.starnix.fair.27": { "priority": 27, "affinity": "all" },
    "fuchsia.starnix.fair.28": { "priority": 28, "affinity": "all" },
    "fuchsia.starnix.fair.29": { "priority": 29, "affinity": "all" },
    "fuchsia.starnix.fair.30": { "priority": 30, "affinity": "all" },
    "fuchsia.starnix.fair.31": { "priority": 31, "affinity": "all" },

    // When possible containers should specify the role overrides for tasks that
    // are more conservative than this broad default. This profile is limited to
    // 95% utilization, similar to the default setting of the RT throttling
    // mechanism of SCHED_FIFO. This profile can preempt variable bandwidth
    // tasks for 19ms out of every 20ms, but will not significantly delay
    // constant bandwidth tasks with tighter periods. To be clear: SCHED_FIFO
    // tasks are NOT the most important tasks in the system, even if they are
    // the most important tasks in Android.
    "fuchsia.starnix.realtime": { "capacity": "19ms", "period": "20ms", "affinity": "all" },
    // LINT.ThenChange(//src/starnix/kernel/core/task/scheduler/manager.rs)
  },
  "memory": {
    "fuchsia.starnix.pinned_memory": { "priority": 24 },
  },
}
