import("//build/bazel/bazel_host_tool.gni")

if (is_host) {
  bazel_host_tool("tar_to_pkg_bin") {
    bazel_target = ":tar_to_pkg_bin"
    bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/tar_to_pkg_bin"
  }
}

group("tests") {
  testonly = true

  # NOTE: tar_img_extract_test is wired via //src/starnix:host_tests.
  # tar_to_pkg_bin does not have any test yet. By listing it here, we
  # can at least verify that it compiles in CQ.
  deps = [ ":tar_to_pkg_bin($host_toolchain)" ]
}

