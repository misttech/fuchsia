load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host:defs.bzl", "rustc_binary_host_tool")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "tar_img_extract",
    srcs = [
        "src/docker_archive.rs",
        "src/layered_image.rs",
        "src/lib.rs",
        "src/populate_bundle_visitor.rs",
    ],
    edition = "2024",
    lint_config = "//src/starnix/config:starnix_clippy_lints",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//src/starnix/tools/gen_docker_container:__pkg__"],
    deps = [
        "//src/storage/ext4/lib/metadata",
        "//src/sys/pkg/lib/fuchsia-pkg",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:itertools",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:serde_json",
        "//third_party/rust_crates/vendor:tar",
        "//third_party/rust_crates/vendor:tempfile",
    ],
)

# @bazel2gn:skip
host_rustc_test(
    name = "tar_img_extract_test",
    crate = ":tar_img_extract",
    edition = "2024",
    lint_config = "//src/starnix/config:starnix_clippy_lints",
    target_compatible_with = HOST_OS_CONSTRAINTS,
)

# @bazel2gn:skip
rustc_binary_host_tool(
    name = "tar_to_pkg_bin",
    srcs = ["src/main.rs"],
    edition = "2024",
    lint_config = "//src/starnix/config:starnix_clippy_lints",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = [
        ":tar_img_extract",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:argh",
    ],
)

# @bazel2gn:skip
test_suite(
    name = "host_tests",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    tests = [":tar_img_extract_test"],
    visibility = ["//src/starnix:__pkg__"],
)
