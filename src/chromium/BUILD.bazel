load("//build/bazel/rules:cipd_prebuilt.bzl", "cipd_prebuilt_file")
load("//build/bazel/rules/packages:prebuilt_package.bzl", "prebuilt_package")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = [
        "//visibility:public",
    ],
)

# The 'canary' flavor of WebEngine, taken directly from the CIPD prebuilt.
# See //manifests/third_party/chromium/chromium.
cipd_prebuilt_file(
    name = "web_engine_canary_archive_arm64",
    path = "//prebuilt/third_party/web_engine_latest/arch/arm64/web_engine.far",
    visibility = ["//visibility:private"],
)

cipd_prebuilt_file(
    name = "web_engine_canary_archive_x64",
    path = "//prebuilt/third_party/web_engine_latest/arch/x64/web_engine.far",
    visibility = ["//visibility:private"],
)

prebuilt_package(
    name = "web_engine_canary",
    archive = select({
        "//build/bazel/platforms:is_fuchsia_arm64": ":web_engine_canary_archive_arm64",
        "//build/bazel/platforms:is_fuchsia_x64": ":web_engine_canary_archive_x64",
    }),
)

alias(
    name = "web_engine",
    actual = ":web_engine_canary",
)
