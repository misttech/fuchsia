{
  name: "imx227",
  composite_name: "imx227_sensor",
  include: [
    "//sdk/lib/driver/compat/compat.shard.cml",
  ],
  program: {
    compat: "driver/imx227.so",
    default_dispatcher_opts: [
      "allow_sync_calls",
    ],
    colocate: "true",
  },
  use: [
    {
      service: "fuchsia.gpio.Init",
      availability: "optional",
      name: "gpio-init",
    },
    {
      service: "fuchsia.hardware.clock.Service",
      name: "clock-sensor",
      bind: {
        rules: {
          "fuchsia.NAME": "\"clock-sensor\"",
        },
      },
    },
    {
      service: "fuchsia.hardware.gpio.Service",
      name: "gpio-reset",
      bind: {
        rules: {
          "fuchsia.NAME": "\"gpio-reset\"",
        },
      },
    },
    {
      service: "fuchsia.hardware.i2c.Service",
      name: "i2c",
    },
    {
      service: "fuchsia.hardware.pin.PinStatesService",
      availability: "optional",
      name: "pin-states-0",
    },
    {
      banjo: "fuchsia.camera.BIND_PROTOCOL.MIPICSI",
      name: "mipicsi",
      primary: true,
      bind: {
        protocol: "fuchsia.camera.BIND_PROTOCOL.MIPICSI",
      },
    },
    {
      service: "fuchsia.hardware.gpio.Service",
      name: "gpio-vana",
      bind: {
        rules: {
          "fuchsia.NAME": "\"gpio-vana\"",
        },
      },
    },
    {
      service: "fuchsia.hardware.gpio.Service",
      name: "gpio-vdig",
      bind: {
        rules: {
          "fuchsia.NAME": "\"gpio-vdig\"",
        },
      },
    },
    {
      name: "pdev",
      bind: {
        one_of: [
          {
            compat: "sony,imx227",
          },
          {
            protocol: "fuchsia.platform.BIND_PROTOCOL.DEVICE",
            vid: "fuchsia.sony.platform.BIND_PLATFORM_DEV_VID.SONY",
            pid: "fuchsia.sony.platform.BIND_PLATFORM_DEV_PID.IMX227",
            did: "fuchsia.sony.platform.BIND_PLATFORM_DEV_DID.CAMERA_SENSOR",
          },
        ],
      },
    },
  ],
}
