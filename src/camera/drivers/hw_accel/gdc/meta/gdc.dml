{
  name: "gdc",
  include: [
    "//sdk/lib/driver/compat/compat.shard.cml",
  ],
  program: {
    colocate: "true",
    compat: "driver/gdc.so",
    default_dispatcher_opts: [
      "allow_sync_calls",
    ],
  },
  use: [
    {
      protocol: "fuchsia.camera.BIND_PROTOCOL.CAMERA_SENSOR_2",
      name: "camera-sensor",
      primary: true,
      bind: {
        protocol: "fuchsia.camera.BIND_PROTOCOL.CAMERA_SENSOR_2",
      },
    },
    {
      protocol: "fuchsia.platform.BIND_PROTOCOL.DEVICE",
      name: "pdev",
      bind: {
        one_of: [
          {
            compat: "arm,mali-gdc",
          },
          {
            protocol: "fuchsia.platform.BIND_PROTOCOL.DEVICE",
            vid: "fuchsia.arm.platform.BIND_PLATFORM_DEV_VID.ARM",
            pid: "fuchsia.arm.platform.BIND_PLATFORM_DEV_PID.GDC",
            did: "fuchsia.arm.platform.BIND_PLATFORM_DEV_DID.MALI_IV010",
          },
        ],
      },
    },
  ],
}
