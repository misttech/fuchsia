{
    name: "usb_video",
    include: [],
    program: {
        binary: "driver/usb_video.so",
        colocate: "true",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        bind: {
            protocol: "fuchsia.usb.BIND_PROTOCOL.INTERFACE_ASSOCIATION",
            usb: {
                class: "fuchsia.usb.BIND_USB_CLASS.VIDEO",
                subclass: "fuchsia.usb.video.BIND_USB_SUBCLASS.VIDEO_INTERFACE_COLLECTION",
                protocol: "fuchsia.usb.video.BIND_USB_PROTOCOL.UNDEFINED",
            },
        },
    },
    capabilities: [
        { service: "fuchsia.hardware.camera.Service" },
    ],
    use: [
        {
            name: "default",
            service: "fuchsia.driver.compat.Service",
            generate_bind_rule: false,
        },
    ],
    expose: [
        {
            service: "fuchsia.hardware.camera.Service",
            from: "self",
        },
    ],
}
