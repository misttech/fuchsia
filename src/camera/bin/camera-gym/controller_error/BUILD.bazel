load("//build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")
load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

fx_cc_library(
    name = "lib",
    srcs = ["controller_error.cc"],
    hdrs = ["controller_error.h"],
    implementation_deps = [
        "//sdk/lib/sys/cpp",
        "//sdk/lib/syslog/cpp",
        "//src/lib/fxl",
    ],
    visibility = ["//src/camera/bin/camera-gym/controller_client:__pkg__"],
    deps = ["//src/camera/bin/camera-gym/fidl:controller_hlcpp"],
    alwayslink = True,
)

fx_cc_binary(
    name = "camera_gym_controller_error_unittest_bin",
    testonly = True,
    srcs = ["controller_error_unittest.cc"],
    tags = ["manual"],
    deps = [
        ":lib",
        "//src/lib/fxl/test:gtest_main",
    ],
)

fx_unittest_package(
    name = "camera_gym_controller_error_unittest",
    unit_tests = [":camera_gym_controller_error_unittest_bin"],
    visibility = ["//src/camera:__pkg__"],
)
