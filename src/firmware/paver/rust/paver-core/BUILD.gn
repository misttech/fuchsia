import("//build/components.gni")
import("//build/rust/rustc_library.gni")

rustc_library("paver-core") {
  crate_name = "paver_core"
  edition = "2024"
  with_unit_tests = true

  configs += [ "//build/config/rust:bootfs" ]

  deps = [
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust_next",
    "//sdk/fidl/fuchsia.mem:fuchsia.mem_rust_next",
    "//sdk/fidl/fuchsia.paver:fuchsia.paver_rust_next",
    "//sdk/fidl/fuchsia.process.lifecycle:fuchsia.process.lifecycle_rust_next",
    "//sdk/rust/zx",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fidl/rust_next/fidl_next",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//src/lib/fuchsia-runtime",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
  ]

  test_deps = [ "//src/lib/fuchsia" ]

  sources = [
    "src/boot_manager.rs",
    "src/data_sink.rs",
    "src/lib.rs",
    "src/paver.rs",
    "src/sysconfig.rs",
  ]
}

fuchsia_unittest_package("paver-core-tests") {
  deps = [ ":paver-core_test" ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}

group("tests") {
  testonly = true
  deps = [ ":paver-core-tests" ]
}
