import("//build/bazel/bazel_test_suite.gni")

group("settings") {
  testonly = true
  deps = [
    ":tests",
    "config",
    "inspect_utils",
    "service",
    "storage",
  ]
}

bazel_test_suite("bazel_tests") {
  target_tests = [ "//src/settings:target_tests" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    "accessibility:tests",
    "audio:tests",
    "camera:tests",
    "camera_watcher_agent:tests",
    "common:tests",
    "config:tests",
    "display:tests",
    "do_not_disturb:tests",
    "factory_reset:tests",
    "input:tests",
    "inspect_utils:tests",
    "intl:tests",
    "keyboard:tests",
    "light:tests",
    "media_buttons:tests",
    "night_mode:tests",
    "privacy:tests",
    "service:tests",
    "setup:tests",
    "storage:tests",
    "test_common:tests",
  ]
}
