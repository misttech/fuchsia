rustc_library("settings_inspect_utils") {
  sources = [
    "src/joinable_inspect_vecdeque.rs",
    "src/lib.rs",
    "src/managed_inspect_map.rs",
    "src/managed_inspect_queue.rs",
  ]
  configs += [ "//build/config/rust/lints:deny_unused_results" ]
  edition = "2024"
  lint_config = "//build/config/rust/lints:clippy_warn_all"
  visibility = [
    ":*",
    "//src/settings/*",
  ]
  deps = [
    "//src/lib/diagnostics/inspect/derive",
    "//src/lib/diagnostics/inspect/rust",
  ]
}
if (is_fuchsia) {
  rustc_test("settings_inspect_utils_lib_test") {
    sources = [
      "src/joinable_inspect_vecdeque.rs",
      "src/lib.rs",
      "src/managed_inspect_map.rs",
      "src/managed_inspect_queue.rs",
    ]
    edition = "2024"
    deps = [
             "//src/lib/diagnostics/inspect/derive",
             "//src/lib/diagnostics/inspect/rust",
           ] + [
             "//src/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
             "//src/lib/fuchsia",
           ]
    configs += [ "//build/config/rust/lints:deny_unused_results" ]
    lint_config = "//build/config/rust/lints:clippy_warn_all"
  }
}

fuchsia_component_manifest("settings_inspect_utils_tests_manifest") {
  testonly = true
  component_name = "settings_inspect_utils_test"
  manifest = "meta/settings_inspect_utils_tests.cml"
}

fuchsia_test_component("settings_inspect_utils_tests_component") {
  cm_label = ":settings_inspect_utils_tests_manifest"
  component_name = "settings_inspect_utils_test"
  deps = [ ":settings_inspect_utils_lib_test" ]
}

fuchsia_test_package("settings_inspect_utils_tests-package") {
  package_name = "settings_inspect_utils_tests-gn"
  test_components = [ ":settings_inspect_utils_tests_component" ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}
