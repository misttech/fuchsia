{
    include: [
        // Enable system logging
        "syslog/client.shard.cml",
    ],
    program: {
        runner: "elf",
        binary: "bin/hwinfo",
        lifecycle: { stop_event: "notify" },
    },
    capabilities: [
        {
            protocol: [
                "fuchsia.hwinfo.Board",
                "fuchsia.hwinfo.Device",
                "fuchsia.hwinfo.Product",
            ],
            delivery: "on_readable",
        },
    ],
    use: [
        {
            protocol: "fuchsia.factory.MiscFactoryStoreProvider",
            availability: "optional",
        },
        { protocol: "fuchsia.boot.Items" },
        {
            protocol: "fuchsia.hwinfo.Board",
            from: "self",
            path: "/escrow/fuchsia.hwinfo.Board",
        },
        {
            protocol: "fuchsia.hwinfo.Device",
            from: "self",
            path: "/escrow/fuchsia.hwinfo.Device",
        },
        {
            protocol: "fuchsia.hwinfo.Product",
            from: "self",
            path: "/escrow/fuchsia.hwinfo.Product",
        },
        {
            directory: "config-data",
            rights: [ "r*" ],
            path: "/config/data",
        },
        {
            config: "fuchsia.hwinfo.ProductName",
            key: "product_name",
            type: "string",
            max_size: 40,
            availability: "optional",
            default: "default-fuchsia",
        },
        {
            config: "fuchsia.hwinfo.ProductModel",
            key: "product_model",
            type: "string",
            max_size: 40,
            availability: "optional",
            default: "default-model",
        },
        {
            config: "fuchsia.hwinfo.ProductManufacturer",
            key: "product_manufacturer",
            type: "string",
            max_size: 40,
            availability: "optional",
            default: "default-manufacturer",
        },
    ],
    expose: [
        {
            protocol: [
                "fuchsia.hwinfo.Board",
                "fuchsia.hwinfo.Device",
                "fuchsia.hwinfo.Product",
            ],
            from: "self",
        },
    ],
}
