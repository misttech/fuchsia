{
    include: [
        "//sdk/lib/syslog/client.shard.cml",
        "inspect/offer.shard.cml",
    ],
    children: [
        {
            name: "hwinfo_positive_tests_test_driver",
            url: "fuchsia-pkg://fuchsia.com/hwinfo_positive_tests#meta/hwinfo_positive_tests_test_driver.cm",
        },
        {
            name: "misc",
            url: "fuchsia-pkg://fuchsia.com/hwinfo_positive_tests#meta/fake_factory_store_providers.cm",
        },
        {
            name: "protocol",
            url: "fuchsia-pkg://fuchsia.com/hwinfo_positive_tests#meta/hwinfo.cm",
        },
    ],
    capabilities: [
        {
            config: "fuchsia.hwinfo.ProductName",
            type: "string",
            max_size: 40,
            value: "test_product_name",
        },
        {
            config: "fuchsia.hwinfo.ProductModel",
            type: "string",
            max_size: 40,
            value: "test_product_model",
        },
        {
            config: "fuchsia.hwinfo.ProductManufacturer",
            type: "string",
            max_size: 40,
            value: "test_manufacturer",
        },
    ],
    offer: [
        {
            config: [
                "fuchsia.hwinfo.ProductManufacturer",
                "fuchsia.hwinfo.ProductModel",
                "fuchsia.hwinfo.ProductName",
            ],
            from: "self",
            to: [ "#protocol" ],
        },
        {
            protocol: "fuchsia.factory.MiscFactoryStoreProvider",
            from: "#misc",
            to: [ "#protocol" ],
        },
        {
            protocol: [
                "fuchsia.hwinfo.Board",
                "fuchsia.hwinfo.Device",
                "fuchsia.hwinfo.Product",
            ],
            from: "#protocol",
            to: [ "#hwinfo_positive_tests_test_driver" ],
        },
        {
            directory: "pkg",
            from: "framework",
            as: "config-data",
            to: [ "#misc" ],
            subdir: "fake_factory_store_providers",
        },
        {
            directory: "pkg",
            from: "framework",
            as: "config-data",
            to: [ "#protocol" ],
            subdir: "hwinfo_positive_tests",
        },
    ],
    expose: [
        {
            protocol: "fuchsia.test.Suite",
            from: "#hwinfo_positive_tests_test_driver",
        },
    ],
}
