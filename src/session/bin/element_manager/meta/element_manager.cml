{
    include: [ "syslog/client.shard.cml" ],
    program: {
        runner: "elf",
        binary: "bin/element_manager",
    },
    capabilities: [
        {
            protocol: [ "fuchsia.element.Manager" ],
        },
    ],
    use: [
        {
            protocol: [ "fuchsia.element.GraphicalPresenter" ],
        },
        {
            protocol: "fuchsia.component.Realm",
            from: "parent",
        },
        {
            storage: "data",
            path: "/data",
            availability: "optional",
        },
        {
            // A list of mappings from component URL to collection in which components with that URL
            // should run. The URL and collection name are separated by a | character.
            //
            // For instance, one entry might be:
            //     "fuchsia-pkg://chromium.org/chrome#meta/chrome.cm|chrome_collection"
            config: "fuchsia.element.UrlToCollection",
            key: "url_to_collection",
            type: "vector",
            max_count: 100,
            element: {
                type: "string",
                max_size: 512,
            },

            // TODO(https://fxbug.dev/570667502): Upgrade to "optional" once out-of-tree session parents route this config.
            availability: "transitional",
            default: [],
        },
        {
            // The collection in which any components not listed in `url_to_collection` should be run.
            config: "fuchsia.element.DefaultCollection",
            key: "default_collection",
            type: "string",
            max_size: 512,

            // TODO(https://fxbug.dev/570667502): Upgrade to "optional" once out-of-tree session parents route this config.
            availability: "transitional",
            default: "elements",
        },
    ],
    expose: [
        {
            protocol: [ "fuchsia.element.Manager" ],
            from: "self",
        },
    ],
}
