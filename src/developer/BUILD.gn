import("//build/bazel/bazel_test_suite.gni")

group("developer") {
  testonly = true
  deps = [
    ":tests",
    "console",
    "debug",
    "ffx",
    "forensics",
    "fuchsia-controller",
    "fuchsia-criterion",
    "lib",
    "remote-control",
  ]
}

group("tests") {
  testonly = true

  deps = [
    ":bazel_tests",
    "adb:tests",
    "build_info:tests",
    "console:tests",
    "debug:tests",
    "ffx:tests",
    "forensics:tests",
    "fuchsia-controller:tests",
    "fuchsia-criterion:tests",
    "hw_info:tests",
    "lib:tests",
    "memory:tests",
    "process_explorer:tests",
    "remote-control:tests",
    "sshd-host:tests",
    "sys_info:tests",
    "vsock-sshd-host:tests",
  ]
}

bazel_test_suite("bazel_tests") {
  host_tests = [ "//src/developer:developer_host_tests" ]
}

group("e2e_tests") {
  testonly = true
  deps = [ "ffx:e2e_tests" ]
}
