{
  "name": "list",
  "description": "List drivers",
  "examples": [
    "To list all drivers:\n\n    $ driver list\n\nTo list only loaded drivers:\n\n    $ driver list --loaded\n\nTo list only loaded and running drivers:\n\n    $ driver list --running"
  ],
