{
  "name": "scroll",
  "description": "Scroll the mouse wheel along one axis.",
  "examples": [
    "  $ ffx emu input mouse scroll --dy 3\n  $ ffx emu input mouse scroll --dx -1"
  ],
  "flags": [
    {
      "kind": "Switch",
      "optionality": "optional",
