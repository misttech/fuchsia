          "arg_name": "dy"
        }
      },
      "optionality": "optional",
      "long": "--dy",
      "short": null,
      "description": "vertical wheel ticks. Positive scrolls up.",
      "hidden": false
    },
    {
      "kind": {
        "Option": {
          "arg_name": "dx"
        }
      },
      "optionality": "optional",
      "long": "--dx",
