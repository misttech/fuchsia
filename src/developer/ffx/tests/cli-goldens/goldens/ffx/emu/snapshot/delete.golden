{
  "name": "delete",
  "description": "Delete snapshots of a Fuchsia emulator.",
  "examples": [
    "  $ ffx emu snapshot delete booted\n  $ ffx emu snapshot delete booted --name fuchsia-emulator\n  $ ffx emu snapshot delete --all"
  ],
  "flags": [
    {
      "kind": "Switch",
      "optionality": "optional",
      "long": "--help",
      "short": null,
      "description": "display usage information",
      "hidden": false
    },
    {
      "kind": "Switch",
      "optionality": "optional",
      "long": "--all",
      "short": null,
      "description": "delete all of the emulator's snapshots.",
      "hidden": false
    },
    {
      "kind": {
        "Option": {
          "arg_name": "name"
        }
      },
      "optionality": "optional",
      "long": "--name",
      "short": null,
      "description": "name of the emulator to delete the snapshot of, as specified to the start command. See a list of available instances by running `ffx emu list`. If no name is specified, and only one emulator is running, it will be selected.",
      "hidden": false
    }
  ],
  "notes": [
    "The emulator does not have to be running. Deleting a snapshot frees the disk\nspace which it took up in the emulator's disk image. --all deletes all of the\nemulator's snapshots, and keeps the emulator instance."
  ],
  "commands": [],
  "positionals": [
    {
      "name": "snapshot",
      "description": "name of the snapshot to delete, as specified to `ffx emu snapshot save`.",
      "optionality": "optional",
      "hidden": false
    }
  ],
  "error_codes": []
}