import("//build/rust/rustc_library.gni")

assert(
    is_host,
    "ffx_fastboot_transport_interface is for use with the host toolchain only")

group("ffx_fastboot_transport_interface") {
  public_deps = [ ":lib" ]
}

group("tests") {
  testonly = true
  deps = [ ":lib_test" ]
}

