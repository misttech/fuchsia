import("//build/tools/bazel2gn/bazel_migration.gni")

if (is_host) {
  rustc_library("lib") {
    sources = [
      "src/error.rs",
      "src/lib.rs",
      "src/recorder.rs",
    ]
    crate_name = "doctor_utils"
    edition = "2024"
    visibility = [
      ":*",
      "//src/developer/ffx/plugins/doctor:*",
      "//vendor/google/*",
    ]
    deps = [
      "//third_party/rust_crates:chrono",
      "//third_party/rust_crates:log",
      "//third_party/rust_crates:schemars",
      "//third_party/rust_crates:serde",
      "//third_party/rust_crates:termion",
      "//third_party/rust_crates:thiserror",
      "//third_party/rust_crates:zip",
    ]
  }
}
if (is_host) {
  rustc_test("lib_test") {
    sources = [
      "src/error.rs",
      "src/lib.rs",
      "src/recorder.rs",
    ]
    edition = "2024"
    deps = [
             "//third_party/rust_crates:chrono",
             "//third_party/rust_crates:log",
             "//third_party/rust_crates:schemars",
             "//third_party/rust_crates:serde",
             "//third_party/rust_crates:termion",
             "//third_party/rust_crates:thiserror",
             "//third_party/rust_crates:zip",
           ] +
           [
             "//src/lib/fuchsia",
             "//third_party/rust_crates:anyhow",
             "//third_party/rust_crates:tempfile",
           ]
    output_name = "doctor_utils_lib_test"
    visibility = [
      ":*",
      "//src/developer/ffx:*",
    ]
  }
}
