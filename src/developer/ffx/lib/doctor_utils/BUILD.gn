assert(is_host, "doctor_utils is for use with the host toolchain only")

group("tests") {
  testonly = true

  deps = [ ":lib_test" ]
}

group("doctor_utils") {
  testonly = true

  deps = [
    ":lib",
    ":tests",
  ]
}

