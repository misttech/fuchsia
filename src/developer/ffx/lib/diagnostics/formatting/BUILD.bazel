load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "lib",
    srcs = ["src/lib.rs"],
    crate_name = "ffx_diagnostics_formatting",
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = [
        "//src/developer/ffx/lib/diagnostics/checks:__pkg__",
        "//src/developer/ffx/lib/target:__pkg__",
    ],
    deps = [
        "//src/developer/ffx/lib/addr:lib",
        "//src/developer/ffx/lib/discovery:lib",
        "//src/developer/ffx/lib/errors:lib",
        "//src/developer/ffx/lib/safe_string:lib",
        "//src/lib/agents:lib",
    ],
)

host_rustc_test(
    name = "lib_test",
    crate = ":lib",
    crate_name = "ffx_diagnostics_formatting_lib_test",
    edition = "2024",
)
