load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "lib",
    srcs = ["src/lib.rs"],
    crate_name = "mdns_discovery",
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//src/developer/ffx/lib/discovery:__pkg__"],
    deps = [
        "//src/developer/ffx/lib/netext:lib",
        "//src/developer/ffx/lib/target_errors:lib",
        "//src/developer/ffx/lib/timeout:lib",
        "//src/lib/fuchsia-async",
        "//src/lib/mdns/rust:mdns",
        "//src/lib/network/packet",
        "//third_party/rust_crates/vendor:async-channel",
        "//third_party/rust_crates/vendor:async-lock",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:socket2",
        "//third_party/rust_crates/vendor:thiserror",
        "//third_party/rust_crates/vendor:tokio",
        "//third_party/rust_crates/vendor:zerocopy",
    ],
)

host_rustc_test(
    name = "lib_test",
    crate = ":lib",
    crate_name = "mdns_discovery_lib_test",
    edition = "2024",
    visibility = ["//src/developer/ffx:__pkg__"],
    deps = [
        "//src/lib/fuchsia",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:static_assertions",
    ],
)
