import("//build/rust/rustc_library.gni")

assert(is_host, "safe_string is for use with the host toolchain only")

rustc_library("lib") {
  name = "safe_string"
  version = "0.1.0"
  edition = "2024"
  with_unit_tests = true
  sources = [ "src/lib.rs" ]
  deps = [ "//third_party/rust_crates:serde" ]
  test_deps = [
    "//third_party/rust_crates:assert_matches",
    "//third_party/rust_crates:serde_json",
  ]
}

group("tests") {
  testonly = true

  deps = [ ":lib_test" ]
}

group("safe_string") {
  testonly = true

  deps = [
    ":lib",
    ":tests",
  ]
}
