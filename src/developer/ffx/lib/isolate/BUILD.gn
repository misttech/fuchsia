import("//build/tools/bazel2gn/bazel_migration.gni")

if (is_host) {
  rustc_library("lib") {
    sources = [ "src/lib.rs" ]
    crate_name = "ffx_isolate"
    edition = "2024"
    rustenv = [
      "SUBTOOL_SEARCH_HOST_TOOLS=${_subtool_search_host_tools}",
      "SUBTOOL_SEARCH_TEST_DATA=${_subtool_search_test_data}",
    ]
    test_deps = [ "//src/lib/fuchsia" ]
    version = "0.1.0"
    visibility = [
      ":*",
      "//src/developer/ffx/*",
    ]
    with_unit_tests = true
    deps = [
      "//src/developer/ffx/config:lib",
      "//src/developer/ffx/lib/executor:lib",
      "//src/developer/ffx/lib/sdk:lib",
      "//third_party/rust_crates:serde",
      "//third_party/rust_crates:serde_json",
      "//third_party/rust_crates:tempfile",
      "//third_party/rust_crates:thiserror",
    ]
  }
}
