load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "lib",
    srcs = [
        "src/errors.rs",
        "src/lib.rs",
    ],
    crate_name = "uart_driver_api",
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = [
        "//src/developer/ffx/lib/discovery:__pkg__",
        "//src/developer/ffx/lib/target:__pkg__",
        "//src/developer/ffx/tools/uart:__pkg__",
        "//src/developer/ffx/tools/uart_driver:__subpackages__",
    ],
    deps = [
        "//src/developer/ffx/config:lib",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:serde_json",
        "//third_party/rust_crates/vendor:sha2",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)

host_rustc_test(
    name = "lib_test",
    crate = ":lib",
    crate_name = "uart_driver_api_lib_test",
    edition = "2024",
    visibility = ["//src/developer/ffx:__pkg__"],
    deps = [
        "//src/lib/fuchsia",
        "//third_party/rust_crates/vendor:tempfile",
    ],
)
