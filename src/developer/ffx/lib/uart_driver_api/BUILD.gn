if (is_host) {
  group("uart_driver_api") {
    public_deps = [ ":lib" ]
  }

  group("tests") {
    testonly = true
    deps = [ ":lib_test" ]
  }
} else {
  group("tests") {
    testonly = true
    deps = [ ":tests($host_toolchain)" ]
  }
}

