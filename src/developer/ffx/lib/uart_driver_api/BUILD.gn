if (is_host) {
  rustc_library("lib") {
    sources = [
      "src/errors.rs",
      "src/lib.rs",
    ]
    crate_name = "uart_driver_api"
    edition = "2024"
    visibility = [
      ":*",
      "//src/developer/ffx/lib/discovery:*",
      "//src/developer/ffx/lib/target:*",
      "//src/developer/ffx/tools/uart:*",
      "//src/developer/ffx/tools/uart_driver/*",
    ]
    deps = [
      "//src/developer/ffx/config:lib",
      "//src/developer/ffx/lib/emulator_instance:lib",
      "//third_party/rust_crates:serde",
      "//third_party/rust_crates:serde_json",
      "//third_party/rust_crates:sha2",
      "//third_party/rust_crates:thiserror",
    ]
  }
}
if (is_host) {
  rustc_test("lib_test") {
    sources = [
      "src/errors.rs",
      "src/lib.rs",
    ]
    edition = "2024"
    deps = [
             "//src/developer/ffx/config:lib",
             "//src/developer/ffx/lib/emulator_instance:lib",
             "//third_party/rust_crates:serde",
             "//third_party/rust_crates:serde_json",
             "//third_party/rust_crates:sha2",
             "//third_party/rust_crates:thiserror",
           ] +
           [
             "//src/lib/fuchsia",
             "//third_party/rust_crates:tempfile",
           ]
    output_name = "uart_driver_api_lib_test"
    visibility = [
      ":*",
      "//src/developer/ffx:*",
    ]
  }
}
