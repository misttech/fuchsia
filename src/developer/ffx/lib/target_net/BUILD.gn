import("//build/bazel/bazel_test_suite.gni")

assert(is_host, "only host is supported")

group("target_net") {
  testonly = true

  deps = [
    ":lib",
    ":tests",
    ":testutil",
  ]
}

bazel_test_suite("bazel_tests") {
  host_tests = [ "//src/developer/ffx/lib/target_net:testutil_test" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    ":testutil_test",
  ]
}

group("host_tests") {
  testonly = true
  deps = [ "tests:host_tests" ]
}

