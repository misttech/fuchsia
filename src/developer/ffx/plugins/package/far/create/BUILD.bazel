load("//src/developer/ffx/build:ffx_plugin.bzl", "ffx_plugin")

package(default_applicable_licenses = ["//:license"])

ffx_plugin(
    name = "ffx_package_far_create",
    srcs = ["src/lib.rs"],
    args_deps = [
        "//src/developer/ffx/core:lib",
        "//third_party/rust_crates/vendor:argh",
    ],
    args_srcs = ["src/args.rs"],
    edition = "2024",
    sdk_category = "not-yet-specified",
    version = "0.1.0",
    visibility = ["//src/developer/ffx/plugins/package/far:__pkg__"],
    deps = [
        "//src/developer/ffx/lib/fho:lib",
        "//src/developer/ffx/lib/writer:lib",
        "//src/sys/pkg/lib/far/rust:fuchsia-archive",
        "//third_party/rust_crates/vendor:walkdir",
    ],
