load("//src/developer/ffx/build:ffx_plugin.bzl", "ffx_plugin")
load("//src/developer/ffx/build:ffx_tool.bzl", "ffx_tool")

package(default_applicable_licenses = ["//:license"])

ffx_plugin(
    name = "ffx_platform",
    args_deps = [
        "//src/developer/ffx/core:lib",
        "//third_party/rust_crates/vendor:argh",
    ],
    args_srcs = ["src/args.rs"],
    edition = "2024",
    plugin_deps = ["//src/developer/ffx/plugins/platform/preflight:ffx_preflight"],
    sdk_category = "not-yet-specified",
    version = "0.1.0",
    visibility = ["//src/developer/ffx:__subpackages__"],
)

ffx_tool(
    name = "ffx_platform_tool",
    srcs = ["src/main.rs"],
    binary_name = "ffx-platform",
    edition = "2024",
    deps = [
        ":ffx_platform_suite",
        "//src/lib/fuchsia-async",
    ],
)
