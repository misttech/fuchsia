{
  name: "usb-adb-function",
  include: [],
  program: {
    binary: "driver/usb-adb-function.so",
    colocate: "true",
    default_dispatcher_opts: [
      "allow_sync_calls",
    ],
    bind: {
      protocol: "fuchsia.usb.BIND_PROTOCOL.FUNCTION",
      rules: {
        "fuchsia.BIND_USB_CLASS": "fuchsia.usb.BIND_USB_CLASS.VENDOR_SPECIFIC",
        "fuchsia.BIND_USB_PROTOCOL": "fuchsia.google.platform.usb.BIND_USB_PROTOCOL.ADB",
        "fuchsia.BIND_USB_SUBCLASS": "fuchsia.google.platform.usb.BIND_USB_SUBCLASS.ADB",
      },
    },
  },
  capabilities: [
    {
      service: "fuchsia.hardware.adb.Service",
    },
  ],
  expose: [
    {
      service: "fuchsia.hardware.adb.Service",
      from: "self",
    },
  ],
  use: [
    {
      service: "fuchsia.driver.compat.Service",
      name: "default",
      generate_bind_rule: false,
    },
    {
      service: "fuchsia.hardware.usb.function.UsbFunctionService",
      name: "default",
      generate_bind_rule: false,
    },
    {
      protocol: "fuchsia.hardware.usb.endpoint.Endpoint",
    },
  ],
}
