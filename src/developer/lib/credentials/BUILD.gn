import("//build/tools/bazel2gn/bazel_migration.gni")

if (is_host) {
  rustc_library("lib") {
    sources = [ "src/lib.rs" ]
    crate_name = "credentials"
    edition = "2024"
    visibility = [
      ":*",
      "//src/developer/ffx/*",
      "//src/developer/lib:*",
      "//src/lib/assembly/product_bundle:*",
    ]
    deps = [
      "//src/lib/gcs",
      "//third_party/rust_crates:anyhow",
      "//third_party/rust_crates:home",
      "//third_party/rust_crates:log",
      "//third_party/rust_crates:serde",
      "//third_party/rust_crates:serde_json",
    ]
  }
}
if (is_host) {
  rustc_test("lib_test") {
    sources = [ "src/lib.rs" ]
    edition = "2024"
    deps = [
             "//src/lib/gcs",
             "//third_party/rust_crates:anyhow",
             "//third_party/rust_crates:home",
             "//third_party/rust_crates:log",
             "//third_party/rust_crates:serde",
             "//third_party/rust_crates:serde_json",
           ] +
           [
             "//src/lib/fuchsia-async",
             "//src/lib/testing/temp_test_env:lib",
             "//third_party/rust_crates:serial_test",
           ]
    output_name = "credentials_lib_test"
    visibility = [
      ":*",
      "//src/developer:*",
    ]
  }
}
