import("//build/bazel/bazel_test_suite.gni")
import("testing/gki_pkvm_boot_test.gni")
import("testing/pkvm_test_product_bundle.gni")

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    "tee:tests",
  ]
}

bazel_test_suite("bazel_tests") {
  target_tests = [ "//src/microfuchsia:target_tests" ]
}

group("boot_tests") {
  testonly = true
  deps = []
  if (current_cpu == "arm64") {
    deps += [ ":pkvm-hello-world-test" ]
  }
}

if (current_cpu == "arm64") {
  # Basic boot exercise of the linux boot shim and a small ZBI.
  gki_pkvm_boot_test("pkvm-hello-world-test") {
    init = "testing:linux-test-init-crosvm-exec"
    product_bundle = ":hello-world-pkvm-test-product-bundle"
  }

  pkvm_test_product_bundle("hello-world-pkvm-test-product-bundle") {
    zbi = "//zircon/kernel/phys/test:zbi-hello-world-test.zbi"
  }
}
