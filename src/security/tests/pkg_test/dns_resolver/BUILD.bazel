load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load("//build/bazel/rules/packages:fx_packaged_binary.bzl", "fx_packaged_binary")
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")

package(default_applicable_licenses = ["//:license"])

rustc_binary(
    name = "security_pkg_dns_resolver-binary",
    testonly = True,
    srcs = ["src/main.rs"],
    crate_name = "security_pkg_dns_resolver",
    edition = "2024",
    tags = ["manual"],
    deps = [
        "//sdk/fidl/fuchsia.net:fuchsia.net_rust",
        "//sdk/fidl/fuchsia.net.name:fuchsia.net.name_rust",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/security/tests/pkg_test/util",
        "//third_party/rust_crates/vendor:argh",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
    ],
)

fx_packaged_binary(
    name = "security_pkg_dns_resolver-binary_packaged",
    testonly = True,
    binary = ":security_pkg_dns_resolver-binary",
    binary_name = "security_pkg_dns_resolver",
)

fx_component_manifest(
    name = "security_pkg_dns_resolver-manifest",
    testonly = True,
    component_name = "security_pkg_dns_resolver",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/security_pkg_dns_resolver.cml",
)

# Note: Test package must include all files designated by cmdline args in
# component manifest. See cml and source for details. These files are not
# included as explicit deps here because they vary across different
# packagings/configurations of the test.
fx_component(
    name = "security_pkg_dns_resolver-component",
    testonly = True,
    compiled_manifest = ":security_pkg_dns_resolver-manifest",
    component_name = "security_pkg_dns_resolver",
    visibility = ["//src/security/tests/pkg_test/tests:__subpackages__"],
    deps = [":security_pkg_dns_resolver-binary_packaged"],
)
