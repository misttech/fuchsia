load("//build/bazel/rules/fidl:fidl_library.bzl", "fidl_library")
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")

package(default_applicable_licenses = ["//:license"])

rustc_binary(
    name = "pkg_server-binary",
    testonly = True,
    srcs = ["src/main.rs"],
    crate_name = "pkg_server",
    edition = "2024",
    visibility = ["//src/security/tests/pkg_test/tests:__pkg__"],
    deps = [
        ":test.security.pkg_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-fs",
        "//src/lib/fuchsia-hyper",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:argh",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:http-body-util",
        "//third_party/rust_crates/vendor:hyper",
        "//third_party/rust_crates/vendor:hyper-util",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:rustls",
        "//third_party/rust_crates/vendor:rustls-pemfile",
        "//third_party/rust_crates/vendor:tokio-rustls",
    ],
)

fidl_library(
    name = "test.security.pkg",
    testonly = True,
    srcs = ["fidl/pkg_server.fidl"],
    visibility = [
        "//src/security/tests/pkg_test/tests/access_ota_blob_as_executable:__pkg__",
        "//src/security/tests/pkg_test/tests/bad_signature_update:__pkg__",
    ],
)
