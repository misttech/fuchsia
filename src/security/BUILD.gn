import("//build/bazel/bazel_test_suite.gni")

bazel_test_suite("bazel_tests") {
  target_tests = [ "//src/security:target_tests" ]
}

group("security") {
  testonly = true
  deps = [ ":tests" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    "bin:tests",
    "lib:tests",
    "tests/",
    "tools:tests",
  ]
}

if (is_host) {
  group("host_tests") {
    testonly = true
    deps = [
      "lib:host_tests",
      "tests:host_tests",
    ]
  }
}
