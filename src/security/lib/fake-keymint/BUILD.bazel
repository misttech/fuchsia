load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load(
    "//build/bazel/rules/testing:fx_unittest_package.bzl",
    "fx_unittest_package",
)

package(default_applicable_licenses = ["//:license"])

# fake-keymint is insecure and should only be used in tests
rustc_library(
    name = "fake-keymint",
    testonly = True,
    srcs = ["src/lib.rs"],
    edition = "2024",
    # rustc_library.bzl defaults lint_config to clippy_warn_production even when
    # testonly = True, whereas GN rustc_artifact.gni skips clippy_warn_production
    # on testonly = true targets.
    # @bazel2gn:skip
    lint_config = "//build/config/rust/lints:clippy_warn_default",
    visibility = [
        "//src/storage/fshost/integration:__pkg__",
        "//vendor/google:__subpackages__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.security.keymint:fuchsia.security.keymint_rust",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-sync",
        "//third_party/rust_crates/vendor:aes-gcm-siv",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
    ],
)

rustc_test(
    name = "fake_keymint_lib_test",
    crate = ":fake-keymint",
    deps = ["//src/lib/fuchsia"],
)

fx_unittest_package(
    name = "fake-keymint-tests",
    unit_tests = [":fake_keymint_lib_test"],
    visibility = ["//src/security:__pkg__"],
)
