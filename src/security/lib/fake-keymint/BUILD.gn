rustc_library("fake-keymint") {
  testonly = true
  sources = [ "src/lib.rs" ]
  edition = "2024"
  visibility = [
    ":*",
    "//src/storage/fshost/integration:*",
    "//vendor/google/*",
  ]
  deps = [
    "//sdk/fidl/fuchsia.security.keymint:fuchsia.security.keymint_rust",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia-sync",
    "//third_party/rust_crates:aes-gcm-siv",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
  ]
}

rustc_test("fake_keymint_lib_test") {
  sources = [ "src/lib.rs" ]
  edition = "2024"
  deps = [
           "//sdk/fidl/fuchsia.security.keymint:fuchsia.security.keymint_rust",
           "//src/lib/fidl/rust/fidl",
           "//src/lib/fuchsia-sync",
           "//third_party/rust_crates:aes-gcm-siv",
           "//third_party/rust_crates:anyhow",
           "//third_party/rust_crates:futures",
           "//third_party/rust_crates:log",
         ] + [ "//src/lib/fuchsia" ]
}

fuchsia_unittest_package("fake-keymint-tests") {
  package_name = "fake-keymint-tests-gn"
  component_name = "fake-keymint-tests"
  deps = [ ":fake_keymint_lib_test" ]
  visibility = [
    ":*",
    "//src/security:*",
  ]
}
