import("//build/testing/environments.gni")

group("fdr") {
  testonly = true
  deps = [
    ":fdr_lib_unittests",
    ":system_recovery_fdr",
  ]
}

bazel_test_suite("bazel_tests") {
  target_tests = [
    "//src/recovery/system:fdr_lib_unittests",
    "//src/recovery/system:ota_lib_unittests",
    "//src/recovery/system:system_recovery_fdr_unittests",
  ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    ":fdr_lib_unittests",
    ":ota_lib_unittests",
    ":system_recovery_fdr_unittests",
    "android:system_recovery_android_unittests",
  ]
}

resource("roboto_regular") {
  sources = [ "//prebuilt/third_party/fonts/roboto/Roboto-Regular.ttf" ]
  outputs = [ "data/fonts/Roboto-Regular.ttf" ]
}

fuchsia_package("system_recovery_fdr") {
  deps = [
    ":component_fdr",
    ":roboto_regular",
  ]
}

fuchsia_component("component_android") {
  component_name = "system_recovery_android"
  manifest = "meta/system_recovery_android.cml"
  deps = [ "android:bin" ]
}

fuchsia_package("system_recovery_android") {
  deps = [
    ":component_android",
    ":roboto_regular",
    "//src/sys/pkg/lib/isolated-swd:pkg-component",
  ]
}

