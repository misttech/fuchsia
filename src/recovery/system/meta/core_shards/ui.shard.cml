{
    offer: [
        {
            protocol: "fuchsia.vulkan.loader.Loader",
            from: "#vulkan_loader",
            to: "#system_recovery",
        },
        {
            service: "fuchsia.hardware.display.Service",
            from: "parent",
            to: "#system_recovery",
        },
        {
            service: "fuchsia.input.report.Service",
            from: "parent",
            to: "#system_recovery",
        },
    ],
}
