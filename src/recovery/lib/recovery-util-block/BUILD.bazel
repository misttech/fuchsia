load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

# This is a separate target so it can be depended on without pulling in all
# of //src/recovery/system:ota_lib, which in turn pulls in rustls, webpki,
# and ring, when ring's assembly has some constraints around linking.
rustc_library(
    name = "recovery-util-block",
    srcs = ["src/lib.rs"],
    edition = "2024",
    visibility = [
        "//src/firmware/lib/fastboot/rust:__pkg__",
        "//src/recovery/lib/installer:__pkg__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.device:fuchsia.device_rust",
        "//sdk/fidl/fuchsia.storage.block:fuchsia.storage.block_rust",
        "//sdk/rust/zx",
        "//src/lib/fuchsia-component",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
    ],
)
