load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "installer",
    srcs = [
        "src/lib.rs",
        "src/partition.rs",
    ],
    edition = "2024",
    visibility = ["//src/firmware/lib/fastboot/rust:__pkg__"],
    deps = [
        "//sdk/fidl/fuchsia.hardware.power.statecontrol:fuchsia.hardware.power.statecontrol_rust",
        "//sdk/fidl/fuchsia.mem:fuchsia.mem_rust",
        "//sdk/fidl/fuchsia.paver:fuchsia.paver_rust",
        "//sdk/fidl/fuchsia.storage.block:fuchsia.storage.block_rust",
        "//sdk/fidl/fuchsia.sysinfo:fuchsia.sysinfo_rust",
        "//sdk/rust/zx",
        "//src/lib/fdio/rust:fdio",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-sync",
        "//src/recovery/lib/recovery-util-block",
        "//src/storage/lib/block_client/rust:block-client",  # @bazel2gn:path_overwrite://src/storage/lib/block_client/rust
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:regex-lite",
    ],
)

rustc_test(
    name = "installer_test",
    crate = ":installer",
    edition = "2024",
    deps = [
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//third_party/rust_crates/vendor:futures",
    ],
)

fx_unittest_package(
    name = "installer-test",
    unit_tests = [":installer_test"],
)
