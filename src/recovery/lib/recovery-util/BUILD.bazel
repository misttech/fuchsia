load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "recovery-util",
    srcs = [
        "src/crash.rs",
        "src/lib.rs",
        "src/ota/action.rs",
        "src/ota/actions/factory_reset.rs",
        "src/ota/actions/finalize_reinstall.rs",
        "src/ota/actions/get_wifi_networks.rs",
        "src/ota/actions/mod.rs",
        "src/ota/actions/ota_reinstall.rs",
        "src/ota/actions/reboot_device.rs",
        "src/ota/actions/set_sharing_consent.rs",
        "src/ota/actions/wifi_connect.rs",
        "src/ota/controller.rs",
        "src/ota/mod.rs",
        "src/ota/state_machine.rs",
        "src/reboot.rs",
        "src/regulatory.rs",
        "src/testing/mod.rs",
        "src/wlan.rs",
    ],
    edition = "2024",
    proc_macro_deps = [
        "//third_party/rust_crates/vendor:async-trait",
    ],
    visibility = ["//src/recovery/lib:__subpackages__"],
    deps = [
        "//sdk/fidl/fuchsia.feedback:fuchsia.feedback_rust",
        "//sdk/fidl/fuchsia.hardware.power.statecontrol:fuchsia.hardware.power.statecontrol_rust",
        "//sdk/fidl/fuchsia.hwinfo:fuchsia.hwinfo_rust",
        "//sdk/fidl/fuchsia.intl:fuchsia.intl_rust",
        "//sdk/fidl/fuchsia.location.namedplace:fuchsia.location.namedplace_rust",
        "//sdk/fidl/fuchsia.recovery:fuchsia.recovery_rust",
        "//sdk/fidl/fuchsia.settings:fuchsia.settings_rust",
        "//sdk/fidl/fuchsia.wlan.policy:fuchsia.wlan.policy_rust",
        "//sdk/rust/zx",
        "//sdk/rust/zx-status",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/recovery/system:ota_lib",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)

rustc_test(
    name = "recovery-util_test",
    crate = ":recovery-util",
    edition = "2024",
    deps = [
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-sync",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:mockall",
    ],
)

fx_unittest_package(
    name = "recovery-util-test",
    unit_tests = [":recovery-util_test"],
)
