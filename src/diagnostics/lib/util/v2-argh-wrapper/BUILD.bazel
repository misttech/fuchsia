load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "v2-argh-wrapper",
    srcs = ["src/lib.rs"],
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    visibility = ["//src/diagnostics:__subpackages__"],
    deps = [
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:argh",
        "//third_party/rust_crates/vendor:log",
    ],
)

host_rustc_test(
    name = "v2-argh-wrapper_test",
    crate = ":v2-argh-wrapper",
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    deps = ["//src/lib/fuchsia"],
)
