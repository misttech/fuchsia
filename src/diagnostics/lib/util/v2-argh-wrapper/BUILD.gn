import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("v2-argh-wrapper") {
  sources = [ "src/lib.rs" ]
  edition = "2024"
  lint_config = "//build/config/rust/lints:clippy_warn_all"
  visibility = [
    ":*",
    "//src/diagnostics/*",
  ]
  deps = [
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:argh",
    "//third_party/rust_crates:log",
  ]
}
if (is_host) {
  rustc_test("v2-argh-wrapper_test") {
    sources = [ "src/lib.rs" ]
    edition = "2024"
    deps = [
             "//third_party/rust_crates:anyhow",
             "//third_party/rust_crates:argh",
             "//third_party/rust_crates:log",
           ] + [ "//src/lib/fuchsia" ]
    lint_config = "//build/config/rust/lints:clippy_warn_all"
  }
}
