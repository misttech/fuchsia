import("//build/bazel/bazel_test_suite.gni")

bazel_test_suite("bazel_tests") {
  host_tests =
      [ "//src/diagnostics/lib/util/v2-argh-wrapper:v2-argh-wrapper_test" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    ":v2-argh-wrapper_test($host_toolchain)",
  ]
}

