rustc_library("inspect-fetcher") {
  sources = [ "src/lib.rs" ]
  edition = "2024"
  lint_config = "//build/config/rust/lints:clippy_warn_all"
  visibility = [
    ":*",
    "//src/diagnostics/detect/*",
    "//src/diagnostics/lib/inspect-fetcher/*",
  ]
  deps = [
    "//sdk/fidl/fuchsia.diagnostics:fuchsia.diagnostics_rust",
    "//src/lib/diagnostics/reader/rust",
    "//src/lib/fuchsia-component",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:serde_json",
  ]
}

rustc_test("inspect-fetcher_test") {
  sources = [ "src/lib.rs" ]
  edition = "2024"
  deps = [
           "//sdk/fidl/fuchsia.diagnostics:fuchsia.diagnostics_rust",
           "//src/lib/diagnostics/reader/rust",
           "//src/lib/fuchsia-component",
           "//third_party/rust_crates:anyhow",
           "//third_party/rust_crates:log",
           "//third_party/rust_crates:serde_json",
         ] + [ "//src/lib/fuchsia" ]
}

fuchsia_unittest_package("inspect-fetcher-test") {
  package_name = "inspect-fetcher-test-gn"
  component_name = "inspect-fetcher-test"
  deps = [ ":inspect-fetcher_test" ]
}
