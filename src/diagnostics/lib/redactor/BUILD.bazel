load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "wrap_host_rust_test")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "redactor",
    srcs = ["src/lib.rs"],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    # Domain-agnostic: any platform or vendor crate that formats sensitive
    # identifiers may depend on this.
    visibility = [
        "//src:__subpackages__",
        "//vendor:__subpackages__",
    ],
    deps = ["//third_party/rust_crates/vendor:sha2"],
)

# @bazel2gn:skip
rustc_test(
    name = "redactor_test",
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate = ":redactor",
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
)

# @bazel2gn:skip
wrap_host_rust_test(
    name = "redactor_host_test",
    binary_name = "redactor_test",
)

# @bazel2gn:skip
fx_unittest_package(
    name = "redactor-tests",
    unit_tests = [":redactor_test"],
    visibility = ["//src/diagnostics:__subpackages__"],
)
