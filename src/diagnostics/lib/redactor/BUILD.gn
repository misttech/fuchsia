import("//build/bazel/bazel_test_suite.gni")

bazel_test_suite("redactor-tests") {
  target_tests = [ "//src/diagnostics/lib/redactor:redactor-tests" ]
  host_tests = [ "//src/diagnostics/lib/redactor:redactor_host_test" ]
}

group("tests") {
  testonly = true
  public_deps = [ ":redactor-tests" ]
  deps = [ ":redactor" ]
}

