{
    // Project ID 3 corresponds to the "power" project in third_party/cobalt_config/projects.yaml.
    // Note: event_codes[0] is (rail_idx + 1) because Cobalt dimension 0 (rail) uses max_event_code
    // without explicit event_codes names, so Sampler requires raw integers.
    project_id: 3,
    data_sets: [
        {
            poll_rate_sec: 600,
