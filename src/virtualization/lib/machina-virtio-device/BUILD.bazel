load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "machina-virtio-device",
    srcs = [
        "src/bell.rs",
        "src/lib.rs",
        "src/mem.rs",
        "src/notify.rs",
    ],
    edition = "2024",
    version = "1.0.0",
    visibility = ["//src/virtualization/bin/vmm/device:__subpackages__"],
    deps = [
        "//sdk/fidl/fuchsia.virtualization.hardware:fuchsia.virtualization.hardware_rust",
        "//sdk/rust/zx",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-runtime",
        "//src/lib/fuchsia-sync",
        "//src/virtualization/lib/virtio-device",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)

rustc_test(
    name = "machina-virtio-device_test",
    crate = ":machina-virtio-device",
    edition = "2024",
    deps = [
        "//src/lib/fuchsia",
        "//third_party/rust_crates/vendor:assert_matches",
    ],
)

fx_unittest_package(
    name = "machina-virtio-device-tests",
    unit_tests = [":machina-virtio-device_test"],
    visibility = ["//src/virtualization:__pkg__"],
)
