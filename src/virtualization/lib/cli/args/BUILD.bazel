load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "guest_cli_args",
    srcs = ["src/lib.rs"],
    edition = "2024",
    visibility = [
        "//src/virtualization/bin/guest:__pkg__",
        "//src/virtualization/ffx:__subpackages__",
        "//src/virtualization/lib/cli:__pkg__",
    ],
    deps = [
        "//third_party/rust_crates/vendor:argh",
        "//third_party/rust_crates/vendor:serde",
    ] + select({
        "//build/bazel/platforms:is_host_os": [
            "//src/developer/ffx/core:lib",
        ],
        "//conditions:default": [],
    }),
)
