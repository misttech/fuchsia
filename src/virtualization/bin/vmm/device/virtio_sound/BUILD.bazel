load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load(
    "//build/bazel/rules/testing:fx_unittest_package.bzl",
    "fx_unittest_package",
)

package(default_applicable_licenses = ["//:license"])

rustc_binary(
    name = "virtio_sound_bin",
    srcs = [
        "src/audio_streams.rs",
        "src/main.rs",
        "src/notification.rs",
        "src/reply.rs",
        "src/sequencer.rs",
        "src/service.rs",
        "src/throttled_log.rs",
        "src/wire.rs",
        "src/wire_convert.rs",
    ],
    crate_name = "virtio_sound",
    edition = "2024",
    proc_macro_deps = ["//third_party/rust_crates/vendor:async-trait"],
    tags = ["manual"],
    deps = [
        "//sdk/fidl/fuchsia.media:fuchsia.media_rust",
        "//sdk/fidl/fuchsia.virtualization.hardware:fuchsia.virtualization.hardware_rust",
        "//sdk/lib/scheduler/rust",
        "//sdk/rust/zx",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-sync",
        "//src/lib/mapped-vmo",
        "//src/virtualization/lib/machina-virtio-device",
        "//src/virtualization/lib/virtio-device",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:iota",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:num-traits",
        "//third_party/rust_crates/vendor:scopeguard",
        "//third_party/rust_crates/vendor:tokio",
        "//third_party/rust_crates/vendor:zerocopy",
    ],
)

rustc_test(
    name = "virtio_sound_bin_test",
    crate = ":virtio_sound_bin",
    edition = "2024",
    deps = ["//third_party/rust_crates/vendor:pretty_assertions"],
)

fx_unittest_package(
    name = "virtio_sound_unittests",
    unit_tests = [":virtio_sound_bin_test"],
    visibility = ["//src/virtualization:__pkg__"],
)

fx_packaged_binary(
    name = "virtio_sound_packaged_bin",
    binary = ":virtio_sound_bin",
    binary_name = "virtio_sound",
)

fx_component_manifest(
    name = "virtio_sound_manifest",
    component_name = "virtio_sound",
    includes = [
        "//sdk/lib/syslog:client.shard",
        "//sdk/lib/trace:use.shard",
    ],
    manifest = "meta/virtio_sound.cml",
)

fx_component(
    name = "virtio_sound_component",
    compiled_manifest = ":virtio_sound_manifest",
    component_name = "virtio_sound",
    visibility = [
        "//src/virtualization/bin/vmm/device:__subpackages__",
    ],
    deps = [":virtio_sound_packaged_bin"],
)
