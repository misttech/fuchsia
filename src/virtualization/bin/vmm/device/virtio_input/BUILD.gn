fuchsia_unittest_package("virtio_input_unittests") {
  package_name = "virtio_input_unittests-gn"
  component_name = "virtio_input_unittests"
  deps = [ ":virtio_input_bin_test" ]
  visibility = [
    ":*",
    "//src/virtualization:*",
  ]
}

fuchsia_component_manifest("virtio_input_manifest") {
  component_name = "virtio_input"
  manifest = "meta/virtio_input.cml"
}

fuchsia_component("virtio_input_component") {
  cm_label = ":virtio_input_manifest"
  component_name = "virtio_input"
  visibility = [
    ":*",
    "//src/virtualization/bin/vmm/device/*",
  ]
  deps = [ ":virtio_input_bin" ]
}
