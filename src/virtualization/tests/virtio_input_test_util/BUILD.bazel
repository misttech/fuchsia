load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")

package(default_applicable_licenses = ["//:license"])

rustc_binary(
    name = "virtio_input_test_util",
    srcs = [
        "src/events.rs",
        "src/main.rs",
    ],
    edition = "2024",
    visibility = ["//src/virtualization/packages/debian_guest:__pkg__"],
    deps = [
        "//third_party/rust_crates/vendor:clap",
        "//third_party/rust_crates/vendor:libc",
        "//third_party/rust_crates/vendor:zerocopy",
    ],
)

host_rustc_test(
    name = "virtio_input_test_util_test",
    crate = ":virtio_input_test_util",
    deps = ["//third_party/rust_crates/vendor:assert_matches"],
)
