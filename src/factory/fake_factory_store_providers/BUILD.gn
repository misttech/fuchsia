    "testdata/test_weave.config",
    "testdata/test_widevine.config",
  ]
  outputs = [ "data/{{source_file_part}}" ]
}

bazel_test_suite("bazel_tests") {
  target_tests = [ "//src/factory/fake_factory_store_providers:fake_factory_store_providers_tests" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    ":fake_factory_store_providers_tests",
    ":test_fake_factory_store_providers_config",
  ]
}

