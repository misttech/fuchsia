load(
    "@fuchsia_rules_common//packages:resources.bzl",
    "resource",
)
load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

rustc_binary(
    name = "bin",
    srcs = ["src/main.rs"],
    crate_name = "fake_factory_store_provider",
    edition = "2024",
    visibility = [
        "//src/hwinfo:__pkg__",
        "//src/testing/sl4f:__pkg__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.factory:fuchsia.factory_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component",
        "//src/storage/lib/vfs/rust:vfs",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:clap",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:serde_json",
    ],
)

fx_packaged_binary(
    name = "fake_factory_store_provider_packaged_bin",
    binary = ":bin",
    binary_name = "fake_factory_store_provider",
)

fx_component_manifest(
    name = "fake_alpha_manifest",
    component_name = "fake_alpha",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/fake_alpha.cml",
)

fx_component(
    name = "fake_alpha_comp",
    compiled_manifest = ":fake_alpha_manifest",
    component_name = "fake_alpha",
    deps = [":fake_factory_store_provider_packaged_bin"],
)

fx_component_manifest(
    name = "fake_cast_manifest",
    component_name = "fake_cast",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/fake_cast.cml",
)

fx_component(
    name = "fake_cast_comp",
    compiled_manifest = ":fake_cast_manifest",
    component_name = "fake_cast",
    deps = [":fake_factory_store_provider_packaged_bin"],
)

fx_component_manifest(
    name = "fake_misc_manifest",
    component_name = "fake_misc",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/fake_misc.cml",
)

fx_component(
    name = "fake_misc_comp",
    compiled_manifest = ":fake_misc_manifest",
    component_name = "fake_misc",
    deps = [":fake_factory_store_provider_packaged_bin"],
)

fx_component_manifest(
    name = "fake_playready_manifest",
    component_name = "fake_playready",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/fake_playready.cml",
)

fx_component(
    name = "fake_playready_comp",
    compiled_manifest = ":fake_playready_manifest",
    component_name = "fake_playready",
    deps = [":fake_factory_store_provider_packaged_bin"],
)

fx_component_manifest(
    name = "fake_weave_manifest",
    component_name = "fake_weave",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/fake_weave.cml",
)

fx_component(
    name = "fake_weave_comp",
    compiled_manifest = ":fake_weave_manifest",
    component_name = "fake_weave",
    deps = [":fake_factory_store_provider_packaged_bin"],
)

fx_component_manifest(
    name = "fake_widevine_manifest",
    component_name = "fake_widevine",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/fake_widevine.cml",
)

fx_component(
    name = "fake_widevine_comp",
    compiled_manifest = ":fake_widevine_manifest",
    component_name = "fake_widevine",
    deps = [":fake_factory_store_provider_packaged_bin"],
)

fx_package(
    name = "fake_factory_store_providers",
    package_name = "fake_factory_store_providers",
    components = [
        ":fake_alpha_comp",
        ":fake_cast_comp",
        ":fake_misc_comp",
        ":fake_playready_comp",
        ":fake_weave_comp",
        ":fake_widevine_comp",
    ],
)

rustc_test(
    name = "fake_factory_store_providers_test",
    srcs = ["tests/fake_factory_store_providers_test.rs"],
    crate_root = "tests/fake_factory_store_providers_test.rs",
    edition = "2024",
    deps = [
        "//sdk/fidl/fuchsia.factory:fuchsia.factory_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-fs",
        "//third_party/rust_crates/vendor:anyhow",
    ],
)

# @bazel2gn:skip
resource(
    name = "test_alpha_config",
    src = "testdata/test_alpha.config",
    dest = "data/test_alpha.config",
)

# @bazel2gn:skip
resource(
    name = "test_cast_config",
    src = "testdata/test_cast.config",
    dest = "data/test_cast.config",
)

# @bazel2gn:skip
resource(
    name = "test_misc_config",
    src = "testdata/test_misc.config",
    dest = "data/test_misc.config",
)

# @bazel2gn:skip
resource(
    name = "test_playready_config",
    src = "testdata/test_playready.config",
    dest = "data/test_playready.config",
)

# @bazel2gn:skip
resource(
    name = "test_weave_config",
    src = "testdata/test_weave.config",
    dest = "data/test_weave.config",
)

# @bazel2gn:skip
resource(
    name = "test_widevine_config",
    src = "testdata/test_widevine.config",
    dest = "data/test_widevine.config",
