fx_packaged_binary(
    name = "fake_factory_store_providers_test_packaged_bin",
    testonly = True,
    binary = ":fake_factory_store_providers_test",
    binary_name = "fake_factory_store_providers_test",
)

fx_component_manifest(
    name = "fake_factory_store_providers_tests_manifest",
    testonly = True,
    component_name = "fake_factory_store_providers_tests",
    includes = [
        "//sdk/lib/inspect:offer.shard.cml",
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/fake_factory_store_providers_test.cml",
)

fx_test_component(
    name = "fake_factory_store_providers_tests_component",
    compiled_manifest = ":fake_factory_store_providers_tests_manifest",
    component_name = "fake_factory_store_providers_tests",
    deps = [":fake_factory_store_providers_test_packaged_bin"],
)

# GN copy is hand-written in BUILD.gn because bazel2gn doesn't translate
# `resources` on an fx_package with test_components.
# @bazel2gn:skip
fx_package(
    name = "fake_factory_store_providers_tests_package",
    package_name = "fake_factory_store_providers_tests",
    components = [
        ":fake_alpha_comp",
        ":fake_cast_comp",
        ":fake_misc_comp",
        ":fake_playready_comp",
        ":fake_weave_comp",
        ":fake_widevine_comp",
    ],
    resources = [
        ":test_alpha_config",
        ":test_cast_config",
        ":test_misc_config",
        ":test_playready_config",
        ":test_weave_config",
        ":test_widevine_config",
    ],
    test_components = [":fake_factory_store_providers_tests_component"],
)

fx_test(
    name = "fake_factory_store_providers_tests",
    package = ":fake_factory_store_providers_tests_package",
)
