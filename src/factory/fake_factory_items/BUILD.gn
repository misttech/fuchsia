import("//build/bazel/bazel_test_suite.gni")
import("//build/components.gni")
import("//build/dist/resource.gni")

fuchsia_test_component("fake_factory_items_test_comp") {
  component_name = "fake_factory_items_test"
  manifest = "meta/fake_factory_items_test.cml"
  deps = [ ":fake_factory_items_test" ]
}

fuchsia_test_package("fake_factory_items_tests") {
  package_name = "fake_factory_items_tests-gn"
  test_components = [ ":fake_factory_items_test_comp" ]
  deps = [
    ":fake_factory_items_comp",
    ":testdata",
  ]
}

resource("testdata") {
  testonly = true
  sources = [
    "testdata/empty",
    "testdata/fake_factory_items.json",
    "testdata/random1",
    "testdata/random2",
  ]
  outputs = [ "data/{{source_file_part}}" ]
}

bazel_test_suite("bazel_tests") {
  target_tests = [ "//src/factory/fake_factory_items:fake_factory_items_tests" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    ":fake_factory_items_tests",
  ]
}

