import("//build/bazel/bazel_test_suite.gni")
import("//build/components.gni")
import("//build/dist/resource.gni")
import("//build/rust/rustc_test.gni")
import("//build/zbi/zbi.gni")

# `factory_store_providers_test` and `factory_store_providers_tests` stay in GN
# because the test depends on GN driver groups
# (`//src/devices/bus/drivers/platform` and
# `//src/storage/testing:storage_drivers`) and a Ninja-generated ZBI resource
# (`zbi("items")`).
rustc_test("factory_store_providers_test") {
  edition = "2024"
  source_root = "tests/factory_store_providers_test.rs"

  deps = [
    "//sdk/fidl/fuchsia.factory:fuchsia.factory_rust",
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//src/devices/bus/drivers/platform",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-component",
    "//src/lib/fuchsia-fs",
    "//src/storage/testing:storage_drivers",
    "//third_party/rust_crates:anyhow",
  ]

  sources = [ "tests/factory_store_providers_test.rs" ]
}

# `factory_store_providers_corruption_test` and
# `factory_store_providers_corruption_tests` stay in GN because the test uses
# RealmBuilder (`//src/lib/fuchsia-component-test/realm_builder_server` has no
# Bazel build yet) and depends on the `//src/devices/bus/drivers/platform` GN
# driver group.
rustc_test("factory_store_providers_corruption_test") {
  edition = "2024"
  source_root = "tests/factory_store_providers_corruption_test.rs"

  deps = [
    "//sdk/fidl/fuchsia.factory:fuchsia.factory_rust",
    "//sdk/fidl/fuchsia.feedback:fuchsia.feedback_rust",
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//src/devices/bus/drivers/platform",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-component",
    "//src/lib/fuchsia-component-test",
    "//src/lib/fuchsia-fs",
    "//src/storage/lib/vfs/rust:vfs",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
  ]

  sources = [ "tests/factory_store_providers_corruption_test.rs" ]
}

fuchsia_package("factory_store_providers") {
  deps = [ ":factory_store_providers_comp" ]
}

test_files = [
  "alpha_file",
  "another_cast_file",
  "failed_widevine_file",
  "ignored_misc_file",
  "multi_validated_file",
  "other/misc",
  "passed_misc_file",
  "pr/file1",
  "some_cast_file",
  "weave_file",
  "widevine_file",
]

zbi_deps = []
foreach(file, test_files) {
  foreach(name, [ "zbi_$file" ]) {
    zbi_deps += [ ":$name" ]

    resource(name) {
      testonly = true
      sources = [ "testdata/input/$file" ]
      outputs = [ file ]
    }
  }
}

test_file_resources = []
foreach(file, test_files) {
  foreach(name, [ "test_resource_$file" ]) {
    test_file_resources += [ ":$name" ]

    resource(name) {
      testonly = true
      sources = [ "testdata/input/$file" ]
      outputs = [ "data/{{source_file_part}}" ]
    }
  }
}

zbi("items") {
  testonly = true
  cpu = ""  # Mark the zbi as incomplete.
  compress = false
  deps = zbi_deps
}

items_zbi_outputs = get_target_outputs(":items")

resource("items_zbi") {
  testonly = true
  sources = [ items_zbi_outputs[0] ]
  outputs = "data/items.zbi"
  deps = [ ":items" ]
}

resource("fake_factory_items_json") {
  testonly = true
  sources = [ "testdata/fake_factory_items.json" ]
  outputs = "data/fake_factory_items.json"
}

resource("fake_factory_items_empty_json") {
  testonly = true
  sources = [ "testdata/fake_factory_items_empty.json" ]
  outputs = "data/fake_factory_items.json"
}

resource("empty_file") {
  testonly = true
  sources = [ "testdata/empty" ]
  outputs = "data/empty"
}

fuchsia_test_component("factory_store_providers_test_comp") {
  component_name = "factory_store_providers_test"
  manifest = "meta/factory_store_providers_test.cml"
  deps = [ ":factory_store_providers_test" ]
}

fuchsia_test_component("factory_store_providers_corruption_test_comp") {
  component_name = "factory_store_providers_corruption_test"
  manifest = "meta/factory_store_providers_corruption_test.cml"
  deps = [ ":factory_store_providers_corruption_test" ]
}

# `factory_store_providers_tests` stays in GN because it depends on a
# Ninja-generated ZBI resource (`zbi("items")`).
fuchsia_test_package("factory_store_providers_tests") {
  test_components = [ ":factory_store_providers_test_comp" ]
  deps = [
           ":factory_store_providers_comp",
           ":factory_store_providers_tests_config",
           ":fake_factory_items_json",
           ":items_zbi",
           "../fake_factory_items:fake_factory_items_comp",
         ] + test_file_resources

  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}

# `factory_store_providers_corruption_tests` stays in GN because the test uses
# RealmBuilder and `//src/lib/fuchsia-component-test/realm_builder_server` has
# no Bazel build yet.
fuchsia_test_package("factory_store_providers_corruption_tests") {
  test_components = [ ":factory_store_providers_corruption_test_comp" ]
  deps = [
    ":empty_file",
    ":factory_store_providers_comp",
    ":factory_store_providers_tests_config",
    ":fake_factory_items_empty_json",
    "../fake_factory_items:fake_factory_items_comp",
  ]

  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}

resource("factory_store_providers_tests_config") {
  sources = [
    "testdata/fuchsia.factory.AlphaFactoryStoreProvider.config",
    "testdata/fuchsia.factory.CastCredentialsFactoryStoreProvider.config",
    "testdata/fuchsia.factory.MiscFactoryStoreProvider.config",
    "testdata/fuchsia.factory.PlayReadyFactoryStoreProvider.config",
    "testdata/fuchsia.factory.WeaveFactoryStoreProvider.config",
    "testdata/fuchsia.factory.WidevineFactoryStoreProvider.config",
  ]
  outputs = [ "data/{{source_file_part}}" ]
}

bazel_test_suite("bazel_tests") {
  target_tests = [ "//src/factory/factory_store_providers:factory_store_providers_tests_no_errors" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    ":factory_store_providers_corruption_tests",
    ":factory_store_providers_tests",
    ":factory_store_providers_tests_no_errors_package",
  ]
}

