import("//build/test.gni")

group("tests") {
  testonly = true
  deps = [
    ":stdbind-cpp-unittests($host_toolchain)",
    ":stdbind-rs_test($host_toolchain)",
  ]
}

test("stdbind-cpp-unittests") {
  sources = [ "optional-test.cc" ]
  deps = [
    "//src/lib/stdbind",
    "//zircon/system/ulib/zxtest",
  ]
}

