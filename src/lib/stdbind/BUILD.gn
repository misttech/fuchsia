import("//build/tools/bazel2gn/bazel_migration.gni")

library_headers("headers") {
  public = [ "include/lib/stdbind/optional.h" ]
  visibility = [
    ":*",
    "//zircon/kernel/*",
  ]
}

source_set("stdbind") {
  visibility = [
    ":*",
    "//zircon/kernel/*",
  ]
  public_deps = [ ":headers" ]
}

rustc_library("stdbind-rs") {
  sources = [
    "src/lib.rs",
    "src/optional.rs",
  ]
  crate_name = "stdbind"
  edition = "2024"
  visibility = [
    ":*",
    "//zircon/kernel/*",
  ]
}
if (is_host) {
  rustc_test("stdbind-rs_test") {
    sources = [
      "src/lib.rs",
      "src/optional.rs",
    ]
    edition = "2024"
    visibility = [
      ":*",
      "//src/lib:*",
    ]
  }
}
