load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "fidl_server",
    srcs = [
        "src/lib.rs",
        "src/server.rs",
    ],
    edition = "2024",
    proc_macro_deps = [
        "//third_party/rust_crates/vendor:async-trait",
    ],
    visibility = [
        "//src/developer/adb/bin/adb-sideload:__pkg__",
        "//src/diagnostics/detect/integration/realm_factory:__pkg__",
    ],
    deps = [
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-async",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
    ],
)

# Runs only in Bazel: only `group("tests")` in BUILD.gn listed the old GN
# test, and the GN copy of :fidl_server is a 1:1 translation.
# @bazel2gn:skip
rustc_test(
    name = "fidl_server_tests",
    srcs = ["tests/src/test.rs"],
    crate_root = "tests/src/test.rs",
    edition = "2024",
    proc_macro_deps = [
        "//third_party/rust_crates/vendor:async-trait",
    ],
    visibility = ["//visibility:private"],
    deps = [
        ":fidl_server",
        "//examples/fidl/fuchsia.examples:fuchsia.examples_rust",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-async",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
    ],
)

# Runs only in Bazel (see :fidl_server_tests).
# @bazel2gn:skip
fx_unittest_package(
    name = "fidl-server-tests",
    package_name = "fidl-server-tests",
    unit_tests = [":fidl_server_tests"],
    visibility = ["//src/lib:__pkg__"],
)
