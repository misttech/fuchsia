load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_proc_macro.bzl", "rustc_proc_macro")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "transformer",
    srcs = ["src/transformer.rs"],
    crate_root = "src/transformer.rs",
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = [
        "//sdk/fidl/fuchsia.diagnostics.types:fuchsia.diagnostics.types_rust_common",
        "//third_party/rust_crates/vendor:proc-macro2",
        "//third_party/rust_crates/vendor:quote",
        "//third_party/rust_crates/vendor:syn",
    ],
)

rustc_proc_macro(
    name = "macro",
    srcs = ["src/lib.rs"],
    crate_name = "fuchsia_dso_macro",
    edition = "2024",
    visibility = ["//src/lib/dso/rust:__pkg__"],
    deps = [":transformer"],
)
