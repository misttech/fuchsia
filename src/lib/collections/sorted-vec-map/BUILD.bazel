load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "wrap_host_rust_test")
load("//build/bazel/rules/rust:defs.bzl", "rustc_library", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "sorted-vec-map",
    srcs = [
        "src/lib.rs",
        "src/sorted_vec_map.rs",
        "src/sorted_vec_set.rs",
    ],
    edition = "2024",
    visibility = [
        "//src/starnix/modules/input:__subpackages__",
        "//src/storage/ext4/lib/metadata:__pkg__",
        "//src/sys/pkg/bin/pkg-cache:__pkg__",
        "//src/sys/pkg/lib/system-image:__pkg__",
        "//src/ui/bin/scene_manager:__pkg__",
        "//src/ui/lib/input_pipeline:__pkg__",
    ],
    deps = [
        "//third_party/rust_crates/vendor:serde",
    ],
)

# TODO(https://fxbug.dev/566963647): Replace these targets with
# `with_unit_tests` once it supports strings.
#
# The same unit test binary is wrapped for host runs below and packaged for
# device runs. The tests are exported to GN via
# `bazel_test_suite("sorted-vec-map-tests")` in BUILD.gn, so bazel2gn skips
# them (it does not support `crate` on `rustc_test` or
# `wrap_host_rust_test`).
rustc_test(
    name = "sorted_vec_map_lib_test",
    crate = ":sorted-vec-map",
    edition = "2024",
    deps = [
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:serde_json",
        "//third_party/rust_crates/vendor:test-case",
    ],
)

wrap_host_rust_test(
    name = "sorted-vec-map_test",
    binary_name = "sorted_vec_map_lib_test",
)

fx_unittest_package(
    name = "sorted-vec-map-tests",
    unit_tests = [":sorted_vec_map_lib_test"],
)
