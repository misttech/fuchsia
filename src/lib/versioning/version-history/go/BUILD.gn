import("//build/bazel/bazel_test_suite.gni")

_version_history_dep = "//sdk:version_history($default_toolchain)"

_version_history_json_dir =
    get_label_info(_version_history_dep, "target_out_dir")

# GN go_library compiles from `source_dir = target_gen_dir` so //go:embed can
# resolve `version_history.json` alongside `version_history.go`.
copy("copy-files") {
  sources = [
    "${_version_history_json_dir}/version_history.json",
    "version_history.go",
  ]
  deps = [ _version_history_dep ]
  outputs = [ "$target_gen_dir/{{source_file_part}}" ]
}

bazel_test_suite("version-history-test") {
  host_tests =
      [ "//src/lib/versioning/version-history/go:version-history-test" ]
}

group("tests") {
  testonly = true
  public_deps = [ ":version-history-test" ]
}

