import("//build/tools/bazel2gn/bazel_migration.gni")

go_library("version-history") {
  sources = [ "version_history.go" ]
  embedsrcs = [ "version_history.json" ]
  name = "go.fuchsia.dev/fuchsia/src/lib/versioning/version-history/go"
  source_dir = target_gen_dir
  non_go_deps = [ ":copy-files" ]
  visibility = [
    ":*",
    "//src/lib/versioning/version-history:*",
    "//src/testing/host-target-testing/build:*",
    "//src/testing/host-target-testing/packages:*",
  ]
}
