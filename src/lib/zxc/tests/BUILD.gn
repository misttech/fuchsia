test("zxc_unittests") {
  sources = [ "result_tests.cc" ]
  deps = [
    "//zircon/system/ulib/zx",
    "//zircon/system/ulib/zxtest",
  ]
}

fuchsia_unittest_component("zxc-tests-component") {
  deps = [ ":zxc_unittests" ]
  component_name = "zxc-tests"
}

