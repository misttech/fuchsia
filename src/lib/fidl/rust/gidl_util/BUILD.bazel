load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "gidl_util",
    srcs = ["src/lib.rs"],
    edition = "2024",
    visibility = [
        "//src/lib/fidl/rust:__pkg__",
        "//src/lib/fidl/rust_next/conformance:__pkg__",
        "//src/lib/fidl_codec/rust:__pkg__",
        "//src/tests/benchmarks/fidl/rust:__pkg__",
        "//tools/fidl/gidl/empty_test:__pkg__",
        "//tools/fidl/measure-tape/rust-tests:__pkg__",
    ],
    deps = [
        "//sdk/rust/zx-status",
        "//sdk/rust/zx-types",
        "//src/lib/fidl/rust/fidl",
    ] + select({
        "@platforms//os:fuchsia": ["//sdk/rust/zx"],
        "//conditions:default": [],
    }),
)
