load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "wrap_host_rust_test")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")
load(
    "//src/tests/fidl/conformance_suite:gidl_conformance_suite.bzl",
    "CONFORMANCE_SUITE_FIDL_TARGET",
    "CONFORMANCE_SUITE_GIDL_FILES",
)
load("//tools/fidl/gidl:gidl.bzl", "gidl")

package(default_applicable_licenses = ["//:license"])

# LINT.IfChange

_CONFORMANCE_TEST_SOURCE = "src/conformance_test.rs"

gidl(
    name = "generate_conformance_test",
    fidl = CONFORMANCE_SUITE_FIDL_TARGET,
    inputs = CONFORMANCE_SUITE_GIDL_FILES,
    language = "rust",
    output = _CONFORMANCE_TEST_SOURCE,
    type = "conformance",
)

rustc_test(
    name = "fidl_rust_conformance_tests_bin",
    srcs = [_CONFORMANCE_TEST_SOURCE],
    crate_name = "fidl_rust_conformance_tests",
    crate_root = _CONFORMANCE_TEST_SOURCE,
    edition = "2024",
    deps = [
        "//sdk/rust/zx-status",
        "//sdk/rust/zx-types",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fidl/rust/gidl_util",
        "//src/tests/fidl/conformance_suite:conformance_fidl_rust",
        "//third_party/rust_crates/vendor:assert_matches",
    ],
)

fx_unittest_package(
    name = "fidl_rust_conformance_tests",
    unit_tests = [":fidl_rust_conformance_tests_bin"],
    visibility = ["//src/lib/fidl:__subpackages__"],
)

# We can't run tests in threads because they assert that handles are closed,
# which is racy when other threads are creating handles. See the comment on
# get_handle_info_valid in ./gidl_util/src/lib.rs for more details. We only
# need this on host because the test runner framework uses processes.
wrap_host_rust_test(
    name = "fidl_rust_conformance_tests_host",
    binary_name = "fidl_rust_conformance_tests_bin",
    test_args = ["--test-threads=1"],
    visibility = ["//src/lib/fidl:__subpackages__"],
)

# LINT.ThenChange(//src/lib/fidl/rust/BUILD.gn)
