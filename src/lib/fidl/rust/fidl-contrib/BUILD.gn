import("//build/components.gni")
import("//build/rust/rustc_test.gni")

# The library is defined in BUILD.bazel. Its unit tests stay in GN because they
# use RealmBuilder via GN-only //src/lib/fuchsia-component-test (which packages
# //src/lib/fuchsia-component-test/realm_builder_server:realm_builder_server_component).
rustc_test("fidl-contrib_test") {
  output_name = "fidl_contrib_lib_test"
  edition = "2024"

  deps = [
    "//sdk/rust/zx",
    "//sdk/testing/fidl/protocols_tests:test.protocol.connector_rust",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//src/lib/fuchsia-component-test",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
  ]
  sources = [
    "src/lib.rs",
    "src/protocol_connector.rs",
  ]
}

fuchsia_unittest_package("fidl_contrib_rust_lib_tests") {
  deps = [ ":fidl-contrib_test" ]
}

group("tests") {
  testonly = true
  deps = [ ":fidl_contrib_rust_lib_tests" ]
}

