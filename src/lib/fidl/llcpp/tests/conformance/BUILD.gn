import("//build/bazel/bazel_test_suite.gni")
import("//build/components.gni")
import("//build/fidl/fidl.gni")
import("//build/test.gni")
import("//src/tests/fidl/conformance_suite/gidl-conformance-suite.gni")
import("//tools/fidl/gidl/gidl.gni")

# fidl_llcpp_manual_conformance_tests and fidl_llcpp_request_response_tests
# are built by Bazel and exported to GN through //src/lib:bazel_tests.
group("conformance") {
  testonly = true
  deps = [
    ":bazel_tests",
    ":fidl_llcpp_conformance_tests",
    ":fidl_llcpp_conformance_tests_bin($host_toolchain)",
  ]
}

bazel_test_suite("bazel_tests") {
  target_tests =
      [ "//src/lib/fidl/llcpp/tests/conformance:fidl_llcpp_conformance_tests" ]
  host_tests = [
    "//src/lib/fidl/llcpp/tests/conformance:fidl_llcpp_conformance_tests_bin",
  ]
}

# LINT.IfChange
gidl_output_prefix = "conformance_suite__"

gidl_deps = []
foreach(gidl_file, conformance_suite_gidl_files) {
  gidl_name = get_path_info(gidl_file, "name")
  target = "${gidl_output_prefix}${gidl_name}"
  gidl_deps += [ ":" + target ]

  gidl_llcpp_conformance(target) {
    testonly = true
    inputs = [ gidl_file ]
    fidl = conformance_suite_fidl_target
    deps = [
      ":conformance_utils",
      "//third_party/googletest:gtest",
    ]
    if (is_fuchsia) {
      deps += [ "//sdk/ctf/tests/pkg/fidl/cpp:handle_util" ]
    }
  }
}

test("fidl_llcpp_conformance_tests_bin") {
  output_name = "fidl_llcpp_conformance_tests"
  deps = [
           ":conformance_utils",
           "//src/lib/fxl/test:gtest_main",
           "//src/tests/fidl/conformance_suite:conformance_fidl_cpp",
           "//third_party/googletest:gtest",
         ] + gidl_deps
}

fuchsia_unittest_package("fidl_llcpp_conformance_tests") {
  package_name = "fidl_llcpp_conformance_tests-gn"
  deps = [ ":fidl_llcpp_conformance_tests_bin" ]
  deprecated_legacy_test_execution = true
}

# LINT.ThenChange(//src/lib/fidl/llcpp/tests/conformance/BUILD.bazel)

