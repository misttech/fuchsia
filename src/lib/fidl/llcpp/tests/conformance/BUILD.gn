import("//build/tools/bazel2gn/bazel_migration.gni")

fidl("manual.conformance.large") {
  testonly = true
  sources = [ "large.test.fidl" ]
  excluded_checks = [
    "vector-bounds-not-specified",
    "wrong-prefix-for-platform-source-library",
  ]
  visibility = [ ":*" ]
}

static_library("conformance_utils") {
  testonly = true
  public = [ "conformance_utils.h" ]
  configs += [ "//build/config:Wno-conversion" ]
  visibility = [ ":*" ]
  public_deps = [
    "//sdk/lib/fidl/cpp/wire",
    "//sdk/lib/fidl_base",
    "//zircon/system/public",
    "//zircon/system/ulib/zx",
  ]
}
