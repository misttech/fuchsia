load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "fuchsia-emulated-handle",
    srcs = [
        "src/channel.rs",
        "src/lib.rs",
        "src/socket.rs",
    ],
    edition = "2024",
    visibility = [
        "//src/developer/ffx/command:__pkg__",
        "//src/lib/fidl/rust/fidl:__pkg__",
    ],
    deps = [
        "//sdk/rust/zx",
        "//sdk/rust/zx-types",
        "//src/lib/fuchsia-sync",
        "//third_party/rust_crates/vendor:bitflags",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:tokio",
    ],
)

# @bazel2gn:skip
host_rustc_test(
    name = "fuchsia-emulated-handle_test",
    crate = ":fuchsia-emulated-handle",
    edition = "2024",
    visibility = ["//src/lib:__pkg__"],
    deps = [
        "//third_party/rust_crates/vendor:futures-test",
    ],
)

# @bazel2gn:skip
host_rustc_test(
    name = "fuchsia-emulated-handle-shutdown-test",
    srcs = ["src/shutdown_test.rs"],
    crate_root = "src/shutdown_test.rs",
    edition = "2024",
    visibility = ["//src/lib:__pkg__"],
    deps = [
        ":fuchsia-emulated-handle",
        "//sdk/rust/zx",
    ],
)
