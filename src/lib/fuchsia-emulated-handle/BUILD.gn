import("//build/components.gni")
import("//build/rust/rustc_library.gni")
import("//build/rust/rustc_test.gni")

if (is_host) {
  rustc_test("fuchsia-emulated-handle-shutdown-test") {
    edition = "2024"
    deps = [
      ":fuchsia-emulated-handle",
      "//sdk/rust/zx",
    ]
    source_root = "src/shutdown_test.rs"
    sources = [ "src/shutdown_test.rs" ]
  }
}

group("tests") {
  testonly = true
  deps = [
    ":fuchsia-emulated-handle-shutdown-test($host_toolchain)",
    ":fuchsia-emulated-handle_test($host_toolchain)",
  ]
}

