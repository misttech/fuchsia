import("//build/components.gni")
import("//build/rust/rustc_library.gni")

fuchsia_unittest_package("fuchsia-async-inspect-tests") {
  deps = [ ":fuchsia-async-inspect_test" ]
}

group("tests") {
  testonly = true
  deps = [ ":fuchsia-async-inspect-tests" ]
}

