import("//build/bazel/bazel_test_suite.gni")

group("diagnostics") {
  deps = [
    "accessor2logger",
    "data",
    "hierarchy",
    "inspect",
    "inspect/rust/bench:build-only",
    "log",
    "log/bench:build-only",
    "reader",
    "selectors",
    "selectors-ext",
    "selectors/bench:build-only",
  ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    "accessor2logger/integration",
    "accessor2logger/tests",
    "data:tests",
    "fake-log-sink:tests",
    "fuchsia-async-inspect:tests",
    "hierarchy:tests",
    "inspect:tests",
    "log:tests",
    "reader:tests",
    "selectors:tests",
    "selectors-ext:tests",
    "testing:tests",
  ]
}

bazel_test_suite("bazel_tests") {
  host_tests = [ "//src/lib/diagnostics:host_tests" ]
}

group("benchmarks") {
  testonly = true
  deps = [
    "hierarchy:benchmarks",
    "inspect:benchmarks",
    "log:benchmarks",
    "selectors:benchmarks",
  ]
}
