import("//build/bazel/bazel_test_suite.gni")
import("//build/rust/rustc_staticlib.gni")

rustc_staticlib("rust_ffi") {
  testonly = true
  edition = "2024"
  features = [ "ffi" ]
  visibility = [
    ":*",
    "//src/lib/diagnostics/fake-log-sink/cpp:*",
    "//src/lib/diagnostics/log/message/rust/cpp-log-decoder:*",
  ]
  public = [ "fake_log_sink.h" ]
  sources = [ "src/lib.rs" ]
  deps = [
    "//sdk/fidl/fuchsia.diagnostics.types:fuchsia.diagnostics.types_rust",
    "//sdk/fidl/fuchsia.logger:fuchsia.logger_rust",
    "//sdk/rust/zx",
    "//src/diagnostics/lib/ring-buffer",
    "//src/lib/diagnostics/log/message/rust",
    "//src/lib/diagnostics/log/message/rust/cpp-log-decoder:lib",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-sync",
    "//third_party/rust_crates:futures",
  ]
}

bazel_test_suite("bazel_tests") {
  target_tests =
      [ "//src/lib/diagnostics/fake-log-sink/rust:fake-log-sink-tests" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    ":fake-log-sink-tests-package",
  ]
}

