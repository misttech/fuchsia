load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load("//build/bazel/rules/packages:fx_packaged_binary.bzl", "fx_packaged_binary")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "rust",
    testonly = True,
    srcs = ["src/lib.rs"],
    crate_name = "fake_log_sink",
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    visibility = ["//src/sys/lib/elf_runner:__pkg__"],
    deps = [
        "//sdk/fidl/fuchsia.diagnostics.types:fuchsia.diagnostics.types_rust",
        "//sdk/fidl/fuchsia.logger:fuchsia.logger_rust",
        "//src/diagnostics/lib/ring-buffer",
        "//src/lib/diagnostics/log/message/rust",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-sync",
        "//third_party/rust_crates/vendor:futures",
    ],
)

# @bazel2gn:raw_attribute:output_name = "fake_log_sink_lib_test"
rustc_test(
    name = "rust_test",
    crate = ":rust",
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    deps = [
        "//sdk/rust/zx",
        "//src/lib/diagnostics/log/encoding/rust",
        "//src/lib/fuchsia",
        "//third_party/rust_crates/vendor:log",
    ],
)

fx_packaged_binary(
    name = "rust_test_packaged_bin",
    testonly = True,
    binary = ":rust_test",
    binary_name = "fake_log_sink_lib_test",
)

fx_component_manifest(
    name = "fake-log-sink-tests-manifest",
    testonly = True,
    component_name = "fake-log-sink-tests",
    includes = [
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/rust:next-vdso.shard.cml",
    ],
    manifest = "meta/fake-log-sink-test.cml",
)

fx_test_component(
    name = "fake-log-sink-tests-component",
    compiled_manifest = ":fake-log-sink-tests-manifest",
    component_name = "fake-log-sink-tests",
    deps = [":rust_test_packaged_bin"],
)

fx_package(
    name = "fake-log-sink-tests-package",
    package_name = "fake-log-sink-tests",
    test_components = [":fake-log-sink-tests-component"],
)

fx_test(
    name = "fake-log-sink-tests",
    package = ":fake-log-sink-tests-package",
)
