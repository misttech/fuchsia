load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "selectors-ext",
    srcs = [
        "src/inspect.rs",
        "src/lib.rs",
    ],
    edition = "2024",
    visibility = ["//src/lib/diagnostics:__pkg__"],
    deps = [
        "//sdk/fidl/fuchsia.diagnostics:fuchsia.diagnostics_rust",
        "//src/lib/diagnostics/selectors",
        "//third_party/rust_crates/vendor:serde",
    ],
)

rustc_test(
    name = "selectors-ext_test",
    crate = ":selectors-ext",
    edition = "2024",
    deps = [
        "//src/lib/fuchsia",
        "//third_party/rust_crates/vendor:pretty_assertions",
        "//third_party/rust_crates/vendor:serde_json",
        "//third_party/rust_crates/vendor:test-case",
    ],
)

fx_unittest_package(
    name = "selectors-ext-test",
    unit_tests = [":selectors-ext_test"],
    visibility = ["//src/lib/diagnostics:__pkg__"],
)
