import("//build/components.gni")
import("//build/rust/rustc_library.gni")

fuchsia_unittest_package("diagnostics-assertions-tests") {
  deps = [ ":diagnostics-assertions_test" ]

  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}

group("tests") {
  testonly = true
  deps = [ ":diagnostics-assertions-tests" ]
}

