load("//build/bazel/rules/rust:defs.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "fake-archive-accessor",
    testonly = True,
    srcs = [
        "src/fake_archive_accessor.rs",
        "src/fake_archive_accessor/archivist_accessor.rs",
        "src/fake_archive_accessor/archivist_server.rs",
        "src/lib.rs",
    ],
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    proc_macro_deps = [
        "//third_party/rust_crates/vendor:async-trait",
    ],
    visibility = [
        "//src/diagnostics/detect/integration/realm_factory:__pkg__",
        "//src/lib/diagnostics/testing:__pkg__",
        "//src/sys/test_runners/inspect/tests:__pkg__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.diagnostics:fuchsia.diagnostics_rust",
        "//sdk/fidl/fuchsia.mem:fuchsia.mem_rust",
        "//sdk/rust/zx",
        "//sdk/rust/zx-status",
        "//src/lib/diagnostics/selectors",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-sync",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)
