import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("lib") {
  sources = [
    "src/lib.rs",
    "src/service.rs",
  ]
  crate_name = "inspect_runtime"
  edition = "2024"
  lint_config = "//build/config/rust/lints:clippy_warn_all"
  visibility = [ ":*" ]
  deps = []
  deps += [
    "//sdk/fidl/fuchsia.inspect:fuchsia.inspect_rust",
    "//sdk/fidl/fuchsia.mem:fuchsia.mem_rust",
    "//sdk/rust/zx",
    "//src/lib/diagnostics/inspect/rust",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component/client",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:pin-project",
  ]
  if (current_build_target_api_level == "PLATFORM" ||
      current_build_target_api_level == "HEAD") {
    deps += [ "//third_party/rust_crates:thiserror" ]
  }
}
