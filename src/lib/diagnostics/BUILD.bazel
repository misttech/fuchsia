load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "host_tests",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    tests = [
        "//src/lib/diagnostics/python/fuchsia_inspect:python_inspect_test",
    ],
)

# Diagnostics library device tests defined in Bazel. These are exported to
# `fx test` and infra builders through the `bazel_tests` target in
# //src/lib/diagnostics/BUILD.gn.
test_suite(
    name = "target_tests",
    target_compatible_with = ["@platforms//os:fuchsia"],
    tests = [
        "//src/lib/diagnostics/inspect/derive/tests:fuchsia-inspect-derive-tests",
        "//src/lib/diagnostics/selectors-ext:selectors-ext-test",
    ],
)
