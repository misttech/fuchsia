rustc_binary("logger_rust_bin") {
  testonly = true
  sources = [ "src/logger_rust.rs" ]
  output_name = "logger_rust"
  source_root = "src/logger_rust.rs"
  edition = "2024"
  visibility = [ ":*" ]
  deps = [
    "//src/lib/fuchsia",
    "//third_party/rust_crates:log",
  ]
