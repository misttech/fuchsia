load("//build/bazel/rules/rust:defs.bzl", "rustc_binary")

package(default_applicable_licenses = ["//:license"])

rustc_binary(
    name = "logger_rust_bin",
    testonly = True,
    srcs = ["src/logger_rust.rs"],
    crate_name = "logger_rust",
    crate_root = "src/logger_rust.rs",
    edition = "2024",
    visibility = ["//visibility:private"],
    deps = [
        "//src/lib/fuchsia",
        "//third_party/rust_crates/vendor:log",
    ],
)
