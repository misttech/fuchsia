source_set("accessor2logger") {
  sources = [
    "log_message.cc",
    "log_message.h",
  ]

  public_deps = [
    "//sdk/fidl/fuchsia.diagnostics:fuchsia.diagnostics_hlcpp",
    "//sdk/fidl/fuchsia.logger:fuchsia.logger_hlcpp",
    "//sdk/lib/fit-promise",
    "//sdk/lib/syslog/cpp",
    "//src/lib/diagnostics/log/message/rust/cpp-log-decoder:log_decoder_api",
  ]
  deps = [
    "//sdk/lib/async",
    "//sdk/lib/async-default",
    "//zircon/system/ulib/zx",
  ]
}

source_set("test_support") {
  testonly = true
  sources = [
    "test_support.cc",
    "test_support.h",
  ]

  public_deps = [
    "//sdk/fidl/fuchsia.diagnostics:fuchsia.diagnostics_hlcpp",
    "//sdk/fidl/fuchsia.logger:fuchsia.logger_hlcpp",
    "//sdk/lib/fit-promise",
    "//sdk/lib/syslog/cpp",
    "//zircon/system/ulib/zx",
  ]
  deps = [
    ":accessor2logger",
    "//src/lib/fsl",
    "//third_party/rapidjson",
  ]
}
