load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "fuchsia-image-format",
    srcs = [
        "src/image_format.rs",
        "src/lib.rs",
        "src/linux_drm.rs",
    ],
    edition = "2024",
    visibility = [
        "//src/graphics/display/bin/display-tool:__pkg__",
        "//src/media/stream_processors/test:__pkg__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.images2:fuchsia.images2_rust",
        "//sdk/fidl/fuchsia.math:fuchsia.math_rust",
        "//sdk/fidl/fuchsia.sysmem:fuchsia.sysmem_rust",
        "//sdk/fidl/fuchsia.sysmem2:fuchsia.sysmem2_rust",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:num-integer",
        "//third_party/rust_crates/vendor:vk-sys",
    ],
)

# @bazel2gn:skip
rustc_test(
    name = "fuchsia-image-format_test",
    crate = ":fuchsia-image-format",
    edition = "2024",
)

# @bazel2gn:skip
fx_unittest_package(
    name = "fuchsia-image-format-tests",
    package_name = "fuchsia-image-format-tests",
    unit_tests = [":fuchsia-image-format_test"],
    visibility = ["//src/lib:__pkg__"],
)
