if (is_host) {
  rustc_library("product_description") {
    sources = [ "src/lib.rs" ]
    edition = "2024"
    visibility = [
      ":*",
      "//tools/pbtool:*",
    ]
    deps = [ "//third_party/rust_crates:serde" ]
  }
}
if (is_host) {
  rustc_test("product_description_test") {
    sources = [ "src/lib.rs" ]
    edition = "2024"
    deps = [ "//third_party/rust_crates:serde" ] +
           [ "//third_party/rust_crates:serde_json" ]
  }
}
