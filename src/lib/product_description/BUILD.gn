import("//build/bazel/bazel_test_suite.gni")

bazel_test_suite("bazel_tests") {
  host_tests = [ "//src/lib/product_description:product_description_test" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    ":product_description_test($host_toolchain)",
  ]
}

