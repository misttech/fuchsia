import("//build/bazel/bazel_test_suite.gni")
import("//build/components.gni")
import("//build/rust/rustc_test.gni")

# The library and its host unit test are defined in BUILD.bazel. The Fuchsia
# unit test package stays in GN because it packages GN-only
# //src/connectivity/network/dns:component and
# //src/connectivity/network/netstack3:component-for-tests.
rustc_test("fuchsia-hyper-test-support_test") {
  output_name = "fuchsia_hyper_test_support_lib_test"
  edition = "2024"
  deps = [
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-hyper",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:chrono",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:http-body-util",
    "//third_party/rust_crates:hyper",
    "//third_party/rust_crates:hyper-util",
    "//third_party/rust_crates:pin-project",
    "//third_party/rust_crates:rustls",
    "//third_party/rust_crates:rustls-pemfile",
    "//third_party/rust_crates:tokio",
    "//third_party/rust_crates:tokio-rustls",
  ]
  sources = [
    "src/body.rs",
    "src/fault_injection.rs",
    "src/handler.rs",
    "src/lib.rs",
  ]
}

fuchsia_unittest_package("fuchsia-hyper-test-support-tests") {
  deps = [
    ":fuchsia-hyper-test-support_test",
    "//src/connectivity/network/dns:component",
    "//src/connectivity/network/netstack3:component-for-tests",
  ]

  manifest = "meta/fuchsia_hyper_test_support_lib_test.cml"
}

bazel_test_suite("host-tests") {
  host_tests = [ "//src/lib/testing/fuchsia-hyper-test-support:fuchsia-hyper-test-support_host_test" ]
}

group("tests") {
  testonly = true
  deps = [
    ":fuchsia-hyper-test-support-tests",
    ":host-tests",
  ]
}

