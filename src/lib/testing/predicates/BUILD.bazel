load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

cc_library(
    name = "predicates",
    srcs = [
        "status.cc",
    ],
    hdrs = [
        "status.h",
    ],
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = [
        "//src/devices:__subpackages__",
        "//src/media:__subpackages__",
        "//vendor/google:__subpackages__",
    ],
    deps = [
        "@com_google_googletest//:gtest_main",
        "@fuchsia_sdk//pkg/zx",
    ],
)

fx_cc_binary(
    name = "predicates-lib-unittests",
    testonly = True,
    srcs = ["predicates_test.cc"],
    tags = ["manual"],
    deps = [":predicates"],
)

fx_unittest_package(
    name = "predicates-lib-test",
    environments = ["//build/testing/environments:emu_env"],
    unit_tests = [":predicates-lib-unittests"],
)
