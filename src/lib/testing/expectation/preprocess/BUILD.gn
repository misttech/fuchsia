import("//build/bazel/bazel_test_suite.gni")

bazel_test_suite("bazel_tests") {
  host_tests = [ "//src/lib/testing/expectation/preprocess:bin_test" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    ":bin_test($host_toolchain)",
  ]
}

