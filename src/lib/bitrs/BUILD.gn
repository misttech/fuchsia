import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("bitrs") {
  sources = [ "src/lib.rs" ]
  edition = "2024"
  proc_macro_deps = [ ":bitrs-macro" ]
  visibility = [
    ":*",
    "//src/lib/bitrs/examples:*",
    "//src/performance/lib/fxt/rust:*",
    "//zircon/kernel/lib/arch:*",
    "//zircon/kernel/object:*",
  ]
  with_unit_tests = true
  deps = [ "//third_party/rust_crates:zerocopy" ]
}
if (is_host) {
  rustc_macro("bitrs-macro") {
    sources = [ "bitrs-macro/src/lib.rs" ]
    source_root = "bitrs-macro/src/lib.rs"
    edition = "2024"
    deps = [
      "//third_party/rust_crates:proc-macro2",
      "//third_party/rust_crates:quote",
      "//third_party/rust_crates:syn",
    ]
  }
}
