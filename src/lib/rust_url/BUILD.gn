import("//build/tools/bazel2gn/bazel_migration.gni")

source_set("rust_url") {
  sources = [ "rust_url.cc" ]
  public = [ "rust_url.h" ]
  deps = [ ":rust_url_c_api" ]
  visibility = [
    ":*",
    "//vendor/google/*",
  ]
}
executable("rust_url_unittests_bin") {
  testonly = true
  sources = [ "rust_url_unittests.cc" ]
  deps = [
    ":rust_url",
    "//src/lib/fxl/test:gtest_main",
  ]
}
fuchsia_unittest_package("rust_url_unittests") {
  package_name = "rust_url_unittests-gn"
  component_name = "rust_url_unittests"
  deps = [ ":rust_url_unittests_bin" ]
  visibility = [
    ":*",
    "//src/lib:*",
  ]
}
