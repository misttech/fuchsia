import("//build/bazel/bazel_test_suite.gni")

bazel_test_suite("fidl-fuchsia-net-ndp-ext-tests") {
  target_tests = [
    "//src/lib/network/fidl_fuchsia_net_ndp_ext:fidl-fuchsia-net-ndp-ext-tests",
  ]
  host_tests = [ "//src/lib/network/fidl_fuchsia_net_ndp_ext:fidl_fuchsia_net_ndp_ext_host_test" ]
}

group("tests") {
  testonly = true
  deps = [ ":fidl-fuchsia-net-ndp-ext-tests" ]
}

