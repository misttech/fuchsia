load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "fidl_fuchsia_net_dhcp_ext",
    srcs = ["src/lib.rs"],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    proc_macro_deps = [
        "//third_party/rust_crates/vendor:async-trait",
    ],
    visibility = [
        "//src/connectivity/network/testing/netemul/rust:__pkg__",
        "//src/connectivity/network/testing/network-test-realm/service:__pkg__",
        "//src/connectivity/network/tests/integration/dhcp-client:__pkg__",
        "//src/connectivity/policy/netcfg:__pkg__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.net.dhcp:fuchsia.net.dhcp_rust",
        "//sdk/fidl/fuchsia.net:fuchsia.net_rust",
        "//sdk/fidl/fuchsia.net.interfaces.admin:fuchsia.net.interfaces.admin_rust",
        "//sdk/fidl/fuchsia.net.resources:fuchsia.net.resources_rust",
        "//sdk/fidl/fuchsia.net.routes.admin:fuchsia.net.routes.admin_rust",
        "//sdk/fidl/fuchsia.net.routes:fuchsia.net.routes_rust",
        "//src/connectivity/lib/net-declare",
        "//src/connectivity/lib/net-types",
        "//src/lib/async-utils",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-async",
        "//src/lib/network/fidl_fuchsia_net_ext",
        "//src/lib/network/fidl_fuchsia_net_interfaces_ext",
        "//src/lib/network/fidl_fuchsia_net_routes_ext",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)

rustc_test(
    name = "fidl_fuchsia_net_dhcp_ext_test",
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate = ":fidl_fuchsia_net_dhcp_ext",
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    proc_macro_deps = [
        "//third_party/rust_crates/vendor:proptest-derive",
    ],
    deps = [
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:proptest",
        "//third_party/rust_crates/vendor:test-case",
    ],
)

fx_unittest_package(
    name = "fidl-fuchsia-net-dhcp-ext-tests",
    unit_tests = [":fidl_fuchsia_net_dhcp_ext_test"],
)
