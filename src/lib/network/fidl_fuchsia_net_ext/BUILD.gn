import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("fidl_fuchsia_net_ext") {
  sources = [ "src/lib.rs" ]
  configs += [ "//build/config/rust/lints:deny_unused_results" ]
  edition = "2024"
  proc_macro_deps = [ "//third_party/rust_crates:paste" ]
  visibility = [
    ":*",
    "//src/connectivity/*",
    "//src/developer/*",
    "//src/lib/fuchsia-hyper:*",
    "//src/lib/network/*",
    "//src/testing/sl4f:*",
    "//src/virtualization/*",
  ]
  deps = [
    "//sdk/fidl/fuchsia.net:fuchsia.net_rust_common",
    "//src/connectivity/lib/net-types",
    "//src/diagnostics/lib/redactor",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:serde",
  ]
}
