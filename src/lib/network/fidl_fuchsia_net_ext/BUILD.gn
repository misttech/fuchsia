import("//build/bazel/bazel_test_suite.gni")

bazel_test_suite("fidl-fuchsia-net-ext-tests") {
  target_tests =
      [ "//src/lib/network/fidl_fuchsia_net_ext:fidl-fuchsia-net-ext-tests" ]
}

group("tests") {
  testonly = true
  deps = [ ":fidl-fuchsia-net-ext-tests" ]
}

