load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "wrap_host_rust_test")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

_COMMON_SRCS = [
    "src/lib.rs",
] + select({
    "@platforms//os:fuchsia": ["src/sync.rs"],
    "//conditions:default": [],
})

_COMMON_BUILD_FLAGS = ["//build/config/rust/lints:deny_unused_results"]

# @bazel2gn:transformer=deps
_COMMON_DEPS = [
    "//src/lib/async-utils",
    "//src/lib/fidl/rust/fidl",
    "//third_party/rust_crates/vendor:futures",
    "//third_party/rust_crates/vendor:thiserror",
]

rustc_library(
    name = "fidl_fuchsia_net_filter_ext",
    srcs = _COMMON_SRCS,
    build_flags = _COMMON_BUILD_FLAGS,
    edition = "2024",
    visibility = [
        "//src/connectivity/network:__subpackages__",
        "//src/connectivity/policy/netcfg:__pkg__",
        "//src/connectivity/policy/tests/integration/management:__pkg__",
        "//src/starnix/kernel/core:__pkg__",
        "//src/starnix/tests/iptables:__pkg__",
    ],
    deps = _COMMON_DEPS + [
        "//sdk/fidl/fuchsia.ebpf:fuchsia.ebpf_rust_flex",
        "//sdk/fidl/fuchsia.net.filter:fuchsia.net.filter_rust_flex",
        "//sdk/fidl/fuchsia.net:fuchsia.net_rust_flex",
        "//sdk/fidl/fuchsia.net.root:fuchsia.net.root_rust_flex",
        "//src/lib/fdomain/client:flex_fidl",
        "//src/lib/network/fidl_fuchsia_net_interfaces_ext",
        "//src/lib/network/fidl_fuchsia_net_matchers_ext",
    ] + select({
        "@platforms//os:fuchsia": ["//sdk/rust/zx"],
        "//conditions:default": [],
    }),
)

rustc_library(
    name = "fidl_fuchsia_net_filter_ext_fdomain",
    srcs = _COMMON_SRCS,
    build_flags = _COMMON_BUILD_FLAGS,
    crate_features = ["fdomain"],
    edition = "2024",
    visibility = [
        "//src/connectivity/network/lib/netfilter:__pkg__",
        "//src/connectivity/network/net-cli:__pkg__",
    ],
    deps = _COMMON_DEPS + [
        "//sdk/fidl/fuchsia.ebpf:fuchsia.ebpf_rust_fdomain_flex",
        "//sdk/fidl/fuchsia.net.filter:fuchsia.net.filter_rust_fdomain_flex",
        "//sdk/fidl/fuchsia.net:fuchsia.net_rust_fdomain_flex",
        "//sdk/fidl/fuchsia.net.root:fuchsia.net.root_rust_fdomain_flex",
        "//src/lib/fdomain/client:flex_fdomain",
        "//src/lib/network/fidl_fuchsia_net_interfaces_ext:fidl_fuchsia_net_interfaces_ext_fdomain",
        "//src/lib/network/fidl_fuchsia_net_matchers_ext:fidl_fuchsia_net_matchers_ext_fdomain",
    ],
)

rustc_test(
    name = "fidl_fuchsia_net_filter_ext_test",
    build_flags = _COMMON_BUILD_FLAGS,
    crate = ":fidl_fuchsia_net_filter_ext",
    edition = "2024",
    deps = [
        "//sdk/fidl/fuchsia.hardware.network:fuchsia.hardware.network_rust_flex",
        "//sdk/fidl/fuchsia.net.interfaces:fuchsia.net.interfaces_rust_flex",
        "//sdk/fidl/fuchsia.net.matchers:fuchsia.net.matchers_rust_flex",
        "//src/lib/fdomain/local:local_fidl_flex",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:test-case",
    ],
)

rustc_test(
    name = "fidl_fuchsia_net_filter_ext_fdomain_test",
    build_flags = _COMMON_BUILD_FLAGS,
    crate = ":fidl_fuchsia_net_filter_ext_fdomain",
    crate_features = ["fdomain"],
    edition = "2024",
    deps = [
        "//sdk/fidl/fuchsia.hardware.network:fuchsia.hardware.network_rust_fdomain_flex",
        "//sdk/fidl/fuchsia.net.interfaces:fuchsia.net.interfaces_rust_fdomain_flex",
        "//sdk/fidl/fuchsia.net.matchers:fuchsia.net.matchers_rust_fdomain_flex",
        "//src/lib/fdomain/local:local_fdomain_flex",
        "//src/lib/fuchsia-async",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:test-case",
    ],
)

wrap_host_rust_test(
    name = "fidl_fuchsia_net_filter_ext_fdomain_host_test",
    binary_name = "fidl_fuchsia_net_filter_ext_fdomain_test",
)

fx_unittest_package(
    name = "fidl-fuchsia-net-filter-ext-tests",
    unit_tests = [":fidl_fuchsia_net_filter_ext_test"],
)

fx_unittest_package(
    name = "fidl-fuchsia-net-filter-ext-fdomain-tests",
    unit_tests = [":fidl_fuchsia_net_filter_ext_fdomain_test"],
)
