load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "wrap_host_rust_test")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

_COMMON_SRCS = ["src/lib.rs"]

_COMMON_BUILD_FLAGS = ["//build/config/rust/lints:deny_unused_results"]

# @bazel2gn:transformer=deps
_COMMON_DEPS = [
    "//sdk/fidl/fuchsia.net:fuchsia.net_rust_common",
    "//sdk/fidl/fuchsia.net.interfaces:fuchsia.net.interfaces_rust_common",
    "//sdk/fidl/fuchsia.net.matchers:fuchsia.net.matchers_rust_common",
    "//src/connectivity/lib/net-types",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/network/fidl_fuchsia_net_ext",
    "//third_party/rust_crates/vendor:thiserror",
]

rustc_library(
    name = "fidl_fuchsia_net_matchers_ext",
    srcs = _COMMON_SRCS,
    build_flags = _COMMON_BUILD_FLAGS,
    edition = "2024",
    visibility = [
        "//src/connectivity:__subpackages__",
        "//src/lib/network:__subpackages__",
        "//src/starnix:__subpackages__",
    ],
    deps = _COMMON_DEPS + [
        "//src/lib/network/fidl_fuchsia_net_interfaces_ext",
    ],
)

rustc_library(
    name = "fidl_fuchsia_net_matchers_ext_fdomain",
    srcs = _COMMON_SRCS,
    build_flags = _COMMON_BUILD_FLAGS,
    crate_features = ["fdomain"],
    edition = "2024",
    visibility = [
        "//src/connectivity/network/lib/netfilter:__pkg__",
        "//src/connectivity/network/net-cli:__pkg__",
        "//src/lib/network/fidl_fuchsia_net_filter_ext:__pkg__",
        "//src/lib/network/fidl_fuchsia_net_routes_ext:__pkg__",
    ],
    deps = _COMMON_DEPS + [
        "//src/lib/network/fidl_fuchsia_net_interfaces_ext:fidl_fuchsia_net_interfaces_ext_fdomain",
    ],
)

rustc_test(
    name = "fidl_fuchsia_net_matchers_ext_test",
    build_flags = _COMMON_BUILD_FLAGS,
    crate = ":fidl_fuchsia_net_matchers_ext",
    edition = "2024",
    deps = [
        "//src/connectivity/lib/net-declare",
        "//third_party/rust_crates/vendor:test-case",
    ],
)

rustc_test(
    name = "fidl_fuchsia_net_matchers_ext_fdomain_test",
    build_flags = _COMMON_BUILD_FLAGS,
    crate = ":fidl_fuchsia_net_matchers_ext_fdomain",
    crate_features = ["fdomain"],
    edition = "2024",
    deps = [
        "//src/connectivity/lib/net-declare",
        "//third_party/rust_crates/vendor:test-case",
    ],
)

wrap_host_rust_test(
    name = "fidl_fuchsia_net_matchers_ext_fdomain_host_test",
    binary_name = "fidl_fuchsia_net_matchers_ext_fdomain_test",
)

fx_unittest_package(
    name = "fidl-fuchsia-net-matchers-ext-tests",
    unit_tests = [":fidl_fuchsia_net_matchers_ext_test"],
)

fx_unittest_package(
    name = "fidl-fuchsia-net-matchers-ext-fdomain-tests",
    unit_tests = [":fidl_fuchsia_net_matchers_ext_fdomain_test"],
)
