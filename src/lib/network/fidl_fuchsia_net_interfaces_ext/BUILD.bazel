load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "wrap_host_rust_test")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

_COMMON_SRCS = [
    "src/admin.rs",
    "src/lib.rs",
    "src/reachability.rs",
]

_COMMON_BUILD_FLAGS = ["//build/config/rust/lints:deny_unused_results"]

# @bazel2gn:transformer=deps
_COMMON_PROC_MACRO_DEPS = [
    "//third_party/rust_crates/vendor:derivative",
]

# @bazel2gn:transformer=deps
_COMMON_DEPS = [
    "//sdk/rust/zx-types",
    "//src/connectivity/lib/net-types",
    "//src/lib/async-utils",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fidl_table_validation",
    "//third_party/rust_crates/vendor:futures",
    "//third_party/rust_crates/vendor:thiserror",
] + select({
    "@platforms//os:fuchsia": ["//sdk/rust/zx"],
    "//conditions:default": [],
})

# @bazel2gn:skip
_COMMON_TEST_DEPS = [
    "//sdk/rust/zx-status",
    "//src/connectivity/lib/net-declare",
    "//src/lib/fuchsia-async",
    "//third_party/rust_crates/vendor:anyhow",
    "//third_party/rust_crates/vendor:assert_matches",
    "//third_party/rust_crates/vendor:test-case",
]

rustc_library(
    name = "fidl_fuchsia_net_interfaces_ext",
    srcs = _COMMON_SRCS,
    build_flags = _COMMON_BUILD_FLAGS,
    edition = "2024",
    proc_macro_deps = _COMMON_PROC_MACRO_DEPS,
    visibility = [
        "//src/connectivity:__subpackages__",
        "//src/developer:__subpackages__",
        "//src/lib/network:__subpackages__",
        "//src/starnix:__subpackages__",
        "//src/sys:__subpackages__",
        "//src/testing/sl4f:__pkg__",
    ],
    deps = _COMMON_DEPS + [
        "//sdk/fidl/fuchsia.hardware.network:fuchsia.hardware.network_rust_flex",
        "//sdk/fidl/fuchsia.net:fuchsia.net_rust_flex",
        "//sdk/fidl/fuchsia.net.interfaces.admin:fuchsia.net.interfaces.admin_rust_flex",
        "//sdk/fidl/fuchsia.net.interfaces:fuchsia.net.interfaces_rust_flex",
        "//sdk/fidl/fuchsia.net.resources:fuchsia.net.resources_rust_flex",
        "//src/lib/fdomain/client:flex_fidl",
    ],
)

rustc_library(
    name = "fidl_fuchsia_net_interfaces_ext_fdomain",
    srcs = _COMMON_SRCS,
    build_flags = _COMMON_BUILD_FLAGS,
    crate_features = ["fdomain"],
    edition = "2024",
    proc_macro_deps = _COMMON_PROC_MACRO_DEPS,
    visibility = [
        "//src/connectivity/network/lib/netfilter:__pkg__",
        "//src/connectivity/network/net-cli:__pkg__",
        "//src/lib/network/fidl_fuchsia_net_filter_ext:__pkg__",
        "//src/lib/network/fidl_fuchsia_net_matchers_ext:__pkg__",
    ],
    deps = _COMMON_DEPS + [
        "//sdk/fidl/fuchsia.hardware.network:fuchsia.hardware.network_rust_fdomain_flex",
        "//sdk/fidl/fuchsia.net:fuchsia.net_rust_fdomain_flex",
        "//sdk/fidl/fuchsia.net.interfaces.admin:fuchsia.net.interfaces.admin_rust_fdomain_flex",
        "//sdk/fidl/fuchsia.net.interfaces:fuchsia.net.interfaces_rust_fdomain_flex",
        "//sdk/fidl/fuchsia.net.resources:fuchsia.net.resources_rust_fdomain_flex",
        "//src/lib/fdomain/client:flex_fdomain",
    ],
)

# @bazel2gn:skip
rustc_test(
    name = "fidl_fuchsia_net_interfaces_ext_test",
    build_flags = _COMMON_BUILD_FLAGS,
    crate = ":fidl_fuchsia_net_interfaces_ext",
    edition = "2024",
    deps = _COMMON_TEST_DEPS + [
        "//src/lib/fdomain/local:local_fidl_flex",
    ],
)

# @bazel2gn:skip
rustc_test(
    name = "fidl_fuchsia_net_interfaces_ext_fdomain_test",
    build_flags = _COMMON_BUILD_FLAGS,
    crate = ":fidl_fuchsia_net_interfaces_ext_fdomain",
    crate_features = ["fdomain"],
    edition = "2024",
    deps = _COMMON_TEST_DEPS + [
        "//src/lib/fdomain/local:local_fdomain_flex",
    ],
)

# @bazel2gn:skip
wrap_host_rust_test(
    name = "fidl_fuchsia_net_interfaces_ext_fdomain_host_test",
    binary_name = "fidl_fuchsia_net_interfaces_ext_fdomain_test",
)

# @bazel2gn:skip
fx_unittest_package(
    name = "fidl-fuchsia-net-interfaces-ext-tests",
    unit_tests = [":fidl_fuchsia_net_interfaces_ext_test"],
)

# @bazel2gn:skip
fx_unittest_package(
    name = "fidl-fuchsia-net-interfaces-ext-fdomain-tests",
    unit_tests = [":fidl_fuchsia_net_interfaces_ext_fdomain_test"],
)
