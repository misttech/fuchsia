load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "wrap_host_rust_test")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "fidl_fuchsia_net_multicast_ext",
    srcs = ["src/lib.rs"],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    edition = "2024",
    visibility = [
        "//src/connectivity/network/netstack3:__pkg__",
        "//src/connectivity/network/tests/integration/inspect:__pkg__",
        "//src/connectivity/network/tests/integration/multicast-forwarding:__pkg__",
        "//src/lib/network:__pkg__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.net.multicast.admin:fuchsia.net.multicast.admin_rust",
        "//src/connectivity/lib/net-types",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/network/fidl_fuchsia_net_ext",
        "//third_party/rust_crates/vendor:futures",
    ],
)

rustc_test(
    name = "fidl_fuchsia_net_multicast_ext_test",
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate = ":fidl_fuchsia_net_multicast_ext",
    edition = "2024",
    deps = [
        "//src/connectivity/lib/net-declare",
        "//third_party/rust_crates/vendor:test-case",
    ],
)

wrap_host_rust_test(
    name = "fidl_fuchsia_net_multicast_ext_host_test",
    binary_name = "fidl_fuchsia_net_multicast_ext_test",
)

fx_unittest_package(
    name = "fidl-fuchsia-net-multicast-ext-tests",
    unit_tests = [":fidl_fuchsia_net_multicast_ext_test"],
)
