rustc_library("netsvc-proto") {
  sources = [
    "src/debuglog.rs",
    "src/lib.rs",
    "src/netboot.rs",
    "src/tftp.rs",
  ]
  configs += [ "//build/config/rust/lints:deny_unused_results" ]
  edition = "2024"
  visibility = [
    ":*",
    "//src/bringup/bin/netsvc/test/integration:*",
    "//src/connectivity/lib/packet-formats:*",
  ]
  deps = [
    "//src/lib/network/packet",
    "//third_party/rust_crates:arrayvec",
    "//third_party/rust_crates:thiserror",
    "//third_party/rust_crates:unicase",
    "//third_party/rust_crates:zerocopy",
  ]
}

rustc_test("netsvc-proto_test") {
  sources = [
    "src/debuglog.rs",
    "src/lib.rs",
    "src/netboot.rs",
    "src/tftp.rs",
  ]
  edition = "2024"
  deps = [
           "//src/lib/network/packet",
           "//third_party/rust_crates:arrayvec",
           "//third_party/rust_crates:thiserror",
           "//third_party/rust_crates:unicase",
           "//third_party/rust_crates:zerocopy",
         ] + [ "//third_party/rust_crates:assert_matches" ]
  configs += [ "//build/config/rust/lints:deny_unused_results" ]
}

fuchsia_unittest_package("netsvc-proto-test") {
  package_name = "netsvc-proto-test-gn"
  component_name = "netsvc-proto-test"
  deps = [ ":netsvc-proto_test" ]
}
