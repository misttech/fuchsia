import("//build/bazel/bazel_test_suite.gni")

bazel_test_suite("bazel_tests") {
  target_tests = [ "//src/lib/network/netsvc-proto:netsvc-proto-test" ]
  host_tests = [ "//src/lib/network/netsvc-proto:netsvc-proto_host_test" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    ":netsvc-proto-test",
    ":netsvc-proto_test($host_toolchain)",
  ]
}

