import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("fuchsia-rseq") {
  sources = [ "src/lib.rs" ]
  edition = "2024"
  visibility = [
    ":*",
    "//src/lib/fuchsia-rcu:*",
  ]
  with_unit_tests = true
  deps = [
    "//sdk/rust/zx",
    "//sdk/rust/zx-types",
    "//src/lib/fuchsia-runtime",
    "//src/lib/fuchsia-sync",
  ]
}

fuchsia_component_manifest("fuchsia-rseq-tests-manifest") {
  testonly = true
  component_name = "fuchsia-rseq-tests"
  manifest = "meta/fuchsia_rseq_tests.cml"
}

fuchsia_test_component("fuchsia-rseq-tests-component") {
  cm_label = ":fuchsia-rseq-tests-manifest"
  component_name = "fuchsia-rseq-tests"
  deps = [ ":fuchsia-rseq_test" ]
}

fuchsia_test_package("fuchsia-rseq-tests-package") {
  package_name = "fuchsia-rseq-tests-gn"
  test_components = [ ":fuchsia-rseq-tests-component" ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}
