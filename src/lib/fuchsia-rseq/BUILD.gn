import("//build/bazel/bazel_test_suite.gni")
import("//build/components.gni")

bazel_test_suite("bazel_tests") {
  target_tests = [ "//src/lib/fuchsia-rseq:fuchsia-rseq-tests" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    ":fuchsia-rseq-tests-package",
  ]
}

