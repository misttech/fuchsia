if (is_host) {
  rustc_library("usb_rs") {
    sources = [
      "src/bulk_interface.rs",
      "src/lib.rs",
      "src/usb_linux/discovery.rs",
      "src/usb_linux/mod.rs",
      "src/usb_linux/usbdevice_fs.rs",
    ]
    edition = "2024"
    test_deps = [
      "//src/lib/fuchsia",
      "//third_party/rust_crates:tempfile",
    ]
    visibility = [
      ":*",
      "//src/developer/ffx/lib/usb_fastboot_discovery:*",
      "//src/developer/ffx/lib/usb_vsock_host:*",
      "//tools/zedmon/client:*",
    ]
    with_unit_tests = true
    deps = [
      "//src/lib/fuchsia-sync",
      "//third_party/rust_crates:futures",
      "//third_party/rust_crates:libc",
      "//third_party/rust_crates:log",
      "//third_party/rust_crates:nix",
      "//third_party/rust_crates:notify",
      "//third_party/rust_crates:thiserror",
      "//third_party/rust_crates:tokio",
      "//third_party/rust_crates:zerocopy",
    ]
  }
}
