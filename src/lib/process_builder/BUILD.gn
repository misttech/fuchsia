import("//build/components.gni")
import("//build/rust/rustc_test.gni")

# `process_builder_test` and `process-builder-tests` remain in GN because
# `process-builder-tests` depends on `//src/lib/elf_parse:static_pie_test_util`
# (which requires `//sdk/lib/c:static`) and `//src/sys/testing/elftest`, which
# are not yet migrated to Bazel.
rustc_test("process_builder_test") {
  name = "process_builder_lib_test"
  edition = "2024"

  deps = [
    ":test-util-fidl_rust",
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//sdk/fidl/fuchsia.ldsvc:fuchsia.ldsvc_rust",
    "//sdk/rust/zx",
    "//src/lib/elf_parse",
    "//src/lib/fdio/rust:fdio",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-runtime",
    "//src/storage/lib/vfs/rust:vfs",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:assert_matches",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:static_assertions",
    "//third_party/rust_crates:thiserror",
    "//third_party/rust_crates:zerocopy",
  ]

  sources = [
    "src/elf_load.rs",
    "src/lib.rs",
    "src/process_args.rs",
    "src/process_builder.rs",
    "src/util.rs",
  ]
}

fuchsia_unittest_package("process-builder-tests") {
  manifest = "meta/process_builder_tests.cml"
  deps = [
    ":process_builder_test",
    ":test_util",
    "//src/lib/elf_parse:static_pie_test_util",
    "//src/sys/testing/elftest",
  ]

  # Needed for fuchsia.kernel.RootJob
  test_type = "system"
}

group("tests") {
  testonly = true
  deps = [ ":process-builder-tests" ]
}

