source_set("fostr") {
  sources = [
    "fidl_types.cc",
    "hex_dump.cc",
    "zx_types.cc",
  ]
  public = [
    "fidl_types.h",
    "hex_dump.h",
    "indent.h",
    "zx_types.h",
  ]
  deps = [ ":fostr_shared" ]
  visibility = [
    ":*",
    "//src/connectivity/network/mdns/service:*",
    "//src/connectivity/network/mdns/util:*",
    "//src/connectivity/network/testing/netemul/network-context/lib:*",
    "//src/developer/forensics/testing:*",
    "//src/lib/fostr/*",
    "//vendor/google/*",
  ]
  if (is_fuchsia) {
    public_deps = [
      "//sdk/lib/fidl/hlcpp",
      "//zircon/system/ulib/zx",
    ]
  } else {
    public_deps = [ "//sdk/lib/fidl/hlcpp:hlcpp_base" ]
  }
}
