import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("container") {
  sources = [
    "src/handles.rs",
    "src/lib.rs",
    "src/test.rs",
    "src/wire.rs",
  ]
  crate_name = "fdomain_container"
  edition = "2024"
  test_deps = [ "//src/lib/fuchsia" ]
  visibility = [
    ":*",
    "//src/developer/remote-control:*",
    "//src/lib/fdomain/client:*",
    "//src/lib/fdomain/example:*",
    "//src/lib/fdomain/example_next:*",
    "//src/lib/fdomain/local:*",
  ]
  with_unit_tests = true
  deps = []
  deps += [
    "//sdk/fidl/fuchsia.fdomain:fuchsia.fdomain_rust",
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fidl/rust/fidl_message",
    "//src/lib/replace-with",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:pin-project",
    "//third_party/rust_crates:rand",
  ]
  if (is_fuchsia) {
    deps += [
      "//sdk/rust/zx",
      "//src/lib/fuchsia-async",
    ]
  }
}
