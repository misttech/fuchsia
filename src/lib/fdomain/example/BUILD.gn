import("//build/components.gni")

# Kept in GN because `fdomain-example-bin` depends on
# `//src/storage/lib/vfs/rust:vfs` (`rustc_dylib("vfs_dylib")`), which places
# two copies of `libvfs-<hash>.so` in Bazel `default_runfiles` and causes
# `fx_packaged_binary` + `fx_package` to fail with duplicate `lib/libvfs-*.so`.
fuchsia_test_component("fdomain-example-component") {
  deps = [ ":fdomain-example-bin" ]
  component_name = "fdomain-example"
  manifest = "meta/fdomain-example.cml"
}

fuchsia_test_package("fdomain-example") {
  test_components = [ ":fdomain-example-component" ]
}

