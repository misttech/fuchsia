load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "platform_artifacts",
    srcs = [
        "src/lib.rs",
        "src/platform_artifacts.rs",
    ],
    crate_name = "assembly_platform_artifacts",
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = [
        "//build/assembly/tools:__subpackages__",
        "//src/developer/ffx/plugins/product_bundle/bisect:__pkg__",
        "//src/lib/assembly:__subpackages__",
    ],
    deps = [
        "//src/lib/assembly/container",
        "//src/lib/assembly/release_info",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:camino",
        "//third_party/rust_crates/vendor:serde",
    ],
)
