load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")

package(default_applicable_licenses = ["//:license"])

# Assembly host tests defined in Bazel. These are exported to `fx test` and
# infra builders through `:bazel_tests` in BUILD.gn.
test_suite(
    name = "host_tests",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    tests = [
        "//src/lib/assembly/blobfs:blobfs_test",
        "//src/lib/assembly/package_copy:package_copy_test",
        "//src/lib/assembly/package_list:package_list_test",
    ],
)
