load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "shell_commands",
    srcs = [
        "src/lib.rs",
        "src/shell_commands.rs",
    ],
    crate_name = "assembly_shell_commands",
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//src/lib/assembly/image_assembly_config_builder:__pkg__"],
    deps = [
        "//src/lib/assembly/config_schema",
        "//src/lib/assembly/constants",
        "//src/lib/assembly/package_utils",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-url",
        "//src/sys/pkg/lib/fuchsia-pkg",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:camino",
        "//tools/lib/cml",
    ],
)

host_rustc_test(
    name = "shell_commands_test",
    crate = ":shell_commands",
    visibility = ["//src/lib/assembly:__pkg__"],
    deps = ["//third_party/rust_crates/vendor:tempfile"],
)
