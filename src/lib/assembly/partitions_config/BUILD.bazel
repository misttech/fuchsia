load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "partitions_config",
    srcs = [
        "src/lib.rs",
        "src/partition_image_mapper.rs",
        "src/partitions_config.rs",
    ],
    crate_name = "assembly_partitions_config",
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = [
        "//build/assembly/tools/assembly_config:__pkg__",
        "//src/developer/ffx:__subpackages__",
        "//src/lib/assembly:__subpackages__",
        "//src/security/lib/scrutiny/collection:__pkg__",
        "//src/sys/pkg/lib/package-tool:__pkg__",
        "//tools/make-fuchsia-vol:__pkg__",
        "//tools/pbtool:__pkg__",
    ],
    deps = [
        "//src/lib/assembly/assembled_system",
        "//src/lib/assembly/container",
        "//src/lib/assembly/util",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:camino",
        "//third_party/rust_crates/vendor:hex",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:ring",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:serde_json",
        "//third_party/rust_crates/vendor:sha2",
        "//third_party/rust_crates/vendor:url",
    ],
)

host_rustc_test(
    name = "partitions_config_test",
    crate = ":partitions_config",
    visibility = ["//src/lib/assembly:__pkg__"],
    deps = [
        "//src/lib/assembly/release_info",
        "//third_party/rust_crates/vendor:pretty_assertions",
        "//third_party/rust_crates/vendor:tempfile",
    ],
)
