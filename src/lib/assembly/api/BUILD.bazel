load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/rust:defs.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "api",
    srcs = [
        "src/api.rs",
        "src/lib.rs",
        "src/release_info.rs",
    ],
    crate_name = "assembly_api",
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    version = "0.1.0",
    visibility = [
        "//src/developer/ffx/plugins/assembly:__pkg__",
        "//src/developer/ffx/plugins/product/get_version:__pkg__",
        "//src/developer/ffx/plugins/product_bundle/bisect:__pkg__",
        "//src/developer/ffx/plugins/product_bundle/create:__pkg__",

        # Needed by the GN `api_test` target generated from
        # `with_host_unit_tests`, which inherits this visibility and is
        # referenced by //src/lib/assembly:tests.
        "//src/lib/assembly:__pkg__",
    ],
    with_host_unit_tests = True,
    deps = [
        "//src/developer/ffx/config:lib",
        "//src/lib/assembly/cli_args",
        "//src/lib/assembly/release_info",
        "//src/lib/assembly/tool",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:camino",
        "//third_party/rust_crates/vendor:serde_json",
        "//third_party/rust_crates/vendor:tempfile",
    ],
)
