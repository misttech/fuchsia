load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "assembled_system",
    srcs = [
        "src/assembled_system.rs",
        "src/base_package.rs",
        "src/blobfs.rs",
        "src/extra_hash_descriptor.rs",
        "src/fvm.rs",
        "src/fxfs.rs",
        "src/image.rs",
        "src/lib.rs",
        "src/vbmeta.rs",
        "src/zbi.rs",
    ],
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = [
        "//build/assembly/tools/assembly:__pkg__",
        "//src/developer/ffx:__subpackages__",
        "//src/lib/assembly:__subpackages__",
        "//src/microfuchsia/testing:__pkg__",
        "//tools/make-fuchsia-vol:__pkg__",
        "//tools/pbtool:__pkg__",
        "//tools/pkgstats:__pkg__",
    ],
    deps = [
        "//src/lib/assembly/base_package",
        "//src/lib/assembly/blobfs",
        "//src/lib/assembly/cli_args",
        "//src/lib/assembly/config_schema",
        "//src/lib/assembly/constants",
        "//src/lib/assembly/container",
        "//src/lib/assembly/fvm",
        "//src/lib/assembly/fxfs",
        "//src/lib/assembly/image_assembly_config",
        "//src/lib/assembly/images_config",
        "//src/lib/assembly/package_list",
        "//src/lib/assembly/release_info",
        "//src/lib/assembly/tool",
        "//src/lib/assembly/util",
        "//src/lib/assembly/vbmeta",
        "//src/lib/assembly/zbi",
        "//src/lib/utf8_path",
        "//src/lib/versioning/version-history/rust",
        "//src/sys/pkg/lib/fuchsia-hash",
        "//src/sys/pkg/lib/fuchsia-merkle",
        "//src/sys/pkg/lib/fuchsia-pkg",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:camino",
        "//third_party/rust_crates/vendor:hex",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:pathdiff",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:serde_json",
    ],
)

host_rustc_test(
    name = "assembled_system_test",
    crate = ":assembled_system",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    visibility = ["//src/lib/assembly:__pkg__"],
    deps = [
        "//src/lib/assembly/test_keys",
        "//src/lib/fuchsia-async",
        "//src/sys/pkg/lib/far/rust:fuchsia-archive",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:regex",
        "//third_party/rust_crates/vendor:tempfile",
    ],
)
