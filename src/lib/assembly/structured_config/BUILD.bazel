load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "structured_config",
    srcs = ["src/lib.rs"],
    crate_name = "assembly_structured_config",
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = [
        "//src/lib/assembly/image_assembly_config_builder:__pkg__",
        "//src/lib/assembly/structured_config/tests/malformed_fail:__pkg__",
        "//src/lib/assembly/structured_config/tests/repackaging_pass:__pkg__",
        "//src/lib/assembly/validate_package:__pkg__",
    ],
    deps = [
        "//src/lib/assembly/validate_util",
        "//src/lib/directed_graph",
        "//src/lib/fidl/rust/fidl",
        "//src/sys/lib/cm_fidl_validator",
        "//src/sys/lib/cm_rust",
        "//src/sys/lib/config_encoder",
        "//src/sys/pkg/lib/fuchsia-pkg",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:camino",
        "//third_party/rust_crates/vendor:serde_json",
        "//third_party/rust_crates/vendor:thiserror",
        "//tools/lib/config_value_file",
    ],
)
