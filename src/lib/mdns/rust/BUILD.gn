import("//build/bazel/bazel_test_suite.gni")

group("rust") {
  public_deps = [ ":mdns" ]
}

bazel_test_suite("bazel_tests") {
  target_tests = [ "//src/lib/mdns/rust:mdns-rust-tests" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    ":mdns-rust-tests",
  ]
}

