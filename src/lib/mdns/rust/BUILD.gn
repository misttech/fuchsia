import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("mdns") {
  sources = [
    "src/lib.rs",
    "src/protocol.rs",
  ]
  edition = "2024"
  visibility = [
    ":*",
    "//src/connectivity/lib/packet-formats:*",
    "//src/connectivity/lib/packet-formats-dhcp:*",
    "//src/developer/ffx/lib/mdns_discovery:*",
    "//src/testing/end_to_end/antlion/runner:*",
  ]
  deps = [
    "//src/lib/network/packet",
    "//third_party/rust_crates:zerocopy",
  ]
}
rustc_test("mdns_lib_test") {
  sources = [
    "src/lib.rs",
    "src/protocol.rs",
  ]
  edition = "2024"
  deps = [
    "//src/lib/network/packet",
    "//third_party/rust_crates:zerocopy",
  ]
}
fuchsia_unittest_package("mdns-rust-tests") {
  package_name = "mdns-rust-tests-gn"
  component_name = "mdns-rust-tests"
  deps = [ ":mdns_lib_test" ]
}
