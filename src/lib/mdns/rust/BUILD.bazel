load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "mdns",
    srcs = [
        "src/lib.rs",
        "src/protocol.rs",
    ],
    edition = "2024",
    visibility = [
        "//src/connectivity/lib/packet-formats:__pkg__",
        "//src/connectivity/lib/packet-formats-dhcp:__pkg__",
        "//src/developer/ffx/lib/mdns_discovery:__pkg__",
        "//src/testing/end_to_end/antlion/runner:__pkg__",
    ],
    deps = [
        "//src/lib/network/packet",
        "//third_party/rust_crates/vendor:zerocopy",
    ],
)

rustc_test(
    name = "mdns_lib_test",
    crate = ":mdns",
    edition = "2024",
)

fx_unittest_package(
    name = "mdns-rust-tests",
    unit_tests = [":mdns_lib_test"],
)
