import("//build/bazel/bazel_test_suite.gni")

group("model") {
  testonly = true
  public_deps = [
    ":lib",
    ":tests",
  ]
}

bazel_test_suite("lib_test") {
  host_tests = [ "//src/lib/intl/model:lib_test" ]
}

group("tests") {
  testonly = true

  public_deps = [ ":lib_test" ]
}

