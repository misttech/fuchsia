    deps = [
      "//src/lib/intl/model:lib",
      "//third_party/rust_crates:anyhow",
      "//third_party/rust_crates:handlebars",
      "//third_party/rust_crates:regex",
      "//third_party/rust_crates:serde",
      "//third_party/rust_crates:xml",
    ]
  }
}
if (is_host) {
  rustc_test("lib_test") {
    sources = [
      "src/json.rs",
      "src/lib.rs",
      "src/message_ids.rs",
      "src/parser.rs",
    ]
    edition = "2024"
    deps = [
      "//src/lib/intl/model:lib",
      "//third_party/rust_crates:anyhow",
      "//third_party/rust_crates:handlebars",
      "//third_party/rust_crates:regex",
      "//third_party/rust_crates:serde",
      "//third_party/rust_crates:xml",
    ]
    output_name = "intl_strings_lib_test"
    visibility = [
      ":*",
      "//src/lib:*",
    ]
  }
}
