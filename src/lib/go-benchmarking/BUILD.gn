import("//build/go/go_library.gni")
import("//build/go/go_test.gni")

go_library("go-benchmarking") {
  sources = [
    "results.go",
    "results_test.go",
  ]
}

go_test("go_benchmarking_test") {
  embed = [ ":go-benchmarking" ]
}

group("tests") {
  testonly = true
  deps = [ ":go_benchmarking_test($host_toolchain)" ]
}
