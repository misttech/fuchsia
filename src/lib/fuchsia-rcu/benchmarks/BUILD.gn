import("//build/tools/bazel2gn/bazel_migration.gni")

config("check_cfg_flags") {
  rustflags = [ "--check-cfg=cfg(rcu_backend, values(\"rseq\", \"atomic\"))" ]
}
rustc_binary("bin_rseq") {
  testonly = true
  sources = [ "src/main.rs" ]
  configs += [
    ":check_cfg_flags",
    "//build/config/rust/lints:deny_unused_results",
  ]
  output_name = "fuchsia_rcu_benchmarks_rseq"
  edition = "2024"
  rustflags = [ "--cfg=rcu_backend=\"rseq\"" ]
  deps = [
    "//src/developer/fuchsia-criterion",
    "//src/lib/fuchsia-rcu",
  ]
}
rustc_binary("bin_atomic") {
  testonly = true
  sources = [ "src/main.rs" ]
  configs += [
    ":check_cfg_flags",
    "//build/config/rust/lints:deny_unused_results",
  ]
  output_name = "fuchsia_rcu_benchmarks_atomic"
  edition = "2024"
  rustflags = [ "--cfg=rcu_backend=\"atomic\"" ]
  deps = [
    "//src/developer/fuchsia-criterion",
    "//src/lib/fuchsia-rcu:fuchsia-rcu-atomic",
  ]
}
