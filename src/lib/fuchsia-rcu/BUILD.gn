rustc_macro("fuchsia-rcu-derive") {
  sources = [ "macro/src/lib.rs" ]
  source_root = "macro/src/lib.rs"
  edition = "2024"
  deps = [
    "//third_party/rust_crates:proc-macro2",
    "//third_party/rust_crates:quote",
    "//third_party/rust_crates:syn",
  ]
}
rustc_library("fuchsia-rcu") {
  sources = _COMMON_SRCS
  features = [ "rseq_backend" ]
  edition = "2024"
  proc_macro_deps = [ ":fuchsia-rcu-derive" ]
  version = "0.1.0"
  with_unit_tests = true
  deps = _COMMON_DEPS + [ "//src/lib/fuchsia-rseq" ]
}
rustc_library("fuchsia-rcu-atomic") {
  testonly = true
  sources = _COMMON_SRCS
  crate_name = "fuchsia_rcu"
  edition = "2024"
  proc_macro_deps = [ ":fuchsia-rcu-derive" ]
  version = "0.1.0"
  deps = _COMMON_DEPS
}
rustc_test("fuchsia-rcu-atomic-tests") {
  sources = _COMMON_SRCS
  edition = "2024"
  proc_macro_deps = [ ":fuchsia-rcu-derive" ]
  version = "0.1.0"
  deps = _COMMON_DEPS
}
