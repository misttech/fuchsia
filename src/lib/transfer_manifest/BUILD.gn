import("//build/tools/bazel2gn/bazel_migration.gni")

if (is_host) {
  rustc_library("transfer_manifest") {
    sources = [ "src/lib.rs" ]
    edition = "2024"
    visibility = [
      ":*",
      "//src/developer/ffx/lib/pbms:*",
      "//tools/pbtool:*",
    ]
    deps = [
      "//third_party/rust_crates:camino",
      "//third_party/rust_crates:serde",
    ]
  }
}
if (is_host) {
  rustc_test("transfer_manifest_test") {
    sources = [ "src/lib.rs" ]
    edition = "2024"
    deps = [
             "//third_party/rust_crates:camino",
             "//third_party/rust_crates:serde",
           ] + [ "//third_party/rust_crates:serde_json" ]
    visibility = [
      ":*",
      "//src/lib:*",
    ]
  }
}
