import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("fuchsia") {
  sources = [ "src/lib.rs" ]
  crate_name = "fuchsia"
  edition = "2024"
  proc_macro_deps = [ "//src/lib/fuchsia/macro" ]
  visibility = [ "//*" ]
  deps = []
  deps += [
    "//sdk/fidl/fuchsia.diagnostics.types:fuchsia.diagnostics.types_rust_common",
    "//src/lib/diagnostics/log/rust",
    "//src/lib/fuchsia-async",
    "//third_party/rust_crates:argh",
    "//third_party/rust_crates:libc",
    "//third_party/rust_crates:log",
  ]
  if (is_fuchsia) {
    deps += [
      "//sdk/lib/scheduler/rust",
      "//src/lib/diagnostics/fuchsia-async-inspect",
    ]
  }
}
