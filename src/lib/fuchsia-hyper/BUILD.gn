import("//build/bazel/bazel_test_suite.gni")
import("//build/components.gni")

# Kept in GN for `fuchsia-hyper-tests` because `bazel2gn` does not translate
# `fx_test_component` (`noGNEquivalent`).
fuchsia_test_component("fuchsia-hyper-lib-test") {
  manifest = "meta/fuchsia_hyper_lib_test.cml"
  deps = [ ":fuchsia-hyper_test" ]
  test_type = "system"
}

# Kept in GN because `//src/connectivity/network/netstack3:component-for-tests`
# has no Bazel build yet.
fuchsia_test_package("fuchsia-hyper-tests") {
  package_name = "fuchsia-hyper-tests-gn"
  test_components = [ ":fuchsia-hyper-lib-test" ]

  # `//src/connectivity/network/netstack3:component-for-tests` has not been
  # migrated to Bazel yet.
  deps = [ "//src/connectivity/network/netstack3:component-for-tests" ]
}

bazel_test_suite("bazel_tests") {
  host_tests = [ "//src/lib/fuchsia-hyper:fuchsia-hyper_host_test" ]
  target_tests = [ "//src/lib/fuchsia-hyper:fuchsia-hyper-tests" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    ":fuchsia-hyper-tests",
    ":fuchsia-hyper_test($host_toolchain)",
  ]
}

