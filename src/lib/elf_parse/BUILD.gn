rustc_library("elf_parse") {
  sources = [ "src/lib.rs" ]
  inputs = [
    "test-utils/elf_aarch64_file-header.bin",
    "test-utils/elf_riscv64_file-header.bin",
    "test-utils/elf_x86-64_file-header.bin",
  ]
  edition = "2024"
  proc_macro_deps = [ "//third_party/rust_crates:num-derive" ]
  visibility = [
    ":*",
    "//src/bringup/*",
    "//src/developer/*",
    "//src/lib/elf-search/rust:*",
    "//src/lib/process_builder:*",
    "//src/performance/*",
    "//src/starnix/*",
  ]
  deps = [
    "//sdk/rust/zx",
    "//third_party/rust_crates:bitflags",
    "//third_party/rust_crates:num-traits",
    "//third_party/rust_crates:static_assertions",
    "//third_party/rust_crates:thiserror",
    "//third_party/rust_crates:zerocopy",
  ]
}
