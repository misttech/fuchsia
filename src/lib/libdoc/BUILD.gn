import("//build/bazel/bazel_test_suite.gni")

if (is_host) {
  bazel_test_suite("bazel_tests") {
    host_tests = [ "//src/lib/libdoc:libdoc_test" ]
  }

  group("tests") {
    testonly = true
    deps = [
      ":bazel_tests",
      ":libdoc_test",
    ]
  }
}

