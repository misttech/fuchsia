load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/rust:rustc_proc_macro.bzl", "rustc_proc_macro")

package(default_applicable_licenses = ["//:license"])

rustc_proc_macro(
    name = "fuzz",
    srcs = ["src/lib.rs"],
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,  # @bazel2gn:skip
    visibility = [
        "//examples/fuzzers:__subpackages__",
        "//src/connectivity:__subpackages__",
        "//src/devices:__subpackages__",
        "//src/diagnostics:__subpackages__",
        "//src/lib/diagnostics/log/encoding/rust:__pkg__",
        "//src/starnix:__subpackages__",
        "//src/storage:__subpackages__",
        "//src/sys:__subpackages__",
        "//zircon/kernel:__subpackages__",
        "//zircon/system:__subpackages__",
    ],
    deps = [
        "//third_party/rust_crates/vendor:quote",
        "//third_party/rust_crates/vendor:syn",
    ],
)
