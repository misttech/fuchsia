import("//build/tools/bazel2gn/bazel_migration.gni")

source_set("files") {
  sources = [
    "directory.cc",
    "file.cc",
    "file_descriptor.cc",
    "glob.cc",
    "path.cc",
    "scoped_temp_dir.cc",
  ]
  public = [
    "directory.h",
    "eintr_wrapper.h",
    "file.h",
    "file_descriptor.h",
    "glob.h",
    "path.h",
    "scoped_temp_dir.h",
  ]
  deps = [
    "//sdk/lib/fit",
    "//sdk/lib/utf-utils",
    "//src/lib/fxl:memory",
  ]
  visibility = [
    ":*",
    "//examples/*",
    "//sdk/lib/*",
    "//src/*",
    "//tools/symbolizer:*",
    "//vendor/*",
    "//zircon/system/ulib/debugdata/test:*",
  ]
  public_deps = [
    "//src/lib/fxl:strings",
    "//zircon/system/ulib/fbl",
  ]
}
executable("files_unittests") {
  testonly = true
  sources = [
    "directory_unittest.cc",
    "file_descriptor_unittest.cc",
    "file_unittest.cc",
    "glob_unittest.cc",
    "path_unittest.cc",
    "scoped_temp_dir_unittest.cc",
  ]
  deps = [
    ":files",
    "//sdk/lib/syslog/cpp",
    "//src/lib/fxl:common",
    "//src/lib/fxl:strings",
    "//src/lib/fxl/test:gtest_main",
    "//third_party/googletest:gtest",
  ]
  deps += [ "//third_party/googletest:gmock" ]
}
fuchsia_component_manifest("files-tests-manifest") {
  testonly = true
  component_name = "files-tests"
  manifest = "meta/files_unittests.cml"
}
fuchsia_test_component("files-tests-component") {
  cm_label = ":files-tests-manifest"
  component_name = "files-tests"
  deps = [ ":files_unittests" ]
}
fuchsia_test_package("files-tests-package") {
  package_name = "files-tests-gn"
  test_components = [ ":files-tests-component" ]
}
