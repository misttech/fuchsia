if (is_fuchsia) {
  import("//build/bazel/bazel_test_suite.gni")
  import("//build/components.gni")

  bazel_test_suite("bazel_tests") {
    target_tests = [ "//src/lib/files:files-tests" ]
  }

  group("tests") {
    testonly = true
    deps = [
      ":bazel_tests",
      ":files-tests-package",
    ]
  }
}

