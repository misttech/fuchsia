import("//build/components.gni")
import("//build/rust/rustc_test.gni")

# TODO(https://fxbug.dev/576688557): Migrate `fuchsia-framebuffer_test` and
# `fuchsia-framebuffer-tests` to BUILD.bazel once a Bazel rule is available for
# `//src/devices/bind/fuchsia.sysmem.heap:fuchsia.sysmem.heap_rust` (generated
# by GN's `_bind_library_rust` template).
rustc_test("fuchsia-framebuffer_test") {
  output_name = "fuchsia_framebuffer_lib_test"
  edition = "2024"
  deps = [
    "//sdk/fidl/fuchsia.images2:fuchsia.images2_rust",
    "//sdk/fidl/fuchsia.math:fuchsia.math_rust",
    "//sdk/fidl/fuchsia.sysmem2:fuchsia.sysmem2_rust",
    "//src/devices/bind/fuchsia.sysmem.heap:fuchsia.sysmem.heap_rust",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//src/lib/fuchsia-runtime",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
  ]

  sources = [
    "src/lib.rs",
    "src/sysmem.rs",
  ]
}

# TODO(https://fxbug.dev/576688557): Kept in GN because
# `:fuchsia-framebuffer_test` depends on
# `//src/devices/bind/fuchsia.sysmem.heap:fuchsia.sysmem.heap_rust`, which has
# no Bazel rule yet.
fuchsia_unittest_package("fuchsia-framebuffer-tests") {
  deps = [ ":fuchsia-framebuffer_test" ]

  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}

