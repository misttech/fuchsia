rustc_library("fuchsia-framebuffer") {
  sources = [
    "src/lib.rs",
    "src/sysmem.rs",
  ]
  edition = "2024"
  visibility = [
    ":*",
    "//src/lib/ui/carnelian:*",
    "//src/starnix/modules/framebuffer:*",
    "//src/ui/examples/flatland-rainbow:*",
    "//src/virtualization/bin/vmm/device/virtio_gpu:*",
  ]
  deps = [
    "//sdk/fidl/fuchsia.images2:fuchsia.images2_rust",
    "//sdk/fidl/fuchsia.math:fuchsia.math_rust",
    "//sdk/fidl/fuchsia.sysmem2:fuchsia.sysmem2_rust",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia-component",
    "//src/lib/fuchsia-runtime",
    "//third_party/rust_crates:anyhow",
  ]
}
