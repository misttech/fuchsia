# `build_flags` cannot be used on `carnelian` because `build_flags` adds a
# generated response file to `compile_data`, which causes `@rules_rust` to copy
# `srcs` into `bazel-out/.../bin/` and breaks relative `include_bytes!("../../../../../...")`
# paths in `#[cfg(test)]` modules when `carnelian_test` inherits `crate = ":carnelian"`
# (https://fxbug.dev/516778625).
# LINT.IfChange(carnelian-performance)
_CARNELIAN_PERFORMANCE_RUSTC_FLAGS = ["-Copt-level=3"] + select({
    "@platforms//cpu:arm64": ["-Ctarget-cpu=cortex-a53"],
    "@platforms//cpu:x86_64": ["-Ctarget-cpu=haswell"],
    "//conditions:default": [],
})
# LINT.ThenChange(BUILD.gn:carnelian-performance)

# @bazel2gn:raw_attribute:configs += [ ":carnelian-performance" ]
