# `build_flags` cannot be used on `carnelian_test` because `build_flags` adds a
# generated response file to `compile_data`, which causes `@rules_rust` to copy
# `srcs` into `bazel-out/.../bin/` and breaks relative `include_bytes!("../../../../../...")`
# paths in `#[cfg(test)]` modules (https://fxbug.dev/516778625).
# @bazel2gn:raw_attribute:configs += [ ":carnelian-performance" ]
# @bazel2gn:raw_attribute:output_name = "carnelian_lib_test"
rustc_test(
    name = "carnelian_test",
    compile_data = [
        "//:prebuilt/third_party/fonts/robotoslab/RobotoSlab-Regular.ttf",
    ],
    crate = ":carnelian",
    edition = "2024",
    # @bazel2gn:skip
    rustc_flags = _CARNELIAN_PERFORMANCE_RUSTC_FLAGS,
    deps = [
        "//third_party/rust_crates/vendor:itertools",
    ],
)

fx_packaged_binary(
    name = "carnelian_test_packaged_bin",
    testonly = True,
    binary = ":carnelian_test",
    binary_name = "carnelian_lib_test",
)

