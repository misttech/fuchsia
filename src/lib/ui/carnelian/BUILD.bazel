        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/carnelian_lib_test.cml",
)

fx_test_component(
    name = "carnelian-render-tests-component",
    compiled_manifest = ":carnelian-render-tests-manifest",
    component_name = "carnelian-render-tests",
    deps = [":carnelian_test_packaged_bin"],
)

fx_package(
    name = "carnelian-render-tests-package",
    package_name = "carnelian-render-tests",
    testonly = True,
    test_components = [":carnelian-render-tests-component"],
)

