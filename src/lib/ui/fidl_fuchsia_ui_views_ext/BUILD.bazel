load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "lib",
    srcs = ["src/lib.rs"],
    crate_name = "fidl_fuchsia_ui_views_ext",
    edition = "2024",
    visibility = [
        "//src/lib/ui/fidl_fuchsia_ui_focus_ext:__pkg__",
        "//src/ui/lib/input_pipeline:__pkg__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.ui.views:fuchsia.ui.views_rust",
        "//sdk/rust/zx",
    ],
)

rustc_test(
    name = "fidl_fuchsia_ui_views_ext_lib_test",
    crate = ":lib",
    edition = "2024",
    deps = ["//src/lib/ui/fuchsia-scenic"],
)

fx_unittest_package(
    name = "test-pkg",
    package_name = "fidl_fuchsia_ui_views_ext-test",
    unit_tests = [":fidl_fuchsia_ui_views_ext_lib_test"],
)
