load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load(
    "//build/bazel/rules/testing:fx_unittest_package.bzl",
    "fx_unittest_package",
)

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "input-synthesis",
    srcs = [
        "src/lib.rs",
        "src/modern_backend/input_device.rs",
        "src/modern_backend/input_device_registry.rs",
        "src/modern_backend/input_reports_reader.rs",
        "src/modern_backend/mod.rs",
        "src/synthesizer.rs",
    ],
    edition = "2024",
    proc_macro_deps = ["//third_party/rust_crates/vendor:async-trait"],
    visibility = [
        "//src/lib/ui:__pkg__",
        "//src/testing/sl4f:__pkg__",
        "//src/ui/tests/integration_input_tests/factory-reset-handler:__pkg__",
        "//src/ui/tools/input:__pkg__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.input:fuchsia.input_rust",
        "//sdk/fidl/fuchsia.input.injection:fuchsia.input.injection_rust",
        "//sdk/fidl/fuchsia.input.report:fuchsia.input.report_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/fidl/fuchsia.ui.input:fuchsia.ui.input_rust",
        "//sdk/fidl/fuchsia.ui.input3:fuchsia.ui.input3_rust",
        "//sdk/rust/zx",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/ui/keymaps",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:serde",
    ],
)

rustc_test(
    name = "input-synthesis_test",
    crate = ":input-synthesis",
    edition = "2024",
    deps = [
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:pretty_assertions",
        "//third_party/rust_crates/vendor:serde_json",
        "//third_party/rust_crates/vendor:test-case",
    ],
)

fx_unittest_package(
    name = "input-synthesis-tests",
    unit_tests = [":input-synthesis_test"],
)
