load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "keymaps",
    srcs = [
        "src/config.rs",
        "src/defs.rs",
        "src/inverse_keymap.rs",
        "src/lib.rs",
        "src/usages.rs",
    ],
    edition = "2024",
    visibility = [
        "//src/lib/ui:__subpackages__",
        "//src/ui/bin/text:__pkg__",
        "//src/ui/lib/input_pipeline:__pkg__",
        "//src/ui/testing/input_helper:__pkg__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.input:fuchsia.input_rust",
        "//sdk/fidl/fuchsia.ui.input3:fuchsia.ui.input3_rust",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:log",
    ],
)

rustc_test(
    name = "keymaps_test",
    crate = ":keymaps",
    edition = "2024",
    deps = [
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:test-case",
    ],
)

fx_unittest_package(
    name = "keymaps-tests",
    unit_tests = [":keymaps_test"],
)
