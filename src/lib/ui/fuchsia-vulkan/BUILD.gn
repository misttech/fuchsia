rustc_library("fuchsia-vulkan") {
  sources = [ "src/lib.rs" ]
  edition = "2024"
  link_deps = [ "//src/lib/vulkan" ]
  proc_macro_deps = [ "//third_party/rust_crates:derivative" ]
  deps = [
    "//sdk/rust/zx",
    "//third_party/rust_crates:vk-sys",
  ]
}
rustc_test("fuchsia-vulkan_test") {
  sources = [ "src/lib.rs" ]
  edition = "2024"
  link_deps = [ "//src/lib/vulkan" ]
  proc_macro_deps = [ "//third_party/rust_crates:derivative" ]
  deps = [
    "//sdk/rust/zx",
    "//third_party/rust_crates:vk-sys",
  ]
  output_name = "fuchsia_vulkan_lib_test"
}
