import("//build/tools/bazel2gn/bazel_migration.gni")

static_library("debug_sym_for_rust") {
  sources = [ "debug_sym_for_rust.cc" ]
  deps = [
    "//src/lib/debug",
    "//src/lib/debug:backtrace-request",
  ]
}

rustc_library("rust") {
  sources = [ "src/lib.rs" ]
  crate_name = "debug"
  edition = "2024"
  link_deps = [ ":debug_sym_for_rust" ]
  visibility = [
    ":*",
    "//src/connectivity/network/netstack3:*",
    "//src/devices/bin/driver-host:*",
    "//src/starnix/kernel/core:*",
    "//src/starnix/kernel/syscall_loop:*",
    "//src/storage/fxfs:*",
    "//src/sys/time/timekeeper/alarms:*",
  ]
  with_unit_tests = true
}
