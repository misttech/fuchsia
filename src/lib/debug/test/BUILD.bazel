load("//build/bazel/rules/cc:fx_cc_test.bzl", "fx_cc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

fx_cc_test(
    name = "backtrace-request-test",
    srcs = ["backtrace-request-test.cc"],
    tags = ["manual"],
    deps = [
        "//src/lib/debug:backtrace-request",
        "//src/lib/debug:backtrace-request-utils",
        "//zircon/system/ulib/zx",
        "//zircon/system/ulib/zxtest",
    ],
)

fx_unittest_package(
    name = "backtrace-request-test-pkg",
    package_name = "backtrace-request-test",
    unit_tests = [":backtrace-request-test"],
    visibility = ["//src/lib:__pkg__"],
)

# Integration test for requesting a backtrace.
#
# Related unittests exist alongside the backtrace and crashsvc code, but
# this verifies that the pieces are working together correctly.
fx_cc_test(
    name = "backtrace-request-integration-test",
    srcs = ["backtrace-request-integration-test.cc"],
    tags = ["manual"],
    deps = [
        "//src/lib/debug:backtrace-request",
        "//zircon/system/ulib/zxtest",
    ],
)

fx_unittest_package(
    name = "backtrace-request-integration-test-pkg",
    package_name = "backtrace-request-integration-test",
    unit_tests = [":backtrace-request-integration-test"],
    visibility = ["//src/lib:__pkg__"],
)
