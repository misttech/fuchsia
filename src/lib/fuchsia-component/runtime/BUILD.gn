import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("runtime") {
  sources = [ "src/lib.rs" ]
  crate_name = "fuchsia_component_runtime"
  edition = "2024"
  test_deps = [
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//third_party/rust_crates:assert_matches",
  ]
  visibility = [
    ":*",
    "//src/lib/fuchsia-component/*",
  ]
  with_unit_tests = true
  deps = [
    "//sdk/fidl/fuchsia.component.runtime:fuchsia.component.runtime_rust",
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//sdk/rust/zx",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia-component/client",
    "//third_party/rust_crates:futures",
  ]
}
fuchsia_component_manifest("fuchsia-component-runtime-unittests-manifest") {
  testonly = true
  component_name = "fuchsia-component-runtime-unittests"
  manifest = "meta/fuchsia-component-runtime-unittests.cml"
}
fuchsia_test_component("fuchsia-component-runtime-unittests-component") {
  cm_label = ":fuchsia-component-runtime-unittests-manifest"
  component_name = "fuchsia-component-runtime-unittests"
  deps = [ ":runtime_test" ]
}
fuchsia_test_package("fuchsia-component-runtime-unittests-package") {
  package_name = "fuchsia-component-runtime-unittests-gn"
  test_components = [ ":fuchsia-component-runtime-unittests-component" ]
}
