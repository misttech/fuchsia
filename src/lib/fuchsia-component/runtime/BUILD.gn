import("//build/bazel/bazel_test_suite.gni")
import("//build/components.gni")

bazel_test_suite("bazel_tests") {
  target_tests = [
    "//src/lib/fuchsia-component/runtime:fuchsia-component-runtime-unittests",
  ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    ":fuchsia-component-runtime-unittests-package",
  ]
}

