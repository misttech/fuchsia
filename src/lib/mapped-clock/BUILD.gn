import("//build/bazel/bazel_test_suite.gni")

# Canonical "build everything" target.
group("mapped-clock") {
  testonly = true
  deps = [
    ":lib",
    ":tests",
  ]
}

bazel_test_suite("mapped-clock-tests") {
  target_tests = [ "//src/lib/mapped-clock:mapped-clock-tests" ]
}

# Canonical tests target.
group("tests") {
  testonly = true
  public_deps = [ ":mapped-clock-tests" ]
}

