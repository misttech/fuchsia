import("//build/bazel/bazel_test_suite.gni")

bazel_test_suite("bazel_tests") {
  target_tests = [ "//src/lib/mpmc:mpmc_tests" ]
}

group("tests") {
  testonly = true

  deps = [
    ":bazel_tests",
    ":mpmc_tests",
  ]
}

