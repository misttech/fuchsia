import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("mpmc") {
  sources = [ "src/lib.rs" ]
  edition = "2024"
  visibility = [
    ":*",
    "//src/media/sessions:*",
    "//src/starnix/modules/thermal:*",
  ]
  deps = [
    "//third_party/rust_crates:crossbeam",
    "//third_party/rust_crates:futures",
  ]
}

rustc_test("mpmc_lib_test") {
  sources = [ "src/test.rs" ]
  source_root = "src/test.rs"
  edition = "2024"
  deps = [
    ":mpmc",
    "//src/lib/fuchsia-async",
    "//third_party/rust_crates:futures",
  ]
}

fuchsia_unittest_package("mpmc_tests") {
  package_name = "mpmc_tests-gn"
  component_name = "mpmc_tests"
  deps = [ ":mpmc_lib_test" ]
}
