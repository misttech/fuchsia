load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "pty",
    srcs = [
        "src/key_util.rs",
        "src/lib.rs",
        "src/pty.rs",
    ],
    edition = "2024",
    visibility = [
        "//src/bringup/bin/virtcon:__pkg__",
        "//src/ui/bin/terminal:__pkg__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.hardware.pty:fuchsia.hardware.pty_rust",
        "//sdk/rust/zx",
        "//src/lib/fdio/rust:fdio",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-component",
        "//src/lib/trace/rust:trace",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:libc",
    ],
)

# TODO(https://fxbug.dev/571374004): Move `pty_tests_component` and `pty_tests`
# to Bazel once `fx_package` supports `subpackages` and
# `//src/bringup/bin/ptysvc:package`,
# `//src/testing/zx-test-util:exit_with_code_util`, and
# `//src/zircon/bin/zxsh:sh` are available in Bazel.
rustc_test(
    name = "pty_test",
    crate = ":pty",
    crate_name = "pty_lib_test",
    deps = [
        "//src/lib/fuchsia-async",
        "//third_party/rust_crates/vendor:futures",
    ],
)
