import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("detect-stall") {
  sources = [
    "src/lib.rs",
    "src/stream.rs",
  ]
  edition = "2024"
  test_deps = [
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-component/tests:fuchsia.component.client.test_rust",
    "//third_party/rust_crates:assert_matches",
  ]
  visibility = [
    ":*",
    "//src/connectivity/policy/http-client:*",
    "//src/devices/bin/driver-index:*",
    "//src/hwinfo:*",
    "//src/lib/fuchsia-component/server:*",
    "//src/sys/component_manager/tests/stop_with_escrow:*",
    "//src/sys/pkg/bin/null-update-checker:*",
    "//src/sys/pkg/bin/system-update-committer:*",
  ]
  with_unit_tests = true
  deps = [
    "//sdk/rust/zx",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-sync",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:pin-project-lite",
  ]
}

fuchsia_unittest_package("detect-stall-unittests") {
  package_name = "detect-stall-unittests-gn"
  component_name = "detect-stall-unittests"
  deps = [ ":detect-stall_test" ]
}
