import("//build/bazel/bazel_test_suite.gni")

bazel_test_suite("bazel_tests") {
  target_tests = [ "//src/lib/detect-stall:detect-stall-unittests" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    ":detect-stall-unittests",
  ]
}

