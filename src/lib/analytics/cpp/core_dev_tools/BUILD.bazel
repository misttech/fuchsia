load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")
load("//build/bazel/rules/host_tests:host_cc_test.bzl", "host_cc_test")

package(default_applicable_licenses = ["//:license"])

fx_cc_library(
    name = "testable_internals",
    srcs = [
        "environment_status.cc",
        "persistent_status.cc",
    ],
    hdrs = [
        "environment_status.h",
        "persistent_status.h",
    ],
    deps = [
        "//sdk/lib/syslog/cpp",
        "//src/lib/analytics/cpp/metric_properties",
        "//src/lib/uuid",
    ],
    alwayslink = True,
)

fx_cc_library(
    name = "core_dev_tools",
    srcs = [
        "analytics_executor.cc",
        "analytics_internal.cc",
        "analytics_messages.cc",
        "analytics_messages.h",
        "analytics_status.h",
        "command_line_options.cc",
        "ga4_common_events.h",
        "google_analytics_4_client.cc",
        "system_info.cc",
    ],
    hdrs = [
        "analytics.h",
        "analytics_executor.h",
        "analytics_internal.h",
        "command_line_options.h",
        "google_analytics_4_client.h",
        "system_info.h",
    ],
    implementation_deps = [
        "//src/developer/debug/shared",
        "//src/developer/debug/zxdb/common",
    ],
    visibility = [
        "//src/developer/debug/zxdb/client:__pkg__",
        "//tools/fidlcat:__pkg__",
        "//tools/fidlcat/lib:__pkg__",
        "//tools/symbolizer:__pkg__",
    ],
    deps = [
        ":testable_internals",
        "//sdk/lib/fit-promise",
        "//sdk/lib/syslog/cpp",
        "//src/lib/analytics/cpp/google_analytics_4",
        "//src/lib/analytics/cpp/metric_properties",
        "//src/lib/cmdline",
        "//src/lib/fxl",
    ],
)

host_cc_test(
    name = "analytics_cpp_core_dev_tools_unittests",
    srcs = [
        "environment_status_unittest.cc",
        "persistent_status_unittest.cc",
    ],
    test_args = ["env HOME=/tmp"],
    visibility = ["//src/lib/analytics:__pkg__"],
    deps = [
        ":core_dev_tools",
        ":testable_internals",
        "//src/lib/analytics/cpp/metric_properties",
        "//src/lib/files",
        "//src/lib/fxl/test:gtest_main",
        "//src/lib/uuid",
        "@com_google_googletest//:gtest",
    ],
)
