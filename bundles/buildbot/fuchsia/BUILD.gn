import("//build/assembly/product_bundle.gni")
import("//build/assembly/product_bundle_test_group.gni")
import("//build/testing/environments.gni")
import("//bundles/buildbot/target_tests.gni")

declare_args() {
  # True if we are running in postsubmit, false if we are running in presubmit.
  # Some tests are only run in postsubmit, but are always built in presubmit.
  # Some hardware platforms are skipped in presubmit, but always run in
  # postsubmit
  is_postsubmit = false
}

group("fuchsia") {
  testonly = true
  deps = [
    # For now, run the Bazel rules and macros tests only on these bots.
    # The test targets currently build some migrated targets as well, so we do
    # not want to run them on bots that take longer than this one.
    "//build/bazel/rules/tests:all",

    # Contains additional targets to be built that are NOT tests, but need
    # to be built.
    # This allows bots to ensure buildable targets do not regress even if they
    # are not being run by another bot (i.e., during bringup of a new CPU
    # architecture).
    ":additional_build_targets",
  ]
  if (target_cpu == "arm64") {
    deps += [
      ":core.arm64",
      ":minimal.arm64",
      ":minimal.arm64-hermetic_examples",
    ]

    # Lacewing tests are only run with the balanced compilation mode.
    if (is_balanced) {
      deps += [ ":workbench_eng.vim3-lacewing" ]
    }
  }
  if (target_cpu == "x64") {
    deps += [
      ":core.x64",
      ":minimal.x64",
      ":minimal.x64-ui_tests",
      ":workbench_eng.x64",
    ]

    # Lacewing tests only run in the debug compilation mode.
    if (is_debug) {
      deps += [ ":core.x64-lacewing" ]
    }

    # Lacewing tests only run with the balanced compilation mode.
    if (is_balanced) {
      deps += [ ":workbench_eng.x64-lacewing" ]
    }
  }
  if (target_cpu == "riscv64") {
    deps += [ ":minimal.riscv64" ]
  }
}

# Contains additional targets to be built that are not needed for tests.
# This allows bots to ensure buildable targets do not regress even if they are
# not being run by another bot (i.e., during bringup of a new CPU architecture).
group("additional_build_targets") {
  testonly = true
  metadata = {
    # This group needs to not be included in test metadata as this builder
    # doesn't have a default product bundle defined, and so cannot run any
    # non-host tests that aren't explicitly listed in a
    # product_bundle_test_group().
    tests_barrier = []
  }
  deps = core_examples_targets
}

########
# Tests to build or run on minimal.

if (target_cpu == "arm64") {
  product_bundle_test_group("minimal.arm64") {
    product_bundle_name = "minimal.arm64"

    if (is_postsubmit) {
      allowed_environments = [ c4a_env ]
    } else {
      build_only = true
    }

    target_tests = minimal_target_tests + minimal_ui_target_tests
  }

  # Included so that there are _some_ tests to run on
  product_bundle_test_group("minimal.arm64-hermetic_examples") {
    product_bundle_name = "minimal.arm64"
    environments = [ c4a_env ]
    target_tests = [ "//examples:hermetic_tests" ]
  }
}
if (target_cpu == "x64") {
  product_bundle_test_group("minimal.x64") {
    product_bundle_name = "minimal.x64"

    if (is_postsubmit) {
      allowed_environments = [ aemu_env ]
    } else {
      build_only = true
    }

    target_tests = minimal_target_tests
  }

  product_bundle_test_group("minimal.x64-ui_tests") {
    product_bundle_name = "minimal.x64"

    # The integration tests that require WebEngine fail when run. See
    # https://fxbug.dev/42083237. Since they are only run on x64 (the test spec
    # requires AEMU), disable them only for that architecture
    build_only = true
    target_tests = minimal_ui_target_tests
  }

  if (is_debug) {
    product_bundle_test_group("core.x64-lacewing") {
      product_bundle_name = "core.x64"
      allowed_environments = [
        aemu_env,
        nuc11_env,
      ]
      host_tests = [ "//src/testing/end_to_end:core_x64_stable_tests" ]
    }
  }
}
if (target_cpu == "riscv64") {
  product_bundle_test_group("minimal.riscv64") {
    product_bundle_name = "minimal.riscv64"

    if (is_postsubmit) {
      allowed_environments = [ qemu_env ]
    } else {
      build_only = true
    }

    target_tests = minimal_target_tests + minimal_ui_target_tests
  }
}

########
# Core

if (target_cpu == "arm64") {
  product_bundle_test_group("core.arm64") {
    product_bundle_name = "core.arm64"
    if (is_postsubmit || is_release) {
      allowed_environments = [ c4a_env ]
    } else {
      build_only = true
    }
    target_tests = core_target_tests
  }
}

if (target_cpu == "x64") {
  # All the core tests.
  product_bundle_test_group("core.x64") {
    product_bundle_name = "core.x64"

    # Presumbit only runs tests in release mode, under the assumption
    # that if the tests pass in release mode, they will likely
    # pass in the others.
    if (is_postsubmit || is_release) {
      allowed_environments = [
        aemu_env,
        nuc11_env,
      ]
      default_environments = [ aemu_env ]
      if (is_postsubmit) {
        # Add nuc11 to the set of hardware environments used by default
        # for tests in post-submit.
        default_environments += [ nuc11_env ]
      }
    } else {
      build_only = true
    }

    target_tests = core_target_tests
  }
}

########
# Workbench.

if (target_cpu == "arm64") {
  # Lacewing tests are only run with the balanced compilation mode.
  if (is_balanced) {
    product_bundle_test_group("workbench_eng.vim3-lacewing") {
      product_bundle_name = "workbench_eng.vim3"

      # TODO(https://fxbug.dev/513339198): Move back to running once fixed.
      build_only = true
      host_tests = [
        "//src/testing/end_to_end:workbench_vim3_stable_tests",
        "//src/tests/end_to_end:workbench_vim3_stable_tests",
      ]
    }
  }
}

if (target_cpu == "x64") {
  product_bundle_test_group("workbench_eng.x64") {
    product_bundle_name = "workbench_eng.x64"

    if (is_postsubmit) {
      allowed_environments = [ aemu_env ]
    } else {
      build_only = true
    }

    # No tests run on Workbench, but we want to always build the product bundle.
    target_tests = []
  }

  # Lacewing tests are only run with the balanced compilation mode.
  if (is_balanced) {
    product_bundle_test_group("workbench_eng.x64-lacewing") {
      product_bundle_name = "workbench_eng.x64"
      allowed_environments = [
        aemu_env,
        nuc11_env,
      ]
      host_tests = [
        "//src/testing/end_to_end:workbench_x64_stable_tests",
        "//src/tests/end_to_end:workbench_x64_stable_tests",
      ]
    }
  }
}
