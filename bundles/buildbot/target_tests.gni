# Hermetic tests for minimal.
minimal_hermetic_target_tests = [
  "//examples:hermetic_tests",
  "//src/sys/component_manager:hermetic_tests",
  "//src/sys/pkg:hermetic_tests",
]

# Tests to build or run on minimal.
minimal_target_tests =
    minimal_hermetic_target_tests + [
      "//examples:tests",
      "//sdk:tests",
      "//src/connectivity/network:tests",
      "//src/bringup:tests",
      "//src/devices:tests",
      "//src/diagnostics:tests",
      "//src/fonts:tests",
      "//src/hwinfo:tests",
      "//src/intl:tests",
      "//src/lib:tests",
      "//src/media/audio/drivers/tests:admin",
      "//src/media/audio/drivers/tests:basic",
      "//src/performance:tests",
      "//src/power:tests",
      "//src/starnix:tests",
      "//src/storage:tests",
      "//src/sys:tests",
      "//src/zircon:tests",

      # reboot_hang is a non-hermetic e2e test. It is added to minimal because
      # iris only has bringup and minimal builders in infra. Execution is
      # restricted to iris_env.
      "//src/tests/end_to_end/reboot_hang:tests",
    ]

minimal_ui_target_tests = [ "//src/ui:tests" ]

# Tests for core that don't depend on any known e2e test libraries.
core_no_e2e_dep_target_tests = [
  "//build:tests",
  "//examples:tests",
  "//scripts:tests",
  "//src/diagnostics:tests",
  "//src/media/bundles:services",
  "//third_party:tests",

  # Used by tests
  "//src/diagnostics/archivist:archivist-for-embedding",

  # The following groups have known e2e tests explicitly excluded.
  "//bundles/fidl:tests_no_e2e",
  "//sdk:tests_no_e2e",
  "//src:tests_no_e2e",
  "//tools:tests_no_e2e",
]

# Tests for core that don't run any e2e tests (includes unit tests for known e2e
# test libraries).
core_no_e2e_target_tests = core_no_e2e_dep_target_tests + e2e_lib_unit_tests

# Tests to run on arm64 coverage builders.
core_no_e2e_arm64_cov_target_tests = [
  "//src/developer/debug/debug_agent:tests",
  "//src/devices:tests",
  "//src/media:tests",
  "//src/zircon:tests",
]

# Examples that are built for core but don't execute any tests.
core_examples_targets = [
  "//build/bazel/examples",
  "//examples",
  "//src/lib/ui/carnelian:examples",
  "//src/media/bundles:examples",
]

# E2E and hermetic tests for core that don't require a board to be defined.
core_e2e_target_tests = [
  "//bundles/fidl:tests",
  "//examples:hermetic_tests",
  "//sdk:tests",
  "//src/sys/pkg:hermetic_tests",
]

# E2E tests for core that require a board to be defined.
core_board_e2e_target_tests = [
  "//src:e2e_tests",
  "//src/media/audio/drivers/tests:basic",
]

# All the core tests.
core_target_tests = core_no_e2e_target_tests + core_e2e_target_tests +
                    core_board_e2e_target_tests
