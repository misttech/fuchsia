# Compiled tools that are depended on by shac checks under //scripts/shac.
group("shac_tools") {
  testonly = true
  deps = [
    "//build/bazel/host:bazel_root_host_tools.clippy-reporter.host_tool($host_toolchain)",
    "//build/bazel/host:bazel_root_host_tools.formatjson5($host_toolchain)",
    "//build/bazel/host:bazel_root_host_tools.gidl-format.host_tool($host_toolchain)",
    "//build/bazel/host:bazel_root_host_tools.mdlint($host_toolchain)",
    "//build/bazel/host:bazel_root_host_tools.readme_fuchsia.host_tool($host_toolchain)",
    "//build/bazel/host:bazel_root_host_tools.rfcmeta($host_toolchain)",
    "//tools/cmc:cmc.actual($host_toolchain)",
    "//tools/doc_checker:doc_checker_bin.actual($host_toolchain)",
    "//tools/fidl/fidlc:fidl-format($host_toolchain)",
    "//tools/fidl/fidlc:fidl-lint($host_toolchain)",
  ]
}
